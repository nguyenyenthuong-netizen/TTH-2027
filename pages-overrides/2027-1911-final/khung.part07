nguon":"Sổ yêu cầu","ty_trong":15},{"chi_tieu":"Không vi phạm pháp luật quảng cáo y tế","nguon":"Biên bản kiểm tra; kết luận cơ quan nhà nước","ty_trong":15},{"chi_tieu":"Nội dung xây mới website tthhealthcare.com, App TTH bàn giao đúng lịch được duyệt","nguon":"Lịch dự án","ty_trong":15},{"chi_tieu":"Tổ trưởng: yêu cầu thuộc phạm vi nhóm 1 cần xử lý được xử lý trong 04 giờ làm việc","nguon":"Sổ yêu cầu; nhật ký xử lý, phạm vi người nhóm 1","ty_trong":10},{"chi_tieu":"Tổ trưởng: lịch, sổ theo dõi, báo cáo tổ và đánh giá người nhóm 1 đúng hạn","nguon":"Sổ theo dõi yêu cầu; lịch sản xuất; bảng đánh giá theo tuyến","ty_trong":10}],"chung":[{"chi_tieu":"Kết quả nhóm thương hiệu: bình quân điểm KPI kết quả các Hạng mục của nhóm","nguon":"Điểm đã chốt kỳ (mục 24.6)","ty_trong":10},{"chi_tieu":"Kết quả phòng: bình quân điểm KPI kết quả các Hạng mục toàn phòng","nguon":"Điểm đã chốt kỳ (mục 24.6)","ty_trong":10}],"nguon_quyet_dinh":"Phòng Marketing Tổng công ty chốt 14/11/2026: Chuyên viên biên tập nhóm 1 giữ vai trò Tổ trưởng theo văn bản chỉ định; 04 KPI chuyên môn × 15% + 02 KPI điều phối × 10% = 80% cá nhân, KPI chung 20%. Chỉ chấm KPI điều phối cho người được chỉ định.","trang_thai_phe_duyet":"đã chốt 14/11/2026","quy_tac_ap_dung":"Thực hiện theo quyết định chốt vị trí ngày 14/11/2026, các thay đổi cần quyết định mới."},"bt-b":{"ca_nhan":[{"chi_tieu":"Tỷ lệ yêu cầu hoàn tất đúng hạn (gồm kiểm pháp lý)","nguon":"Sổ yêu cầu","ty_trong":20},{"chi_tieu":"Số vòng chỉnh sửa bình quân","nguon":"Sổ yêu cầu","ty_trong":20},{"chi_tieu":"Không vi phạm pháp luật quảng cáo y tế","nguon":"Biên bản kiểm tra; kết luận cơ quan nhà nước","ty_trong":20},{"chi_tieu":"Nội dung xây mới website của thương hiệu nhóm 2 bàn giao đúng lịch được duyệt","nguon":"Lịch dự án","ty_trong":20}],"chung":[{"chi_tieu":"Kết quả nhóm thương hiệu: bình quân điểm KPI kết quả các Hạng mục của nhóm","nguon":"Điểm đã chốt kỳ (mục 24.6)","ty_trong":10},{"chi_tieu":"Kết quả phòng: bình quân điểm KPI kết quả các Hạng mục toàn phòng","nguon":"Điểm đã chốt kỳ (mục 24.6)","ty_trong":10}],"nguon_quyet_dinh":"Khung 11/11/2026, Phụ lục 2; bỏ 04 chỉ tiêu Tổ trưởng (16%) vì vai trò Tổ trưởng chuyển Chuyên viên biên tập nhóm 1, chia lại 20% mỗi chỉ tiêu (Phòng Marketing Tổng công ty duyệt 14/11/2026)","trang_thai_phe_duyet":"đã chốt 14/11/2026","quy_tac_ap_dung":"Thực hiện theo quyết định chốt vị trí ngày 14/11/2026, các thay đổi cần quyết định mới."}},"ghi_chu_nghiem_thu_noi_dung":["15/11/2026: đã sửa các mâu thuẫn có quyết định; còn chờ quyết định KPI các vị trí khác, KPI Quản lý sản phẩm số 15%/20%, phụ cấp điều phối nhóm 2, lịch thiết bị media mục 11.1, vùng và thời điểm chuyển giao Quản lý mạng lưới vùng. Bản này không tự ban hành các nội dung đó."],"quan_ly_mang_luoi_vung":{"trang_thai":"Cần Ban Tổng Giám đốc phê duyệt danh sách bàn giao trước khi áp dụng; không tự chuyển quyền","suat_dinh_bien":"01 Quản lý mạng lưới vùng tính trong mốc 56 người; không cộng thêm người ngoài lộ trình","quy_tac_ban_dau":"Khi chưa có quyết định giao quyền và danh sách bàn giao quản lý mạng lưới vùng, Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở trực tiếp quản lý và đánh giá tất cả Trưởng nhóm Marketing bệnh viện ở cả hai nhóm thương hiệu. Giới hạn đánh giá trực tiếp 12 người; khi vượt giới hạn phải trình cơ cấu bổ sung, không tự phân vùng hoặc chuyển tuyến sang Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số.","nguyen_tac":"Mỗi Trưởng nhóm Marketing cơ sở chỉ có 01 người quản lý trực tiếp tại một thời điểm (Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở cho đến khi có quyết định bàn giao hợp lệ sang quản lý vùng). Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số không nhận tuyến quản lý Trưởng nhóm do kiêm nhiệm Truyền thông. Trần Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở2 người, Quản lý mạng lưới vùng 15 người; phải kiểm số người đánh giá trực tiếp.","trinh_tu":["Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở lập danh sách tất cả Trưởng nhóm bệnh viện đang trực tiếp quản lý, gồm cả Nguyên Phúc và Thái Thượng Hoàng, theo mã cơ sở, Nhóm thương hiệu và KPI.","Lập dự thảo vùng theo danh sách cơ sở có thật, nhóm thương hiệu và số nhân sự chuyển tuyến; đối chiếu giới hạn 12/15 và tổng định biên mục tiêu 56.","Trưởng phòng đối chiếu không trùng tuyến, trình Ban Tổng Giám đốc phê duyệt người giữ vị trí, phạm vi, danh sách cơ sở, quyền đánh giá, ngày có hiệu lực.","Sau phê duyệt, người giao và người nhận ký bàn giao; cập nhật hồ sơ vị trí, DM-8, danh sách phân quyền, KPI và phần mềm/sổ; thu hồi quyền cũ trong cùng thời điểm.","Trong vòng bàn giao, kết quả của kỳ trước do người quản lý tại thời điểm phát sinh xác nhận; người mới đánh giá từ ngày có hiệu lực, không đánh giá hồi tố nếu không có hồ sơ bàn giao.","Khi người quản lý vùng vắng, chỉ điều phối tạm theo ủy quyền; thẩm quyền đánh giá không chuyển tự động."],"truong_ban_giao":["ma_phieu","ngay_phe_duyet","nguoi_chuyen_giao","nguoi_nhan","ten_vung","nhom_thuong_hieu","ma_co_so","ma_truong_nhom","nguoi_danh_gia_cu","nguoi_danh_gia_moi","ngay_hieu_luc","so_nguoi_truc_tiep_truoc","so_nguoi_truc_tiep_sau","xac_nhan_nguoi_chuyen","xac_nhan_nguoi_nhan","xac_nhan_truong_phong","can_cu_phe_duyet","ma_quyen_duoc_cap","nhat_ky_thu_hoi_quyen_cu"],"chan":["Thiếu danh sách cơ sở/nhóm/người quản lý: không cho kích hoạt","Một người có 02 người đánh giá trực tiếp cùng kỳ: chặn","Vượt trần 12 hoặc 15: chặn và báo Trưởng phòng","Không có biên bản + hiệu lực quyết định: không chuyển quyền","Tổng số người vượt 56 mà chưa có quyết định sửa định biên: chặn"]},"phuong_an_nguoi_thay":{"trang_thai":"Phương án điều chỉnh danh sách người thay, chỉ có hiệu lực sau quyết định phân công Trưởng phòng và xác nhận người cụ thể.","ma_tran":[{"vai_tro":"Trưởng phòng Marketing","nguoi_thay_chinh":"Chuyên viên trưởng","nguoi_du_phong":"Quản lý sản phẩm số","gioi_han":"Quyền theo R07; không tự phát sinh thẩm quyền chi R28; không duyệt hồ sơ do chính mình lập."},{"vai_tro":"Tổ trưởng Tổ Tăng trưởng số","nguoi_thay_chinh":"Chuyên viên trưởng","nguoi_du_phong":"Trưởng phòng quyết định người đủ điều kiện nếu hai vai trò trùng thời điểm","gioi_han":"Chỉ điều phối theo thời hạn; nhóm 1 và 2 giữ trách nhiệm chuyên môn tương ứng, không tự duyệt sản phẩm."},{"vai_tro":"Tổ trưởng Tổ Nội dung và Sáng tạo","nguoi_thay_chinh":"01 Chuyên viên biên tập nhóm 1 khác người đang giữ vai trò Tổ trưởng, do Trưởng phòng chỉ định","nguoi_du_phong":"Chuyên viên trưởng chỉ xử lý các quyền dùng chung/nhóm 2 đã thuộc tuyến; quyết định tạm thời nếu không có người nhóm 1 đủ điều kiện","gioi_han":"Chỉ điều phối người nhóm 1; không duyệt nghỉ hoặc đánh giá người nhóm 2; không tự ký kết quả của mình."}],"rao_chan":["Không ai làm thay hơn 02 vai trò tại cùng thời điểm; Chuyên viên trưởng chỉ đứng thay chính cho Trưởng phòng và Tổ trưởng Tăng trưởng số.","Không đồng thời xếp lịch và duyệt nghỉ của chính mình; hồ sơ tự liên quan chuyển cấp có thẩm quyền độc lập.","Thiếu người cùng nhóm đủ điều kiện thì báo Trưởng phòng, không tự cấp quyền xuyên nhóm.","Mỗi lượt làm thay phải có mã, người giao, phạm vi quyền, ngày bắt đầu/kết thúc, người kiểm và nhật ký thu hồi.","Không tự động kích hoạt khi Trưởng phòng/Tổ trưởng vắng; phải có phân công/ủy quyền phù hợp R07 và R28.","Không cấp vai trò dựa trên mã loại vị trí đơn thuần; bắt buộc chọn mã nhân sự cụ thể và kiểm soát tổng số quyền đang đồng thời có hiệu lực."],"kiem_tra_theo_ca_nhan":"Giới hạn tối đa 02 tính theo mã nhân sự cụ thể, không tính theo mã loại vị trí; các mã bt-ac và tn-a là nhóm chức danh có thể gồm nhiều người. Chỉ xác nhận khi có danh sách phân người thật, ngày hiệu lực và bảng kiểm tổng số vai trò trên cùng thời điểm.","truong_so_nguoi_thay":["ma_nhan_su","ma_vi_tri_goc","ma_vai_tro_thay","loai_thay_chinh_du_phong","nhom_thuong_hieu","co_so","nguoi_chi_dinh","quyet_dinh_so","hieu_luc_tu","hieu_luc_den","so_vai_tro_dang_giu_cung_luc","kiem_tra_xung_dot_nguoi_duyet","nhat_ky_cap_quyen","nhat_ky_thu_hoi"],"canh_bao_ma_chuc_danh":"Trong nguồn hiện có, bt-ac và tn-a xuất hiện ở 03 quan hệ thay chính theo mã loại vị trí; không đủ cơ sở kết luận một cá nhân bị giao 03 vai trò. Phải phân bổ và kiểm tra theo người thật trước khi ban hành."},"ma_tran_phe_duyet_kpi":{"trang_thai":"Đang tham mưu, không dùng chấm trả lương thưởng khi chưa có quyết định hiệu lực","kpi_da_chot":["bt-ac","bt-b","tk-nt"],"kpi_trong_ban_tham_muu":["cvt","cvtt-a","cvtt-bc","dl-1","md-ac","md-b","mdcs-a","mdcs-b","qc-a","qc-b","qhcs","qlsps","qlth-a","qlth-bc","tk-a","tk-b","tn-a","tn-b"],"vi_tri_chua_co_bang":["tp","dl-2","qlml","dmpk"],"quy_tac":"Không chấm KPI dự thảo hoặc phụ cấp chưa duyệt. Chỉ ghi số liệu vận hành, theo dõi kết quả để làm cơ sở trình; khi phê duyệt phải ghi người duyệt, ngày hiệu lực, phiên bản và cách chuyển tiếp, không hồi tố tự động.","phuong_an_qlsps":{"de_xuat":"20% chỉ tiêu Tổ trưởng nằm trong 80% KPI cá nhân; 60% còn lại cho nhiệm vụ sản phẩm số, 20% kết quả chung toàn phòng (giữ 100%); hiện bảng dữ liệu có hai tiêu chí Tổ trưởng × 10% nhưng là dự thảo, chưa hiệu lực","phuong_an_so_sanh":"Giữ 15% Tổ trưởng hoặc nâng 20% đều là thay đổi chính sách; Ban Tổng Giám đốc/Phòng Nhân lực duyệt trước khi chấm","quy_tac_ap_dung":"Giữ nguyên tỷ trọng dự thảo trong bản tham mưu, không ghi đã chốt."},"phu_cap_dieu_phoi_nhom2":{"de_xuat":"Phụ cấp theo thời gian thực đảm nhiệm, tính theo quyết định nhân sự và quy chế tiền lương; không đặt số tiền hoặc tỷ lệ khi chưa có căn cứ","dieu_kien":["Nhóm 2 có ít nhất 02 Chuyên viên biên tập","Trưởng phòng chỉ định 01 người điều phối bằng văn bản, không có quyền đánh giá/duyệt độc lập vượt Chuyên viên trưởng","Quyết định quy định thời hạn, chức năng, nguồn chi, mức phụ cấp và cơ chế chấm khi nghỉ thay","Không tự tính hoặc truy lĩnh trước ngày hiệu lực"]}},"quy_trinh_lich_media_chung":{"trang_thai":"Dự thảo quy trình chi tiết, chưa thay thế quyết định cần chốt tại mục 11.1 dòng 20.","chu_so_huu_lich":"Chuyên viên trưởng quản lý lịch thiết bị media dùng chung trong BM-4 và đối soát xung đột hai nhóm; Tổ trưởng Nội dung chỉ điều phối lịch nhân sự nhóm 1; các nhóm tạo đề xuất lịch từ người thực hiện.","nguoi_duyet_ngoai_le":"Trưởng phòng phê duyệt quyết định ưu tiên khi Chuyên viên trưởng không thể giải quyết hoặc có xung đột lợi ích; không tự duyệt hồ sơ mình gửi.","buoc":["Người có nhu cầu tạo yêu cầu BM-7/SO-1, ghi nhóm, cơ sở, thiết bị, thời gian bắt đầu/kết thúc, mức độ ưu tiên dựa trên kế hoạch đã được duyệt và người nhận/bàn giao.","Người được phân công ghi đề xuất trên BM-4, chưa coi đăng ký là phê duyệt cấp thiết bị.","Chuyên viên trưởng đối chiếu trùng lịch; căn cứ lịch sự kiện đã phê duyệt, hạn bắt buộc, mức ảnh hưởng chuyên môn và thời điểm đăng ký để đề xuất giải pháp.","Nếu còn tranh chấp, chuyển Trưởng phòng ra quyết định ưu tiên trong thời hạn công việc; không tự gia hạn hoặc bỏ lịch một nhóm.","Người nhận và bàn giao thiết bị xác nhận tình trạng trước/sau; người giữ sổ kiểm trả; sự cố phát sinh ghi SO-3.","Đổi/hủy lịch phải giữ lịch sử, lý do, người quyết định, thông báo cho các bên; không được xóa vết lịch trước."],"truong":["ma_lich","ma_yeu_cau","nhom","co_so","nguoi_dang_ky","loai_thiet_bi","ma_thiet_bi","bat_dau","ket_thuc","muc_dich","can_cu_ke_hoach_duyet","tinh_trang","xac_nhan_cv_truong","quyet_dinh_uu_tien","nguoi_nhan","nguoi_ban_giao","kiem_tra_ve_sinh_va_thiet_bi","thoi_diem_tra","nguoi_thay_doi","ly_do_thay_doi","lich_su_sua"],"rao_chan":["Không được ghi trùng một mã thiết bị cùng khoảng thời gian trừ khi được xác nhận không loại trừ nhau.","Không được phát thiết bị khi chưa có mã lịch xác nhận, trừ tình huống khẩn cấp có ghi nhận và phê duyệt hợp lệ.","Không ai tự duyệt chính yêu cầu/lịch của mình.","Quyền thay đổi lịch đã xác nhận chỉ thuộc người được phân quyền, mọi thay đổi lưu nhật ký.","Thiết bị chưa bàn giao/đang sự cố không thể cấp lịch mới cho tới khi được xác nhận đủ điều kiện."]},"ghi_chu_giai_quyet_4_dieu_kien":["Vùng: đã có bộ quy tắc, mẫu bàn giao, xác nhận hiệu lực; chưa tạo cơ sở/vùng/người thật.","Người thay: đề xuất Chuyên viên biên tập nhóm 1 còn lại thay Tổ trưởng Nội dung; Chuyên viên trưởng chỉ còn 02 vai trò thay chính là Trưởng phòng và Tổ trưởng Tăng trưởng số, chờ Trưởng phòng ký phân công cá nhân.","KPI/phụ cấp: phương án 20% KPI Tổ trưởng của Quản lý sản phẩm số, phụ cấp điều phối nhóm 2, quy tắc lịch thiết bị chỉ là tham mưu – không được tính tiền hoặc tự cấp quyền trước khi có quyết định.","Biểu mẫu/sổ: đủ 32/32 danh sách trường dự thảo, 25 bộ mới chưa có chủ sở hữu xác nhận, 7 bộ đã có trường sơ bộ; không được coi đủ điều kiện lập trình production chỉ vì có trường."],"ghi_chu_ra_soat_cheo_v2":["C1: Mô tả vị trí tk-nt / Mục đích","C2: R03 – Tổ trưởng chỉ điều phối","C3: R07 – Ủy quyền khi vắng","C4: Mục 21 – Đọc kết quả lộ trình","C6: m-I-6","C7: m-14-15","C8: m-4-3","C9: m-14-11","C10: m-6","C11: v-org","E1–E10: hiệu chỉnh thống nhất 34 người/suất định biên với 25 loại vị trí, bỏ ngưỡng 10 người mang tính tuyệt đối tại phần phương án chọn","F1: R05/R06, vị trí tk-nt và mục 15.6: chặn tự kiểm file in của chính người sản xuất, yêu cầu người kiểm độc lập"],"ghi_chu_kiem_soat_mot_luot":{"nguon":"Khung v4 15/11/2026 + danh mục 78 lỗi gốc + quyết định đã chốt đến 14/11/2026 20:30 + rà chéo 21 điểm.","nguyen_tac":"Sửa các mâu thuẫn có quyết định; các nội dung chờ phê duyệt phải khóa hiệu lực và không dùng chấm lương/thưởng, không phân quyền người thật.","cac_diem_con_phai_phe_duyet":["KPI còn lại và KPI Tổ trưởng của Quản lý sản phẩm số","Mức phụ cấp người điều phối nhóm 2","Chi tiết quy định lịch thiết bị dùng chung mục 11.1 số 20","Danh sách phân vùng, mã nhân sự, giấy ủy quyền, ngày bàn giao","Xác nhận nghiệp vụ 25 biểu mẫu/sổ mới đặc tả"],"kiem_thu_tai_co_so":"Thí điểm tại Bệnh viện Đa khoa TTH Vinh (nhóm 1) và Bệnh viện Y học cổ truyền Nguyên Phúc (nhóm 2) trước khi xác nhận nghiệm thu vận hành.","doi_chieu_bo_sung":"Đồng bộ riêng các bảng mốc mở rộng mục 21.2, định biên thiết kế 04→05 từ bệnh viện chuyên khoa thứ nhất; Chuyên viên biên tập nhóm 2 thứ hai, số giờ dự án thiết kế và công thức ví dụ không còn dùng số cũ.","bo_sung_buoc_duyet":"QT.57 bước 2: không giao Quản lý thương hiệu/Trưởng phòng duyệt chi; tách thẩm định kế hoạch, xác nhận ngân sách cơ sở, và phê duyệt chi theo R28."},"dieu_chinh_17112026":{"nguon":"Ảnh nhận xét 17/11/2026 của người dùng","trang_thai":"Đã cập nhật trách nhiệm nghiệp vụ trên bản lưu HTML ngày 17/11/2026, không tự sửa quyết định nhân sự đã ban hành","danh_sach":[{"ma":"R-1711-01","ten":"Hồ sơ quảng cáo","noi_dung":"Pháp chế chủ trì bộ hồ sơ pháp lý, nộp; Biên tập chỉ cung cấp nội dung và minh chứng được duyệt; bác sĩ/chuyên môn xác nhận nguồn; Trưởng phòng duyệt nội dung Marketing. Danh sách DS-1 do Pháp chế xác nhận pháp lý, Trưởng phòng duyệt cách áp dụng trong Marketing.","muc_goc":"11.2; mảng 38–39","phan_mem":"Chặn nộp, công bố khi thiếu căn cứ và người kiểm duyệt","chua_co_phan_mem":"Phiếu bàn giao nội dung + hồ sơ Pháp chế"},{"ma":"R-1711-02","ten":"Truyền thông chi nhánh","noi_dung":"Chuyên viên Marketing cơ sở – truyền thông quản lý vận hành biển bảng, màn hình, phát thanh; cơ sở hai người Trưởng nhóm kiêm. Media chi nhánh chỉ sản xuất tư liệu; Chuyên viên truyền thông TCT điều phối lịch, Thiết kế ngoại tuyến giữ mẫu.","muc_goc":"8; 11.1; mảng 12–13","phan_mem":"Biểu mẫu kiểm tra hiện trạng, ảnh, số đo, lịch phát gắn người nhận việc Truyền thông cơ sở","chua_co_phan_mem":"Danh sách biển bảng; sổ lịch phát; phiếu báo hỏng"},{"ma":"R-1711-03","ten":"Kịch bản tư vấn","noi_dung":"Contact Center là chủ nghiệp vụ tư vấn và kịch bản; bộ phận tư vấn cơ sở giữ khi chưa chuyển giao. Marketing chỉ cung cấp thông tin Marketing đã phê duyệt, không để Biên tập viết hoặc duyệt kịch bản.","muc_goc":"17; mảng 17","phan_mem":"Loại bỏ kịch bản tư vấn khỏi việc chủ trì của Biên tập; quy trình nhận bàn giao thông tin","chua_co_phan_mem":"Phiếu thông tin Hạng mục và biên bản tiếp nhận Contact Center"},{"ma":"R-1711-04","ten":"Dữ liệu website/App","noi_dung":"Đơn vị chủ dữ liệu xác nhận -> Marketing cơ sở gửi đủ nguồn -> Biên tập chuẩn hóa, đăng thông tin cơ sở/hồ sơ/lịch bác sĩ khi chưa có HIS; Quản lý sản phẩm số đối chiếu, đăng giá/người hành nghề/dịch vụ/kỹ thuật trên CMS/App sau kiểm độc lập. Không tự duyệt dữ liệu gốc.","muc_goc":"11.1, số 24; mảng 43; QT.14; QT.28","phan_mem":"Bắt buộc source_version, approved_by, effective_date, published_by và độc lập người kiểm","chua_co_phan_mem":"Sổ kiểm soát thay đổi dữ liệu và hai người ký"}]},"phan_dinh_vi_tri_chi_tiet_17112026":[{"id":"tp","vi_tri":"Trưởng phòng Marketing","pham_vi":"TCT – toàn hệ thống","chu_tri_dau_ra":"Chủ kế hoạch năm, ngân sách, cơ chế duyệt, kết quả toàn phòng; quyết định ưu tiên giữa hai nhóm","khong_thuoc_trach_nhiem":"Không mặc nhiên duyệt thay bác sĩ, Pháp chế, Ban Tổng Giám đốc hoặc đơn vị chủ dữ liệu","ban_giao_dau_vao":"Nhận báo cáo từ Quản lý thương hiệu, Chuyên viên trưởng, đo lường; ký/duyệt theo ma trận thẩm quyền","kiem_duyet":"Ban Tổng Giám đốc đối với nội dung vượt thẩm quyền"},{"id":"cvt","vi_tri":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở","pham_vi":"TCT – vận hành chung","chu_tri_dau_ra":"Quản lý trực tiếp toàn bộ Trưởng nhóm Marketing bệnh viện của cả hai nhóm; điều phối khối sản xuất TCT, đầu mối tải việc và đánh giá cơ sở; tiếp nhận yêu cầu phối hợp từ CVT Truyền thông – Số.","khong_thuoc_trach_nhiem":"Không thay Quản lý thương hiệu chịu KPI Hạng mục; không tự mở rộng quyền phê duyệt Không thay Trưởng nhóm giao việc trực tiếp từng nhân viên; không thay CVT Truyền thông – Số hướng dẫn nghiệp vụ Truyền thông.","ban_giao_dau_vao":"Nhận kế hoạch/yêu cầu từ Quản lý thương hiệu và chuyên môn từ CVT Truyền thông – Số; phân tải/chốt lịch Trưởng nhóm cơ sở; phản hồi Trưởng phòng khi xung đột ngoài quyền.","kiem_duyet":"Trưởng phòng duyệt thay đổi quy tắc/quyền ngoài hạn mức"},{"id":"cvt-2","vi_tri":"Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số","pham_vi":"TCT – Tổ Truyền thông và Thương hiệu, Tổ Tăng trưởng số; nghiệp vụ tại cơ sở cả hai nhóm","chu_tri_dau_ra":"Quản lý và kiểm chuẩn hai tổ tại TCT; chuẩn truyền thông, OOH, phát thanh, màn hình, quảng cáo, kênh số. Đề xuất yêu cầu cơ sở qua CVT Nội dung – Cơ sở.","khong_thuoc_trach_nhiem":"Không quản lý, giao trùng việc hoặc đánh giá Trưởng nhóm bệnh viện; không duyệt phát hành, y khoa, ngân sách ngoài thẩm quyền.","ban_giao_dau_vao":"Nhận yêu cầu hai nhóm thương hiệu và thông tin thực địa; phân loại nghiệp vụ, chuyển yêu cầu ảnh hưởng tải việc cơ sở qua CVT Nội dung – Cơ sở.","kiem_duyet":"Kiểm nghiệp vụ Truyền thông/Tăng trưởng số, thông báo điểm không đạt; Trưởng phòng/cấp thẩm quyền duyệt theo ma trận."},{"id":"qlth-a","vi_tri":"Quản lý thương hiệu nhóm 1","pham_vi":"TCT – nhóm 1: TTH Group, Healthcare, Hospital, Clinic","chu_tri_dau_ra":"Chủ mục tiêu/kết quả Hạng mục nhóm 1; thông điệp, kế hoạch, nghiệm thu yêu cầu; giao nhiệm vụ theo Hạng mục","khong_thuoc_trach_nhiem":"Không tự viết bài, dựng video, đăng quảng cáo, nhập CMS, xác nhận y khoa; không phân công chuyên môn nhóm 2. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Đặt yêu cầu cho Biên tập/Thiết kế/Media/Quảng cáo/Truyền thông đúng nhóm; nhận dữ liệu cơ sở","kiem_duyet":"Trưởng phòng/cấp được ủy quyền duyệt kế hoạch, ngân sách và phát hành theo loại"},{"id":"qlth-bc","vi_tri":"Quản lý thương hiệu nhóm 2","pham_vi":"TCT – nhóm 2: các thương hiệu ngoài TTH; kiêm Tổ trưởng Truyền thông và Thương hiệu","chu_tri_dau_ra":"Chủ mục tiêu/kết quả Hạng mục nhóm 2; kiêm điều phối tiến độ 04 vị trí của tổ, không thay trách nhiệm nhóm 1","khong_thuoc_trach_nhiem":"Không tự thành cấp duyệt cao hơn; không duyệt ngân sách/nội dung chuyên môn và không chỉ đạo làm chéo nhóm. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Nhận đề bài nhóm 2, phân luồng công việc tổ; báo Trưởng phòng khi xung đột","kiem_duyet":"Trưởng phòng/cấp được ủy quyền; quyền tổ trưởng chỉ điều phối"},{"id":"cvtt-a","vi_tri":"Chuyên viên truyền thông nhóm 1","pham_vi":"TCT – truyền thông nhóm 1","chu_tri_dau_ra":"PR/báo chí, đối tác truyền thông, KOL/KOC, tài trợ và ngoại tuyến nhóm 1; chốt lịch màn hình, phát thanh cơ sở nhóm 1","khong_thuoc_trach_nhiem":"Không sản xuất thay Biên tập/Thiết kế/Media; không vận hành thiết bị ở bệnh viện; không chốt KPI Hạng mục. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Đặt sản phẩm qua Tổ Nội dung và Sáng tạo; giao lịch đã duyệt cho cơ sở; nhận ảnh nghiệm thu","kiem_duyet":"Quản lý thương hiệu nghiệm thu phù hợp Hạng mục; Trưởng phòng/cấp có thẩm quyền duyệt phát ngôn"},{"id":"cvtt-bc","vi_tri":"Chuyên viên truyền thông nhóm 2","pham_vi":"TCT – truyền thông nhóm 2","chu_tri_dau_ra":"PR/báo chí, đối tác, KOL/KOC, tài trợ, ngoại tuyến, lịch phát cho các đơn vị nhóm 2","khong_thuoc_trach_nhiem":"Không mặc định quản trị kênh quảng cáo, sản xuất nội dung hay điều hành PR nhóm 1. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Bàn giao lịch/mẫu phát cho Trưởng nhóm hoặc truyền thông cơ sở; chuyển nguồn về người viết","kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu; Trưởng phòng/cấp được ủy quyền duyệt"},{"id":"bt-ac","vi_tri":"Chuyên viên biên tập nhóm 1","pham_vi":"TCT – biên tập nhóm 1; 02 người phân công cụ thể","chu_tri_dau_ra":"Viết/biên tập nội dung bài, kịch bản lời, nội dung website/App của nhóm 1; rà soát nội dung y tế theo lịch; chuẩn bị bản nội dung và minh chứng phục vụ hồ sơ pháp lý; chủ trì kịch bản lời/thoại của video V2–V4 kể cả video không có nội dung y tế; thông điệp, lời dẫn và nội dung chữ trên hình. Không chuyển quyền chủ trì lời cho Media chỉ vì video không mang nội dung y tế.","khong_thuoc_trach_nhiem":"Không soạn kịch bản tư vấn Contact Center; không tự lập/nộp hồ sơ pháp lý; không tự xác nhận giá, giấy phép, lịch bác sĩ; không nhập dữ liệu có cấu trúc thuộc mảng 43. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Nhận nguồn bác sĩ/cơ sở và yêu cầu Quản lý thương hiệu; giao file lời cho Thiết kế/Media/Kênh số; chuyển minh chứng cho Pháp chế","kiem_duyet":"Đầu ra của Biên tập được người khác kiểm độc lập theo cấp độ rủi ro; bác sĩ/đơn vị chuyên môn xác nhận mọi nội dung y khoa; Quản lý thương hiệu nghiệm thu đầu ra; người có thẩm quyền duyệt phát hành. Biên tập không tự phê duyệt sản phẩm mình viết."},{"id":"bt-b","vi_tri":"Chuyên viên biên tập nhóm 2","pham_vi":"TCT – biên tập nhóm 2","chu_tri_dau_ra":"Viết/biên tập nội dung, lời video, website của nhóm 2; chuẩn bị minh chứng nội dung nhóm 2 khi có hồ sơ pháp lý; chủ trì kịch bản lời/thoại của video V2–V4 kể cả video không có nội dung y tế; thông điệp, lời dẫn và nội dung chữ trên hình. Không chuyển quyền chủ trì lời cho Media chỉ vì video không mang nội dung y tế.","khong_thuoc_trach_nhiem":"Không viết thay kịch bản tư vấn, hồ sơ pháp lý; không tự quản trị kênh/quảng cáo hay xác nhận thông số chuyên môn. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Nhận nguồn chuyên môn đơn vị nhóm 2; giao sản phẩm theo phiếu cho Media, Thiết kế, Quảng cáo","kiem_duyet":"Đầu ra của Biên tập được người khác kiểm độc lập theo cấp độ rủi ro; bác sĩ/đơn vị chuyên môn xác nhận mọi nội dung y khoa; Quản lý thương hiệu nghiệm thu đầu ra; người có thẩm quyền duyệt phát hành. Biên tập không tự phê duyệt sản phẩm mình viết."},{"id":"tk-a","vi_tri":"Chuyên viên thiết kế nhóm 1","pham_vi":"TCT – thiết kế nhóm 1; 02 người phân công hệ thống/bệnh viện","chu_tri_dau_ra":"Thiết kế bản số và bản in không thuộc danh sách cố định của Thiết kế ngoại tuyến; bộ nhận diện TTH, ứng dụng web/App","khong_thuoc_trach_nhiem":"Không thi công, quản trị biển bảng, dựng video, đăng kênh; không làm thay thiết kế cố định ngoại tuyến","ban_giao_dau_vao":"Nhận nội dung đã kiểm; giao file đúng thông số cho Quảng cáo, Media hoặc Truyền thông; bàn giao kiểm file in","kiem_duyet":"Người yêu cầu nghiệm thu; kiểm độc lập và người duyệt theo loại sản phẩm"},{"id":"tk-b","vi_tri":"Chuyên viên thiết kế nhóm 2","pham_vi":"TCT – thiết kế nhóm 2","chu_tri_dau_ra":"Thiết kế sản phẩm nhóm 2 ngoài danh sách cố định ngoại tuyến; chủ trì thiết kế hệ nhận diện của nhóm 2 theo phân công","khong_thuoc_trach_nhiem":"Không tự thay mẫu nhận diện được duyệt; không tự duyệt in/thi công; không phụ trách sản phẩm nhóm 1","ban_giao_dau_vao":"Nhận nội dung nhóm 2; giao file đến Media/Kênh số/Truyền thông; phối hợp Thiết kế ngoại tuyến phần cố định","kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu, cấp có thẩm quyền duyệt nhận diện"},{"id":"tk-nt","vi_tri":"Chuyên viên thiết kế ngoại tuyến","pham_vi":"TCT – chuyên môn ngoại tuyến dùng chung cả 02 nhóm","chu_tri_dau_ra":"Thiết kế danh sách cố định: biển bảng, trang trí cố định, lễ Tết; giữ quy chuẩn in, danh mục và kiểm nhận diện độc lập","khong_thuoc_trach_nhiem":"Không giữ toàn bộ thiết kế in; không tự nghiệm thu cuối sản phẩm do chính mình thiết kế; không trực tiếp vận hành biển bảng tại cơ sở","ban_giao_dau_vao":"Nhận số đo/ảnh hiện trạng từ Truyền thông cơ sở, yêu cầu Chuyên viên truyền thông; chuyển file kỹ thuật để triển khai","kiem_duyet":"Người kiểm độc lập (nếu tự làm), cấp duyệt biển bảng theo QyĐ.48"},{"id":"md-ac","vi_tri":"Chuyên viên media nhóm 1","pham_vi":"TCT – media nhóm 1; 02 người phân công hệ thống/bệnh viện","chu_tri_dau_ra":"Chủ trì kịch bản phân cảnh, shot-list, quay/dựng, âm thanh, hình ảnh, hậu kỳ kỹ thuật và chuẩn kỹ thuật Media; kiểm kỹ thuật độc lập V2/V3 do Media cơ sở dựng; trực tiếp sản xuất V3 vượt mẫu và V4. Không là người chủ trì kịch bản lời/thoại.","khong_thuoc_trach_nhiem":"Không thay Biên tập viết kịch bản lời/thoại; không thay bác sĩ xác nhận chuyên môn; không thay người có thẩm quyền duyệt phát hành; không trực tiếp vận hành biển bảng, màn hình, phát thanh ở cơ sở.","ban_giao_dau_vao":"Nhận kịch bản đã kiểm từ Biên tập và tư liệu từ Media cơ sở; xuất bản hoàn chỉnh cho Kênh số/Truyền thông","kiem_duyet":"Chỉ kiểm kỹ thuật hình/âm/dựng và tuân thủ B-7/QC-4 của bản dựng khác người làm; không tự duyệt bản dựng do chính mình sản xuất và không duyệt nội dung y khoa hoặc phát hành."},{"id":"md-b","vi_tri":"Chuyên viên media nhóm 2","pham_vi":"TCT – media nhóm 2","chu_tri_dau_ra":"Chủ trì kịch bản phân cảnh, shot-list, quay/dựng, âm thanh, hình ảnh, hậu kỳ kỹ thuật và chuẩn kỹ thuật Media; kiểm kỹ thuật độc lập V2/V3 do Media cơ sở dựng; trực tiếp sản xuất V3 vượt mẫu và V4. Không là người chủ trì kịch bản lời/thoại.","khong_thuoc_trach_nhiem":"Không thay Biên tập viết kịch bản lời/thoại; không thay bác sĩ xác nhận chuyên môn; không thay người có thẩm quyền duyệt phát hành; không trực tiếp vận hành biển bảng, màn hình, phát thanh ở cơ sở.","ban_giao_dau_vao":"Nhận tư liệu Media cơ sở và kịch bản lời nhóm 2; giao file phát hành","kiem_duyet":"Chỉ kiểm kỹ thuật hình/âm/dựng và tuân thủ B-7/QC-4 của bản dựng khác người làm; không tự duyệt bản dựng do chính mình sản xuất và không duyệt nội dung y khoa hoặc phát hành."},{"id":"qc-a","vi_tri":"Chuyên viên quảng cáo và kênh số nhóm 1","pham_vi":"TCT – quảng cáo/kênh số nhóm 1; 02 người phân công hệ thống/bệnh viện","chu_tri_dau_ra":"Chạy quảng cáo trả phí, đăng/quản trị kênh số, lịch gửi nhóm 1, tối ưu theo dữ liệu nền tảng","khong_thuoc_trach_nhiem":"Không quyết định chiến lược thương hiệu, không chốt KPI tài chính chính thức, không sửa dữ liệu gốc/đăng CMS cấu trúc","ban_giao_dau_vao":"Nhận nội dung, thiết kế, media đã duyệt; gắn đo theo hướng dẫn; báo số liệu cho Đo lường và đối soát","kiem_duyet":"Quản lý thương hiệu nghiệm thu lịch; Chuyên viên trưởng quản quyền theo ma trận"},{"id":"qc-b","vi_tri":"Chuyên viên quảng cáo và kênh số nhóm 2","pham_vi":"TCT – quảng cáo/kênh số nhóm 2","chu_tri_dau_ra":"Chạy quảng cáo, quản trị kênh số, lịch đăng/gửi tin của thương hiệu nhóm 2","khong_thuoc_trach_nhiem":"Không thay Truyền thông xử lý báo chí/KOL; không đổi chính sách nền tảng hoặc dữ liệu có cấu trúc website","ban_giao_dau_vao":"Nhận gói sản phẩm nhóm 2 đã duyệt; phản hồi chi phí, Lead về Đo lường","kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu lịch; cấp duyệt kinh phí"},{"id":"dl-1","vi_tri":"Chuyên viên đo lường và đối soát","pham_vi":"TCT – dữ liệu hiệu quả dùng chung","chu_tri_dau_ra":"Đối soát nguồn khách, chi phí, KPI, báo cáo chốt kỳ toàn hệ thống; phát hiện lệch số","khong_thuoc_trach_nhiem":"Không thay Quảng cáo tối ưu tài khoản; không tự sửa dữ liệu nguồn; không thay Quản lý thương hiệu quyết định ngân sách","ban_giao_dau_vao":"Nhận số nền tảng từ Quảng cáo, số tiếp đón/HIS và chứng từ, khóa kỳ và bàn giao báo cáo","kiem_duyet":"Trưởng phòng duyệt bản chốt kỳ; đối soát độc lập"},{"id":"dl-2","vi_tri":"Chuyên viên dữ liệu khách hàng và thị trường","pham_vi":"TCT – dữ liệu khách hàng, thị trường, CRM","chu_tri_dau_ra":"Chủ chất lượng dữ liệu, phân nhóm khách hàng, quyền riêng tư/lịch gửi, khảo sát, yêu cầu nghiệp vụ CRM","khong_thuoc_trach_nhiem":"Không làm thay Đo lường chốt KPI; không vận hành Contact Center; không thay Số hóa lập trình ứng dụng","ban_giao_dau_vao":"Nhận dữ liệu hợp lệ, phân nhóm/kiểm trùng, gửi tiêu chí cho Kênh số/Contact Center đúng quyền","kiem_duyet":"Cấp phụ trách dữ liệu và pháp lý xác nhận điều kiện sử dụng; chưa đủ consent thì chặn"},{"id":"qlsps","vi_tri":"Quản lý sản phẩm số","pham_vi":"TCT – sản phẩm số và đầu mối Số hóa; kiêm Tổ trưởng Tăng trưởng số","chu_tri_dau_ra":"Chủ nghiệp vụ website/App/trang đích, cấu trúc CMS, SEO tự nhiên, thay đổi sản phẩm số; công bố dữ liệu có cấu trúc mảng 43 sau kiểm độc lập","khong_thuoc_trach_nhiem":"Không viết lời thay Biên tập; không làm kỹ thuật thay Phòng Số hóa; không xác nhận dữ liệu gốc; không tự có quyền duyệt chỉ vì kiêm Tổ trưởng","ban_giao_dau_vao":"Nhận nội dung đã duyệt và dữ liệu có xác nhận; gửi yêu cầu kỹ thuật đến Số hóa; nghiệm thu nghiệp vụ, kiểm công bố","kiem_duyet":"Trưởng phòng/cấp có thẩm quyền duyệt thay đổi lớn; nguồn và người kiểm độc lập duyệt dữ liệu"},{"id":"qlml","vi_tri":"Quản lý mạng lưới Marketing cơ sở theo vùng (01 suất dự kiến, chờ phân vùng)","pham_vi":"TCT – quản lý vùng, chỉ khi đã phê duyệt phạm vi","chu_tri_dau_ra":"Giám sát Trưởng nhóm Marketing cơ sở trong vùng danh sách đã duyệt; hỗ trợ đánh giá, chuẩn hóa vận hành","khong_thuoc_trach_nhiem":"Không tự giành chủ Hạng mục của Quản lý thương hiệu; không chỉ đạo chuyên môn ngoài vùng chưa giao. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Nhận báo cáo cơ sở, chuyển nhu cầu và vấn đề lên Chuyên viên trưởng","kiem_duyet":"Chuyên viên trưởng phê duyệt phân công theo văn bản/phạm vi"},{"id":"tn-a","vi_tri":"Trưởng nhóm Marketing cơ sở – bệnh viện nhóm 1","pham_vi":"Bệnh viện nhóm 1 – đầu mối Marketing tại chỗ","chu_tri_dau_ra":"Tiếp nhận yêu cầu khoa phòng, lấy xác nhận nguồn, điều phối nhân sự cơ sở; tin Facebook bệnh viện trong danh mục; kiêm vận hành biển bảng/màn hình/phát thanh nếu cơ sở 02 người","khong_thuoc_trach_nhiem":"Không tự đổi chiến lược/nhận diện/chiến dịch TCT, không tự duyệt bài vượt danh mục; không tự sửa dữ liệu giá/chứng chỉ; chỉ có quyền đăng tin V1 thuộc danh mục Facebook bệnh viện khi có quyền đăng hợp lệ, không tự đăng dịch vụ/giá/khuyến mại/ca bệnh lên bất kỳ kênh nào; không quản trị các kênh khác. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Chuyển thông tin đã xác nhận cho TCT theo một luồng; nhận kế hoạch đã duyệt; trả ảnh, nhật ký triển khai Gửi kế hoạch, tải việc, tiến độ và KPI lên Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở; nhận kiểm chuẩn Truyền thông từ tuyến Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số qua đầu mối điều phối.","kiem_duyet":"Ban Giám đốc cơ sở xác nhận thông tin gốc; TCT/cấp duyệt nội dung theo phân cấp Trưởng nhóm nhận quản lý trực tiếp và đánh giá từ Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở; không do Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số đánh giá song song."},{"id":"tn-b","vi_tri":"Trưởng nhóm Marketing cơ sở – bệnh viện nhóm 2 (kiêm nhiệm truyền thông cơ sở)","pham_vi":"Bệnh viện nhóm 2 – đầu mối tại chỗ kiêm PR","chu_tri_dau_ra":"Điều phối nguồn khoa phòng, tổ chức hiện trường và quan hệ cộng đồng; kiểm/vận hành biển bảng, màn hình, phát thanh tại cơ sở 02 người; kiêm triển khai decor, theo dõi hiện trạng biển bảng theo tháng, ảnh nghiệm thu và báo cáo theo phân quyền","khong_thuoc_trach_nhiem":"Không chuyển việc kiểm định kỳ thiết bị cho Media; không thay chuyên viên Truyền thông TCT quyết định lịch/hợp đồng hệ thống; chỉ có quyền đăng tin V1 thuộc danh mục Facebook bệnh viện khi có quyền đăng hợp lệ, không tự đăng dịch vụ/giá/khuyến mại/ca bệnh lên bất kỳ kênh nào; không quản trị các kênh khác. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Bàn giao thông tin đã xác nhận, tư liệu, nhật ký nghiệm thu cho TCT nhóm 2 Gửi kế hoạch, tải việc, tiến độ và KPI lên Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở; nhận kiểm chuẩn Truyền thông từ tuyến Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số qua đầu mối điều phối.","kiem_duyet":"Ban Giám đốc cơ sở xác nhận thực tế; TCT nghiệm thu sản phẩm/lịch Trưởng nhóm nhận quản lý trực tiếp và đánh giá từ Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở; không do Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số đánh giá song song."},{"id":"mdcs-a","vi_tri":"Chuyên viên Marketing cơ sở – media, bệnh viện nhóm 1","pham_vi":"Bệnh viện nhóm 1 – Media tại chỗ","chu_tri_dau_ra":"Quay, chụp, thu thập tư liệu hiện trường; cắt dựng V1 và sản xuất V2/V3 thuộc mẫu B-7 theo kịch bản lời đã có của Biên tập đúng nhóm và phân cảnh do Media TCT cung cấp; lưu nguồn, giấy đồng ý và giờ công; V3 vượt mẫu và V4 chuyển Media TCT.","khong_thuoc_trach_nhiem":"Không viết kịch bản lời, không phê duyệt lời/chuyên môn/phát hành; không chủ trì kiểm biển bảng, vận hành màn hình, phát thanh hoặc chụp ảnh nghiệp vụ nghiệm thu công trình; không tự làm V4. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Nhận lịch/kịch bản qua cổng; phối hợp bác sĩ, nhân vật và địa điểm; giao tư liệu gốc, căn cứ sử dụng hình ảnh, bản dựng V2/V3 và nhật ký giờ công riêng cho TCT.","kiem_duyet":"Media TCT đúng nhóm kiểm kỹ thuật bản dựng; bác sĩ/đơn vị chuyên môn xác nhận y khoa; người có thẩm quyền riêng duyệt phát hành. Không tự duyệt sản phẩm mình làm."},{"id":"mdcs-b","vi_tri":"Chuyên viên Marketing cơ sở – media, bệnh viện nhóm 2","pham_vi":"Bệnh viện nhóm 2 – Media tại chỗ","chu_tri_dau_ra":"Quay, chụp, thu thập tư liệu hiện trường; cắt dựng V1 và sản xuất V2/V3 thuộc mẫu B-7 theo kịch bản lời đã có của Biên tập đúng nhóm và phân cảnh do Media TCT cung cấp; lưu nguồn, giấy đồng ý và giờ công; V3 vượt mẫu và V4 chuyển Media TCT.","khong_thuoc_trach_nhiem":"Không viết kịch bản lời, không phê duyệt lời/chuyên môn/phát hành; không chủ trì kiểm biển bảng, vận hành màn hình, phát thanh hoặc chụp ảnh nghiệp vụ nghiệm thu công trình; không tự làm V4. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Nhận lịch/kịch bản qua cổng; phối hợp bác sĩ, nhân vật và địa điểm; giao tư liệu gốc, căn cứ sử dụng hình ảnh, bản dựng V2/V3 và nhật ký giờ công riêng cho TCT.","kiem_duyet":"Media TCT đúng nhóm kiểm kỹ thuật bản dựng; bác sĩ/đơn vị chuyên môn xác nhận y khoa; người có thẩm quyền riêng duyệt phát hành. Không tự duyệt sản phẩm mình làm."},{"id":"qhcs","vi_tri":"Chuyên viên Marketing cơ sở – truyền thông, bệnh viện nhóm 1","pham_vi":"Bệnh viện nhóm 1 đủ 03 người – Quan hệ công chúng tại chỗ","chu_tri_dau_ra":"Chủ trì tổ chức sự kiện và quan hệ cộng đồng tại cơ sở; kiểm tra hiện trạng biển bảng hằng tuần, tổng hợp hằng tháng, báo hỏng trong ngày, chụp ảnh và số đo, ảnh nghiệm thu thi công/tuân thủ nhận diện; trực tiếp vận hành màn hình và phát thanh theo lịch đã duyệt, ghi nhật ký. Cơ sở 02 người do Trưởng nhóm kiêm nhiệm.","khong_thuoc_trach_nhiem":"Không thiết kế mẫu, không viết kịch bản phát thanh chính thức, không ký hợp đồng truyền thông hệ thống, không duyệt lịch phát mới, ngân sách hoặc nghiệm thu tài chính; không thay Phòng Nhân lực/Công đoàn chủ trì các hoạt động nội bộ ngoài Marketing.; không viết lời, thiết kế, đăng bài/quản trị kênh số hoặc có quyền phê duyệt phát hành chỉ vì đang vận hành thiết bị phát. Không chủ trì soạn, quản lý phiên bản hoặc phê duyệt kịch bản tư vấn Contact Center; chỉ cung cấp nội dung đã duyệt, thông tin được xác nhận trong đúng phạm vi phụ trách.","ban_giao_dau_vao":"Nhận lịch/mẫu từ Chuyên viên Truyền thông TCT đúng nhóm; bàn giao báo cáo kiểm tra biển bảng hằng tháng, ảnh hiện trạng, ảnh nghiệm thu trang trí, màn hình, phát thanh và sự kiện cho Truyền thông TCT và Thiết kế ngoại tuyến.","kiem_duyet":"Ban Giám đốc cơ sở duyệt phần địa phương; TCT duyệt theo phạm vi/mẫu"},{"id":"dmpk","vi_tri":"Đầu mối kiêm nhiệm tại phòng khám (nhóm 1)","pham_vi":"Phòng khám nhóm 1 – đầu mối kiêm nhiệm","chu_tri_dau_ra":"Nhận thông tin, ảnh, lịch, sự kiện, nhu cầu tại phòng khám; chuyển một đầu mối về Marketing TCT","khong_thuoc_trach_nhiem":"Không là bộ máy marketing độc lập, không tự đăng/sửa dữ liệu có điều kiện, không tự phát hành sản phẩm khi thiếu duyệt","ban_giao_dau_vao":"Gửi nguồn có xác nhận của phòng khám cho Quản lý thương hiệu nhóm 1/Chuyên viên trưởng","kiem_duyet":"Đơn vị chủ dữ liệu/phòng khám xác nhận; TCT duyệt sản phẩm theo quy trình"}],"doi_chieu_vi_tri_gan_nhau_17112026":[{"cap_vi_tri":"Quản lý thương hiệu ↔ Chuyên viên truyền thông","nguoi_1":"Quản lý thương hiệu nắm mục tiêu, KPI, ngân sách và yêu cầu của Hạng mục","nguoi_2":"Chuyên viên truyền thông lập/triển khai PR, báo chí, KOL/KOC, tài trợ và ngoại tuyến, lịch nội viện","diem_ban_giao":"Truyền thông báo đầu ra và nghiệm thu tại chỗ; Quản lý thương hiệu xác nhận phù hợp mục tiêu; cấp có thẩm quyền duyệt"},{"cap_vi_tri":"Quản lý thương hiệu nhóm 1 ↔ nhóm 2","nguoi_1":"Mỗi người có kết quả, ngân sách, định vị riêng theo nhóm đã chốt","nguoi_2":"Việc liên quan hai nhóm: Trưởng phòng phân chủ nhiệm vụ và tỷ lệ kết quả, không mặc định nhóm 1 chủ trì tất cả","diem_ban_giao":"Hạng mục liên nhóm phải có phiếu chỉ rõ chủ việc, chủ chi phí, KPI và phần mỗi nhóm"},{"cap_vi_tri":"Tổ trưởng Truyền thông và Thương hiệu ↔ Quản lý thương hiệu nhóm 1","nguoi_1":"Quản lý thương hiệu nhóm 2 kiêm Tổ trưởng, điều phối lịch và xung đột nguồn lực tổ 04 người","nguoi_2":"Quản lý thương hiệu nhóm 1 vẫn tự giữ kết quả nhóm 1; Tổ trưởng không có quyền duyệt sản phẩm/nhân sự nhóm 1 chỉ nhờ kiêm nhiệm","diem_ban_giao":"Xung đột chuyên môn, ưu tiên ngân sách, quyền đánh giá: chuyển Trưởng phòng"},{"cap_vi_tri":"Chuyên viên truyền thông ↔ Chuyên viên biên tập","nguoi_1":"Truyền thông viết thông cáo, bài gửi báo, điều phối đối tác/PR; giữ thông điệp khi phát ngôn","nguoi_2":"Biên tập viết bài kênh sở hữu, nội dung y khoa, kịch bản lời, bài website; kiểm nguồn nội dung","diem_ban_giao":"Nội dung truyền thông lên kênh có đầu ra được kiểm và nghiệm thu; không chuyển toàn bộ thông cáo sang Biên tập"},{"cap_vi_tri":"Biên tập ↔ Media TCT","nguoi_1":"Biên tập viết lời/câu chữ có nội dung chuyên môn, gói dịch vụ, giá, ưu đãi","nguoi_2":"Media viết phân cảnh và tổ chức quay, dựng, chỉnh ảnh/video; kịch bản hình không thay trách nhiệm lời","diem_ban_giao":"Bản lời chuyên môn đủ xác nhận mới quay/phát hành; Media không tự sửa cam kết y khoa"},{"cap_vi_tri":"Media TCT ↔ Thiết kế TCT","nguoi_1":"Media sở hữu ảnh chụp, dựng phim, chỉnh màu và hậu kỳ video","nguoi_2":"Thiết kế tạo bố cục, typography, banner, đồ họa tĩnh/động theo phân công","diem_ban_giao":"Sản phẩm có cả hai phần cần giao đầu ra rõ: file ảnh/video gốc → file đồ họa → bản kiểm cuối"},{"cap_vi_tri":"Thiết kế nhóm ↔ Thiết kế ngoại tuyến","nguoi_1":"Thiết kế nhóm làm sản phẩm số + in không nằm danh sách cố định; nhận diện thương hiệu của nhóm","nguoi_2":"Thiết kế ngoại tuyến làm biển bảng, vật phẩm cố định, trang trí lễ Tết, giữ quy chuẩn in và kiểm nhận diện","diem_ban_giao":"Không dùng vật liệu in làm tiêu chí duy nhất; xác định theo danh mục cố định mảng 6/15.2"},{"cap_vi_tri":"Quảng cáo & kênh số ↔ Truyền thông","nguoi_1":"Quảng cáo giữ tài khoản, lịch đăng, ngân sách quảng cáo trả phí, kỹ thuật nền tảng, phân phối số","nguoi_2":"Truyền thông giữ quan hệ báo chí, KOL/KOC, hợp đồng/nghĩa vụ PR, ngoại tuyến","diem_ban_giao":"Với KOL: Truyền thông chủ người/hợp đồng; Quảng cáo chủ quảng bá trả phí; Quản lý thương hiệu chủ KPI"},{"cap_vi_tri":"Quảng cáo & kênh số ↔ Quản lý sản phẩm số","nguoi_1":"Quảng cáo quản trị kênh social, tài khoản quảng cáo, Trang doanh nghiệp trên Google và trang đích quảng cáo theo mẫu","nguoi_2":"Quản lý sản phẩm số chủ nghiệp vụ website/App, CMS cấu trúc và SEO tự nhiên; Phòng Số hóa làm kỹ thuật","diem_ban_giao":"Không tự chuyển trách nhiệm đăng/sửa dữ liệu người hành nghề, bảng giá sang người chạy quảng cáo"},{"cap_vi_tri":"Quản lý sản phẩm số ↔ Biên tập","nguoi_1":"Biên tập chịu chất lượng câu chữ và bằng chứng nội dung trên website/App","nguoi_2":"Quản lý sản phẩm số chịu cấu trúc, triển khai CMS/dữ liệu định dạng, nghiệm thu và công bố sau đủ xác nhận","diem_ban_giao":"Một thay đổi nguồn có hai trường: trường dữ liệu có cấu trúc do Quản lý sản phẩm số; mô tả, bài viết do Biên tập"},{"cap_vi_tri":"Đo lường và đối soát ↔ Quảng cáo","nguoi_1":"Quảng cáo tối ưu theo dữ liệu nền tảng hàng ngày, cung cấp log chi phí/Lead","nguoi_2":"Đo lường độc lập đối chiếu tiếp đón, HIS, CRM, chi phí và chốt báo cáo KPI chính thức","diem_ban_giao":"Không dùng số quản trị quảng cáo làm số doanh thu/KPI chính thức khi chưa đối soát"},{"cap_vi_tri":"Đo lường và đối soát ↔ Dữ liệu khách hàng & thị trường","nguoi_1":"Đo lường chịu chốt số, KPI, đối soát và báo cáo hiệu quả","nguoi_2":"Dữ liệu khách hàng chịu chất lượng tệp, bảo vệ dữ liệu, phân nhóm, lịch gửi, khảo sát và CRM","diem_ban_giao":"Giai đoạn chưa đủ nhân sự có thể kiêm nhưng trách nhiệm chốt số và kiểm dữ liệu tách hai công việc"},{"cap_vi_tri":"Quản lý sản phẩm số ↔ Dữ liệu khách hàng/CRM","nguoi_1":"Quản lý sản phẩm số là đầu mối website/App và công việc kỹ thuật với Phòng Số hóa","nguoi_2":"Dữ liệu khách hàng là chủ nghiệp vụ dữ liệu Marketing/CRM và yêu cầu chức năng liên quan khách hàng","diem_ban_giao":"Không chuyển quyền vận hành tổng đài, tư vấn sang Marketing; CRM liên phòng do Trưởng phòng chủ trì theo khung"},{"cap_vi_tri":"Chuyên viên trưởng ↔ Tổ trưởng các tổ","nguoi_1":"Chuyên viên trưởng giữ chính sách, quy trình, phân công liên tổ/chi nhánh và xử lý xung đột","nguoi_2":"Tổ trưởng kiêm nhiệm điều phối công việc trong phạm vi được phân công, không mặc nhiên duyệt nội dung/chi phí","diem_ban_giao":"Yêu cầu ngoài phạm vi, người thay, vượt giờ hoặc trùng người chuyển Chuyên viên trưởng rồi Trưởng phòng"},{"cap_vi_tri":"Người giữ chuẩn ↔ Người làm sản phẩm","nguoi_1":"Người giữ chuẩn cập nhật tiêu chí, quy trình, hướng dẫn và đào tạo","nguoi_2":"Người thực hiện chịu sản phẩm cụ thể; người kiểm phải độc lập với người làm","diem_ban_giao":"Không đồng nhất chủ trì văn bản/quy trình với chủ trì mọi công việc nghiệp vụ (Phụ lục 8)"}],"ma_tran_TCT_chi_nhanh_17112026":[{"so":"01","dau_viec":"Kế hoạch Hạng mục/chương trình","TCT":"Quản lý thương hiệu của nhóm lập mục tiêu, ngân sách, KPI, hồ sơ và giao sản phẩm","chi_nhanh":"Trưởng nhóm/đầu mối phòng khám cung cấp nhu cầu, năng lực tiếp nhận, lịch bác sĩ; triển khai hiện trường","xac_nhan_duyet":"Trưởng phòng/cấp có thẩm quyền duyệt kế hoạch; chuyên môn xác nhận năng lực cung ứng","quy_tac_chan":"Không có chủ Hạng mục, KPI, chủ chi phí, đơn vị triển khai → không mở Hạng mục"},{"so":"02","dau_viec":"Bài viết/chương trình có nội dung y tế","TCT":"Biên tập nhóm viết; bác sĩ xác nhận chuyên môn; kiểm pháp lý theo tầng; Quản lý thương hiệu nghiệm thu mục tiêu","chi_nhanh":"Trưởng nhóm cung cấp hồ sơ bác sĩ, căn cứ, đề bài, ảnh đồng ý; không tự duyệt chuyên môn y khoa thay bác sĩ","xac_nhan_duyet":"Kiểm độc lập và người duyệt nội dung theo mục 14.16","quy_tac_chan":"Thiếu nguồn/chuyên môn đồng ý hoặc chưa kiểm pháp lý → chặn phát hành"},{"so":"03","dau_viec":"Tin hoạt động trong ngày tại bệnh viện","TCT":"TCT cung cấp danh mục tin chuẩn, mẫu, ranh giới pháp lý; bài ngoài danh mục do Biên tập xử lý","chi_nhanh":"Trưởng nhóm đăng tin V1 đúng danh mục lên Facebook bệnh viện khi có quyền; Media cơ sở cung cấp ảnh/clip và chỉ đăng thay nếu có phân quyền hợp lệ, không tự phát hành ở các kênh khác.","xac_nhan_duyet":"Danh sách kiểm tra tự động và nhật ký; nội dung ngoài danh mục phải qua quy trình duyệt","quy_tac_chan":"Chưa đủ quyền đăng, không khớp danh mục V1, nguồn không hợp lệ hoặc có nội dung nhạy cảm → chuyển duyệt nội dung, không đăng nhanh."},{"so":"04","dau_viec":"Ảnh, video V2/V3 địa phương","TCT":"Biên tập đúng nhóm chủ trì lời mọi V2/V3; Media TCT đúng nhóm viết phân cảnh, giữ bộ mẫu B-7, kiểm kỹ thuật bản dựng và nhận phần vượt mẫu; không mặc định dựng lại toàn bộ.","chi_nhanh":"Media cơ sở chủ trì quay/dựng V2/V3 thuộc mẫu B-7 dựa trên lời của Biên tập và phân cảnh của Media TCT; gửi tư liệu, bản dựng, giấy đồng ý và nhật ký giờ công.","xac_nhan_duyet":"Media TCT kiểm kỹ thuật khi cơ sở dựng; bác sĩ xác nhận nội dung y khoa; cấp duyệt phát hành theo rủi ro nội dung, không theo nhãn V2/V3.","quy_tac_chan":"Thiếu kịch bản cần thiết, căn cứ sử dụng hình ảnh, bản dựng được kiểm độc lập hoặc cấp duyệt phát hành → chặn; không chuyển việc cho TCT chỉ vì sản phẩm đăng kênh TCT"},{"so":"05","dau_viec":"Video chiến dịch V4/phim thương hiệu","TCT":"Biên tập đúng nhóm viết toàn bộ lời/thông điệp; Media TCT lập phân cảnh, chủ trì hậu kỳ V4; Thiết kế phụ trách đồ họa.","chi_nhanh":"Media cơ sở cung cấp footage và sắp xếp nhân vật, địa điểm, giấy đồng ý","xac_nhan_duyet":"Đơn vị chuyên môn, người nghiệm thu và cấp duyệt theo quy trình","quy_tac_chan":"Không giao Media cơ sở tự làm/duyệt video V4"},{"so":"06","dau_viec":"Ấn phẩm thiết kế số/tờ rơi không cố định","TCT":"Thiết kế theo nhóm chịu sản phẩm; Biên tập giao chữ đã kiểm","chi_nhanh":"Trưởng nhóm/đầu mối phòng khám gửi yêu cầu, số lượng, vị trí, ảnh hiện trường","xac_nhan_duyet":"Người gửi yêu cầu nghiệm thu, kiểm độc lập và cấp duyệt phù hợp","quy_tac_chan":"Không chuyển sang Thiết kế ngoại tuyến chỉ vì sản phẩm được in"},{"so":"07","dau_viec":"Biển bảng, bảng hiệu, trang trí cố định","TCT":"Truyền thông TCT giữ kế hoạch, thi công, nghiệm thu; Thiết kế ngoại tuyến giữ mẫu/file in/quy chuẩn","chi_nhanh":"Truyền thông cơ sở kiểm hiện trạng, gửi số đo, ảnh, báo hỏng, giám sát tại chỗ; cơ sở 02 người Trưởng nhóm kiêm","xac_nhan_duyet":"Quyết định 48 và thẩm quyền chi/thi công; kiểm file độc lập","quy_tac_chan":"Media cơ sở không chủ trì kiểm biển/ảnh nghiệm thu; thiếu ảnh hiện trạng, số đo, kiểm file độc lập hoặc duyệt theo QyĐ.48 → dừng thi công."},{"so":"08","dau_viec":"Màn hình nội viện","TCT":"Truyền thông TCT của nhóm giữ lịch; Biên tập/Thiết kế/Media TCT cung cấp sản phẩm đã duyệt","chi_nhanh":"Truyền thông cơ sở hoặc Trưởng nhóm kiêm vận hành phát, kiểm âm thanh/hình và báo lỗi","xac_nhan_duyet":"Chuyên viên truyền thông nghiệm thu lịch và nội dung; cấp duyệt phát hành theo loại","quy_tac_chan":"Media cơ sở không phải người vận hành; không phát file chưa duyệt"},{"so":"09","dau_viec":"Phát thanh nội viện","TCT":"Truyền thông TCT chốt lịch; Biên tập soạn kịch bản mẫu; Media TCT thu âm khi cần","chi_nhanh":"Truyền thông cơ sở (03 người) hoặc Trưởng nhóm cơ sở (02 người) phát theo lịch, ghi nhật ký","xac_nhan_duyet":"Trưởng nhóm kiểm áp dụng đúng mẫu; kiểm nội dung theo phân cấp","quy_tac_chan":"Không để Media cơ sở là người chịu trách nhiệm phát thanh"},{"so":"10","dau_viec":"Sự kiện địa phương ngoài Hạng mục","TCT":"Truyền thông TCT tư vấn chuẩn PR khi cần; Tổ sản xuất nhận yêu cầu sản phẩm","chi_nhanh":"Truyền thông cơ sở hoặc Trưởng nhóm kiêm chủ trì tổ chức sự kiện, địa điểm và đối tác tại chỗ","xac_nhan_duyet":"Ban Giám đốc cơ sở duyệt kế hoạch/chi phí, nội dung theo phân cấp","quy_tac_chan":"Có báo chí/cấp hệ thống thì báo lên Trưởng phòng trước triển khai"},{"so":"11","dau_viec":"Sự kiện cơ sở nằm trong Hạng mục","TCT":"Quản lý thương hiệu chủ kết quả/đầu ra, Truyền thông chủ phần PR, Tổ Nội dung sản xuất","chi_nhanh":"Truyền thông cơ sở chủ phần tổ chức, hậu cần và ảnh nghiệm thu","xac_nhan_duyet":"BGĐ cơ sở/cấp có thẩm quyền duyệt theo phạm vi, Quản lý thương hiệu nghiệm thu Hạng mục","quy_tac_chan":"Không chuyển toàn bộ hậu cần sang Media/Thiết kế hoặc báo chí sang Biên tập"},{"so":"12","dau_viec":"Hội nghị/sự kiện cấp hệ thống","TCT":"Quản lý thương hiệu nhóm chủ Hạng mục; Truyền thông liên hệ báo chí; Tổ sản xuất làm nội dung","chi_nhanh":"Marketing cơ sở cùng nhóm hỗ trợ hiện trường; nơi không có Marketing cơ sở: Quản lý thương hiệu điều phối hậu cần","xac_nhan_duyet":"Trưởng phòng/Ban Tổng Giám đốc theo thẩm quyền","quy_tac_chan":"Trường hợp trụ sở đặt tại cơ sở của nhóm khác vẫn xử lý theo chủ Hạng mục, không tự động đổi nhóm"},{"so":"13","dau_viec":"Báo chí/khủng hoảng/mạo danh","TCT":"Truyền thông TCT đúng nhóm chủ phát hiện/xác minh/đề xuất; Quảng cáo xử lý báo cáo vi phạm nền tảng","chi_nhanh":"Cơ sở và Contact Center báo tin, lưu ảnh/bằng chứng, không tự phát ngôn vượt thẩm quyền","xac_nhan_duyet":"Trưởng phòng/cấp được ủy quyền duyệt thông điệp; Pháp chế xử lý phần cơ quan nhà nước","quy_tac_chan":"Không tự trả lời vụ việc nhạy cảm từ tài khoản cơ sở khi chưa có chỉ đạo"},{"so":"14","dau_viec":"KOL/KOC","TCT":"Truyền thông TCT chọn, thẩm định, giữ quan hệ/hợp đồng; Quảng cáo giữ chạy trả phí; Quản lý thương hiệu chủ KPI","chi_nhanh":"Cơ sở xác nhận khả năng tiếp nhận, điều phối nhân vật/địa điểm tại chỗ","xac_nhan_duyet":"Quản lý thương hiệu và cấp duyệt chi phí/nội dung theo phân cấp","quy_tac_chan":"Không giao bộ phận quảng cáo tự ký hợp đồng PR"},{"so":"15","dau_viec":"Bài đăng và quảng cáo số","TCT":"Quảng cáo & kênh số nhóm sở hữu tài khoản/lịch đăng và tối ưu; Biên tập/Thiết kế/Media giao sản phẩm đã duyệt","chi_nhanh":"Trưởng nhóm gửi đề bài và kiểm hiện trường; riêng tin trong ngày theo quy định","xac_nhan_duyet":"Quản lý thương hiệu nghiệm thu lịch, cấp duyệt sản phẩm và chi phí","quy_tac_chan":"Chưa duyệt nội dung hoặc thiếu nguồn, quyền kênh → không đăng/chạy"},{"so":"16","dau_viec":"Trang doanh nghiệp trên Google","TCT":"Quảng cáo & kênh số nhóm chịu cập nhật hồ sơ Trang doanh nghiệp trên Google","chi_nhanh":"Trưởng nhóm cơ sở gửi thay đổi có xác nhận của đơn vị chủ dữ liệu","xac_nhan_duyet":"Kiểm khớp nguồn, phê duyệt nội dung theo phân cấp","quy_tac_chan":"Không tự sửa giờ hoạt động/điện thoại theo lời nhắn miệng"},{"so":"17","dau_viec":"Website: bài viết, mô tả dịch vụ","TCT":"Biên tập nhóm chịu câu chữ và nguồn; Quản lý sản phẩm số quản trị luồng CMS, SEO/nghiệp vụ","chi_nhanh":"Trưởng nhóm gửi thông tin và xác nhận chuyên môn, đối chiếu cơ sở","xac_nhan_duyet":"Bác sĩ/cấp duyệt xác nhận; người nhập không tự xác nhận nguồn","quy_tac_chan":"Không công bố dữ liệu có điều kiện chưa được xác nhận"},{"so":"18","dau_viec":"Website: giá, người hành nghề, kỹ thuật/dịch vụ được phép","TCT":"Quản lý sản phẩm số đối chiếu bộ chứng từ, nhập/công bố dữ liệu có cấu trúc sau kiểm độc lập; Pháp chế kiểm điều kiện","chi_nhanh":"Kế toán/giá, Nhân lực/chuyên môn, Pháp chế cấp và xác nhận nguồn; Trưởng nhóm chuyển một lần đủ hồ sơ; Ban Giám đốc cơ sở xác nhận hiệu lực","xac_nhan_duyet":"Nguồn dữ liệu và người kiểm độc lập duyệt trước công bố; không giao Biên tập tự sửa số liệu","quy_tac_chan":"Thiếu bản nguồn/đã hết hạn/sai với dữ liệu được phép → chặn công bố"},{"so":"19","dau_viec":"Lịch bác sĩ trước/sau HIS","TCT":"Biên tập nhóm cập nhật nội dung hiển thị trước kết nối; Quản lý sản phẩm số kiểm nguồn đồng bộ khi đã có HIS","chi_nhanh":"Đơn vị chủ dữ liệu/lịch bác sĩ xác nhận từng thay đổi; Trưởng nhóm chuyển có chứng cứ","xac_nhan_duyet":"Chủ dữ liệu xác nhận, kiểm độc lập trước công bố","quy_tac_chan":"Đã kết nối HIS thì không ghi đè thủ công dữ liệu đồng bộ"},{"so":"20","dau_viec":"CRM, dữ liệu khách hàng","TCT":"Dữ liệu khách hàng là chủ nghiệp vụ Marketing CRM; Số hóa/Công nghệ lập trình theo phạm vi; Chuyên viên trưởng giữ quy trình phần mềm Marketing","chi_nhanh":"Cơ sở, tiếp đón, Contact Center cung cấp dữ liệu theo quyền hợp pháp, không tạo tệp ngoài luồng","xac_nhan_duyet":"Trưởng phòng chủ dự án; quyền sử dụng dữ liệu theo quy định","quy_tac_chan":"Thiếu căn cứ xử lý dữ liệu/đồng ý phù hợp → không nhập/gửi"},{"so":"21","dau_viec":"Tiếp nhận đa kênh và kịch bản tư vấn","TCT":"Contact Center tập trung chủ trì xây dựng, quản lý phiên bản, đào tạo và vận hành kịch bản tư vấn. Marketing TCT chỉ cung cấp thông điệp/chương trình đã duyệt, tiêu chí Lead hợp lệ.","chi_nhanh":"Bộ phận dịch vụ/tiếp đón cơ sở lập đầu vào, đề xuất tình huống và câu trả lời; bác sĩ/chuyên môn xác nhận nội dung y tế; đầu mối có thẩm quyền xác nhận gói, giá, điều kiện, lịch. Marketing cơ sở hỗ trợ thông tin chương trình, không chủ trì viết kịch bản nghiệp vụ.","xac_nhan_duyet":"Cơ sở/chuyên môn xác nhận nguồn; người được phân quyền ở đơn vị chủ quản Contact Center duyệt kịch bản nghiệp vụ; Marketing kiểm tra thông điệp truyền thông khi liên quan.","quy_tac_chan":"Không giao Biên tập/Truyền thông Marketing quyền tự soạn hoặc duyệt kịch bản nghiệp vụ; thiếu xác nhận/duyệt, hết hiệu lực hoặc có câu hỏi vượt chuyên môn → không tư vấn, chuyển tuyến."},{"so":"22","dau_viec":"Thủ tục pháp lý quảng cáo","TCT":"Pháp chế chủ hồ sơ pháp lý, yêu cầu thành phần/nộp/theo dõi; Biên tập Marketing giao nội dung, phiên bản và minh chứng","chi_nhanh":"Bác sĩ/chủ cơ sở cung cấp xác nhận chuyên môn, giấy phép và thông tin nền","xac_nhan_duyet":"Trưởng phòng duyệt phần Marketing; Pháp chế kiểm điều kiện và hồ sơ; cơ quan nhà nước xử lý theo thủ tục","quy_tac_chan":"Marketing không tự nộp thay Pháp chế khi chưa có phân quyền"},{"so":"23","dau_viec":"Thu thập số liệu, báo cáo KPI","TCT":"Đo lường và đối soát chốt kỳ; Quảng cáo cung cấp số nền tảng; Quản lý thương hiệu chịu kết quả Hạng mục","chi_nhanh":"Tiếp đón/HIS cung cấp nguồn khách; Trưởng nhóm cơ sở kiểm bằng chứng và chênh lệch","xac_nhan_duyet":"Trưởng phòng duyệt số liệu chốt kỳ","quy_tac_chan":"Không chốt KPI từ ảnh chụp quảng cáo khi chưa đối soát"},{"so":"24","dau_viec":"Kiểm nhận diện toàn hệ thống","TCT":"Thiết kế ngoại tuyến lập lịch/kiểm độc lập; Truyền thông TCT theo dõi khắc phục biển bảng; Thiết kế nhóm kiểm thay nếu file do Thiết kế ngoại tuyến tự làm","chi_nhanh":"Truyền thông cơ sở hoặc Trưởng nhóm kiêm cung cấp ảnh, số đo, vị trí, nhật ký","xac_nhan_duyet":"Quản lý thương hiệu nhóm nghiệm thu biện pháp khắc phục","quy_tac_chan":"Người làm không tự kiểm cuối sản phẩm của mình"},{"so":"25","dau_viec":"Tuyển dụng, truyền thông nội bộ","TCT":"Nhân lực/Hành chính cung cấp chủ trương; Biên tập/Thiết kế/Media nhóm làm nội dung; Quảng cáo nhóm đăng; Truyền thông phụ trách tương tác nội bộ theo nhóm","chi_nhanh":"Trưởng nhóm cơ sở lấy thông tin thực tế, hỗ trợ truyền thông tại bệnh viện","xac_nhan_duyet":"Đơn vị chủ trì nội dung và cấp duyệt sản phẩm","quy_tac_chan":"Không coi Marketing là chủ điều kiện tuyển dụng hay chính sách nhân sự"},{"so":"26","dau_viec":"Nhà cung cấp, hồ sơ mua sắm","TCT":"Quản lý thương hiệu nhóm chủ hồ sơ Hạng mục/chi trong hạn mức; Truyền thông khảo sát thi công/PR; Thiết kế ngoại tuyến kiểm file; Đo lường cộng nhu cầu","chi_nhanh":"Cơ sở cung cấp đo đạc, xác nhận khối lượng và hiện trạng, phối hợp nghiệm thu","xac_nhan_duyet":"Tài chính – Kế hoạch và cấp có thẩm quyền theo quy định mua sắm","quy_tac_chan":"Không tự ký/chi khi chưa đủ thẩm quyền, hợp đồng, chứng từ"},{"so":"27","dau_viec":"Tài trợ thương hiệu và từ thiện","TCT":"Truyền thông của nhóm chủ hồ sơ tài trợ có đối ứng; Quản lý thương hiệu chủ tài trợ trong Hạng mục; không có đối ứng: Tổ Công tác xã hội","chi_nhanh":"Truyền thông cơ sở chủ tài trợ địa phương trong phạm vi được duyệt","xac_nhan_duyet":"BGĐ cơ sở, Trưởng phòng/BTGĐ tùy loại/giá trị","quy_tac_chan":"Không đưa từ thiện không đối ứng vào KPI Marketing như tài trợ truyền thông"},{"so":"28","dau_viec":"Phòng khám – quy trình một đầu mối","TCT":"Quản lý thương hiệu nhóm 1 tiếp nhận yêu cầu, chia cho chuyên môn TCT; Chuyên viên trưởng hỗ trợ chuẩn","chi_nhanh":"Đầu mối kiêm nhiệm tại từng phòng khám gửi nội dung/ảnh/nhu cầu có xác nhận của phòng khám","xac_nhan_duyet":"TCT duyệt sản phẩm; phòng khám xác nhận thông tin gốc","quy_tac_chan":"Không tạo một quy trình, quyền đăng, bộ mẫu riêng không theo hệ thống"},{"so":"29","dau_viec":"Nguyên Phúc – Trưởng nhóm kiêm Truyền thông nhận nhu cầu video V3","TCT":"Quản lý thương hiệu nhóm 2 xác lập mục tiêu; CVT Nội dung – Cơ sở kiểm tải và chuyển Trưởng nhóm; Biên tập/Media TCT đúng nhóm hướng dẫn sản xuất","chi_nhanh":"Trưởng nhóm Nguyên Phúc bố trí bác sĩ, hiện trường, media, tư liệu; cùng một phiếu việc; kiêm truyền thông không tạo lệnh từ CVT Truyền thông – Số","xac_nhan_duyet":"Bác sĩ xác nhận y khoa; biên tập/media kiểm độc lập; cấp có thẩm quyền duyệt phát hành, kênh số đúng nhóm đăng","quy_tac_chan":"Thiếu bác sĩ xác nhận hoặc có hai nguồn giao trực tiếp → dừng/chuyển CVT Nội dung – Cơ sở"},{"so":"30","dau_viec":"Thái Thượng Hoàng – Trưởng nhóm kiêm Truyền thông xử lý OOH","TCT":"QLTH Nhóm 2 xác lập mục tiêu; Truyền thông TCT/CVT Truyền thông – Số duyệt chuẩn nghiệp vụ; CVT Nội dung – Cơ sở chốt tải của Trưởng nhóm","chi_nhanh":"Trưởng nhóm bệnh viện cung cấp vị trí, số đo, kiểm thi công, chụp ảnh và vận hành theo lịch duyệt; media chỉ ghi hình theo nhiệm vụ sản xuất","xac_nhan_duyet":"Thiết kế kiểm file; cơ sở xác nhận hiện trạng; QLTH nghiệm thu mục tiêu; duyệt chi và phát hành theo thẩm quyền","quy_tac_chan":"CVT Truyền thông – Số không tự đổi lịch Trưởng nhóm; thiếu thiết kế đạt chuẩn, xác nhận chuyên môn hoặc duyệt chi → chặn"},{"so":"31","dau_viec":"Bệnh viện chuyên khoa – phát thanh nội viện ngoài lịch","TCT":"Truyền thông TCT/CVT Truyền thông – Số kiểm bản lời, định dạng, lịch và quy tắc phát; CVT Nội dung – Cơ sở điều phối khi phát sinh thêm tải","chi_nhanh":"Trưởng nhóm kiêm Truyền thông chỉ phát bản đã duyệt, ghi nhật ký thiết bị, lưu bản âm thanh/mã lịch; không tự viết-duyệt-phát","xac_nhan_duyet":"Đơn vị y tế xác nhận thông tin; người có quyền duyệt nội dung và lịch phát; Trưởng nhóm thực hiện phát","quy_tac_chan":"Không có bản duyệt hoặc thay đổi thông tin/giá/thời gian → ngừng phát và chuyển duyệt lại"},{"so":"32","dau_viec":"Yêu cầu trực tiếp từ Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số tới Trưởng nhóm chuyên khoa","TCT":"CVT Truyền thông – Số ghi yêu cầu chuyên môn và thời hạn mong muốn, chuyển CVT Nội dung – Cơ sở; CVT Nội dung – Cơ sở đối soát KPI/ưu tiên và quyết định đầu mối điều phối","chi_nhanh":"Trưởng nhóm chỉ nhận một lệnh được thống nhất trên mã việc; nếu xung đột báo CVT Nội dung – Cơ sở, không tự chọn người chỉ đạo","xac_nhan_duyet":"Trưởng phòng xử lý xung đột ngoài thẩm quyền; các lớp duyệt sản phẩm và chi phí giữ độc lập","quy_tac_chan":"Hai đầu mối cùng giao nhiệm vụ, lệnh vượt tải/ngoài kế hoạch hoặc sửa deadline không lưu nhật ký → chặn và chuyển Trưởng phòng"},{"so":"33","dau_viec":"Đánh giá kỳ tháng Trưởng nhóm chuyên khoa kiêm Truyền thông","TCT":"CVT Nội dung – Cơ sở tổng hợp sản lượng theo hai vai (quản lý Tổ và nghiệp vụ Truyền thông), kiểm bằng chứng; CVT Truyền thông – Số nhận xét chất lượng nghiệp vụ trong phần được giao","chi_nhanh":"Trưởng nhóm cung cấp nhật ký kênh/màn hình/biển bảng/phát thanh, kết quả việc tại chỗ, tải giờ; Ban Giám đốc xác nhận dữ liệu thực tế, nội quy","xac_nhan_duyet":"CVT Nội dung – Cơ sở là người đánh giá trực tiếp; Trưởng phòng duyệt hoặc rà soát theo phân cấp; ý kiến CVT Truyền thông – Số và cơ sở là đầu vào","quy_tac_chan":"Hai phiếu đánh giá của hai CVT hoặc cộng trùng giờ/đầu ra giữa hai vai → chặn đối soát"}],"nguyen_tac_phan_dinh_17112026":"Đơn vị chủ dữ liệu xác nhận dữ liệu gốc; TCT giữ chuẩn, chủ trì sản phẩm chuyên môn và kết quả theo nhóm; chi nhánh chịu hiện trường theo định biên. Mỗi việc có chủ, người làm, người kiểm độc lập và cấp duyệt riêng. Tổ trưởng chỉ điều phối. Hai người cùng chức danh được giao đầu việc một người chịu trách nhiệm chính trên phiếu/lịch sản xuất. Các ma trận là chi tiết hóa phương án trình, không tự thay văn bản phân quyền đã ban hành. Với Marketing bệnh viện Nhóm 1 và Nhóm 2, Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở là cấp quản lý trực tiếp của Trưởng nhóm (kể cả người kiêm Truyền thông); Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số giữ chuẩn chuyên môn, trao đổi qua CVT Nội dung – Cơ sở về tải việc, không lập tuyến giao việc và đánh giá thứ hai. Ban Giám đốc bệnh viện quản lý hiện trường/chấm công và xác nhận dữ liệu, không thay các cấp duyệt Marketing theo ma trận.","phan_dinh_vai_tro_17112026":"Cập nhật ranh giới 25 vị trí, 15 cặp gần nhau, 28 luồng phối hợp TCT/chi nhánh; thống nhất Tổ trưởng Tổ Truyền thông và Thương hiệu; sửa mảng 14/37/43.","phan_cap_duyet_17112026":{"trang_thai":"Dự thảo chờ cấp có thẩm quyền ban hành/ủy quyền","cac_cua_kiem_soat":[{"buoc":"G0 – Khởi tạo hồ sơ","nguoi_lam":"Người giao việc xác định mã yêu cầu, nhóm thương hiệu, cơ sở, đầu ra, kênh, hạn, ngân sách và nguồn; chuyển chủ trì theo ma trận 25 vị trí","quy_tac_chan":"Thiếu thông tin tối thiểu thì không vào lịch sản xuất"},{"buoc":"G1 – Kiểm đầu vào","nguoi_lam":"Người chủ dữ liệu và đầu mối cơ sở xác nhận nguồn; Biên tập kiểm câu chữ; với nội dung y khoa, bác sĩ/đơn vị chuyên môn kiểm chuyên môn","quy_tac_chan":"Thiếu giấy phép/hình ảnh đồng ý/chứng cứ y khoa ⇒ dừng"},{"buoc":"G2 – Kiểm sản xuất","nguoi_lam":"Người khác với người làm kiểm kỹ thuật, nhận diện, phiên bản; tổ trưởng chỉ điều phối, không tự có quyền duyệt","quy_tac_chan":"Không đạt QC ⇒ trả sửa; trường hợp thiếu người kiểm độc lập thì chuyển phân công, không bỏ bước"},{"buoc":"G3 – Nghiệm thu theo yêu cầu","nguoi_lam":"Quản lý thương hiệu cùng nhóm xác nhận đúng brief, thông điệp, định dạng, số lượng và hạn; đây là nghiệm thu, không phải quyền phê duyệt phát hành","quy_tac_chan":"Không đạt ⇒ tối đa 02 vòng chỉnh trong cùng phạm vi; thay đổi mục tiêu/brief phải mở phiên bản mới"},{"buoc":"G4 – Phê duyệt phát hành","nguoi_lam":"Người có thẩm quyền được gắn theo loại sản phẩm và phạm vi; lãnh đạo, chuyên môn, Pháp chế, BGĐ cơ sở/BTGĐ tham gia đúng từng lĩnh vực","quy_tac_chan":"Không có ủy quyền hiệu lực ⇒ chặn; không tự chuyển cấp khi quá hạn"},{"buoc":"G5 – Công bố/thực thi","nguoi_lam":"Quảng cáo và kênh số đăng/trả phí; Truyền thông thực hiện phát hành báo chí/ngoại tuyến; Quản lý sản phẩm số quản trị công bố dữ liệu website; cơ sở phát nội viện theo lịch","quy_tac_chan":"Người thực thi kiểm mã phiên bản được duyệt, quyền kênh và ngân sách; thiếu bất kỳ điều kiện thì không phát"},{"buoc":"G6 – Đối soát sau phát hành","nguoi_lam":"Người vận hành lưu URL, ảnh chứng cứ, nhật ký; đo lường và đối soát chốt số độc lập; Quản lý thương hiệu chịu kết quả Hạng mục","quy_tac_chan":"Sự cố phải có bản ghi thu hồi/đính chính và phân tích nguyên nhân"}],"ma_tran_16_loai":[{"ma":"01","noi_dung_duyet":"Kế hoạch Hạng mục, kế hoạch tháng","lap_kiem_thuc_hien":"Quản lý thương hiệu đúng nhóm lập; cơ sở xác nhận nhu cầu; Chuyên viên trưởng đối chiếu tải và nguồn lực","duyet":"Trưởng phòng Marketing duyệt kế hoạch trong phạm vi được giao; Ban Tổng Giám đốc duyệt phạm vi, ngân sách hoặc chủ trương thuộc thẩm quyền cấp trên","chan":"Không triển khai Hạng mục hoặc phát sinh chi vượt hạn mức nếu chưa được cấp có thẩm quyền thông qua"},{"ma":"02","noi_dung_duyet":"Bài viết, tin, thông điệp và kịch bản thông thường","lap_kiem_thuc_hien":"Biên tập đúng nhóm lập; người Biên tập khác kiểm độc lập; bác sĩ/đơn vị chuyên môn xác nhận các mệnh đề y khoa; Quản lý thương hiệu nghiệm thu đúng yêu cầu","duyet":"Sản phẩm mẫu, thường xuyên: Chuyên viên trưởng chỉ ký duyệt phát hành khi có văn bản phân quyền. Sản phẩm mới, vượt thông điệp, nhạy cảm hoặc cấp hệ thống: Trưởng phòng; trường hợp vượt thẩm quyền chuyển Ban Tổng Giám đốc","chan":"Không dùng “nghiệm thu” hoặc “kiểm tra” thay chữ ký phê duyệt phát hành"},{"ma":"03","noi_dung_duyet":"Ảnh, video, phóng sự và phim chiến dịch","lap_kiem_thuc_hien":"Media đúng nhóm sản xuất; người có năng lực được phân công kiểm kỹ thuật độc lập; Biên tập kiểm lời và pháp lý; người phụ trách chuyên môn xác nhận nội dung y khoa; Quản lý thương hiệu nghiệm thu","duyet":"Video mẫu đã duyệt: người được Trưởng phòng phân quyền duyệt phát hành; phim mới, quảng cáo y tế hoặc hình ảnh rủi ro cao: Trưởng phòng và cấp có thẩm quyền chuyên môn/pháp lý theo từng trường hợp","chan":"Không tự duyệt bản dựng; khi dùng hình ảnh người bệnh phải có căn cứ đồng ý phù hợp"},{"ma":"04","noi_dung_duyet":"Thiết kế số, ấn phẩm in và ứng dụng nhận diện","lap_kiem_thuc_hien":"Thiết kế đúng nhóm làm; người kiểm độc lập kiểm quy chuẩn, nội dung; Biên tập kiểm chữ; Quản lý thương hiệu nghiệm thu theo yêu cầu","duyet":"Biến thể đúng mẫu đã phê duyệt: Chuyên viên trưởng theo ủy quyền và QyĐ.03.MKT; sản phẩm mới, ngoại viện, thay đổi nhận diện hoặc cấp hệ thống: Trưởng phòng/cấp được giao","chan":"Chưa có xác nhận file chốt, bản in và thẩm quyền chi thì không đặt in hoặc đưa thi công"},{"ma":"05","noi_dung_duyet":"Quảng cáo trả phí, lịch đăng, trang đích","lap_kiem_thuc_hien":"Quảng cáo và kênh số lập lịch, bộ thông số và cấu hình; Biên tập, Thiết kế, Media giao sản phẩm đã duyệt; Quản lý thương hiệu nghiệm thu thông điệp và lịch","duyet":"Duyệt phát hành nội dung theo cấp 02–04; ngân sách và điều chỉnh chi do người có thẩm quyền chi theo R28 duyệt riêng; vận hành quảng cáo do người được cấp quyền kênh thực hiện","chan":"Không cho chạy chỉ vì đã có lịch; tắt hoặc tạm dừng vi phạm ngay, lưu nhật ký và thông báo"},{"ma":"06","noi_dung_duyet":"Thông cáo báo chí, phát ngôn, KOL/KOC, quan hệ công chúng","lap_kiem_thuc_hien":"Chuyên viên Truyền thông TCT đúng nhóm chủ trì báo chí, kiểm nguồn và đề xuất đối tác; Biên tập hỗ trợ sản xuất nội dung; Quản lý thương hiệu xác nhận thông điệp","duyet":"Trưởng phòng duyệt phương án trong thẩm quyền; phát ngôn, thông tin nhạy cảm, đại diện Tập đoàn và cam kết hợp đồng do người phát ngôn/đại diện có thẩm quyền phê duyệt; chi phí theo R28","chan":"Chuyên viên Truyền thông không mặc nhiên là người phát ngôn hoặc người duyệt nội dung chính thức"},{"ma":"07","noi_dung_duyet":"Sự kiện cơ sở, sự kiện cấp hệ thống","lap_kiem_thuc_hien":"Truyền thông cơ sở chủ trì hiện trường; Chuyên viên Truyền thông TCT chủ phần báo chí/PR; Tổ Nội dung và Sáng tạo sản xuất; Quản lý thương hiệu chủ Hạng mục","duyet":"Sự kiện địa phương: Ban Giám đốc cơ sở duyệt tổ chức, hiện trường và chi phí theo phân cấp; sự kiện hệ thống hoặc báo chí quy mô lớn: Trưởng phòng, Ban Tổng Giám đốc theo phạm vi; nội dung y khoa có xác nhận chuyên môn","chan":"Không lấy duyệt hậu cần thay duyệt thông điệp, hoặc ngược lại"},{"ma":"08","noi_dung_duyet":"Biển bảng, màn hình, phát thanh và vật phẩm ngoại tuyến","lap_kiem_thuc_hien":"Chuyên viên Truyền thông TCT quản lý kênh/lịch, thi công và nghiệm thu phạm vi hệ thống; Thiết kế ngoại tuyến giữ file và thông số; Truyền thông cơ sở kiểm hiện trạng, vận hành theo lịch","duyet":"Trưởng phòng duyệt mẫu/chiến dịch toàn hệ thống; Ban Giám đốc cơ sở xác nhận địa điểm, điều kiện tại chỗ và phần thuộc phân cấp; người có thẩm quyền chi duyệt hợp đồng/thi công theo R28","chan":"Media chi nhánh không chủ trì kiểm biển bảng hoặc phê duyệt lịch phát thanh"},{"ma":"09","noi_dung_duyet":"Tin hoạt động trong ngày tại chi nhánh","lap_kiem_thuc_hien":"Quan hệ công chúng hoặc đầu mối Marketing cơ sở cung cấp nguồn, ảnh, sự kiện; Biên tập kiểm theo danh mục tin nhanh; người có quyền kênh thực hiện đăng","duyet":"Chỉ được áp dụng cơ chế nhanh khi danh mục và mẫu đã được Trưởng phòng phê duyệt, Ban Giám đốc cơ sở xác nhận đúng sự kiện; người duyệt phát hành theo ủy quyền kênh còn hiệu lực","chan":"Ngoài danh mục, có quảng cáo dịch vụ y tế, người bệnh hoặc nội dung nhạy cảm: quay về quy trình thông thường"},{"ma":"10","noi_dung_duyet":"Website/App: bài viết, dịch vụ, SEO, giao diện","lap_kiem_thuc_hien":"Biên tập chủ câu chữ; cơ sở/chuyên môn sở hữu nguồn thông tin; Quản lý sản phẩm số quản trị CMS, trạng thái và quyền đăng; Công nghệ thực hiện thay đổi kỹ thuật","duyet":"Đơn vị sở hữu dữ liệu/chuyên môn xác nhận sự thật; Trưởng phòng hoặc người được ủy quyền duyệt nội dung Marketing; thay đổi cấu trúc lớn do Trưởng phòng và bộ phận kỹ thuật liên quan duyệt đúng phần","chan":"Quản lý sản phẩm số không tự xác nhận sự thật y khoa hoặc giá; có quyền kỹ thuật đăng không đồng nghĩa quyền duyệt nội dung"},{"ma":"11","noi_dung_duyet":"Website/App: giá, người hành nghề, danh mục kỹ thuật, giấy phép, thời gian làm việc","lap_kiem_thuc_hien":"Kế toán/chủ giá, Nhân lực/chủ hồ sơ hành nghề, Ban chuyên môn/chủ kỹ thuật, Pháp chế/chủ điều kiện pháp lý cung cấp bản gốc; Marketing cơ sở chuyển hồ sơ; Quản lý sản phẩm số nhập dữ liệu","duyet":"Ban Giám đốc cơ sở xác nhận bản áp dụng tại cơ sở; đơn vị chủ dữ liệu và Pháp chế xác nhận tính hợp lệ; người có thẩm quyền công bố được chỉ định phê duyệt cuối trước khi mở hiển thị","chan":"Thiếu bản nguồn, hết hạn hoặc sai phạm vi giấy phép: chặn công bố; Biên tập không tự sửa số liệu"},{"ma":"12","noi_dung_duyet":"Kịch bản tư vấn, bàn giao Contact Center","lap_kiem_thuc_hien":"Marketing cung cấp thông tin dịch vụ/chiến dịch, nguồn và thông điệp đã kiểm; Contact Center chủ nghiệp vụ hội thoại, tư vấn, hướng dẫn xử lý","duyet":"Trưởng phòng duyệt thông tin Marketing cung cấp; người quản lý nghiệp vụ Contact Center được phân quyền duyệt kịch bản tư vấn; cơ sở/chuyên môn xác nhận điều kiện khám chữa bệnh","chan":"Không giao Biên tập quyền duyệt nghiệp vụ tư vấn hoặc trực tiếp phê duyệt lời hứa chuyên môn"},{"ma":"13","noi_dung_duyet":"Thông tin nội bộ, đào tạo, nhân sự, chế độ","lap_kiem_thuc_hien":"Đơn vị chủ trì (Nhân lực, chuyên môn, hành chính...) cung cấp và chịu nội dung; Biên tập/Thiết kế/Media chỉ hỗ trợ sản phẩm khi có yêu cầu","duyet":"Thủ trưởng đơn vị chủ trì duyệt nội dung thuộc thẩm quyền; phần sản phẩm Marketing kiểm QC, người được phân quyền phát hành thực hiện","chan":"Không mặc nhiên yêu cầu Phòng Marketing ký duyệt nội dung thuộc chuyên môn đơn vị khác"},{"ma":"14","noi_dung_duyet":"Sự cố, khủng hoảng, thông tin mạo danh và đính chính","lap_kiem_thuc_hien":"Truyền thông TCT xác minh, thu bằng chứng và soạn phương án; Biên tập hỗ trợ câu chữ; Pháp chế/ban chuyên môn xác nhận phần liên quan; cơ sở khóa nguồn phát tán","duyet":"Trưởng phòng điều phối khẩn; nội dung phát ngôn/đính chính do người phát ngôn hoặc người được Ban Tổng Giám đốc ủy quyền phê duyệt; thông báo cơ quan nhà nước theo thẩm quyền pháp luật","chan":"Không tự phát ngôn; quá hạn không có nghĩa được tự duyệt; trường hợp nguy cơ tức thì có thể tạm ẩn/tạm dừng và lập nhật ký"},{"ma":"15","noi_dung_duyet":"Quyền kênh, quyền đăng, thay người duyệt","lap_kiem_thuc_hien":"Quản lý sản phẩm số/đầu mối quản trị kênh lập yêu cầu quyền; Chuyên viên trưởng kiểm sơ đồ vai trò, người thay, thời hạn; người vận hành chỉ dùng quyền đã cấp","duyet":"Trưởng phòng duyệt quyền quản trị cao nhất và ma trận phân quyền; Chuyên viên trưởng cấp/thu hồi quyền thao tác trong ma trận đã duyệt; duyệt thay chỉ có giá trị theo ủy quyền cụ thể","chan":"Không dùng quyền quản trị hệ thống để tự cấp quyền phê duyệt nội dung hoặc bỏ nhật ký"},{"ma":"16","noi_dung_duyet":"Đổi phạm vi, duyệt lại, thu hồi hoặc sửa sau đăng","lap_kiem_thuc_hien":"Người yêu cầu ghi lý do, phiên bản cũ/mới; Biên tập/Media/Thiết kế sửa đúng phần; Quản lý thương hiệu nghiệm thu thay đổi; người kênh lưu dấu vết","duyet":"Thay đổi thông điệp, căn cứ chuyên môn, chi phí hoặc phạm vi thì chuyển lại cấp duyệt tương ứng của lần phát hành; sửa lỗi kỹ thuật không đổi bản chất được xử lý theo ủy quyền và lưu nhật ký","chan":"Không tự ghi đè hồ sơ đã duyệt; sửa sau phát hành không xóa dấu vết quyết định cũ"}],"phan_biet_diem_ky":"Kiểm QC, xác nhận chuyên môn, nghiệm thu brief, phê duyệt phát hành, phê duyệt chi và quyền đăng là các quyền khác nhau; người lập không được tự duyệt."},"ghi_chu_truyen_thong_17112026":"Chuyên viên Truyền thông thuộc Tổ Truyền thông và Thương hiệu vì chủ nghiệp vụ PR, báo chí, khủng hoảng, ngoại tuyến và nội viện; tổ sản xuất chỉ tạo sản phẩm. Không đồng nhất nghiệm thu triển khai với quyền ký duyệt phát hành.","bo_quy_chuan_da_dong_bo":[{"ma":"Content","chu_tri":"Một Biên tập TCT được phân công, Biên tập hai nhóm phụ trách phần nhóm","kiem":"Chuyên viên trưởng và Biên tập khác; bác sĩ kiểm mệnh đề y khoa","phe_duyet":"Trưởng phòng Marketing","phan_biet":"Nội dung và văn phong"},{"ma":"QC-4","chu_tri":"Media TCT nhóm 1 làm đầu mối chung, Media TCT nhóm 2 phần riêng","kiem":"Media của nhóm khác người làm và Chuyên viên trưởng","phe_duyet":"Trưởng phòng Marketing","phan_biet":"Kỹ thuật video, không phải quyền duyệt phát hành"},{"ma":"Xuat-ban-nen-tang","chu_tri":"Một Chuyên viên Kênh số TCT đầu mối, chuyên viên hai nhóm cập nhật phần riêng","kiem":"Quản lý sản phẩm số tổng hợp; Chuyên viên trưởng kiểm","phe_duyet":"Trưởng phòng Marketing","phan_biet":"Cách xuất bản và quyền kênh, không thay phê duyệt nội dung"},{"ma":"DS-3","chu_tri":"Quản lý sản phẩm số giữ danh mục/phiên bản; Kênh số hai nhóm theo dõi nguồn","kiem":"Chuyên viên trưởng kiểm","phe_duyet":"Chuyên viên trưởng đối với cập nhật thường xuyên theo phân quyền; Trưởng phòng đối với thay đổi quy chuẩn nội bộ","phan_biet":"Chính sách của nền tảng, không tự ban hành quy định"}],"phan_loai_video_v1_v4":[{"ma":"V1","san_pham":"Tin nhanh tại cơ sở theo danh mục đã duyệt; ví dụ clip hiện trường, sự kiện trong ngày, không tạo lời/khẳng định mới. Không được dùng V1 để bỏ qua kiểm tra người bệnh, y khoa, giá hoặc chương trình.","kich_ban":"Mẫu tin nhanh và nguồn đã được xác nhận; không bắt buộc kịch bản video đầy đủ nếu đúng danh mục. Chuyển Biên tập khi vượt danh mục.","dung":"Media cơ sở quay, cắt cơ bản","duyet":"Chỉ đăng Facebook bệnh viện với quyền đăng hợp lệ và danh sách kiểm đạt; danh sách kiểm không phải giấy ủy quyền. Vượt danh mục thì theo cấp duyệt nội dung.","dang":"Facebook bệnh viện trong danh mục/ủy quyền; kênh khác do TCT"},{"ma":"V2","san_pham":"Video ngắn theo bộ mẫu dựng B7: V2-01 giới thiệu bác sĩ/khoa phòng; V2-02 cơ sở vật chất; V2-03 hướng dẫn thủ tục; V2-04 sự kiện; V2-05 dịch vụ; V2-06 giá/ưu đãi; V2-07 kiến thức sức khỏe chuẩn. V2 được xác định bởi cách sản xuất theo mẫu, không phải không có y khoa hoặc giá.","kich_ban":"Biên tập TCT đúng nhóm chủ trì viết mọi lời/thoại, lời dẫn, thông điệp và chữ trên hình; Media TCT đúng nhóm lập phân cảnh/shot-list. Nội dung y khoa, dịch vụ, giá, ưu đãi phải có nguồn và xác nhận chuyên môn/pháp lý theo phân loại rủi ro.","dung":"Media cơ sở chủ trì quay/dựng hoàn chỉnh theo B-7, Media TCT đúng nhóm kiểm kỹ thuật và hỗ trợ hậu kỳ vượt năng lực; không mặc định dựng lại.","duyet":"Người có thẩm quyền theo nội dung/rủi ro; không suy ra quyền duyệt từ nhãn V2. Chuyên môn phải xác nhận khi có yếu tố y khoa.","dang":"Kênh số TCT đăng đa kênh theo lịch và quyền; cơ sở chỉ được đăng Facebook bệnh viện với nội dung đúng danh mục/ủy quyền và bản đã duyệt."},{"ma":"V3","san_pham":"Video có câu chuyện, nhân vật/phỏng vấn, kịch bản riêng: V3-A01 chuyện nhân sự/đối tác/cộng đồng không có khẳng định y khoa; V3-B01 bác sĩ trao đổi chuyên môn; V3-B02 người bệnh/ca bệnh. Không tự đổi thành V2 chỉ vì ngắn.","kich_ban":"Biên tập TCT đúng nhóm viết lời, câu hỏi phỏng vấn, thông điệp, chữ trên hình; Media TCT lập phân cảnh. V3-B bắt buộc bác sĩ/đơn vị chuyên môn xác nhận nội dung; dữ liệu, hình ảnh người bệnh phải có căn cứ và giấy đồng ý hợp lệ.","dung":"Media cơ sở có thể quay/dựng V3 theo mẫu B-7 và kịch bản đã duyệt; Media TCT đúng nhóm kiểm kỹ thuật, trực tiếp hậu kỳ phần vượt mẫu/phức tạp.","duyet":"V3-A duyệt theo rủi ro nội dung thực tế; V3-B phải qua kiểm chứng y tế, pháp lý và cấp phát hành tương ứng. Loại V3 không tự quyết định thẩm quyền.","dang":"Kênh số/Truyền thông TCT quản lý việc đăng đa kênh; cơ sở không tự đăng ca bệnh, giá, kỹ thuật mới."},{"ma":"V4","san_pham":"Phim thương hiệu, TVC, phim chiến dịch, giới thiệu tổng thể hệ thống, phóng sự chuyên sâu hoặc nhiều bối cảnh (B7-V4-01); Media TCT chủ trì sản xuất.","kich_ban":"Biên tập TCT đúng nhóm viết toàn bộ kịch bản lời/thông điệp; Media TCT đúng nhóm lập phân cảnh, shot-list, kế hoạch ghi hình; Thiết kế cung cấp đồ họa.","dung":"Media TCT chủ trì; cơ sở cấp tư liệu","duyet":"Trưởng phòng hoặc cấp cao hơn theo thẩm quyền","dang":"Kênh số hoặc Truyền thông TCT"}],"luong_ca_benh_tieu_bieu":["Khoa/phòng/bác sĩ/Marketing cơ sở đề xuất hoặc Quản lý thương hiệu đặt yêu cầu","Marketing cơ sở kiểm hồ sơ nguồn và căn cứ đồng ý sử dụng thông tin/hình ảnh","Quản lý thương hiệu TCT điều phối sản phẩm theo nhóm, phân loại V/kênh","Biên tập TCT đúng nhóm viết bài/kịch bản lời ca bệnh","Media TCT viết phân cảnh; Media cơ sở quay/dựng V2/V3 theo mẫu; Media TCT dựng V4/kiểm bản dựng","Bác sĩ xác nhận y khoa; kiểm nội dung/Media/pháp lý độc lập","Quản lý thương hiệu nghiệm thu đầu ra","Trưởng phòng hoặc cấp cao hơn duyệt ca bệnh mới/nhạy cảm; Chuyên viên trưởng chỉ theo ủy quyền thường xuyên phù hợp","Kênh số/Truyền thông TCT công bố; cơ sở chỉ triển khai phiên bản được duyệt đúng quyền","Lưu URL/nhật ký; theo dõi, đối soát, tái duyệt khi thay đổi nội dung"],"phan_bo_tai_media_co_so_17112026":{"trang_thai":"Phương pháp kiểm soát và phân công đã cập nhật; giờ công Media từng cơ sở chưa đo, không xác nhận có giờ dư","nguong_ke_hoach_moi_nguoi_gio_thang":142,"media_tct_n1":{"nguoi":2,"gio_ke_hoach":284,"gio_du_toan":219,"chenh_ly_thuyet":65},"media_tct_n2":{"nguoi":1,"gio_ke_hoach":142,"gio_du_toan":131,"chenh_ly_thuyet":11},"media_tct_tong_chenh_ly_thuyet":76,"media_co_so":{"benh_vien_hien_tai":5,"nguoi":5,"tong_khung_ke_hoach":710,"gio_thuc_do":null,"gio_con_du":null,"ghi_chu":"710 giờ là tổng ngưỡng kế hoạch, không phải giờ dư; phải trừ giờ sản xuất và việc hiện trường thực đo theo từng người"},"danh_muc_do_gio":["Quay/chụp/thu âm hiện trường","Dựng V1","Dựng V2 theo mẫu B-7","Dựng V3 theo kịch bản/mẫu B-7","Chỉnh sửa ảnh","Chuẩn bị, di chuyển, hỗ trợ cùng nhóm","Sửa bản dựng","Lưu nguồn/tư liệu/bàn giao"],"quy_tac_chuyen_tuyen":"Ưu tiên Media cơ sở chủ trì V2 và V3 theo mẫu khi có năng lực và tải; TCT kiểm kỹ thuật, viết lời/phân cảnh theo K1–K6, chủ trì V4 hoặc hậu kỳ chuyên sâu; chuyển tuyến phải có lý do, nhật ký","quy_tac_hach_toan":"Giờ sản xuất của cơ sở chỉ hạch toán tại cơ sở, giờ kiểm/sửa của TCT chỉ tại TCT, không tính trùng và không tính giảm tải TCT hai lần","chu_ky":"Ghi giờ theo từng yêu cầu; đối soát tháng; đánh giá tải theo quý; cập nhật định biên theo ngưỡng của khung","chi_so_theo_doi":["Tỷ lệ V2/V3 dựng hoàn chỉnh tại cơ sở","Giờ sản xuất thực đo của Media cơ sở","Giờ kiểm/điều chỉnh thực đo của Media TCT","Tỷ lệ bản dựng được thông qua lần đầu","Số lượt TCT phải dựng lại","Tỷ lệ đúng hạn theo cơ sở và theo nhóm"]},"ghi_chu_phan_quyen_hai_nhom_ba_to":"2 nhóm thương hiệu là trục chịu trách nhiệm kế hoạch, thương hiệu, nghiệm thu và kết quả; 3 tổ chuyên môn là trục chuyên ngành và điều phối năng lực, không phải nhóm thương hiệu thứ 3. Một đầu việc có 1 người làm chính và 1 đầu mối chịu trách nhiệm; không phát sinh tuyến duyệt mới từ việc kiêm Tổ trưởng. Việc thay đổi sơ đồ/bỏ tổ trưởng phải xử lý thống nhất nhân sự trước khi cập nhật. Cơ cấu giai đoạn đầu gồm 02 Chuyên viên trưởng: CVT Nội dung – Cơ sở cho Nội dung – Sáng tạo, CVT Truyền thông – Số cho Truyền thông – Thương hiệu và Tăng trưởng số; thông suốt cùng tuyến chuyên môn giữa TCT và cơ sở.","doi_ten_truyen_thong_co_so_17112026":{"ten_moi":"Chuyên viên Marketing cơ sở – truyền thông","ten_cu":"Tên cũ đã thay trên toàn bộ giao diện","pham_vi":"Chỉ đổi tên vị trí tại cơ sở; không đổi các chức danh Truyền thông/Quan hệ công chúng tại Tổng công ty và không tăng định biên","ma_noi_bo":"qhcs giữ nguyên là mã kỹ thuật để bảo toàn liên kết và dữ liệu lịch sử; giao diện chỉ dùng tên mới","co_so_hai_nguoi":"Trưởng nhóm Marketing cơ sở kiêm nhiệm phần việc của vị trí truyền thông cơ sở; không chuyển sang Media","ranh_gioi":"Hoạt động nội bộ ngoài Marketing thuộc Nhân lực, Công đoàn và đơn vị chủ quản; không tạo nhiệm vụ chỉ để lấp giờ"},"chuyen_viec_media_sang_truyen_thong_co_so_17112026":{"vi_tri_nhan":"Chuyên viên Marketing cơ sở – truyền thông; bệnh viện 02 người: Trưởng nhóm kiêm","vi_tri_ngung_chu_tri":"Chuyên viên Marketing cơ sở – media","cong_viec":["Vận hành phát thanh nội viện theo lịch","Kiểm tra và vận hành màn hình nội viện","Kiểm biển bảng/định kỳ, chụp ảnh hiện trạng, số đo","Chụp ảnh nghiệm thu trang trí/biển bảng và ảnh kiểm tuân thủ nhận diện"],"khong_chuyen":"Media cơ sở tiếp tục quay, chụp và dựng V1–V3 theo phạm vi đã thống nhất; không đồng nhất tư liệu sự kiện Marketing với ảnh nghiệp vụ nghiệm thu."},"ma_tran_dong_bo_mtvc_van_hanh_17112026":{"trang_thai":"Đối soát và xử lý các vùng mâu thuẫn V1–V4, xuất bản đa kênh, biển bảng/màn hình/phát thanh; chưa xác nhận hoàn toàn mọi quy trình, văn bản được duyệt trên thực tế","quy_tac":["Biên tập TCT đúng nhóm viết lời mọi V2–V4; Media TCT lập phân cảnh; Media cơ sở quay/dựng V1–V3 theo mẫu khi có giao việc.","V2/V3 là phân cấp sản xuất, rủi ro nội dung xét độc lập: K1–K6/chuyên môn, giá, ưu đãi, người bệnh, giấy đồng ý.","Cơ sở chỉ đăng V1 Facebook bệnh viện theo danh mục và quyền; các kênh còn lại do Kênh số TCT giữ lịch/phát hành; vận hành màn hình và phát thanh là chức năng Truyền thông cơ sở.","Truyền thông cơ sở chủ trì kiểm biển bảng, màn hình, phát thanh; cơ sở 02 người Trưởng nhóm kiêm; Media cơ sở không kiêm nghiệp vụ nghiệm thu.","Quyền kiểm kỹ thuật không đồng nhất quyền kiểm pháp lý, xác nhận y khoa, nghiệm thu đầu ra hoặc phê duyệt phát hành.","B7 có danh mục 12 kiểu V1–V4. Cấm phân loại theo có/không có nội dung y khoa, giá hay chương trình; nội dung phát sinh phải xác nhận nguồn riêng. B7 không thay thẩm quyền duyệt phát hành."],"nguon_doi_chieu":["MTCV 25 vị trí","Mảng việc 5,9,10,12–15","Ma trận TCT–chi nhánh 03–09,24","Quy trình tin-trong-ngay, phat-thanh-man-hinh, bien-bang-hong, lich-dang-thang","Lịch vận hành","Bộ video B-7, tiêu chuẩn QC-4","Ma trận phân cấp duyệt 14.16","B7 12 kiểu video; MTCV Biên tập/Media; QC-4, KPI, quyền kênh và phân cấp duyệt"],"quy_tac_chan":"Một sản phẩm chỉ phát hành khi đủ nguồn, xác nhận chuyên môn nếu có, kiểm độc lập, nghiệm thu và phê duyệt theo thẩm quyền; người sản xuất không tự phê duyệt cuối."},"danh_muc_video_b7_17112026":[{"ma":"V1","ten":"V1 – Tin nhanh","vi_du":"Ghi nhận sự kiện đang diễn ra, đoàn công tác, hình ảnh hoạt động trong ngày, clip thông báo hiện trường không có lời dẫn mới","dau_hieu":"Cảnh quay thực tế, cắt gọn, nhãn thông tin đã xác thực; không lồng khẳng định y khoa, giá, ưu đãi hoặc nội dung người bệnh chưa duyệt","phan_cong":"Media cơ sở quay, cắt; Trưởng nhóm cơ sở chịu trách nhiệm nguồn và quyền đăng danh mục đã ủy quyền","quy_tac_kiem_soat":"Vượt danh mục tin nhanh → chuyển V2/V3 hoặc tuyến duyệt nội dung; không dùng V1 để né duyệt"},{"ma":"V2-01","ten":"V2 – Giới thiệu bác sĩ, nhân sự, khoa/phòng","vi_du":"Video hồ sơ bác sĩ: tên, chức danh, lịch công tác, điểm nổi bật đã xác thực; giới thiệu khu khám, khoa/phòng","dau_hieu":"Các cảnh và thứ tự chuẩn theo mẫu; thông tin chức danh, chuyên môn, lịch làm việc phải có nguồn; không tự nói “giỏi nhất”, “tốt nhất”","phan_cong":"Biên tập TCT viết chữ/lời; Media TCT lập phân cảnh/mẫu; Media cơ sở chủ trì quay/dựng","quy_tac_kiem_soat":"Có khẳng định năng lực/hiệu quả y khoa → chuyên môn xác nhận; kịch bản chân dung có hành trình phỏng vấn riêng → V3"},{"ma":"V2-02","ten":"V2 – Cơ sở vật chất, tiện ích","vi_du":"Clip giới thiệu sảnh, khu chờ, phòng khám, thiết bị, tiện ích, hướng dẫn đường đi","dau_hieu":"Montage nhiều cảnh, tiêu đề/đồ họa đã duyệt; tránh suy diễn công dụng hoặc hiệu quả thiết bị","phan_cong":"Biên tập TCT viết lời/chữ; Media TCT chọn phân cảnh mẫu; Media cơ sở quay/dựng","quy_tac_kiem_soat":"Nêu tính năng chuyên môn kỹ thuật mới, lợi ích điều trị → thẩm định nội dung"},{"ma":"V2-03","ten":"V2 – Hướng dẫn thủ tục, hành trình khách hàng","vi_du":"Hướng dẫn đặt lịch, lấy số, làm hồ sơ, thanh toán, nhận kết quả, sử dụng ứng dụng","dau_hieu":"Theo bước rõ ràng, màn hình/hình ảnh đúng phiên bản, không tự đưa mức phí hoặc cam kết thời gian chưa xác minh","phan_cong":"Đầu mối nghiệp vụ xác nhận thao tác; Biên tập viết lời; Media cơ sở quay/dựng","quy_tac_kiem_soat":"Thay đổi luồng nghiệp vụ phải cập nhật mẫu và xác nhận lại trước phát hành"},{"ma":"V2-04","ten":"V2 – Hoạt động/sự kiện theo mẫu","vi_du":"Tổng hợp khám cộng đồng, tập huấn, sinh hoạt nội bộ, hoạt động thiện nguyện","dau_hieu":"Tường thuật sự kiện theo khuôn mở–thân–kết; không dàn dựng phát ngôn, không suy diễn kết quả chương trình","phan_cong":"Truyền thông cơ sở cấp nguồn sự kiện; Biên tập viết lời; Media cơ sở quay/dựng","quy_tac_kiem_soat":"Nếu xây dựng câu chuyện nhân vật, phỏng vấn nhiều đoạn → V3-A; có thông tin bệnh nhân → kiểm chứng y tế, hình ảnh"},{"ma":"V2-05","ten":"V2 – Thông tin dịch vụ","vi_du":"Giới thiệu quy trình khám gói dịch vụ, phạm vi phục vụ, đối tượng khách hàng được tiếp nhận","dau_hieu":"Thông tin dịch vụ lấy từ bộ nội dung đã được xác nhận; hình ảnh/hậu kỳ theo mẫu","phan_cong":"Biên tập TCT chủ trì nội dung; Media cơ sở quay/dựng; Media TCT kiểm kỹ thuật","quy_tac_kiem_soat":"Phải kiểm nguồn, điều kiện quảng cáo y tế và xác nhận chuyên môn khi có nội dung chuyên môn"},{"ma":"V2-06","ten":"V2 – Giá, chương trình, ưu đãi","vi_du":"Video thông báo bảng giá, chương trình khám, quà tặng, ưu đãi theo kế hoạch đã duyệt","dau_hieu":"Mẫu ngắn có thời hạn, điều kiện, đối tượng áp dụng và thông tin liên hệ rõ ràng","phan_cong":"Biên tập TCT soạn nội dung theo hồ sơ giá/chương trình; Media cơ sở dựng theo mẫu","quy_tac_kiem_soat":"Bắt buộc kiểm quyết định giá/chương trình, thời gian, điều kiện; cấp duyệt theo rủi ro và thẩm quyền; không mặc nhiên được đăng nhanh"},{"ma":"V2-07","ten":"V2 – Kiến thức sức khỏe theo kịch bản chuẩn","vi_du":"Bác sĩ trình bày 3 bước chuẩn bị khám, hướng dẫn chăm sóc sau khám đã được cơ sở chuyên môn xác nhận","dau_hieu":"Một chủ đề, lời ngắn theo kịch bản đã duyệt, cảnh minh họa chuẩn; không cam kết hiệu quả cá nhân","phan_cong":"Biên tập TCT viết lời, bác sĩ xác nhận, Media cơ sở quay/dựng theo mẫu","quy_tac_kiem_soat":"Có giải đáp ca bệnh, lập luận riêng, phỏng vấn nhiều tuyến hoặc phân tích chuyên sâu → V3-B"},{"ma":"V3-A01","ten":"V3-A – Câu chuyện không có nội dung y khoa","vi_du":"Chân dung nhân sự, câu chuyện phục vụ, văn hóa doanh nghiệp, chuyện đối tác, hành trình thiện nguyện","dau_hieu":"Có tuyến chuyện, nhân vật, tình tiết, câu hỏi phỏng vấn, nhiều phân đoạn; không đánh đồng với V2 chỉ vì video ngắn","phan_cong":"Biên tập TCT chủ trì lời/câu hỏi; Media TCT lập phân cảnh; cơ sở quay/dựng nếu thuộc mẫu, TCT hậu kỳ phức tạp","quy_tac_kiem_soat":"Kiểm quyền hình ảnh, nguồn lời nói, cam kết thương hiệu; nếu phát sinh thông tin bệnh nhân/y khoa → V3-B"},{"ma":"V3-B01","ten":"V3-B – Bác sĩ chia sẻ chuyên môn","vi_du":"Phỏng vấn bác sĩ về triệu chứng, phương pháp chẩn đoán, điều trị, phục hồi, phòng bệnh","dau_hieu":"Câu hỏi, luận điểm, tư liệu minh họa có kiểm chứng chuyên môn; không thay thế tư vấn cá nhân","phan_cong":"Biên tập TCT viết câu hỏi/lời; Media TCT phân cảnh; cơ sở ghi hình/dựng trong mẫu; TCT xử lý hậu kỳ chuyên sâu","quy_tac_kiem_soat":"Bác sĩ/đơn vị chuyên môn bắt buộc xác nhận; kiểm pháp lý quảng cáo, không khẳng định quá mức"},{"ma":"V3-B02","ten":"V3-B – Câu chuyện người bệnh/ca bệnh","vi_du":"Hành trình điều trị, trải nghiệm bệnh nhân, nội dung trước–sau hoặc mô tả kết quả điều trị","dau_hieu":"Kịch bản riêng, nhân vật thật, bằng chứng hồ sơ, phạm vi thông tin được phép sử dụng; không mặc nhiên được dùng hình ảnh người bệnh","phan_cong":"Biên tập TCT lập kịch bản; bác sĩ xác nhận; cơ sở phối hợp ghi hình; Media TCT kiểm kỹ thuật/hậu kỳ","quy_tac_kiem_soat":"Có văn bản đồng ý hợp lệ, căn cứ chuyên môn và rà soát pháp lý; không phỏng vấn/đăng khi chưa đủ hồ sơ"},{"ma":"V4-01","ten":"V4 – Chiến dịch, phim thương hiệu, phim giới thiệu hệ thống","vi_du":"TVC thương hiệu, phim ra mắt cơ sở, phóng sự tổng thể, chiến dịch lớn, chuỗi phim nhiều địa điểm","dau_hieu":"Ý tưởng và kịch bản riêng, quy mô nhiều bối cảnh, hậu kỳ hoặc quản lý sản xuất phức tạp","phan_cong":"Media TCT chủ trì toàn bộ sản xuất và điều phối; Media cơ sở hỗ trợ hiện trường, tư liệu","quy_tac_kiem_soat":"Duyệt kịch bản/chi phí/phát hành theo hạng mục và thẩm quyền; không áp mẫu V2 để giao V4 cho cơ sở"}],"nguyen_tac_kich_ban_contact_center_18112026":{"ket_luan":"Contact Center ngoài Marketing, chủ biên kịch bản nghiệp vụ; cơ sở cung cấp và xác nhận đầu vào; Marketing chỉ phối hợp thông điệp.","phan_biet":"Kịch bản tư vấn Contact Center khác kịch bản video, phát thanh, MC và kịch bản truyền thông do Marketing phụ trách.","khong_tang_dinh_bien_marketing":true,"tham_chieu":"Mục 17.4; mảng 17; ma trận TCT–chi nhánh số 21; biểu mẫu M-1"},"phan_dinh_quan_ly_hai_cvt_19112026":{"dinh_bien":{"tct":22,"benh_vien":14,"tong":36,"cvt":2,"to_chuyen_mon":3},"tuyen":{"CVT1":"Quản lý trực tiếp tất cả Trưởng nhóm Marketing bệnh viện Nhóm 1 và Nhóm 2 (kể cả Trưởng nhóm chuyên khoa kiêm Truyền thông); quản lý dọc kế hoạch, giao việc, tải việc, đánh giá và tổng hợp; đồng thời quản lý chuyên môn Tổ Nội dung và Sáng tạo tại Tổng công ty.","CVT2":"Quản lý Tổ Truyền thông và Thương hiệu, Tổ Tăng trưởng số tại Tổng công ty; ban hành hướng dẫn và kiểm tra chuẩn nghiệp vụ tại các bệnh viện thuộc cả hai nhóm; không là cấp quản lý trực tiếp và không được tự sửa tải việc/KPI của Trưởng nhóm Marketing cơ sở.","co_so":"Nhân viên cơ sở chịu sự phân công trực tiếp của Trưởng nhóm; Trưởng nhóm chịu sự quản lý trực tiếp của Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở. Người kiêm nhiệm truyền thông vẫn một cấp quản lý. Ban Giám đốc bệnh viện xác nhận dữ kiện, quản lý chấm công và nội quy tại chỗ, không trở thành cấp duyệt Marketing mặc định.","duyet":"Kiểm chuyên môn ≠ nghiệm thu mục tiêu ≠ phê duyệt phát hành ≠ phê duyệt ngân sách, chi phí; phân quyền bởi cấp có thẩm quyền","tth_clinic":"Thuộc Nhóm 1 TTH Group / TTH Healthcare / TTH Hospital / TTH Clinic, đầu mối kiêm nhiệm, không thuộc khối thương hiệu độc lập","truong_hop_phat_sinh":"Một mã việc, một đầu mối quản lý tải việc: Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số trao đổi với Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở trước khi điều chỉnh đầu việc ở cơ sở. Xung đột ưu tiên, thiếu nhân lực, hoặc bất đồng kiểm chuyên môn được Trưởng phòng quyết định; tình huống nội dung rủi ro dừng phát hành đúng quyền và lưu hồ sơ.","kiem_nhiem_bv_chuyen_khoa":"Trưởng nhóm Marketing kiêm Truyền thông tại Nguyên Phúc và Thái Thượng Hoàng: báo cáo, nhận quản lý và đánh giá từ Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở; chuẩn nghiệp vụ truyền thông từ Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số; không tự duyệt nội dung mình sản xuất; ghi riêng tải công việc quản lý và tải truyền thông.","phan_quyen_cong_viec":"Một người quản lý trực tiếp cho một Trưởng nhóm/một thời kỳ; một người chủ trì một mã việc; kiểm y khoa, kiểm chuyên môn Marketing, nghiệm thu mục tiêu, duyệt phát hành và duyệt chi phí là các bước tách riêng."},"trang_thai":"Phương án cơ cấu quản lý đơn tuyến đã thống nhất trong hồ sơ trình; quyền thực thi tuân theo quyết định và ủy quyền có hiệu lực.","lo_trinh":"Mốc tăng định biên tương lai của phương án 34 suất cũ cần tính lại theo tải WISN; không tự cộng thêm 02 người vào mọi mốc"},"phan_tuyen_quan_ly_coso_19112026":{"tuyen_quan_ly_chinh":["Trưởng phòng Marketing","Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở","Trưởng nhóm Marketing bệnh viện Nhóm 1 hoặc Nhóm 2","Nhân viên Marketing bệnh viện"],"tuyen_huong_dan_chuyen_mon":"Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số hướng dẫn và kiểm tra nghiệp vụ Truyền thông/Thương hiệu/Tăng trưởng số qua Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở; không có quyền giao thêm việc, đổi tiến độ hoặc đánh giá nhân sự Trưởng nhóm.","kiem_nhiem_chuyen_khoa":"Nguyên Phúc và Thái Thượng Hoàng: Trưởng nhóm Marketing kiêm Truyền thông vẫn thuộc CVT Nội dung – Cơ sở trực tiếp, phân tải quản lý và truyền thông riêng trong cùng KPI; ghi nguồn hướng dẫn CVT Truyền thông – Số, cùng một lịch công tác.","chan":["Mỗi nhân sự chỉ một manager_id đang hiệu lực","CVT Truyền thông – Số không là người đánh giá trực tiếp Trưởng nhóm","Giao việc mới thay đổi tải qua CVT Nội dung – Cơ sở","Nội dung chưa xác nhận y tế hoặc chưa đủ duyệt không phát hành","Một KPI, giờ công, đầu ra chỉ ghi một lần; tỷ lệ chia việc kiêm nhiệm cần đo thực tế"],"quy_tac_vang_mat":"CVT Nội dung – Cơ sở vắng mặt: Trưởng phòng chỉ định người điều phối tạm, ghi phạm vi và thời hạn; quyền đánh giá không tự chuyển cho CVT Truyền thông – Số.","vi_du":["Nguyên Phúc – video YHCT V3","Thái Thượng Hoàng – biển bảng OOH","Phát thanh bệnh viện chuyên khoa","Yêu cầu truyền thông phát sinh","Đánh giá KPI người kiêm nhiệm"],"nhan_su_ap_dung":[{"ma_vi_tri":"tn-a","quan_ly_truc_tiep":"cvt","huong_dan_truyen_thong":"cvt-2","nhom":"1"},{"ma_vi_tri":"tn-b","quan_ly_truc_tiep":"cvt","huong_dan_truyen_thong":"cvt-2","nhom":"2","kiem_nhiem":"Truyền thông cơ sở"}]},"dau_moi_truc_tiep_marketing_co_so_19112026":{"nguoi_quan_ly_truc_tiep":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở","nguoi_kiem_tra_chuyen_mon":"Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số","pham_vi":"Toàn bộ Trưởng nhóm Marketing bệnh viện thuộc Nhóm thương hiệu 1 và 2, kể cả người kiêm nhiệm Truyền thông tại bệnh viện chuyên khoa.","ngoai_le":"Chỉ đổi tuyến khi quyết định quản lý vùng có hiệu lực và danh sách bàn giao cụ thể.","khong_giao_trung":"Mỗi công việc của Trưởng nhóm có một đầu mối phân tải và một người chịu trách nhiệm đánh giá."},"kiem_soat_phan_tuyen_19112026":{"nguyen_tac":"Một người lao động có một người quản lý trực tiếp đang hiệu lực. Quyền giao việc, kiểm tra chuyên môn, duyệt sản phẩm, duyệt phát hành, duyệt ngân sách và đánh giá kết quả là sáu quyền khác nhau.","nhom_1_2":"Nhóm thương hiệu 1/2 phân loại phạm vi thương hiệu, không đồng nghĩa CVT 1/2 hay tuyến báo cáo.","quan_ly_truc_tiep":[{"vi_tri":"Trưởng nhóm Marketing bệnh viện, cả hai nhóm","bao_cao_truc_tiep":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở","phoi_hop_chuyen_mon":"Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số","quy_tac":"CVT Truyền thông – Số gửi yêu cầu chuyên môn qua CVT Nội dung – Cơ sở; không tự đổi ưu tiên và giao tải phát sinh."},{"vi_tri":"Media/Truyền thông Marketing cơ sở","bao_cao_truc_tiep":"Trưởng nhóm Marketing cơ sở","phoi_hop_chuyen_mon":"Tổ chuyên môn TCT theo đúng mảng","quy_tac":"Không nhận hai lệnh sản xuất cùng hạn từ hai đầu mối khác nhau; lịch và giờ công do Trưởng nhóm xác nhận."},{"vi_tri":"Trưởng nhóm Marketing kiêm Truyền thông tại bệnh viện chuyên khoa","bao_cao_truc_tiep":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở","phoi_hop_chuyen_mon":"Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số","quy_tac":"Một người, một KPI tổng hợp; tách hạng mục việc Marketing và truyền thông khi chấm tải, không tạo hai người quản lý."},{"vi_tri":"Đầu mối kiêm nhiệm tại phòng khám đa khoa","bao_cao_truc_tiep":"Người quản lý nhân sự tại phòng khám theo quyết định hiện hành","phoi_hop_chuyen_mon":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở thông qua đầu mối phụ trách cơ sở được giao","quy_tac":"Không mặc nhiên chuyển quan hệ lao động/đánh giá sang Phòng Marketing TCT; bổ sung phân tuyến chỉ khi có phân công chính thức."},{"vi_tri":"Người phụ trách Quản lý mạng lưới theo vùng (nếu bổ nhiệm)","bao_cao_truc_tiep":"Theo quyết định bổ nhiệm","phoi_hop_chuyen_mon":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở","quy_tac":"Chưa kích hoạt quyền quản lý trực tiếp khi chưa ban hành phân vùng, người nhận bàn giao và ngày hiệu lực; tránh song trùng cấp trên."}],"phan_quyen_sau_quy_trinh":[{"quyen":"Giao việc/đổi thời hạn tại cơ sở","nguoi_co_quyen":"Trưởng nhóm; CVT Nội dung – Cơ sở điều chỉnh ở cấp cơ sở theo phân quyền","chan":"CVT Truyền thông – Số không được trực tiếp thay đổi tải việc của cơ sở"},{"quyen":"Kiểm tra nghiệp vụ","nguoi_co_quyen":"Đúng chức năng tổ và người được phân công kiểm tra","chan":"Kiểm tra không đồng nghĩa quyền duyệt phát hành"},{"quyen":"Phê duyệt nội dung y tế","nguoi_co_quyen":"Đầu mối chuyên môn y tế có thẩm quyền","chan":"Marketing không thay bác sĩ xác nhận tính đúng đắn y khoa"},{"quyen":"Phê duyệt phát hành","nguoi_co_quyen":"Người được phân quyền theo loại sản phẩm, kênh và nhóm thương hiệu","chan":"Thiếu ma trận phê duyệt hoặc thiếu xác nhận y tế: khóa phát hành"},{"quyen":"Phê duyệt chi phí","nguoi_co_quyen":"Người có thẩm quyền ngân sách theo phân cấp","chan":"Duyệt sản phẩm không được mặc nhiên duyệt ngân sách"},{"quyen":"Đánh giá cá nhân","nguoi_co_quyen":"Người quản lý trực tiếp; bộ phận chuyên môn cung cấp ý kiến kiểm chứng","chan":"Không tạo đồng thời hai phiếu đánh giá KPI cho một người"}],"xung_dot":"Mọi xung đột ưu tiên, nguồn lực hoặc hai người cùng giao việc: đóng băng yêu cầu trùng và chuyển Trưởng phòng Marketing xử lý; ghi người quyết định, thời hạn và lý do. Không xuất hai lệnh chạy song song.","phan_he":"Cả hai phân hệ phần mềm dùng chung mã yêu cầu, mã chiến dịch/hạng mục, danh mục nhân sự, trường manager_id, bộ phê duyệt và nhật ký; công việc phát sinh phải gắn công việc thường xuyên hoặc hạng mục trọng điểm theo tiêu chí, không sao chép hai bản ghi công việc."},"bo_mau_bao_cao_y_te_19112026":{"tinh_trang":"Đặc tả kiểm soát đề xuất, chưa phải biểu mẫu ban hành","mau":{"BM-1":{"doi_soat":["Tổng yêu cầu tiếp nhận theo nguồn/kênh/cơ sở","Lead hợp lệ và nguyên nhân loại","Lịch đặt có mã","Khách đến theo dữ liệu tiếp đón","Khách thực hiện dịch vụ theo dữ liệu nghiệp vụ đã đối soát","Doanh thu ghi nhận bởi hệ thống tài chính (nếu được cấp quyền)"],"chi_so":["Chi phí được duyệt, thực chi, cam kết chi, dự báo","Tỷ lệ đặt lịch trên Lead hợp lệ","Tỷ lệ khách đến trên lịch hẹn","Tỷ lệ thực hiện dịch vụ trên khách đến","Chi phí/Lead hợp lệ; chi phí/lịch hẹn; chi phí/khách thực hiện dịch vụ"],"giai_trinh":["So sánh kế hoạch – thực tế – kỳ trước theo từng bệnh viện/chuyên khoa","Sai lệch số liệu, đối soát chéo Contact Center/CRM/tiếp đón/tài chính","Rủi ro pháp lý quảng cáo và điểm chặn","Người chịu trách nhiệm, hạn khắc phục, chứng cứ đóng việc"],"luu_y":"Không đồng nhất Lead, đặt lịch, khách đến và khách khám; báo cáo lãnh đạo dùng số tổng hợp, không kèm định danh bệnh nhân."},"BM-2":{"doi_soat":["Tồn đầu tuần, phát sinh, hoàn thành, tồn cuối tuần","Việc trọng điểm và việc thường xuyên theo nhân sự/tổ/cơ sở","Việc trễ hạn, thay đổi ưu tiên và lý do"],"chi_so":["Tỷ lệ đúng hạn","Số sản phẩm đạt ngay vòng duyệt đầu","Số vòng sửa hợp lệ","Giờ công và tải thực tế phân tách kiêm nhiệm"],"giai_trinh":["Vấn đề cần quyết định","Hạn xử lý và chủ thể","Kế hoạch tuần kế tiếp gắn mã việc"],"luu_y":"Một mã việc xuất hiện trong báo cáo theo nhiều góc nhìn nhưng không cộng đôi số việc hoặc giờ công."},"BM-3":{"doi_soat":["Mã kế hoạch, nhóm thương hiệu, cơ sở, kênh, dịch vụ/chuyên khoa","Mục tiêu, thông điệp đã duyệt, nguồn chứng cứ","Sản phẩm, đơn vị chủ trì, hạn, người kiểm, người duyệt"],"chi_so":["Số nội dung theo loại và theo kênh","Tải công việc dự kiến và tồn kho nội dung"],"giai_trinh":["Điều kiện tuân thủ quảng cáo khám chữa bệnh khi có yếu tố dịch vụ/giá/hiệu quả","Ngày hết hiệu lực và quy tắc thu hồi"],"luu_y":"Lịch nội dung không được coi là giấy phép phát hành."},"BM-4":{"doi_soat":["Mã yêu cầu/mã thiết bị/mã sản phẩm","Trạng thái mượn-trả thiết bị, người nhận và giờ bàn giao","Ca trùng lịch và phân xử ưu tiên"],"chi_so":["Giờ quay/dựng thực tế","Tỷ lệ đúng hạn và sử dụng thiết bị"],"giai_trinh":["Bản quyền, đồng ý sử dụng hình ảnh, nguồn tư liệu","Hồ sơ lưu bản gốc và bản dựng"],"luu_y":"Thông tin nhận diện bệnh nhân phải được kiểm soát quyền."},"BM-5":{"doi_soat":["Lịch đăng gắn sản phẩm đã duyệt","Mã kênh, ngày giờ, người phát hành, phiên bản và ngày hiệu lực"],"chi_so":["Đăng đúng lịch","Lỗi phát hành/thu hồi"],"giai_trinh":["Bằng chứng màn hình, URL, mức độ thay đổi sau phát hành"],"luu_y":"Không đăng chỉ vì lịch đến hạn nếu chưa đủ các xác nhận bắt buộc."}},"phuong_phap":"Chỉ tiêu phải nêu tử số, mẫu số, kỳ đo, nguồn ghi nhận, ngày khóa kỳ, người đối soát, quy tắc loại trùng và cách xử lý dữ liệu thiếu. Các số tiền lấy từ bộ phận tài chính, không tự quy đổi từ kết quả quảng cáo.","tuyen_xac_nhan":"Dữ liệu nguồn → đo lường/đối soát → người phụ trách nghiệp vụ xác nhận → Trưởng phòng rà soát → cấp có thẩm quyền duyệt báo cáo."}}</script><script>(function(){
var root=document.getElementById('ops-root'),src=document.getElementById('csdl');if(!root||!src)return;
var D=JSON.parse(src.textContent),M={};
function put(list,kind){list.forEach(function(x){M[x.id]={ten:x.ten,kind:kind,x:x}})}
put(D.chuc_danh,'cd');put(D.vi_tri,'vt');put(D.vai_tro,'vr');put(D.don_vi,'dv');
var CODE={};(D.danh_muc_tai_lieu||[]).forEach(function(x){CODE[x.ma]='dm-'+x.ma});(D.quy_tac||[]).forEach(function(x){CODE[x.ma]='qtac-'+x.ma});if(D.ngoai_le_cheo_nhom){D.ngoai_le_cheo_nhom.truong_hop.concat(D.ngoai_le_cheo_nhom.rao_chan).forEach(function(x){CODE[x.ma]='qtac-'+x.ma})}CODE['KPI-QT']='qtac-KPI-QT';
var TOG={lanhdao:'ld',th:'th',nd:'nd',ts:'ts',coso:'cs'};
var LOAIG={lanh_dao:'ld',co_so:'bgd',contact_center:'cc',khac:'ngoai',ben_ngoai:'ngoai'};
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function tx(s){s=esc(s);
  s=s.replace(/(mục )(\d+(?:\.\d+)?)(?![\d.]*\d)/g,function(m,a,n){var id='m-'+n.replace('.','-');return document.getElementById(id)?a+'<a class="xref" href="#'+id+'" data-sec="'+id+'">'+n+'</a>':m});
  s=s.replace(/(^|[^\w\-])((?:BM|SO|HS|DM|DS|QC|M|B|RC|CN)-\d+|R\d\d|KPI-QT)(?![\w\-])/g,function(m0,p,c){return CODE[c]?p+'<a class="xref" href="#'+CODE[c]+'">'+c+'</a>':m0});
  return s.replace(/Đề xuất – chờ duyệt/g,'<span class="pend">Đề xuất – chờ duyệt</span>')}
function ref(r){var p=String(r).split('|'),e=M[p[0]];if(!e)return{label:r,g:'ngoai'};
  var g=e.kind==='dv'?(e.x.loai==='marketing'?(e.x.id==='mkt-coso'?'cs':'mkt'):LOAIG[e.x.loai]):TOG[e.x.to]||'ngoai';
  return{label:e.ten+(p[1]?' ('+p[1]+')':''),g:g}}
function chip(r,w){var o=ref(r);return '<span class="ochip g-'+o.g+(w?' with':'')+'">'+esc(o.label)+'</span>'}
function chips(a,w){return (a||[]).map(function(r){return chip(r,w)}).join('')}
function ul(a){return '<ul class="ops-ul">'+a.map(function(x){return '<li>'+tx(x)+'</li>'}).join('')+'</ul>'}
var DX='<span class="pend">Đề xuất – chờ duyệt</span>';
function qtl(s){return tx(s).replace(/QT\.(\d+)(?![\d.])/g,function(m,n){var q=D.quy_trinh[+n-1];return q?'<a class="qtl" href="#vh-qt-'+q.id+'" data-go="vh-qt-'+q.id+'">QT.'+n+'</a>':m})}
function sec(id,num,title,body,sub){var h=sub?'h3':'h2';return '<section class="doc-sec ops-sec'+(sub?' sub':'')+'" id="'+id+'" data-title="'+esc(title)+'"><'+h+' class="sec-h"><span class="sec-num">'+num+'</span>'+esc(title)+'</'+h+'>'+body+'</section>'}
var legend='<div class="ops-legend">'+[['ld','Lãnh đạo phòng, Ban Tổng Giám đốc'],['th','Tổ Truyền thông và Thương hiệu'],['nd','Tổ Nội dung và Sáng tạo'],['ts','Tổ Tăng trưởng số'],['cs','Marketing cơ sở'],['cc','Contact Center'],['bgd','Cơ sở: Ban Giám đốc, khoa phòng, bộ phận'],['ngoai','Đơn vị khác']].map(function(x){return '<span class="ochip g-'+x[0]+'">'+x[1]+'</span>'}).join('')+'</div>';
var KP={};D.kpi.forEach(function(k){KP[k.id]=k.ten});
var NH={};D.nhom_hoat_dong.forEach(function(n){NH[n.id]=n.ten});
var h='';

/* VH.1 Hành trình khách hàng */
h+=sec('vh-hanh-trinh','VH.1','Hành trình khách hàng: ai phụ trách khâu nào','<p class="lede">Marketing đưa khách đến và giữ quan hệ sau khám; Contact Center tiếp nhận từ xa; cơ sở tiếp đón, khám, giải quyết phản ánh.</p>'+legend+
 '<ol class="ops-journey">'+D.hanh_trinh_khach_hang.map(function(s,i){var g=s.chiu_trach_nhiem.length?ref(s.chiu_trach_nhiem[0]).g:'ngoai';
  return '<li class="ops-jn g-b-'+g+'"><div class="ops-jh"><span class="ops-n">'+(i+1)+'</span><b>'+esc(s.ten)+'</b>'+(s.de_xuat?DX:'')+'</div>'+
  '<dl><dt>Chịu trách nhiệm</dt><dd>'+(s.chiu_trach_nhiem.length?chips(s.chiu_trach_nhiem):'<span class="ochip g-ngoai">'+esc(s.chiu_trach_nhiem_ghi_chu)+'</span>')+'</dd><dt>Marketing làm</dt><dd>'+tx(s.marketing_lam)+'</dd><dt>Đơn vị khác làm</dt><dd>'+tx(s.don_vi_khac_lam)+'</dd><dt>Căn cứ</dt><dd class="ops-mute">'+tx(s.can_cu)+'</dd></dl></li>'}).join('')+'</ol>');

/* VH.2 Phạm vi */
var own=D.mang_viec.filter(function(m){return m.pham_vi==='marketing'}),part=D.mang_viec.filter(function(m){return m.pham_vi==='mot_phan'});
function li3(n,a,b){return '<li><span class="ops-mn">'+n+'</span><span>'+tx(a)+'<small>'+tx(b)+'</small></span></li>'}
h+=sec('vh-pham-vi','VH.2','Phạm vi công việc Marketing','<p class="lede">Đọc từ bảng phân định 04 cột (mục 31) và phân định với đơn vị ngoài (mục 17, mục 18). Số là mảng ở mục 31.</p><div class="ops-scope">'+
 '<div class="ops-col c-mkt"><h3>Marketing chịu trách nhiệm kết quả <em>'+own.length+' mảng</em></h3><ul class="ops-sl">'+own.map(function(m){return li3(m.so,m.ten,'Chịu trách nhiệm kết quả: '+m.chiu_trach_nhiem)}).join('')+'</ul></div>'+
 '<div class="ops-col c-cc"><h3>Marketing làm một phần, đơn vị khác chịu kết quả <em>'+(part.length+D.mang_viec_bo_sung.length)+' việc</em></h3><ul class="ops-sl">'+part.map(function(m){return li3(m.so,m.ten,'Marketing: '+m.phan_marketing+'. Chịu kết quả: '+m.chiu_trach_nhiem)}).join('')+D.mang_viec_bo_sung.map(function(m){return li3('–',m.ten,'Marketing: '+m.phan_marketing+'. Chịu kết quả: '+m.chiu_trach_nhiem+' ('+m.can_cu+')')}).join('')+'</ul></div>'+
 '<div class="ops-col c-ng"><h3>Không thuộc Marketing <em>'+D.ngoai_pham_vi.length+' việc</em></h3><ul class="ops-sl">'+D.ngoai_pham_vi.map(function(n,i){return '<li><span class="ops-mn">'+(i+1)+'</span><span>'+tx(n.viec)+'<small>'+n.don_vi.map(function(r){return esc(ref(r).label)}).join('; ')+' · '+tx(n.ghi_chu)+'</small></span></li>'}).join('')+'</ul></div></div>');

