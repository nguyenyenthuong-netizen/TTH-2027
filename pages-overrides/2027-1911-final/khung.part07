h khung.","Trạng thái đồng ý mặc định là chưa đồng ý; không được ghi hình/sử dụng ngoài phạm vi hợp pháp khi thiếu đồng ý; rút đồng ý kích hoạt quy trình rà soát dừng sử dụng theo chính sách pháp chế.","Tuyệt đối không đưa họ tên/người bệnh thật vào bản khung mẫu hoặc dữ liệu demo."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm.","bo_tieu_chuan_19112026":{"tham_chieu":"QT.21, QT.48; mục 17.1","thanh_phan_bat_buoc":["Mã biểu mẫu và phiên bản","Mã việc/chương trình hoặc kỳ báo cáo","Nhóm thương hiệu – cơ sở – chuyên khoa/dịch vụ nếu có","Người lập và người xác nhận","Thời điểm chốt, tài liệu nguồn","Trạng thái, lịch sử sửa, dấu vết duyệt"],"dieu_kien_chan":["Không có mã/phiên bản/phạm vi áp dụng hoặc mất nguồn xác nhận","Người tự làm tự duyệt khi không có ủy quyền phù hợp","Hồ sơ y tế/khách hàng chứa dữ liệu cá nhân vượt quyền hoặc thiếu căn cứ sử dụng","Có thay đổi sau phê duyệt nhưng chưa tái kiểm soát"],"tieu_chi_nghiem_thu":["Có đủ thành phần bắt buộc hoặc lý do không áp dụng đã được chấp thuận","Có mã hồ sơ nguồn và minh chứng đối soát","Người kiểm chuyên môn và người phê duyệt được phân tách theo thẩm quyền","Khôi phục được phiên bản cũ; truy ra người sửa, thời gian, lý do"],"che_do_xuat":"HTML/PDF đọc được và dữ liệu bảng CSV/XLSX (chỉ với dữ liệu bảng); giữ tiếng Việt Unicode, mã và phiên bản","xu_ly_chua_co_phan_mem":"Dùng bảng tính/tệp có mã bản ghi, phiên bản và nhật ký phê duyệt; quyền truy cập được kiểm soát, không lưu dữ liệu người bệnh vào bản trình","trang_thai":"ĐẶC TẢ ĐỀ XUẤT – chờ đơn vị nắm giữ, đơn vị duyệt và Phòng Quản lý chất lượng xác nhận trước ban hành","truong_kiem_soat_chung":["ma_ban_ghi","ma_nguon","nguoi_lap","thoi_diem_lap","trang_thai","phien_ban","nguoi_xac_nhan","nguoi_duyet","lich_su_sua","nguon_du_lieu"]}},{"ma":"BM-26","loai":"Biểu mẫu","ten":"Bản cộng nhu cầu mua của 02 nhóm","noi_dung":"Nhà cung cấp, loại hàng, dịch vụ, giá trị từng nhóm, 