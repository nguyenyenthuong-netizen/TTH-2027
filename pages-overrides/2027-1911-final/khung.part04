goai_le":[{"tinh_huong":"Loại việc chưa có trong bảng phân công","cach_lam":"Trưởng phòng xếp một lần vào vị trí có chức năng gần nhất, bổ sung vào bảng."},{"tinh_huong":"Xung đột ưu tiên tại cơ sở","cach_lam":"Quản lý thương hiệu của nhóm và Trưởng nhóm thống nhất; chưa được thì Chuyên viên trưởng quyết định; liên quan Ban Giám đốc cơ sở thì Trưởng phòng làm việc với Ban Giám đốc cơ sở."}],"nhom_vi_du":"N1","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-ngoai-luong"},{"id":"co-so-moi","ten":"Cơ sở mới hoạt động","nhom_hoat_dong":["N1","N3","N8","N11"],"vi_du":"Bệnh viện Đa khoa Quốc tế TTH Huế khai trương theo lịch Ban Tổng Giám đốc chốt (nhóm 1).","buoc":[{"thuc_hien":["dl-1","cvt"],"phoi_hop":["tp","btgd"],"noi_dung":"Rà soát định biên với giờ thêm của bệnh viện mới: Tổng công ty không thêm người ở bước này; Marketing cơ sở 03 người.","thoi_han":"03 tháng trước khi cơ sở hoạt động","ghi_nhan":"Biên bản rà soát định biên","can_cu":"mục 14.14; mục 21","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung","chu_tri_chinh":"dl-1","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Biên bản rà soát định biên","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắ