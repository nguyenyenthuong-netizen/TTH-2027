<script id="csdl" type="application/json">{"ten":"Cơ sở dữ liệu tổ chức và vận hành Marketing toàn hệ thống TTH Group – phương án 2 nhóm thương hiệu","ngay_cap_nhat":"19/11/2026 – cơ cấu 02 Chuyên viên trưởng, 03 tổ chuyên môn, 02 nhóm thương hiệu; đối soát tuyến TCT – bệnh viện","trang_thai":"Phương án cơ cấu Marketing TTH Group 2027; chưa thay quyết định nhân sự, thẩm quyền phê duyệt hay quy chế đã ban hành.","nguon":"Khung bộ máy, định biên và phân công Marketing toàn hệ thống TTH Group – phương án 2 nhóm thương hiệu (10/11/2026)","quy_uoc_tham_chieu":"Trường thuc_hien, phoi_hop, chiu_trach_nhiem, don_vi ghi mã: vi_tri, chuc_danh, vai_tro hoặc don_vi; dạng \"mã|ghi chú\"","to":[{"id":"lanhdao","ten":"Lãnh đạo, quản lý"},{"id":"th","ten":"Tổ Truyền thông và Thương hiệu"},{"id":"nd","ten":"Tổ Nội dung và Sáng tạo"},{"id":"ts","ten":"Tổ Tăng trưởng số"},{"id":"coso","ten":"Marketing cơ sở"}],"chuc_danh":[{"id":"tp","ten":"Trưởng phòng Marketing","to":"lanhdao"},{"id":"cvt","ten":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở","to":"lanhdao"},{"id":"qlth","ten":"Quản lý thương hiệu","to":"th"},{"id":"cvtt","ten":"Chuyên viên truyền thông","to":"th"},{"id":"bt","ten":"Chuyên viên biên tập","to":"nd"},{"id":"tk","ten":"Chuyên viên thiết kế","to":"nd"},{"id":"md","ten":"Chuyên viên media","to":"nd"},{"id":"qc","ten":"Chuyên viên quảng cáo và kênh số","to":"ts"},{"id":"dl","ten":"Chuyên viên đo lường và đối soát; Chuyên viên dữ liệu khách hàng và thị trường","to":"ts"},{"id":"qlsps","ten":"Quản lý sản phẩm số","to":"ts"},{"id":"qlml","ten":"Quản lý mạng lưới Marketing cơ sở theo vùng","to":"lanhdao"},{"id":"tn","ten":"Trưởng nhóm Marketing cơ sở","to":"coso"},{"id":"mdcs","ten":"Chuyên viên Marketing cơ sở – media","to":"coso"},{"id":"qhcs","ten":"Chuyên viên Marketing cơ sở – truyền thông","to":"coso"},{"id":"dmpk","ten":"Đầu mối kiêm nhiệm tại phòng khám","to":"coso"},{"id":"cvt2","ten":"Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số","to":"lanhdao"}],"vi_tri":[{"id":"tp","ten":"Trưởng phòng Marketing","to":"lanhdao","nhom_thuong_hieu":"","chuc_danh":"tp","thay_chinh":"cvt","du_phong":["qlsps|thứ tự ủy quyền thứ hai, chỉ việc không có chi mới ngoài hạn mức; việc có chi mới: Tổng Giám đốc"],"pham_vi":"trung_lap","gio_ke_hoach":"≈ 81–88 giờ/tháng (ước tính, đo ở thí điểm)","viec_chung":"Điều hành; duyệt theo phân cấp (mục 14.16); quyền quản trị cao nhất kênh (R08)","muc_dich":"Tham mưu cho Ban Tổng Giám đốc và chịu trách nhiệm chung về công tác Marketing của toàn hệ thống: kế hoạch, ngân sách, nội dung chuyên môn, kết quả Hạng mục trọng điểm (mục 4.1); chủ trì khủng hoảng liên quan cả hai nhóm.","bao_cao_cho":"Ban Tổng Giám đốc","ngach":"Theo khung lãnh đạo của Tổng công ty (mục 24.2)","trang_thai_kpi":"Chưa có bảng KPI chính thức; phải lập và duyệt trước khi áp dụng với vị trí này.","phan_dinh_chu_tri_dau_ra":"Chủ kế hoạch năm, ngân sách, cơ chế duyệt, kết quả toàn phòng; quyết định ưu tiên giữa hai nhóm","phan_dinh_khong_thuoc_trach_nhiem":"Không mặc nhiên duyệt thay bác sĩ, Pháp chế, Ban Tổng Giám đốc hoặc đơn vị chủ dữ liệu","phan_dinh_ban_giao_dau_vao":"Nhận báo cáo từ Quản lý thương hiệu, Chuyên viên trưởng, đo lường; ký/duyệt theo ma trận thẩm quyền","phan_dinh_kiem_duyet":"Ban Tổng Giám đốc đối với nội dung vượt thẩm quyền"},{"id":"cvt","ten":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở","to":"lanhdao","nhom_thuong_hieu":"","chuc_danh":"cvt","thay_chinh":"tp","du_phong":["qlsps|việc không có chi mới ngoài hạn mức"],"pham_vi":"trung_lap","gio_ke_hoach":"Tính tải quản lý và nghiệp vụ từ nhật ký công việc thực đo; không cộng chồng tải Tổ trưởng hoặc người sản xuất.","viec_chung":"Điều phối năng lực và kế hoạch sản xuất Nội dung – Biên tập – Thiết kế – Media hai nhóm; tiêu chuẩn kịch bản, file mẫu, bộ nhận diện sản phẩm, lịch dùng thiết bị Media và kiểm soát kỹ thuật sản xuất toàn hệ thống. Tổ trưởng tại bệnh viện trực tiếp giao việc hiện trường; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở giải quyết xung đột năng lực sản xuất đúng thẩm quyền.","muc_dich":"Quản lý trực tiếp các Trưởng nhóm Marketing bệnh viện thuộc cả Nhóm 1 và Nhóm 2; là một đầu mối quản lý dọc về kế hoạch, giao việc điều phối, tải việc, tiến độ, đánh giá và tổng hợp kết quả Marketing cơ sở. Đồng thời điều phối chuyên môn Tổ Nội dung và Sáng tạo TCT, chuẩn Biên tập – Thiết kế – Media. Không quản lý chấm công, nội quy hoặc ra lệnh trực tiếp cho từng nhân viên Marketing bệnh viện thay Trưởng nhóm.","bao_cao_cho":"Trưởng phòng Marketing","ngach":"Quản lý","phan_dinh_chu_tri_dau_ra":"Quản lý trực tiếp toàn bộ Trưởng nhóm Marketing bệnh viện (bao gồm Trưởng nhóm Nhóm 2 kiêm Truyền thông); chốt một lịch tải việc, đánh giá KPI Trưởng nhóm theo dữ liệu có xác nhận của cơ sở; phụ trách chuẩn/sản lượng và kiểm soát chuyên môn Tổ Nội dung và Sáng tạo. Phản hồi yêu cầu điều chỉnh ưu tiên từ Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số.","phan_dinh_khong_thuoc_trach_nhiem":"Không duyệt nội dung y khoa, nghiệm thu mục tiêu thương hiệu, duyệt phát hành, chi phí hoặc quản lý hành chính cơ sở nếu không có phân quyền cụ thể.","phan_dinh_ban_giao_dau_vao":"Nhận đề xuất xung đột, phân bổ nguồn lực theo phân cấp; bàn giao cho người được chỉ định","phan_dinh_kiem_duyet":"Có quyền quản lý, điều phối, đánh giá Trưởng nhóm cơ sở trong phạm vi phân công, không tự sinh quyền xác nhận y khoa, nghiệm thu mục tiêu, phê duyệt phát hành hoặc phê duyệt chi phí."},{"id":"cvt-2","ten":"Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số","to":"lanhdao","nhom_thuong_hieu":"","chuc_danh":"cvt2","pham_vi":"trung_lap","thay_chinh":"tp","du_phong":[],"bao_cao_cho":"Trưởng phòng Marketing","ngach":"Quản lý","gio_ke_hoach":"Tính tải quản lý của hai tổ và tuyến nghiệp vụ tại cơ sở theo giờ thực đo; không tự cộng quyền hoặc vị trí Tổ trưởng.","muc_dich":"Quản lý chuyên môn Tổ Truyền thông và Thương hiệu, Tổ Tăng trưởng số tại TCT; ban hành/hướng dẫn tiêu chuẩn truyền thông, OOH, màn hình, phát thanh, quảng cáo, kênh số đến bệnh viện Nhóm 1 và Nhóm 2. Không phải cấp trên quản lý trực tiếp của Trưởng nhóm Marketing cơ sở, kể cả Trưởng nhóm bệnh viện chuyên khoa đang kiêm nhiệm Truyền thông.","viec_chung":"Quản lý chuẩn PR, OOH, phát thanh và màn hình nội viện, kênh số, quảng cáo, sản phẩm số và đo lường theo từng nhóm thương hiệu. Tổ trưởng của hai tổ phân công nhân sự TCT; Tổ trưởng Marketing bệnh viện quản lý, giao việc nhân sự tại bệnh viện. Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số không trực tiếp ra hai lệnh cho cùng một nhân viên.","phan_dinh_chu_tri_dau_ra":"Quy chuẩn, kiểm tra chất lượng nghiệp vụ truyền thông, thương hiệu, PR/OOH, phát thanh, màn hình, kênh số; đề xuất yêu cầu chuyên môn với Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở để thống nhất tải việc/trạng thái trước khi giao xuống Trưởng nhóm cơ sở.","phan_dinh_khong_thuoc_trach_nhiem":"Không tự động duyệt nội dung y khoa, phát hành, ngân sách hoặc chi phí; không thay quản lý thương hiệu nghiệm thu hạng mục.","phan_dinh_ban_giao_dau_vao":"Nhận yêu cầu từ Quản lý thương hiệu, Tổ trưởng hai tổ và Tổ trưởng Marketing bệnh viện; điều phối một đầu mối công việc, chuyển đúng cấp duyệt.","phan_dinh_kiem_duyet":"Được kiểm chuẩn và thông báo lỗi chuyên môn; có thể yêu cầu tạm dừng chuyển phát hành khi chưa đủ điều kiện kiểm soát, theo ma trận quyền. Không mặc nhiên giao việc trực tiếp, đánh giá nhân sự Trưởng nhóm, duyệt phát hành hay duyệt chi; vượt quyền chuyển Trưởng phòng."},{"id":"qlth-a","ten":"Quản lý thương hiệu nhóm 1","to":"th","nhom_thuong_hieu":"N1","chuc_danh":"qlth","thay_chinh":"cvtt-a","du_phong":["cvt"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 139 giờ/tháng (sau cân giờ 14/11/2026: phần Hạng mục toàn hệ thống của nhóm 2 về Quản lý thương hiệu nhóm 2; tài trợ, hồ sơ năng lực về Chuyên viên truyền thông nhóm 1)","viec_chung":"Phần nhóm 1 của Hạng mục toàn hệ thống (chi phí dùng chung ở thương hiệu chủ); hội nghị, sự kiện cấp hệ thống mang thương hiệu TTH Group; Hạng mục đối tác cấp hệ thống của thương hiệu nhóm 1; trực sự cố tầng 1 chung (CN-4)","muc_dich":"Chịu trách nhiệm kết quả Hạng mục trọng điểm của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic): khách hàng, doanh thu ghi nhận theo nguồn khách; giữ định vị, thông điệp các thương hiệu TTH; chủ Hạng mục toàn hệ thống; đầu mối giao việc theo Hạng mục với Marketing của các bệnh viện, phòng khám nhóm 1.","bao_cao_cho":"Tổ trưởng Tổ Truyền thông và Thương hiệu phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"Chủ mục tiêu/kết quả Hạng mục nhóm 1; thông điệp, kế hoạch, nghiệm thu yêu cầu; giao nhiệm vụ theo Hạng mục","phan_dinh_khong_thuoc_trach_nhiem":"Không tự viết bài, dựng video, đăng quảng cáo, nhập CMS, xác nhận y khoa; không phân công chuyên môn nhóm 2","phan_dinh_ban_giao_dau_vao":"Đặt yêu cầu cho Biên tập/Thiết kế/Media/Quảng cáo/Truyền thông đúng nhóm; nhận dữ liệu cơ sở","phan_dinh_kiem_duyet":"Trưởng phòng/cấp được ủy quyền duyệt kế hoạch, ngân sách và phát hành theo loại"},{"id":"qlth-bc","ten":"Quản lý thương hiệu nhóm 2","to":"th","nhom_thuong_hieu":"N2","chuc_danh":"qlth","thay_chinh":"cvtt-bc","du_phong":["cvt"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 88–91 giờ/tháng (không kiêm Tổ trưởng; chỉ nghiệm thu, không kiểm lời)","viec_chung":"Phần nhóm 2 của Hạng mục toàn hệ thống (≈ 07 giờ/tháng); nhãn hiệu các thương hiệu nhóm 2 (hồ sơ: bộ phận pháp chế); trực sự cố tầng 1 chung (CN-4); Kiêm Tổ trưởng Tổ Truyền thông và Thương hiệu (04 vị trí), điều phối công việc chung không mặc định quyền phê duyệt","muc_dich":"Chịu trách nhiệm kết quả Hạng mục trọng điểm của nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng, các chuỗi chuyên khoa, Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện); giữ định vị, thông điệp các thương hiệu này; lập phần nhóm 2 của Hạng mục toàn hệ thống. Kiêm Tổ trưởng Tổ Truyền thông và Thương hiệu: điều phối tiến độ, phân việc, xử lý trùng lịch của cả 04 vị trí trong tổ, không làm thay công việc chuyên môn nhóm 1 và không tự có quyền duyệt ngân sách, nội dung hay quyết định nhân sự.","bao_cao_cho":"Tổ trưởng Tổ Truyền thông và Thương hiệu phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"Chủ mục tiêu/kết quả Hạng mục nhóm 2; kiêm điều phối tiến độ 04 vị trí của tổ, không thay trách nhiệm nhóm 1","phan_dinh_khong_thuoc_trach_nhiem":"Không tự thành cấp duyệt cao hơn; không duyệt ngân sách/nội dung chuyên môn và không chỉ đạo làm chéo nhóm","phan_dinh_ban_giao_dau_vao":"Nhận đề bài nhóm 2, phân luồng công việc tổ; báo Trưởng phòng khi xung đột","phan_dinh_kiem_duyet":"Trưởng phòng/cấp được ủy quyền; quyền tổ trưởng chỉ điều phối"},{"id":"cvtt-a","ten":"Chuyên viên truyền thông nhóm 1","to":"th","nhom_thuong_hieu":"N1","chuc_danh":"cvtt","thay_chinh":"qlth-a","du_phong":["cvt"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 115 giờ/tháng","viec_chung":"Phần nhóm 1 của chuẩn quan hệ công chúng, quy chế phát ngôn (Chuyên viên trưởng tổng hợp); hồ sơ năng lực Tập đoàn (ghép, phần nhóm 2 không sửa); tài trợ, hồ sơ năng lực thương hiệu Tập đoàn; trực sự cố tầng 1 chung (CN-4)","muc_dich":"Thực hiện quan hệ công chúng, kênh ngoại tuyến và nội viện của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic), gồm lịch phát màn hình, phát thanh nội viện của cơ sở nhóm 1; xử lý khủng hoảng của nhóm 1, gồm khủng hoảng mang tên TTH Group; khủng hoảng liên quan cả hai nhóm: làm phần của nhóm 1 theo chủ trì của Trưởng phòng. Góp phần nhóm 1 vào chuẩn quan hệ công chúng chung, quy chế phát ngôn (Chuyên viên trưởng giữ, QC-5).","bao_cao_cho":"Tổ trưởng Tổ Truyền thông và Thương hiệu phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"PR/báo chí, đối tác truyền thông, KOL/KOC, tài trợ và ngoại tuyến nhóm 1; chốt lịch màn hình, phát thanh cơ sở nhóm 1","phan_dinh_khong_thuoc_trach_nhiem":"Không sản xuất thay Biên tập/Thiết kế/Media; không vận hành thiết bị ở bệnh viện; không chốt KPI Hạng mục","phan_dinh_ban_giao_dau_vao":"Đặt sản phẩm qua Tổ Nội dung và Sáng tạo; giao lịch đã duyệt cho cơ sở; nhận ảnh nghiệm thu","phan_dinh_kiem_duyet":"Quản lý thương hiệu nghiệm thu phù hợp Hạng mục; Trưởng phòng/cấp có thẩm quyền duyệt phát ngôn"},{"id":"cvtt-bc","ten":"Chuyên viên truyền thông nhóm 2","to":"th","nhom_thuong_hieu":"N2","chuc_danh":"cvtt","thay_chinh":"qlth-bc","du_phong":["cvt"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 69 giờ/tháng","viec_chung":"Phần nhóm 2 của chuẩn quan hệ công chúng, quy chế phát ngôn; phần nhóm 2 của hồ sơ năng lực Tập đoàn; trực sự cố tầng 1 chung (CN-4)","muc_dich":"Thực hiện quan hệ công chúng, kênh ngoại tuyến và nội viện của nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng, các chuỗi chuyên khoa, Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện), gồm lịch phát màn hình, phát thanh nội viện của cơ sở nhóm 2; xử lý khủng hoảng của nhóm 2. Góp phần nhóm 2 vào chuẩn quan hệ công chúng chung, quy chế phát ngôn (Chuyên viên trưởng giữ, QC-5).","bao_cao_cho":"Tổ trưởng Tổ Truyền thông và Thương hiệu phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"PR/báo chí, đối tác, KOL/KOC, tài trợ, ngoại tuyến, lịch phát cho các đơn vị nhóm 2","phan_dinh_khong_thuoc_trach_nhiem":"Không mặc định quản trị kênh quảng cáo, sản xuất nội dung hay điều hành PR nhóm 1","phan_dinh_ban_giao_dau_vao":"Bàn giao lịch/mẫu phát cho Trưởng nhóm hoặc truyền thông cơ sở; chuyển nguồn về người viết","phan_dinh_kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu; Trưởng phòng/cấp được ủy quyền duyệt"},{"id":"bt-ac","ten":"Chuyên viên biên tập nhóm 1","to":"nd","nhom_thuong_hieu":"N1","chuc_danh":"bt","thay_chinh":"bt-ac|người còn lại trong nhóm","du_phong":["cvtt-a|việc có hạn, không nội dung chuyên môn"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 211 giờ/tháng cho 02 người (gồm ≈ 12 giờ kiểm pháp lý ngang hàng cho nhóm 2; ≈ 17 giờ vai trò Tổ trưởng của người được chỉ định)","viec_chung":"Kiểm pháp lý ngang hàng lời của Chuyên viên biên tập nhóm 2 (CN-1, ≈ 12 giờ/tháng); duyệt sản phẩm truyền thông nội bộ Tổng công ty, TTH Group; thay khi vắng, chờ tuyển cho nhóm 2 (CN-2, CN-3)","muc_dich":"Viết toàn bộ nội dung của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic), gồm nội dung website tthhealthcare.com (bản tiếng Việt, tiếng Anh) và App TTH; hai người kiểm pháp lý lời của nhau; kiểm pháp lý ngang hàng lời của Chuyên viên biên tập nhóm 2 (CN-1).","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Viết/biên tập nội dung bài, kịch bản lời, nội dung website/App của nhóm 1; rà soát nội dung y tế theo lịch; chuẩn bị bản nội dung và minh chứng phục vụ hồ sơ pháp lý; chủ trì kịch bản lời/thoại của video V2–V4 kể cả video không có nội dung y tế; thông điệp, lời dẫn và nội dung chữ trên hình. Không chuyển quyền chủ trì lời cho Media chỉ vì video không mang nội dung y tế.","phan_dinh_khong_thuoc_trach_nhiem":"Không soạn kịch bản tư vấn Contact Center; không tự lập/nộp hồ sơ pháp lý; không tự xác nhận giá, giấy phép, lịch bác sĩ; không nhập dữ liệu có cấu trúc thuộc mảng 43","phan_dinh_ban_giao_dau_vao":"Nhận nguồn bác sĩ/cơ sở và yêu cầu Quản lý thương hiệu; giao file lời cho Thiết kế/Media/Kênh số; chuyển minh chứng cho Pháp chế","phan_dinh_kiem_duyet":"Đầu ra của Biên tập được người khác kiểm độc lập theo cấp độ rủi ro; bác sĩ/đơn vị chuyên môn xác nhận mọi nội dung y khoa; Quản lý thương hiệu nghiệm thu đầu ra; người có thẩm quyền duyệt phát hành. Biên tập không tự phê duyệt sản phẩm mình viết."},{"id":"bt-b","ten":"Chuyên viên biên tập nhóm 2","to":"nd","nhom_thuong_hieu":"N2","chuc_danh":"bt","thay_chinh":"bt-ac|ngoại lệ thay khi vắng, người trung lập cho phép làm thay có thời hạn (mục 15.4)","du_phong":["Việc không gấp lùi hạn"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 125 giờ/tháng","viec_chung":"Không","muc_dich":"Viết toàn bộ nội dung của nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng, các chuỗi chuyên khoa, Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện), gồm nội dung xây mới website các chuỗi; lời do Chuyên viên biên tập nhóm 1 kiểm pháp lý ngang hàng (CN-1); có quyền dừng phát hành vì lý do pháp lý.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Viết/biên tập nội dung, lời video, website của nhóm 2; chuẩn bị minh chứng nội dung nhóm 2 khi có hồ sơ pháp lý; chủ trì kịch bản lời/thoại của video V2–V4 kể cả video không có nội dung y tế; thông điệp, lời dẫn và nội dung chữ trên hình. Không chuyển quyền chủ trì lời cho Media chỉ vì video không mang nội dung y tế.","phan_dinh_khong_thuoc_trach_nhiem":"Không viết thay kịch bản tư vấn, hồ sơ pháp lý; không tự quản trị kênh/quảng cáo hay xác nhận thông số chuyên môn","phan_dinh_ban_giao_dau_vao":"Nhận nguồn chuyên môn đơn vị nhóm 2; giao sản phẩm theo phiếu cho Media, Thiết kế, Quảng cáo","phan_dinh_kiem_duyet":"Đầu ra của Biên tập được người khác kiểm độc lập theo cấp độ rủi ro; bác sĩ/đơn vị chuyên môn xác nhận mọi nội dung y khoa; Quản lý thương hiệu nghiệm thu đầu ra; người có thẩm quyền duyệt phát hành. Biên tập không tự phê duyệt sản phẩm mình viết."},{"id":"tk-a","ten":"Chuyên viên thiết kế nhóm 1","to":"nd","nhom_thuong_hieu":"N1","chuc_danh":"tk","thay_chinh":"tk-a|người còn lại trong nhóm","du_phong":["tk-nt|sản phẩm in"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 189 giờ/tháng cho 02 người (chia cố định: phụ trách hệ thống / phụ trách bệnh viện)","viec_chung":"Bộ nhận diện chung của TTH, quy chuẩn ứng dụng (người phụ trách hệ thống); thay khi vắng, chờ tuyển cho nhóm 2 (CN-2, CN-3)","muc_dich":"Hai người cùng mô tả công việc, chia cố định (phụ trách hệ thống / phụ trách bệnh viện): làm mọi sản phẩm thiết kế của nhóm 1 ngoài danh sách cố định của Chuyên viên thiết kế ngoại tuyến, cả bản số và bản in (gồm Hạng mục toàn hệ thống, sự kiện hệ thống, tuyển dụng, nội bộ); làm và giữ bộ nhận diện chung của TTH, quy chuẩn ứng dụng (B-1, QC-1); hình ảnh website tthhealthcare.com, App TTH. Phần mềm giao việc theo bảng phân công; yêu cầu cần xử lý: Tổ trưởng.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Thiết kế bản số và bản in không thuộc danh sách cố định của Thiết kế ngoại tuyến; bộ nhận diện TTH, ứng dụng web/App","phan_dinh_khong_thuoc_trach_nhiem":"Không thi công, quản trị biển bảng, dựng video, đăng kênh; không làm thay thiết kế cố định ngoại tuyến","phan_dinh_ban_giao_dau_vao":"Nhận nội dung đã kiểm; giao file đúng thông số cho Quảng cáo, Media hoặc Truyền thông; bàn giao kiểm file in","phan_dinh_kiem_duyet":"Người yêu cầu nghiệm thu; kiểm độc lập và người duyệt theo loại sản phẩm"},{"id":"tk-b","ten":"Chuyên viên thiết kế nhóm 2","to":"nd","nhom_thuong_hieu":"N2","chuc_danh":"tk","thay_chinh":"tk-a|ngoại lệ thay khi vắng, người trung lập cho phép làm thay có thời hạn (mục 15.4)","du_phong":["tk-nt|sản phẩm in","Việc không gấp lùi hạn"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 135 giờ/tháng","viec_chung":"Bộ nhận diện các thương hiệu nhóm 2 (đầu mối phần thuê ngoài thiết kế hệ nhận diện, mục 26); Chủ trì bộ nhận diện nhóm 2; Chuyên viên thiết kế ngoại tuyến hỗ trợ trong giờ dư đến khi bàn giao","muc_dich":"Làm mọi sản phẩm thiết kế của nhóm 2 (gồm Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện) ngoài danh sách cố định của Chuyên viên thiết kế ngoại tuyến, cả bản số và bản in; bộ nhận diện các thương hiệu nhóm 2, quy chuẩn ứng dụng (B-2, QC-2); mẫu thiết kế sẵn của nhóm 2 trong thư viện mẫu (M-6); hình ảnh website các chuỗi.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Thiết kế sản phẩm nhóm 2 ngoài danh sách cố định ngoại tuyến; chủ trì thiết kế hệ nhận diện của nhóm 2 theo phân công","phan_dinh_khong_thuoc_trach_nhiem":"Không tự thay mẫu nhận diện được duyệt; không tự duyệt in/thi công; không phụ trách sản phẩm nhóm 1","phan_dinh_ban_giao_dau_vao":"Nhận nội dung nhóm 2; giao file đến Media/Kênh số/Truyền thông; phối hợp Thiết kế ngoại tuyến phần cố định","phan_dinh_kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu, cấp có thẩm quyền duyệt nhận diện"},{"id":"tk-nt","ten":"Chuyên viên thiết kế ngoại tuyến","to":"nd","nhom_thuong_hieu":"","chuc_danh":"tk","thay_chinh":"Chuyên viên thiết kế của nhóm có sản phẩm","du_phong":["cvt|vai trò Tổ trưởng"],"pham_vi":"trung_lap","gio_ke_hoach":"≈ 75–80 giờ/tháng việc của vị trí; giờ dư ≈ 60 giờ/tháng hỗ trợ bộ nhận diện nhóm 2 đến khi bàn giao (không giữ vai trò Tổ trưởng từ 14/11/2026)","viec_chung":"Cấu trúc thư viện mẫu thiết kế sẵn (quyền, thu hồi mẫu cũ, hướng dẫn công cụ); danh mục biển bảng toàn hệ thống, đầu mối QyĐ.48; kiểm tra tuân thủ nhận diện tại cơ sở hằng quý; quy chuẩn in; bộ mẫu trang trí; bản quyền phông chữ, ảnh, nhạc, video, thuê bao công cụ thiết kế; làm việc kỹ thuật với đơn vị in, thi công (hợp đồng, thanh toán: Quản lý thương hiệu; thi công, nghiệm thu: Chuyên viên truyền thông của nhóm); Hỗ trợ Chuyên viên thiết kế nhóm 2 làm bộ nhận diện nhóm 2 (mảng 7; B-2, QC-2) trong giờ dư (≈ 60 giờ/tháng) đến khi bàn giao: phần ứng dụng lên ấn phẩm, mẫu thiết kế sẵn, biển bảng của nhóm 2; phần thiết kế hệ nhận diện thuê ngoài theo phiếu chốt điểm 26, chưa thuê được thì cùng làm (điểm 7a). Chuyên viên thiết kế nhóm 2 chủ trì, Quản lý thương hiệu nhóm 2 nghiệm thu; giờ, KPI kết quả tính cho nhóm 2 (Phòng Marketing Tổng công ty chốt 14/11/2026)","muc_dich":"Làm sản phẩm thuộc danh sách cố định của toàn hệ thống: biển bảng, phương tiện quảng cáo cố định, trang trí cố định, trang trí lễ, Tết, phương tiện; giữ quy chuẩn in; chịu trách nhiệm tổ chức kiểm tra kỹ thuật file in, thi công trước khi gửi nhà cung cấp; với file do chính mình tạo phải chuyển người khác đủ năng lực kiểm độc lập, không tự xác nhận kiểm cuối. Vị trí trung lập giữ việc chung: cấu trúc thư viện mẫu thiết kế sẵn, danh mục biển bảng toàn hệ thống, đầu mối QyĐ.48, kiểm tra tuân thủ nhận diện tại cơ sở hằng quý, bản quyền và thuê bao công cụ; không giữ vai trò Tổ trưởng Tổ Nội dung và Sáng tạo; tuyến điều phối việc của vị trí này thuộc Chuyên viên trưởng.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Thiết kế danh sách cố định: biển bảng, trang trí cố định, lễ Tết; giữ quy chuẩn in, danh mục và kiểm nhận diện độc lập","phan_dinh_khong_thuoc_trach_nhiem":"Không giữ toàn bộ thiết kế in; không tự nghiệm thu cuối sản phẩm do chính mình thiết kế; không trực tiếp vận hành biển bảng tại cơ sở","phan_dinh_ban_giao_dau_vao":"Nhận số đo/ảnh hiện trạng từ Truyền thông cơ sở, yêu cầu Chuyên viên truyền thông; chuyển file kỹ thuật để triển khai","phan_dinh_kiem_duyet":"Người kiểm độc lập (nếu tự làm), cấp duyệt biển bảng theo QyĐ.48"},{"id":"md-ac","ten":"Chuyên viên media nhóm 1","to":"nd","nhom_thuong_hieu":"N1","chuc_danh":"md","thay_chinh":"md-ac|người còn lại trong nhóm","du_phong":["mdcs-a|ghi hình tại cơ sở"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 219 giờ/tháng cho 02 người","viec_chung":"Lập chuẩn kỹ thuật media chung (Chuyên viên trưởng giữ, Trưởng phòng duyệt, QC-4); thư mục kho tư liệu của nhóm 1; thay khi vắng, chờ tuyển cho nhóm 2 (CN-2, CN-3); Chuyên viên media của nhóm duyệt bản dựng V2, V3 do Marketing cơ sở – media thực hiện theo bộ mẫu B-7; làm V4 và sản phẩm video thuộc Tổng công ty.","muc_dich":"Hai người cùng mô tả công việc, chia cố định (phụ trách hệ thống / phụ trách bệnh viện): sản xuất video, ảnh hoàn chỉnh của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic); sự kiện, phim thương hiệu cấp hệ thống; lập chuẩn kỹ thuật media chung (QC-4), soạn nội dung đào tạo Marketing cơ sở – media; giữ thư mục kho tư liệu của nhóm 1. Phần mềm giao việc theo bảng phân công; yêu cầu cần xử lý: Tổ trưởng.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Chủ trì kịch bản phân cảnh, shot-list, quay/dựng, âm thanh, hình ảnh, hậu kỳ kỹ thuật và chuẩn kỹ thuật Media; kiểm kỹ thuật độc lập V2/V3 do Media cơ sở dựng; trực tiếp sản xuất V3 vượt mẫu và V4. Không là người chủ trì kịch bản lời/thoại.","phan_dinh_khong_thuoc_trach_nhiem":"Không thay Biên tập viết kịch bản lời/thoại; không thay bác sĩ xác nhận chuyên môn; không thay người có thẩm quyền duyệt phát hành; không trực tiếp vận hành biển bảng, màn hình, phát thanh ở cơ sở.","phan_dinh_ban_giao_dau_vao":"Nhận kịch bản đã kiểm từ Biên tập và tư liệu từ Media cơ sở; xuất bản hoàn chỉnh cho Kênh số/Truyền thông","phan_dinh_kiem_duyet":"Chỉ kiểm kỹ thuật hình/âm/dựng và tuân thủ B-7/QC-4 của bản dựng khác người làm; không tự duyệt bản dựng do chính mình sản xuất và không duyệt nội dung y khoa hoặc phát hành."},{"id":"md-b","ten":"Chuyên viên media nhóm 2","to":"nd","nhom_thuong_hieu":"N2","chuc_danh":"md","thay_chinh":"md-ac|ngoại lệ thay khi vắng, người trung lập cho phép làm thay có thời hạn (mục 15.4)","du_phong":["mdcs-b|ghi hình tại cơ sở","Việc không gấp lùi hạn"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 131 giờ/tháng","viec_chung":"Không (thư mục kho tư liệu của nhóm 2); Chuyên viên media của nhóm duyệt bản dựng V2, V3 do Marketing cơ sở – media thực hiện theo bộ mẫu B-7; làm V4 và sản phẩm video thuộc Tổng công ty.","muc_dich":"Sản xuất video, ảnh hoàn chỉnh của nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng, các chuỗi chuyên khoa, Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện); giữ thư mục kho tư liệu của nhóm 2 (quyền: Chuyên viên trưởng).","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Chủ trì kịch bản phân cảnh, shot-list, quay/dựng, âm thanh, hình ảnh, hậu kỳ kỹ thuật và chuẩn kỹ thuật Media; kiểm kỹ thuật độc lập V2/V3 do Media cơ sở dựng; trực tiếp sản xuất V3 vượt mẫu và V4. Không là người chủ trì kịch bản lời/thoại.","phan_dinh_khong_thuoc_trach_nhiem":"Không thay Biên tập viết kịch bản lời/thoại; không thay bác sĩ xác nhận chuyên môn; không thay người có thẩm quyền duyệt phát hành; không trực tiếp vận hành biển bảng, màn hình, phát thanh ở cơ sở.","phan_dinh_ban_giao_dau_vao":"Nhận tư liệu Media cơ sở và kịch bản lời nhóm 2; giao file phát hành","phan_dinh_kiem_duyet":"Chỉ kiểm kỹ thuật hình/âm/dựng và tuân thủ B-7/QC-4 của bản dựng khác người làm; không tự duyệt bản dựng do chính mình sản xuất và không duyệt nội dung y khoa hoặc phát hành."},{"id":"qc-a","ten":"Chuyên viên quảng cáo và kênh số nhóm 1","to":"ts","nhom_thuong_hieu":"N1","chuc_danh":"qc","thay_chinh":"qc-a|người còn lại trong nhóm","du_phong":["qlsps"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 264 giờ/tháng cho 02 người","viec_chung":"Thay khi vắng, chờ tuyển cho nhóm 2 (CN-2, CN-3)","muc_dich":"Hai người cùng mô tả công việc, chia cố định (phụ trách hệ thống / phụ trách bệnh viện): quảng cáo trực tuyến và quản trị kênh số của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic); gửi tin hàng loạt trên kênh nhóm 1; đăng tin tuyển dụng.","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Chạy quảng cáo trả phí, đăng/quản trị kênh số, lịch gửi nhóm 1, tối ưu theo dữ liệu nền tảng","phan_dinh_khong_thuoc_trach_nhiem":"Không quyết định chiến lược thương hiệu, không chốt KPI tài chính chính thức, không sửa dữ liệu gốc/đăng CMS cấu trúc","phan_dinh_ban_giao_dau_vao":"Nhận nội dung, thiết kế, media đã duyệt; gắn đo theo hướng dẫn; báo số liệu cho Đo lường và đối soát","phan_dinh_kiem_duyet":"Quản lý thương hiệu nghiệm thu lịch; Chuyên viên trưởng quản quyền theo ma trận"},{"id":"qc-b","ten":"Chuyên viên quảng cáo và kênh số nhóm 2","to":"ts","nhom_thuong_hieu":"N2","chuc_danh":"qc","thay_chinh":"qc-a|ngoại lệ thay khi vắng, người trung lập cho phép làm thay có thời hạn (mục 15.4)","du_phong":["qlsps"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 138 giờ/tháng","viec_chung":"Không","muc_dich":"Quảng cáo trực tuyến và quản trị kênh số của nhóm 2, gồm trang Facebook Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện; gửi tin hàng loạt trên kênh nhóm 2; áp dụng chính sách nền tảng trên kênh nhóm 2 (danh sách: Quản lý sản phẩm số, DS-3).","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Chạy quảng cáo, quản trị kênh số, lịch đăng/gửi tin của thương hiệu nhóm 2","phan_dinh_khong_thuoc_trach_nhiem":"Không thay Truyền thông xử lý báo chí/KOL; không đổi chính sách nền tảng hoặc dữ liệu có cấu trúc website","phan_dinh_ban_giao_dau_vao":"Nhận gói sản phẩm nhóm 2 đã duyệt; phản hồi chi phí, Lead về Đo lường","phan_dinh_kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu lịch; cấp duyệt kinh phí"},{"id":"dl-1","ten":"Chuyên viên đo lường và đối soát","to":"ts","nhom_thuong_hieu":"","chuc_danh":"dl","thay_chinh":"dl-2|chưa có người: bảng tính chốt số có công thức, hướng dẫn chốt số","du_phong":["qlsps|chốt theo hướng dẫn; phần KPI của Quản lý sản phẩm số do Chuyên viên trưởng kiểm"],"pham_vi":"trung_lap","gio_ke_hoach":"≈ 144 giờ/tháng có phần mềm, gồm phần kiêm Chuyên viên dữ liệu khách hàng và thị trường (chưa có phần mềm ≈ 179)","viec_chung":"Chốt kỳ, chốt KPI quý; danh mục nguồn khách, tiêu chí Lead hợp lệ; cộng nhu cầu mua của 02 nhóm ngày 20–22 (R17); sổ hợp đồng","muc_dich":"Đo hiệu quả Marketing: số liệu đo lường, đối soát, báo cáo đúng kỳ cho mọi nhóm thương hiệu; chốt số liệu KPI; phân tích để Quản lý thương hiệu quyết định kênh, ngân sách. Giai đoạn đầu kiêm phần việc của Chuyên viên dữ liệu khách hàng và thị trường đến khi vị trí này có người (mục 6).","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Đối soát nguồn khách, chi phí, KPI, báo cáo chốt kỳ toàn hệ thống; phát hiện lệch số","phan_dinh_khong_thuoc_trach_nhiem":"Không thay Quảng cáo tối ưu tài khoản; không tự sửa dữ liệu nguồn; không thay Quản lý thương hiệu quyết định ngân sách","phan_dinh_ban_giao_dau_vao":"Nhận số nền tảng từ Quảng cáo, số tiếp đón/HIS và chứng từ, khóa kỳ và bàn giao báo cáo","phan_dinh_kiem_duyet":"Trưởng phòng duyệt bản chốt kỳ; đối soát độc lập"},{"id":"dl-2","ten":"Chuyên viên dữ liệu khách hàng và thị trường","to":"ts","nhom_thuong_hieu":"","chuc_danh":"dl","thay_chinh":"dl-1","du_phong":["qlsps"],"pham_vi":"trung_lap","gio_ke_hoach":"Giai đoạn đầu do Chuyên viên đo lường và đối soát kiêm; có người từ bước Bệnh viện Đa khoa Quốc tế TTH Huế (mục 21)","viec_chung":"Lịch gửi chung, trần tần suất, danh sách loại (R19); CRM; đầu mối Marketing về bảo vệ dữ liệu cá nhân, hồ sơ đánh giá tác động (R18)","muc_dich":"Quản lý dữ liệu khách hàng, chất lượng dữ liệu phần mềm và bảo vệ dữ liệu cá nhân trong hoạt động Marketing; lịch gửi chung, trần tần suất (QC-6); khảo sát, thông tin thị trường. Giai đoạn đầu chưa có người: Chuyên viên đo lường và đối soát kiêm; có người khi CRM vận hành toàn hệ thống hoặc khi vượt 142 giờ 02 quý liên tiếp (mục 6, 21).","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên","trang_thai_kpi":"Chưa có bảng KPI chính thức; phải lập và duyệt trước khi áp dụng với vị trí này.","phan_dinh_chu_tri_dau_ra":"Chủ chất lượng dữ liệu, phân nhóm khách hàng, quyền riêng tư/lịch gửi, khảo sát, yêu cầu nghiệp vụ CRM","phan_dinh_khong_thuoc_trach_nhiem":"Không làm thay Đo lường chốt KPI; không vận hành Contact Center; không thay Số hóa lập trình ứng dụng","phan_dinh_ban_giao_dau_vao":"Nhận dữ liệu hợp lệ, phân nhóm/kiểm trùng, gửi tiêu chí cho Kênh số/Contact Center đúng quyền","phan_dinh_kiem_duyet":"Cấp phụ trách dữ liệu và pháp lý xác nhận điều kiện sử dụng; chưa đủ consent thì chặn"},{"id":"qlsps","ten":"Quản lý sản phẩm số","to":"ts","nhom_thuong_hieu":"","chuc_danh":"qlsps","thay_chinh":"dl-2|chưa có người: Chuyên viên đo lường và đối soát","du_phong":["qc-a|sản phẩm số nhóm 1","qc-b|sản phẩm số nhóm 2","cvt|vai trò Tổ trưởng"],"pham_vi":"trung_lap","gio_ke_hoach":"≈ 117 giờ/tháng, gồm ≈ 19 giờ vai trò Tổ trưởng Tổ Tăng trưởng số (chưa có phần mềm ≈ 24)","viec_chung":"Vai trò Tổ trưởng Tổ Tăng trưởng số; chính sách nền tảng, danh sách bị cấm; website, App TTH, trang đích; mã theo dõi chỉ bật sau đồng ý (R18)","muc_dich":"Chủ nghiệp vụ website tthhealthcare.com, website các chuỗi, App TTH, trang đích; là đầu mối duy nhất của Phòng Marketing với Phòng Số hóa; giữ chính sách nền tảng, danh sách bị cấm (DS-3), tên miền; vai trò Tổ trưởng Tổ Tăng trưởng số (chỉ điều phối).","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"Chủ nghiệp vụ website/App/trang đích, cấu trúc CMS, SEO tự nhiên, thay đổi sản phẩm số; công bố dữ liệu có cấu trúc mảng 43 sau kiểm độc lập","phan_dinh_khong_thuoc_trach_nhiem":"Không viết lời thay Biên tập; không làm kỹ thuật thay Phòng Số hóa; không xác nhận dữ liệu gốc; không tự có quyền duyệt chỉ vì kiêm Tổ trưởng","phan_dinh_ban_giao_dau_vao":"Nhận nội dung đã duyệt và dữ liệu có xác nhận; gửi yêu cầu kỹ thuật đến Số hóa; nghiệm thu nghiệp vụ, kiểm công bố","phan_dinh_kiem_duyet":"Trưởng phòng/cấp có thẩm quyền duyệt thay đổi lớn; nguồn và người kiểm độc lập duyệt dữ liệu"},{"id":"qlml","ten":"Quản lý mạng lưới Marketing cơ sở theo vùng (01 suất dự kiến, chờ phân vùng)","to":"lanhdao","nhom_thuong_hieu":"","chuc_danh":"qlml","thay_chinh":"tn-a|Trưởng nhóm Marketing cơ sở trong vùng do Chuyên viên trưởng chỉ định (đúng nhóm có việc)","du_phong":["cvt|chỉ điều phối tạm thời theo vùng, khi bảo đảm giới hạn đánh giá"],"pham_vi":"theo_nhom","gio_ke_hoach":"01 suất trong mốc 56 người; chỉ bố trí khi đủ điều kiện R15, được phê duyệt phân vùng/bàn giao. Giới hạn Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở2; Quản lý vùng 15 người trực tiếp.","viec_chung":"Vị trí dự kiến tại mốc đủ 10 bệnh viện, nằm trong 56 người; chỉ nhận tuyến quản lý theo danh sách cơ sở/nhóm, quyết định và biên bản bàn giao có ngày hiệu lực. Chưa có hiệu lực thì không tự giao quyền đánh giá hoặc duyệt.","muc_dich":"Quản lý Trưởng nhóm Marketing cơ sở của một phạm vi nhóm/vùng được phê duyệt bằng danh sách cụ thể; báo cáo Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở, tối đa 15 người được đánh giá trực tiếp, không quản lý chồng hai nhóm khi chưa có phê duyệt.","bao_cao_cho":"Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở theo danh sách cơ sở được cấp có thẩm quyền quyết định bàn giao. Trước ngày hiệu lực bàn giao, mọi Trưởng nhóm bệnh viện thuộc cấp quản lý trực tiếp Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở; không tự chuyển tuyến sang quản lý vùng hoặc Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số.","ngach":"Chuyên viên chính","trang_thai_kpi":"Chưa có bảng KPI chính thức; phải lập và duyệt trước khi áp dụng với vị trí này.","trang_thai_phan_vung":"Chưa chốt danh sách cơ sở/nhóm, chưa có ngày hiệu lực; mẫu thủ tục hoàn thiện trong phụ lục điều kiện.","phan_dinh_chu_tri_dau_ra":"Giám sát Trưởng nhóm Marketing cơ sở trong vùng danh sách đã duyệt; hỗ trợ đánh giá, chuẩn hóa vận hành","phan_dinh_khong_thuoc_trach_nhiem":"Không tự giành chủ Hạng mục của Quản lý thương hiệu; không chỉ đạo chuyên môn ngoài vùng chưa giao","phan_dinh_ban_giao_dau_vao":"Nhận báo cáo cơ sở, chuyển nhu cầu và vấn đề lên Chuyên viên trưởng","phan_dinh_kiem_duyet":"Chuyên viên trưởng phê duyệt phân công theo văn bản/phạm vi"},{"id":"tn-a","ten":"Trưởng nhóm Marketing cơ sở – bệnh viện nhóm 1","to":"coso","nhom_thuong_hieu":"N1","chuc_danh":"tn","thay_chinh":"qhcs","du_phong":["bt-ac","qlth-a"],"pham_vi":"nhom_1","gio_ke_hoach":"Theo danh mục việc, định mức mục 6; đo ở thí điểm","viec_chung":"Không","muc_dich":"Đầu mối Marketing tại bệnh viện đa khoa TTH Hospital: làm việc với khoa phòng, tổ chức việc tại chỗ, cung cấp đầu vào cho Tổng công ty, quản lý trực tiếp 02 thành viên Marketing tại cơ sở. Bệnh viện 02 người: kiêm nhiệm toàn bộ nhiệm vụ truyền thông cơ sở về biển bảng, màn hình và phát thanh; không giao sang Media.","bao_cao_cho":"Cấp trên quản lý trực tiếp về Marketing: Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở (TCT). Trực tiếp quản lý, giao việc và đánh giá cấp 1 các nhân sự Marketing tại bệnh viện. Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số hướng dẫn/kiểm tra nghiệp vụ Truyền thông, Thương hiệu và Tăng trưởng số, không đồng thời chỉ huy hoặc đánh giá Trưởng nhóm. Ban Giám đốc bệnh viện quản lý chấm công, nội quy tại chỗ, cung cấp xác nhận nguồn và ý kiến phối hợp theo phân cấp; không tự phát sinh tuyến quản lý Marketing thứ hai.","ngach":"Chuyên viên cơ sở; phụ cấp trách nhiệm Trưởng nhóm (mục 24.5)","phan_dinh_chu_tri_dau_ra":"Tiếp nhận yêu cầu khoa phòng, lấy xác nhận nguồn, điều phối nhân sự cơ sở; tin Facebook bệnh viện trong danh mục; kiêm vận hành biển bảng/màn hình/phát thanh nếu cơ sở 02 người","phan_dinh_khong_thuoc_trach_nhiem":"Không tự đổi chiến lược/nhận diện/chiến dịch TCT, không tự duyệt bài vượt danh mục; không tự sửa dữ liệu giá/chứng chỉ; chỉ có quyền đăng tin V1 thuộc danh mục Facebook bệnh viện khi có quyền đăng hợp lệ, không tự đăng dịch vụ/giá/khuyến mại/ca bệnh lên bất kỳ kênh nào; không quản trị các kênh khác.","phan_dinh_ban_giao_dau_vao":"Chuyển thông tin đã xác nhận cho TCT theo một luồng; nhận kế hoạch đã duyệt; trả ảnh, nhật ký triển khai","phan_dinh_kiem_duyet":"Ban Giám đốc cơ sở xác nhận thông tin gốc; TCT/cấp duyệt nội dung theo phân cấp Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở là đầu mối phân công/tổng hợp và đánh giá Trưởng nhóm; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số chỉ kiểm nghiệp vụ truyền thông. Người kiêm nhiệm không có quyền tự phê duyệt sản phẩm mình tạo.","quan_ly_truc_tiep_ma":"cvt","quyen_kiem_chuyen_mon_truyen_thong_ma":"cvt-2","quy_tac_doi_tuyen":"Chỉ thay quan_ly_truc_tiep_ma bằng quyết định giao quyền, danh sách bàn giao và thời điểm hiệu lực; không chuyển vì kiêm nhiệm Truyền thông."},{"id":"tn-b","ten":"Trưởng nhóm Marketing cơ sở – bệnh viện nhóm 2 (kiêm nhiệm truyền thông cơ sở)","to":"coso","nhom_thuong_hieu":"N2","chuc_danh":"tn","thay_chinh":"mdcs-b","du_phong":["bt-b","qlth-bc"],"pham_vi":"nhom_2","gio_ke_hoach":"Theo danh mục việc, định mức mục 6; đo ở thí điểm","viec_chung":"Không","muc_dich":"Đầu mối Marketing tại bệnh viện nhóm 2: làm việc với khoa phòng, tổ chức việc tại chỗ, cung cấp đầu vào cho Tổng công ty; kiêm truyền thông cơ sở; quản lý trực tiếp 01 thành viên Marketing tại cơ sở. Bệnh viện 02 người: kiêm nhiệm toàn bộ nhiệm vụ truyền thông cơ sở về biển bảng, màn hình và phát thanh; không giao sang Media; đồng thời kiêm khảo sát, điều phối decor lễ/Tết, kiểm tra hiện trạng biển bảng hằng tháng và chụp ảnh nghiệm thu tại cơ sở 02 người. Kiêm nhiệm truyền thông chỉ là gộp chức năng tại vị trí, không đổi cấp quản lý. Các nghiệp vụ truyền thông nhận chuẩn chuyên môn từ Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số thông qua tuyến điều phối Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở; công việc tính tải và KPI riêng để tránh giao việc hai nguồn.","bao_cao_cho":"Cấp trên quản lý trực tiếp về Marketing: Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở (TCT). Trực tiếp quản lý, giao việc và đánh giá cấp 1 các nhân sự Marketing tại bệnh viện. Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số hướng dẫn/kiểm tra nghiệp vụ Truyền thông, Thương hiệu và Tăng trưởng số, không đồng thời chỉ huy hoặc đánh giá Trưởng nhóm. Ban Giám đốc bệnh viện quản lý chấm công, nội quy tại chỗ, cung cấp xác nhận nguồn và ý kiến phối hợp theo phân cấp; không tự phát sinh tuyến quản lý Marketing thứ hai.","ngach":"Chuyên viên cơ sở; phụ cấp trách nhiệm Trưởng nhóm (mục 24.5)","phan_dinh_chu_tri_dau_ra":"Điều phối nguồn khoa phòng, tổ chức hiện trường và quan hệ cộng đồng; kiểm/vận hành biển bảng, màn hình, phát thanh tại cơ sở 02 người; kiêm triển khai decor, theo dõi hiện trạng biển bảng theo tháng, ảnh nghiệm thu và báo cáo theo phân quyền","phan_dinh_khong_thuoc_trach_nhiem":"Không chuyển việc kiểm định kỳ thiết bị cho Media; không thay chuyên viên Truyền thông TCT quyết định lịch/hợp đồng hệ thống; chỉ có quyền đăng tin V1 thuộc danh mục Facebook bệnh viện khi có quyền đăng hợp lệ, không tự đăng dịch vụ/giá/khuyến mại/ca bệnh lên bất kỳ kênh nào; không quản trị các kênh khác.","phan_dinh_ban_giao_dau_vao":"Bàn giao thông tin đã xác nhận, tư liệu, nhật ký nghiệm thu cho TCT nhóm 2","phan_dinh_kiem_duyet":"Ban Giám đốc cơ sở xác nhận thực tế; TCT nghiệm thu sản phẩm/lịch Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở là đầu mối phân công/tổng hợp và đánh giá Trưởng nhóm; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số chỉ kiểm nghiệp vụ truyền thông. Người kiêm nhiệm không có quyền tự phê duyệt sản phẩm mình tạo.","quan_ly_truc_tiep_ma":"cvt","quyen_kiem_chuyen_mon_truyen_thong_ma":"cvt-2","quy_tac_doi_tuyen":"Chỉ thay quan_ly_truc_tiep_ma bằng quyết định giao quyền, danh sách bàn giao và thời điểm hiệu lực; không chuyển vì kiêm nhiệm Truyền thông."},{"id":"mdcs-a","ten":"Chuyên viên Marketing cơ sở – media, bệnh viện nhóm 1","to":"coso","nhom_thuong_hieu":"N1","chuc_danh":"mdcs","thay_chinh":"tn-a","du_phong":["Chuyên viên Marketing cơ sở – media bệnh viện cùng nhóm gần nhất","md-ac"],"pham_vi":"nhom_1","gio_ke_hoach":"Ngưỡng kế hoạch 142 giờ/người/tháng; giờ công thực đo theo từng đầu ra chưa có, không kết luận có giờ dư","viec_chung":"Không; Dựng video V2 và V3 của chính bệnh viện theo bộ mẫu dựng của nhóm (B-7) và chuyển Chuyên viên Media TCT đúng nhóm kiểm kỹ thuật bản dựng; không tự dựng video chiến dịch V4 (phiếu chốt điểm 12, định hướng 11/11/2026).","muc_dich":"Ghi hình, chụp ảnh tại chỗ cho sản phẩm của Tổng công ty tại bệnh viện nhóm 1; hỗ trợ bệnh viện nhóm 1 lân cận. Không phụ trách biển bảng, màn hình, phát thanh tại cơ sở; chỉ hỗ trợ quay, chụp, thu âm theo yêu cầu sản xuất. Đồng thời chủ trì quay/dựng V1, V2 và V3 theo mẫu B-7 đã được giao, không chỉ làm clip tin trong ngày. Media TCT đúng nhóm kiểm bản dựng và trực tiếp hậu kỳ V3 phức tạp/V4.","bao_cao_cho":"Tổ trưởng Marketing tại bệnh viện trực tiếp giao việc; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở hướng dẫn, kiểm chuẩn chuyên môn Media từ Tổng công ty; chấm công, nội quy do cơ sở.","ngach":"Chuyên viên cơ sở","phan_dinh_chu_tri_dau_ra":"Quay, chụp, thu thập tư liệu hiện trường; cắt dựng V1 và sản xuất V2/V3 thuộc mẫu B-7 theo kịch bản lời đã có của Biên tập đúng nhóm và phân cảnh do Media TCT cung cấp; lưu nguồn, giấy đồng ý và giờ công; V3 vượt mẫu và V4 chuyển Media TCT.","phan_dinh_khong_thuoc_trach_nhiem":"Không viết kịch bản lời, không phê duyệt lời/chuyên môn/phát hành; không chủ trì kiểm biển bảng, vận hành màn hình, phát thanh hoặc chụp ảnh nghiệp vụ nghiệm thu công trình; không tự làm V4.","phan_dinh_ban_giao_dau_vao":"Nhận lịch/kịch bản qua cổng; phối hợp bác sĩ, nhân vật và địa điểm; giao tư liệu gốc, căn cứ sử dụng hình ảnh, bản dựng V2/V3 và nhật ký giờ công riêng cho TCT.","phan_dinh_kiem_duyet":"Media TCT đúng nhóm kiểm kỹ thuật bản dựng; bác sĩ/đơn vị chuyên môn xác nhận y khoa; người có thẩm quyền riêng duyệt phát hành. Không tự duyệt sản phẩm mình làm."},{"id":"mdcs-b","ten":"Chuyên viên Marketing cơ sở – media, bệnh viện nhóm 2","to":"coso","nhom_thuong_hieu":"N2","chuc_danh":"mdcs","thay_chinh":"tn-b","du_phong":["Chuyên viên Marketing cơ sở – media bệnh viện cùng nhóm gần nhất","md-b"],"pham_vi":"nhom_2","gio_ke_hoach":"Ngưỡng kế hoạch 142 giờ/người/tháng; giờ công thực đo theo từng đầu ra chưa có, không kết luận có giờ dư","viec_chung":"Không; Dựng video V2 và V3 của chính bệnh viện theo bộ mẫu dựng của nhóm (B-7) và chuyển Chuyên viên Media TCT đúng nhóm kiểm kỹ thuật bản dựng; không tự dựng video chiến dịch V4 (phiếu chốt điểm 12, định hướng 11/11/2026).","muc_dich":"Ghi hình, chụp ảnh tại chỗ cho sản phẩm của Tổng công ty tại bệnh viện nhóm 2; người thay chính của Trưởng nhóm. Không phụ trách biển bảng, màn hình, phát thanh tại cơ sở; chỉ hỗ trợ quay, chụp, thu âm theo yêu cầu sản xuất. Đồng thời chủ trì quay/dựng V1, V2 và V3 theo mẫu B-7 đã được giao, không chỉ làm clip tin trong ngày. Media TCT đúng nhóm kiểm bản dựng và trực tiếp hậu kỳ V3 phức tạp/V4.","bao_cao_cho":"Tổ trưởng Marketing tại bệnh viện trực tiếp giao việc; Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở hướng dẫn, kiểm chuẩn chuyên môn Media từ Tổng công ty; chấm công, nội quy do cơ sở.","ngach":"Chuyên viên cơ sở","phan_dinh_chu_tri_dau_ra":"Quay, chụp, thu thập tư liệu hiện trường; cắt dựng V1 và sản xuất V2/V3 thuộc mẫu B-7 theo kịch bản lời đã có của Biên tập đúng nhóm và phân cảnh do Media TCT cung cấp; lưu nguồn, giấy đồng ý và giờ công; V3 vượt mẫu và V4 chuyển Media TCT.","phan_dinh_khong_thuoc_trach_nhiem":"Không viết kịch bản lời, không phê duyệt lời/chuyên môn/phát hành; không chủ trì kiểm biển bảng, vận hành màn hình, phát thanh hoặc chụp ảnh nghiệp vụ nghiệm thu công trình; không tự làm V4.","phan_dinh_ban_giao_dau_vao":"Nhận lịch/kịch bản qua cổng; phối hợp bác sĩ, nhân vật và địa điểm; giao tư liệu gốc, căn cứ sử dụng hình ảnh, bản dựng V2/V3 và nhật ký giờ công riêng cho TCT.","phan_dinh_kiem_duyet":"Media TCT đúng nhóm kiểm kỹ thuật bản dựng; bác sĩ/đơn vị chuyên môn xác nhận y khoa; người có thẩm quyền riêng duyệt phát hành. Không tự duyệt sản phẩm mình làm."},{"id":"qhcs","ten":"Chuyên viên Marketing cơ sở – truyền thông, bệnh viện nhóm 1","to":"coso","nhom_thuong_hieu":"N1","chuc_danh":"qhcs","thay_chinh":"tn-a","du_phong":["cvtt-a"],"pham_vi":"nhom_1","gio_ke_hoach":"Theo danh mục việc, định mức mục 6; đo ở thí điểm","viec_chung":"Không","muc_dich":"Quan hệ đối tác, cộng đồng, nguồn giới thiệu người bệnh và sự kiện Marketing tại bệnh viện đa khoa nhóm 1; chủ trì khảo sát, tổ chức triển khai trang trí lễ, Tết và sự kiện Marketing ở hiện trường theo thiết kế đã duyệt; vận hành lịch phát màn hình và phát thanh nội viện; kiểm tra biển bảng hằng tuần, tổng hợp hiện trạng hằng tháng, báo hỏng trong ngày; trực tiếp chụp ảnh xác nhận hiện trạng, ảnh nghiệm thu và gửi hồ sơ, số đo cho TCT. Không duyệt thiết kế, chi phí hoặc nghiệm thu tài chính.","bao_cao_cho":"Tổ trưởng Marketing tại bệnh viện trực tiếp giao việc và quản lý nhân sự; Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số hướng dẫn, kiểm chuẩn nghiệp vụ truyền thông/OOH/phát thanh/màn hình nội viện từ TCT; chấm công, nội quy do cơ sở.","ngach":"Chuyên viên cơ sở","phan_dinh_chu_tri_dau_ra":"Chủ trì tổ chức sự kiện và quan hệ cộng đồng tại cơ sở; kiểm tra hiện trạng biển bảng hằng tuần, tổng hợp hằng tháng, báo hỏng trong ngày, chụp ảnh và số đo, ảnh nghiệm thu thi công/tuân thủ nhận diện; trực tiếp vận hành màn hình và phát thanh theo lịch đã duyệt, ghi nhật ký. Cơ sở 02 người do Trưởng nhóm kiêm nhiệm.","phan_dinh_khong_thuoc_trach_nhiem":"Không thiết kế mẫu, không viết kịch bản phát thanh chính thức, không ký hợp đồng truyền thông hệ thống, không duyệt lịch phát mới, ngân sách hoặc nghiệm thu tài chính; không thay Phòng Nhân lực/Công đoàn chủ trì các hoạt động nội bộ ngoài Marketing.; không viết lời, thiết kế, đăng bài/quản trị kênh số hoặc có quyền phê duyệt phát hành chỉ vì đang vận hành thiết bị phát.","phan_dinh_ban_giao_dau_vao":"Nhận lịch/mẫu từ Chuyên viên Truyền thông TCT đúng nhóm; bàn giao báo cáo kiểm tra biển bảng hằng tháng, ảnh hiện trạng, ảnh nghiệm thu trang trí, màn hình, phát thanh và sự kiện cho Truyền thông TCT và Thiết kế ngoại tuyến.","phan_dinh_kiem_duyet":"Ban Giám đốc cơ sở duyệt phần địa phương; TCT duyệt theo phạm vi/mẫu"},{"id":"dmpk","ten":"Đầu mối kiêm nhiệm tại phòng khám (nhóm 1)","to":"coso","nhom_thuong_hieu":"N1","chuc_danh":"dmpk","thay_chinh":"Người dự phòng do phòng khám cử","du_phong":["md-ac|ghi hình theo lịch, kết hợp chuyến","qlth-a|thông tin"],"pham_vi":"nhom_1","gio_ke_hoach":"Kiêm nhiệm tại phòng khám","viec_chung":"Không","muc_dich":"Cung cấp ảnh, thông tin và hỗ trợ việc tại chỗ cho Marketing tại phòng khám nhóm 1 (TTH Clinic).","bao_cao_cho":"Phòng khám TTH Clinic quản lý công việc chính; Quản lý thương hiệu Nhóm 1 xác định mục tiêu, Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở/2 hướng dẫn theo từng loại đầu ra Marketing. Không thuộc thương hiệu Nhóm 2.","ngach":"Phụ cấp kiêm nhiệm theo xác nhận phần việc Marketing (mục 24.5)","trang_thai_kpi":"Chưa có bảng KPI chính thức; phải lập và duyệt trước khi áp dụng với vị trí này.","phan_dinh_chu_tri_dau_ra":"Nhận thông tin, ảnh, lịch, sự kiện, nhu cầu tại phòng khám; chuyển một đầu mối về Marketing TCT","phan_dinh_khong_thuoc_trach_nhiem":"Không là bộ máy marketing độc lập, không tự đăng/sửa dữ liệu có điều kiện, không tự phát hành sản phẩm khi thiếu duyệt","phan_dinh_ban_giao_dau_vao":"Gửi nguồn có xác nhận của phòng khám cho Quản lý thương hiệu nhóm 1/Chuyên viên trưởng","phan_dinh_kiem_duyet":"Đơn vị chủ dữ liệu/phòng khám xác nhận; TCT duyệt sản phẩm theo quy trình"}],"vai_tro":[{"id":"tt-nd","ten":"Tổ trưởng Tổ Nội dung và Sáng tạo","vi_tri":"bt-ac","giu_tam":"bt-ac","to":"nd","viec":"Điều phối 05 người nhóm 1 (Chuyên viên biên tập nhóm 1 còn lại, Chuyên viên thiết kế nhóm 1, Chuyên viên media nhóm 1): yêu cầu cần Tổ trưởng xử lý trong 04 giờ làm việc; xếp lịch sản xuất, lịch ghi hình, xử lý trùng lịch của người nhóm 1; duyệt nghỉ; đánh giá theo số liệu; báo cáo tổ. 03 người nhóm 2 (Chuyên viên biên tập, thiết kế, media nhóm 2), Chuyên viên thiết kế ngoại tuyến, lịch thiết bị media dùng chung, cho phép làm thay có thời hạn (RC-1), tranh chấp phân loại: Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở (≈ 13 giờ/tháng). Không duyệt nội dung, không duyệt phát hành","gio":"≈ 17 giờ/tháng (phần người nhóm 2, Chuyên viên thiết kế ngoại tuyến: Chuyên viên trưởng ≈ 13 giờ/tháng)","ghi_chu":"Người giữ vai trò: Chuyên viên biên tập nhóm 1 do Trưởng phòng chỉ định (chốt 14/11/2026); Phương án người thay chờ quyết định nhân sự, không tự kích hoạt quyền.","dieu_kien_giu_tam":"Chỉ người biên tập nhóm 1 còn lại (không phải người đang giữ Tổ trưởng); Trưởng phòng phải chỉ định cá nhân bằng văn bản, nêu ngày hiệu lực và phạm vi nhóm 1. Không tự động cấp quyền."},{"id":"tt-ts","ten":"Tổ trưởng Tổ Tăng trưởng số","vi_tri":"qlsps","giu_tam":"cvt-2","to":"ts","viec":"Điều phối Chuyên viên quảng cáo và kênh số hai nhóm: yêu cầu cần Tổ trưởng xử lý trong 04 giờ làm việc; xếp lịch; duyệt nghỉ; đánh giá theo số liệu; báo cáo tổ; cho phép làm thay chéo nhóm có thời hạn. Không duyệt nội dung, lịch đăng, chính sách nền tảng","gio":"≈ 19 giờ/tháng (chưa có phần mềm ≈ 24)","canh_bao_nguoi_thay":"Chỉ Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số được giao giữ tạm khi có ủy quyền riêng và đúng giới hạn; không mặc nhiên có quyền ký, duyệt phát hành hoặc chi."},{"id":"tt-th","ten":"Tổ trưởng Tổ Truyền thông và Thương hiệu","vi_tri":"qlth-bc","giu_tam":"qlth-bc","to":"th","viec":"Quản lý thương hiệu nhóm 2 kiêm nhiệm, điều phối tiến độ và khối lượng của 04 vị trí tổ (Quản lý thương hiệu nhóm 1/2; Chuyên viên truyền thông nhóm 1/2). Chỉ có quyền điều phối công việc của tổ; không tự phát sinh quyền duyệt sản phẩm, ngân sách, nghỉ phép, đánh giá cuối hay thay đổi nhân sự.","gio":"Trong quỹ giờ kiêm nhiệm của Quản lý thương hiệu nhóm 2; không tăng định biên.","ghi_chu":"Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số phụ trách quản lý chuyên môn của tổ; Tổ trưởng kiêm nhiệm phân công thường ngày. Quyền duyệt phát hành, chi phí tách riêng."}],"don_vi":[{"id":"mkt-tct","ten":"Phòng Marketing Tổng công ty","loai":"marketing"},{"id":"mkt-coso","ten":"Marketing cơ sở","loai":"marketing"},{"id":"btgd","ten":"Ban Tổng Giám đốc","loai":"lanh_dao"},{"id":"bgd-coso","ten":"Ban Giám đốc cơ sở","loai":"co_so"},{"id":"gd-coso","ten":"Giám đốc cơ sở","loai":"co_so"},{"id":"khoa-phong","ten":"Khoa phòng","loai":"co_so"},{"id":"bac-si","ten":"Bác sĩ","loai":"co_so"},{"id":"tiep-don","ten":"Bộ phận tiếp đón","loai":"co_so"},{"id":"xu-ly-phan-anh","ten":"Bộ phận tiếp nhận, xử lý phản ánh của cơ sở","loai":"co_so"},{"id":"cc","ten":"Contact Center","loai":"contact_center"},{"id":"so-hoa","ten":"Phòng Số hóa","loai":"khac"},{"id":"cnnvy","ten":"Phòng Công nghệ – Nghiệp vụ Y","loai":"khac"},{"id":"nhan-luc","ten":"Phòng Nhân lực","loai":"khac"},{"id":"tuyen-dung","ten":"Tổ Tuyển dụng (Phòng Nhân lực)","loai":"khac"},{"id":"qlcl","ten":"Phòng Quản lý chất lượng","loai":"khac"},{"id":"phap-che","ten":"Bộ phận pháp chế","loai":"khac"},{"id":"hcqt","ten":"Phòng Hành chính quản trị","loai":"khac"},{"id":"ke-toan","ten":"Kế toán","loai":"khac"},{"id":"mua-sam","ten":"Phòng Tài chính – Kế hoạch (đơn vị chủ trì mua sắm)","loai":"khac"},{"id":"winmed","ten":"Công ty Cổ phần Winmed Việt Nam","loai":"khac"},{"id":"ctxh","ten":"Tổ Công tác xã hội","loai":"khac"},{"id":"don-vi-ban","ten":"Đơn vị bán, ký hợp đồng khám sức khỏe doanh nghiệp","loai":"khac"},{"id":"don-vi-ky-ket","ten":"Đơn vị ký kết đối tác cấp hệ thống","loai":"khac"},{"id":"don-vi-kinh-doanh","ten":"Đơn vị kinh doanh","loai":"khac"},{"id":"don-vi-chuyen-mon","ten":"Đơn vị chuyên môn","loai":"khac"},{"id":"khach","ten":"Khách hàng","loai":"ben_ngoai"},{"id":"nha-truong","ten":"Nhà trường","loai":"ben_ngoai"},{"id":"tue-duc-thien","ten":"Công ty TNHH Tuệ Đức Thiện","loai":"khac"},{"id":"nha-cung-cap","ten":"Nhà cung cấp, đơn vị thi công đã phê duyệt","loai":"ben_ngoai"},{"id":"bao-chi","ten":"Cơ quan báo chí","loai":"ben_ngoai"},{"id":"co-so-y-te-doi-tac","ten":"Cơ sở y tế đối tác, tuyến dưới","loai":"ben_ngoai"},{"id":"co-quan-nha-nuoc","ten":"Cơ quan nhà nước có thẩm quyền","loai":"ben_ngoai"},{"id":"thu-ky-btgd","ten":"Thư ký Ban Tổng Giám đốc mảng Marketing","loai":"lanh_dao"},{"id":"ptgd-tc","ten":"Phó Tổng Giám đốc mảng tài chính","loai":"lanh_dao"},{"id":"to-mkt-vinh","ten":"Tổ Marketing Bệnh viện Đa khoa TTH Vinh","loai":"to_marketing_benh_vien","nhom":"N1"},{"id":"to-mkt-hatinh","ten":"Tổ Marketing Bệnh viện Đa khoa TTH Hà Tĩnh","loai":"to_marketing_benh_vien","nhom":"N1"},{"id":"to-mkt-quangbinh","ten":"Tổ Marketing Bệnh viện Đa khoa TTH Quảng Bình","loai":"to_marketing_benh_vien","nhom":"N1"},{"id":"to-mkt-nguyenphuc","ten":"Tổ Marketing Bệnh viện Y học cổ truyền Nguyên Phúc","loai":"to_marketing_benh_vien","nhom":"N2"},{"id":"to-mkt-thaithuonghoang","ten":"Tổ Marketing Bệnh viện Răng Hàm Mặt và Phẫu thuật tạo hình thẩm mỹ Thái Thượng Hoàng","loai":"to_marketing_benh_vien","nhom":"N2"}],"muc_tieu_chien_luoc":[{"id":"MT1","ten":"Tăng trưởng và phát triển thị trường"},{"id":"MT2","ten":"Thương hiệu và niềm tin"},{"id":"MT3","ten":"Giá trị và quan hệ vòng đời khách hàng"},{"id":"MT4","ten":"Hệ sinh thái, cộng đồng và quan hệ chiến lược"},{"id":"MT5","ten":"Thương hiệu nhà tuyển dụng và gắn kết nội bộ"},{"id":"MT6","ten":"Năng lực Marketing và nền tảng quản trị"}],"kpi":[{"id":"KPI-01","ten":"Khách sử dụng dịch vụ","muc_tieu":"MT1","cong_thuc":"Đếm khách duy nhất sử dụng dịch vụ và được quy thuộc cho Hạng mục theo quy tắc đối soát","don_vi_tinh":"Khách","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS, CRM; đối soát của cơ sở","dieu_kien_dung":"Hạng mục có kết quả cần đạt là tạo khách sử dụng dịch vụ","quy_tac":"Không thay bằng số Lead, số đặt lịch","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-02","ten":"Doanh thu quy thuộc","muc_tieu":"MT1","cong_thuc":"Tổng doanh thu đã xác nhận của khách, dịch vụ được quy thuộc cho Hạng mục trong thời gian ghi nhận","don_vi_tinh":"Đồng","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS; kế toán; CRM đối soát","dieu_kien_dung":"Chỉ dùng khi có căn cứ quy thuộc","quy_tac":"Không phải tổng doanh thu của cơ sở; không suy ra từ lượt tiếp cận, lượt truy cập","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-03","ten":"Tỷ lệ Lead hợp lệ thành khách","muc_tieu":"MT1","cong_thuc":"Khách sử dụng dịch vụ quy thuộc ÷ Lead hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM, Contact Center; HIS","dieu_kien_dung":"Có cùng lúc số Lead hợp lệ và số khách sử dụng dịch vụ","quy_tac":"Lead hợp lệ theo tiêu chí chuẩn","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-04","ten":"Lead hợp lệ","muc_tieu":"MT1","cong_thuc":"Đếm Lead duy nhất đạt tiêu chí Lead hợp lệ, đủ điều kiện chuyển tư vấn, chăm sóc","don_vi_tinh":"Lead hợp lệ","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM, Contact Center","dieu_kien_dung":"Hạng mục có hoạt động tạo Lead","quy_tac":"Không dùng số tin nhắn, bình luận thô","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-05","ten":"Đặt lịch","muc_tieu":"MT1","cong_thuc":"Đếm lịch hẹn hợp lệ, đã xác nhận, quy thuộc cho Hạng mục","don_vi_tinh":"Lịch","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM; App TTH; website; HIS","dieu_kien_dung":"Hạng mục có bước đặt lịch","quy_tac":"Có quy tắc xử lý lịch hủy, lịch trùng","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-06","ten":"Chi phí trên Lead hợp lệ","muc_tieu":"MT1","cong_thuc":"Chi phí quảng cáo ÷ Lead hợp lệ từ quảng cáo","don_vi_tinh":"Đồng/Lead hợp lệ","chieu":"Càng thấp càng tốt","nguon_so_lieu":"Nền tảng quảng cáo; CRM đối soát","dieu_kien_dung":"Có quảng cáo trả phí, truy được Lead hợp lệ","quy_tac":"Chỉ tính chi phí quảng cáo; chỉ để chẩn đoán","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-07","ten":"Chi phí trên khách","muc_tieu":"MT1","cong_thuc":"Tổng chi của Hạng mục ÷ khách sử dụng dịch vụ quy thuộc","don_vi_tinh":"Đồng/khách","chieu":"Càng thấp càng tốt","nguon_so_lieu":"Phần mềm (chi Hạng mục); HIS","dieu_kien_dung":"Hạng mục có kết quả cần đạt là tạo khách","quy_tac":"Không áp dụng cho tuyển dụng, dự án nền tảng","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-08","ten":"Nhận biết thương hiệu","muc_tieu":"MT2","cong_thuc":"Số người nhận biết thương hiệu ÷ tổng mẫu hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Khảo sát, nghiên cứu thương hiệu","dieu_kien_dung":"Có khảo sát nhận biết thương hiệu theo năm (thuê đơn vị bên ngoài có điều kiện, mục 26); chưa có khảo sát: theo quy tắc chung cho KPI chưa đo được","quy_tac":"Không thay bằng lượt tiếp cận; giữ cùng phương pháp giữa các kỳ","ky_cham":"Năm","can_cu":"mục 12.5"},{"id":"KPI-09","ten":"Mức độ cân nhắc, lựa chọn thương hiệu","muc_tieu":"MT2","cong_thuc":"Số người cân nhắc, lựa chọn thương hiệu ÷ tổng mẫu hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Khảo sát, nghiên cứu thương hiệu","dieu_kien_dung":"Có khảo sát nhận biết thương hiệu theo năm (thuê đơn vị bên ngoài có điều kiện, mục 26); chưa có khảo sát: theo quy tắc chung cho KPI chưa đo được","quy_tac":"Giữ cùng phương pháp giữa các kỳ","ky_cham":"Năm","can_cu":"mục 12.5"},{"id":"KPI-10","ten":"Tỷ lệ đánh giá tích cực","muc_tieu":"MT2","cong_thuc":"Đánh giá công khai tích cực hợp lệ ÷ tổng đánh giá hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Trang doanh nghiệp trên Google; nền tảng đánh giá","dieu_kien_dung":"Có hoạt động quản lý đánh giá","quy_tac":"Ngưỡng tích cực thống nhất trước khi đo","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-11","ten":"Tăng trưởng tìm kiếm thương hiệu","muc_tieu":"MT2","cong_thuc":"(Lượt tìm kiếm có từ khóa thương hiệu kỳ này − kỳ gốc) ÷ kỳ gốc × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Google Search Console; công cụ SEO thống nhất","dieu_kien_dung":"Có kỳ gốc so sánh hợp lệ","quy_tac":"Không so giữa các nguồn, cách đo khác nhau","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-12","ten":"Điểm đánh giá trung bình","muc_tieu":"MT2","cong_thuc":"Tổng điểm đánh giá ÷ số đánh giá hợp lệ","don_vi_tinh":"Điểm (thang 5)","chieu":"Càng cao càng tốt","nguon_so_lieu":"Trang doanh nghiệp trên Google; nền tảng đánh giá","dieu_kien_dung":"Có đủ số đánh giá tin cậy","quy_tac":"Ghi rõ thang điểm","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-13","ten":"Bài, đề cập báo chí không trả phí đạt chuẩn","muc_tieu":"MT2","cong_thuc":"Đếm bài, đề cập không trả phí đạt tiêu chí nguồn, nội dung, thời gian","don_vi_tinh":"Bài","chieu":"Càng cao càng tốt","nguon_so_lieu":"Theo dõi báo chí; báo cáo quan hệ công chúng","dieu_kien_dung":"Hạng mục có kết quả cần đạt tương ứng, hoặc chỉ tiêu quý của vị trí","quy_tac":"Không tính bài trả phí","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-14","ten":"Tỷ lệ tuân thủ thương hiệu","muc_tieu":"MT2","cong_thuc":"Điểm chạm đạt chuẩn ÷ tổng điểm chạm được kiểm tra × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Biên bản kiểm tra tuân thủ nhận diện của Chuyên viên thiết kế ngoại tuyến; phần mềm","dieu_kien_dung":"Hạng mục có kết quả cần đạt tương ứng, hoặc chỉ tiêu quý của vị trí","quy_tac":"Dùng một mẫu kiểm tra thống nhất","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-15","ten":"Tỷ lệ tái sử dụng dịch vụ","muc_tieu":"MT3","cong_thuc":"Khách quay lại sử dụng dịch vụ ÷ khách đủ điều kiện theo dõi × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS; CRM","dieu_kien_dung":"Có định nghĩa nhóm khách, thời gian tái sử dụng","quy_tac":"Không dùng tổng lượt khám làm mẫu số","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-16","ten":"Khách sử dụng thêm dịch vụ","muc_tieu":"MT3","cong_thuc":"Đếm khách hiện hữu duy nhất sử dụng thêm dịch vụ khác, quy thuộc hoạt động chăm sóc","don_vi_tinh":"Khách","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM; HIS","dieu_kien_dung":"Có chương trình chăm sóc, sử dụng thêm dịch vụ","quy_tac":"Loại trừ khách trùng","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-17","ten":"Doanh thu từ khách hiện hữu","muc_tieu":"MT3","cong_thuc":"Tổng doanh thu quy thuộc từ nhóm khách hiện hữu được chăm sóc trong kỳ","don_vi_tinh":"Đồng","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS; kế toán; CRM","dieu_kien_dung":"Có định nghĩa khách hiện hữu, căn cứ quy thuộc","quy_tac":"Không lấy toàn bộ doanh thu khách cũ nếu không gắn chương trình","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-18","ten":"Tỷ lệ phản hồi đúng thời hạn","muc_tieu":"MT3","cong_thuc":"Tương tác phản hồi đúng thời hạn chuẩn ÷ tổng tương tác thuộc thời hạn chuẩn × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Contact Center; CRM","dieu_kien_dung":"Có thời hạn phản hồi chuẩn theo kênh, loại yêu cầu","quy_tac":"Loại trừ tin rác, tin tự động","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-19","ten":"Tỷ lệ chăm sóc thành đặt lịch","muc_tieu":"MT3","cong_thuc":"Đặt lịch từ nhóm được chăm sóc ÷ tổng khách, Lead đủ điều kiện chăm sóc × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM, Contact Center; HIS","dieu_kien_dung":"Có chương trình chăm sóc","quy_tac":"Mẫu số là nhóm đủ điều kiện, không phải toàn bộ dữ liệu","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-20","ten":"NPS","muc_tieu":"MT3","ghi_chu":"Chờ chốt phân vai với Phòng Quản lý chất lượng (mục 28, số 30)","cong_thuc":"% khách chấm 9–10 trừ % khách chấm 0–6 trên thang 0–10","don_vi_tinh":"Điểm NPS","chieu":"Càng cao càng tốt","nguon_so_lieu":"Khảo sát NPS; CRM","dieu_kien_dung":"Có khảo sát theo thang 0–10","quy_tac":"Không 