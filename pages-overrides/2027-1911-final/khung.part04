tốt","nguon_so_lieu":"Phòng Nhân lực","dieu_kien_dung":"Có kết quả cần đạt là tuyển dụng","quy_tac":"Chốt rõ mốc: đồng ý đề nghị tuyển dụng hay nhận việc","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-31","ten":"Tỷ lệ tham gia, gắn kết cán bộ nhân viên","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Phòng Nhân lực (chờ chốt, mục 28, số 30)","cong_thuc":"Cán bộ nhân viên tham gia hợp lệ ÷ tổng cán bộ nhân viên thuộc đối tượng × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực; form nội bộ","dieu_kien_dung":"Chương trình có kết quả cần đạt là gắn kết nội bộ","quy_tac":"Không dùng cho truyền thông tuyển dụng bên ngoài","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-32","ten":"Tỷ lệ ứng viên hợp lệ thành phỏng vấn","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Ứng viên được phỏng vấn ÷ ứng viên hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực","dieu_kien_dung":"Có các bước tuyển chọn","quy_tac":"Cùng kỳ, cùng nhóm vị trí","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-33","ten":"Tỷ lệ phỏng vấn thành tuyển được","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Tuyển được ÷ ứng viên đã phỏng vấn × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực","dieu_kien_dung":"Có các bước tuyển chọn","quy_tac":"Cùng định nghĩa tuyển được","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-34","ten":"Chi phí trên người tuyển được","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Tổng chi của Hạng mục tuyển dụng ÷ số người tuyển được","don_vi_tinh":"Đồng/người","chieu":"Càng thấp càng tốt","nguon_so_lieu":"Phần mềm (chi Hạng mục); Phòng Nhân lực","dieu_kien_dung":"Có số liệu chi, số tuyển được","quy_tac":"Không dùng chi phí trên khách","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-35","ten":"Tỷ lệ chấp nhận đề nghị tuyển dụng","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Ứng viên đồng ý đề nghị tuyển dụng ÷ tổng đề nghị hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực","dieu_kien_dung":"Có ghi nhận đề nghị tuyển dụng","quy_tac":"Không dùng khi chưa theo dõi đề nghị tuyển dụng có cấu trúc","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-36","ten":"Tỷ lệ Hạng mục nghiệm thu","muc_tieu":"MT6","cong_thuc":"Phần việc nghiệm thu đạt ÷ tổng phần việc phải nghiệm thu × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Biên bản nghiệm thu; phần mềm","dieu_kien_dung":"Dự án có danh mục phần việc rõ ràng","quy_tac":"Điều kiện nghiệm thu xác định trước","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-37","ten":"Tỷ lệ Hạng mục đúng hạn","muc_tieu":"MT6","cong_thuc":"Phần việc hoàn thành đúng hoặc trước hạn đã duyệt ÷ tổng phần việc đến hạn × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phần mềm","dieu_kien_dung":"Có hạn chuẩn","quy_tac":"Không tính phần việc chưa đến hạn vào mẫu số","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-38","ten":"Tỷ lệ sử dụng","muc_tieu":"MT6","cong_thuc":"Người, đơn vị sử dụng thực tế ÷ tổng người, đơn vị phải sử dụng × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Nhật ký hệ thống; báo cáo sử dụng","dieu_kien_dung":"Dự án có yêu cầu sử dụng sau triển khai","quy_tac":"Định nghĩa trước thế nào là sử dụng thực tế","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-39","ten":"Tỷ lệ dữ liệu đạt chuẩn","muc_tieu":"MT6","cong_thuc":"Bản ghi đạt chuẩn ÷ tổng bản ghi kiểm tra × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM; báo cáo chất lượng dữ liệu","dieu_kien_dung":"Có bộ tiêu chuẩn dữ liệu","quy_tac":"Có thể tách đủ trường, đúng giá trị khi dữ liệu ổn định","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-40","ten":"Tỷ lệ đơn vị tuân thủ quy trình","muc_tieu":"MT6","cong_thuc":"Đơn vị, điểm đạt ÷ tổng đơn vị, điểm được kiểm tra × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Danh sách kiểm tra; phần mềm","dieu_kien_dung":"Có quy trình, chuẩn áp dụng toàn hệ thống","quy_tac":"Dùng một mẫu kiểm tra thống nhất","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-41","ten":"Tỷ lệ tích hợp, kết nối hoàn thành","muc_tieu":"MT6","cong_thuc":"Luồng kết nối đạt kiểm thử ÷ tổng luồng kết nối theo kế hoạch × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Biên bản kiểm thử; sổ theo dõi kết nối","dieu_kien_dung":"Dự án có kết nối hệ thống","quy_tac":"Chỉ tính luồng đạt điều kiện kỹ thuật, nghiệp vụ","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-42","ten":"Tỷ lệ mã theo dõi, quy thuộc đối soát được","muc_tieu":"MT6","cong_thuc":"Điểm chạm, nguồn đối soát được ÷ tổng điểm chạm, nguồn phải đo × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Công cụ đo; CRM; HIS; kiểm tra dữ liệu","dieu_kien_dung":"Có kết quả cần đạt là đo lường, quy thuộc","quy_tac":"Gắn mã nhưng không đối soát được thì không tính đạt; Đo trên phần khách đã đồng ý mã theo dõi (Nghị định 330/2026/NĐ-CP)","ky_cham":"Quý","can_cu":"mục 12.5"}],"nhom_hoat_dong":[{"id":"N1","ten":"Nghiên cứu / Chiến lược / Kế hoạch"},{"id":"N2","ten":"Sáng tạo / Sản xuất nội dung / Tài sản thương hiệu"},{"id":"N3","ten":"Kênh sở hữu / Xuất bản tự nhiên"},{"id":"N4","ten":"Quảng cáo trả phí / Mua truyền thông"},{"id":"N5","ten":"PR / Danh tiếng / Đánh giá công khai"},{"id":"N6","ten":"Sự kiện / Kích hoạt / Cộng đồng"},{"id":"N7","ten":"Đối tác / B2B / Nguồn giới thiệu"},{"id":"N8","ten":"Website / App / SEO kỹ thuật / Công nghệ Marketing"},{"id":"N9","ten":"CRM / Tiếp thị trực tiếp / Tổng đài"},{"id":"N10","ten":"Đo lường / Phân tích / Quy thuộc kết quả / Báo cáo"},{"id":"N11","ten":"Vận hành / Quản trị / Năng lực Marketing"}],"mang_viec":[{"so":1,"ten":"Kế hoạch, ngân sách","thuc_hien":"Quản lý thương hiệu (Hạng mục, tháng); Trưởng phòng chủ trì kế hoạch năm","dau_vao":"Trưởng nhóm cơ sở (nhu cầu); Ban Giám đốc cơ sở (dịch vụ trọng tâm); Chuyên viên đo lường và đối soát (số liệu)","duyet":"Ban Giám đốc cơ sở: nhu cầu, ngân sách cơ sở. Trưởng phòng: kế hoạch Hạng mục, kế hoạch tháng. Ban Tổng Giám đốc: kế hoạch, hạn mức năm; Hạng mục dùng ngân sách Tổng công ty hoặc nhiều cơ sở (mục 4.2)","chiu_trach_nhiem":"Trưởng phòng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":2,"ten":"Nghiên cứu thị trường, khảo sát nhận biết","thuc_hien":"Chuyên viên dữ liệu khách hàng và thị trường","dau_vao":"Marketing cơ sở (thu thập tại chỗ); Quản lý thương hiệu (câu hỏi)","duyet":"Chuyên viên trưởng: phương án khảo sát (mục 14.16)","chiu_trach_nhiem":"Chuyên viên dữ liệu khách hàng và thị trường","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":3,"ten":"Gói dịch vụ, ưu đãi; chương trình trọng điểm theo hệ thống bệnh viện, phòng khám (gói khám, gói điều trị, chương trình trị liệu, hội thảo, lớp học)","thuc_hien":"Trưởng phòng chủ trì (chương trình theo hệ thống trong kế hoạch năm; trình Ban Tổng Giám đốc); Quản lý thương hiệu của nhóm lập đề xuất chi tiết theo thị trường, Hạng mục","dau_vao":"Đơn vị chuyên môn chủ trì nội dung chuyên môn của chương trình áp dụng từ 02 cơ sở; khoa phòng, bác sĩ (thành phần chuyên môn, chỉ định, chống chỉ định, số buổi; chương trình, báo cáo viên của hội thảo, lớp học); kế toán (giá, phí); Chuyên viên dữ liệu khách hàng và thị trường (thị trường, giá đối thủ)","duyet":"Ban Giám đốc cơ sở: chương trình, gói của 01 cơ sở. Chương trình áp dụng từ 02 cơ sở hoặc toàn hệ thống bệnh viện, phòng khám của một thương hiệu: Ban Tổng Giám đốc (Đề xuất – chờ duyệt, theo ngưỡng mục 14.15, số 38); Ban Giám đốc từng cơ sở xác nhận khả năng tiếp nhận, lịch, địa điểm. Marketing không quyết nội dung chuyên môn, giá (QT.26)","chiu_trach_nhiem":"Ban Giám đốc cơ sở","pham_vi":"mot_phan","phan_marketing":"Quản lý thương hiệu đề xuất","can_cu":"mục 31"},{"so":4,"ten":"Nội dung chuyên môn; rà soát định kỳ nội dung y khoa đã đăng (QT.28)","thuc_hien":"Chuyên viên biên tập của nhóm","dau_vao":"Trưởng nhóm cơ sở (chủ đề, bác sĩ)","duyet":"Bác sĩ, trưởng khoa: chuyên môn. Pháp lý: kiểm pháp lý theo tầng (mục 15.6). Bộ phận pháp chế: sản phẩm rủi ro cao. Nghiệm thu: người gửi yêu cầu; phát hành khi đủ bước kiểm, nghiệm thu, duyệt (mục 14.16)","chiu_trach_nhiem":"Chuyên viên biên tập của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":5,"ten":"Tin hoạt động trong ngày","thuc_hien":"Trưởng nhóm Marketing cơ sở: tin V1 đúng danh mục trên Facebook bệnh viện khi có quyền đăng hợp lệ; Media cơ sở chỉ đăng thay nếu có ủy quyền tách biệt và truy cập hợp lệ, không mặc nhiên có quyền khi Trưởng nhóm vắng.","dau_vao":"Chuyên viên Marketing cơ sở – media (ảnh, clip ngắn)","duyet":"Kiểm danh mục, nguồn, quyền đăng và nhật ký; danh sách kiểm không thay giấy ủy quyền. Vượt danh mục/chứa ca bệnh, giá, ưu đãi, kỹ thuật mới: chuyển Biên tập TCT và quy trình duyệt phát hành.","chiu_trach_nhiem":"Trưởng nhóm cơ sở","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":6,"ten":"Thiết kế","thuc_hien":"Chuyên viên thiết kế ngoại tuyến (danh sách cố định, mục 15.2); Chuyên viên thiết kế của nhóm (sản phẩm còn lại, cả bản số và bản in)","dau_vao":"Marketing cơ sở (yêu cầu, số đo); Chuyên viên biên tập (nội dung)","duyet":"Người gửi yêu cầu nghiệm thu đúng yêu cầu (Quản lý thương hiệu; Trưởng nhóm Marketing cơ sở với yêu cầu của cơ sở). Ấn phẩm ngoại viện (QyĐ.03.MKT mục 5.2): theo phân cấp (mục 14.16). Biển truyền thông: theo QyĐ.48","chiu_trach_nhiem":"Chuyên viên thiết kế của nhóm (sản phẩm của nhóm); Chuyên viên thiết kế ngoại tuyến (danh sách cố định)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":7,"ten":"Bộ nhận diện làm lại","thuc_hien":"Chuyên viên thiết kế nhóm 1 (bộ nhận diện chung của TTH: TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic); Chuyên viên thiết kế nhóm 2 (bộ nhận diện của nhóm 2; phần thiết kế hệ nhận diện thuê ngoài theo tờ trình – mục 26, Chuyên viên thiết kế nhóm 2 là đầu mối, nghiệm thu kỹ thuật); Chuyên viên thiết kế của nhóm (áp dụng cho sản phẩm còn lại); Chuyên viên thiết kế ngoại tuyến (áp dụng cho biển bảng, trang trí, phương tiện); Chuyên viên truyền thông của nhóm (thi công biển); Chuyên viên thiết kế ngoại tuyến hỗ trợ bộ nhận diện nhóm 2 trong giờ dư đến khi bàn giao","dau_vao":"Quản lý thương hiệu (định vị); Marketing cơ sở (hiện trạng)","duyet":"Ban Tổng Giám đốc","chiu_trach_nhiem":"Quản lý thương hiệu nhóm 1 (bộ nhận diện chung của TTH, áp dụng tại nhóm 1); Quản lý thương hiệu nhóm 2 (bộ nhận diện của nhóm 2)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":8,"ten":"Nhãn hiệu, tên miền","thuc_hien":"Bộ phận pháp chế (đăng ký nhãn hiệu); Phòng Công nghệ – Nghiệp vụ Y (đăng ký, gia hạn, theo dõi hạn tên miền, chứng chỉ bảo mật); Phòng Số hóa (trỏ tên miền, cài chứng chỉ bảo mật trên website)","dau_vao":"Quản lý sản phẩm số (danh mục tên miền)","duyet":"Ban Tổng Giám đốc","chiu_trach_nhiem":"Nhãn hiệu: Quản lý thương hiệu của nhóm (hồ sơ: bộ phận pháp chế); tên miền: Quản lý sản phẩm số","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":9,"ten":"Media","thuc_hien":"Biên tập đúng nhóm chịu trách nhiệm kịch bản lời mọi video V2–V4; Media TCT đúng nhóm lập phân cảnh, kiểm kỹ thuật, dựng V3 vượt mẫu và V4; Media cơ sở chủ trì quay/dựng V1–V3 trong B-7, chuyển kiểm kỹ thuật theo quy trình. Không giao lời cho Media vì video không chứa chuyên môn.","dau_vao":"Biên tập đúng nhóm (kịch bản lời/thoại của mọi V2–V4, thông điệp); Media TCT (phân cảnh/shot-list); cơ sở/bác sĩ (nguồn y tế, nhân vật, giấy đồng ý); phân loại rủi ro chuyên môn/giá/ưu đãi độc lập với V1–V4.","duyet":"Bác sĩ/đơn vị chuyên môn xác nhận nếu có yếu tố y tế; kiểm pháp lý độc lập; Media TCT kiểm kỹ thuật nếu cơ sở dựng; Quản lý thương hiệu nghiệm thu đầu ra; người có thẩm quyền theo ma trận duyệt phát hành. Không tự kiểm hoặc tự duyệt.","chiu_trach_nhiem":"Media cơ sở chịu trách nhiệm chất lượng đầu ra dựng V2/V3 theo B-7 của chính cơ sở; Media TCT đúng nhóm chịu trách nhiệm kiểm kỹ thuật V2/V3, sản phẩm dựng chuyên sâu V3/V4 và chuẩn kỹ thuật. Phê duyệt phát hành theo ma trận riêng.","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":10,"ten":"Kênh số","thuc_hien":"Chuyên viên quảng cáo và kênh số của nhóm (kênh của nhóm)","dau_vao":"Tổ Nội dung và Sáng tạo (sản phẩm); Trưởng nhóm cơ sở (tin trong ngày trên Facebook của bệnh viện)","duyet":"Quản lý thương hiệu của nhóm: nghiệm thu lịch đăng. Trưởng phòng: quyền quản trị kênh (quyền quản trị cao nhất 02 người); Chuyên viên trưởng: quyền đăng bài, trả lời tin nhắn theo ma trận quyền (mục 11.3)","chiu_trach_nhiem":"Chuyên viên quảng cáo và kênh số của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":11,"ten":"Quảng cáo trực tuyến, KOL, KOC","thuc_hien":"Chuyên viên quảng cáo và kênh số (quảng cáo trả phí, đo Lead); Chuyên viên truyền thông của nhóm (KOL, KOC: chọn người, hợp đồng, quan hệ, pháp lý)","dau_vao":"Quản lý thương hiệu (kết quả cần đạt, ngân sách); Marketing cơ sở (ưu đãi, khả năng tiếp nhận)","duyet":"Chi phí: tờ trình theo Hạng mục. Nội dung: kiểm tra pháp lý","chiu_trach_nhiem":"Chuyên viên quảng cáo và kênh số của nhóm (Lead hợp lệ; chi phí trên Lead chỉ để chẩn đoán)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":12,"ten":"Bảng biển, quảng cáo ngoài trời, truyền thanh, truyền hình","thuc_hien":"Chuyên viên truyền thông của nhóm (quyết định vận hành/lịch/cải tạo theo phân cấp); Chuyên viên Marketing cơ sở – truyền thông (vận hành/kiểm tra/ảnh, số đo tại bệnh viện 03 người); bệnh viện 02 người: Trưởng nhóm Marketing cơ sở kiêm; Chuyên viên thiết kế ngoại tuyến (danh mục và mẫu)","dau_vao":"Chuyên viên thiết kế ngoại tuyến (mẫu thiết kế, file theo số đo, quy chuẩn chung); Marketing cơ sở (khảo sát); Quản lý thương hiệu; Chuyên viên Marketing cơ sở – truyền thông cung cấp kiểm tra tại chỗ, không giao Media cơ sở","duyet":"Thiết kế, nội dung, chất liệu: theo QyĐ.48 (Ban Tổng Giám đốc hoặc Ban Giám đốc cơ sở). Chi phí: tờ trình","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":13,"ten":"Màn hình nội viện","thuc_hien":"Chuyên viên truyền thông của nhóm (lập, giao lịch phát); Chuyên viên Marketing cơ sở – truyền thông (vận hành, kiểm tra hiển thị/âm thanh tại cơ sở; bệnh viện 02 người: Trưởng nhóm kiêm); Chuyên viên biên tập, thiết kế, media TCT (sản phẩm nội dung), không giao Media chi nhánh vận hành","dau_vao":"Marketing cơ sở gửi đề xuất của khoa phòng, có xác nhận của người phụ trách; sản phẩm đã được duyệt","duyet":"Chuyên viên truyền thông của nhóm nghiệm thu; kiểm pháp lý theo tầng (mục 15.6); phát hành khi đủ bước","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":14,"ten":"Phát thanh nội viện","thuc_hien":"Chuyên viên truyền thông TCT của nhóm lập lịch và điều phối; Chuyên viên biên tập của nhóm soạn kịch bản mẫu; Chuyên viên Marketing cơ sở – truyền thông trực tiếp phát, kiểm tra âm thanh tại bệnh viện 03 người; bệnh viện 02 người: Trưởng nhóm Marketing cơ sở kiêm nhiệm; Media cơ sở chỉ hỗ trợ thu âm tư liệu nếu được yêu cầu","dau_vao":"Khoa phòng (thông tin đã xác nhận); Trưởng nhóm Marketing cơ sở (nhu cầu, khung giờ, tình trạng hệ thống phát)","duyet":"Kịch bản do Biên tập soạn; bác sĩ xác nhận khi có chuyên môn; kiểm nội dung độc lập theo tầng; Truyền thông TCT nghiệm thu lịch phát; người có thẩm quyền duyệt phát hành trước khi cơ sở phát đúng bản.","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm chịu trách nhiệm lịch và nội dung phát theo bản đã duyệt; truyền thông cơ sở hoặc Trưởng nhóm kiêm chịu trách nhiệm vận hành tại chỗ","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":15,"ten":"Trang trí lễ, Tết; poster, tranh ảnh trang trí tại cơ sở; vật phẩm thương hiệu","thuc_hien":"Chuyên viên Truyền thông TCT đúng nhóm lập kế hoạch, điều phối; Chuyên viên Marketing cơ sở – truyền thông khảo sát, triển khai, kiểm tra và chụp ảnh nghiệm thu tại bệnh viện 03 người; bệnh viện 02 người: Trưởng nhóm Marketing cơ sở kiêm nhiệm; Chuyên viên Thiết kế ngoại tuyến phụ trách mẫu trang trí, Thiết kế đúng nhóm phụ trách vật phẩm.","dau_vao":"Quản lý thương hiệu đúng nhóm xác định nhu cầu; Chuyên viên Marketing cơ sở – truyền thông cung cấp vị trí, kích thước, tình trạng thực tế, ảnh nghiệm thu (bệnh viện 02 người: Trưởng nhóm kiêm).","duyet":"Mẫu toàn hệ thống: Trưởng phòng, mỗi dịp một lần. Chi phí: tờ trình. Ban Giám đốc cơ sở: tại cơ sở; không đồng nhất duyệt thiết kế với nghiệm thu thi công, duyệt chi phí","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":16,"ten":"Website, App TTH","thuc_hien":"Quản lý sản phẩm số chủ nghiệp vụ, phối hợp Phòng Số hóa kỹ thuật; Chuyên viên biên tập phụ trách nội dung biên tập; Quản lý sản phẩm số cập nhật dữ liệu có cấu trúc theo mảng 43 sau kiểm độc lập; Chuyên viên quảng cáo và kênh số quản trị kênh mạng xã hội/Trang doanh nghiệp trên Google, không quản trị CMS website","dau_vao":"Marketing cơ sở (hồ sơ bác sĩ, dịch vụ; lịch bác sĩ khi chưa có kết nối HIS); HIS (lịch làm việc của bác sĩ khi có kết nối); kế toán (giá)","duyet":"Trưởng phòng: cấu trúc, thay đổi lớn. Bác sĩ: nội dung y khoa","chiu_trach_nhiem":"Quản lý sản phẩm số","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":17,"ten":"Tiếp nhận đa kênh: tổng đài, hotline di động, tin nhắn, bình luận, email, form","thuc_hien":"Contact Center (trước khi nhận: người đang trả lời tại cơ sở, mục 17)","dau_vao":"Cơ sở/bộ phận quản lý dịch vụ cung cấp phiếu thông tin gói khám, giá, điều kiện, lịch, câu hỏi thường gặp; chuyên môn/đơn vị có thẩm quyền xác nhận; Marketing cung cấp chương trình, thông điệp đã duyệt và tiêu chí Lead hợp lệ. Contact Center chủ trì kịch bản.","duyet":"Người có thẩm quyền của đơn vị chủ quản Contact Center duyệt kịch bản nghiệp vụ; chuyên môn xác nhận phần y tế, cơ sở xác nhận giá/điều kiện; Marketing chỉ kiểm tra thông điệp thuộc Marketing khi có.","chiu_trach_nhiem":"Contact Center: chất lượng tiếp nhận, nội dung kịch bản và phân tuyến; cơ sở/chuyên môn: tính đúng của thông tin cung cấp.","pham_vi":"mot_phan","phan_marketing":"Bàn giao thông tin Marketing đã duyệt, tiêu chí Lead hợp lệ; không chủ trì kịch bản tư vấn","can_cu":"mục 31"},{"so":18,"ten":"Chăm sóc, giữ chân khách hàng cũ; gửi tin hàng loạt","thuc_hien":"Chuyên viên quảng cáo và kênh số của nhóm (gửi tin hàng loạt, gửi tự động trên kênh của nhóm); Chuyên viên dữ liệu khách hàng và thị trường (lịch gửi chung, trần tần suất, chặn trùng; giai đoạn đầu: Chuyên viên đo lường và đối soát); Contact Center (gọi; trả lời tin khách gửi lại)","dau_vao":"Chuyên viên dữ liệu khách hàng và thị trường (phân khúc, danh sách đã đồng ý); Chuyên viên biên tập (nội dung); Chuyên viên thiết kế của nhóm (hình ảnh); Marketing cơ sở (đăng ký nhận tin, có đồng ý)","duyet":"Quản lý thương hiệu của nhóm: Hạng mục, đợt gửi. Biên tập kiểm theo tầng: pháp lý. Chuyên viên dữ liệu khách hàng và thị trường: dữ liệu cá nhân. Trưởng phòng: tần suất tối đa mỗi khách (mục 16, số 20)","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":19,"ten":"Đánh giá công khai","thuc_hien":"Contact Center, trước khi nhận: người đang trả lời tại cơ sở (thông thường); Chuyên viên truyền thông của nhóm (nhạy cảm)","dau_vao":"Marketing cơ sở (điểm chạm, phản ánh); bộ phận tiếp nhận, xử lý phản ánh của cơ sở (kết quả giải quyết)","duyet":"Chuyên viên truyền thông của nhóm: kịch bản trả lời","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":20,"ten":"Sự kiện, cộng đồng, học đường, đối tác địa phương","thuc_hien":"Truyền thông cơ sở (bệnh viện 02 người: Trưởng nhóm)","dau_vao":"Khoa phòng (phần y tế); Chuyên viên thiết kế của nhóm (ấn phẩm, bản số và bản in)","duyet":"Ban Giám đốc cơ sở: kế hoạch, ngân sách. Nội dung truyền thông (QyĐ.03.MKT mục 5.2): Chuyên viên trưởng; có báo chí, cấp hệ thống: Trưởng phòng (mục 14.16)","chiu_trach_nhiem":"Truyền thông cơ sở; sự kiện thuộc Hạng mục: Quản lý thương hiệu chịu trách nhiệm kết quả Hạng mục (mục 11.1, số 14)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":21,"ten":"Cơ sở y tế, bác sĩ, phòng khám bên ngoài giới thiệu người bệnh; tuyến dưới","thuc_hien":"Truyền thông cơ sở (bệnh viện 02 người: Trưởng nhóm); từ 02 cơ sở: Quản lý thương hiệu của nhóm","dau_vao":"Chuyên viên đo lường và đối soát (nguồn giới thiệu); đơn vị chuyên môn (chuyển tuyến, phản hồi chuyên môn cho người giới thiệu theo quy định)","duyet":"Ban Giám đốc cơ sở: chính sách hợp tác. Hình thức ghi nhận, chăm sóc bác sĩ, phòng khám bên ngoài: chỉ áp dụng hình thức được bộ phận pháp chế xác nhận (mục 28, số 47)","chiu_trach_nhiem":"Truyền thông cơ sở","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":22,"ten":"Hội nghị khoa học, sự kiện hệ thống","thuc_hien":"Chuyên viên biên tập, thiết kế, media của nhóm có sự kiện (sản xuất); Chuyên viên truyền thông của nhóm (báo chí); Marketing cơ sở cùng nhóm (hậu cần tại chỗ). Sự kiện của nhóm 1 tại trụ sở Tổng công ty (Bệnh viện Y học cổ truyền Nguyên Phúc, nhóm 2): Quản lý thương hiệu nhóm 1 lo hậu cần, phối hợp bộ phận hành chính của cơ sở (QT.12) – thay cách làm Phòng Marketing Tổng công ty xác nhận ngày 28/10/2026, theo nguyên tắc không xử lý chéo nhóm. Sự kiện hệ thống tổ chức ở nơi không có Marketing cơ sở (địa điểm thuê, phòng khám): Quản lý thương hiệu phụ trách Hạng mục điều phối hậu cần tại chỗ; Marketing cơ sở cùng nhóm gần nhất hỗ trợ theo lịch chung; âm thanh, sân khấu thuê qua nhà cung cấp, hồ sơ do Quản lý thương hiệu lập (mảng 30)","dau_vao":"Đơn vị chủ trì nội dung khoa học","duyet":"Trưởng phòng; Ban Tổng Giám đốc theo thẩm quyền","chiu_trach_nhiem":"Quản lý thương hiệu phụ trách Hạng mục","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":23,"ten":"Báo chí, khủng hoảng, theo dõi dư luận","thuc_hien":"Chuyên viên truyền thông của nhóm (gồm theo dõi dư luận về thương hiệu của nhóm)","dau_vao":"Marketing cơ sở (thông tin, bác sĩ); Phòng Quản lý chất lượng (sự cố y khoa)","duyet":"Người phát ngôn theo quy chế; Ban Tổng Giám đốc: thông cáo khủng hoảng","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm; khủng hoảng liên quan cả hai nhóm: Trưởng phòng (chưa có: Chuyên viên trưởng)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":24,"ten":"Bác sĩ trên mạng","thuc_hien":"Bác sĩ; Trưởng nhóm cơ sở (điều phối)","dau_vao":"Chuyên viên truyền thông của nhóm (hướng dẫn)","duyet":"Theo quy chế phát ngôn","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":25,"ten":"Truyền thông nội bộ","thuc_hien":"Nội bộ Tổng công ty, TTH Group: Chuyên viên truyền thông nhóm 1 (vận động tương tác), Chuyên viên biên tập nhóm 1, Chuyên viên media nhóm 1 (sản xuất); nội bộ đơn vị nhóm 2: người cùng chuyên môn nhóm 2; Marketing cơ sở (cấp cơ sở)","dau_vao":"Phòng Hành chính quản trị, Phòng Nhân lực (nội dung chủ trương, văn hóa)","duyet":"Đơn vị chủ trì nội dung; sản phẩm Marketing: Chuyên viên biên tập của nhóm duyệt, không duyệt sản phẩm do chính mình làm (mục 14.16)","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm (nội bộ Tổng công ty, TTH Group: nhóm 1)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":26,"ten":"Truyền thông tuyển dụng","thuc_hien":"Chuyên viên thiết kế của nhóm có cơ sở tuyển dụng (Tổng công ty, TTH Group: nhóm 1); Chuyên viên quảng cáo và kênh số của nhóm (đăng)","dau_vao":"Tổ Tuyển dụng (Phòng Nhân lực) (nội dung)","duyet":"Tổ Tuyển dụng (Phòng Nhân lực)","chiu_trach_nhiem":"Tổ Tuyển dụng (Phòng Nhân lực)","pham_vi":"mot_phan","phan_marketing":"Thiết kế, đăng trên kênh","can_cu":"mục 31"},{"so":27,"ten":"Quy tắc ứng xử mạng xã hội của nhân viên","thuc_hien":"Chuyên viên truyền thông nhóm 1, nhóm 2 soạn phần của nhóm; Chuyên viên trưởng tổng hợp","dau_vao":"Phòng Nhân lực","duyet":"Phòng Nhân lực trình ban hành","chiu_trach_nhiem":"Phòng Nhân lực","pham_vi":"mot_phan","phan_marketing":"Chuyên viên truyền thông nhóm 1 soạn","can_cu":"mục 31"},{"so":28,"ten":"Ấn phẩm giáo dục sức khỏe cho người bệnh","thuc_hien":"Chuyên viên thiết kế của nhóm (bản gốc: bản số, tờ phát tay); Chuyên viên thiết kế ngoại tuyến (poster treo cố định tại khoa phòng)","dau_vao":"Khoa phòng (nội dung)","duyet":"Khoa phòng: chuyên môn","chiu_trach_nhiem":"Khoa phòng (chờ văn bản Tổ Công tác xã hội)","pham_vi":"mot_phan","phan_marketing":"Thiết kế theo quy chuẩn","can_cu":"mục 31"},{"so":29,"ten":"Đối tác cấp hệ thống","thuc_hien":"Đơn vị được Ban Tổng Giám đốc giao (ký kết); hồ sơ năng lực: Chuyên viên truyền thông của nhóm (hồ sơ năng lực Tập đoàn: nhóm 1 ghép, phần nhóm 2 do Chuyên viên truyền thông nhóm 2 viết, nhóm 1 không sửa); truyền thông: Quản lý thương hiệu của nhóm","dau_vao":"Marketing cơ sở","duyet":"Ban Tổng Giám đốc","chiu_trach_nhiem":"Đơn vị được Ban Tổng Giám đốc giao","pham_vi":"mot_phan","phan_marketing":"Hồ sơ năng lực, truyền thông","can_cu":"mục 31"},{"so":30,"ten":"Nhà cung cấp, hợp đồng, thanh toán","thuc_hien":"Quản lý thương hiệu của nhóm (hồ sơ); Chuyên viên trưởng (danh sách nhà cung cấp đã phê duyệt); Chuyên viên đo lường và đối soát (cộng nhu cầu mua của 02 nhóm ngày 20–22, trước khi ký)","dau_vao":"Chuyên viên truyền thông, Chuyên viên quảng cáo và kênh số (đề xuất)","duyet":"Theo quy định mua sắm (Phòng Tài chính – Kế hoạch chủ trì); Quy chế chi tiêu nội bộ ban hành kèm Quyết định 189/QĐ-TTH: Điều 3.1 (người phê duyệt chi tiêu; với Marketing: chi mới ngoài hạn mức, kế hoạch và ngân sách năm: Tổng Giám đốc (đồng thời là Chủ tịch Hội đồng quản trị); chi trong hạn mức đã duyệt (tờ trình chi Hạng mục, hợp đồng, thanh toán): Phó Tổng Giám đốc mảng tài chính theo ma trận thẩm quyền), Điều 32.1 (tổng giá trị mua sắm từ 20 triệu đồng trở lên bắt buộc ký hợp đồng)","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm (chi trong hạn mức)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":31,"ten":"Quản trị nghiệp vụ phần mềm","thuc_hien":"Chuyên viên trưởng (phân quyền, mẫu Hạng mục); Chuyên viên dữ liệu khách hàng và thị trường (danh mục, chất lượng dữ liệu)","dau_vao":"Phòng Số hóa (kỹ thuật; yêu cầu gửi qua Quản lý sản phẩm số)","duyet":"Ma trận phân quyền, mẫu Hạng mục: Trưởng phòng duyệt một lần, sửa khi cần (Chuyên viên trưởng cấp quyền theo ma trận); thay đổi quy tắc phần mềm: Trưởng phòng","chiu_trach_nhiem":"Chuyên viên trưởng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":32,"ten":"Ghi nhận kết quả","thuc_hien":"Bộ phận tiếp đón (nguồn khách); Chuyên viên đo lường và đối soát (đối soát)","dau_vao":"Trưởng nhóm cơ sở (kiểm tra nguồn khách, bằng chứng)","duyet":"Trưởng phòng: bản chốt kỳ","chiu_trach_nhiem":"Chuyên viên đo lường và đối soát","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":33,"ten":"Bảo vệ dữ liệu cá nhân","thuc_hien":"Chuyên viên dữ liệu khách hàng và thị trường","dau_vao":"Marketing cơ sở (giấy đồng ý); Phòng Công nghệ – Nghiệp vụ Y","duyet":"Bộ phận pháp chế","chiu_trach_nhiem":"Chuyên viên dữ liệu khách hàng và thị trường","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":34,"ten":"Khám sức khỏe doanh nghiệp, gói dịch vụ cho tổ chức","thuc_hien":"Truyền thông: Quản lý thương hiệu của nhóm (Hạng mục); hồ sơ năng lực: Chuyên viên truyền thông của nhóm; quan hệ: truyền thông cơ sở; bán, ký hợp đồng: đơn vị do Ban Tổng Giám đốc xác định","dau_vao":"Khoa Khám sức khỏe (gói, giá)","duyet":"Ban Giám đốc cơ sở; Ban Tổng Giám đốc theo thẩm quyền","chiu_trach_nhiem":"Đơn vị bán, ký hợp đồng (mục 28, số 24)","pham_vi":"mot_phan","phan_marketing":"Truyền thông, hồ sơ năng lực, quan hệ","can_cu":"mục 31"},{"so":35,"ten":"Nội dung tiếng Anh của website","thuc_hien":"tthhealthcare.com: Chuyên viên biên tập nhóm 1; website của thương hiệu nhóm 2: Chuyên viên biên tập nhóm 2","dau_vao":"Bác sĩ (chuyên môn)","duyet":"Bác sĩ: chuyên môn. Kiểm pháp lý theo tầng (mục 15.6); Quản lý sản phẩm số nghiệm thu; phát hành khi đủ bước","chiu_trach_nhiem":"Chuyên viên biên tập của nhóm có website","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":36,"ten":"Theo dõi tổng chi Marketing so với ngân sách năm","thuc_hien":"Chuyên viên đo lường và đối soát","dau_vao":"Quản lý thương hiệu (khoản chi theo Hạng mục); kế toán (đối chiếu)","duyet":"Trưởng phòng","chiu_trach_nhiem":"Trưởng phòng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":37,"ten":"Kiểm tra tuân thủ nhận diện tại cơ sở","thuc_hien":"Chuyên viên thiết kế ngoại tuyến (kiểm độc lập; sản phẩm do chính mình làm: Chuyên viên thiết kế của nhóm có cơ sở kiểm); Chuyên viên truyền thông của nhóm (biển bảng)","dau_vao":"Chuyên viên Marketing cơ sở – truyền thông kiểm hiện trạng biển bảng hằng tuần, tổng hợp và gửi ảnh/số đo hằng tháng (bệnh viện 02 người: Trưởng nhóm kiêm); Media cơ sở không giữ lịch kiểm định kỳ.","duyet":"Quản lý thương hiệu của nhóm: biện pháp khắc phục","chiu_trach_nhiem":"Chuyên viên thiết kế ngoại tuyến","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":38,"ten":"Thủ tục với cơ quan nhà nước khi pháp luật yêu cầu","thuc_hien":"Pháp chế chủ trì xác định điều kiện, thành phần, hoàn thiện và nộp hồ sơ pháp lý quảng cáo; Chuyên viên biên tập của nhóm chỉ chuẩn bị nội dung/phiên bản và minh chứng Marketing. Hồ sơ website/App: Phòng Số hóa chủ trì theo phân công hiện hành","dau_vao":"Bộ phận pháp chế; Phòng Công nghệ – Nghiệp vụ Y (hồ sơ tên miền, chứng chỉ bảo mật); Quản lý sản phẩm số (phần nội dung của hồ sơ website, App TTH); bác sĩ/đơn vị chuyên môn xác nhận nội dung y tế, giấy phép/căn cứ và nguồn","duyet":"Trưởng phòng duyệt nội dung Marketing; Pháp chế kiểm tra điều kiện pháp lý, hoàn thiện/nộp hồ sơ; không phát hành khi thiếu căn cứ","chiu_trach_nhiem":"Bộ phận pháp chế (mục 28, số 7)","pham_vi":"mot_phan","phan_marketing":"Bản nội dung, minh chứng, nguồn xác nhận và phiên bản Marketing đã duyệt; không lập/nộp thay hồ sơ pháp lý","can_cu":"mục 31"},{"so":39,"ten":"Theo dõi thay đổi pháp luật quảng cáo y tế, chính sách nền tảng","thuc_hien":"Bộ phận pháp chế (pháp luật, danh sách kiểm tra pháp lý chung); Quản lý sản phẩm số (chính sách nền tảng, danh sách từ khóa, hình ảnh bị cấm); Chuyên viên biên tập của nhóm (phần chuyên khoa, sửa mẫu của nhóm)","dau_vao":"Bộ phận pháp chế (thông báo thay đổi)","duyet":"Pháp chế xác nhận nội dung chuyên môn DS-1; Trưởng phòng phê duyệt áp dụng danh sách trong quy trình Marketing; chính sách nền tảng do Chuyên viên trưởng duyệt","chiu_trach_nhiem":"Trưởng phòng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":40,"ten":"Quy định dùng công cụ trí tuệ nhân tạo","thuc_hien":"Chuyên viên trưởng (soạn)","dau_vao":"Chuyên viên biên tập; Chuyên viên dữ liệu khách hàng và thị trường; Phòng Công nghệ – Nghiệp vụ Y","duyet":"Trưởng phòng","chiu_trach_nhiem":"Chuyên viên trưởng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":41,"ten":"Tài trợ","thuc_hien":"Cấp hệ thống, thương hiệu: hồ sơ tài trợ: Chuyên viên truyền thông của nhóm (thương hiệu Tập đoàn: nhóm 1); tài trợ thuộc Hạng mục: Quản lý thương hiệu của nhóm. Địa phương: truyền thông cơ sở. Từ thiện không có đối ứng truyền thông: Tổ Công tác xã hội (mục 11.1, số 15)","dau_vao":"Đơn vị đề nghị tài trợ","duyet":"Ban Giám đốc cơ sở (địa phương); Trưởng phòng, Ban Tổng Giám đốc theo thẩm quyền","chiu_trach_nhiem":"Theo phạm vi: Chuyên viên truyền thông của nhóm, Quản lý thương hiệu của nhóm (Hạng mục) hoặc truyền thông cơ sở","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":42,"ten":"Mạo danh bệnh viện, bác sĩ, thương hiệu trên mạng (trang Facebook, tài khoản, website, quảng cáo giả)","thuc_hien":"Chuyên viên truyền thông của nhóm có thương hiệu bị mạo danh (phát hiện, xác minh, lưu bằng chứng, cảnh báo khách, báo bác sĩ); Chuyên viên quảng cáo và kênh số của nhóm (báo cáo vi phạm lên nền tảng); mạo danh cả hai nhóm: Chuyên viên trưởng chủ quy trình (QT.27)","dau_vao":"Marketing cơ sở, Contact Center, nhân viên (báo phát hiện); Quản lý thương hiệu của nhóm có thương hiệu (hồ sơ nhãn hiệu, mảng 8)","duyet":"Cảnh báo trên kênh chính thức: Trưởng phòng (mục 14.16). Báo cơ quan chức năng: bộ phận pháp chế","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":43,"ten":"Thông tin công khai của cơ sở khám bệnh, chữa bệnh trên website, App TTH (giá dịch vụ, người hành nghề, dịch vụ, kỹ thuật được phép)","thuc_hien":"Quản lý sản phẩm số đối chiếu nguồn, nhập và đăng dữ liệu có cấu trúc về giá/người hành nghề/dịch vụ/kỹ thuật trên website/App sau kiểm độc lập; Chuyên viên biên tập chỉ hiệu đính cách diễn đạt, không sửa số liệu nguồn","dau_vao":"Nguồn gốc: Kế toán/đơn vị quản lý giá cấp bảng giá; Phòng Nhân lực và đơn vị chuyên môn cấp, xác nhận người hành nghề và phân công; Phòng chuyên môn/Pháp chế cấp, xác nhận danh mục dịch vụ, kỹ thuật được phép; Ban Giám đốc cơ sở xác nhận hiệu lực. Trưởng nhóm cơ sở chuyển đủ bộ tài liệu đã xác nhận, không tự làm chủ dữ liệu.","duyet":"Đơn vị chủ dữ liệu và Ban Giám đốc cơ sở xác nhận tính đúng, hiệu lực của dữ liệu; Pháp chế kiểm soát điều kiện công khai; người kiểm độc lập đối chiếu trước công bố. Quản lý sản phẩm số chỉ công bố sau khi đủ bước.","chiu_trach_nhiem":"Quản lý sản phẩm số (tính chính xác cập nhật so với nguồn đã duyệt; chủ dữ liệu cơ sở chịu trách nhiệm dữ liệu gốc)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":44,"ten":"Trải nghiệm người bệnh; khảo sát hài lòng (NPS, CSAT)","thuc_hien":"Chuyên viên dữ liệu khách hàng và thị trường (NPS trên kênh số, điểm chạm sau khám; tổng hợp phản hồi cho Hạng mục); Contact Center (gọi khảo sát khi vận hành)","dau_vao":"Phòng Quản lý chất lượng (khảo sát hài lòng người bệnh theo quy định); bộ phận tiếp nhận, xử lý phản ánh","duyet":"Trưởng phòng: bộ câu hỏi trên kênh số","chiu_trach_nhiem":"Chờ quyết định (mục 28, số 30)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":45,"ten":"Bảo hiểm y tế, bảo hiểm sức khỏe, bảo lãnh viện phí: truyền thông quyền lợi, đối tác bảo hiểm","thuc_hien":"Quản lý thương hiệu của nhóm (truyền thông quyền lợi; đối tác bảo hiểm cấp hệ thống: hồ sơ năng lực, truyền thông); Chuyên viên biên tập (nội dung); Contact Center (tư vấn theo kịch bản)","dau_vao":"Bộ phận phụ trách bảo hiểm của cơ sở (quyền lợi, danh sách bảo lãnh viện phí)","duyet":"Ban Giám đốc cơ sở: nội dung quyền lợi tại cơ sở. Ký kết đối tác: đơn vị được Ban Tổng Giám đốc giao (mục 28, số 49)","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":46,"ten":"Người bệnh nước ngoài","thuc_hien":"Quản lý thương hiệu của nhóm (Hạng mục); Chuyên viên biên tập của nhóm (nội dung tiếng Anh, mảng 35); Quản lý sản phẩm số (trang ngôn ngữ trên website, App TTH)","dau_vao":"Ban Giám đốc cơ sở (nhu cầu, khả năng tiếp đón người bệnh nước ngoài)","duyet":"Trưởng phòng","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm, khi Ban Tổng Giám đốc xác nhận nhu cầu (mục 28, số 48)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"}],"mang_viec_bo_sung":[{"ten":"Tin giao dịch gửi tự động (xác nhận, nhắc lịch hẹn, báo đã có kết quả, nhắc tái khám theo chỉ định)","phan_marketing":"Soạn mẫu nội dung","chiu_trach_nhiem":"Đơn vị vận hành chờ Ban Tổng Giám đốc chốt","can_cu":"mục 28, số 36"}],"ngoai_pham_vi":[{"viec":"Giải quyết khiếu nại, phản ánh của người bệnh; trả lời người phản ánh qua kênh riêng","don_vi":["xu-ly-phan-anh"],"ghi_chu":"QT.18.MAR chuyển ra (mục 18)"},{"viec":"Sự cố y khoa; khảo sát hài lòng người bệnh","don_vi":["qlcl"],"ghi_chu":"KPI-20, KPI-21: chờ chốt (mục 28, số 30)"},{"viec":"Giao diện, lập trình, vận hành kỹ thuật website, App TTH, website các chuỗi, phần mềm Quản trị Marketing","don_vi":["so-hoa"],"ghi_chu":"mục 17"},{"viec":"Phần mềm phát màn hình, kho tư liệu; đăng ký, gia hạn, theo dõi hạn tên miền, chứng chỉ bảo mật (SSL); kết nối hệ thống","don_vi":["cnnvy"],"ghi_chu":"mục 17"},{"viec":"Bản tin nội bộ, chủ trương; lắp đặt, bảo trì thiết bị màn hình; sửa chữa vật lý biển bảng","don_vi":["hcqt"],"ghi_chu":"mục 17"},{"viec":"Mua sắm theo quy định mua sắm, gồm thiết bị màn hình, đồng phục","don_vi":["mua-sam"],"ghi_chu":"mục 17; mục 28, số 7"},{"viec":"Văn hóa doanh nghiệp, sự kiện nội bộ; quy định đồng phục; chức danh, chế độ, lương thưởng","don_vi":["nhan-luc"],"ghi_chu":"mục 17"},{"viec":"Nội dung, kế hoạch tuyển dụng","don_vi":["tuyen-dung"],"ghi_chu":"mục 17"},{"viec":"Đăng ký nhãn hiệu; ý kiến pháp lý sản phẩm rủi ro cao","don_vi":["phap-che"],"ghi_chu":"đơn vị chờ chốt (mục 28, số 7)"},{"viec":"Từ thiện, hỗ trợ người bệnh","don_vi":["ctxh"],"ghi_chu":"mục 17"},{"viec":"Giá dịch vụ; chuyên môn, phần y tế của khám cộng đồng; chuyển tuyến","don_vi":["ke-toan","khoa-phong","don-vi-chuyen-mon"],"ghi_chu":"mục 17"},{"viec":"Vật tư y tế khám cộng đồng","don_vi":["khoa-phong"],"ghi_chu":"QT.05.MKT chuyển ra (mục 18)"},{"viec":"Danh sách người hành nghề, danh mục dịch vụ, kỹ thuật được phép của cơ sở","don_vi":["don-vi-chuyen-mon"],"ghi_chu":"mục 17; mảng 43"}],"hanh_trinh_khach_hang":[{"ten":"Thu hút","chiu_trach_nhiem":["mkt-tct","mkt-coso"],"marketing_lam":"Kế hoạch, Hạng mục, nội dung, thiết kế, media, quảng cáo, kênh số, website, App TTH, báo chí, biển bảng, sự kiện, cộng đồng, đối tác địa phương; thông tin công khai của cơ sở trên website, App TTH (mảng 43); quan hệ với bác sĩ, phòng khám bên ngoài giới thiệu người bệnh (mảng 21)","don_vi_khac_lam":"Ban Giám đốc cơ sở duyệt ưu đãi, giá, ngân sách cơ sở; bác sĩ xác nhận chuyên môn","can_cu":"mục 31, mảng 1–16, 20–24"},{"ten":"Tiếp nhận từ xa","chiu_trach_nhiem":["cc"],"marketing_lam":"Marketing cung cấp thông tin chiến dịch/dịch vụ/ưu đãi đã duyệt, tiêu chí Lead hợp lệ và đầu mối với Contact Center (Chuyên viên đo lường và đối soát); không soạn hay duyệt kịch bản tư vấn","don_vi_khac_lam":"Mọi nguồn đa kênh: tổng đài 19002675, hotline di động của các cơ sở, tin nhắn trên mọi kênh (Facebook, Trang Zalo chính thức, TikTok, YouTube, Threads, website, App TTH), bình luận hỏi dịch vụ, email, form trên website, App TTH, trang đích","can_cu":"mục 17; mục 31, mảng 17"},{"ten":"Đặt lịch","chiu_trach_nhiem":["cc"],"marketing_lam":"Đặt lịch trên website, App TTH: Quản lý sản phẩm số (kỹ thuật: Phòng Số hóa). KPI-05 đặt lịch: Chuyên viên quảng cáo và kênh số, chỉ tiêu chung với Contact Center","don_vi_khac_lam":"Tư vấn, đặt lịch qua tổng đài, tin nhắn (KPI-18, KPI-19)","can_cu":"mục 9; mục 12.2"},{"ten":"Tiếp đón, khám","chiu_trach_nhiem":["tiep-don","khoa-phong"],"marketing_lam":"Marketing cơ sở kiểm tra nguồn khách tại quầy tiếp đón; truyền thông quyền lợi bảo hiểm, bảo lãnh viện phí (Quản lý thương hiệu của nhóm, mảng 45)","don_vi_khac_lam":"Bộ phận tiếp đón ghi nguồn khách; khoa phòng thực hiện dịch vụ","can_cu":"mục 31, mảng 32; mục 31, mảng 45"},{"ten":"Tin giao dịch","chiu_trach_nhiem":[],"chiu_trach_nhiem_ghi_chu":"Gửi tự động từ hệ thống; đơn vị vận hành chờ Ban Tổng Giám đốc chốt","marketing_lam":"Soạn mẫu nội dung","don_vi_khac_lam":"Xác nhận, nhắc lịch hẹn, báo đã có kết quả, nhắc tái khám theo chỉ định. Đề xuất: Phòng Số hóa vận hành kỹ thuật; Phòng Công nghệ – Nghiệp vụ Y kết nối HIS","can_cu":"mục 28, số 36","de_xuat":true},{"ten":"Chăm sóc, giữ chân","chiu_trach_nhiem":["qlth|của nhóm"],"marketing_lam":"Hạng mục chăm sóc khách hàng cũ; danh sách đã đồng ý (Chuyên viên dữ liệu khách hàng và thị trường); nội dung (Biên tập); gửi tin hàng loạt (Chuyên viên quảng cáo và kênh số của nhóm; lịch gửi chung: Chuyên viên dữ liệu khách hàng và thị trường); đo (Chuyên viên đo lường và đối soát)","don_vi_khac_lam":"Contact Center: gọi chăm sóc, trả lời tin khách gửi lại. Bộ phận tiếp đón: tiếp đón khách tái khám","can_cu":"mục 31, mảng 18"},{"ten":"Phản ánh, đánh giá","chiu_trach_nhiem":["xu-ly-phan-anh|nội dung phản ánh","cvtt|của nhóm, trả lời công khai"],"marketing_lam":"Trả lời đánh giá nhạy cảm; kịch bản trả lời (Chuyên viên truyền thông của nhóm); khủng hoảng truyền thông; NPS trên kênh số, điểm chạm sau khám (Chuyên viên dữ liệu khách hàng và thị trường, mảng 44); mạo danh trên mạng (Chuyên viên truyền thông của nhóm, QT.27)","don_vi_khac_lam":"Contact Center: đánh giá thông thường, chuyển phản ánh. Phòng Quản lý chất lượng: sự cố y khoa, khảo sát hài lòng người bệnh","can_cu":"mục 11.1, số 6; mục 31, mảng 19, 23; mục 31, mảng 42, 44"},{"ten":"Đo lường","chiu_trach_nhiem":["dl-1"],"marketing_lam":"Đối soát Lead – đặt lịch – khách – doanh thu được ghi nhận; KPI; báo cáo tuần, tháng, quý dựng tự động","don_vi_khac_lam":"Bộ phận tiếp đón (nguồn khách); kế toán (đối chiếu chi)","can_cu":"mục 31, mảng 32, 36"}],"lien_he_don_vi":[{"don_vi":["btgd"],"marketing_gui":"Kế hoạch, ngân sách Marketing năm (có xác nhận của Giám đốc từng cơ sở); Hạng mục dùng ngân sách Tổng công ty hoặc nhiều cơ sở; đề xuất định biên; báo cáo","don_vi_phu_trach":"Duyệt định biên, hạn mức năm, Hạng mục dùng ngân sách Tổng công ty; thông cáo khủng hoảng; ban hành ma trận thẩm quyền","marketing_nhan":"Quyết định. Yêu cầu của Ban Tổng Giám đốc do Trưởng phòng chuyển vào cổng tiếp nhận yêu cầu","can_cu":"mục 4.2; mục 14.10"},{"don_vi":["bgd-coso","khoa-phong"],"marketing_gui":"Kế hoạch Hạng mục, sản phẩm truyền thông, báo cáo kết quả của cơ sở","don_vi_phu_trach":"Duyệt nội dung kinh doanh và tiền của cơ sở: ngân sách cơ sở, ưu đãi, giá, khả năng tiếp nhận. Bác sĩ xác nhận chuyên môn. Chịu trách nhiệm tổng khách hàng, doanh thu của cơ sở","marketing_nhan":"Dịch vụ trọng tâm, nhu cầu tháng (qua Trưởng nhóm), chủ đề, bác sĩ, ý kiến đánh giá theo tuyến","can_cu":"mục 4.2; mục 14.13; mục 16, số 10"},{"don_vi":["cc"],"marketing_gui":"Thông tin dịch vụ, Hạng mục, ưu đãi đã duyệt để Contact Center tự soạn kịch bản tư vấn; tiêu chí Lead hợp lệ; kịch bản trả lời đánh giá; thông tin Hạng mục, ưu đãi đang triển khai; Kịch bản tư vấn bảo hiểm (mảng 45), kịch bản trả lời khi có kênh mạo danh (QT.27)","don_vi_phu_trach":"Tiếp nhận mọi nguồn đa kênh (tổng đài 19002675, hotline di động của các cơ sở, tin nhắn trên mọi kênh (Facebook, Trang Zalo chính thức, TikTok, YouTube, Threads, website, App TTH), bình luận hỏi dịch vụ, email, form trên website, App TTH, trang đích), đánh giá thông thường, chăm sóc Lead, gọi chăm sóc khách hàng cũ","marketing_nhan":"Lead đã xử lý, lịch hẹn; đánh giá nhạy cảm chuyển Chuyên viên truyền thông; báo cáo trực cuối ngày; báo cáo phản hồi khách hàng tháng","can_cu":"mục 17; mục 30; mục 31, mảng 17"},{"don_vi":["tiep-don"],"marketing_gui":"Nguồn khách theo Hạng mục, theo đợt gửi tin","don_vi_phu_trach":"Ghi nguồn khách khi khách đến; tiếp đón khách tái khám","marketing_nhan":"Số khách theo nguồn khách để đối soát","can_cu":"mục 31, mảng 18, 32"},{"don_vi":["xu-ly-phan-anh"],"marketing_gui":"Phản ánh nhận qua kênh số (Contact Center, Marketing cơ sở chuyển)","don_vi_phu_trach":"Giải quyết nội dung phản ánh; trả lời người phản ánh qua kênh riêng","marketing_nhan":"Kết quả giải quyết, làm đầu vào trả lời công khai","can_cu":"mục 11.1, số 6; mục 17"},{"don_vi":["so-hoa"],"marketing_gui":"Yêu cầu nghiệp vụ (Quản lý sản phẩm số là đầu mối duy nhất); bộ nhận diện số (Chuyên viên thiết kế của nhóm); yêu cầu nghiệp vụ, quy tắc dữ liệu, danh sách quyền theo vị trí của từng hệ thống (chủ nghiệp vụ, mục 17.2); phần nội dung của hồ sơ website, App TTH","don_vi_phu_trach":"Thiết kế giao diện, lập trình, vận hành kỹ thuật website, App TTH, website các chuỗi, mẫu trang đích, phần mềm Quản trị Marketing (02 phân hệ, mục 17.2); trỏ tên miền, cài chứng chỉ bảo mật trên website; hồ sơ pháp lý, thủ tục của website, App TTH (chủ trì, nộp; mảng 38); phần kỹ thuật của hệ thống phần mềm Marketing, trừ CRM, hộp thư dùng chung (mục 17.2): cài đặt, kết nối, chuyển dữ liệu, tạo tài khoản theo danh sách quyền, cài mã theo dõi, SEO kỹ thuật; kết nối HIS với website, App TTH cho lịch làm việc của bác sĩ (mục 28, số 50); kết nối form, trang đích trên website, App TTH với CRM","marketing_nhan":"Bản phát hành theo lịch định kỳ; lỗi xử lý theo 03 mức; KPI-41 chỉ tiêu chung","can_cu":"mục 11.1, số 5; mục 17"},{"don_vi":["cnnvy"],"marketing_gui":"Danh mục tên miền, yêu cầu hộp thư chức danh, quyền sổ theo dõi dùng chung; yêu cầu nghiệp vụ, quy tắc dữ liệu, danh sách quyền CRM (Chuyên viên dữ liệu khách hàng và thị trường)","don_vi_phu_trach":"Phần mềm phát màn hình, kho tư liệu; đăng ký, gia hạn, theo dõi hạn tên miền, chứng chỉ bảo mật (SSL); kết nối hệ thống; hồ sơ tên miền, chứng chỉ bảo mật cho hồ sơ website, App TTH (mảng 38); dữ liệu lịch làm việc của bác sĩ trên HIS (mục 28, số 50); kỹ thuật, kết nối CRM, hộp thư dùng chung (tổng đài 19002675, hotline di động, email, form, HIS), chuyển dữ liệu, tạo tài khoản theo danh sách quyền (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026)","marketing_nhan":"Hạ tầng, tài khoản, kết nối","can_cu":"mục 17; mục 28, số 21, 23"},{"don_vi":["nhan-luc","tuyen-dung"],"marketing_gui":"Định biên, mô tả vị trí, đầu vào lương thưởng; sản phẩm truyền thông tuyển dụng; dự thảo quy tắc ứng xử mạng xã hội","don_vi_phu_trach":"Chức danh, chế độ, lương thưởng, phương án sử dụng lao động; tuyển dụng; ban hành quy tắc ứng xử","marketing_nhan":"Nội dung tuyển dụng; quyết định nhân sự; báo nghỉ việc để thu hồi quyền kênh trong 48 giờ","can_cu":"mục 17; mục 14.7"},{"don_vi":["qlcl"],"marketing_gui":"Thông tin truyền thông khi có sự cố; Phản hồi trải nghiệm người bệnh trên kênh số, NPS (mảng 44)","don_vi_phu_trach":"Sự cố y khoa; khảo sát hài lòng người bệnh; cập nhật Sổ quy định","marketing_nhan":"Thông tin sự cố để xử lý truyền thông; Kết quả khảo sát hài lòng người bệnh theo quy định (mảng 44)","can_cu":"mục 17; mục 31, mảng 23"},{"don_vi":["phap-che"],"marketing_gui":"Sản phẩm rủi ro cao; hồ sơ thủ tục khi pháp luật yêu cầu; Bằng chứng mạo danh (QT.27); đề nghị xác nhận danh mục thông tin phải công khai, hình thức chăm sóc người giới thiệu (mục 28, số 46, 47)","don_vi_phu_trach":"Ý kiến pháp lý; đăng ký nhãn hiệu; bảo vệ dữ liệu cá nhân; nộp hồ sơ; thông báo thay đổi pháp luật quảng cáo y tế","marketing_nhan":"Ý kiến pháp lý; thông báo thay đổi để cập nhật danh sách kiểm tra; Đánh giá pháp lý, báo cơ quan chức năng khi mạo danh có dấu hiệu lừa đảo; danh mục thông tin phải công khai","can_cu":"mục 17; mục 11.2"},{"don_vi":["hcqt"],"marketing_gui":"Đề nghị sửa chữa biển bảng, thiết bị màn hình","don_vi_phu_trach":"Bản tin nội bộ, chủ trương; lắp đặt, bảo trì thiết bị màn hình; sửa chữa vật lý biển bảng","marketing_nhan":"Thiết bị, biển bảng được sửa chữa","can_cu":"mục 17; mục 28, số 8"},{"don_vi":["ke-toan","mua-sam"],"marketing_gui":"Tờ trình, hồ sơ khoản chi theo Hạng mục","don_vi_phu_trach":"Giá dịch vụ; đối chiếu chi; mua sắm theo quy định (Phòng Tài chính – Kế hoạch chủ trì); Giá dịch vụ để công khai trên website, App TTH (mảng 43)","marketing_nhan":"Xác nhận chi, số đối chiếu tổng chi","can_cu":"mục 31, mảng 30, 36"},{"don_vi":["winmed"],"marketing_gui":"Kế hoạch, sản phẩm truyền thông, quảng cáo (nhóm 2)","don_vi_phu_trach":"Cử đầu mối; gửi nhu cầu qua cổng tiếp nhận yêu cầu; xác nhận thông tin sản phẩm, dịch vụ; không triển khai quảng cáo song song","marketing_nhan":"Nhu cầu ngày 20–25; thông tin sản phẩm","can_cu":"mục 11.1, số 4; mục 17; mục 28, số 13"},{"don_vi":["ctxh"],"marketing_gui":"Ấn phẩm giáo dục sức khỏe; truyền thông hoạt động","don_vi_phu_trach":"Từ thiện, hỗ trợ người bệnh; phát ấn phẩm giáo dục sức khỏe (chờ văn bản)","marketing_nhan":"Thông tin hoạt động","can_cu":"mục 17; mục 28, số 10"},{"don_vi":["tue-duc-thien"],"marketing_gui":"Kế hoạch, sản phẩm truyền thông, quảng cáo, hồ sơ năng lực (nhóm 2)","don_vi_phu_trach":"Công ty xây dựng trong Tập đoàn. Cử đầu mối; gửi nhu cầu qua cổng tiếp nhận yêu cầu; xác nhận thông tin công trình, dịch vụ; trả lời tin nhắn trên kênh của công ty; không triển khai quảng cáo song song","marketing_nhan":"Nhu cầu ngày 20–25; thông tin công trình, dịch vụ","can_cu":"mục 3; mục 11.1, số 4; mục 17; mục 28, số 39"},{"don_vi":["don-vi-chuyen-mon"],"marketing_gui":"Đề xuất chương trình trọng điểm; danh sách bài nội dung y khoa cần xác nhận lại","don_vi_phu_trach":"Nội dung chuyên môn của chương trình áp dụng từ 02 cơ sở; chuyển tuyến; danh sách người hành nghề, danh mục dịch vụ, kỹ thuật được phép của cơ sở","marketing_nhan":"Nội dung chuyên môn đã duyệt; danh mục được phép làm căn cứ công khai, kiểm tra trước khi quảng cáo","can_cu":"mục 17; mục 31, mảng 3, 21, 43; mục 28, số 46"}],"contact_center":{"gioi_thieu":"Contact Center là cổng tiếp nhận yêu cầu từ xa tập trung toàn hệ thống cho mọi nguồn đa kênh: tổng đài 19002675, hotline di động của các cơ sở, tin nhắn trên mọi kênh (Facebook, Trang Zalo chính thức, TikTok, YouTube, Threads, website, App TTH), bình luận hỏi dịch vụ, email, form trên website, App TTH, trang đích (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026); mọi nguồn về một hộp thư dùng chung, CRM khi có, gắn nguồn khách. Không phải bộ phận chăm sóc khách hàng tại cơ sở. Đơn vị chủ quản, thời điểm vận hành: Ban Tổng Giám đốc quyết định (mục 28, số 11). Kế hoạch hoạt động năm 2026 giao Phòng Marketing chủ trì xây dựng hệ thống Hotline 1900. Contact Center là bộ phận nghiệp vụ ngoài Marketing, giữ một bộ kịch bản thống nhất cho toàn hệ thống với các biến thể đã kiểm soát theo cơ sở, dịch vụ và chương trình.","marketing_giao":["Thông tin về thông điệp, tên dịch vụ, chương trình, ưu đãi và nội dung quảng cáo đã được phê duyệt; Marketing không biên soạn, quản lý hoặc phê duyệt kịch bản tư vấn nghiệp vụ","Tiêu chí Lead hợp lệ và yêu cầu đo lường nguồn khách do Chuyên viên đo lường và đối soát bàn giao","Mẫu phản hồi đánh giá công khai về thương hiệu do Chuyên viên truyền thông đúng nhóm chủ trì; khác với kịch bản tư vấn nghiệp vụ do Contact Center chủ trì","Thông điệp và điều kiện chương trình đã được phê duyệt, có mã phiên bản, ngày hiệu lực và đầu mối giải đáp","Lead từ quảng cáo, trang đích và kênh số, có nguồn khách và căn cứ xử lý dữ liệu hợp pháp","Phản hồi từ cơ sở về những câu hỏi khách hàng thường gặp để Contact Center tổng hợp, cập nhật kịch bản"],"contact_center_lam":["Tiếp nhận theo ca mọi nguồn đa kênh: tổng đài 19002675, hotline di động của các cơ sở, tin nhắn trên mọi kênh (Facebook, Trang Zalo chính thức, TikTok, YouTube, Threads, website, App TTH), bình luận hỏi dịch vụ, email, form trên website, App TTH, trang đích","Lọc Lead hợp lệ, tư vấn, đặt lịch","Chăm sóc Lead; gọi chăm sóc khách hàng cũ","Trả lời tin khách gửi lại sau đợt gửi tin","Trả lời đánh giá thông thường theo kịch bản","Báo cáo trực cuối ngày; báo cáo phản hồi khách hàng tháng","Tư vấn quyền lợi bảo hiểm, bảo lãnh viện phí theo kịch bản (mảng 45)","Hướng dẫn khách khi gặp kênh mạo danh; báo Chuyên viên truyền thông của nhóm có thương hiệu bị mạo danh (QT.27)","Gọi khảo sát trải nghiệm người bệnh khi vận hành (mảng 44)","Chủ trì viết, chuẩn hóa, quản lý phiên bản, đào tạo và kiểm soát chất lượng kịch bản tư vấn; chỉ sử dụng thông tin dịch vụ, gói khám, giá và điều kiện đã được cơ sở/chuyên môn xác nhận","Quản lý kho tri thức nghiệp vụ thống nhất: dịch vụ/gói, giá, điều kiện, lịch tiếp nhận, câu hỏi thường gặp; gắn từng phiên bản với cơ sở áp dụng, ngày hiệu lực, người xác nhận và người phê duyệt"],"chuyen_tiep":["Lịch hẹn → bộ phận tiếp đón của cơ sở","Phản ánh → bộ phận tiếp nhận, xử lý phản ánh của cơ sở","Đánh giá nhạy cảm → Chuyên viên truyền thông của nhóm","Dấu hiệu khủng hoảng → lịch trực sự cố","Số liệu Lead, đặt lịch → Chuyên viên đo lường và đối soát"],"khong_lam":["Giải quyết nội dung phản ánh: bộ phận tiếp nhận, xử lý phản ánh của cơ sở","Trả lời đánh giá nhạy cảm, khủng hoảng: Chuyên viên truyền thông của nhóm","Gửi tin hàng loạt, gửi tự động: Chuyên viên quảng cáo và kênh số của nhóm, theo lịch gửi chung của Chuyên viên dữ liệu khách hàng và thị trường","Tiếp đón, hướng dẫn tại cơ sở: theo cơ cấu của cơ sở","Tin nhắn trên kênh của Công ty TNHH Tuệ Đức Thiện: đầu mối của công ty trả lời","Không tự xác nhận hoặc thay đổi chỉ định y khoa, giá, điều kiện gói dịch vụ, quyền lợi bảo hiểm, lịch bác sĩ; khi không chắc chắn phải chuyển người phụ trách chuyên môn/cơ sở","Không dùng kịch bản khi thiếu xác nhận nguồn hoặc thiếu phê duyệt nghiệp vụ; không biến kịch bản tư vấn thành nội dung quảng cáo chưa được kiểm soát"],"kpi":[{"kpi":"KPI-18","chiu_trach_nhiem":"Contact Center"},{"kpi":"KPI-19","chiu_trach_nhiem":"Contact Center; phần gửi tự động, gửi tin hàng loạt: Chuyên viên quảng cáo và kênh số của nhóm"},{"kpi":"KPI-05","chiu_trach_nhiem":"Chuyên viên quảng cáo và kênh số của nhóm; chỉ tiêu chung với Contact Center"},{"kpi":"KPI-15","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm; dữ liệu: Chuyên viên dữ liệu khách hàng và thị trường"},{"kpi":"KPI-16","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm; dữ liệu: Chuyên viên dữ liệu khách hàng và thị trường"},{"kpi":"KPI-17","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm; dữ liệu: Chuyên viên dữ liệu khách hàng và thị trường"},{"kpi":"KPI-20","chiu_trach_nhiem":"Chờ chốt với Phòng Quản lý chất lượng"},{"kpi":"KPI-21","chiu_trach_nhiem":"Chờ chốt với Phòng Quản lý chất lượng"}],"kpi_can_cu":"mục 9; mục 12.2","khi_chua_co":["Hiện nay (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026): Bệnh viện Răng hàm mặt và Phẫu thuật tạo hình thẩm mỹ Thái Thượng Hoàng có trả lời tự động bằng trí tuệ nhân tạo; Bệnh viện Đa khoa TTH Vinh, Bệnh viện Y học cổ truyền Nguyên Phúc, Bệnh viện Đa khoa TTH Hà Tĩnh, Bệnh viện Đa khoa TTH Quảng Bình: nhân viên tư vấn hoặc Phát triển dịch vụ của bệnh viện kiêm nhiệm; không thuộc định biên Marketing","Trước khi Contact Center nhận: người đang trả lời tin nhắn tại cơ sở giữ việc. Khi quyền kênh chuyển về Tổng công ty (Giai đoạn 2), người này được cấp quyền chỉ trả lời tin nhắn trên hộp thư dùng chung; không đăng bài, không sửa trang; Lead ghi vào hộp thư dùng chung, gắn nguồn khách (Đề xuất – chờ duyệt)","Hộp thư của từng cơ sở chuyển Contact Center khi Contact Center nhận. Contact Center là điều kiện chuyển hộp thư, không là điều kiện của Giai đoạn 2","Cơ sở mới chưa có người trả lời tin nhắn: Ban Giám đốc cơ sở bố trí người (bộ phận tư vấn hoặc Phát triển dịch vụ) từ trước khai trương đến khi Contact Center nhận (Đề xuất – chờ duyệt; QT.9)","Hotline di động của cơ sở giữ người đang trực tại cơ sở; Lead ghi vào hộp thư dùng chung, gắn nguồn khách (Đề xuất – chờ duyệt)","Kênh cấp hệ thống, kênh của Công ty Cổ phần Winmed Việt Nam: người đang trả lời hiện nay giữ việc theo cùng quy tắc","Gọi chăm sóc khách hàng cũ tạm chưa thực hiện; tin chăm sóc tự động cho khách đã đồng ý vẫn gửi","Thí điểm Giai đoạn 1 tại bệnh viện thí điểm: hộp thư dùng chung, nguồn khách, sổ Lead; đo lượng tin nhắn, cuộc gọi theo giờ","Đầu mối phía Marketing: Chuyên viên đo lường và đối soát nhận số liệu tin nhắn, Lead, đặt lịch theo nguồn khách; Phòng Marketing không lập lịch ca, không quản lý người trả lời tin nhắn","Định biên, giờ trực, nguồn người của Contact Center: tham mưu ở mục 17.3; đơn vị chủ quản quyết định (mục 28, số 11, 33)"],"khi_chua_co_can_cu":"mục 17; mục 28, số 11, 33, 44","khi_chua_co_de_xuat":true,"crm":["Chủ trì dự án: Trưởng phòng Marketing","Chủ nghiệp vụ dữ liệu khách hàng: Chuyên viên dữ liệu khách hàng và thị trường","Đầu mối Contact Center: Chuyên viên đo lường và đối soát","Đầu mối yêu cầu, nghiệm thu với Phòng Công nghệ – Nghiệp vụ Y: Chuyên viên dữ liệu khách hàng và thị trường; kết nối form, trang đích trên website, App TTH: Quản lý sản phẩm số với Phòng Số hóa","Kỹ thuật, kết nối (tổng đài 19002675, hotline di động, email, form, HIS): Phòng Công nghệ – Nghiệp vụ Y (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026)","Lộ trình, quyền, dữ liệu, quy tắc chặn R1–R7: mục 17.1 (Đề xuất – chờ duyệt); quy trình mẫu: QT.25"],"crm_can_cu":"mục 11.1, số 37; mục 17.1","crm_de_xuat":false,"con_thieu":["Đơn vị chủ quản, thời điểm vận hành (Ban Tổng Giám đốc)","Lượng tin nhắn, cuộc gọi theo giờ, theo ca để tính số người trực (đo ở thí điểm Giai đoạn 1)","Mốc thời hạn phản hồi chuẩn làm căn cứ KPI-18; khung giờ trực, xử lý ngoài giờ","Thời hạn chuyển phản ánh cho cơ sở và thời hạn cơ sở báo lại kết quả","Danh sách kênh đưa về hộp thư dùng chung (Phòng Marketing lập)","Nền tảng CRM; quy tắc đồng ý, lưu trữ dữ liệu khách hàng","Nền tảng CRM, ngân sách (Ban Tổng Giám đốc, mục 28, số 45)"],"dinh_bien":[{"buoc":"1. Mở đầu","thoi_diem":"Cùng thí điểm Giai đoạn 1 (Quý I/2027)","pham_vi":"Bệnh viện thí điểm","cho_truc":"01 chỗ trực ghép cuộc gọi, tin nhắn","gio_thang":487,"so_nguoi":4,"cach_tinh":"487 ÷ 142 = 3,43; 01 người kiêm Trưởng nhóm Contact Center"},{"buoc":"2. Toàn hệ thống","thoi_diem":"Trước đợt chuyển hộp thư của Giai đoạn 2 (Quý II/2027)","pham_vi":"05 bệnh viện, 02 phòng khám, kênh cấp hệ thống, kênh của Công ty Cổ phần Winmed Việt Nam","cho_truc":"02 chỗ trực (cuộc gọi; tin nhắn, bình luận, email, form); Trưởng nhóm Contact Center giờ hành chính","gio_thang":1116,"so_nguoi":8,"cach_tinh":"974 ÷ 142 = 6,86 → 07; Trưởng nhóm 01"},{"buoc":"3. Gọi chăm sóc","thoi_diem":"Khi bắt đầu gọi chăm sóc khách hàng cũ, gọi khảo sát","pham_vi":"Như bước 2","cho_truc":"+01 người gọi ra trong giờ hành chính","gio_thang":1258,"so_nguoi":9,"cach_tinh":"+142 giờ"},{"buoc":"4. Mở rộng","thoi_diem":"Cơ sở mới hoặc khi số đo vượt ngưỡng","pham_vi":"Theo cơ sở mới","cho_truc":"+01 chỗ trực","gio_thang":null,"so_nguoi":null,"cach_tinh":"+487 giờ/chỗ trực; mức tham chiếu khi đủ 10 bệnh viện: 03 chỗ trực, 13 người"}],"dinh_bien_can_cu":"mục 17.3; mục 6; QyĐ.02.MKT phiên bản 3.0, mục 5.5.2","dinh_bien_de_xuat":true,"ghi_chu_phan_quyen":"Contact Center chủ trì biên soạn, bảo trì, đào tạo và vận hành kịch bản tư vấn (ngoài định biên Marketing). Bộ phận quản lý dịch vụ/tiếp đón tại cơ sở lập bản thông tin đầu vào, tình huống thực tế và phương án trả lời; bác sĩ/chuyên môn xác nhận phần y tế; bộ phận có thẩm quyền xác nhận giá, ưu đãi, điều kiện và khả năng tiếp nhận. Marketing cung cấp thông điệp hoặc nội dung chiến dịch đã duyệt, kiểm tra ngôn ngữ thương hiệu khi liên quan. Người được phân quyền ở đơn vị chủ quản Contact Center phê duyệt kịch bản nghiệp vụ sau khi có các xác nhận bắt buộc; Marketing không tự động có quyền duyệt kịch bản nghiệp vụ. Trước khi Contact Center tiếp nhận, bộ phận tư vấn được cơ sở phân công giữ nhiệm vụ dưới quản lý của cơ sở.","quy_trinh_quan_ly_kich_ban_18112026":[{"buoc":1,"ten":"Cơ sở cung cấp dữ liệu","chu_tri":"Bộ phận quản lý dịch vụ/tiếp đón tại cơ sở","dau_ra":"Phiếu thông tin gói, giá, điều kiện, câu hỏi thường gặp, nguồn chứng cứ và người phụ trách"},{"buoc":2,"ten":"Xác nhận nguồn nghiệp vụ","chu_tri":"Bộ phận chuyên môn, đơn vị quản lý giá/dịch vụ có thẩm quyền","dau_ra":"Xác nhận chuyên môn, thông tin giá, bảo hiểm, lịch, giới hạn tư vấn và ngày hiệu lực"},{"buoc":3,"ten":"Biên soạn kịch bản","chu_tri":"Contact Center","dau_ra":"Kịch bản gốc tập trung và nhánh theo dịch vụ, cơ sở, tình huống; có quy tắc chuyển tuyến"},{"buoc":4,"ten":"Kiểm tra thông điệp khi cần","chu_tri":"Marketing đúng nhóm thương hiệu","dau_ra":"Đối chiếu thông điệp/chương trình đã duyệt; không thay quyền xác nhận chuyên môn"},{"buoc":5,"ten":"Phê duyệt và phát hành","chu_tri":"Người có thẩm quyền thuộc đơn vị chủ quản Contact Center","dau_ra":"Mã phiên bản, lịch hiệu lực, phạm vi áp dụng, nhật ký duyệt, hướng dẫn sử dụng"},{"buoc":6,"ten":"Đánh giá và cập nhật","chu_tri":"Contact Center","dau_ra":"Theo dõi lỗi tư vấn, thay đổi gói/giá/lịch, phản hồi cơ sở, thu hồi phiên bản cũ"}],"quy_tac_chan_kich_ban_18112026":["Thiếu dữ liệu hoặc chứng cứ nguồn: không được tự viết thành cam kết tư vấn.","Thiếu xác nhận y khoa/giá/điều kiện tương ứng: khóa nội dung đó, chuyển cơ sở xác minh.","Thiếu phê duyệt nghiệp vụ hoặc hết hiệu lực: không phát hành, không dùng bản cũ.","Khách hỏi chẩn đoán, chỉ định, kết quả điều trị: chuyển nhân sự y tế phù hợp.","Trước khi thực hiện cuộc gọi quảng bá, kiểm tra điều kiện pháp lý về quảng cáo, dữ liệu và sự đồng ý liên quan."],"bo_kich_ban_dich_vu":[{"ma":"KB-DV01","nhom":"Dịch vụ khám chuyên khoa / khám lần đầu","du_lieu_dau_vao":"Tên dịch vụ, khoa, bác sĩ/khung giờ, địa điểm, yêu cầu đăng ký, mức giá đã xác nhận","quy_tac_chan":"Chỉ giới thiệu phạm vi công bố; không tư vấn thay bác sĩ"},{"ma":"KB-DV02","nhom":"Gói khám sức khỏe và tầm soát","du_lieu_dau_vao":"Danh mục hạng mục, đối tượng/điều kiện, chuẩn bị, giá và thời hạn gói","quy_tac_chan":"Không cam kết phát hiện bệnh hoặc thay đổi danh mục khi chưa xác nhận"},{"ma":"KB-DV03","nhom":"Khám và chăm sóc Nhi","du_lieu_dau_vao":"Độ tuổi tiếp nhận, lịch khám, bác sĩ, giới hạn phục vụ, thời điểm chuyển tuyến","quy_tac_chan":"Dấu hiệu nguy cấp phải chuyển hướng xử trí khẩn, không tiếp tục chốt lịch thông thường"},{"ma":"KB-DV04","nhom":"Sản – phụ khoa, hỗ trợ sinh sản/IVF","du_lieu_dau_vao":"Phạm vi dịch vụ đã được phép, lịch tư vấn, chi phí theo các khoản công khai, hồ sơ cần chuẩn bị","quy_tac_chan":"Không cam kết tỷ lệ thành công, không suy đoán chỉ định hoặc điều kiện phù hợp"},{"ma":"KB-DV05","nhom":"Ung bướu và dịch vụ điều trị chuyên sâu","du_lieu_dau_vao":"Khoa tiếp nhận, bác sĩ, hồ sơ thăm khám, thời gian, quy trình chuyển chuyên môn","quy_tac_chan":"Không cam kết phác đồ, đáp ứng điều trị hoặc kết quả lâm sàng"},{"ma":"KB-DV06","nhom":"Y học cổ truyền – Nguyên Phúc","du_lieu_dau_vao":"Danh mục khám, kỹ thuật được phép công bố, chuẩn bị, đặt lịch, phạm vi áp dụng","quy_tac_chan":"Không tự chỉ định kỹ thuật, không nói thay bác sĩ về hiệu quả"},{"ma":"KB-DV07","nhom":"Răng hàm mặt và phẫu thuật tạo hình – Thái Thượng Hoàng","du_lieu_dau_vao":"Dịch vụ, quy trình thăm khám trước thực hiện, điều kiện, lịch, giá theo niêm yết","quy_tac_chan":"Không khẳng định người bệnh phù hợp điều trị hoặc hứa hẹn kết quả thẩm mỹ"},{"ma":"KB-DV08","nhom":"Dịch vụ cận lâm sàng / chẩn đoán hình ảnh","du_lieu_dau_vao":"Yêu cầu chỉ định khi có, chuẩn bị, đơn vị thực hiện, lịch, thời gian trả kết quả dự kiến","quy_tac_chan":"Không giải thích kết quả hoặc quyết định thay nhân viên chuyên môn"},{"ma":"KB-DV09","nhom":"Chương trình ưu đãi hoặc gói dịch vụ có thời hạn","du_lieu_dau_vao":"Mã chương trình, đối tượng, điều kiện, mức ưu đãi, thời gian, cơ sở áp dụng","quy_tac_chan":"Hết hạn hoặc chưa được phê duyệt thì chặn dùng và trả về chủ chương trình"},{"ma":"KB-DV10","nhom":"Bảo hiểm y tế / bảo lãnh viện phí","du_lieu_dau_vao":"Loại hình, thủ tục, giấy tờ, điều kiện thanh toán được đầu mối bảo hiểm xác nhận","quy_tac_chan":"Không cam kết được thanh toán trước khi xác minh quyền lợi cụ thể"},{"ma":"KB-DV11","nhom":"Dịch vụ tạm ngừng, đổi giá hoặc đổi lịch","du_lieu_dau_vao":"Phiên bản thay đổi, ngày hiệu lực, phạm vi ngừng/đổi, phương án thay thế được xác nhận","quy_tac_chan":"Ngừng dùng kịch bản cũ ngay khi thay đổi có hiệu lực; không báo giá cũ"},{"ma":"KB-DV12","nhom":"Chuyển bác sĩ / khiếu nại / tình huống vượt thẩm quyền","du_lieu_dau_vao":"Tình huống, đầu mối tiếp nhận, thời hạn chuyển và mã hồ sơ","quy_tac_chan":"Không tự chẩn đoán, kê đơn, xử lý khiếu nại hay hứa hẹn thay cấp có thẩm quyền"}],"truong_bat_buoc_kich_ban_dich_vu":["Mã kịch bản và mã phiên bản; loại dịch vụ/gói; thương hiệu, mã cơ sở, chuyên khoa và phạm vi áp dụng","Mã dịch vụ/mã gói hoặc bảng ánh xạ danh mục dịch vụ chuẩn; tên hiển thị đã được xác nhận","Nguồn xác nhận y tế và đầu mối bác sĩ/chuyên khoa; nguồn xác nhận điều kiện, giá, lịch, năng lực tiếp nhận","Mục đích cuộc gọi; lời chào; câu hỏi xác định nhu cầu không xâm phạm thông tin ngoài mục đích hợp pháp","Cây hội thoại theo nhánh: hỏi thông tin – đặt lịch – thông tin chưa đủ – đổi lịch – chuyển chuyên môn – từ chối/không phù hợp","Nội dung cấm hứa hẹn/chẩn đoán/chỉ định; dấu hiệu buộc chuyển tuyến khẩn/chuyên môn","Nguồn, mã chiến dịch và điều kiện ưu đãi đã phê duyệt nếu có; không dùng bản quảng cáo chưa phê duyệt","Mã lượt tiếp nhận, trạng thái, thời hạn xử lý/chuyển người phụ trách; căn cứ pháp lý về xử lý dữ liệu cá nhân","Người soạn, người xác nhận chuyên môn, người xác nhận giá/điều kiện, người kiểm nội dung Marketing nếu liên quan, người có quyền duyệt phát hành","Ngày duyệt, ngày bắt đầu/kết thúc hiệu lực, thời hạn rà soát, lịch sử phiên bản, đường dẫn minh chứng và biên bản kiểm thử"],"quy_trinh_kich_ban_dich_vu_7_buoc":["1. Đơn vị chủ quản dịch vụ tại cơ sở cung cấp phiếu dữ liệu dịch vụ và các nhánh tình huống; không giao cho Marketing tự tổng hợp bằng phỏng đoán","2. Bác sĩ/đơn vị chuyên môn xác nhận giới hạn y tế; bộ phận dịch vụ và kế toán/tài chính xác nhận giá, điều kiện và lịch; đầu mối bảo hiểm xác nhận phần bảo hiểm nếu có","3. Contact Center chủ biên một kịch bản gốc và các biến thể gắn mã cơ sở/dịch vụ/gói; đánh dấu mọi nội dung không được khẳng định","4. Marketing chỉ xác nhận thông điệp/chương trình thuộc phạm vi mình đã được cấp quyền; nếu không có nội dung Marketing thì không tạo vòng duyệt Marketing hình thức","5. Kiểm thử theo tình huống chuẩn, ngoại lệ, dịch vụ dừng, cơ sở hết lịch, giá đổi, khách không đủ thông tin, dấu hiệu cần tư vấn y khoa; lưu kết quả đạt/chưa đạt","6. Người có thẩm quyền thuộc đơn vị chủ quản Contact Center duyệt phát hành sau khi đủ xác nhận; không tự duyệt kịch bản mình viết","7. Công bố bản hiệu lực trên kho tri thức/CRM; đào tạo, thu hồi bản cũ, ghi nhận lỗi và cập nhật theo sự kiện thay đổi"],"kiem_soat_kich_ban_dich_vu":"Một mã dịch vụ có thể có nhiều nhánh theo cơ sở nhưng chỉ một nguồn dữ liệu chuẩn và phiên bản hiệu lực tại mỗi cơ sở. Không đủ chữ ký xác nhận, thông tin hết hiệu lực, thiếu người duyệt, mã dịch vụ không khớp, hoặc dữ liệu cá nhân không đủ cơ sở xử lý thì khóa sử dụng kịch bản. Contact Center quản lý nội dung tư vấn; Marketing quản lý nội dung truyền thông/chiến dịch; cơ sở xác nhận nghiệp vụ, không phát hành kịch bản riêng.","phan_loai_kich_ban":"Kịch bản dịch vụ Contact Center = hỏi đáp, xác định nhu cầu, giới thiệu thông tin dịch vụ hợp lệ, hướng dẫn đặt lịch và chuyển tuyến. Kịch bản Marketing = nội dung bài, video, quảng cáo, phát thanh hoặc sự kiện; người biên tập và phê duyệt khác theo ma trận. Hai loại không dùng chung tuyến duyệt.","phan_cong_ban_hanh_kich_ban":"Contact Center soạn kịch bản theo từng dịch vụ, người có thẩm quyền thuộc đơn vị chủ quản nghiệp vụ phê duyệt sau khi có xác nhận của cơ sở/chuyên môn. Marketing kiểm đúng phần thông điệp marketing nếu có, không duyệt thay nghiệp vụ y tế hoặc toàn bộ kịch bản.","ho_so_kiem_thu_kich_ban":["Mã dịch vụ và mã cơ sở đúng, bản hiệu lực","Giá, lịch và điều kiện dịch vụ có xác nhận nguồn","Kịch bản hỏi thông tin có cơ sở xử lý dữ liệu hợp pháp","Dấu hiệu cấp cứu/chuyên môn vượt thẩm quyền được chuyển tuyến","Tình huống hết lịch, đổi giá, dịch vụ tạm dừng, khách không đồng ý lưu dữ liệu","Người thực hiện kiểm thử, người xác nhận, người duyệt, thời hạn cập nhật","Lịch sử phát hành và cơ chế thu hồi bản cũ"]},"quy_trinh":[{"id":"hang-muc","ten":"Hạng mục trọng điểm","nhom_hoat_dong":["N1","N2","N8","N3","N4","N9","N10"],"vi_du":"Bệnh viện Đa khoa TTH Vinh triển khai gói khám sức khỏe doanh nghiệp trong Quý I. Nhóm 1: Quản lý thương hiệu nhóm 1 chịu trách nhiệm kết quả.","buoc":[{"thuc_hien":["tn-a"],"phoi_hop":["bgd-coso"],"noi_dung":"Thống nhất nhu cầu với Ban Giám đốc bệnh viện (dịch vụ, đối tượng, ưu đãi dự kiến, khả năng tiếp nhận), gửi nhu cầu tháng.","thoi_han":"Ngày 10–15","ghi_nhan":"Phần mềm: nhu cầu tháng","can_cu":"mục 16, số 12","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Trang tính nhu cầu tháng","chu_tri_chinh":"tn-a","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Phần mềm: nhu cầu tháng","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qlth-a"],"phoi_hop":["dl-1","qc-a"],"noi_dung":"Lập Hạng mục: mục tiêu chiến lược chính MT1; chỉ tiêu KPI-01 (khách), KPI-04 (Lead hợp lệ); hạn mức chi; danh sách Hoạt động. Chuyên viên đo lường và đối soát ghi cách đo, nguồn khách; Chuyên viên quảng cáo và kênh số nhóm 1 ghi yêu cầu kênh.","thoi_han":"Trình chậm nhất ngày 18, cùng kế hoạch tháng (BM-3)","ghi_nhan":"Phần mềm: Hạng mục","can_cu":"mục 13; mục 14.5","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung","chu_tri_chinh":"qlth-a","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Phần mềm: Hạng mục","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["tp","gd-coso"],"phoi_hop":["btgd|chi mới ngoài hạn mức: Tổng Giám đốc","ptgd-tc|chi trong hạn mức đã duyệt"],"noi_dung":"Giám đốc bệnh viện xác nhận mức chi dự kiến từ bước đề xuất. Trưởng phòng duyệt kế hoạch Hạng mục; Giám đốc bệnh viện ký tờ trình chi. Hạng mục dùng ngân sách Tổng công ty hoặc nhiều cơ sở: chi trong hạn mức đã duyệt – Phó Tổng Giám đốc mảng tài chính; chi mới ngoài hạn mức – Tổng Giám đốc (R28).","thoi_han":"Duyệt chậm nhất ngày 20","ghi_nhan":"Tờ trình trên phần mềm","can_cu":"mục 4.2; mục 16, số 9","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục","chu_tri_chinh":"tp","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Tờ trình trên phần mềm","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qlth-a"],"phoi_hop":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"noi_dung":"Quản lý thương hiệu nhóm 1 gửi yêu cầu sản xuất qua cổng tiếp nhận (kết quả cần đạt, thông điệp, đối tượng, hạn). Đủ ô bắt buộc thì tự xác nhận, giao theo bảng phân công; yêu cầu cần Tổ trưởng xử lý (thiếu nội dung, gấp, vượt công suất, ngoài bộ): Tổ trưởng xử lý trong 04 giờ làm việc; người làm theo người phụ trách nhóm 1: Chuyên viên biên tập nhóm 1, Chuyên viên thiết kế nhóm 1, Chuyên viên media nhóm 1.","thoi_han":"Tự xác nhận khi đủ ô; yêu cầu cần Tổ trưởng xử lý 04 giờ làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu; sổ theo dõi yêu cầu","can_cu":"mục 14.5; mục 16, số 14","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"qlth-a","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Cổng tiếp nhận yêu cầu; sổ theo dõi yêu cầu","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["mdcs-a"],"phoi_hop":["khoa-phong"],"noi_dung":"Ghi hình, chụp ảnh bác sĩ và quy trình khám tại bệnh viện theo kịch bản; đưa tư liệu lên kho tư liệu.","thoi_han":"Trong ngày","ghi_nhan":"kho tư liệu","can_cu":"mục 15.3; QyĐ.04.MKT; mục 31, mảng 9","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)","chu_tri_chinh":"mdcs-a","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: kho tư liệu","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_nguoi_xac_nhan_chuyen_mon":true,"can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["bt-ac","tk-a","md-ac"],"phoi_hop":["bac-si|xác nhận chuyên môn","bt-ac|người còn lại trong nhóm – kiểm pháp lý tầng 1","tk-nt|xác nhận kỹ thuật file in; biển bảng, phương tiện quảng cáo cố định nếu Hạng mục có","qlth-a|nghiệm thu nội dung chữ trước khi gửi thiết kế"],"noi_dung":"Chuyên viên biên tập nhóm 1 viết bài, kịch bản; bác sĩ xác nhận chuyên môn; Chuyên viên biên tập nhóm 1 còn lại kiểm pháp lý tầng 1 theo danh sách kiểm tra. Quản lý thương hiệu nhóm 1 nghiệm thu nội dung chữ trước khi gửi thiết kế (yêu cầu hợp lệ phải có nội dung đã duyệt, mục 14.6). Chuyên viên thiết kế nhóm 1 làm hình ảnh chủ đạo và mọi sản phẩm của Hạng mục, cả bản số và bản in (tờ rơi, băng rôn, standee); file in qua Chuyên viên thiết kế ngoại tuyến xác nhận kỹ thuật (mục 15.2). Chuyên viên media nhóm 1 dựng video từ tư liệu trong kho tư liệu.","thoi_han":"Bài kiến thức 03 ngày làm việc; thiết kế cấp 3–4: 05–10 ngày làm việc; video chiến dịch 07 ngày làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.7; mục 15.2; mục 15.6","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"bt-ac","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Sổ theo dõi yêu cầu","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_nguoi_xac_nhan_chuyen_mon":true,"can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qlth-a"],"phoi_hop":["tp|nội dung thuộc QyĐ.03.MKT mục 5.2"],"noi_dung":"Quản lý thương hiệu nhóm 1 nghiệm thu đúng yêu cầu, tối đa 02 vòng chỉnh sửa. Phần mềm chặn phát hành khi thiếu bước (chất lượng, pháp lý, bác sĩ xác nhận, nghiệm thu); chưa có phần mềm: người đăng kiểm cột các bước trên sổ yêu cầu.","thoi_han":"Theo lịch đã xếp","ghi_nhan":"Sổ theo dõi: số vòng chỉnh sửa","can_cu":"mục 14.5","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"qlth-a","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Sổ theo dõi: số vòng chỉnh sửa","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_nguoi_xac_nhan_chuyen_mon":true,"can_duyet_phat_hanh":true,"quy_tac_duyet":"Phải tìm được quyết định phân quyền phát hành theo loại sản phẩm/kênh/nhóm; kiểm chứng xác nhận y tế, hình ảnh/đồng ý, bản quyền và ngân sách nếu liên quan; người thực hiện không tự duyệt","duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nộ