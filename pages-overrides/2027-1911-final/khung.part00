<!DOCTYPE html>

<html lang="vi"><head><meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/><title>TTH Group · Khung cơ cấu Marketing 2027 · 02 Chuyên viên trưởng</title><meta content="#0837A1" name="theme-color"/><meta content="light" name="color-scheme"/>
<style>:root{--blue:#0837A1;--deep:#083B6C;--dark:#082F56;--red:#ED3237;--ink:#172B4D;--muted:#58708B;--line:#D4E3F1;--bg:#F2F6FB;--light:#EDF6FF;--card:#fff;--teal:#0F6B78;--mid:#3F5BA9;--s1:#2F5BD0;--s2:#D9434A;--side:264px}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 "Segoe UI",Roboto,Arial,sans-serif;-webkit-text-size-adjust:100%}
button{font:inherit;cursor:pointer;color:inherit}a{color:inherit}
:focus-visible{outline:3px solid #F7B733;outline-offset:2px}
/* sidebar */
.side{position:fixed;left:0;top:0;bottom:0;width:var(--side);background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column;z-index:40;overflow:hidden}
.side-top{display:flex;justify-content:space-between;align-items:center;padding:22px 16px 14px 20px;border-bottom:1px solid var(--line)}
.side-k{font-weight:800;color:var(--blue);letter-spacing:.6px;font-size:13px}.side-s{font-size:12.5px;color:var(--muted)}
.side-toggle{border:1px solid var(--line);background:var(--light);border-radius:10px;width:36px;height:36px;color:var(--blue);font-size:16px}
.search{padding:12px 16px 4px;position:relative}
.search input{width:100%;border:1px solid #BBD4E9;border-radius:10px;padding:9px 12px;font:inherit;font-size:14px;background:#F8FBFE;color:var(--ink)}
.qres{display:none;position:absolute;left:16px;right:16px;top:52px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 12px 30px #0837A11f;max-height:60vh;overflow:auto;z-index:5}
.qres.on{display:block}.qres button{display:block;width:100%;text-align:left;border:0;background:#fff;padding:9px 12px;border-bottom:1px solid #EEF3F8;font-size:13px}
.qres button:hover{background:var(--light)}.qres b{color:var(--blue);display:block}.qres small{color:var(--muted)}.qres .none{padding:10px 12px;color:var(--muted);font-size:13px}
.tabs{display:flex;flex-direction:column;gap:4px;padding:10px 14px}
.tab{display:flex;align-items:center;gap:12px;border:0;background:transparent;padding:9px 10px;border-radius:12px;color:#33475F;font-weight:700;font-size:14px;text-align:left}
.tab-num{flex:none;width:30px;height:26px;border-radius:7px;background:var(--light);color:var(--blue);display:grid;place-items:center;font-size:12px;font-weight:800}
.tab:hover:not(.on){background:#EEF6FC}.tab.on{background:var(--blue);color:#fff;box-shadow:inset 3px 0 var(--red)}.tab.on .tab-num{background:#ffffff26;color:#fff}
.subnav{flex:1;overflow:auto;padding:4px 14px 10px 20px;border-top:1px solid var(--line);margin-top:4px}
.subnav a{display:block;padding:5px 8px;border-radius:8px;font-size:12.5px;color:#41566E;text-decoration:none;line-height:1.35}
.subnav a.sub{padding-left:22px;color:var(--muted)}.subnav a:hover{background:var(--light);color:var(--blue)}
.side-actions{display:grid;gap:8px;padding:12px 16px;border-top:1px solid var(--line)}
.action{border:1px solid #BBD4E9;background:#fff;color:var(--deep);border-radius:11px;padding:9px 12px;font-weight:700;font-size:13.5px;text-align:left}
.action.blue{background:var(--blue);border-color:var(--blue);color:#fff}
.side-foot{font-size:11px;color:var(--muted);text-align:center;padding:8px 10px 14px}
body.side-min{--side:76px}body.side-min .side-k,body.side-min .side-s,body.side-min .tab-label,body.side-min .subnav,body.side-min .search,body.side-min .side-foot{display:none}
body.side-min .side-top{justify-content:center;padding:18px 0}body.side-min .side-actions .action{font-size:0;padding:10px}body.side-min .side-actions .action::first-letter{font-size:16px}
.wrap{margin-left:var(--side)}
/* header */
.top{display:flex;align-items:center;gap:22px;background:#fff;border-top:6px solid var(--blue);border-bottom:4px solid var(--red);padding:16px 28px}
.logo{width:150px;height:88px;object-fit:contain;flex:none}
.top-copy{flex:1;min-width:0}.eyebrow{font-size:11.5px;letter-spacing:2.2px;font-weight:800;color:var(--blue);text-transform:uppercase}
.top h1{margin:4px 0;color:var(--blue);font-size:clamp(22px,2.3vw,34px);line-height:1.15;letter-spacing:-.3px}
.top p{margin:0;font-weight:650;font-size:13.5px;color:#22385A}
.top-chip{border:1px solid #BBD4E9;border-radius:999px;padding:8px 14px;font-weight:800;color:var(--blue);font-size:12px;white-space:nowrap;background:var(--light)}
main{max-width:none;width:100%;box-sizing:border-box;padding:26px 28px 60px}
.view{display:none}.view.on{display:block}
.view-h{margin:4px 0 16px}.vt{color:var(--dark);font-size:clamp(24px,2.2vw,32px);margin:6px 0 6px;line-height:1.2}
.lede{color:var(--muted);margin:0 0 6px;max-width:1400px}
.card,.scope,.doc-sec{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px 24px;margin:16px 0;box-shadow:0 6px 24px #0B356B0a}
.card-h{margin:0 0 12px;color:var(--deep);font-size:18px}
.doc-sec .sec-h{display:flex;gap:12px;align-items:baseline;margin:0 0 12px;color:var(--dark);font-size:20px;line-height:1.3}
.doc-sec.sub{margin-left:18px;border-left:4px solid #C9DBF0}.doc-sec.sub .sec-h{font-size:17.5px}
.sec-num{flex:none;background:var(--blue);color:#fff;border-radius:8px;padding:2px 9px;font-size:14px}
.doc-sec.sub .sec-num{background:var(--light);color:var(--blue)}
.doc-sec.flash{animation:flash 1.6s ease}@keyframes flash{0%{box-shadow:0 0 0 4px #F7B733}100%{box-shadow:0 6px 24px #0B356B0a}}
p{margin:8px 0}ul,ol{margin:8px 0;padding-left:22px}li{margin:3px 0}
.pend{display:inline-block;background:#FDECEC;color:#A61E25;border:1px solid #F6C3C5;border-radius:999px;padding:0 9px;font-weight:700;font-size:.86em;white-space:nowrap}
.xref{color:var(--blue);font-weight:650;text-decoration:underline dotted;text-underline-offset:2px}
.muted{color:var(--muted)}
/* tables */
.tbl{overflow-x:auto;border:1px solid var(--line);border-radius:12px;margin:10px 0;background:#fff;-webkit-overflow-scrolling:touch}
table.t{border-collapse:collapse;width:100%;font-size:13.8px}
table.t.wide{min-width:980px}table.t.mid{min-width:720px}
table.t th{background:#EDF4FC;color:var(--deep);text-align:left;font-weight:750;padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:bottom}
table.t td{padding:9px 12px;border-top:1px solid #E7EFF7;vertical-align:top}
table.t td:first-child{font-weight:650;color:#1B355C}
table.t tbody tr:hover td{background:#F7FAFD}
pre.ascii{background:#F4F8FC;border:1px solid var(--line);border-radius:12px;padding:14px;overflow-x:auto;font:13px/1.5 Consolas,"Courier New",monospace;color:var(--dark)}
.meta{padding:16px 18px}
/* stats */
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:16px 0}
.stat{background:#fff;border:1px solid var(--line);border-top:4px solid var(--blue);border-radius:14px;padding:14px 16px}
.stat.red{border-top-color:var(--red)}.stat b{display:block;font-size:30px;color:var(--dark);line-height:1.1}.stat span{font-size:13px;color:var(--muted)}
/* scope */
.scope h2{margin:4px 0;color:var(--dark);font-size:26px}
.scope-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:14px}
.scope-card{border:1px solid var(--line);border-left:6px solid var(--blue);border-radius:14px;padding:16px;background:#fff}
.scope-card.b{border-left-color:var(--red)}.scope-card.c{border-left-color:var(--teal)}
.sc-top{display:flex;gap:12px;align-items:center}.sc-l{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;font-weight:900;font-size:22px;border:2px solid var(--blue);color:var(--blue);flex:none}
.b .sc-l{border-color:var(--red);color:var(--red)}.c .sc-l{border-color:var(--teal);color:var(--teal)}
.sc-e{font-size:11px;letter-spacing:1.5px;font-weight:800;color:var(--muted)}.scope-card h3{margin:2px 0;font-size:18px;color:var(--dark)}
.pills{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0 6px}.pills span{background:#F4F8FC;border:1px solid var(--line);border-radius:8px;padding:4px 9px;font-weight:650;font-size:13px}
.sc-n{font-size:12.5px;color:var(--muted);margin:6px 0 0}
.code-legend{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin-top:14px;background:var(--light);border-radius:12px;padding:10px 14px;font-size:13px}
.code-legend i{font-style:normal;font-weight:800;border:1px solid #9FB9DA;border-radius:6px;padding:0 6px;background:#fff;color:var(--blue);margin-right:4px}.code-legend em{color:var(--muted)}
/* buttons */
.btn{border:1px solid #BBD4E9;background:#fff;color:var(--deep);border-radius:10px;padding:7px 12px;font-weight:700;font-size:13px;margin-right:6px}
.btn:hover{background:var(--light)}
/* org */
.org-tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:14px}.org-legend{margin-left:auto;font-size:12.5px;color:var(--muted);display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.org-top{display:flex;flex-direction:column;align-items:center}
.node{border:0;border-radius:14px;padding:14px 26px;font-weight:800;color:#fff;text-align:center;font-size:17px}
.node.dark{background:var(--dark)}.node.blue{background:var(--blue);box-shadow:inset 5px 0 var(--red);min-width:min(420px,100%)}
.node small{display:block;font-weight:600;font-size:12px;opacity:.85;margin-top:3px}
.vline{width:3px;height:22px;background:var(--blue)}
.org-cols{display:grid;grid-template-columns:1.45fr 1fr 1fr;gap:16px;position:relative;padding-top:22px;border-top:3px solid var(--blue)}
.col{border:1px solid var(--line);border-radius:16px;background:#FAFCFE}
.col-h{display:block;width:100%;text-align:left;border:0;border-radius:15px 15px 0 0;background:var(--blue);color:#fff;padding:14px 16px;font-weight:800;font-size:16px}
.col-h small{display:block;font-weight:600;font-size:12px;opacity:.85}.col-h b{color:#FFD7D8}
.col:nth-child(2) .col-h{background:#0A2F86}.col:nth-child(3) .col-h{background:#123F8F}
.col-b{padding:12px;display:grid;gap:8px}
.pos{display:flex;flex-wrap:wrap;align-items:center;gap:6px;width:100%;text-align:left;background:#fff;border:1px solid var(--line);border-left:4px solid var(--blue);border-radius:10px;padding:9px 11px;font-weight:700;font-size:13.8px;color:var(--dark)}
.pos:hover{background:var(--light);border-color:#9FB9DA}.pos-n{flex:1 1 160px}
.tag{font-style:normal;font-size:11px;font-weight:800;border-radius:6px;padding:1px 6px;border:1px solid #9FB9DA;color:var(--blue);background:#fff}
.t-b{color:var(--red);border-color:#F2A6A9}.t-c{color:var(--teal);border-color:#8CC5CC}.t-ac,.t-bc{color:#4B3A9C;border-color:#B8ADE6}
.lead{font-size:11px;font-weight:800;color:#fff;background:var(--red);border-radius:6px;padding:1px 6px}
.state{font-size:11px;font-weight:700;color:#7A5A00;background:#FFF4D6;border:1px solid #F1D58B;border-radius:6px;padding:1px 6px}
.grp{border:1px solid var(--line);border-radius:12px;background:#fff}
.grp>summary{list-style:none;cursor:pointer;padding:11px 14px;font-weight:800;color:var(--dark);font-size:14.5px}
.grp>summary::-webkit-details-marker{display:none}.grp>summary::before{content:"▸ ";color:var(--blue)}.grp[open]>summary::before{content:"▾ "}
.grp>summary small{display:block;font-weight:600;color:var(--muted);font-size:12px;margin-left:16px}
.grp-b{padding:0 12px 12px;display:grid;gap:8px}
.grp.local{border-color:#F6C3C5}.grp.local .pos{border-left-color:var(--red)}
.hosp-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.hosp{border:1px dashed #E7B4B6;border-radius:10px;padding:8px;display:grid;gap:6px;background:#FFFBFB}
.hosp-h{font-size:12.5px;font-weight:800;color:#7D1D22}
.grp.clinic .pos{border-left-color:var(--teal)}.grp.future{border-style:dashed;padding:8px}.grp.future .pos{border-left-color:#9AA9BC;border-style:dashed}
/* JD */
.jd-tools{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;align-items:center;margin:8px 0}
.filters{display:flex;flex-wrap:wrap;gap:6px}
.fbtn{border:1px solid #BBD4E9;background:#fff;border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700;color:var(--deep)}
.fbtn.on{background:var(--blue);border-color:var(--blue);color:#fff}
.jd{margin:12px 0;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 4px 18px #0B356B0a}
.jd[hidden]{display:none}
.jd.role{border-color:#F6C3C5}
.jd-head{list-style:none;display:flex;align-items:center;gap:14px;padding:14px 18px;cursor:pointer}
.jd-head::-webkit-details-marker{display:none}
.jd-no{flex:none;width:40px;height:40px;border-radius:12px;background:var(--blue);color:#fff;display:grid;place-items:center;font-weight:900}
.role .jd-no{background:var(--red)}
.jd-tt{flex:1;min-width:0}.jd-name{display:block;font-weight:800;font-size:17px;color:var(--dark)}.jd-meta{display:block;font-size:13px;color:var(--muted)}
.chip{flex:none;border:1px solid #BBD4E9;background:var(--light);color:var(--blue);border-radius:999px;padding:3px 10px;font-size:12px;font-weight:800}
.chip.red{background:#FDECEC;color:#A61E25;border-color:#F6C3C5}
.jd-arrow{color:var(--blue);transition:transform .2s}.jd-d[open] .jd-arrow{transform:rotate(180deg)}
.jd-body{padding:0 18px 18px;border-top:1px solid var(--line)}
.jd-purpose{background:var(--light);border-radius:10px;padding:10px 14px;margin:14px 0}
.jd-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.jd-box{border:1px solid #E3ECF6;border-radius:12px;padding:12px 14px}
.jd-box h4{margin:4px 0 6px;color:var(--blue);font-size:13px;letter-spacing:.6px;text-transform:uppercase}
.jd-box h4~h4{margin-top:14px}.jd-box dl{margin:0;display:grid;grid-template-columns:130px 1fr;gap:4px 10px;font-size:14px}
.jd-box dt{color:var(--muted);font-weight:650}.jd-box dd{margin:0}
.jd-box ul{padding-left:18px;font-size:14px}.jd-box p{font-size:14px}
.jd-box.q{background:#FBFDFF}
ul.yes,ul.no{list-style:none;padding-left:0}ul.yes li,ul.no li{position:relative;padding-left:22px}
ul.yes li::before{content:"✓";position:absolute;left:2px;color:#13804A;font-weight:900}
ul.no li::before{content:"✕";position:absolute;left:3px;color:#B4232A;font-weight:900}
.cancu{font-size:12.5px!important;color:var(--muted)}
.jdlink{color:var(--blue);font-weight:750;text-decoration:none}.jdlink:hover{text-decoration:underline}
/* chart */
.chart{margin:0}.chart figcaption b{display:block;color:var(--dark);font-size:17px}.chart figcaption span{color:var(--muted);font-size:13px}
.legend{display:flex;gap:18px;margin:10px 0;font-size:13px;color:var(--ink)}.sw{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.sw.s1,.seg.s1{background:var(--s1)}.sw.s2,.seg.s2{background:var(--s2)}
.bars{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px;height:300px;align-items:end;border-bottom:1px solid #C9D6E5;padding:0 6px;position:relative}
.bar{position:relative;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;outline:none}
.bar-tot{font-weight:800;color:var(--dark);font-size:14px;margin-bottom:4px}
.bar-stack{width:min(64px,80%);display:flex;flex-direction:column;gap:2px}
.seg{display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:12px;min-height:16px}
.bar-stack .seg:first-child{border-radius:4px 4px 0 0}
.bars-x{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px;padding:8px 6px 0;font-size:12px;color:var(--muted);text-align:center;line-height:1.3}
.tip{display:none;position:absolute;bottom:105%;left:50%;transform:translateX(-50%);background:var(--dark);color:#fff;font-size:12.5px;border-radius:10px;padding:8px 10px;width:max-content;max-width:220px;z-index:3;box-shadow:0 8px 20px #0003}
.bar:hover .tip,.bar:focus .tip{display:block}.bar:hover .bar-stack,.bar:focus .bar-stack{filter:brightness(1.08)}

/* relations */
.rel-card{padding:18px}
.rel-svg{width:100%;height:auto;max-height:560px;display:block;background:radial-gradient(circle at 50% 50%,#EEF5FF 0,#fff 60%);border:1px solid var(--line);border-radius:14px}
.hub{fill:#fff;stroke:#9FC2E8;stroke-width:2}.hub-t{text-anchor:middle;font-weight:800;fill:var(--dark);font-size:17px}
.edge{fill:none;stroke:var(--blue);stroke-width:2.6;transition:opacity .2s,stroke-width .2s}.edge.dash{stroke:var(--red);stroke-dasharray:9 7}
.n-dark{fill:var(--dark)}.n-blue{fill:var(--blue)}.n-teal{fill:var(--teal)}.n-mid{fill:var(--mid)}
.n-t{fill:#fff;text-anchor:middle;font-weight:800;font-size:19px}
.badge circle{fill:var(--blue);stroke:#fff;stroke-width:3}.badge.red circle{fill:var(--red)}.badge text{fill:#fff;text-anchor:middle;font-weight:800;font-size:13px}
.rel-svg.focus .edge,.rel-svg.focus .badge{opacity:.15}.rel-svg.focus .edge.hl,.rel-svg.focus .badge.hl{opacity:1}.edge.hl{stroke-width:5}
.rel-legend{display:flex;gap:22px;justify-content:center;margin:12px 0;font-size:13px;color:var(--muted)}
.rel-legend .ln{display:inline-block;width:34px;border-top:3px solid var(--blue);vertical-align:middle;margin-right:8px}.rel-legend .ln.dash{border-top:3px dashed var(--red)}
.rel-rows{border:1px solid var(--line);border-radius:14px;overflow:hidden}
.rel-row{display:grid;grid-template-columns:48px 280px 1fr;gap:14px;align-items:center;width:100%;text-align:left;border:0;border-top:1px solid #E7EFF7;background:#fff;padding:12px 16px;font-size:14px}
.rel-row:first-child{border-top:0}.rel-row:hover,.rel-row.on{background:var(--light)}
.rel-n{background:var(--light);color:var(--blue);font-weight:900;border-radius:8px;text-align:center;padding:5px 0}
.rel-row.red .rel-n{background:#FDECEC;color:#B4232A}.rel-row.red .rel-who{color:#A61E25}
.rel-who{font-weight:800;color:var(--dark)}
/* phases */
.phases{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
.ph{border:1px solid var(--line);border-top:5px solid var(--blue);border-radius:14px;padding:14px;background:#fff;position:relative}
.ph:nth-child(2){border-top-color:#2F5BD0}.ph:nth-child(3){border-top-color:var(--teal)}.ph:nth-child(4){border-top-color:#6B4FB8}.ph:nth-child(5){border-top-color:var(--red)}
.ph-n{width:34px;height:34px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-weight:900}
.ph-t{font-weight:800;color:var(--dark);margin-top:8px;font-size:15.5px}.ph-d{font-size:12.5px;color:var(--muted);font-weight:700}
.ph-p,.ph-w{font-size:13.2px;margin-top:8px}
/* drawer */
.foot{text-align:center;color:var(--muted);font-size:12px;padding:0 20px 30px}
/* responsive */
@media (max-width:1250px){.org-cols{grid-template-columns:1fr 1fr}.org-cols .col:first-child{grid-column:1/-1}.phases{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:900px){
 .side{position:sticky;top:0;width:auto;height:auto;border-right:0;border-bottom:1px solid var(--line);box-shadow:0 4px 14px #0B356B14}
 .side-top{display:none}
 .tabs{flex-direction:row;overflow-x:auto;padding:8px 12px;gap:6px;scrollbar-width:thin}
 .tab{flex:none;padding:7px 10px}.subnav,.side-actions,.side-foot{display:none}
 .search{padding:8px 16px 4px}.qres{top:46px}
 .wrap{margin-left:0}
 .top{padding:12px 16px;gap:12px;flex-wrap:wrap}.logo{width:96px;height:58px}.top-chip{display:none}
 main{padding:16px 16px 50px}
 .card,.scope,.doc-sec{padding:16px;border-radius:14px}.doc-sec.sub{margin-left:0}
 .stats{grid-template-columns:repeat(2,minmax(0,1fr))}.scope-grid{grid-template-columns:1fr}
 .org-cols{grid-template-columns:1fr}.hosp-grid{grid-template-columns:1fr}.org-legend{margin-left:0}
 .jd-grid{grid-template-columns:1fr}.jd-box dl{grid-template-columns:1fr}.jd-head{gap:10px;padding:12px}.chip{display:none}
 .phases{grid-template-columns:1fr}
 .rel-row{grid-template-columns:40px 1fr}.rel-what{grid-column:2}
 .bars,.bars-x{gap:6px}.bars{height:240px}.bars-x{font-size:10.5px;overflow-wrap:anywhere}.seg{font-size:11px}
 .rel-scroll{overflow-x:auto}.rel-svg{min-width:640px}
 .doc-sec .sec-h{font-size:17.5px}
}
@media print{
 .side,.org-tools,.jd-tools,.top-chip{display:none!important}
 .wrap{margin:0}.view{display:block!important;break-before:page}.view:first-of-type{break-before:auto}
 body{background:#fff;font-size:12px}.card,.scope,.doc-sec,.jd{box-shadow:none;break-inside:auto}
 .tbl{overflow:visible;border:0}table.t.wide,table.t.mid{min-width:0}table.t{font-size:10.5px}
 .jd[hidden]{display:block!important}.tip{display:none!important}
}

/* mô tả công việc mở trong sơ đồ */
.pos-panel{grid-column:1/-1;width:100%;border:2px solid var(--blue);border-radius:14px;background:#fff;padding:12px 14px;margin:2px 0 6px;box-shadow:0 10px 26px #0837A11f;text-align:left;color:var(--ink);font-weight:400}
.org .pos-panel{max-width:none;margin:12px 0}
.pp-h{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;border-bottom:3px solid var(--red);padding-bottom:8px}
.pp-h b{display:block;color:var(--blue);font-size:17px}.pp-m{display:block;font-size:12.5px;color:var(--muted)}
.pp-x{flex:none;border:1px solid var(--blue);background:var(--blue);border-radius:9px;padding:6px 10px;color:#fff;font-weight:700;font-size:12.5px;white-space:nowrap}.pp-x:hover{background:#0A2F86}
.pos-panel .jd-body{border:0;padding:0}.pos-panel .jd-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pos-panel .jd-box{padding:10px 12px}
.pos-panel .jd-box dl{grid-template-columns:130px 1fr}.pos-panel .jd-purpose{margin:10px 0}
.org-top>.pos-panel .jd-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.org-top>.pos-panel .jd-box dl{grid-template-columns:130px 1fr}
.pp-f{margin-top:10px}.pp-f .btn{display:inline-block;text-decoration:none}
.pos[aria-expanded="true"]{background:var(--light);border-color:var(--blue);box-shadow:0 0 0 2px #0837A133}
.pos-lead[aria-expanded="true"]{box-shadow:0 0 0 3px #F7B733}
@media (max-width:900px){.pos-panel .jd-grid{grid-template-columns:1fr}.pos-panel .jd-box dl{grid-template-columns:1fr}}
@media print{.pos-panel{display:none}}

.pos-panel,.doc-sec,.jd{scroll-margin-top:16px}
@media (max-width:900px){.pos-panel,.doc-sec,.jd{scroll-margin-top:124px}}

/* thu gọn không phải kéo lên */
.pp-h{position:sticky;top:0;z-index:3;background:#fff;padding-top:6px;margin-top:-6px}
.jd-head{border-radius:16px;background:#fff}
.jd-d[open]>.jd-head{position:sticky;top:0;z-index:3;border-bottom:1px solid var(--line);border-radius:16px 16px 0 0;box-shadow:0 6px 12px -10px #0B356B55}
.jd-foot,.pp-f{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.btn.blue{background:var(--blue);border-color:var(--blue);color:#fff}.btn.blue:hover{background:#0A2F86}
@media (max-width:900px){.pp-h,.jd-d[open]>.jd-head{top:108px}}
@media print{.jd-foot{display:none}.jd-d[open]>.jd-head{position:static}}
.jd-link{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0 0 12px}
.jl-col{border:1px solid #CFE0F3;border-top:3px solid var(--blue);border-radius:12px;padding:12px 14px;background:#fff}
.jl-col.kpi{border-top-color:var(--red)}
.jl-col h4{margin:2px 0 10px;color:var(--blue);font-size:13px;letter-spacing:.6px;text-transform:uppercase}
.jl-col.kpi h4{color:#B4232A}
.jl-col h4 small{display:block;text-transform:none;letter-spacing:0;font-weight:600;color:var(--muted);font-size:12px;margin-top:2px}
ul.codes{list-style:none;padding:0;margin:0;display:grid;gap:8px;font-size:14px}
ul.codes li{display:flex;gap:9px;align-items:flex-start;line-height:1.45}
.code{flex:none;min-width:40px;text-align:center;font-weight:800;font-size:12px;border-radius:6px;padding:2px 6px;background:var(--light);color:var(--blue);border:1px solid #BBD4E9}
.code.mt{background:#FDEEEE;color:#B4232A;border-color:#F2B4B6}
ul.codes li.note{color:var(--muted);font-size:13.5px;border-top:1px dashed var(--line);padding-top:7px}
.mtx td:nth-child(2),.mtx td:nth-child(3){white-space:normal}
.lg2{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:10px;font-size:12.5px}.lg2>b{width:100%;color:var(--dark);font-size:12.5px}
.lg2 span{display:inline-flex;gap:4px;align-items:center}
.pos-panel .jd-link{grid-template-columns:1fr}
@media (max-width:760px){.jd-link{grid-template-columns:1fr}}
ul.kl{margin:2px 0 6px;padding-left:16px;font-size:13.5px}ul.kl li{margin:2px 0}
.mtx td{vertical-align:top}.mtx td:first-child{width:17%}.mtx td:nth-child(2){width:24%}.mtx td:nth-child(4){width:22%}
.mtx p.mtg{margin:0 0 2px;color:var(--dark);font-size:13.5px}.mtx p.mtg i,.codes i{color:var(--muted);font-weight:500}
p.mini{margin:4px 0 2px;color:var(--muted);font-size:13px}
.gloss th{width:170px;text-align:left;color:var(--blue);vertical-align:top}.gloss td{font-size:14px}
ul.codes li.vh{border-top:1px dashed var(--line);padding-top:7px}
.code{margin-left:2px}
ul.codes ul.kl{list-style:disc;padding-left:18px;display:block}ul.codes ul.kl li{display:list-item}
table.t.gloss th,table.t.gloss td{vertical-align:top}
.kpibox{margin:0 0 12px}.kpibox .tbl{margin:6px 0}
table.kpi-t{font-size:13.5px}table.kpi-t td{vertical-align:top}table.kpi-t td.w,table.kpi-t th:last-child{text-align:right;white-space:nowrap;font-weight:800;color:var(--dark)}
table.kpi-t tr.kg td{background:#F4F8FC;color:var(--blue);font-weight:800;font-size:12px;letter-spacing:.4px;text-transform:uppercase}
table.kpi-t tr.sum td{background:var(--light);font-weight:800;color:var(--dark)}
table.kpi-t small{color:var(--muted)}
.jl-col.org2 dl{margin:0;display:grid;grid-template-columns:120px 1fr;gap:4px 10px;font-size:13.5px}.jl-col.org2 dt{color:var(--muted);font-weight:650}.jl-col.org2 dd{margin:0}
.pos-panel .jl-col.org2 dl{grid-template-columns:1fr}
.fbtn.g{border-style:dashed}
.p3intro p strong{color:var(--dark)}
@media (max-width:760px){.jl-col.org2 dl{grid-template-columns:1fr}}
table.kpi-t small.src{display:block;margin-top:2px;font-size:12px}
table.kpi-t td:nth-child(2){width:24%}table.kpi-t td:nth-child(1){width:64%}
.jd-tt .jd-name{display:inline}.jd-tt .tag{margin-left:6px;vertical-align:2px}

/* chế độ toàn màn hình (đọc rộng) */
body.fs-on .top{display:none}
body.fs-on main{padding-top:14px}
@media print{body.fs-on .top{display:flex}}
.fhead{position:fixed;z-index:35;display:none;overflow:hidden;pointer-events:none;box-shadow:0 8px 12px -10px #0B356B66;border-radius:0}
.fhead table{margin:0;table-layout:fixed;border-collapse:collapse}
.fhead th{box-sizing:border-box}
@media print{.fhead{display:none!important}}
.jd-out{margin:12px 0}.jd-out h4{margin:0 0 6px;color:var(--deep)}.jd-out h4 small{font-weight:500;color:#5b6b80;margin-left:8px;font-size:12px}

/* Bảng mô tả công việc theo mẫu TTH */
.tth-form{border:1px solid #D9E4F2;border-radius:12px;padding:14px 16px;margin:12px 0;background:#fff}
.tth-title{display:flex;flex-direction:column;gap:2px;text-align:center;border-bottom:1px solid #E3ECF6;padding-bottom:10px;margin-bottom:10px;text-transform:none;color:var(--muted);font-size:12px;letter-spacing:.6px}
.tth-title b{font-size:17px;color:var(--deep);letter-spacing:0;text-transform:uppercase}
.tth-info{margin:0 0 6px;display:grid;grid-template-columns:230px 1fr;gap:4px 12px;font-size:14px}
.tth-info dt{color:var(--muted);font-weight:650}.tth-info dd{margin:0}
.tth-h{margin:16px 0 6px;color:var(--blue);font-size:14px}
.tth-sub{margin:8px 0 4px;font-weight:650;font-size:13.5px}
.tth-nv td:first-child,.tth-kv td:first-child{width:1%;white-space:nowrap}
.tth-nv td:nth-child(2){width:18%}.tth-nv td:last-child{width:20%}
.tth-rel td{width:50%;vertical-align:top}.tth-form ul{padding-left:18px;margin:0}
.tth-vang{margin:10px 0}
.tth-sign{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px;text-align:center;font-size:13px}
.tth-sign div{border:1px dashed #C9D6E8;border-radius:10px;padding:10px 8px 26px;display:flex;flex-direction:column;gap:3px}
.tth-sign i{color:var(--muted)}
.tth-pl{margin:6px 0 4px}.tth-plh{font-weight:700;color:var(--deep);margin:10px 0 6px}
.pl{border:1px solid #E3ECF6;border-radius:10px;margin:6px 0;padding:0 12px}
.pl>summary{cursor:pointer;list-style:none;padding:9px 0}.pl>summary::-webkit-details-marker{display:none}
.pl>summary h4{display:inline;margin:0}.pl>summary::before{content:'▸';margin-right:8px;color:var(--blue)}.pl[open]>summary::before{content:'▾'}
.pl[open]{padding-bottom:10px}
@media (max-width:720px){.tth-info{grid-template-columns:1fr}.tth-sign{grid-template-columns:1fr}.tth-nv td:nth-child(2),.tth-nv td:last-child{width:auto}}
@media print{.pl{border:0;padding:0}.pl>summary::before{content:''}}
.tth-rel td,.tth-rel td li{font-weight:400}
.pos-panel .tth-form{padding:10px;margin:8px 0}.pos-panel .tth-info{grid-template-columns:1fr;gap:2px 0}.pos-panel .tth-info dd{margin-bottom:6px}.pos-panel .tth-sign{grid-template-columns:1fr}
.org-top>.pos-panel .tth-info{grid-template-columns:230px 1fr}.org-top>.pos-panel .tth-sign{grid-template-columns:1fr 1fr}

/* lọc nhân sự theo nhóm thương hiệu */
.gfilter{display:flex;flex-wrap:wrap;gap:6px 8px;align-items:center;width:100%;margin-top:8px;padding-top:10px;border-top:1px solid var(--line)}
.gfilter .gl{font-weight:800;font-size:13px;color:var(--dark);margin-right:2px}
.gbtn{border:1px solid #BBD4E9;background:#fff;color:var(--deep);border-radius:999px;padding:6px 14px;font-weight:700;font-size:13px;cursor:pointer}
.gbtn:hover{background:var(--light)}
.gbtn.on{background:var(--blue);border-color:var(--blue);color:#fff}
.gbtn[data-g="2"].on{background:var(--red);border-color:var(--red)}
.gleg{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center;font-size:12.5px;color:var(--muted);margin-left:auto}
.gleg[hidden]{display:none}
.gleg .lg{display:inline-block;width:18px;height:12px;border-radius:4px;background:#fff;border:1px solid var(--line);vertical-align:middle;margin-right:2px}
.gleg .lg.direct{box-shadow:0 0 0 2px var(--blue)}.gleg .lg.shared{outline:2px dashed #6B7F99}.gleg .lg.cross{outline:2px dotted var(--red)}.gleg .lg.none{opacity:.45;background:#DDE5EE}
.grel{border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 0 16px;background:#FBFDFF}
.grel[hidden]{display:none}
.grel-h{font-weight:800;color:var(--dark);font-size:15px}
.grel-sum{font-size:13px;color:var(--muted);margin:4px 0 12px}
.grel-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.grel-b{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:#fff;min-width:0}
.grel-b h4{margin:0 0 4px;font-size:13px;color:var(--deep);letter-spacing:.2px}
.grel-b.k-direct{border-top:3px solid var(--blue)}.grel-b.k-coso{border-top:3px solid var(--red)}.grel-b.k-shared{border-top:3px dashed #6B7F99}.grel-b.k-cross{border-top:3px dotted var(--red)}
.grel-it{display:block;width:100%;text-align:left;border:0;border-top:1px solid #EEF3F8;background:none;padding:7px 2px;font-size:13px;color:var(--dark);cursor:pointer}
.grel-it:first-of-type{border-top:0}
.grel-it b{font-weight:750}.grel-it span{display:block;color:var(--muted);font-size:12.5px;margin-top:2px;line-height:1.45}
.grel-it:hover b,.grel-it:focus-visible b{text-decoration:underline}
.org.gf-1 .pos[data-r1="none"],.org.gf-2 .pos[data-r2="none"]{opacity:.25}
.org.gf-1 .pos[data-r1="direct"],.org.gf-2 .pos[data-r2="direct"]{box-shadow:0 0 0 2px var(--blue)}
.org.gf-1 [data-r1="shared"],.org.gf-2 [data-r2="shared"]{outline:2px dashed #6B7F99;outline-offset:2px}
.org.gf-1 .pos[data-r1="cross"],.org.gf-2 .pos[data-r2="cross"]{outline:2px dotted var(--red);outline-offset:2px}
.org.gf-1 .hosp[data-g="2"] .hosp-h,.org.gf-2 .hosp[data-g="1"] .hosp-h{opacity:.35}
@media (max-width:760px){.grel-grid{grid-template-columns:1fr}.gleg{margin-left:0}}
@media print{.gfilter,.grel{display:none!important}}

.grel-b.k-lead{grid-column:1/-1;border-top:3px solid var(--dark)}
.grel-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:18px}
.grel-cols .grel-it{border-top:1px solid #EEF3F8}
.grel-it.st{cursor:default}.grel-it.st:hover b{text-decoration:none}
@media (max-width:760px){.grel-cols{grid-template-columns:1fr}}

/* kỹ năng phụ, người thay */
.jd-quick{border:1px solid #CFE0F2;border-left:5px solid var(--blue);border-radius:12px;background:#F6FAFE;padding:12px 14px;margin:0 0 14px}
.jd-quick .jq-h{font-weight:800;color:var(--dark);margin-bottom:6px}
.jd-quick dl{display:grid;grid-template-columns:230px 1fr;gap:5px 12px;margin:0}
.jd-quick dt{font-weight:700;color:var(--deep);font-size:13px}.jd-quick dd{margin:0;font-size:13.5px}
.jd-quick .mini{margin:8px 0 0}
.pos-sub{display:none}
.org.show-sub .pos-sub{display:grid;gap:2px;width:100%;margin-top:4px;padding-top:5px;border-top:1px dashed #D5E1EE;font-weight:500;font-size:12px;line-height:1.45;color:#3C4E66;text-align:left}
.org.show-sub .pos-sub i{font-style:normal;font-weight:700;color:var(--deep)}
.org.show-sub .pos-lead .pos-sub{color:#E6EEFA;border-top-color:rgba(255,255,255,.35)}.org.show-sub .pos-lead .pos-sub i{color:#fff}
.btn.sub-tg[aria-pressed="true"]{background:var(--blue);color:#fff;border-color:var(--blue)}
@media (max-width:760px){.jd-quick dl{grid-template-columns:1fr}.jd-quick dt{margin-top:4px}}

/* 11/11/2026: lọc nhóm thương hiệu ở phần mô tả công việc – cùng cách xác định nhân sự liên quan như trang Bộ máy */
.jrel{display:none;margin-top:5px;font-size:12.5px;font-weight:600;line-height:1.4;padding:3px 9px;border-radius:8px;background:#F2F7FC;color:var(--deep)}
.jd-list.gf-1 .jrel.g1,.jd-list.gf-2 .jrel.g2{display:block;width:fit-content;max-width:100%}
.jrel.k-direct{box-shadow:inset 3px 0 0 var(--blue)}.jrel.k-lead{box-shadow:inset 3px 0 0 var(--dark)}
.jrel.k-shared{box-shadow:inset 3px 0 0 #6B7F99}.jrel.k-cross{box-shadow:inset 3px 0 0 var(--red);background:#FDF3F3}
.jd-list.gf-1,.jd-list.gf-2{display:flex;flex-direction:column}
.jd-list.gf-1>.jd,.jd-list.gf-2>.jd{margin:6px 0}
.jd-gsum{margin:4px 0 8px;padding:9px 12px;border:1px solid var(--line);border-radius:12px;background:#fff;font-size:13.5px;line-height:1.5}
@media print{.jrel{display:none!important}.jd-gsum{display:none!important}}
/* Phần 08 – Luồng vận hành (đọc từ cơ sở dữ liệu dùng chung) */
.ochip{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:650;border-radius:999px;padding:3px 10px;border:1px solid transparent;max-width:100%;line-height:1.35}
.ochip::before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor;flex:none}
.ochip.with{background:transparent!important;border-color:currentColor;font-weight:500}
.g-mkt{color:#0837A1;background:#E3EAF8}.g-ld{color:#082F56;background:#E3E9F4}.g-th{color:#1F5FBF;background:#E4EDFB}.g-nd{color:#8A5200;background:#FBF0DD}
.g-ts{color:#2E7D32;background:#E6F3E7}.g-cs{color:#0F6B78;background:#E0F1F2}.g-cc{color:#B4237A;background:#FBE6F1}.g-bgd{color:#56687F;background:#ECEFF3}.g-ngoai{color:#6B4E9B;background:#EFEAF7}
.g-b-mkt{--gc:#0837A1}.g-b-ld{--gc:#082F56}.g-b-th{--gc:#1F5FBF}.g-b-nd{--gc:#C27A00}.g-b-ts{--gc:#2E7D32}.g-b-cs{--gc:#0F6B78}.g-b-cc{--gc:#B4237A}.g-b-bgd{--gc:#7A8A9E}.g-b-ngoai{--gc:#6B4E9B}
.ops-legend{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 14px}
.ops-mute{color:var(--muted);font-size:13px;margin:6px 0 0}
.ops-ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px;font-size:14px}
.ops-ul small{display:block;color:var(--muted);font-size:12.5px}
.ops-n{width:30px;height:30px;border-radius:50%;display:inline-grid;place-items:center;font-weight:800;font-size:13px;border:2px solid var(--blue);color:var(--blue);background:var(--light);flex:none;font-variant-numeric:tabular-nums}
.ops-journey{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(250px,100%),1fr));gap:12px}
.ops-jn{border:1px solid var(--line);border-top:4px solid var(--gc,var(--blue));border-radius:12px;padding:14px;background:#F7FAFD;display:flex;flex-direction:column;gap:8px}
.ops-jh{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.ops-jn dl{margin:0;display:flex;flex-direction:column;gap:5px;font-size:13.5px}
.ops-jn dt{font-size:11px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;color:var(--muted)}
.ops-jn dd{margin:0}
.ops-scope{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
@media (max-width:1100px){.ops-scope{grid-template-columns:minmax(0,1fr)}}
.ops-col{border:1px solid var(--line);border-top:4px solid var(--cc,var(--blue));border-radius:12px;padding:14px;min-width:0}
.ops-col.c-mkt{--cc:#0837A1}.ops-col.c-cc{--cc:#B4237A}.ops-col.c-ng{--cc:#6B4E9B}
.ops-col h3{margin:0 0 6px;font-size:16px;color:var(--dark)}
.ops-col h3 em{display:block;font-style:normal;font-size:12.5px;color:var(--muted);font-weight:600}
.ops-sl{list-style:none;margin:0;padding:0}
.ops-sl li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:8px;padding:8px 0;border-top:1px solid #E7EFF7;font-size:14px}
.ops-sl li:first-child{border-top:0}
.ops-mn{font-weight:800;font-size:12px;color:var(--muted);padding-top:2px;font-variant-numeric:tabular-nums}
.ops-sl small{display:block;color:var(--muted);font-size:12.5px;margin-top:2px}
.ops-ccflow{display:grid;grid-template-columns:minmax(0,1fr) 26px minmax(0,1fr) 26px minmax(0,1fr);gap:8px;margin:10px 0 14px}
.ops-arr{display:grid;place-items:center;color:var(--muted);font-size:22px;font-weight:800}
@media (max-width:900px){.ops-ccflow{grid-template-columns:minmax(0,1fr)}.ops-arr{transform:rotate(90deg);height:22px}}
.ops-cc,.ops-box{border:1px solid var(--line);border-radius:12px;padding:14px;background:#F7FAFD;min-width:0}
.ops-cc.mid{background:#FBE6F1;border-color:#E9A7CB}
.ops-cc h4,.ops-box h4,.ops-unit h4{margin:0 0 8px;font-size:15px;color:var(--deep);display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ops-cc.mid h4{color:#B4237A}
.ops-box.warn{background:#FFF6F6;border-color:#F6C3C5;margin-top:14px}
.ops-g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:14px}
.ops-units{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));gap:14px}
.ops-unit{border:1px solid var(--line);border-left:4px solid var(--gc,var(--blue));border-radius:12px;padding:14px;background:#fff}
.ops-unit dl{margin:0;display:grid;grid-template-columns:118px minmax(0,1fr);gap:6px 10px;font-size:13.5px}
.ops-unit dt{font-weight:750;color:var(--muted);font-size:12.5px}
.ops-unit dd{margin:0}
@media (max-width:480px){.ops-unit dl{grid-template-columns:minmax(0,1fr)}}
.ops-toc{columns:2;column-gap:28px;margin:6px 0 0;padding-left:22px;font-size:14px}
.ops-toc li{margin:0 0 6px;break-inside:avoid}
@media (max-width:700px){.ops-toc{columns:1}}
.ops-case{background:#F7FAFD;border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:0 0 14px;font-size:14px}
.ops-case>b{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:2px}
.ops-nh{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.ops-nh span{font-size:12px;border:1px dashed #B9CDE4;border-radius:6px;padding:1px 7px;color:var(--muted)}
.ops-panel{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:start}
@media (max-width:1100px){.ops-panel{grid-template-columns:minmax(0,1fr)}}
.ops-panel aside{display:flex;flex-direction:column;gap:12px}
.ops-steps{list-style:none;margin:0;padding:0}
.ops-step{display:grid;grid-template-columns:30px minmax(0,1fr);gap:12px;position:relative;padding-bottom:14px}
.ops-step:not(:last-child)::after{content:"";position:absolute;left:14px;top:32px;bottom:0;width:2px;background:var(--line)}
.ops-sb{display:flex;flex-direction:column;gap:6px;min-width:0;padding-top:3px}
.ops-sb p{margin:0}
.ops-who{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.ops-meta{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:12.5px;color:var(--muted)}
.ops-meta b{color:var(--ink);font-weight:650}
.ops-br{border-left:3px solid var(--red);padding:2px 0 2px 10px;font-size:14px;margin:0 0 10px}
.ops-br b{display:block;font-size:13px;color:#A61E25}
.ops-cal{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(270px,100%),1fr));gap:14px}
@media print{.ops-panel,.ops-scope{grid-template-columns:minmax(0,1fr)}.ops-ccflow{grid-template-columns:minmax(0,1fr)}.ops-arr{display:none}}
/* Danh mục bên trái: 12 phần, cuộn cả cột khi màn hình thấp */
@media (min-width:901px){
 .side{overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin}
 .tabs{gap:2px;padding:8px 12px}
 .tab{padding:6px 10px}
 .tab-num{height:24px}
 .subnav{flex:1 0 auto;overflow:visible}
 .side-actions{position:sticky;bottom:0;background:#fff;z-index:2}
}
@media (min-width:901px) and (max-height:760px){
 .side-top{padding:12px 16px 10px 20px}
 .tab{padding:5px 10px;font-size:13.5px}
}

.ops-th-h{margin:14px 0 8px;font-size:16px;color:var(--dark)}
.ops-th td:first-child{width:62%}
@media (max-width:700px){.ops-th td:first-child{width:auto}}
.qtl{color:var(--blue);font-weight:650;text-decoration:underline dotted;text-underline-offset:2px}
/* search */
.search input{padding-right:12px}
.qres{position:fixed;left:calc(var(--side) + 14px);right:auto;top:14px;width:min(780px,calc(100vw - var(--side) - 28px));max-height:calc(100vh - 28px);border-radius:14px;box-shadow:0 18px 50px #0837A133;z-index:60;padding:0;overscroll-behavior:contain}
.qres .qh{position:sticky;top:0;background:#fff;z-index:1;padding:10px 14px 9px;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center}
.qres .qh b{display:inline;color:var(--ink)}
.qres .qk{margin-left:auto;font-size:11.5px}
.qres .qchips{display:flex;flex-wrap:wrap;gap:6px;width:100%}
.qres .qchip{display:inline-block;width:auto;border:1px solid #BBD4E9;background:#fff;border-radius:999px;padding:3px 10px;font-size:12px;font-weight:600;color:var(--deep)}
.qres .qchip:hover{background:var(--light)}
.qres .qchip.on{background:var(--blue);border-color:var(--blue);color:#fff}
.qres .qg{border-bottom:1px solid #E3ECF5;padding:3px 0 5px}
.qres .qg-h,.qres .qgo{display:flex;gap:10px;align-items:baseline;justify-content:space-between;padding:8px 14px 3px;border:0}
.qres .qgo{justify-content:flex-start;background:#FFF8E1;border-bottom:1px solid #F3E2A9;padding:10px 14px}
.qres .qg-t{font-weight:700;color:var(--blue);font-size:13.5px;line-height:1.35}
.qres .qg-v{font-size:11.5px;color:var(--muted);white-space:nowrap;flex:none}
.qres .qhit{padding:4px 14px 6px 26px;border:0;font-size:12.8px;color:#33475F;line-height:1.45;overflow-wrap:anywhere}
.qres .qmore{padding:3px 14px 7px 26px;border:0;font-size:12px;color:var(--blue);font-weight:700;background:transparent}
.qres .qall{padding:10px 14px;text-align:center}
.qres button.qi:hover,.qres button.act{background:var(--light)}
.qres button.act{box-shadow:inset 3px 0 var(--blue)}
.qres mark,mark.qhl{background:#FFE58A;color:inherit;border-radius:3px;padding:0 1px}
.qres .none{padding:14px;line-height:1.5}
.qflash:not(tr){animation:qflash 2.2s ease}
tr.qflash>td{animation:qflash 2.2s ease}
@keyframes qflash{0%,35%{background:#FFF4C2;box-shadow:0 0 0 3px #F7B733}100%{box-shadow:0 0 0 0 transparent}}
@media (max-width:900px){.qres{left:8px;right:8px;width:auto;top:120px;max-height:70vh}.qres .qk{display:none}.qres .qchips{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}.qres .qchip{flex:none}}
@media print{.qres{display:none!important}mark.qhl{background:none}}
/* III.0 */
details.cdcard>summary{cursor:pointer;list-style:none;display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline;margin:0}
details.cdcard>summary::-webkit-details-marker{display:none}
details.cdcard>summary::before{content:'▸';color:var(--blue);font-size:14px}
details.cdcard[open]>summary{margin-bottom:12px}
details.cdcard[open]>summary::before{content:'▾'}
details.cdcard>summary .mini{font-weight:400;font-size:12.5px;color:var(--muted)}
details.cdcard .doc-sec>.sec-h{display:none}
</style><style id="acceptance-style">.acceptance-note{border-left:3px solid #0837A1;background:#F4F8FF;padding:10px 13px;margin:10px 0 12px;border-radius:6px;color:#183858;font-size:13.5px;line-height:1.55}</style><style id="approval-1711-style">
.approval-note{background:#f4f8fe;border-left:4px solid #0837A1;padding:14px 17px;border-radius:8px;margin:15px 0}.approval-note strong{color:#0837A1}.approval-matrix{overflow-x:auto}.approval-matrix table{min-width:1160px}.approval-matrix th{background:#0837A1!important;color:#fff!important}.approval-matrix td{vertical-align:top}.approval-matrix tr:nth-child(even) td{background:#f5f8fd}.approval-chip{font-weight:700;color:#a3272e}.approval-flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:11px;margin:14px 0}.approval-step{border:1px solid #cbd9eb;border-radius:9px;padding:13px;background:#fff}.approval-step b{display:block;color:#0837A1;margin-bottom:5px}.approval-step p{margin:6px 0}.approval-sub{margin:21px 0 9px;color:#0837A1}.approval-fail{color:#a3272e;font-weight:600}
</style><style>.b7-chi-tiet{margin:20px 0 14px;padding:14px;border:1px solid #cbddeb;background:#f9fcff;border-radius:10px}.b7-chi-tiet h4{font-size:17px;color:#0837A1;margin:0 0 9px}.b7-chi-tiet .table-wrap{overflow-x:auto}.b7-chi-tiet table{min-width:1100px;width:100%;border-collapse:collapse;font-size:13px;line-height:1.45}.b7-chi-tiet th,.b7-chi-tiet td{border:1px solid #d3e0ec;padding:9px 10px;vertical-align:top;text-align:left}.b7-chi-tiet thead th{background:#0837A1;color:white}.b7-chi-tiet tbody th{color:#0837A1;min-width:90px}.b7-chi-tiet p{margin:9px 0;line-height:1.5}</style>
<style id="no-overflow-layout">
/* Bản xem không tràn, không cắt bảng / 18.11.2026 */
html,body{max-width:100%!important;overflow-x:visible!important}
body .wrap{min-width:0!important;max-width:100%!important;overflow-x:visible!important}
body .wrap main{min-width:0!important;max-width:100%!important;overflow-x:visible!important}
#main .view,#main .doc-sec,#main .card,#main .scope,#main .org,#main .jd,#main .col{min-width:0!important;max-width:100%!important;overflow-wrap:anywhere!important}
#main .tbl,#main .table-wrap,#main .approval-matrix,#main .rg-wrap,#main .b7-chi-tiet .table-wrap{box-sizing:border-box!important;max-width:100%!important;min-width:0!important;width:100%!important;overflow:visible!important;contain:none!important}
#main table:not(.tth-card){table-layout:fixed!important;min-width:0!important;width:100%!important;max-width:100%!important}
#main table th,#main table td{overflow-wrap:anywhere!important;white-space:normal!important;word-break:normal!important;vertical-align:top!important;height:auto!important;max-height:none!important;text-overflow:clip!important}
#main .view h1,#main .view h2,#main .view h3,#main .view h4,#main .sec-h,#main .jd-name{max-height:none!important;height:auto!important;text-overflow:clip!important;white-space:normal!important;overflow-wrap:anywhere!important}
#main table.tth-card,#main table.tth-card>tbody,#main table.tth-card>tbody>tr{display:block!important;min-width:0!important;width:100%!important;max-width:100%!important;table-layout:auto!important;overflow:visible!important}
#main table.tth-card>colgroup,#main table.tth-card>thead,#main table.tth-card>tfoot{display:none!important}
#main table.tth-card>tbody>tr{margin:0 0 11px!important;border:1px solid #d2deeb!important;border-left:3px solid #0837A1!important;border-radius:7px!important;box-sizing:border-box!important;background:#fff!important;padding:8px 10px!important}
#main table.tth-card>tbody>tr>td,#main table.tth-card>tbody>tr>th{display:grid!important;grid-template-columns:minmax(100px,28%) minmax(0,1fr)!important;column-gap:10px!important;width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;padding:8px 2px!important;border:0!important;border-bottom:1px solid #e0e8f3!important;background:transparent!important;white-space:normal!important;text-align:left!important;overflow:visible!important}
#main table.tth-card>tbody>tr>td:last-child,#main table.tth-card>tbody>tr>th:last-child{border-bottom:0!important}
#main table.tth-card>tbody>tr>td::before,#main table.tth-card>tbody>tr>th::before{content:attr(data-tth-title)!important;color:#0837A1!important;font-weight:700!important;display:block!important;min-width:0!important;overflow-wrap:anywhere!important}
#main table.tth-card>tbody>tr>td:has(details),#main table.tth-card>tbody>tr>td:has(table),#main table.tth-card>tbody>tr>td:has(.tbl){display:block!important;grid-template-columns:none!important;max-width:100%!important;min-width:0!important}
#main table.tth-card>tbody>tr>td:has(details)::before,#main table.tth-card>tbody>tr>td:has(table)::before,#main table.tth-card>tbody>tr>td:has(.tbl)::before{margin:0 0 8px!important}
#main table.tth-card .tbl,#main table.tth-card .table-wrap,#main table.tth-card details{max-width:100%!important;min-width:0!important;width:100%!important;overflow:visible!important}
#main table.tth-card code,#main table.tth-card abbr{white-space:normal!important;overflow-wrap:anywhere!important}
@media(max-width:760px){#main table.tth-card>tbody>tr>td,#main table.tth-card>tbody>tr>th{grid-template-columns:minmax(82px,33%) minmax(0,1fr)!important;column-gap:6px!important}body .wrap main{padding:12px!important}}

#main table.pending-decisions-table:not(.tth-card){table-layout:fixed!important;width:100%!important;min-width:0!important}
#main table.pending-decisions-table:not(.tth-card)>colgroup{display:table-column-group!important}
@media(max-width:900px){
 .side{position:relative!important;top:auto!important;height:auto!important;width:100%!important;max-width:100%!important;overflow:visible!important}
 .side .tabs{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:5px!important;overflow:visible!important;padding:8px 10px 10px!important;width:100%!important;box-sizing:border-box!important}
 .side .tab{width:100%!important;min-width:0!important;max-width:100%!important;padding:7px 6px!important;white-space:normal!important;line-height:1.25!important;display:flex!important;align-items:center!important;gap:4px!important;font-size:10.5px!important;overflow-wrap:anywhere!important;text-align:left!important}
 .side .tab-num{flex:none!important;max-width:23px!important;font-size:10px!important}
 .side .search{padding:8px 12px 4px!important;max-width:100%!important}
}
</style><style id="offline-smart-columns-css">

/* 18/11/2026 – căn lề và tỉ lệ cột cho bản ngoại tuyến; KHÔNG CẮT NỘI DUNG */
html,body{overflow-x:hidden!important;max-width:100%!important}
body .wrap,body .wrap main{min-width:0!important;max-width:100%!important;overflow-x:visible!important}
#main .view,#main .doc-sec,#main .card,#main .scope,#main .org,#main .jd,#main .col{min-width:0!important;max-width:100%!important}
#main .tbl,#main .table-wrap,#main .approval-matrix,#main .rg-wrap,#main .b7-chi-tiet .table-wrap{width:100%!important;max-width:100%!important;min-width:0!important;overflow-x:visible!important;box-sizing:border-box!important}
#main table{box-sizing:border-box!important;max-width:100%!important;min-width:0!important}
#main table:not(.tth-card){width:100%!important;table-layout:fixed!important}
#main table:not(.tth-card)>colgroup>col{min-width:0!important}
#main table th,#main table td{box-sizing:border-box!important;overflow-wrap:anywhere!important;word-break:normal!important;white-space:normal!important;vertical-align:top!important;max-width:100%!important;height:auto!important;max-height:none!important}
#main table tr,#main table tbody,#main table thead{max-width:100%!important}
#main table.tth-card>tbody>tr>td,#main table.tth-card>tbody>tr>th{grid-template-columns:minmax(100px,28%) minmax(0,1fr)!important;column-gap:14px!important}
#main .offline-full-form-details{min-width:0;max-width:100%;padding:0;margin:14px 0}
#main .offline-full-form-details>details{display:block;width:100%;max-width:100%;margin:9px 0;padding:12px 14px;border:1px solid #CBDDEC;border-left:4px solid #0837A1;border-radius:9px;background:#fff;box-sizing:border-box}
#main .offline-full-form-details>details>summary{font-weight:750;color:#0837A1;white-space:normal;overflow-wrap:anywhere;cursor:pointer}
#main a.offline-full-form-link{color:#0837A1!important;text-decoration:underline!important;white-space:normal!important;overflow-wrap:anywhere!important;cursor:pointer}
#main table.pending-decisions-table:not(.tth-card)>colgroup>col:nth-child(1){width:6%!important}
#main table.pending-decisions-table:not(.tth-card)>colgroup>col:nth-child(2){width:24%!important}
#main table.pending-decisions-table:not(.tth-card)>colgroup>col:nth-child(3){width:55%!important}
#main table.pending-decisions-table:not(.tth-card)>colgroup>col:nth-child(4){width:15%!important}
@media(max-width:760px){#main table.tth-card>tbody>tr>td,#main table.tth-card>tbody>tr>th{grid-template-columns:minmax(78px,32%) minmax(0,1fr)!important;column-gap:8px!important}}
</style>
<style id="tth-full-depth-no-overflow-style">
/* BẢN OFFLINE 18/11/2026 – sửa cuối toàn 12 mục, giữ nguyên toàn bộ nội dung */
html,body {max-width:100%!important;overflow-x:hidden!important}
body .wrap,body .wrap main {box-sizing:border-box!important;min-width:0!important;overflow-x:visible!important}
#main, #main .view, #main .doc-sec, #main .card, #main .scope, #main .tbl, #main .table-wrap,
#main .rg-wrap, #main .approval-matrix, #main .jd, #main .org, #main .ops-sec {box-sizing:border-box!important;min-width:0!important;max-width:100%!important}
#main .tbl, #main .table-wrap, #main .rg-wrap, #main .approval-matrix {overflow-x:visible!important;overflow-y:visible!important;contain:none!important}
#main table:not(.tth-card) {box-sizing:border-box!important;width:100%!important;max-width:100%!important;min-width:0!important;table-layout:fixed!important}
#main table td,#main table th {overflow-wrap:anywhere!important;white-space:normal!important;word-break:normal!important;text-overflow:clip!important;vertical-align:top!important;max-height:none!important;height:auto!important}
#main table td *, #main table th * {max-width:100%!important;min-width:0!important;overflow-wrap:anywhere!important;word-break:break-word!important;white-space:normal!important}
#main pre,#main code,#main .sec-h,#main .jd-name,#main .top,#main h1,#main h2,#main h3,#main h4,#main h5 {white-space:normal!important;overflow-wrap:anywhere!important;text-overflow:clip!important;max-height:none!important}
#main img,#main svg,#main canvas,#main iframe,#main video {max-width:100%!important;height:auto}
#main .rel-scroll{box-sizing:border-box!important;min-width:0!important;max-width:100%!important;width:100%!important;overflow-x:visible!important}
#main svg.rel-svg{display:block!important;width:100%!important;min-width:0!important;max-width:100%!important;height:auto!important;aspect-ratio:1000 / 540!important}
#main .offline-full-form-details,#main .offline-full-form-details>details {box-sizing:border-box!important;width:100%!important;max-width:100%!important;min-width:0!important}
#main table.tth-card,#main table.tth-card>tbody,#main table.tth-card>tbody>tr {max-width:100%!important;min-width:0!important;box-sizing:border-box!important}
#main table.tth-card>tbody>tr>td,#main table.tth-card>tbody>tr>th{box-sizing:border-box!important;min-width:0!important;max-width:100%!important;grid-template-columns:minmax(84px,26%) minmax(0,1fr)!important;column-gap:12px!important;overflow-wrap:anywhere!important}
#main table.tth-card>tbody>tr>td:has(details),#main table.tth-card>tbody>tr>td:has(table),#main table.tth-card>tbody>tr>td:has(.tbl){grid-template-columns:none!important;display:block!important}
#main .ops-th a,#main .ops-th .pend,#main .ops-th abbr {white-space:normal!important;overflow-wrap:anywhere!important;word-break:break-word!important}
#main .ops-th .pend {display:inline!important;border-radius:4px!important;padding:0 2px!important}
#main .offline-smart-columns>colgroup>col{min-width:0!important}
#main table.pending-decisions-table:not(.tth-card)>colgroup>col:nth-child(1){width:6%!important}
#main table.pending-decisions-table:not(.tth-card)>colgroup>col:nth-child(2){width:24%!important}
#main table.pending-decisions-table:not(.tth-card)>colgroup>col:nth-child(3){width:55%!important}
#main table.pending-decisions-table:not(.tth-card)>colgroup>col:nth-child(4){width:15%!important}
@media(max-width:760px){
 #main table.tth-card>tbody>tr>td,#main table.tth-card>tbody>tr>th{grid-template-columns:minmax(74px,32%) minmax(0,1fr)!important;column-gap:6px!important}
 #main table.tth-card>tbody>tr>td:has(details),#main table.tth-card>tbody>tr>td:has(table),#main table.tth-card>tbody>tr>td:has(.tbl){display:block!important}
 #main .doc-sec, #main .card,#main .scope{padding:10px!important}
}
@media print{html,body{overflow-x:visible!important}#main .view{break-inside:auto}}
</style>
<style id="tth-fix-nhan-to-truong-18112026">
/* Chỉ chỉnh hiển thị nhãn Tổ trưởng; giữ nguyên dòng phụ, cơ cấu và nội dung. */
#v-org .org .pos > .lead,
#v-org .org-legend > .lead {
  display: inline-flex !important;
  visibility: visible !important;
  opacity: 1 !important;
  align-items: center !important;
  justify-content: center !important;
  align-self: center !important;
  flex: 0 1 auto !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: 100% !important;
  min-height: 22px !important;
  padding: 3px 9px !important;
  border: 1px solid #ED3237 !important;
  border-radius: 6px !important;
  background-color: #ED3237 !important;
  background-image: none !important;
  color: #FFFFFF !important;
  font-size: 11px !important;
  font-weight: 800 !important;
  line-height: 1.35 !important;
  white-space: normal !important;
  overflow-wrap: anywhere !important;
  text-align: center !important;
  text-shadow: none !important;
  box-shadow: none !important;
  text-decoration: none !important;
}
@media print {
  #v-org .org .pos > .lead, #v-org .org-legend > .lead {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
}
</style>
<style id="tth-ooh-flow-2027-style">

/* TTH – Luồng OOH 2027; khóa bố cục trong vùng nội dung, dùng khi mở file offline */
#v-org .org .pos .lead[aria-label*="Nội dung và Sáng tạo"]{background:#ED3237!important;color:#fff!important;border:1px solid #ED3237!important;font-weight:800!important;line-height:1.4!important;white-space:normal!important;max-width:100%!important;overflow-wrap:anywhere!important;text-align:center!important}
#v-ops .ooh-flow{box-sizing:border-box!important;width:100%!important;max-width:100%!important;min-width:0!important;margin:18px auto 26px!important;padding:18px!important;overflow:visible!important;border:1px solid #d2e3f3;border-radius:12px;background:#fff;box-shadow:0 2px 7px rgba(8,55,161,.045)}
#v-ops .ooh-flow *{box-sizing:border-box;min-width:0;max-width:100%;overflow-wrap:anywhere}
#v-ops .ooh-overline{font-size:11px;color:#ED3237;font-weight:900;letter-spacing:.6px;margin:0 0 6px}
#v-ops .ooh-flow .sec-h{line-height:1.4;font-size:22px;color:#0837A1;margin:0 0 12px}
#v-ops .ooh-intro{font-size:14px;line-height:1.65;color:#23436b;margin:7px 0 14px}
#v-ops .ooh-flow-summary{display:flex;flex-wrap:wrap;align-items:center;gap:6px;padding:11px;background:#f2f6ff;border:1px solid #d2e2f4;border-radius:9px;margin:12px 0}
#v-ops .ooh-flow-summary span{display:inline-block;flex:0 1 auto;border-radius:7px;border:1px solid #bcd0ef;background:#fff;color:#0837A1;font-size:12px;font-weight:800;padding:7px 9px;line-height:1.3}
#v-ops .ooh-flow-summary i{color:#ED3237;font-style:normal;font-size:18px;font-weight:800}
#v-ops .ooh-message{font-size:13px;line-height:1.65;color:#183a60;background:#fff9f9;border-left:4px solid #ED3237;border-radius:4px;padding:10px 13px;margin:13px 0 18px}
#v-ops .ooh-steps{display:grid;grid-template-columns:minmax(0,1fr);gap:11px}
#v-ops .ooh-step{border:1px solid #d6e2f2;background:#fff;border-radius:10px;min-width:0;max-width:100%;overflow:visible!important}
#v-ops .ooh-step-head{display:flex;align-items:center;gap:10px;padding:11px 13px;background:#eff5ff;border-radius:10px 10px 0 0}
#v-ops .ooh-no{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;color:white;background:#0837A1;border-radius:50%;font-weight:900;font-size:14px}
#v-ops .ooh-step h4{font-size:14px;line-height:1.4;color:#0837A1;margin:0}
#v-ops .ooh-step-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;padding:13px 15px 7px}
#v-ops .ooh-step-grid b{display:block;font-size:12px;color:#0837A1;margin-bottom:5px}
#v-ops .ooh-step-grid p,#v-ops .ooh-raci p{font-size:13px;line-height:1.6;margin:0 0 7px;color:#243a56}
#v-ops .ooh-gate{font-size:12.5px;line-height:1.6;color:#82332e;background:#fff5f4;border-top:1px solid #ffe1e0;margin:0;padding:9px 15px;border-radius:0 0 10px 10px}
#v-ops .ooh-gate b{color:#A32528}
#v-ops .ooh-gate span{font-size:9px;color:#ED3237}
#v-ops .ooh-h3{font-size:17px;color:#0837A1;margin:19px 0 10px}
#v-ops .ooh-raci{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin:0 0 10px}
#v-ops .ooh-raci article{border:1px solid #d3e0f2;border-radius:9px;padding:13px;background:#f8fbff}
#v-ops .ooh-raci h4{color:#0837A1;font-size:15px;margin:0 0 9px}
#v-ops .ooh-rules{border-left:3px solid #0837A1;padding:1px 0 1px 13px}
#v-ops .ooh-rules p{font-size:13px;line-height:1.65;color:#263e5a;margin:8px 0}
#v-ops .ooh-note{font-size:12.5px;line-height:1.65;padding:10px 12px;background:#f3f6fb;border-radius:7px;color:#3b5168}
@media(max-width:850px){#v-ops .ooh-step-grid,#v-ops .ooh-raci{grid-template-columns:minmax(0,1fr)!important}#v-ops .ooh-flow{padding:11px!important}#v-ops .ooh-flow-summary{padding:8px;gap:4px}#v-ops .ooh-flow-summary span{font-size:11px;padding:5px 7px}#v-ops .ooh-step-head{padding:9px}}
</style>

