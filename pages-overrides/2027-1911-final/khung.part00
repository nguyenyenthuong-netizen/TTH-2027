<style id="tth-org-layout-rebuild-2027">
/* Independent branches: avoid grid row spanning and empty second-column space. */
#v-org .org-cols{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;grid-template-rows:auto!important;grid-auto-flow:row!important;align-items:start!important;gap:16px!important;min-width:0!important}
#v-org .org-cols>.org-left,#v-org .org-cols>.org-right{display:flex!important;flex-direction:column!important;gap:12px!important;grid-column:auto!important;grid-row:auto!important;min-width:0!important;width:auto!important;margin:0!important}
#v-org .org-cols .col,#v-org .org-cols .mkt-org-cvt-2{min-width:0!important;width:100%!important;grid-column:auto!important;grid-row:auto!important;margin:0!important;align-self:start!important}
#v-org .org-right-teams{display:grid!important;grid-template-columns:minmax(0,1fr)!important;grid-auto-flow:row!important;gap:12px!important;align-items:start!important;min-width:0!important;width:100%!important}
#v-org .org-cols .col-h{box-sizing:border-box!important;display:block!important;position:relative!important;z-index:1!important;width:100%!important;height:auto!important;min-height:0!important;white-space:normal!important;overflow-wrap:break-word!important;overflow:visible!important;line-height:1.5!important;text-align:left!important;padding:14px 16px!important}
#v-org .org-cols .col-h small{display:block!important;white-space:normal!important;overflow-wrap:break-word!important;line-height:1.4!important;margin-top:4px!important}
#v-org .mkt-org-local-row{margin:16px 0 0;display:block;clear:both;max-width:100%;min-width:0}
#v-org .mkt-org-local-heading{padding:14px 16px;border-radius:12px 12px 0 0;border:1px solid #cbdcf1;background:#edf4fc;color:#0837A1;display:flex;flex-direction:column;gap:6px;line-height:1.45}
#v-org .mkt-org-local-heading strong{font-size:16px}#v-org .mkt-org-local-heading span{font-size:12.5px;color:#334d71}
#v-org .mkt-org-local-row>details{margin:0 0 10px;min-width:0;width:100%}
#v-org .mkt-org-local-row .hosp-grid{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
@media(max-width:1100px){#v-org .org-cols{grid-template-columns:minmax(0,1fr)!important}}
@media print{#v-org .org-cols{grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;break-inside:auto}}
/* Explicit functional reporting line from first chief's branch to local Marketing. */
#v-org .mkt-org-line-to-local{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;min-width:0;margin:0;padding:0;clear:both}
#v-org .mkt-org-line-path{grid-column:1;display:flex;flex-direction:column;align-items:center;position:relative;min-width:0;padding-top:9px}
#v-org .mkt-org-line-path:before{content:"";position:absolute;top:-14px;height:24px;width:3px;background:#0837A1;left:50%;transform:translateX(-50%)}
#v-org .mkt-org-line-caption{position:relative;z-index:1;max-width:calc(100% - 18px);padding:8px 12px;border-radius:9px;border:2px solid #0837A1;background:#f4f8ff;color:#0837A1;text-align:center;font-size:13px;font-weight:800;line-height:1.35;overflow-wrap:anywhere}
#v-org .mkt-org-line-caption small{display:block;margin-top:3px;color:#30496d;font-size:11px;font-weight:600}
#v-org .mkt-org-line-arrow{position:relative;z-index:1;line-height:1;font-size:32px;font-weight:900;color:#0837A1;margin-top:0;margin-bottom:-8px}
#v-org .mkt-org-local-heading{border-top:3px solid #0837A1}
@media(max-width:1100px){#v-org .mkt-org-line-to-local{grid-template-columns:minmax(0,1fr)}}
@media print{#v-org .mkt-org-line-to-local{grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important}}
</style>
