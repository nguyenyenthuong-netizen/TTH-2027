hàng chứa dữ liệu cá nhân vượt quyền hoặc thiếu căn cứ sử dụng","Có thay đổi sau phê duyệt nhưng chưa tái kiểm soát"],"tieu_chi_nghiem_thu":["Có đủ thành phần bắt buộc hoặc lý do không áp dụng đã được chấp thuận","Có mã hồ sơ nguồn và minh chứng đối soát","Người kiểm chuyên môn và người phê duyệt được phân tách theo thẩm quyền","Khôi phục được phiên bản cũ; truy ra người sửa, thời gian, lý do"],"che_do_xuat":"HTML/PDF đọc được và dữ liệu bảng CSV/XLSX (chỉ với dữ liệu bảng); giữ tiếng Việt Unicode, mã và phiên bản","xu_ly_chua_co_phan_mem":"Dùng bảng tính/tệp có mã bản ghi, phiên bản và nhật ký phê duyệt; quyền truy cập được kiểm soát, không lưu dữ liệu người bệnh vào bản trình","trang_thai":"ĐẶC TẢ ĐỀ XUẤT – chờ đơn vị nắm giữ, đơn vị duyệt và Phòng Quản lý chất lượng xác nhận trước ban hành","bao_cao_y_te":{"doi_soat":["Mã kế hoạch, nhóm thương hiệu, cơ sở, kênh, dịch vụ/chuyên khoa","Mục tiêu, thông điệp đã duyệt, nguồn chứng cứ","Sản phẩm, đơn vị chủ trì, hạn, người kiểm, người duyệt"],"chi_so":["Số nội dung theo loại và theo kênh","Tải công việc dự kiến và tồn kho nội dung"],"giai_trinh":["Điều kiện tuân thủ quảng cáo khám chữa bệnh khi có yếu tố dịch vụ/giá/hiệu quả","Ngày hết hiệu lực và quy tắc thu hồi"],"luu_y":"Lịch nội dung không được coi là giấy phép phát hành."},"truong_kiem_soat_chung":["ma_ban_ghi","ma_nguon","nguoi_lap","thoi_diem_lap","trang_thai","phien_ban","nguoi_xac_nhan","nguoi_duyet","lich_su_sua","nguon_du_lieu"]}},{"ma":"BM-4","loai":"Sổ","ten":"Lịch sản xuất chung","noi_dung":"Số yêu cầu; sản phẩm, cấp độ; người làm, người kiểm; hạn; thứ tự ưu tiên; lịch ghi hình; trạng thái; giờ; cho phép làm thay","xay_dung":["cvt"],"nam_giu":"tt-nd","cap_nhat":["tt-nd"],"duyet":["cvt"],"dung":["Mọi vị trí theo quyền"],"noi_luu_co_pm":"Phần mềm, cập nhật hằng ngày; tự xếp theo bảng phân công","noi_luu_chua_pm":"Trang tính lịch sản xuất trong sổ yêu cầu dùng chung","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"mục 30.5; mục 14.9; QT.30","so_cu":39,"tr