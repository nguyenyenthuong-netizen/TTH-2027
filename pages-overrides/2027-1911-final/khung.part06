 quyền hoặc thiếu căn cứ sử dụng","Có thay đổi sau phê duyệt nhưng chưa tái kiểm soát"],"tieu_chi_nghiem_thu":["Có đủ thành phần bắt buộc hoặc lý do không áp dụng đã được chấp thuận","Có mã hồ sơ nguồn và minh chứng đối soát","Người kiểm chuyên môn và người phê duyệt được phân tách theo thẩm quyền","Khôi phục được phiên bản cũ; truy ra người sửa, thời gian, lý do"],"che_do_xuat":"HTML/PDF đọc được và dữ liệu bảng CSV/XLSX (chỉ với dữ liệu bảng); giữ tiếng Việt Unicode, mã và phiên bản","xu_ly_chua_co_phan_mem":"Dùng bảng tính/tệp có mã bản ghi, phiên bản và nhật ký phê duyệt; quyền truy cập được kiểm soát, không lưu dữ liệu người bệnh vào bản trình","trang_thai":"ĐẶC TẢ ĐỀ XUẤT – chờ đơn vị nắm giữ, đơn vị duyệt và Phòng Quản lý chất lượng xác nhận trước ban hành","truong_kiem_soat_chung":["ma_ban_ghi","ma_nguon","nguoi_lap","thoi_diem_lap","trang_thai","phien_ban","nguoi_xac_nhan","nguoi_duyet","lich_su_sua","nguon_du_lieu"]}},{"ma":"BM-7","loai":"Biểu mẫu","ten":"Mẫu yêu cầu sản xuất","noi_dung":"Ô bắt buộc để phần mềm tự xác nhận, tự giao","xay_dung":["cvt"],"nam_giu":"cvt","cap_nhat":["cvt"],"duyet":["tp"],"dung":["qlth","tn","qlsps","cvtt","tuyen-dung"],"noi_luu_co_pm":"Cổng tiếp nhận yêu cầu","noi_luu_chua_pm":"Sổ yêu cầu dùng chung (bảng tính)","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"QT.2; mục 14.6, 14.12","so_cu":1,"truong":[{"ma_truong":"ma_hang_muc","ten":"Mã Hạng mục hoặc mã việc định kỳ","bat_buoc":true,"nguon":"Kế hoạch Hạng mục (BM-8), BM-3","nguoi_nhap":"Người gửi","nguoi_xem":"Mọi vị trí","loai_du_lieu":"text-id","quy_tac_kiem_tra":"Bắt buộc; Mã duy nhất, không để trống, không tái sử dụng cho bản ghi khác","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"},{"ma_truong":"nhom_thuong_hieu","ten":"Nhóm thương hiệu","bat_buoc":true,"nguon":"Danh mục nhóm","nguoi_nhap":"Người gửi","nguoi_xem":"Mọi vị trí","loai_du_lieu":"enum","quy_tac_kiem_tra":"Bắt buộc; Chọn từ danh mục đang hiệu l