UẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["tp"],"nguoi_nam_giu":"dl-1","danh_sach_nguoi_duyet":["btgd"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm.","bo_tieu_chuan_19112026":{"tham_chieu":"mục 30.5; QT.41","thanh_phan_bat_buoc":["Mã biểu mẫu và phiên bản","Mã việc/chương trình hoặc kỳ báo cáo","Nhóm thương hiệu – cơ sở – chuyên khoa/dịch vụ nếu có","Người lập và người xác nhận","Thời điểm chốt, tài liệu nguồn","Trạng thái, lịch sử sửa, dấu vết duyệt"],"dieu_kien_chan":["Không có mã/phiên bản/phạm vi áp dụng hoặc mất nguồn xác nhận","Người tự làm tự duyệt khi không có ủy quyền phù hợp","Hồ sơ y tế/khách hàng chứa dữ liệu cá nhân vượt quyền hoặc thiếu căn cứ sử dụng","Có thay đổi sau phê duyệt nhưng chưa tái kiểm soát"],"tieu_chi_nghiem_thu":["Có đủ thành phần bắt buộc hoặc lý do không áp dụng đã được chấp thuận","Có mã hồ sơ nguồn và minh chứng đối soát","Người kiểm chuyên môn và người phê duyệt được phân tách theo thẩm quyền","Khôi phục được phiên bản cũ; truy ra người sửa, thời gian, lý do"],"che_do_xuat":"HTML/PDF đọc được và dữ liệu bảng CSV/XLSX (chỉ với dữ liệu bảng); giữ tiếng Việt Unicode, mã và phiên bản","xu_ly_chua_co_phan_mem":"Dùng bảng tính/tệp có mã bản ghi, phiên bản và nhật ký phê duyệt; quyền truy cập được kiểm soát, không lưu dữ liệu người bệnh vào bản trình","trang_thai":"ĐẶC TẢ ĐỀ XUẤT – chờ đơn vị nắm giữ, đơn vị duyệt và Phòng Quản lý chất lượng xác nhận trước ban hành","bao_cao_y_te":{"doi_soat":["Tổng yêu cầu tiếp nhận theo nguồn/kênh/cơ sở","Lead hợp lệ và nguyên nhân loại","Lịch đặt có mã","Khách đến theo dữ liệu tiếp đón","Khách thực hiện dịch vụ theo dữ liệu nghiệp vụ đã đối soát","Doanh thu ghi nhận bởi hệ thống tài chính (nếu được cấp quyền)"],"chi_so":["Chi phí được duyệt, thực chi, cam kết chi, dự báo","Tỷ lệ đặt lịch trên Lead hợp lệ","Tỷ lệ khách đến trên lịch hẹn","Tỷ lệ thực hiện dịch vụ trên khách đến","Chi phí/Lead hợp lệ; chi phí/lịch hẹn; chi phí/khách thực hiện dịch vụ"],"giai_trinh":["So sánh kế hoạch – thực tế – kỳ trước theo từng bệnh viện/chuyên khoa","Sai lệch số liệu, đối soát chéo Contact Center/CRM/tiếp đón/tài chính","Rủi ro pháp lý quảng cáo và điểm chặn","Người chịu trách nhiệm, hạn khắc phục, chứng cứ đóng việc"],"luu_y":"Không đồng nhất Lead, đặt lịch, khách đến và khách khám; báo cáo lãnh đạo dùng số tổng hợp, không kèm định danh bệnh nhân."},"truong_kiem_soat_chung":["ma_ban_ghi","ma_nguon","nguoi_lap","thoi_diem_lap","trang_thai","phien_ban","nguoi_xac_nhan","nguoi_duyet","lich_su_sua","nguon_du_lieu"]}},{"ma":"BM-2","loai":"Biểu mẫu","ten":"Báo cáo tuần","noi_dung":"Khung chung 02 phần khi chưa có phần mềm; dựng tự động khi có phần mềm","xay_dung":["dl-1"],"nam_giu":"dl-1","cap_nhat":["dl-1"],"duyet":["tp"],"dung":["Mọi vị trí theo quyền"],"noi_luu_co_pm":"Phần mềm, trước 10:00 thứ Bảy","noi_luu_chua_pm":"Bảng tính 02 phần","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"mục 30.5; 29/BB-TTH","so_cu":37,"truong":[{"ma_truong":"tuan_bao_cao","ten":"Tuần