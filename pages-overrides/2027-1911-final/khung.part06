ác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-tam-ngung-doi-gio"},{"id":"phat-truc-tiep","ten":"Phát trực tiếp trên kênh chính thức (tư vấn sức khỏe, sự kiện, hội thảo)","nhom_hoat_dong":["N3","N6","N2"],"vi_du":"Tổng công ty phát trực tiếp chương trình tư vấn sức khỏe của bác sĩ Bệnh viện Đa khoa TTH Vinh trên Facebook của bệnh viện; Chuyên viên Marketing cơ sở – media vận hành máy quay tại bệnh viện.","buoc":[{"thuc_hien":["qlth"],"phoi_hop":["tn|bác sĩ, địa điểm tại cơ sở","tt-nd|lịch sản xuất chung"],"noi_dung":"Đưa buổi phát trực tiếp vào kế hoạch Hạng mục hoặc kế hoạch tháng: chủ đề, kênh, ngày giờ, bác sĩ, người dẫn; xếp vào lịch sản xuất chung.","thoi_han":"Theo kế hoạch tháng (Trưởng phòng duyệt chậm nhất ngày 20)","ghi_nhan":"Kế hoạch tháng; lịch sản xuất chung","can_cu":"mục 4.2; QT.1","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Trang tính BM-3 của nhóm","chu_tri_chinh":"qlth","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Kế hoạch tháng; lịch sản xuất chung","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_nguoi_xac_nhan_chuyen_mon":true,"can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["bt"],"phoi_hop":["bac-si|xác nhận chuyên môn"],"noi_dung":"Kịch bản: nội dung, câu hỏi dự kiến; giá, ưu đãi chỉ nói khi thuộc Hạng mục đã duyệt và kế toán đã xác nhận; không nêu thông tin người bệnh. Bác sĩ xác nhận chuyên môn; kiểm pháp lý theo tầng (mục 15.6); Quản lý thương hiệu của nhóm nghiệm thu; buổi phát có báo chí, rủi ro cao: Trưởng phòng duyệt (mục 14.16).","thoi_han":"03 ngày làm việc trước buổi phát","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 16.1; mục 14.8","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"bt","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Cổng tiếp nhận yêu cầu","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_nguoi_xac_nhan_chuyen_mon":true,"can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["md","mdcs"],"phoi_hop":["tk|hình hiệu, khung hình","tn|giao việc Chuyên viên Marketing cơ sở – media"],"noi_dung":"Chuẩn bị kỹ thuật: thiết bị, đường truyền, hình hiệu, khung hình theo mẫu thiết kế sẵn; phát thử. Buổi phát tại cơ sở: Chuyên viên Marketing cơ sở – media vận hành máy quay theo lịch chung, giao qua Trưởng nhóm; nội dung, kênh do Tổng công ty giữ.","thoi_han":"Phát thử trước buổi phát 01 ngày làm việc","ghi_nhan":"Lịch sản xuất chung","can_cu":"mục 8; mục 15.3","de_xuat":true,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc