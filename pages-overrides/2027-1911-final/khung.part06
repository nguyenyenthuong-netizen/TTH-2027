n chéo thương hiệu","loai_du_lieu":"rows","bat_buoc":false,"nguon":"Hồ sơ nghiệp vụ nguồn gắn mã bản ghi; người lập phải dẫn chứng và người đối soát kiểm tra","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền","quy_tac_kiem_tra":"Có thể để trống nếu lý do không áp dụng được ghi; Bảng dòng có định danh và tổng đối chiếu","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"},{"ma_truong":"bai_hoc","ten":"Bài học, cải tiến","loai_du_lieu":"text","bat_buoc":false,"nguon":"Hồ sơ nghiệp vụ nguồn gắn mã bản ghi; người lập phải dẫn chứng và người đối soát kiểm tra","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền","quy_tac_kiem_tra":"Có thể để trống nếu lý do không áp dụng được ghi; Nội dung có căn cứ, không chỉ ghi “đã làm”","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"}],"ban_theo_nhom":true,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["qlth"],"nguoi_nam_giu":"dl-1","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","