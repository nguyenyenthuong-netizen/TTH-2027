lập phải dẫn chứng và người đối soát kiểm tra","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền","quy_tac_kiem_tra":"Bắt buộc; Chọn từ danh mục đang hiệu lực, không nhập tùy ý","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["tt-nd","tt-ts","tp"],"nguoi_nam_giu":"cvt","danh_sach_nguoi_duyet":["tt-nd","tt-ts","tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung.","Chặn lịch nghỉ trùng người thay chính hoặc trùng công việc có hạn theo R12."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm.","bo_tieu_chuan_19112026":{"tham_chieu":"QT.7; mục 15.4","thanh_phan_bat_buoc":["Mã biểu mẫu và phiên bản","Mã việc/chương trình hoặc kỳ báo cáo","Nhóm thương hiệu – cơ sở – chuyên khoa/dịch vụ nếu có","Người lập và người xác nhận","Thời điểm chốt, tài liệu nguồn","Trạng thái, lịch sử sửa, dấu vết duyệt"],"dieu_kien_chan":["Không có mã/phiên bản/phạm vi áp dụng hoặc mất nguồn xác nhận","Người tự làm tự duyệt khi không có ủy quyền phù hợp","Hồ sơ y tế/khách hàng chứa dữ liệu cá nhân vượt quyền hoặc thiếu căn cứ sử dụng","Có thay đổi sau phê duyệt nhưng chưa tái kiểm soát"],"tieu_chi_nghiem_thu":["Có đủ thành phần bắt buộc hoặc lý do không áp dụng đã được chấp thuận","Có mã hồ sơ nguồn và minh chứng đối soát","Người kiểm chuyên môn và người phê duyệt được phân tách theo thẩm quyền","Khôi phục được phiên bản cũ; truy ra người sửa, thời gian, lý do"],"che_do_xuat":"HTML/PDF đọc được và dữ liệu bảng CSV/XLSX (chỉ với dữ liệu bảng); giữ tiếng Việt Unicode, mã và phiên bản","xu_ly_chua_co_phan_mem":"Dùng bảng tính/tệp có mã bản ghi, phiên bản và nhật ký phê duyệt; quyền truy cập được kiểm soát, không lưu dữ liệu người bệnh vào bản trình","trang_thai":"ĐẶC TẢ ĐỀ XUẤT – chờ đơn vị nắm giữ, đơn vị duyệt và Phòng Quản lý chất lượng xác nhận trước ban hành","truong_kiem_soat_chung":["ma_ban_ghi","ma_nguon","nguoi_lap","thoi_diem_lap","trang_thai","phien_ban","nguoi_xac_nhan","nguoi_duyet","lich_su_sua","nguon_du_lieu"]}},{"ma":"BM-23","loai":"Biểu mẫu","ten":"Biên bản cấp, thu hồi quyền tạm","noi_dung":"Hệ thống, phần quyền, ngày cấp, ngày thu hồi theo thời hạn cho phép làm thay","xay_dung":["cvt"],"nam_giu":"cvt","cap_nhat":["cvt"],"duyet":["tp"],"dung":["cvt"],"noi_luu_co_pm":"Phần mềm tự ghi","noi_luu_chua_pm":"Biên bản theo mẫu","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"mục 15.4; mục 11.3","so_cu":null,"truong":[{"ma_truong":"ma_giay_phep","ten":"Mã cho phép làm thay","loai_du_lieu":"relation","bat_buoc":true,"nguon":"Hồ sơ nghiệp vụ nguồn gắn mã bản ghi; người lập phải dẫn chứng và người đối soát kiểm tra","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duy