n hành","truong_kiem_soat_chung":["ma_ban_ghi","ma_nguon","nguoi_lap","thoi_diem_lap","trang_thai","phien_ban","nguoi_xac_nhan","nguoi_duyet","lich_su_sua","nguon_du_lieu"]}},{"ma":"BM-9","loai":"Biểu mẫu","ten":"Tờ trình chi Hạng mục","noi_dung":"Nội dung chi, dự toán, nguồn ngân sách, xác nhận của Giám đốc cơ sở khi dùng ngân sách cơ sở; ghi loại chi: chi mới ngoài hạn mức (Tổng Giám đốc duyệt) hoặc chi trong hạn mức đã duyệt (Phó Tổng Giám đốc mảng tài chính duyệt) – R28","xay_dung":["cvt"],"nam_giu":"cvt","cap_nhat":["qlth"],"duyet":["tp","gd-coso","ptgd-tc","btgd"],"dung":["qlth","ke-toan"],"noi_luu_co_pm":"Phần mềm","noi_luu_chua_pm":"Tờ trình trên Workit, ghi mã Hạng mục","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"mục 4.2, 14.16; Quy chế chi tiêu nội bộ (189/QĐ-TTH) Điều 3.1","so_cu":4,"truong":[{"ma_truong":"ma_hang_muc","ten":"Hạng mục chi","loai_du_lieu":"relation","bat_buoc":true,"nguon":"Mốc thời gian thực tế có dấu vết trong lịch sản xuất/hồ sơ yêu cầu; không tự điền mặc định","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền","quy_tac_kiem_tra":"Bắt buộc; Khóa ngoại tồn tại, không trùng nguồn","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"},{"ma_truong":"noi_dung_chi","ten":"Nội dung chi","loai_du_lieu":"text","bat_buoc":true,"nguon":"Hồ sơ nghiệp vụ nguồn gắn mã bản ghi; người lập phải dẫn chứng và người đối soát kiểm tra","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền","quy_tac_kiem_tra":"Bắt buộc; Nội dung có căn cứ, không chỉ ghi “đã làm”","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"},{"ma_truong":"loai_chi_R28","ten":"Trong hạn mức hoặc chi mới