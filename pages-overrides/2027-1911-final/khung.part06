:false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qlth"],"phoi_hop":["dl-1|chi đã phát sinh, đối soát"],"noi_dung":"Cập nhật kế hoạch trên phần mềm, giữ bản trước điều chỉnh; báo cáo Hạng mục ghi lý do điều chỉnh, chi đã phát sinh.","thoi_han":"Sau khi điều chỉnh","ghi_nhan":"Kế hoạch, báo cáo Hạng mục trên phần mềm","can_cu":"QT.1; mục 9.4, số 5","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung; Bảng tính chốt kỳ, báo cáo lập theo mẫu","chu_tri_chinh":"qlth","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Kế hoạch, báo cáo Hạng mục trên phần mềm","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"}],"kiem_soat":["Mọi điều chỉnh qua cổng tiếp nhận yêu cầu; không điều chỉnh qua tin nhắn riêng (mục 14.1, số 3)","Giữ bản kế hoạch trước điều chỉnh trên phần mềm","Chi đã phát sinh ghi đúng Hạng mục; không chuyển sang Hạng mục khác để tránh vượt hạn mức"],"ngoai_le":[{"tinh_huong":"Ban Tổng Giám đốc chỉ đạo mới làm thay đổi kế hoạch","cach_lam":"Trưởng phòng trình phương án lùi Hạng mục nào, nguồn chi trước khi triển khai (QT.41, bước 4)."},{"tinh_huong":"Sự kiện, hội nghị hoãn, hủy","cach_lam":"Theo QT.21, QT.12."},{"tinh_huong":"Cơ sở tạm ngừng dịch vụ, đổi giờ làm việc","cach_lam":"Theo QT.46."},{"tinh_huong":"Ưu đãi đã công bố bị hủy, đổi điều kiện","cach_lam":"Đính chính theo QT.38; khách đã đăng ký: bộ phận tiếp nhận, xử lý phản ánh của cơ sở giải quyết (QT.1, ngoại lệ)."},{"tinh_huong":"Cần làm gấp hơn thời hạn chuẩn sau khi điều chỉnh","cach_lam":"Theo QT.31."}],"nhom_vi_du":"N1","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-dieu-chinh-ke-hoach"}],"lich_van_hanh":[{"tan_suat":"Hằng ngày","viec":"Rà soát thông tin, bình luận trên kênh","can_cu":"QT.MKT.09, QĐ.MKT.11","phu_trach":"Bình luận hỏi dịch vụ: Contact Center. Thông tin vi phạm: Chuyên viên quảng cáo và kênh số của nhóm. Dư luận về thương hiệu của nhóm: Chuyên viên truyền thông của nhóm"},{"tan_suat":"Hằng ngày","viec":"Trực tin nhắn theo ca","can_cu":"QyĐ.02.MKT, QĐ.MKT.11","phu_trach":"Contact Center (trước khi nhận: người đang trả lời tại cơ sở, mục 17)"},{"tan_suat":"Hằng ngày","viec":"Báo cáo trực trang Facebook cuối ngày","can_cu":"QĐ.MKT.11","phu_trach":"Contact Center (báo cáo từ hệ thống); trước khi nhận: người đang trả lời tại cơ sở"},{"tan_suat":"Hằng ngày","viec":"Theo dõi thực hiện kế hoạch","can_cu":"QT.MKT.22","phu_trach":"Người phụ trách Hoạt động trên phần mềm; Quản lý thương hiệu theo Hạng mục"},{"tan_suat":"Hằng tuần","viec":"Giao ban nội bộ phòng tại Tổng công ty 09:00 thứ Ba (nhân sự Tổng công ty; người làm việc tạm tại chi nhánh dự trực tuyến, mục I.4); Marketing cơ sở giao ban nội bộ tại cơ sở 01–02 lần","can_cu":"QyĐ.02.MKT; Phòng Marketing Tổng công ty xác nhận ngày 11/11/2026","phu_trach":"Tổng công ty: Trưởng phòng chủ trì; Trưởng phòng vắng hoặc chưa có: Chuyên viên trưởng. Cơ sở: Trưởng nhóm"},{"tan_suat":"Hằng tuần","viec":"Báo cáo tuần, gửi trước 10:00 thứ Bảy","can_cu":"29/BB-TTH","phu_trach":"Dựng tự động; Chuyên viên đo lường và đối soát"},{"tan_suat":"Hằng tuần","viec":"Lịch khám cộng đồng trước 17:00 thứ Sáu","can_cu":"QT.06.MKT","phu_trach":"Truyền thông cơ sở (lịch dựng từ Hoạt động)"},{"tan_suat":"Hằng tuần","viec":"Kế hoạch phát thanh nội viện trước thứ Tư; phát thứ Hai","can_cu":"QT.MKT.22","phu_trach":"Lịch: Chuyên viên truyền thông của nhóm. Kịch bản: Chuyên viên biên tập của nhóm. Thu âm: Chuyên viên media của nhóm. Phát: Chuyên viên Marketing cơ sở – truyền thông (bệnh viện 02 người: Trưởng nhóm kiêm) (QT.29)"},{"tan_suat":"Hằng tháng","viec":"Giao ban Marketing ngành dọc, tuần thứ 2: 01 cuộc chia 03 phần (phần chung; phần nhóm 1; phần nhóm 2)","can_cu":"QyĐ.02.MKT; 29/BB-TTH","phu_trach":"Trưởng phòng chủ trì; Quản lý thương hiệu, Trưởng nhóm"},{"tan_suat":"Hằng tháng","viec":"Kế hoạch tháng","can_cu":"29/BB-TTH, QyĐ.03.MKT, QT.MKT.22","phu_trach":"Ngày 10–15: Trưởng nhóm Marketing cơ sở gửi nhu cầu tháng; Quản lý thương hiệu của nhóm lập BM-3, trình chậm nhất ngày 18; Trưởng phòng duyệt chậm nhất ngày 20; người trình, người duyệt không nghỉ ngày 18–20 (mục 16, số 12)"},{"tan_suat":"Hằng tháng","viec":"Kế hoạch quảng cáo ngày 20–25, gồm kế hoạch cho Công ty Cổ phần Winmed Việt Nam","can_cu":"QT.05.MKT.TCT","phu_trach":"Chuyên viên quảng cáo và kênh số theo nhóm thương hiệu. Winmed (nhóm 2): Winmed gửi nhu cầu; Quản lý thương hiệu nhóm 2 lập kế hoạch; Chuyên viên quảng cáo và kênh số nhóm 2 triển khai"},{"tan_suat":"Hằng tháng","viec":"Số liệu hoạt động tháng (kỳ số liệu: tháng dương lịch), chốt kỳ trong 03 ngày làm việc đầu tháng sau; gồm yêu cầu gấp (QT.31), giờ","can_cu":"Phương án theo dõi","phu_trach":"Dựng tự động; Chuyên viên đo lường và đối soát chốt kỳ; Trưởng phòng duyệt bản chốt kỳ (mục 14.16)"},{"tan_suat":"Hằng tháng","viec":"Cập nhật danh sách từ khóa, hình ảnh, video bị cấm","can_cu":"QyĐ.05.MKT","phu_trach":"Quản lý sản phẩm số (dùng chung cả hai nhóm); Chuyên viên trưởng duyệt"},{"tan_suat":"Hằng tháng","viec":"Báo cáo thông tin công cộng","can_cu":"QT.MKT.09","phu_trach":"Chuyên viên quảng cáo và kênh số của nhóm (kênh của nhóm)"},{"tan_suat":"Hằng tháng","viec":"Báo cáo phản hồi khách hàng","can_cu":"QT.18.MAR","phu_trach":"Contact Center; bộ phận xử lý phản ánh (chuyển ra – mục 18)"},{"tan_suat":"Hằng tháng","viec":"Chủ đề chương trình truyền hình, đề xuất sự kiện trước ngày 28; lịch phát trước ngày 01 tháng sau","can_cu":"QT.37.MAR, QT.MKT.13","phu_trach":"Trưởng nhóm thu đề xuất của khoa; truyền thông cơ sở (sự kiện); Chuyên viên truyền thông của nhóm (truyền hình)"},{"tan_suat":"Hằng tháng","viec":"Vật tư khám cộng đồng","can_cu":"QT.05.MKT","phu_trach":"Khoa phòng, kế toán (chuyển ra – mục 18)"},{"tan_suat":"Hằng tháng","viec":"Báo cáo sử dụng hình ảnh khách hàng; đối chiếu thời hạn giấy đồng ý, gỡ hình ảnh hết hạn (QT.48)","can_cu":"Quy trình sử dụng hình ảnh (Hà Tĩnh)","phu_trach":"Chuyên viên dữ liệu khách hàng và thị trường; cơ sở cung cấp số giấy đồng ý"},{"tan_suat":"Hằng tháng","viec":"Báo cáo tháng, sơ kết tháng ngày 25; báo cáo Ban Tổng Giám đốc. Số liệu tính KPI theo bản chốt kỳ ngày làm việc đầu tháng sau","can_cu":"QyĐ.02.MKT; QT.41; Phòng Marketing Tổng công ty xác nhận ngày 11/11/2026","phu_trach":"Trưởng phòng; số liệu: Chuyên viên đo lường và đối soát"},{"tan_suat":"Hằng quý","viec":"Sơ kết quý, báo cáo quý","can_cu":"QyĐ.02.MKT","phu_trach":"Trưởng phòng; Chuyên viên đo lường và đối soát"},{"tan_suat":"Hằng quý","viec":"Hội thảo chia sẻ giữa các cơ sở","can_cu":"29/BB-TTH","phu_trach":"Chuyên viên trưởng"},{"tan_suat":"6 tháng","viec":"Sơ kết 6 tháng","can_cu":"QyĐ.02.MKT","phu_trach":"Trưởng phòng; Chuyên viên đo lường và đối soát"},{"tan_suat":"Hằng năm","viec":"Tổng kết năm; kế hoạch năm; phân bổ bài trang cộng đồng trên mạng xã hội","can_cu":"QyĐ.02.MKT, QT.MKT.22, QyĐ.03.MKT","phu_trach":"Trưởng phòng; Quản lý thương hiệu; Chuyên viên quảng cáo và kênh số (trang cộng đồng trên mạng xã hội)"},{"tan_suat":"Theo sự việc","viec":"Thu hồi quyền kênh 01 ngày / 48 giờ","can_cu":"QyĐ.05.MKT","phu_trach":"Quyền quản trị: Trưởng phòng; quyền đăng bài, trả lời tin nhắn, kho tư liệu: Chuyên viên trưởng; hệ thống khác: người cấp quyền của hệ thống đó (mục 11.3; QT.17)"},{"tan_suat":"Theo sự việc","viec":"Sự cố kênh: báo 30 phút, báo cáo 48 giờ","can_cu":"QyĐ.05.MKT","phu_trach":"Báo: Trưởng nhóm, người phát hiện. Xử lý: Chuyên viên quảng cáo và kênh số của nhóm. Khủng hoảng: Chuyên viên truyền thông của nhóm"},{"tan_suat":"Theo sự việc","viec":"Gỡ thông tin vi phạm trong 3 giờ","can_cu":"QT.MKT.09","phu_trach":"Chuyên viên quảng cáo và kênh số của nhóm (ngoài giờ: người trực tầng 1)"},{"tan_suat":"Theo sự việc","viec":"Báo cáo chiến dịch quảng cáo 02 ngày sau kết thúc","can_cu":"QT.05.MKT.TCT","phu_trach":"Chuyên viên quảng cáo và kênh số của nhóm"},{"tan_suat":"Theo sự việc","viec":"Tin bài sau sự kiện","can_cu":"QT.04.MKT.TCT, QĐ.15.MAR, QĐ.MKT.05","phu_trach":"Tin hoạt động trong ngày: Trưởng nhóm Marketing cơ sở, trong 04 giờ; bài hoàn chỉnh: Chuyên viên biên tập của nhóm, trong 12 giờ (mục 16, số 13)"},{"tan_suat":"Theo sự việc","viec":"Tổng duyệt sự kiện trước 01 ngày","can_cu":"QT.MKT.13","phu_trach":"Truyền thông cơ sở (sự kiện tại cơ sở); Quản lý thương hiệu (sự kiện hệ thống)"},{"tan_suat":"Theo sự việc","viec":"Báo cáo nhanh 01 ngày sau khi kết thúc kế hoạch; kết quả chính thức sau kỳ chốt số liệu","can_cu":"QT.MKT.22","phu_trach":"Quản lý thương hiệu (theo mẫu Tổng kết Hạng mục)"},{"tan_suat":"Theo sự việc","viec":"Yêu cầu tư liệu media: tự xác nhận khi đủ ô; yêu cầu cần Tổ trưởng xử lý được xử lý trong 04 giờ làm việc","can_cu":"QyĐ.04.MKT","phu_trach":"Tổ trưởng Tổ Nội dung và Sáng tạo (yêu cầu cần xử lý; mục 16, số 14)"},{"tan_suat":"Hằng tháng","viec":"Theo dõi tổng chi Marketing so với ngân sách năm","can_cu":"Bổ sung (mục 11.2, việc 36)","phu_trach":"Chuyên viên đo lường và đối soát"},{"tan_suat":"Hằng tháng","viec":"Cập nhật chính sách các nền tảng","can_cu":"Bổ sung (mục 11.2, việc 39)","phu_trach":"Quản lý sản phẩm số (dùng chung cả hai nhóm); Chuyên viên trưởng duyệt; Chuyên viên quảng cáo và kênh số của nhóm áp dụng"},{"tan_suat":"Hằng quý","viec":"Kiểm tra tuân thủ nhận diện tại các cơ sở","can_cu":"Bổ sung (mục 11.2, việc 37)","phu_trach":"Chuyên viên thiết kế ngoại tuyến (sản phẩm do chính mình làm: Chuyên viên thiết kế của nhóm có cơ sở); biển bảng: Chuyên viên truyền thông của nhóm"},{"tan_suat":"Hằng tháng","viec":"Rà soát chất lượng dữ liệu khách hàng: hồ sơ trùng, thiếu đồng ý (khi CRM vận hành)","can_cu":"Bổ sung (mục 17.1)","phu_trach":"Chuyên viên dữ liệu khách hàng và thị trường"},{"tan_suat":"Hằng tháng","viec":"Danh sách bài, trang nội dung y khoa đến hạn rà soát; đối chiếu thông tin công khai (giá, người hành nghề, dịch vụ, kỹ thuật được phép) với dữ liệu của cơ sở (Đề xuất – chờ duyệt)","can_cu":"Bổ sung (mục 31, mảng 4, 43)","phu_trach":"Quản lý sản phẩm số; Chuyên viên biên tập của nhóm rà soát, bác sĩ xác nhận lại (QT.28)"},{"tan_suat":"Hằng quý","viec":"Tổng hợp mạo danh trên mạng: số vụ phát hiện, đã gỡ, đang xử lý","can_cu":"Bổ sung (mục 31, mảng 42)","phu_trach":"Chuyên viên truyền thông của nhóm; Chuyên viên trưởng tổng hợp khi cả hai nhóm"},{"tan_suat":"Hằng năm","viec":"Đào tạo nhắc lại pháp luật quảng cáo y tế, bảo vệ dữ liệu cá nhân","can_cu":"Bổ sung (mục 9.2)","phu_trach":"Bộ phận pháp chế; Chuyên viên biên tập của nhóm (phần chuyên khoa)"},{"tan_suat":"Theo sự việc","viec":"Cập nhật danh sách kiểm tra pháp lý khi pháp luật thay đổi","can_cu":"Bổ sung (mục 11.2, việc 39)","phu_trach":"Bộ phận pháp chế cung cấp; Trưởng phòng duyệt; Chuyên viên biên tập của nhóm sửa mẫu, kịch bản của nhóm (QT.18)"},{"tan_suat":"Hằng ngày","viec":"Tin trong ngày theo danh mục trên Facebook của bệnh viện","can_cu":"Bổ sung (mục 16, số 5, 13)","phu_trach":"Trưởng nhóm cơ sở khi có quyền đăng hợp lệ; Media cơ sở chỉ đăng thay theo ủy quyền riêng và lưu nhật ký."},{"tan_suat":"Hằng tuần","viec":"Theo dõi giờ dự phòng","can_cu":"Bổ sung (mục 16, số 16)","phu_trach":"Tổ trưởng của tổ (Tổ Truyền thông và Thương hiệu: Chuyên viên trưởng); Trưởng nhóm tại cơ sở. Dự phòng dùng hết quá 02 tuần: Chuyên viên trưởng báo Trưởng phòng"},{"tan_suat":"Hằng tháng","viec":"Kế hoạch SEO trong kế hoạch tháng","can_cu":"Bổ sung (mục 11.1, số 23)","phu_trach":"Quản lý sản phẩm số; Trưởng phòng duyệt cùng kế hoạch tháng"},{"tan_suat":"Hằng quý","viec":"Chấm KPI quý trong 05 ngày làm việc đầu quý sau (Quý I/2027: chấm KPI, tính thử thưởng, chưa chi)","can_cu":"Bổ sung (mục 24)","phu_trach":"Chuyên viên đo lường và đối soát tính; Trưởng phòng duyệt"},{"tan_suat":"Hằng quý","viec":"Rà soát định biên trong 10 ngày làm việc đầu quý sau; cân giờ theo từng người","can_cu":"Bổ sung (mục 21)","phu_trach":"Chuyên viên trưởng tính, đề xuất (số giờ theo sổ theo dõi yêu cầu: Chuyên viên đo lường và đối soát); Trưởng phòng duyệt"},{"tan_suat":"Hằng quý","viec":"Làm thực tế phần việc phụ tối thiểu 01 lần","can_cu":"Bổ sung (mục 15.4)","phu_trach":"Từng người"},{"tan_suat":"Hằng năm","viec":"Tháng 12: rà soát thang lương","can_cu":"Bổ sung (mục 24)","phu_trach":"Phòng Nhân lực"},{"tan_suat":"Hằng tuần","viec":"Kiểm tra phát thanh, màn hình nội viện; thiết bị hỏng: báo trong ngày","can_cu":"Bổ sung (QT.29)","phu_trach":"Chuyên viên Truyền thông cơ sở (bệnh viện 03 người); Trưởng nhóm kiêm nếu bệnh viện 02 người. Trưởng nhóm giám sát; Media cơ sở không chủ trì."},{"tan_suat":"Hằng tháng","viec":"Nghiệm thu truyền hình, truyền thanh, báo chí, trang cộng đồng trên mạng xã hội theo hợp đồng năm","can_cu":"Bổ sung (QT.33)","phu_trach":"Chuyên viên truyền thông của nhóm (hợp đồng năm của nhóm)"},{"tan_suat":"Hằng tháng","viec":"Tổng hợp khảo sát hài lòng trên kênh số, khi có quyết định (mục 28, số 30) (Đề xuất – chờ duyệt)","can_cu":"Bổ sung (QT.52)","phu_trach":"Chuyên viên dữ liệu khách hàng và thị trường"},{"tan_suat":"Hằng quý","viec":"Phiếu góp ý quý của Ban Giám đốc cơ sở; tổng hợp, dùng chấm KPI","can_cu":"Bổ sung (QT.42; mục 24.4)","phu_trach":"Chuyên viên trưởng"},{"tan_suat":"Hằng quý","viec":"Báo cáo kết quả hợp tác truyền thông với đối tác theo nguồn khách","can_cu":"Bổ sung (QT.43)","phu_trach":"Quản lý thương hiệu của nhóm; đối tác cấp hệ thống: Quản lý thương hiệu của nhóm có thương hiệu ký kết"},{"tan_suat":"Hằng quý","viec":"Rà hiệu lực hồ sơ quảng cáo thuốc, thực phẩm bảo vệ sức khỏe, mỹ phẩm, trang thiết bị y tế (Đề xuất – chờ duyệt)","can_cu":"Bổ sung (QT.55)","phu_trach":"Chuyên viên biên tập của nhóm có sản phẩm"},{"tan_suat":"Hằng tuần","viec":"Giao ban Tổng công ty 11:00 thứ Hai","can_cu":"Phòng Marketing Tổng công ty xác nhận ngày 11/11/2026","phu_trach":"Trưởng phòng dự; chưa có Trưởng phòng: Chuyên viên trưởng (phụ trách phòng)"},{"tan_suat":"02 tuần/lần","viec":"Giao ban với Tổng Giám đốc thứ Tư; 04 tuần/lần với cả phòng","can_cu":"Phòng Marketing Tổng công ty xác nhận ngày 11/11/2026","phu_trach":"02 tuần/lần: Trưởng phòng, Chuyên viên trưởng, Tổ trưởng Tổ Nội dung và Sáng tạo, Tổ trưởng Tổ Tăng trưởng số; 04 tuần/lần: cả phòng"},{"tan_suat":"Hằng tháng","viec":"Ngày 10: chi phí trên khách của tháng trước; kế hoạch SEO","can_cu":"mục 16, số 12","phu_trach":"Chuyên viên đo lường và đối soát (chi phí trên khách); Quản lý sản phẩm số (kế hoạch SEO)"},{"tan_suat":"Hằng tháng","viec":"Ngày 20–22: gửi yêu cầu sản xuất của tháng sau qua cổng tiếp nhận","can_cu":"mục 16, số 14","phu_trach":"Quản lý thương hiệu của nhóm; Trưởng nhóm Marketing cơ sở"},{"tan_suat":"Hằng tháng","viec":"Ngày 20–22: cộng nhu cầu mua của 02 nhóm theo nhà cung cấp, loại hàng, trước khi ký hợp đồng","can_cu":"Quy chế chi tiêu nội bộ (Quyết định 189/QĐ-TTH), Điều 32.1","phu_trach":"Chuyên viên đo lường và đối soát; đơn vị chủ trì mua sắm làm một hợp đồng khi tổng từ 20 triệu đồng trở lên"},{"tan_suat":"Hằng tháng","viec":"Ngày 20–25: lịch đăng tháng sau của từng kênh","can_cu":"QT.56","phu_trach":"Chuyên viên quảng cáo và kênh số của nhóm lập; Quản lý thương hiệu của nhóm nghiệm thu"},{"tan_suat":"Quy tắc lịch","viec":"Mốc rơi vào ngày nghỉ (12 ngày lễ, Tết: Bộ luật Lao động 2019, Điều 112; Nghị quyết 28/2026/QH16) làm vào ngày làm việc liền trước","can_cu":"mục 16","phu_trach":"Mọi vị trí; phần mềm tự dời mốc"},{"tan_suat":"Hằng quý","viec":"Báo cáo giờ làm chéo nhóm theo người, vị trí, trường hợp; vị trí quá 24 giờ trong quý: xem nguyên nhân","can_cu":"mục 15.4","phu_trach":"Chuyên viên trưởng; Thư ký Ban Tổng Giám đốc mảng Marketing xem được"},{"tan_suat":"Theo sự việc","viec":"Cho phép làm thay chéo nhóm có thời hạn: lập trong 04 giờ làm việc; thu hồi quyền tạm đúng ngày hết hạn","can_cu":"mục 15.4","phu_trach":"Người trung lập cho phép làm thay có thời hạn (RC-1); Chuyên viên trưởng cấp, thu hồi quyền tạm"},{"tan_suat":"Theo sự việc","viec":"Bác sĩ nghỉ việc: cơ sở báo trong 01 ngày làm việc; dừng quảng cáo, ẩn bài, gỡ hồ sơ trong 01 ngày làm việc","can_cu":"QT.28","phu_trach":"Ban Giám đốc cơ sở báo; Chuyên viên quảng cáo và kênh số của nhóm; Quản lý sản phẩm số"},{"tan_suat":"Hằng tuần / hằng tháng","viec":"Kiểm tra biển bảng tại cơ sở (hằng tuần), tổng hợp ảnh/số đo hiện trạng và báo cáo (hằng tháng); biển hỏng báo trong ngày","can_cu":"QyĐ.48; quy trình biển-bảng-hỏng; ma trận TCT–chi nhánh 07,24","phu_trach":"Chuyên viên Truyền thông cơ sở (03 người); bệnh viện 02 người Trưởng nhóm Marketing cơ sở kiêm; Chuyên viên truyền thông TCT nhận và kiểm; Media cơ sở không chủ trì."}],"kpi_van_hanh":[{"ten":"Rà soát định biên, bảng phân công đúng kỳ","cong_thuc":"Đạt (100 điểm): biên bản rà soát định biên, bảng phân công lập trong 10 ngày làm việc đầu quý sau (mục 30); không đạt (0 điểm): quá hạn","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ đúng hạn của Tổ Nội dung và Sáng tạo, Marketing cơ sở","cong_thuc":"Số yêu cầu của Tổ Nội dung và Sáng tạo và Marketing cơ sở hoàn tất đúng hạn ÷ tổng số yêu cầu của Tổ Nội dung và Sáng tạo và Marketing cơ sở đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ người đạt bậc 3 (mục 24.3)","cong_thuc":"Số người trong phạm vi quản lý đạt bậc 3 trở lên ÷ tổng số người trong phạm vi quản lý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Cơ sở mới ra mắt đúng lịch","cong_thuc":"Đạt (100 điểm): mọi cơ sở mới trong quý ra mắt đúng lịch ra mắt đã duyệt (mục 22.2); không có cơ sở mới: không chấm, tỷ trọng chia cho chỉ tiêu còn lại","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ yêu cầu cần Tổ trưởng xử lý được xử lý trong 04 giờ làm việc","cong_thuc":"Số yêu cầu cần Tổ trưởng xử lý được xử lý trong 04 giờ làm việc kể từ khi nhận ÷ tổng số yêu cầu cần Tổ trưởng xử lý của tổ trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ đúng hạn của tổ","cong_thuc":"Số yêu cầu của tổ hoàn tất đúng hạn ÷ tổng số yêu cầu của tổ đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Sản phẩm phát hành đủ bước kiểm tra","cong_thuc":"Đạt (100 điểm): mọi sản phẩm của tổ phát hành trong quý có đủ bước kiểm tra trên sổ theo dõi (pháp lý, nhận diện, duyệt); không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Sổ theo dõi cập nhật hằng ngày","cong_thuc":"Đạt (100 điểm): sổ theo dõi yêu cầu của tổ được cập nhật trong mọi ngày làm việc của quý; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Kế hoạch, ngân sách, đối soát đúng hạn","cong_thuc":"Số kế hoạch, tờ trình ngân sách, bản đối soát của Hạng mục phụ trách nộp đúng hạn ÷ tổng số phải nộp trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Xử lý khủng hoảng đúng thời hạn","cong_thuc":"Đạt (100 điểm): mọi sự cố truyền thông trong quý được báo, xử lý, báo cáo đúng thời hạn (mục 30); không có sự cố: đạt; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Lịch phát màn hình, phát thanh đúng kế hoạch","cong_thuc":"Số lượt phát màn hình, phát thanh đúng kế hoạch ÷ tổng số lượt theo kế hoạch trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ yêu cầu hoàn tất đúng hạn","cong_thuc":"Số yêu cầu do vị trí thực hiện hoàn tất đúng hạn ÷ tổng số yêu cầu do vị trí thực hiện đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Số vòng chỉnh sửa bình quân","cong_thuc":"Tổng số vòng chỉnh sửa của các sản phẩm hoàn tất ÷ số sản phẩm hoàn tất trong quý","don_vi_tinh":"Vòng","ky_cham":"Quý","de_xuat":true},{"ten":"Không vi phạm pháp luật quảng cáo y tế","cong_thuc":"Đạt (100 điểm): không có sản phẩm do vị trí làm hoặc kiểm tra bị cơ quan nhà nước, bộ phận pháp chế xác định vi phạm trong quý; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Nội dung xây mới website tthhealthcare.com, App TTH bàn giao đúng lịch được duyệt","cong_thuc":"Số phần nội dung xây mới bàn giao đúng lịch dự án ÷ tổng số phần đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Nội dung xây mới website các chuỗi bàn giao đúng lịch được duyệt","cong_thuc":"Số phần nội dung xây mới bàn giao đúng lịch dự án ÷ tổng số phần đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ yêu cầu hoàn tất đúng hạn theo cấp độ","cong_thuc":"Số yêu cầu thiết kế hoàn tất trong thời hạn chuẩn của cấp độ ÷ tổng số yêu cầu đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ sản phẩm đạt trong 02 vòng chỉnh sửa","cong_thuc":"Số sản phẩm được duyệt trong tối đa 02 vòng chỉnh sửa ÷ tổng số sản phẩm hoàn tất trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Áp dụng bộ nhận diện chung của TTH tại cơ sở nhóm 1 đúng lịch được duyệt","cong_thuc":"Số phần việc áp dụng bộ nhận diện hoàn tất đúng lịch dự án ÷ tổng số phần việc đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ sản phẩm làm từ mẫu","cong_thuc":"Số sản phẩm thiết kế làm từ thư viện mẫu thiết kế sẵn ÷ tổng số sản phẩm thiết kế thuộc loại đã có mẫu trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Bộ nhận diện nhóm 2 bàn giao đúng lịch được duyệt","cong_thuc":"Số phần của bộ nhận diện bàn giao đúng lịch dự án ÷ tổng số phần đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Bộ nhận diện chung của TTH bàn giao đúng lịch được duyệt","cong_thuc":"Số phần của bộ nhận diện bàn giao đúng lịch dự án ÷ tổng số phần đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ file in đạt quy chuẩn ngay lần đầu","cong_thuc":"Số file in đạt kiểm tra kỹ thuật ngay lần đầu ÷ tổng số file in được kiểm tra trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Không bỏ sót lịch đã duyệt","cong_thuc":"Đạt (100 điểm): mọi lịch ghi hình, chụp ảnh đã duyệt trong quý có người thực hiện; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ tư liệu lên kho tư liệu trong ngày","cong_thuc":"Số đợt ghi hình, chụp ảnh có tư liệu lên kho tư liệu trong ngày ÷ tổng số đợt trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Sự cố kênh xử lý đúng hạn","cong_thuc":"Đạt (100 điểm): mọi sự cố kênh trong quý được báo trong 30 phút, báo cáo trong 48 giờ, gỡ vi phạm trong 03 giờ (mục 30); không có sự cố: đạt; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Không vi phạm quy định quảng cáo","cong_thuc":"Đạt (100 điểm): không có quảng cáo bị nền tảng gỡ do vi phạm hoặc bị bộ phận pháp chế xác định vi phạm trong quý; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Báo cáo đúng kỳ","cong_thuc":"Số báo cáo nộp đúng kỳ theo lịch (mục 30) ÷ tổng số báo cáo phải nộp trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Sai lệch đối soát","cong_thuc":"Bình quân, theo các chỉ tiêu đối soát trong quý, của: chênh lệch tuyệt đối giữa số đối soát và số kế toán, HIS ÷ số kế toán, HIS × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Không vi phạm bảo vệ dữ liệu cá nhân","cong_thuc":"Đạt (100 điểm): không có sự cố lộ, dùng sai dữ liệu cá nhân trong phạm vi vị trí trong quý; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Lỗi website, App TTH được báo đúng hạn, theo dõi đến khi hoàn tất xử lý","cong_thuc":"Số lỗi được báo Phòng Số hóa đúng hạn và theo dõi đến khi đóng ÷ tổng số lỗi phát hiện trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Hoạt động tại chỗ đúng kế hoạch trong vùng","cong_thuc":"Số Hoạt động tại chỗ trong vùng thực hiện đúng kế hoạch ÷ tổng số Hoạt động tại chỗ theo kế hoạch trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Hoạt động tại chỗ đúng kế hoạch","cong_thuc":"Số Hoạt động tại chỗ thực hiện đúng kế hoạch ÷ tổng số Hoạt động tại chỗ theo kế hoạch trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ đúng hạn của Marketing cơ sở trong vùng","cong_thuc":"Số yêu cầu của Marketing cơ sở trong vùng hoàn tất đúng hạn ÷ tổng số yêu cầu của Marketing cơ sở trong vùng đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Đánh giá Trưởng nhóm đúng kỳ","cong_thuc":"Đạt (100 điểm): hồ sơ đánh giá của mọi Trưởng nhóm trong vùng nộp đúng kỳ; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Đánh giá cấp 1 đúng kỳ","cong_thuc":"Đạt (100 điểm): hồ sơ đánh giá cấp 1 của mọi thành viên Marketing tại cơ sở nộp đúng kỳ; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Tin sau sự kiện trong 04 giờ","cong_thuc":"Số tin đăng trong 04 giờ sau khi sự kiện kết thúc ÷ tổng số sự kiện cần tin trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Nhu cầu tháng đúng hạn","cong_thuc":"Đạt (100 điểm): nhu cầu tháng nhập phần mềm trong ngày 10–15 của cả 03 tháng trong quý; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Xác nhận chuyên môn đúng hạn","cong_thuc":"Số yêu cầu xác nhận chuyên môn (bác sĩ, khoa phòng) hoàn tất đúng hạn ÷ tổng số yêu cầu xác nhận trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Không bỏ sót lịch ghi hình","cong_thuc":"Đạt (100 điểm): mọi lịch ghi hình tại cơ sở trong quý có người thực hiện; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Góp ý của Ban Giám đốc cơ sở theo phiếu góp ý quý (thang 100 điểm)","cong_thuc":"Điểm phiếu góp ý quý của Ban Giám đốc cơ sở, thang 100","don_vi_tinh":"Điểm","ky_cham":"Quý","de_xuat":true}],"tinh_huong_thuong_gap":[{"tinh_huong":"Bệnh viện cần chương trình dịch vụ trọng điểm của 01 cơ sở (gói khám, gói điều trị, khai trương dịch vụ)","quy_trinh":"QT.1"},{"tinh_huong":"Chương trình chung nhiều cơ sở, dùng ngân sách Tổng công ty","quy_trinh":"QT.10, QT.15"},{"tinh_huong":"Chương trình trọng điểm từ 02 cơ sở, theo hệ thống bệnh viện, phòng khám: gói khám, gói điều trị, hội thảo, lớp học","quy_trinh":"QT.26, QT.10"},{"tinh_huong":"Cơ sở cần một sản phẩm lẻ (ảnh, bài, video, ấn phẩm) ngoài Hạng mục","quy_trinh":"QT.2"},{"tinh_huong":"Tin hoạt động trong ngày tại cơ sở","quy_trinh":"QT.3"},{"tinh_huong":"Kế hoạch nội dung, lịch đăng hằng tháng trên kênh; ai chịu trách nhiệm nội dung kênh","quy_trinh":"QT.56"},{"tinh_huong":"Sự kiện tại cơ sở ngoài Hạng mục (khám cộng đồng, học đường, tư vấn sức khỏe)","quy_trinh":"QT.21; tin trong ngày: QT.3"},{"tinh_huong":"Hội nghị khoa học, sự kiện cấp hệ thống","quy_trinh":"QT.12"},{"tinh_huong":"Khách để lại thông tin, nhắn tin, gọi tổng đài, hotline di động, gửi email, form","quy_trinh":"QT.4"},{"tinh_huong":"Chăm sóc khách cũ: gửi tin hàng loạt, tin chăm sóc tự động","quy_trinh":"QT.5"},{"tinh_huong":"Đánh giá tiêu cực, phản ánh, khủng hoảng truyền thông, thông tin vi phạm trên kênh","quy_trinh":"QT.6"},{"tinh_huong":"Người phụ trách, Tổ trưởng vắng mặt; ngoại lệ chéo nhóm khi vắng, chờ tuyển","quy_trinh":"QT.7"},{"tinh_huong":"Lãnh đạo, khoa phòng nhắn thẳng nhân viên; loại việc chưa có trong bảng phân công","quy_trinh":"QT.8"},{"tinh_huong":"Cơ sở mới hoạt động, khai trương","quy_trinh":"QT.9"},{"tinh_huong":"Bộ nhận diện; thay biển theo nhận diện mới","quy_trinh":"QT.11"},{"tinh_huong":"Biển bảng hỏng, xuống cấp","quy_trinh":"QT.13"},{"tinh_huong":"Trang trí lễ, Tết; poster, tranh ảnh, trang trí cố định tại khoa phòng; vật phẩm thương hiệu","quy_trinh":"QT.24; mục 15.2"},{"tinh_huong":"Phân việc thiết kế: ai làm sản phẩm nào, bản in hay bản số","quy_trinh":"Mục 15.2: quy tắc hai bước, quy tắc chặn C1–C13"},{"tinh_huong":"Poster dịch vụ, bảng danh mục dịch vụ của khoa treo lâu dài","quy_trinh":"QT.2; mục 15.2 (nguyên tắc thông điệp dịch vụ)"},{"tinh_huong":"Website, App TTH: cập nhật nội dung, lỗi; kế hoạch SEO","quy_trinh":"QT.14; mục 11.1, số 23"},{"tinh_huong":"Kế hoạch, ngân sách năm; chi ngoài kế hoạch; chốt kỳ; KPI quý","quy_trinh":"QT.15"},{"tinh_huong":"Cơ sở y tế tuyến dưới, bác sĩ, phòng khám bên ngoài giới thiệu người bệnh; tài trợ tại địa phương","quy_trinh":"QT.16"},{"tinh_huong":"Mạo danh, tin giả về bệnh viện, bác sĩ, thương hiệu trên mạng","quy_trinh":"QT.27"},{"tinh_huong":"Rà soát định kỳ nội dung y khoa; thông tin công khai trên website, App TTH (giá, người hành nghề, kỹ thuật được phép)","quy_trinh":"QT.28"},{"tinh_huong":"Bảo hiểm y tế, bảo hiểm sức khỏe, bảo lãnh viện phí","quy_trinh":"QT.1 (ngoại lệ bảo hiểm); mục 31, mảng 45"},{"tinh_huong":"KOL, KOC trong Hạng mục","quy_trinh":"QT.20"},{"tinh_huong":"Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện gửi nhu cầu truyền thông","quy_trinh":"QT.19"},{"tinh_huong":"Truyền thông tuyển dụng","quy_trinh":"QT.22"},{"tinh_huong":"Chuyển quyền kênh, tài khoản quảng cáo, kho tư liệu của bệnh viện về Tổng công ty (Giai đoạn 2)","quy_trinh":"QT.23"},{"tinh_huong":"Nhân viên nghỉ việc, chuyển công tác","quy_trinh":"QT.17"},{"tinh_huong":"Thay đổi pháp luật, chính sách nền tảng; thủ tục với cơ quan nhà nước; dùng trí tuệ nhân tạo","quy_trinh":"QT.18"},{"tinh_huong":"Việc định kỳ (ngày, tuần, tháng, quý, năm)","quy_trinh":"mục 30"},{"tinh_huong":"Phát thanh nội viện, màn hình nội viện: nhu cầu, kế hoạch phát, kịch bản, thu âm, phát, kiểm tra thiết bị","quy_trinh":"QT.29"},{"tinh_huong":"Hai cơ sở, hai nhóm thương hiệu cùng cần một người, một ngày ghi hình","quy_trinh":"QT.30"},{"tinh_huong":"Yêu cầu gấp hơn thời hạn chuẩn","quy_trinh":"QT.31"},{"tinh_huong":"Mua dịch vụ in ấn, thi công, quảng cáo ngoài trời: nhà cung cấp, hợp đồng, nghiệm thu, thanh toán","quy_trinh":"QT.32"},{"tinh_huong":"Truyền hình, truyền thanh, báo chí, trang cộng đồng trên mạng xã hội theo hợp đồng năm","quy_trinh":"QT.33"},{"tinh_huong":"Báo chí đề nghị phỏng vấn, đưa tin; bác sĩ tham gia truyền thông","quy_trinh":"QT.34"},{"tinh_huong":"Sự kiện nội bộ; phòng ban Tổng công ty cần truyền thông (sơ kết, tổng kết, nội bộ)","quy_trinh":"QT.35"},{"tinh_huong":"Cơ sở cần người Marketing cơ sở của cơ sở khác hỗ trợ","quy_trinh":"QT.36"},{"tinh_huong":"Giới thiệu dịch vụ của cơ sở này tại cơ sở khác trong hệ thống","quy_trinh":"QT.37"},{"tinh_huong":"Bài, ấn phẩm đã phát hành có sai sót (giá, chuyên môn, thông tin người bệnh)","quy_trinh":"QT.38"},{"tinh_huong":"Tài khoản kênh, tài khoản quảng cáo bị khóa, mất quyền, bị chiếm","quy_trinh":"QT.39"},{"tinh_huong":"Lộ, mất dữ liệu cá nhân khách hàng","quy_trinh":"QT.40"},{"tinh_huong":"Ban Tổng Giám đốc giao việc, chỉ đạo; báo cáo, xin ý kiến","quy_trinh":"QT.41"},{"tinh_huong":"Ban Giám đốc cơ sở đề nghị, phản ánh, bất đồng với Marketing; góp ý quý; Trưởng nhóm Marketing cơ sở và Quản lý thương hiệu chưa thống nhất","quy_trinh":"QT.42"},{"tinh_huong":"Đối tác đề nghị hợp tác: ký kết, đồng thương hiệu, sự kiện chung","quy_trinh":"QT.43"},{"tinh_huong":"Cơ sở đổi tên, đổi thương hiệu, chuyển nhóm thương hiệu","quy_trinh":"QT.44"},{"tinh_huong":"Cơ quan nhà nước thanh tra, kiểm tra, yêu cầu giải trình, xử phạt về quảng cáo, thông tin trên kênh","quy_trinh":"QT.45"},{"tinh_huong":"Cơ sở tạm ngừng dịch vụ, đổi giờ làm việc","quy_trinh":"QT.46"},{"tinh_huong":"Phát trực tiếp trên kênh chính thức (tư vấn sức khỏe, sự kiện, hội thảo)","quy_trinh":"QT.47"},{"tinh_huong":"Ca bệnh, câu chuyện, cảm nhận, hình ảnh trước – sau của người bệnh; người bệnh rút đồng ý, yêu cầu gỡ ảnh","quy_trinh":"QT.48"},{"tinh_huong":"Phần mềm Quản trị Marketing, kho tư liệu, CRM gián đoạn; mất tư liệu","quy_trinh":"QT.49"},{"tinh_huong":"Nghiên cứu thị trường, khảo sát nhận biết thương hiệu","quy_trinh":"QT.50"},{"tinh_huong":"Khám sức khỏe doanh nghiệp, gói dịch vụ cho tổ chức","quy_trinh":"QT.51; đơn vị bán, ký hợp đồng chờ quyết định (mục 28, số 24)"},{"tinh_huong":"Khảo sát hài lòng, trải nghiệm người bệnh (NPS, CSAT)","quy_trinh":"QT.52; chịu trách nhiệm kết quả chờ quyết định (mục 28, số 30)"},{"tinh_huong":"Người bệnh nước ngoài","quy_trinh":"QT.53; chờ xác nhận nhu cầu (mục 28, số 48)"},{"tinh_huong":"Dịch bệnh, thiên tai; cơ quan y tế đề nghị đăng hướng dẫn phòng bệnh","quy_trinh":"QT.54"},{"tinh_huong":"Quảng cáo, giới thiệu thuốc, thực phẩm bảo vệ sức khỏe, mỹ phẩm, trang thiết bị y tế","quy_trinh":"QT.55"},{"tinh_huong":"Sự kiện, hội nghị hoãn, hủy","quy_trinh":"QT.21, QT.12 (ngoại lệ)"},{"tinh_huong":"Hãng dược, nhà cung cấp thiết bị tài trợ hội nghị, sự kiện","quy_trinh":"QT.12 (ngoại lệ); QT.55"},{"tinh_huong":"Bị khiếu nại vi phạm bản quyền; nền tảng gỡ nội dung, cảnh cáo kênh","quy_trinh":"QT.38, QT.39 (ngoại lệ)"},{"tinh_huong":"Cơ sở ngừng hoạt động hẳn, sáp nhập, chuyển nhượng","quy_trinh":"QT.44 (ngoại lệ)"},{"tinh_huong":"KOL, KOC gặp sự cố cá nhân sau hợp tác","quy_trinh":"QT.20 (ngoại lệ)"},{"tinh_huong":"Nhân viên không đồng ý điểm KPI","quy_trinh":"QT.15 (ngoại lệ); mục 24.6"},{"tinh_huong":"Website bị tấn công, không truy cập được","quy_trinh":"QT.14 (ngoại lệ)"},{"tinh_huong":"Đơn vị khác dùng tên, nhãn hiệu TTH trong quảng cáo, từ khóa tìm kiếm","quy_trinh":"QT.27 (ngoại lệ)"},{"tinh_huong":"Khách hỏi triệu chứng, đề nghị chẩn đoán, kê đơn qua tin nhắn","quy_trinh":"QT.4 (ngoại lệ)"},{"tinh_huong":"Người bệnh, người nhà quay video, phát trực tiếp tố cáo; đánh giá giả có tổ chức","quy_trinh":"QT.6 (ngoại lệ)"},{"tinh_huong":"Khách khiếu nại ưu đãi, khuyến mại","quy_trinh":"QT.1 (ngoại lệ)"},{"tinh_huong":"Báo chí hỏi thông tin người bệnh, người nổi tiếng khám tại cơ sở","quy_trinh":"QT.34 (ngoại lệ); QT.48"},{"tinh_huong":"Thông báo bổ nhiệm, thay đổi lãnh đạo","quy_trinh":"QT.35 (ngoại lệ)"},{"tinh_huong":"Đoàn đánh giá chất lượng bệnh viện, kiểm tra chung","quy_trinh":"QT.45 (ngoại lệ)"},{"tinh_huong":"Triển khai CRM đa kênh; Lead khi CRM vận hành","quy_trinh":"QT.25, QT.4; mục 17.1"},{"tinh_huong":"Tin giao dịch: nhắc lịch hẹn, báo đã có kết quả, nhắc tái khám theo chỉ định","quy_trinh":"Không thuộc Marketing; đơn vị vận hành chờ quyết định (mục 28, số 36)"},{"tinh_huong":"Lập kế hoạch, triển khai, tối ưu quảng cáo trả phí trực tuyến; mẫu quảng cáo, trang đích; nền tảng từ chối quảng cáo","quy_trinh":"QT.57"},{"tinh_huong":"Báo cáo tuần, tháng; giao ban; chỉ đạo sau giao ban","quy_trinh":"QT.58, QT.41"},{"tinh_huong":"Ý tưởng, đề xuất cải tiến của nhân viên","quy_trinh":"QT.58 (ngoại lệ)"},{"tinh_huong":"Nhân viên mới nhận việc; điều chuyển vị trí, nhóm thương hiệu","quy_trinh":"QT.59, QT.17"},{"tinh_huong":"Đổi lịch, đổi ngân sách, dừng, hủy kế hoạch tháng hoặc Hạng mục đang triển khai","quy_trinh":"QT.60"},{"tinh_huong":"Chương trình tuyển dụng: chiến dịch, ngày hội việc làm, quảng cáo tuyển dụng","quy_trinh":"QT.22 (ngoại lệ); QT.10"},{"tinh_huong":"Hoạt động từ thiện, công tác xã hội của cơ sở","quy_trinh":"QT.21 (ngoại lệ); mục 11.1, số 15"},{"tinh_huong":"TTH tài trợ sự kiện, tổ chức bên ngoài để có truyền thông thương hiệu","quy_trinh":"QT.43 (cấp hệ thống); QT.16 (tại địa phương); duyệt: mục 14.16, mảng 41"},{"tinh_huong":"Cần mẫu thiết kế sẵn mới; sửa, thu hồi mẫu","quy_trinh":"QT.11 (ngoại lệ)"},{"tinh_huong":"Tham gia giải thưởng, bình chọn, xếp hạng; truyền thông khi đạt giải","quy_trinh":"QT.10 (ngoại lệ); QT.1"},{"tinh_huong":"Tình huống chưa có trong bảng này","quy_trinh":"Loại việc mới: QT.8; tranh chấp: mục 14.8; ngoại lệ chung: mục 14.10; bất đồng, cần cấp trên quyết định: mục 4.2; sự cố, khủng hoảng: QT.6. Sau khi xử lý, Chuyên viên trưởng đề xuất bổ sung tình huống vào bảng này (Đề xuất – chờ duyệt)"},{"tinh_huong":"Bác sĩ nghỉ việc, chuyển công tác; hồ sơ, quảng cáo còn hiển thị","quy_trinh":"QT.28"},{"tinh_huong":"Trang đích lỗi khi quảng cáo đang hiển thị, kể cả ngoài giờ","quy_trinh":"QT.14"},{"tinh_huong":"Người nhóm 2 ở vị trí 01 người nghỉ phép, nghỉ đột xuất","quy_trinh":"QT.7"},{"tinh_huong":"Nhân viên nộp đơn nghỉ việc ở vị trí 01 người","quy_trinh":"QT.17"},{"tinh_huong":"Yêu cầu gửi ngoài giờ, không phải sự cố","quy_trinh":"QT.31"},{"tinh_huong":"Khách chuyển chéo thương hiệu qua Contact Center","quy_trinh":"QT.4"},{"tinh_huong":"Đơn vị khác đề nghị cung cấp dữ liệu khách","quy_trinh":"QT.25"},{"tinh_huong":"Hai nhóm cùng mua một loại dịch vụ của một nhà cung cấp","quy_trinh":"QT.32"}],"vai_tro_ghi_chu":"03 Tổ trưởng chuyên môn kiêm nhiệm phụ trách điều phối trong tổ theo chức năng, không tự có quyền duyệt. Tuyến nhân sự bệnh viện là một chiều: Trưởng phòng → Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở → Trưởng nhóm Marketing bệnh viện (Nhóm 1 và Nhóm 2) → nhân viên Marketing cơ sở. Chuyên viên trưởng Truyền thông – Thương hiệu và Tăng trưởng số quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số, hướng dẫn/kiểm soát nghiệp vụ ở bệnh viện qua phối hợp với Chuyên viên trưởng Nội dung – Sáng tạo và Marketing cơ sở, không là cấp quản lý thứ hai. TTH Clinic thuộc Nhóm 1, đầu mối kiêm nhiệm vẫn thuộc tuyến hành chính phòng khám; phối hợp chuyên môn Marketing theo giao việc.","kpi_quy_tac_chung":{"ma":"KPI-QT","ten":"Quy tắc chung cho KPI chưa đo được","noi_dung":"Theo thứ tự: (1) có nguồn thay thế (mã ưu đãi, mã đối tác, phiếu giới thiệu, Lead ghép được) thì chấm trên nguồn đó, chỉ tiêu đầu quý đặt theo cùng cách đếm; (2) không có nguồn nào, hoặc chưa chốt người chịu trách nhiệm (KPI-10, KPI-12, KPI-20, KPI-21), thì không chấm, tỷ trọng chia cho chỉ tiêu còn lại theo tỷ lệ.","ap_dung":"Mọi KPI ở mục 9, mục 12.5; thay các quy tắc riêng trước đây","can_cu":"Phiếu chốt 14/11/2026, điểm 16"},"kpi_to_truong":[{"ten":"Tỷ lệ yêu cầu cần Tổ trưởng xử lý được xử lý trong 04 giờ làm việc","cong_thuc":"Số yêu cầu cần Tổ trưởng xử lý được xử lý trong 04 giờ làm việc kể từ khi nhận ÷ tổng số yêu cầu cần Tổ trưởng xử lý của tổ trong quý × 100","ty_trong":"10% phần cá nhân","ky_cham":"Quý"},{"ten":"Sổ, báo cáo, đánh giá người đúng kỳ","cong_thuc":"Số kỳ rà sổ, báo cáo tổ, đánh giá người hoàn tất đúng hạn ÷ tổng số kỳ đến hạn trong quý × 100","ty_trong":"10% phần cá nhân","ky_cham":"Quý"}],"danh_muc_tai_lieu":[{"ma":"BM-1","loai":"Biểu mẫu","ten":"Báo cáo tháng gửi Ban Tổng Giám đốc","noi_dung":"Số đã chốt kỳ tháng trước; số nhanh tháng này; kết quả theo nhóm, cơ sở, Hạng mục; chi so với ngân sách; vướng mắc, đề xuất","xay_dung":["dl-1"],"nam_giu":"dl-1","cap_nhat":["tp"],"duyet":["btgd"],"dung":["tp","cvt"],"noi_lu