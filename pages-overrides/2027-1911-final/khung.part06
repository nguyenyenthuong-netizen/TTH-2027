uộc; Bảng dòng có định danh và tổng đối chiếu","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"},{"ma_truong":"nguoi_dau_moi","ten":"Đầu mối liên hệ","loai_du_lieu":"user","bat_buoc":true,"nguon":"Hồ sơ nghiệp vụ nguồn gắn mã bản ghi; người lập phải dẫn chứng và người đối soát kiểm tra","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền","quy_tac_kiem_tra":"Bắt buộc; Nhân sự có quyền và đang hiệu lực; lưu mã người dùng","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["qlsps","dl-2"],"nguoi_nam_giu":"qlsps","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm.","bo_tie