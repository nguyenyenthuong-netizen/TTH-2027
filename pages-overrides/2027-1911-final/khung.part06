oi_dung":"Đăng theo lịch; người đăng không sửa nội dung, cần sửa thì đề nghị qua cổng tiếp nhận. Bình luận hỏi dịch vụ, tin nhắn: Contact Center; đánh giá nhạy cảm: Chuyên viên truyền thông của nhóm; thông tin vi phạm: Chuyên viên quảng cáo và kênh số gỡ trong 03 giờ.","thoi_han":"Theo lịch đăng; gỡ thông tin vi phạm trong 03 giờ","ghi_nhan":"Kênh chính thức; sổ theo dõi sự cố","can_cu":"mục 16, số 21; mục 30","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"qc","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Kênh chính thức; sổ theo dõi sự cố","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["dl-1","qc"],"phoi_hop":["qlth|đánh giá, điều chỉnh kế hoạch tháng sau"],"noi_dung":"Số liệu kênh của tháng (tiếp cận, tương tác, Lead theo nguồn khách) trong báo cáo tháng dựng từ phần mềm; Quản lý thương hiệu của nhóm đánh giá, điều chỉnh kế hoạch nội dung tháng sau.","thoi_han":"Ngày làm việc đầu tháng","ghi_nhan":"Báo cáo tháng","can_cu":"mục 16, số 11; mục 12.5","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu","chu_tri_chinh":"dl-1","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Báo cáo tháng","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"}],"kiem_soat":["Mỗi kênh một người quản trị; mỗi bài một người viết, một người duyệt phát hành (mục 16, số 21)","Chỉ sản phẩm đã duyệt phát hành vào lịch đăng; người đăng không sửa nội dung","Trách nhiệm nội dung bài: người viết; chuyên môn: bác sĩ xác nhận; pháp lý: Chuyên viên biên tập kiểm theo tầng; nghiệm thu: Quản lý thương hiệu của nhóm; phát hành khi đủ bước. Trách nhiệm kênh (lịch đăng, đăng, bình luận) và kết quả kênh số của nhóm: Chuyên viên quảng cáo và kênh số của nhóm; quyền: Chuyên viên trưởng","Nội dung do công cụ trí tuệ nhân tạo tạo ra (ảnh, video, giọng đọc, nhất là hình người) ghi dấu hiệu nhận biết theo Luật Trí tuệ nhân tạo 134/2025/QH15 (số điều: bộ phận pháp chế xác nhận)"],"ngoai_le":[{"tinh_huong":"Tin trong ngày trên Facebook của bệnh viện","cach_lam":"Trưởng nhóm Marketing cơ sở đăng theo QT.3; không qua lịch đăng của Tổng công ty."},{"tinh_huong":"Cơ sở đề nghị đăng bài ngoài lịch","cach_lam":"Gửi qua cổng tiếp nhận theo QT.2; gấp: QT.31."},{"tinh_huong":"Kênh TTH Healthcare, kênh chung TTH Clinic","cach_lam":"Dùng lại sản phẩm đã duyệt của TTH Hospital, TTH Clinic, TTH Group; sản phẩm riêng theo Hạng mục (mục 6)."},{"tinh_huong":"Kênh của Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện","cach_lam":"Theo QT.19."},{"tinh_huong":"Nội dung đã đăng có sai sót","cach_lam":"Theo QT.38."}],"nhom_vi_du":"N1","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-lich-dang-thang"},{"id":"quang-cao-tra-phi","ten":"Quảng cáo trả phí trực tuyến: kế hoạch, mẫu quảng cáo, trang đích, triển khai, tối ưu, báo cáo","nhom_hoat_dong":["N4","N2","N10"],"vi_du":"Tháng 3: Bệnh viện Đa khoa TTH Hà Tĩnh triển khai quảng cáo Facebook cho gói khám tầm soát ung thư trong Hạng mục đã duyệt; cần 03 biến thể mẫu quảng cáo, 01 trang đích, nguồn khách riêng.","buoc":[{"thuc_hien":["qc"],"phoi_hop":["qlth|kết quả cần đạt, thông điệp, ngân sách","dl-1|cách đo, nguồn khách"],"noi_dung":"Lập kế hoạch quảng cáo tháng theo kế hoạch tháng, Hạng mục: chiến dịch, kênh, đối tượng, ngân sách, thời gian, số mẫu quảng cáo, nguồn khách. Công ty Cổ phần Winmed Việt Nam: theo QT.19.","thoi_han":"Ngày 20–25 hằng tháng","ghi_nhan":"Kế hoạch quảng cáo tháng trên phần mềm","can_cu":"QT.05.MKT.TCT; mục 30","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung","chu_tri_chinh":"qc","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Kế hoạch quảng cáo tháng trên phần mềm","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qlth"],"phoi_hop":["tp|thẩm định kế hoạch, không duyệt thay khoản chi","gd-coso|xác nhận mức chi dùng ngân sách cơ sở","ptgd-tc|duyệt chi trong hạn mức theo R28","btgd|Tổng Giám đốc phê duyệt chi mới ngoài hạn mức theo R28"],"noi_dung":"Quản lý thương hiệu của nhóm rà soát kế hoạch quảng cáo, mức ngân sách đề xuất, đối chiếu ngân sách đã duyệt và lập tờ trình chi. Giám đốc cơ sở xác nhận mức chi dùng ngân sách cơ sở. Cấp có thẩm quyền duyệt khoản chi theo R28: Phó Tổng Giám đốc mảng tài chính (trong hạn mức, kế hoạch đã duyệt); Tổng Giám đốc (chi mới ngoài hạn mức). Người lập và Trưởng phòng Marketing không tự thay người có thẩm quyền duyệt chi.","thoi_han":"Theo lịch trình kế hoạch tháng; chỉ triển khai khi khoản chi có phê duyệt hợp lệ theo R28","ghi_nhan":"Kế hoạch tháng; tờ trình chi Hạng mục","can_cu":"R28; mục 4.2; mục 14.5 bước 7","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Tờ trình chi trên Workit có loại chi, ngân sách, hạn mức, người có quyền ký và xác nhận của cơ sở nếu sử dụng ngân sách cơ sở; sổ Hạng mục ghi ngày duyệt và bằng chứng; chưa đủ thì dừng triển khai.","chu_tri_chinh":"qlth","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Kế hoạch tháng; tờ trình chi Hạng mục","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qc"],"phoi_hop":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"noi_dung":"Bổ sung yêu cầu kênh vào yêu cầu sản xuất của Quản lý thương hiệu: định dạng, kích thước, số biến thể (mục 14.5, bước 1).","thoi_han":"Cùng yêu cầu sản xuất","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.5; mục 14.12","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"qc","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Cổng tiếp nhận yêu cầu","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["bt","tk","md"],"phoi_hop":["bac-si|xác nhận nội dung chuyên môn","phap-che|rủi ro cao","tp|nội dung thuộc QyĐ.03.MKT mục 5.2"],"noi_dung":"Làm mẫu quảng cáo: lời quảng cáo và mọi biến thể chữ: Chuyên viên biên tập của nhóm; hình ảnh: Chuyên viên thiết kế của nhóm; video quảng cáo: Chuyên viên media của nhóm, kịch bản lời: Chuyên viên biên tập (mục 15.3, K2). Kiểm pháp lý theo tầng (mục 15.6); nội dung bắt buộc của quảng cáo dịch vụ khám bệnh, chữa bệnh theo danh sách kiểm tra pháp lý (Nghị định 342/2025/NĐ-CP, Điều 9); chỉ quảng cáo dịch vụ, kỹ thuật thuộc danh mục được phép (mục 14.15, số 40); hồ sơ nội dung quảng cáo khi pháp luật yêu cầu (QT.18, QT.55).","thoi_han":"Theo thời hạn chuẩn (mục 14.7)","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 15.6; mục 16.1, số 5","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"bt","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Cổng tiếp nhận yêu cầu","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_nguoi_xac_nhan_chuyen_mon":true,"can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qc"],"phoi_hop":["qlsps|nghiệm thu trang đích","dl-1|mã theo dõi"],"noi_dung":"Dựng trang đích từ mẫu khi Hạng mục cần; gắn mã theo dõi, nguồn khách; gỡ trang khi Hạng mục kết thúc.","thoi_han":"Trước ngày bắt đầu chiến dịch","ghi_nhan":"Danh mục sản phẩm số; trang quản trị nội dung website","can_cu":"mục 28, số 31; mục 11.1, số 25","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng 