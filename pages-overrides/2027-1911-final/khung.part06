gười lập phải dẫn chứng và người đối soát kiểm tra","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền","quy_tac_kiem_tra":"Bắt buộc; Chọn từ danh mục đang hiệu lực, không nhập tùy ý","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"},{"ma_truong":"han_sua","ten":"Hạn sửa","loai_du_lieu":"date","bat_buoc":false,"nguon":"Mốc thời gian thực tế có dấu vết trong lịch sản xuất/hồ sơ yêu cầu; không tự điền mặc định","nguoi_nhap":"Người lập theo tuyến/đồng bộ dữ liệu từ hệ thống nguồn; không tự quyết thông tin y tế và tài chính","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền","quy_tac_kiem_tra":"Có thể để trống nếu lý do không áp dụng được ghi; Ngày hợp lệ, thuộc kỳ; kiểm hiệu lực và múi giờ Việt Nam","kiem_duyet":"Người kiểm dữ liệu theo trường nguồn, khác với người lập; phát hành chỉ theo ma trận thẩm quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["cvt"],"nguoi_nam_giu":"cvt","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung.","Bắt buộc người nghiệm thu khác người thực hiện và có tiêu chí nghiệm thu đối chiếu."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm.","bo_tieu_chuan_19112026":{"tham_chieu":"QT.10, QT.11, QT.13, QT.24, QT.25","thanh_phan_bat_buoc":["Mã biểu mẫu và phiên bản","Mã việc/chương trình hoặc kỳ báo cáo","Nhóm thương hiệu – cơ sở – chuyên khoa/dịch vụ nếu có","Người lập và người xác nhận","Thời điểm chốt, tài liệu nguồn","Trạng thái, lịch sử sửa, dấu vết duyệt"],"dieu_kien_chan":["Không có mã/phiên bản/phạm vi áp dụng hoặc mất nguồn xác nhận","Người tự làm tự duyệt khi không có ủy quyền phù hợp","Hồ sơ y tế/khách hàng chứa dữ liệu cá nhân vượt quyền hoặc thiếu căn cứ sử dụng","Có thay đổi sau phê duyệt nhưng chưa tái kiểm soát"],"tieu_chi_nghiem_thu":["Có đủ thành phần bắt buộc hoặc lý do không áp dụng đã được chấp thuận","Có mã hồ sơ nguồn và minh chứng đối soát","Người kiểm chuyên môn và người phê duyệt được phân tách theo thẩm quyền","Khôi phục được phiên bản cũ; truy ra người sửa, thời gian, lý do"],"che_do_xuat":"HTML/PDF đọc được và dữ liệu bảng CSV/XLSX (chỉ với dữ liệu bảng); giữ tiếng Việt Unicode, mã và phiên bản","xu_ly_chua_co_phan_mem":"Dùng bảng tính/tệp có mã bản ghi, phiên bản và nhật ký phê duyệt; quyền truy cập được kiểm soát, không lưu dữ liệu người bệnh vào bản trình","trang_thai":"ĐẶC TẢ ĐỀ XUẤT – chờ đơn vị nắm giữ, đơn vị duyệt và Phòng Quản lý chất lượng xác nhận trước ban hành","truong_kiem_soat_chung":["ma_ban_ghi","ma_nguon","nguoi_lap","thoi_diem_lap","trang_thai","phien_ban","nguoi_xac_nhan","nguoi_duyet","lich_su_sua","nguon_du_lieu"]}},{"ma":"BM-16","loai":"Biểu mẫu","ten":"Biên bản bàn giao; biên bản rà soát định biên; biên bản đào tạo","noi_dung":"Bàn giao theo hồ sơ vị trí, gồm chuyển quyền kênh; giờ theo vị