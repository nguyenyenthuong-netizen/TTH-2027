oai_le":[{"tinh_huong":"Điều chuyển giữa vị trí, giữa nhóm thương hiệu","cach_lam":"Bàn giao phần việc cũ theo mục 15.5; thu hồi quyền cũ cùng ngày cấp quyền mới (mục 11.3; QT.17)."},{"tinh_huong":"Không có người bàn giao (vị trí mới, người cũ đã nghỉ)","cach_lam":"Chuyên viên trưởng hướng dẫn theo hồ sơ vị trí; người thay chính hỗ trợ trong giờ của mình (mục 15.4)."},{"tinh_huong":"Kiêm nhiệm tạm thời khi thay người vắng","cach_lam":"Theo QT.7."},{"tinh_huong":"Nhân sự chi nhánh chuyển về Tổng công ty theo lộ trình","cach_lam":"Theo mục 19, mục 21.3; quyền kênh, kho tư liệu theo QT.23."},{"tinh_huong":"Trưởng nhóm Marketing cơ sở của cơ sở mới","cach_lam":"Có mặt từ 03 tháng trước khai trương; theo QT.9."}],"nhom_vi_du":"N1","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-nhan-viec-moi"},{"id":"dieu-chinh-ke-hoach","ten":"Điều chỉnh kế hoạch tháng, Hạng mục đang triển khai: đổi lịch, đổi ngân sách, dừng, hủy","nhom_hoat_dong":["N1","N11"],"vi_du":"Giữa tháng 6: Bệnh viện Y học cổ truyền Nguyên Phúc đề nghị lùi chương trình tri ân 02 tuần vì thiếu bác sĩ; sản phẩm đang làm dở, quảng cáo đã triển khai 03 ngày.","buoc":[{"thuc_hien":["qlth"],"phoi_hop":["tn|đề nghị của cơ sở","bgd-coso|đề nghị của cơ sở"],"noi_dung":"Nhận hoặc lập đề nghị điều chỉnh qua cổng tiếp nhận: nội dung, lý do, ảnh hưởng (Hoạt động, sản phẩm đang làm, chi đã phát sinh, Lead).","thoi_han":"Ngay khi phát sinh","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.1; mục 14.6","de_xuat":