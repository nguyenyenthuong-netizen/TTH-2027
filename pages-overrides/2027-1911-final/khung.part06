một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["cvt"],"phoi_hop":["tp|duyệt"],"noi_dung":"Cập nhật phạm vi nhóm (mục 3), bảng phân công, danh mục kênh; báo Trưởng phòng.","thoi_han":"Sau ngày áp dụng","ghi_nhan":"Bảng phân công; mục 3","can_cu":"mục 3; mục 21","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung","chu_tri_chinh":"cvt","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Bảng phân công; mục 3","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"}],"kiem_soat":["Không dùng tên mới trên sản phẩm, kênh, biển hiệu trước ngày áp dụng hoặc khi giấy phép hoạt động chưa điều chỉnh (Đề xuất – chờ duyệt)","Mỗi cơ sở thuộc 01 nhóm; từ ngày áp dụng, mọi vị trí theo nhóm làm việc với người của nhóm mới (mục 3)","Sản phẩm còn tên cũ trên kênh, biển bảng có trong danh mục cần thay, có hạn thay"],"ngoai_le":[{"tinh_huong":"Cơ sở đổi tên nhưng không đổi nhóm (ví dụ đổi tên trong cùng chuỗi chuyên khoa)","cach_lam":"Bỏ bước 2, 3; làm bước 4–8 với người của nhóm hiện tại."},{"tinh_huong":"Cơ sở mới, chưa hoạt động, chưa có kênh","cach_lam":"Theo QT.9."},{"tinh_huong":"Thương hiệu hệ thống mới theo Phụ lục 03 của Quyết định kiến trúc thương hiệu (Nguyên Bách Healthcare, Thái Thượng Hoàng Healthcare), nếu được hình thành","cach_lam":"Phần chung vào nhóm 2; số người theo quy tắc định biên (mục 21)."},{"tinh_huong":"Kênh cũ không đổi tên được theo chính sách nền tảng","cach_lam":"Lập kênh mới theo QT.9, bước 4; kênh cũ đăng thông báo chuyển kênh; quyền kênh cũ thu hồi theo QT.23. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Cơ sở ngừng hoạt động hẳn, sáp nhập, chuyển nhượng","cach_lam":"Trưởng phòng nhận quyết định; kênh, Trang doanh nghiệp trên Google: đăng thông báo, đóng hoặc chuyển theo quyết định (quyền theo mục 11.3); website, App TTH: Quản lý sản phẩm số gỡ hoặc chuyển trang cơ sở (QT.14); tư liệu giữ trong kho tư liệu; Marketing cơ sở: Chuyên viên trưởng đề xuất bố trí theo mục 19, mục 21, Phòng Nhân lực thực hiện; cân giờ: bước 2. (Đề xuất – chờ duyệt)"}],"nhom_vi_du":"chung","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-doi-ten-chuyen-nhom"},{"id":"thanh-tra-kiem-tra","ten":"Cơ quan nhà nước thanh tra, kiểm tra, yêu cầu giải trình, xử phạt về quảng cáo, thông tin trên kênh","nhom_hoat_dong":["N11","N5"],"vi_du":"Cơ quan nhà nước có thẩm quyền gửi văn bản yêu cầu Bệnh viện Đa khoa TTH Quảng Bình giải trình một bài quảng cáo gói khám trên Facebook của bệnh viện.","buoc":[{"thuc_hien":["bgd-coso","btgd"],"phoi_hop":["phap-che","tp","tn|báo khi đoàn kiểm tra làm việc tại cơ sở"],"noi_dung":"Đơn vị nhận văn bản, quyết định thanh tra, kiểm tra (Ban Giám đốc cơ sở, Ban Tổng Giám đốc) chuyển bộ phận pháp chế và Trưởng phòng Marketing. Marketing cơ sở, nhân viên nhận yêu cầu trực tiếp từ đoàn kiểm tra: báo Trưởng nhóm; Trưởng nhóm báo Trưởng phòng theo lịch trực sự cố.","thoi_han":"Trong ngày nhận văn bản","ghi_nhan":"Sổ theo dõi sự cố; văn bản đến","can_cu":"mục 4.2; mục 14.10","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"bgd-coso","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Sổ theo dõi sự cố; văn bản đến","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["phap-che"],"phoi_hop":["co-quan-nha-nuoc","tp"],"noi_dung":"Đầu mối làm việc với cơ quan nhà nước: xác định nội dung yêu cầu, thời hạn trả lời, hồ sơ cần cung cấp. Phòng Marketing không tự trả lời, giải trình với cơ quan nhà nước.","thoi_han":"Theo thời hạn của cơ quan nhà nước","ghi_nhan":"Hồ sơ pháp lý","can_cu":"mảng 38; mục 14.8","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung","chu_tri_chinh":"phap-che","dau_vao