g":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"}],"kiem_soat":["Mọi bản tin, nội dung màn hình có trong kế hoạch phát đã duyệt","Nội dung chuyên môn có bác sĩ xác nhận, qua kiểm pháp lý theo tầng trước khi phát","Dịch vụ, giá, ưu đãi chỉ phát khi thuộc Hạng mục đã duyệt"],"ngoai_le":[{"tinh_huong":"Thông báo khẩn tại cơ sở (tìm người nhà, sự cố, hướng dẫn an toàn)","cach_lam":"Thông báo khẩn phục vụ an toàn/vận hành do cơ sở thực hiện theo quy định chuyên ngành; đầu mối Truyền thông cơ sở hoặc Trưởng nhóm kiêm ghi nhận nhật ký, không giao Media cơ sở."},{"tinh_huong":"Cơ sở không bố trí Chuyên viên Truyền thông cơ sở riêng hoặc vị trí này vắng","cach_lam":"Trưởng nhóm cơ sở kiêm hoặc bố trí người thay có phân quyền vận hành theo lịch; Media cơ sở không tự động tiếp quản phát thanh/màn hình. Phòng khám: đầu mối kiêm nhiệm theo phân công."},{"tinh_huong":"Khoa phòng đề nghị phát nội dung riêng","cach_lam":"Gửi qua Trưởng nhóm Marketing cơ sở; đưa vào kế hoạch tuần sau."}],"nhom_vi_du":"N2","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-phat-thanh-man-hinh"},{"id":"xung-dot-lich","ten":"Hai cơ sở, hai nhóm thương hiệu cùng cần một nguồn lực","nhom_hoat_dong":["N11"],"vi_du":"Cùng ngày thứ Bảy, Bệnh viện Đa khoa TTH Vinh và Bệnh viện Y học cổ truyền Nguyên Phúc cùng cần bộ thiết bị media dùng chung.","buoc":[{"thuc_hien":["cvt|xử lý trùng lịch giữa hai nhóm hoặc thiết bị media dùng chung","tt-nd|chỉ xử lý trùng lịch trong nhóm 1"],"phoi_hop":[],"noi_dung":"Phần mềm báo trùng lịch khi xếp lịch sản xuất chung (chưa có phần mềm: người nhận yêu cầu thứ hai ghi \"cần Tổ trưởng xử lý\" trên sổ yêu cầu); Tổ trưởng của tổ xếp theo thứ tự ưu tiên: việc không được gián đoạn, Hạng mục trọng điểm; nhu cầu tháng đã duyệt; việc phát sinh. Trùng lịch ghi hình trong nhóm: người còn lại cùng nhóm đi; nhóm 2: lùi lịch hoặc Chuyên viên Marketing cơ sở – media cùng nhóm quay tư liệu.","thoi_han":"Yêu cầu cần Tổ trưởng xử lý: trong 04 giờ làm việc từ khi nhận yêu cầu thứ hai","ghi_nhan":"Lịch sản xuất chung; sổ theo dõi yêu cầu","can_cu":"mục 14.8, 14.9; mục 15.3","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"cvt|xử lý trùng lịch giữa hai nhóm hoặc thiết bị media dùng chung","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Lịch sản xuất chung; sổ theo dõi yêu cầu","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và 