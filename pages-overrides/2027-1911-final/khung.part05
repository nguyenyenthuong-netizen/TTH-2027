à KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"}],"kiem_soat":["Dùng thương hiệu, logo của đối tác và của TTH theo điều khoản đã thống nhất bằng văn bản","Nguồn khách riêng cho từng đối tác"],"ngoai_le":[{"tinh_huong":"Cơ sở y tế giới thiệu người bệnh tại địa phương","cach_lam":"Theo QT.16."},{"tinh_huong":"Đối tác đề nghị quảng cáo trên kênh của TTH","cach_lam":"Trưởng phòng xem xét; nội dung của đối tác qua kiểm tra pháp lý như sản phẩm của TTH."},{"tinh_huong":"KOL, KOC","cach_lam":"Theo QT.20."}],"nhom_vi_du":"N1","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-doi-tac"},{"id":"doi-ten-chuyen-nhom","ten":"Cơ sở đổi tên, đổi thương hiệu, chuyển nhóm thương hiệu","nhom_hoat_dong":["N2","N3","N8","N11"],"vi_du":"Một bệnh viện mua lại đang giữ thương hiệu riêng (nhóm 2) có quyết định đổi sang tên TTH; theo quy tắc xếp đơn vị mới, bệnh viện chuyển sang nhóm 1 (mục 3).","buoc":[{"thuc_hien":["tp"],"phoi_hop":["btgd|quyết định đổi tên","phap-che|giấy phép hoạt động đã điều chỉnh","bgd-coso"],"noi_dung":"Nhận quyết định đổi tên; xác định nhóm của cơ sở theo quy tắc xếp đơn vị mới (mang tên TTH: nhóm 1; thương hiệu riêng: nhóm 2) và ngày áp dụng tên mới. Tên mới chỉ dùng trên sản phẩm, kênh, biển hiệu từ ngày áp dụng, khi giấy phép hoạt động đã điều chỉnh (mục 1: Luật Khám bệnh, chữa bệnh 15/2023/QH15; Nghị định 96/2023/NĐ-CP, Điều 70).","thoi_han":"Khi có quyết định","ghi_nhan":"Sổ theo dõi yêu cầu; quyết định đổi tên","can_cu":"mục 3; mục 1","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"tp","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Sổ theo dõi yêu cầu; quyết định đổi tên","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["cvt","dl-1"],"phoi_hop":["tp|ban hành bảng phân công"],"noi_dung":"Cân giờ theo nhóm mới; cập nhật bảng phân công: phần việc của cơ sở ở mọi vị trí theo nhóm thương hiệu chuyển sang người của nhóm mới từ ngày áp dụng; Marketing cơ sở giữ nguyên người, chuyển sang vị trí cùng chức danh của nhóm mới. Nhóm mới vượt giờ: theo quy tắc định biên.","thoi_han":"Trước ngày áp dụng","ghi_nhan":"Bảng phân công","can_cu":"mục 3; mục 21","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung","chu_tri_chinh":"cvt","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Bảng phân công","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qlth-a","qlth-bc"],"phoi_hop":["tp|quyết định Hạng mục đang triển khai"],"noi_dung":"Quản lý thương hiệu của nhóm cũ bàn giao cho Quản lý thương hiệu của nhóm mới: Hạng mục đang triển khai, kế hoạch tháng, hạn mức còn lại, sổ theo dõi yêu cầu, thư mục kho tư liệu của cơ sở. Hạng mục đang triển khai giữ người phụ trách đến khi kết thúc, hoặc chuyển theo quyết định của Trưởng phòng.","thoi_han":"Trước ngày áp dụng","ghi_nhan":"Biên bản bàn giao","can_cu":"mục 14.8; QT.17","de_xuat":true,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung","chu_tri_chinh":"qlth-a","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Biên bản bàn giao","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["tk","tk-nt","cvtt"],"phoi_hop":["qlth|tờ trình; nghiệm thu","bgd-coso|thống nhất thời điểm thay biển","tp|duyệt nhận diện, hình ảnh chủ đạo mới (mục 14.16)"],"noi_dung":"Mẫu thiết kế sẵn, sản phẩm số và in theo tên, nhận diện mới: Chuyên viên thiết kế của nhóm mới; biển hiệu, biển bảng, phương tiện quảng cáo cố định: Chuyên viên thiết kế ngoại tuyến; danh mục biển bảng cần thay, dự toán: Chuyên viên truyền thông của nhóm mới; tờ trình: Quản lý thương hiệu của nhóm mới (cách làm như QT.11, bước 7, 8).","thoi_han":"Trước ngày áp dụng; biển hiệu theo tờ trình đã duyệt","ghi_nhan":"Thư viện mẫu thiết kế sẵn; danh mục biển bảng cần thay","can_cu":"QT.11; mục 14.8","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Thư viện mẫu trên công cụ thiết kế","chu_tri_chinh":"tk","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Thư viện mẫu thiết kế sẵn; danh mục biển bảng cần thay","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["qc","qlsps"],"phoi_hop":["tp|cấp quyền quản trị","cvt|cấp quyền theo ma trận đăng bài, trả lời tin nhắn","bt|thông tin cơ sở trên website","so-hoa"],"noi_dung":"Đổi tên kênh mạng xã hội, Trang doanh nghiệp trên Google theo chính sách nền tảng: Chuyên viên quảng cáo và kênh số của nhóm mới; quyền kênh, tài khoản quảng cáo chuyển theo vị trí của nhóm mới (mục 11.3). Website tthhealthcare.com, App TTH hoặc website các chuỗi: Quản lý sản phẩm số nêu yêu cầu, Phòng Số hóa làm (QT.14); Chuyên viên biên tập của nhóm mới nhập thông tin cơ sở (mục 11.1, số 24).","thoi_han":"Ngày áp dụng","ghi_nhan":"Danh mục kênh; trang quản trị nội dung website","can_cu":"mục 11.3; mục 11.1, số 24; QT.14","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung","chu_tri_chinh":"qc","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Danh mục kênh; trang quản trị nội dung website","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"},{"thuc_hien":["bt","cvtt"],"phoi_hop":["cc|dùng kịch bản mới","qc|đăng"],"noi_dung":"Marketing bàn giao thông tin đã duyệt về tên mới; Contact Center tự cập nhật kịch bản tư vấn và câu trả lời mẫu; Contact Center dùng từ ngày áp dụng. Thông báo khách trên kênh chính thức: nội dung: Chuyên viên truyền thông của nhóm mới; Chuyên viên trưởng duyệt; Chuyên viên quảng cáo và kênh số của nhóm mới đăng.","thoi_han":"Trước ngày áp dụng","ghi_nhan":"Kịch bản tư vấn; kênh chính 