coso|ý kiến của từng cơ sở"],"noi_dung":"Đối soát đăng ký – tham dự – khách – doanh thu ghi nhận theo cơ sở; Quản lý thương hiệu tổng kết; Trưởng phòng báo cáo, đề xuất tiếp tục, điều chỉnh, dừng. Ban Tổng Giám đốc quyết định.","thoi_han":"Báo cáo nhanh 01 ngày sau khi kết thúc; kết quả chính thức sau kỳ chốt số liệu","ghi_nhan":"Phần mềm","can_cu":"mục 14.7; mục 31, mảng 32","de_xuat":false,"thu_tu":9,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung","chu_tri_chinh":"dl-1","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Phần mềm","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"}],"kiem_soat":["Trưởng phòng chủ trì: chương trình trọng điểm theo hệ thống nằm trong kế hoạch năm do Trưởng phòng lập; bổ sung trong năm: Trưởng phòng đề xuất, dùng dự phòng hoặc điều chỉnh kế hoạch năm (mục 4.2)","Nội dung chuyên môn: đơn vị chuyên môn, khoa phòng, bác sĩ; giá, phí: kế toán; duyệt theo phạm vi áp dụng; Marketing đề xuất, lập Hạng mục, truyền thông, tổ chức, đo kết quả","Không đăng giá, ưu đãi chưa được duyệt; tin cơ sở tự đăng không có giá, ưu đãi (mục 16, số 5)","Đổi giá, ưu đãi: cập nhật cùng lúc website, App TTH, kịch bản tư vấn, ấn phẩm","Dữ liệu người đăng ký hội thảo, lớp học chỉ dùng theo nội dung đã đồng ý (mục 17.1)"],"ngoai_le":[{"tinh_huong":"Cơ sở muốn mức ưu đãi khác mức chung của chương trình hệ thống","cach_lam":"Ban Giám đốc cơ sở đề nghị qua Quản lý thương hiệu của nhóm; Ban Tổng Giám đốc duyệt (Đề xuất – chờ duyệt)."},{"tinh_huong":"Chương trình chỉ của 01 cơ sở","cach_lam":"Ban Giám đốc cơ sở duyệt; Marketing làm theo QT.1."},{"tinh_huong":"Hội nghị khoa học cho nhân viên y tế","cach_lam":"Làm theo QT.12."},{"tinh_huong":"Gói cho doanh nghiệp, tổ chức","cach_lam":"Bán, ký hợp đồng: đơn vị do Ban Tổng Giám đốc xác định (mục 28, số 24); Marketing làm truyền thông, hồ sơ năng lực."}],"nhom_vi_du":"N1","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc chuyển giữa hai phân hệ phải cùng mã nguồn; không nhân đôi công việc, chi phí, giờ công hoặc KPI"],"ma_luu_do":"QT-chuong-trinh-he-thong"},{"id":"mao-danh","ten":"Mạo danh, tin giả về bệnh viện, bác sĩ, thương hiệu trên mạng","nhom_hoat_dong":["N5","N3"],"vi_du":"Một trang Facebook dùng tên, logo Bệnh viện Đa khoa TTH Hà Tĩnh và ảnh một bác sĩ của bệnh viện để nhận đặt lịch, thu tiền trước.","buoc":[{"thuc_hien":["cvtt-a"],"phoi_hop":["mkt-coso|báo phát hiện","cc|báo phát hiện"],"noi_dung":"Phát hiện khi theo dõi dư luận hằng ngày, hoặc nhận báo từ Marketing cơ sở, Contact Center, nhân viên, khách. Báo theo lịch trực sự cố.","thoi_han":"Báo trong 30 phút","ghi_nhan":"Sổ theo dõi sự cố","can_cu":"mục 30 (sự cố kênh); mảng 42","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","chu_tri_chinh":"cvtt-a","dau_vao_bat_buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cầ