buoc":"Mã yêu cầu/hạng mục, hồ sơ nguồn, người giao hợp lệ, thời hạn và thông tin cần thiết của bước","dau_ra_kiem_chung":"Kết quả có mã bản ghi, người chịu trách nhiệm, thời điểm, trạng thái và chứng cứ tương ứng: Biên bản chuyển quyền","dieu_kien_chuyen_buoc":"Hoàn tất kiểm tra đầu vào – đầu ra, xử lý sai lệch và ghi người nhận bước tiếp theo; thiếu xác nhận bắt buộc thì khóa chuyển","quy_tac_chong_trung":"Một mã việc, một người chủ trì; người phối hợp không được tự tạo lệnh giao thứ hai; ghi một lần giờ công và KPI","can_duyet_phat_hanh":false,"duyet_chi_phi":"Chỉ khi có phát sinh chi phí: thực hiện theo ma trận tài chính, khác quyền duyệt nội dung","ngoai_le_kiem_soat":"Đầu vào không đạt, quá hạn, thiếu thẩm quyền hoặc xung đột tuyến: chuyển người quản lý trực tiếp/Trưởng phòng; lưu lý do, thời hạn và người chấp thuận thay đổi"}],"kiem_soat":["Không kênh nào bị gián đoạn (mục I.2, số 6)","Quyền gắn với vị trí, không gắn với cá nhân"],"ngoai_le":[{"tinh_huong":"Kênh do cá nhân lập, chưa chuyển được quyền","cach_lam":"Báo Trưởng phòng; người đang quản trị giữ quyền đến khi chuyển được; ghi sổ theo dõi."},{"tinh_huong":"Thời gian giữ song song quyền cũ trước khi thu hồi","cach_lam":"01 tháng sau nghiệm thu, chỉ quyền xem (bước 6)."},{"tinh_huong":"Người giữ quyền cao nhất bằng tài khoản cá nhân nghỉ việc, thuyên chuyển trước khi chuyển quyền","cach_lam":"Chuyển quyền kênh là một mục của biên bản bàn giao (QT.17, bước 2); chưa chuyển được: Trưởng phòng báo Ban Tổng Giám đốc trước ngày người đó nghỉ."}],"nhom_vi_du":"N1","trang_thai_quan_tri_19112026":"LUỒNG ĐẶC TẢ ĐỀ XUẤT – chưa thay thế quy trình đã được ban hành","quy_tac_phan_tuyen":["Một bước có một người chủ trì, có thể có nhiều người phối hợp nhưng không được có hai người cùng quyết định cuối","Giao việc TCT–cơ sở qua tuyến quản lý trực tiếp; hướng dẫn chuyên môn không tự tạo tuyến giao việc","Kiểm tra nội dung, duyệt phát hành, duyệt tài chính và xác nhận y tế phải thể hiện thành dấu vết độc lập","Công việc c