eo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"}],"ban_theo_nhom":false,"ma":"BM-27","loai":"Biểu mẫu","ten":"Bản chốt kỳ tháng","noi_dung":"Lead, đặt lịch, khách, doanh thu ghi nhận theo nhóm, cơ sở, Hạng mục, kênh; chi so với ngân sách; số đã chốt dùng tính KPI","nam_giu":"dl-1","noi_luu_co_pm":"Phần mềm, khóa kỳ","noi_luu_chua_pm":"Bảng tính chốt kỳ có công thức","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"QT.15; mục 30; mục 14.16","so_cu":8,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["dl-1"],"nguoi_nam_giu":"dl-1","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung.","Số đã chốt kỳ phải có nguồn kiểm chứng; không sửa trực tiếp số đã khóa mà thiếu phiên bản điều chỉnh được duyệt."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"xay_dung":["cvtt"],"cap_nhat":["cvtt"],"duyet":["cvt"],"dung":["mdcs","tn"],"truong":[{"ma_truong":"co_so","ten":"Cơ sở","loai_du_lieu":"relation","bat_buoc":