uon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"vướng_mac","ten":"Vướng mắc","loai_du_lieu":"text","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"tham_muu","ten":"Kiến nghị/giải pháp","loai_du_lieu":"text","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["tp"],"nguoi_nam_giu":"dl-1","danh_sach_nguoi_duyet":["btgd"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"BM-2","loai":"Biểu mẫu","ten":"Báo cáo tuần","noi_dung":"Khung chung 02 phần khi chưa có phần mềm; dựng tự động khi có phần mềm","xay_dung":["dl-1"],"nam_giu":"dl-1","cap_nhat":["dl-1"],"duyet":["tp"],"dung":["Mọi vị trí theo quyền"],"noi_luu_co_pm":"Phần mềm, trước 10:00 thứ Bảy","noi_luu_chua_pm":"Bảng tính 02 phần","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"mục 30.5; 29/BB-TTH","so_cu":37,"truong":[{"ma_truong":"tuan_bao_cao","ten":"Tuần báo cáo","loai_du_lieu":"daterange","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ket_qua_tuan","ten":"Kết quả đã thực hiện","loai_du_lieu":"rows","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ke_hoach_tuan_toi","ten":"Việc tuần tiếp theo","loai_du_lieu":"rows","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"han_con_vuong","ten":"Việc vướng, người phối hợp","loai_du_lieu":"rows","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ket_qua_kpi","ten":"Số liệu đo lường có nguồn","loai_du_lieu":"rows","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["dl-1"],"nguoi_nam_giu":"dl-1","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"BM-3","loai":"Biểu mẫu","ten":"Kế hoạch nội dung tháng","noi_dung":"Định hướng tháng; nội dung theo kênh, cơ sở, chủ đề, loại bài, người làm; số lượng so với chỉ tiêu năm; nhu cầu cơ sở; kế hoạch SEO; hạn mức","xay_dung":["cvt"],"nam_giu":"cvt","cap_nhat":["qlth"],"duyet":["tp"],"dung":["qlth","bt","tk","md","qc","tn"],"noi_luu_co_pm":"Phần mềm: kế hoạch tháng","noi_luu_chua_pm":"Trang tính BM-3 của nhóm","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"mục 16, số 12; QT.15, QT.56","so_cu":38,"truong":[{"ma_truong":"ma_ke_hoach","ten":"Mã kế hoạch tháng","bat_buoc":true,"nguon":"Phần mềm sinh","nguoi_nhap":"Phần mềm","nguoi_xem":"Mọi vị trí","loai_du_lieu":"chưa định kiểu – chờ xác nhận"},{"ma_truong":"nhom_thuong_hieu","ten":"Nhóm thương hiệu","bat_buoc":true,"ng