ẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["qlth"],"nguoi_nam_giu":"cvt","danh_sach_nguoi_duyet":["tp","gd-coso","ptgd-tc","btgd"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung.","Chi ngoài hạn mức phải chọn Tổng Giám đốc duyệt; trong hạn mức theo quy chế và Phó Tổng Giám đốc mảng tài chính; không tự suy quyền chỉ bởi danh sách người duyệt của biểu mẫu."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"BM-10","loai":"Biểu mẫu","ten":"Báo cáo Hạng mục trọng điểm","noi_dung":"Kết quả so với kế hoạch theo KPI; chi so với hạn mức; đối soát theo nguồn khách; khách chuyển chéo thương hiệu; bài học","xay_dung":["dl-1"],"nam_giu":"dl-1","cap_nhat":["qlth"],"duyet":["tp"],"dung":["qlth","tp"],"noi_luu_co_pm":"Phần mềm","noi_luu_chua_pm":"Bảng tính chốt kỳ, báo cáo lập theo mẫu","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"QT.1; QT.12","so_cu":5,"truong":[{"ma_truong":"ma_hang_muc","ten":"Mã Hạng mục","loai_du_lieu":"relation","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận the