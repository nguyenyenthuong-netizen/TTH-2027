4, số 5","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung; Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["Mọi điều chỉnh qua cổng tiếp nhận yêu cầu; không điều chỉnh qua tin nhắn riêng (mục 14.1, số 3)","Giữ bản kế hoạch trước điều chỉnh trên phần mềm","Chi đã phát sinh ghi đúng Hạng mục; không chuyển sang Hạng mục khác để tránh vượt hạn mức"],"ngoai_le":[{"tinh_huong":"Ban Tổng Giám đốc chỉ đạo mới làm thay đổi kế hoạch","cach_lam":"Trưởng phòng trình phương án lùi Hạng mục nào, nguồn chi trước khi triển khai (QT.41, bước 4)."},{"tinh_huong":"Sự kiện, hội nghị hoãn, hủy","cach_lam":"Theo QT.21, QT.12."},{"tinh_huong":"Cơ sở tạm ngừng dịch vụ, đổi giờ làm việc","cach_lam":"Theo QT.46."},{"tinh_huong":"Ưu đãi đã công bố bị hủy, đổi điều kiện","cach_lam":"Đính chính theo QT.38; khách đã đăng ký: bộ phận tiếp nhận, xử lý phản ánh của cơ sở giải quyết (QT.1, ngoại lệ)."},{"tinh_huong":"Cần làm gấp hơn thời hạn chuẩn sau khi điều chỉnh","cach_lam":"Theo QT.31."}],"nhom_vi_du":"N1"}],"lich_van_hanh":[{"tan_suat":"Hằng ngày","viec":"Rà soát thông tin, bình luận trên kênh","can_cu":"QT.MKT.09, QĐ.MKT.11","phu_trach":"Bình luận hỏi dịch vụ: Contact Center. Thông tin vi phạm: Chuyên viên quảng cáo và kênh số của nhóm. Dư luận về thương hiệu của nhóm: Chuyên viên truyền thông của nhóm"},{"tan_suat":"Hằng ngày","viec":"Trực tin nhắn theo ca","can_cu":"QyĐ.02.MKT, QĐ.MKT.11","phu_trach":"Contact Center (trước khi nhận: người đang trả lời tại cơ sở, mục 17)"},{"tan_suat":"Hằng ngày","viec":"Báo cáo trực trang Facebook cuối ngày","can_cu":"QĐ.MKT.11","phu_trach":"Contact Center (báo cáo từ hệ thống); trước khi nhận: người đang trả lời tại cơ sở"},{"tan_suat":"Hằng ngày","viec":"Theo dõi thực hiện kế hoạch","can_cu":"QT.MKT.22","phu_trach":"Người phụ trách Hoạt động trên phần mềm; Quản lý thương hiệu theo Hạng mục"},{"tan_suat":"Hằng tuần","viec":"Giao ban nội bộ phòng tại Tổng công ty 09:00 thứ Ba (nhân sự Tổng công ty; người làm việc tạm tại chi nhánh dự trực tuyến, mục I.4); Marketing cơ sở giao ban nội bộ tại cơ sở 01–02 lần","can_cu":"QyĐ.02.MKT; Phòng Marketing Tổng công ty xác nhận ngày 11/11/2026","phu_trach":"Tổng công ty: Trưởng phòng chủ trì; Trưởng phòng vắng hoặc chưa có: Chuyên viên trưởng. Cơ sở: Trưởng nhóm"},{"tan_suat":"Hằng tuần","viec":"Báo cáo tuần, gửi trước 10:00 thứ Bảy","can_cu":"29/BB-TTH","phu_trach":"Dựng tự động; Chuyên viên đo lường và đối soát"},{"tan_suat":"Hằng tuần","viec":"Lịch khám cộng đồng trước 17:00 thứ Sáu","can_cu":"QT.06.MKT","phu_trach":"Truyền thông cơ sở (lịch dựng từ Hoạt động)"},{"tan_suat":"Hằng tuần","viec":"Kế hoạch phát thanh nội viện trước thứ Tư; phát thứ Hai","can_cu":"QT.MKT.22","phu_trach":"Lịch: Chuyên viên truyền thông của nhóm. Kịch bản: Chuyên viên biên tập của nhóm. Thu âm: Chuyên viên media của nhóm. Phát: Chuyên viên Marketing cơ sở – truyền thông (bệnh viện 02 người: Trưởng nhóm kiêm) (QT.29)"},{"tan_suat":"Hằng tháng","viec":"Giao ban Marketing ngành dọc, tuần thứ 2: 01 cuộc chia 03 phần (phần chung; phần nhóm 1; phần nhóm 2)","can_cu":"QyĐ.02.MKT; 29/BB-TTH","phu_trach":"Trưởng phòng chủ trì; Quản lý thương hiệu, Trưởng nhóm"},{"tan_suat":"Hằng tháng","viec":"Kế hoạch tháng","can_cu":"29/BB-TTH, QyĐ.03.MKT, QT.MKT.22","phu_trach":"Ngày 10–15: Trưởng nhóm Marketing cơ sở gửi nhu cầu tháng; Quản lý thương hiệu của nhóm lập BM-3, trình chậm nhất ngày 18; Trưởng phòng duyệt chậm nhất ngày 20; người trình, người duyệt không nghỉ ngày 18–20 (mục 16, số 12)"},{"tan_suat":"Hằng tháng","viec":"Kế hoạch quảng cáo ngày 20–25, gồm kế hoạch cho Công ty Cổ phần Winmed Việt Nam","can_cu":"QT.05.MKT.TCT","phu_trach":"Chuyên viên quảng cáo và kênh số theo nhóm thương hiệu. Winmed (nhóm 2): Winmed gửi nhu cầu; Quản lý thương hiệu nhóm 2 lập kế hoạch; Chuyên viên quảng cáo và kênh số nhóm 2 triển khai"},{"tan_suat":"Hằng tháng","viec":"Số liệu hoạt động tháng (kỳ số liệu: tháng dương lịch), chốt kỳ trong 03 ngày làm việc đầu tháng