 15.4; mục 15.5","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":["qlsps|trang quản trị nội dung website, App TTH","tk-nt|thư viện mẫu thiết kế sẵn","qc|tài khoản gửi tin của nhóm","dl-2|CRM","cnnvy|hộp thư chức danh"],"noi_dung":"Cấp quyền theo danh sách quyền của vị trí; mỗi hệ thống một người cấp (mục 11.3): quyền đăng bài, trả lời tin nhắn, kho tư liệu: Chuyên viên trưởng; quyền gắn với vị trí, không gắn với cá nhân; người nhóm nào chỉ có quyền trên kênh, thư mục, mẫu của nhóm đó (quyền tạm khi được cho phép làm thay: mục 15.4).","thoi_han":"Ngày đầu nhận việc","ghi_nhan":"Danh sách quyền","can_cu":"mục 11.3; mục 15.5, số 2","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":["bt|danh sách kiểm tra pháp lý (DS-1 do bộ phận pháp chế cung cấp)","dl-2|bảo vệ dữ liệu cá nhân","md|chuẩn kỹ thuật media (QC-4)","tk|quy chuẩn ứng dụng nhận diện của nhóm (QC-1, QC-2)","tk-nt|thư viện mẫu, quy chuẩn in"],"noi_dung":"Đào tạo khi nhận việc theo mô tả công việc của vị trí: Quy chế phối hợp, phần mềm, danh sách kiểm tra pháp lý, bảo vệ dữ liệu cá nhân, chuẩn của chuyên môn.","thoi_han":"Theo kế hoạch đào tạo của vị trí","ghi_nhan":"Biên bản đào tạo","can_cu":"mục 9.2; mục 9.3","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":["nhan-luc|hồ sơ"],"noi_dung":"Có người bàn giao: làm song song 10 ngày làm việc, lập biên bản bàn giao; Chuyên viên trưởng xác nhận.","thoi_han":"10 ngày làm việc","ghi_nhan":"Biên bản bàn giao","can_cu":"mục 15.5; QT.17","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt","tt-nd","tt-ts","tn"],"phoi_hop":["cvt|duyệt đánh giá theo tuyến"],"noi_dung":"Người đánh giá theo tuyến theo dõi kỹ năng cần học trong 06 tháng đầu (mô tả công việc); đánh giá theo tuyến (mục 14.13).","thoi_han":"06 tháng đầu","ghi_nhan":"Phần mềm","can_cu":"mục 9.3; mục 14.13","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Quyền gắn với vị trí; không cấp quyền cá nhân (mục 11.3)","Người mới dùng mô tả công việc, hồ sơ vị trí của vị trí; không nhận việc qua tin nhắn riêng (mục 14.1, số 3)"],"ngoai_le":[{"tinh_huong":"Điều chuyển giữa vị trí, giữa nhóm thương hiệu","cach_lam":"Bàn giao phần việc cũ theo mục 15.5; thu hồi quyền cũ cùng ngày cấp quyền mới (mục 11.3; QT.17)."},{"tinh_huong":"Không có người bàn giao (vị trí mới, người cũ đã nghỉ)","cach_lam":"Chuyên viên trưởng hướng dẫn theo hồ sơ vị trí; người thay chính hỗ trợ trong giờ của mình (mục 15.4)."},{"tinh_huong":"Kiêm nhiệm tạm thời khi thay người vắng","cach_lam":"Theo QT.7."},{"tinh_huong":"Nhân sự chi nhánh chuyển về Tổng công ty theo lộ trình","cach_lam":"Theo mục 19, mục 21.3; quyền kênh, kho tư liệu theo QT.23."},{"tinh_huong":"Trưởng nhóm Marketing cơ sở của cơ sở mới","cach_lam":"Có mặt từ 03 tháng trước khai trương; theo QT.9."}],"nhom_vi_du":"N1"},{"id":"dieu-chinh-ke-hoach","ten":"Điều chỉnh kế hoạch tháng, Hạng mục đang triển khai: đổi lịch, đổi ngân sách, dừng, hủy","nhom_hoat_dong":["N1","N11"],"vi_du":"Giữa tháng 6: Bệnh viện Y học cổ truyền Nguyên Phúc đề nghị lùi chương trình tri ân 02 tuần vì thiếu bác sĩ; sản phẩm đang làm dở, quảng cáo đã triển khai 03 ngày.","buoc":[{"thuc_hien":["qlth"],"phoi_hop":["tn|đề nghị của cơ sở","bgd-coso|đề nghị của cơ sở"],"noi_dung":"Nhận hoặc lập đề nghị điều chỉnh qua cổng tiếp nhận: nội dung, lý do, ảnh hưởng (Hoạt động, sản phẩm đang làm, chi đã phát sinh, Lead).","thoi_han":"Ngay khi phát sinh","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.1; mục 14.6","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlth"],"phoi_hop":["tt-nd|sản phẩm đang làm","tt-ts|quảng cáo, lịch