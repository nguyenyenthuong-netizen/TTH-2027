_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ngay_ket_thuc","ten":"Ngày kết thúc","loai_du_lieu":"date","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"han_bao_cao","ten":"Hạn báo cáo 02 ngày","loai_du_lieu":"date","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"chi_phi","ten":"Chi phí","loai_du_lieu":"money","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"lead_hop_le","ten":"Lead hợp lệ","loai_du_lieu":"number","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"lich_hen","ten":"Số lịch đặt","loai_du_lieu":"number","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"khach_thuc_te","ten":"Khách theo nguồn","loai_du_lieu":"number","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"nguon_doi_soat","ten":"Nguồn số liệu","loai_du_lieu":"files","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ket_luan","ten":"Kết luận tối ưu","loai_du_lieu":"text","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"}],"ban_theo_nhom":true,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["qc"],"nguoi_nam_giu":"dl-1","danh_sach_nguoi_duyet":["qlth"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"BM-15","loai":"Biểu mẫu","ten":"Biên bản nghiệm thu","noi_dung":"Đúng yêu cầu, dùng được cho mục đích; ảnh nghiệm thu; người nghiệm thu khác người làm","xay_dung":["cvt"],"nam_giu":"cvt","cap_nhat":["cvt"],"duyet":["tp"],"dung":["Mọi vị trí theo quyền"],"noi_luu_co_pm":"Phần mềm; k