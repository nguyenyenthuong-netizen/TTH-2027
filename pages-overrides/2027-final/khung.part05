 mục"},{"thuc_hien":["cvt"],"phoi_hop":["bgd-coso"],"noi_dung":"Phiếu góp ý quý của Ban Giám đốc cơ sở (thang 100 điểm); tổng hợp, báo Trưởng phòng; dùng chấm KPI.","thoi_han":"Hằng quý","ghi_nhan":"Phiếu góp ý quý của Ban Giám đốc cơ sở (mục 9.4)","can_cu":"mục 12.5; mục 24.4","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Mỗi phản ánh có người nhận, hạn trả lời trên sổ theo dõi","Ban Giám đốc cơ sở không giao việc sản xuất trực tiếp cho nhân viên Tổng công ty","Mỗi bất đồng có người quyết định, hạn quyết định trên sổ theo dõi (mục 4.2)"],"ngoai_le":[{"tinh_huong":"Ban Giám đốc cơ sở đề nghị đổi người Marketing cơ sở","cach_lam":"Chuyên viên trưởng trình Trưởng phòng; Phòng Nhân lực thực hiện theo quy định."},{"tinh_huong":"Bất đồng giữa Trưởng nhóm Marketing cơ sở và Quản lý thương hiệu của nhóm (lịch, thứ tự việc tại cơ sở)","cach_lam":"Hai bên thống nhất theo thứ tự ưu tiên tại cơ sở; chưa được thì Chuyên viên trưởng quyết định trong 01 ngày làm việc; liên quan Ban Giám đốc cơ sở thì Trưởng phòng làm việc với Ban Giám đốc cơ sở (mục 4.2; mục 14.9)."},{"tinh_huong":"Bất đồng trong Phòng Marketing (thông điệp, pháp lý, nhận diện, lịch, ngân sách quảng cáo)","cach_lam":"Theo bảng phân quyền quyết định khi có tranh chấp (mục 14.8); tranh chấp giữa Quản lý thương hiệu và bên sản xuất về nội dung: Trưởng phòng quyết định."}],"nhom_vi_du":"N1"},{"id":"doi-tac","ten":"Hợp tác truyền thông với đối tác: ký kết, đồng thương hiệu, sự kiện chung","nhom_hoat_dong":["N7","N6"],"vi_du":"Ngân hàng đối tác đề nghị ký kết ưu đãi khám sức khỏe cho khách hàng của ngân hàng, kèm sự kiện ký kết và truyền thông chung.","buoc":[{"thuc_hien":["don-vi-ky-ket"],"phoi_hop":["btgd"],"noi_dung":"Đơn vị ký kết đối tác cấp hệ thống làm việc nội dung hợp tác, hợp đồng; gửi Phòng Marketing phần truyền thông qua cổng tiếp nhận yêu cầu.","thoi_han":"Khi có thỏa thuận","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 28, số 24","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlth-a"],"phoi_hop":["phap-che|điều khoản sử dụng thương hiệu","tk-a|quy chuẩn nhận diện"],"noi_dung":"Phương án truyền thông chung: thông điệp, cách thể hiện hai thương hiệu, kênh, quyền sử dụng logo; bộ phận pháp chế xem điều khoản sử dụng thương hiệu.","thoi_han":"Trước ký kết","ghi_nhan":"Kế hoạch Hạng mục trọng điểm","can_cu":"mục 14.16; Quyết định kiến trúc thương hiệu","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["tp"],"phoi_hop":["btgd"],"noi_dung":"Trưởng phòng duyệt phương án truyền thông; dùng logo TTH Group, thông cáo báo chí theo phân cấp duyệt.","thoi_han":"Theo phân cấp duyệt","ghi_nhan":"Tờ trình","can_cu":"mục 14.16; QyĐ.03.MKT","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["bt-ac","tk-a","md-ac"],"phoi_hop":[],"noi_dung":"Thông cáo, bài (Chuyên viên biên tập nhóm 1); bộ sự kiện ký kết (Chuyên viên thiết kế nhóm 1); ghi hình (Chuyên viên media nhóm 1).","thoi_han":"Theo thời hạn chuẩn","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.7; QT.12","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvtt-a"],"phoi_hop":["bao-chi"],"noi_dung":"Mời báo chí, gửi thông cáo theo chuẩn quan hệ công chúng.","thoi_han":"Theo kế hoạch","ghi_nhan":"Thông cáo báo chí; danh sách mời báo chí (mục 9.4)","can_cu":"mục 7.2","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc-a"],"phoi_hop":["dl-1|nguồn khách đối tác"],"noi_dung":"Đăng trên kênh; nguồn khách riêng của đối tác để đo khách giới thiệu.","thoi_han":"Theo lịch đăng","ghi_nhan":"Danh mục nguồn khách (mục 9.4)","can_cu":"mục 12.5","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qlth-a"],"phoi_hop":["dl-1","don-vi-ky-ket"],"noi_dung":"Báo cáo kết quả hợp tác theo nguồn khách: Lead, khách, doanh thu từ đối tác.","thoi_han":"Hằng quý","ghi_nhan":"Báo cáo Hạng mục trọng điểm","can_cu":"mục 12.5","de_xuat":true,"thu_tu":7,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung; Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["Dùng thương hiệu, logo của đối tác và của TTH theo điều khoản đã thống nhất bằng văn bản","Nguồn khách riêng cho từng đối tác"],"ngoai_le":[{"tinh_huong":"Cơ sở y tế giới thiệu người bệnh tại địa phương","cach_lam":"Theo QT.16."},{"tinh_huong":"Đối tác đề nghị quảng cáo trên kênh của TTH","cach_lam":"Trưởng phòng xem xét; nội dung của đối tác qua kiểm tra pháp lý như sản phẩm của TTH."},{"tinh_huong":"KOL, KOC","cach_lam":"Theo QT.20."}],"nhom_vi_du":"N1"},{"id":"doi-ten-chuyen-nhom","ten":"Cơ sở đổi tên, đổi thương hiệu, chuyển nhóm thương hiệu","nhom_hoat_dong":["N2","N3","N8","N11"],"vi_du":"Một bệnh viện mua lại đang giữ thương hiệu riêng (nhóm 2) có quyết định đổi sang tên TTH; theo quy tắc xếp đơn vị mới, bệnh viện chuyển sang nhóm 1 (mục 3).","buoc":[{"thuc_hien":["tp"],"phoi_hop":["btgd|quyết định đổi tên","phap-che|giấy phép hoạt động đã điều chỉnh","bgd-coso"],"noi_dung":"Nhận quyết định đổi tên; xác định nhóm của cơ sở theo quy tắc xếp đơn vị mới (mang tên TTH: nhóm 1; thương hiệu riêng: nhóm 2) và ngày áp dụng tên mới. Tên mới chỉ dùng trên sản phẩm, kênh, biển hiệu từ ngày áp dụng, khi giấy phép hoạt động đã điều chỉnh (mục 1: Luật Khám bệnh, chữa bệnh 15/2023/QH15; Nghị định 96/2023/NĐ-CP, Điều 70).","thoi_han":"Khi có quyết định","ghi_nhan":"Sổ theo dõi yêu cầu; quyết định đổi tên","can_cu":"mục 3; mục 1","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvt","dl-1"],"phoi_hop":["tp|ban hành bảng phân công"],"noi_dung":"Cân giờ theo nhóm mới; cập nhật bảng phân công: phần việc của cơ sở ở mọi vị trí theo nhóm thương hiệu chuyển sang người của nhóm mới từ ngày áp dụng; Marketing cơ sở giữ nguyên người, chuyển sang vị trí cùng chức danh của nhóm mới. Nhóm mới vượt giờ: theo quy tắc định biên.","thoi_han":"Trước ngày áp dụng","ghi_nhan":"Bảng phân công","can_cu":"mục 3; mục 21","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qlth-a","qlth-bc"],"phoi_hop":["tp|quyết định Hạng mục đang triển khai"],"noi_dung":"Quản lý thương hiệu của nhóm cũ bàn giao cho Quản lý thương hiệu của nhóm mới: Hạng mục đang triển khai, kế hoạch tháng, hạn mức còn lại, sổ theo dõi yêu cầu, thư mục kho tư liệu của cơ sở. Hạng mục đang triển khai giữ người phụ trách đến khi kết thúc, hoặc chuyển theo quyết định của Trưởng phòng.","thoi_han":"Trước ngày áp dụng","ghi_nhan":"Biên bản bàn giao","can_cu":"mục 14.8; QT.17","de_xuat":true,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tk","tk-nt","cvtt"],"phoi_hop":["qlth|tờ trình; nghiệm thu","bgd-coso|thống nhất thời điểm thay biển","tp|duyệt nhận diện, hình ảnh chủ đạo mới (mục 14.16)"],"noi_dung":"Mẫu thiết kế sẵn, sản phẩm số và in theo tên, nhận diện mới: Chuyên viên thiết kế của nhóm mới; biển hiệu, biển bảng, phương tiện quảng cáo cố định: Chuyên viên thiết kế ngoại tuyến; danh mục biển bảng cần thay, dự toán: Chuyên viên truyền thông của nhóm mới; tờ trình: Quản lý thương hiệu của nhóm mới (cách làm như QT.11, bước 7, 8).","thoi_han":"Trước ngày áp dụng; biển hiệu theo tờ trình đã duyệt","ghi_nhan":"Thư viện mẫu thiết kế sẵn; danh mục biển bảng cần thay","can_cu":"QT.11; mục 14.8","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Thư viện mẫu trên công cụ thiết kế"},{"thuc_hien":["qc","qlsps"],"phoi_hop":["tp|cấp quyền quản trị","cvt|cấp quyền theo ma trận đăng bài, trả lời tin nhắn","bt|thông tin cơ sở trên website","so-hoa"],"noi_dung":"Đổi tên kênh mạng xã hội, Trang doanh nghiệp trên Google theo chính sách nền tảng: Chuyên viên quảng cáo và kênh số của nhóm mới; quyền kênh, tài khoản quảng cáo chuyển theo vị trí của nhóm mới (mục 11.3). Website tthhealthcare.com, App TTH hoặc website các chuỗi: Quản lý sản phẩm số nêu yêu cầu, Phòng Số hóa làm (QT.14); Chuyên viên biên tập của nhóm mới nhập thông tin cơ sở (mục 11.1, số 24).","thoi_han":"Ngày áp dụng","ghi_nhan":"Danh mục kênh; trang quản trị nội dung website","can_cu":"mục 11.3; mục 11.1, số 24; QT.14","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt","cvtt"],"phoi_hop":["cc|dùng kịch bản mới","qc|đăng"],"noi_dung":"Marketing bàn giao thông tin đã duyệt về tên mới; Contact Center tự cập nhật kịch bản tư vấn và câu trả lời mẫu; Contact Center dùng từ ngày áp dụng. Thông báo khách trên kênh chính thức: nội dung: Chuyên viên truyền thông của nhóm mới; Chuyên viên trưởng duyệt; Chuyên viên quảng cáo và kênh số của nhóm mới đăng.","thoi_han":"Trước ngày áp dụng","ghi_nhan":"Kịch bản tư vấn; kênh chính thức","can_cu":"mục 17; mục 16.1","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-1"],"phoi_hop":["cvt|chấm KPI quý"],"noi_dung":"Số liệu KPI, doanh thu theo nguồn khách của cơ sở: trước ngày áp dụng tính cho nhóm cũ, từ ngày áp dụng tính cho nhóm mới; ghi ngày chuyển trên phần mềm để đối chiếu.","thoi_han":"Kỳ chốt số liệu đầu tiên sau ngày áp dụng","ghi_nhan":"Báo cáo tháng; phần mềm","can_cu":"mục 12.5","de_xuat":true,"thu_tu":7,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["cvt"],"phoi_hop":["tp|duyệt"],"noi_dung":"Cập nhật phạm vi nhóm (mục 3), bảng phân công, danh mục kênh; báo Trưởng phòng.","thoi_han":"Sau ngày áp dụng","ghi_nhan":"Bảng phân công; mục 3","can_cu":"mục 3; mục 21","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Không dùng tên mới trên sản phẩm, kênh, biển hiệu trước ngày áp dụng hoặc khi giấy phép hoạt động chưa điều chỉnh (Đề xuất – chờ duyệt)","Mỗi cơ sở thuộc 01 nhóm; từ ngày áp dụng, mọi vị trí theo nhóm làm việc với người của nhóm mới (mục 3)","Sản phẩm còn tên cũ trên kênh, biển bảng có trong danh mục cần thay, có hạn thay"],"ngoai_le":[{"tinh_huong":"Cơ sở đổi tên nhưng không đổi nhóm (ví dụ đổi tên trong cùng chuỗi chuyên khoa)","cach_lam":"Bỏ bước 2, 3; làm bước 4–8 với người của nhóm hiện tại."},{"tinh_huong":"Cơ sở mới, chưa hoạt động, chưa có kênh","cach_lam":"Theo QT.9."},{"tinh_huong":"Thương hiệu hệ thống mới theo Phụ lục 03 của Quyết định kiến trúc thương hiệu (Nguyên Bách Healthcare, Thái Thượng Hoàng Healthcare), nếu được hình thành","cach_lam":"Phần chung vào nhóm 2; số người theo quy tắc định biên (mục 21)."},{"tinh_huong":"Kênh cũ không đổi tên được theo chính sách nền tảng","cach_lam":"Lập kênh mới theo QT.9, bước 4; kênh cũ đăng thông báo chuyển kênh; quyền kênh cũ thu hồi theo QT.23. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Cơ sở ngừng hoạt động hẳn, sáp nhập, chuyển nhượng","cach_lam":"Trưởng phòng nhận quyết định; kênh, Trang doanh nghiệp trên Google: đăng thông báo, đóng hoặc chuyển theo quyết định (quyền theo mục 11.3); website, App TTH: Quản lý sản phẩm số gỡ hoặc chuyển trang cơ sở (QT.14); tư liệu giữ trong kho tư liệu; Marketing cơ sở: Chuyên viên trưởng đề xuất bố trí theo mục 19, mục 21, Phòng Nhân lực thực hiện; cân giờ: bước 2. (Đề xuất – chờ duyệt)"}],"nhom_vi_du":"chung"},{"id":"thanh-tra-kiem-tra","ten":"Cơ quan nhà nước thanh tra, kiểm tra, yêu cầu giải trình, xử phạt về quảng cáo, thông tin trên kênh","nhom_hoat_dong":["N11","N5"],"vi_du":"Cơ quan nhà nước có thẩm quyền gửi văn bản yêu cầu Bệnh viện Đa khoa TTH Quảng Bình giải trình một bài quảng cáo gói khám trên Facebook của bệnh viện.","buoc":[{"thuc_hien":["bgd-coso","btgd"],"phoi_hop":["phap-che","tp","tn|báo khi đoàn kiểm tra làm việc tại cơ sở"],"noi_dung":"Đơn vị nhận văn bản, quyết định thanh tra, kiểm tra (Ban Giám đốc cơ sở, Ban Tổng Giám đốc) chuyển bộ phận pháp chế và Trưởng phòng Marketing. Marketing cơ sở, nhân viên nhận yêu cầu trực tiếp từ đoàn kiểm tra: báo Trưởng nhóm; Trưởng nhóm báo Trưởng phòng theo lịch trực sự cố.","thoi_han":"Trong ngày nhận văn bản","ghi_nhan":"Sổ theo dõi sự cố; văn bản đến","can_cu":"mục 4.2; mục 14.10","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["phap-che"],"phoi_hop":["co-quan-nha-nuoc","tp"],"noi_dung":"Đầu mối làm việc với cơ quan nhà nước: xác định nội dung yêu cầu, thời hạn trả lời, hồ sơ cần cung cấp. Phòng Marketing không tự trả lời, giải trình với cơ quan nhà nước.","thoi_han":"Theo thời hạn của cơ quan nhà nước","ghi_nhan":"Hồ sơ pháp lý","can_cu":"mảng 38; mục 14.8","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt","qc"],"phoi_hop":["cvt|kiểm tra đủ hồ sơ","dl-1|số liệu triển khai quảng cáo","cvtt|hợp đồng nhà cung cấp, KOL, KOC (nếu có)"],"noi_dung":"Cung cấp hồ sơ của sản phẩm bị yêu cầu: bản đã phát hành, ngày đăng, kênh, người duyệt, bản kiểm tra pháp lý, xác nhận chuyên môn của bác sĩ, xác nhận giá của kế toán, hồ sơ nội dung quảng cáo đã nộp (nếu có); tài khoản quảng cáo: lịch sử triển khai, ngân sách.","thoi_han":"Theo hạn bộ phận pháp chế đề nghị","ghi_nhan":"Phần mềm; kho tư liệu; hồ sơ pháp lý","can_cu":"mục 16.1; mảng 38","de_xuat":true,"thu_tu":3,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["qc","bt"],"phoi_hop":["phap-che|xác định dấu hiệu vi phạm","qlsps|website, App TTH"],"noi_dung":"Bộ phận pháp chế xác định có dấu hiệu vi phạm: tạm ẩn bài, dừng quảng cáo đang dùng nội dung đó; rà sản phẩm cùng nội dung trên kênh khác, trên website (cách làm như QT.38, bước 2). Không xóa sản phẩm, lịch sử đăng, lịch sử quảng cáo khi bộ phận pháp chế chưa đồng ý.","thoi_han":"03 giờ từ khi bộ phận pháp chế báo","ghi_nhan":"Sổ theo dõi sự cố","can_cu":"QT.38; mục 14.8","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tp"],"phoi_hop":["btgd","phap-che","bgd-coso"],"noi_dung":"Báo Ban Tổng Giám đốc; thống nhất với bộ phận pháp chế nội dung giải trình phần Marketing; trình theo ma trận thẩm quyền.","thoi_han":"Theo thời hạn của cơ quan nhà nước","ghi_nhan":"Văn bản giải trình","can_cu":"mục 4.2; mục 14.16","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["phap-che"],"phoi_hop":["co-quan-nha-nuoc","tp","bgd-coso","ke-toan|nộp phạt theo quyết định"],"noi_dung":"Nhận kết luận, quyết định xử phạt; báo Trưởng phòng, Ban Giám đốc cơ sở; theo dõi thực hiện.","thoi_han":"Theo quyết định của cơ quan nhà nước","ghi_nhan":"Hồ sơ pháp lý","can_cu":"mảng 38","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["phap-che","cvt"],"phoi_hop":["tp|duyệt danh sách kiểm tra; nhận báo cáo","bt|sửa mẫu, kịch bản của nhóm"],"noi_dung":"Ghi nguyên nhân (nội dung đầu vào, sản xuất, kiểm tra, duyệt, đăng); cập nhật danh sách kiểm tra pháp lý (bộ phận pháp chế cung cấp, Trưởng phòng duyệt); phổ biến cho toàn phòng, Marketing cơ sở (Chuyên viên trưởng; QT.18, bước 2, 5). Kết luận vi phạm tính vào KPI “Không vi phạm pháp luật quảng cáo y tế” của vị trí làm, kiểm tra sản phẩm (mục 12.5).","thoi_han":"Sau khi có kết luận","ghi_nhan":"Sổ theo dõi sự cố; danh sách kiểm tra trên phần mềm","can_cu":"QT.18; mục 12.5","de_xuat":true,"thu_tu":7,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"}],"kiem_soat":["Một đầu mối làm việc với cơ quan nhà nước: bộ phận pháp chế (Đề xuất – chờ duyệt)","Hồ sơ mỗi sản phẩm (bản kiểm tra pháp lý, xác nhận chuyên môn, xác nhận giá, người duyệt) tra được trên phần mềm","Không xóa sản phẩm, lịch sử đăng, lịch sử quảng cáo đang bị yêu cầu khi bộ phận pháp chế chưa đồng ý; chỉ tạm ẩn, dừng quảng cáo (Đề xuất – chờ duyệt)"],"ngoai_le":[{"tinh_huong":"Đoàn kiểm tra làm việc tại cơ sở, yêu cầu xem kênh, tài khoản","cach_lam":"Trưởng nhóm Marketing cơ sở báo Trưởng phòng, bộ phận pháp chế ngay; cung cấp theo hướng dẫn của bộ phận pháp chế. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Yêu cầu liên quan dữ liệu cá nhân khách hàng","cach_lam":"Bộ phận pháp chế xác định căn cứ trước khi cung cấp; lộ, mất dữ liệu: theo QT.40."},{"tinh_huong":"Sản phẩm do nhà cung cấp, KOL, KOC đăng","cach_lam":"Chuyên viên truyền thông của nhóm, Quản lý thương hiệu của nhóm cung cấp hợp đồng, nội dung đã duyệt (QT.20, QT.32)."},{"tinh_huong":"Báo chí đưa tin về việc bị kiểm tra, xử phạt","cach_lam":"Theo QT.6; phát ngôn theo quy chế phát ngôn."},{"tinh_huong":"Đoàn đánh giá chất lượng bệnh viện, kiểm tra chung (không riêng quảng cáo)","cach_lam":"Phòng Quản lý chất lượng là đầu mối; Phòng Marketing cung cấp phần thuộc mình: thông tin công khai (QT.28), biển bảng (QT.13), hồ sơ sản phẩm (bước 3). (Đề xuất – chờ duyệt)"}],"nhom_vi_du":"N1"},{"id":"tam-ngung-doi-gio","ten":"Cơ sở tạm ngừng dịch vụ, đổi giờ làm việc","nhom_hoat_dong":["N3","N4","N8","N9"],"vi_du":"Bệnh viện Đa khoa TTH Hà Tĩnh tạm ngừng dịch vụ nội soi 02 tuần để bảo trì thiết bị; cùng tháng, Phòng khám Đa khoa TTH Khe Tre đổi giờ làm việc ngày thứ Bảy.","buoc":[{"thuc_hien":["tn","dmpk"],"phoi_hop":["bgd-coso|duyệt nội dung"],"noi_dung":"Gửi thông tin thay đổi một lần qua cổng tiếp nhận yêu cầu sau khi Ban Giám đốc cơ sở duyệt: dịch vụ tạm ngừng hoặc giờ làm việc mới, ngày bắt đầu, ngày dự kiến hoạt động lại, nơi khách được chuyển đến (nếu có).","thoi_han":"Ngay khi Ban Giám đốc cơ sở quyết định","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 11.1, số 24","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qc"],"phoi_hop":["qlth|điều chỉnh hạn mức Hạng mục","dl-2|lịch gửi chung"],"noi_dung":"Dừng hoặc chỉnh quảng cáo dẫn khách đến dịch vụ tạm ngừng, quảng cáo có giờ làm việc cũ; tạm dừng tin chăm sóc tự động, gửi tin hàng loạt mời dùng dịch vụ đó (Chuyên viên quảng cáo và kênh số của nhóm; QT.5).","thoi_han":"Trong ngày nhận thông tin","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"QT.14, bước 6; QT.5","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["bt","qc"],"phoi_hop":[],"noi_dung":"Cập nhật giờ làm việc, trạng thái dịch vụ trên website (Chuyên viên biên tập của nhóm, trang quản trị nội dung website) và Trang doanh nghiệp trên Google (Chuyên viên quảng cáo và kênh số của nhóm), cùng thời hạn.","thoi_han":"Trong ngày nhận đủ thông tin","ghi_nhan":"Trang quản trị nội dung website; Trang doanh nghiệp trên Google","can_cu":"mục 11.1, số 24; QT.14","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tn"],"phoi_hop":["bgd-coso|duyệt nội dung chữ","tk|sản phẩm mới ngoài mẫu thiết kế sẵn","tn|nghiệm thu sản phẩm mới"],"noi_dung":"Đăng thông báo vận hành trên Facebook của bệnh viện bằng mẫu thiết kế sẵn; Ban Giám đốc cơ sở duyệt nội dung chữ; sản phẩm mới: Chuyên viên thiết kế của nhóm làm, Trưởng nhóm Marketing cơ sở nghiệm thu.","thoi_han":"Cấp 1: 01 ngày làm việc; cấp 2: 02 ngày làm việc","ghi_nhan":"Facebook của bệnh viện","can_cu":"mục 16.1; mục 16, số 5","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt","cc"],"phoi_hop":["tiep-don|danh sách khách đã đặt lịch"],"noi_dung":"Marketing chuyển thông tin dịch vụ tạm ngừng, nơi chuyển khách, giờ mới đã được cơ sở duyệt; Contact Center cập nhật kịch bản tư vấn; Contact Center báo khách đã đặt lịch trong thời gian tạm ngừng; lịch đã đặt: cơ sở xử lý theo chính sách của cơ sở.","thoi_han":"Trong ngày nhận thông tin","ghi_nhan":"Kịch bản tư vấn; sổ theo dõi","can_cu":"mục 17; QT.38, bước 5","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlsps"],"phoi_hop":["so-hoa"],"noi_dung":"Website tthhealthcare.com, App TTH, website các chuỗi: dịch vụ tạm ngừng không nhận đặt lịch trong thời gian tạm ngừng; Quản lý sản phẩm số gửi yêu cầu Phòng Số hóa khi cần chỉnh chức năng (QT.14, bước 4).","thoi_han":"Trước ngày bắt đầu tạm ngừng","ghi_nhan":"Cổng tiếp nhận yêu cầu của Phòng Số hóa","can_cu":"QT.14; mục 17","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tn"],"phoi_hop":["qlth|xác nhận mở lại quảng cáo","qc","bt"],"noi_dung":"Hoạt động lại: Trưởng nhóm báo qua cổng tiếp nhận yêu cầu; bước 2–6 làm lại theo thông tin mới; quảng cáo, tin chăm sóc mở lại sau khi Quản lý thương hiệu của nhóm xác nhận.","thoi_han":"Trước ngày hoạt động lại","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 11.1, số 24","de_xuat":true,"thu_tu":7,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"}],"kiem_soat":["Thông tin cơ sở (tên, địa chỉ, giờ làm việc, điện thoại) là một bản trên phần mềm; website, Trang doanh nghiệp trên Google cập nhật cùng thời hạn (mục 11.1, số 24)","Không còn quảng cáo, tin chăm sóc mời dùng dịch vụ đang tạm ngừng (Đề xuất – chờ duyệt)"],"ngoai_le":[{"tinh_huong":"Tạm ngừng do sự cố (mất điện, sự cố y khoa, thiên tai)","cach_lam":"Thông báo khẩn tại cơ sở theo quy định của cơ sở; thông tin ra bên ngoài theo QT.6."},{"tinh_huong":"Nghỉ lễ, Tết theo lịch năm","cach_lam":"Lịch nghỉ đưa vào nhu cầu tháng (ngày 10–15); làm như bước 3–5."},{"tinh_huong":"Phòng khám (một bộ kênh mạng xã hội chung của TTH Clinic)","cach_lam":"Đầu mối kiêm nhiệm gửi thông báo qua cổng tiếp nhận yêu cầu; Chuyên viên quảng cáo và kênh số nhóm 1 đăng trên kênh chung khi đủ bước kiểm, nghiệm thu (mục 14.16). (Đề xuất – chờ duyệt)"},{"tinh_huong":"Bác sĩ nghỉ, đổi lịch khám","cach_lam":"Theo QT.14 (lịch làm việc của bác sĩ lấy từ HIS khi có kết nối)."},{"tinh_huong":"Dịch vụ dừng hẳn","cach_lam":"Quản lý sản phẩm số cập nhật danh mục dịch vụ theo QT.28, bước 5; sản phẩm đã phát hành có dịch vụ đó: gỡ theo QT.38."}],"nhom_vi_du":"N1"},{"id":"phat-truc-tiep","ten":"Phát trực tiếp trên kênh chính thức (tư vấn sức khỏe, sự kiện, hội thảo)","nhom_hoat_dong":["N3","N6","N2"],"vi_du":"Tổng công ty phát trực tiếp chương trình tư vấn sức khỏe của bác sĩ Bệnh viện Đa khoa TTH Vinh trên Facebook của bệnh viện; Chuyên viên Marketing cơ sở – media vận hành máy quay tại bệnh viện.","buoc":[{"thuc_hien":["qlth"],"phoi_hop":["tn|bác sĩ, địa điểm tại cơ sở","tt-nd|lịch sản xuất chung"],"noi_dung":"Đưa buổi phát trực tiếp vào kế hoạch Hạng mục hoặc kế hoạch tháng: chủ đề, kênh, ngày giờ, bác sĩ, người dẫn; xếp vào lịch sản xuất chung.","thoi_han":"Theo kế hoạch tháng (Trưởng phòng duyệt chậm nhất ngày 20)","ghi_nhan":"Kế hoạch tháng; lịch sản xuất chung","can_cu":"mục 4.2; QT.1","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Trang tính BM-3 của nhóm"},{"thuc_hien":["bt"],"phoi_hop":["bac-si|xác nhận chuyên môn"],"noi_dung":"Kịch bản: nội dung, câu hỏi dự kiến; giá, ưu đãi chỉ nói khi thuộc Hạng mục đã duyệt và kế toán đã xác nhận; không nêu thông tin người bệnh. Bác sĩ xác nhận chuyên môn; kiểm pháp lý theo tầng (mục 15.6); Quản lý thương hiệu của nhóm nghiệm thu; buổi phát có báo chí, rủi ro cao: Trưởng phòng duyệt (mục 14.16).","thoi_han":"03 ngày làm việc trước buổi phát","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 16.1; mục 14.8","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["md","mdcs"],"phoi_hop":["tk|hình hiệu, khung hình","tn|giao việc Chuyên viên Marketing cơ sở – media"],"noi_dung":"Chuẩn bị kỹ thuật: thiết bị, đường truyền, hình hiệu, khung hình theo mẫu thiết kế sẵn; phát thử. Buổi phát tại cơ sở: Chuyên viên Marketing cơ sở – media vận hành máy quay theo lịch chung, giao qua Trưởng nhóm; nội dung, kênh do Tổng công ty giữ.","thoi_han":"Phát thử trước buổi phát 01 ngày làm việc","ghi_nhan":"Lịch sản xuất chung","can_cu":"mục 8; mục 15.3","de_xuat":true,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc"],"phoi_hop":["cc|bình luận hỏi dịch vụ, tin nhắn","cvtt|dư luận về thương hiệu của nhóm"],"noi_dung":"Phát trên kênh chính thức theo kịch bản đã duyệt; quyền phát theo phân quyền kênh. Trong buổi phát: bình luận hỏi dịch vụ chuyển Contact Center; thông tin vi phạm: Chuyên viên quảng cáo và kênh số của nhóm xử lý; dư luận: Chuyên viên truyền thông nhóm 1.","thoi_han":"Trong buổi phát","ghi_nhan":"Kênh chính thức","can_cu":"mục 11.3; mục 30","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt","qc"],"phoi_hop":["qlth|nhận báo dừng phát","cvtt|khi có dấu hiệu khủng hoảng"],"noi_dung":"Chuyên viên biên tập của nhóm theo dõi buổi phát, có quyền dừng phát hành khi nội dung sai chuyên môn, vi phạm pháp luật quảng cáo, lộ thông tin người bệnh (mục 14.8); Chuyên viên quảng cáo và kênh số dừng phát, ẩn bản ghi; đính chính theo QT.38; có dấu hiệu khủng hoảng: QT.6.","thoi_han":"Ngay khi phát hiện","ghi_nhan":"Sổ theo dõi sự cố","can_cu":"mục 14.8; QT.38; QT.6","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["md","dl-1"],"phoi_hop":["qc|đăng lại","mdcs|lưu tư liệu tại cơ sở"],"noi_dung":"Sau buổi phát: lưu bản ghi lên kho tư liệu; đoạn ngắn dùng lại qua cổng tiếp nhận yêu cầu (Chuyên viên media Tổng công ty dựng); số liệu lượt xem, bình luận, Lead theo nguồn khách vào báo cáo tháng.","thoi_han":"Lưu kho tư liệu trong ngày; số liệu trong báo cáo tháng","ghi_nhan":"kho tư liệu; báo cáo tháng","can_cu":"mục 12.5; QT.4","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu; Kho tư liệu (thư mục theo nhóm)"}],"kiem_soat":["Chỉ phát trên kênh chính thức, theo kịch bản đã duyệt","Không nêu thông tin người bệnh","Giá, ưu đãi chỉ nói khi thuộc Hạng mục đã duyệt và kế toán đã xác nhận","Phát trực tiếp không thuộc tin cơ sở được tự đăng (mục 16, số 5): Chuyên viên Marketing cơ sở – media chỉ vận hành máy quay, nội dung và kênh do Tổng công ty giữ (mục 8)"],"ngoai_le":[{"tinh_huong":"Bác sĩ phát trực tiếp trên mạng xã hội cá nhân","cach_lam":"Theo quy tắc ứng xử mạng xã hội của nhân viên; nội dung quảng cáo dịch vụ phải qua Phòng Marketing."},{"tinh_huong":"Đường truyền lỗi, mất kết nối trong buổi phát","cach_lam":"Chuyên viên quảng cáo và kênh số đăng thông báo trên kênh; phát lại hoặc đăng bản ghi khi Quản lý thương hiệu của nhóm nghiệm thu. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Phát trực tiếp cùng đối tác, trên kênh của đối tác","cach_lam":"Theo QT.43; nội dung, kênh thống nhất trong thỏa thuận hợp tác."},{"tinh_huong":"Phát trực tiếp hội nghị khoa học, sự kiện cấp hệ thống","cach_lam":"Theo QT.12; phần kỹ thuật như bước 3–6."},{"tinh_huong":"Cơ sở chưa có Chuyên viên Marketing cơ sở – media; Chuyên viên Marketing cơ sở – media vắng","cach_lam":"Trưởng nhóm đề nghị Chuyên viên media Tổng công ty theo lịch sản xuất chung; trùng lịch: QT.30."}],"nhom_vi_du":"N1"},{"id":"noi-dung-nguoi-benh","ten":"Nội dung có người bệnh: ca bệnh, câu chuyện, cảm nhận, hình ảnh trước – sau; người bệnh rút đồng ý","nhom_hoat_dong":["N2","N5","N9"],"vi_du":"Bệnh viện Răng hàm mặt và Phẫu thuật tạo hình thẩm mỹ Thái Thượng Hoàng muốn đăng câu chuyện và hình ảnh trước – sau của một khách hàng; 03 tháng sau, khách đề nghị gỡ hình ảnh.","buoc":[{"thuc_hien":["bt"],"phoi_hop":["qlth|nội dung trong Hạng mục","tn|liên hệ người bệnh qua khoa phòng","khoa-phong"],"noi_dung":"Xác định nội dung cần người bệnh (ca bệnh, câu chuyện, cảm nhận, hình ảnh trước – sau) trong Hạng mục hoặc yêu cầu đã duyệt; chỉ dùng khi người bệnh đồng ý bằng văn bản theo mẫu: phạm vi sử dụng, kênh, thời hạn; trẻ em: cha mẹ hoặc người giám hộ đồng ý.","thoi_han":"Khi lập kịch bản","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 9.4, mẫu 27; QT.21, bước 4","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tn","mdcs"],"phoi_hop":["dl-2|lưu trạng thái đồng ý"],"noi_dung":"Thu giấy đồng ý trước khi ghi hình, chụp ảnh; lưu bản chụp giấy đồng ý gắn với tư liệu trong kho tư liệu.","thoi_han":"Trước khi ghi hình","ghi_nhan":"Giấy đồng ý chụp ảnh, ghi hình (mục 9.4, mẫu 27); kho tư liệu","can_cu":"mục 9.4, mẫu 27","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["bt"],"phoi_hop":["bac-si|bác sĩ điều trị xác nhận chuyên môn","phap-che|rủi ro cao"],"noi_dung":"Viết nội dung: không nêu thông tin định danh, thông tin sức khỏe ngoài phạm vi đồng ý; bác sĩ điều trị xác nhận chuyên môn; kiểm pháp lý theo tầng. Rủi ro cao (hiệu quả điều trị, so sánh, hình ảnh trước – sau): thêm ý kiến bộ phận pháp chế.","thoi_han":"03 ngày làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 16, số 4; mục 16.1","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qc"],"phoi_hop":[],"noi_dung":"Đăng, quảng cáo trong phạm vi kênh, thời hạn ghi trên giấy đồng ý.","thoi_han":"Theo lịch đăng","ghi_nhan":"Lịch đăng","can_cu":"mục 16.1","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Trang tính lịch đăng"},{"thuc_hien":["dl-2"],"phoi_hop":["tn|số giấy đồng ý của cơ sở","qc|gỡ khi hết hạn"],"noi_dung":"Báo cáo sử dụng hình ảnh khách hàng hằng tháng (cơ sở cung cấp số giấy đồng ý); đối chiếu thời hạn đồng ý; đến hạn: báo Chuyên viên quảng cáo và kênh số của nhóm gỡ, dừng quảng cáo.","thoi_han":"Hằng tháng","ghi_nhan":"Báo cáo tháng","can_cu":"mục 7.4; mục 9.4, mẫu 27","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["qc","md-b","dl-2"],"phoi_hop":["qlsps|website, App TTH","phap-che|thời hạn theo pháp luật về bảo vệ dữ liệu cá nhân","xu-ly-phan-anh|trả lời người bệnh"],"noi_dung":"Người bệnh rút đồng ý, yêu cầu gỡ: Chuyên viên quảng cáo và kênh số của nhóm ẩn hoặc gỡ trên kênh, dừng quảng cáo có hình ảnh đó; website, App TTH: Quản lý sản phẩm số; Chuyên viên media nhóm 2 đánh dấu tư liệu trong kho tư liệu không dùng; Chuyên viên dữ liệu khách hàng và thị trường cập nhật trạng thái đồng ý.","thoi_han":"03 giờ từ khi nhận yêu cầu","ghi_nhan":"Sổ theo dõi sự cố; kho tư liệu; CRM","can_cu":"QT.38, bước 2; QT.25","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính); Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng; Kho tư liệu (thư mục theo nhóm)"}],"kiem_soat":["Không dùng hình ảnh, câu chuyện người bệnh khi chưa có giấy đồng ý còn thời hạn","Tin cơ sở tự đăng không có ca bệnh (mục 16, số 5)","Không xác nhận người viết đánh giá là người bệnh (mục 16, số 19)"],"ngoai_le":[{"tinh_huong":"Người bệnh tự đăng câu chuyện, cảm nhận trên trang cá nhân","cach_lam":"Không chia sẻ lại, không trích dẫn trên kênh chính thức khi chưa có giấy đồng ý. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Người bệnh là người nổi tiếng","cach_lam":"Không công bố việc khám, điều trị khi chưa có đồng ý bằng văn bản; báo chí hỏi: không cung cấp thông tin người bệnh (QT.34). (Đề xuất – chờ duyệt)"},{"tinh_huong":"Người bệnh, người nhà lọt vào khung hình khi ghi hình tại cơ sở","cach_lam":"Làm mờ khuôn mặt hoặc không dùng; Chuyên viên biên tập kiểm tra trước khi duyệt. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Lộ thông tin người bệnh trên bài đã đăng","cach_lam":"Theo QT.40, QT.38."}],"nhom_vi_du":"N2"},{"id":"he-thong-gian-doan","ten":"Phần mềm Quản trị Marketing, hệ thống phần mềm Marketing gián đoạn (kể cả kho tư liệu)","nhom_hoat_dong":["N11","N10"],"vi_du":"Phân hệ việc thường xuyên của phần mềm Quản trị Marketing không truy cập được trong 01 ngày; cùng tuần, kho tư liệu lỗi, không mở được thư mục tư liệu của Bệnh viện Đa khoa TTH Vinh.","buoc":[{"thuc_hien":["cvt","md|thư mục của nhóm","dl-2"],"phoi_hop":["qlsps|gửi Phòng Số hóa","cnnvy|kho tư liệu, CRM"],"noi_dung":"Người phát hiện báo chủ nghiệp vụ của hệ thống (phần mềm Quản trị Marketing: Chuyên viên trưởng; kho tư liệu: Chuyên viên trưởng (quyền), thư mục của nhóm: Chuyên viên media của nhóm; CRM: Chuyên viên dữ liệu khách hàng và thị trường); chủ nghiệp vụ báo đơn vị kỹ thuật theo mục 17.2 (Phòng Số hóa qua Quản lý sản phẩm số; kho tư liệu, CRM: Phòng Công nghệ – Nghiệp vụ Y).","thoi_han":"Ngay khi phát hiện","ghi_nhan":"Sổ theo dõi sự cố","can_cu":"mục 17.2; mục 11.3; mục 31, mảng 31","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvt","tt-nd","tt-ts"],"phoi_hop":[],"noi_dung":"Trong lúc gián đoạn: Tổ trưởng của tổ (Tổ Truyền thông và Thương hiệu: Chuyên viên trưởng) nhận yêu cầu qua bản ghi tạm dùng chung (người gửi, việc, hạn, người làm); thời hạn chuẩn tính từ giờ ghi tạm; Marketing cơ sở gửi yêu cầu qua kênh nội bộ của phòng. Khi hệ thống trở lại: người nhận nhập bản ghi tạm vào phần mềm trong 01 ngày làm việc.","thoi_han":"Trong thời gian gián đoạn","ghi_nhan":"Bản ghi tạm","can_cu":"mục 16, số 1; mục 14.7","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt"],"phoi_hop":["bac-si|xác nhận chuyên môn"],"noi_dung":"Giữ đủ kiểm tra pháp lý, xác nhận chuyên môn, duyệt phát hành; ghi người kiểm tra, người duyệt, thời điểm vào bản ghi tạm.","thoi_han":"Theo thời hạn chuẩn","ghi_nhan":"Bản ghi tạm","can_cu":"mục 16, số 4; mục 16.1","de_xuat":true,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt","tt-nd","tt-ts"],"phoi_hop":["dl-1|kiểm tra đủ"],"noi_dung":"Hệ thống hoạt động lại: nhập lại yêu cầu, Hoạt động, bằng chứng từ bản ghi tạm; tư liệu lưu tạm chuyển lên kho tư liệu theo thư mục.","thoi_han":"Ngày làm việc đầu tiên sau khi hệ thống hoạt động lại","ghi_nhan":"Phần mềm; kho tư liệu","can_cu":"mục 17.2","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["dl-1"],"phoi_hop":["cvt|duyệt"],"noi_dung":"Số liệu KPI của kỳ: đối chiếu bản ghi tạm; thời gian gián đoạn không tính trễ hạn cho người làm.","thoi_han":"Kỳ chốt số liệu","ghi_nhan":"Báo cáo tháng","can_cu":"mục 12.5","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["cvt"],"phoi_hop":["tp|gián đoạn kéo dài: làm việc với đơn vị kỹ thuật"],"noi_dung":"Ghi sự cố, thời gian gián đoạn, dữ liệu mất (nếu có); báo Trưởng phòng. Sau khôi phục, Chuyên viên trưởng kiểm soát việc nhập bù đầy đủ yêu cầu, lịch, kết quả và lịch sử phê duyệt, đối chiếu với sổ tạm.","thoi_han":"Sau khi hệ thống hoạt động lại","ghi_nhan":"Sổ theo dõi sự cố","can_cu":"mục 17.2","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"}],"kiem_soat":["Không bỏ kiểm tra pháp lý, xác nhận chuyên môn, duyệt phát hành vì hệ thống gián đoạn","Mọi việc trong thời gian gián đoạn có bản ghi tạm và được nhập lại (Đề xuất – chờ duyệt)"],"ngoai_le":[{"tinh_huong":"Sự cố, khủng hoảng trong lúc hệ thống gián đoạn","cach_lam":"Theo QT.6; báo theo lịch trực sự cố."},{"tinh_huong":"Website, App TTH lỗi","cach_lam":"Theo QT.14."},{"tinh_huong":"CRM, hộp thư dùng chung, tổng đài gián đoạn","cach_lam":"Contact Center nhận qua kênh còn hoạt động; Phòng Công nghệ – Nghiệp vụ Y xử lý kỹ thuật (mục 17.2). (Đề xuất – chờ duyệt)"},{"tinh_huong":"Mất tư liệu trong kho tư liệu","cach_lam":"Chuyên viên media của nhóm có thư mục báo Chuyên viên trưởng, Phòng Công nghệ – Nghiệp vụ Y khôi phục từ bản sao lưu; không khôi phục được: lập danh mục tư liệu mất, quay chụp lại phần cần cho Hạng mục đang triển khai. (Đề xuất – chờ duyệt)"}],"nhom_vi_du":"chung"},{"id":"nghien-cuu-thi-truong","ten":"Nghiên cứu thị trường, khảo sát nhận biết thương hiệu","nhom_hoat_dong":["N1","N10"],"vi_du":"Trước khi lập kế hoạch năm 2027, Phòng Marketing khảo sát mức độ nhận biết thương hiệu Nguyên Phúc tại Nghệ An và Hà Tĩnh.","buoc":[{"thuc_hien":["qlth"],"phoi_hop":["tp|nhu cầu cấp hệ thống"],"noi_dung":"Nêu nhu cầu nghiên cứu: câu hỏi cần trả lời, dùng cho kế hoạch năm hoặc Hạng mục nào.","thoi_han":"Theo kế hoạch năm (QT.15) hoặc khi lập Hạng mục","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"QT.15; QT.1","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["dl-2"],"phoi_hop":["cvt|duyệt phương án"],"noi_dung":"Lập phương án khảo sát: đối tượng, cỡ mẫu, cách thu (kênh số, Contact Center, tại cơ sở), bảng hỏi, chi phí; Chuyên viên trưởng duyệt.","thoi_han":"Trước khi thu thập","ghi_nhan":"Phương án khảo sát","can_cu":"mục 31, mảng 2; mục 14.16","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tn","qhcs"],"phoi_hop":["dl-2"],"noi_dung":"Thu thập tại cơ sở theo phương án; ghi thông tin thị trường trên phần mềm.","thoi_han":"Theo phương án","ghi_nhan":"Phần mềm","can_cu":"QT.21, bước 7","de_xuat":true,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-2"],"phoi_hop":["dl-1|số liệu KPI-08"],"noi_dung":"Xử lý, báo cáo kết quả; không lưu dữ liệu định danh ngoài phạm vi người trả lời đồng ý.","thoi_han":"Theo phương án","ghi_nhan":"Báo cáo nghiên cứu","can_cu":"mục 12.5; mục 31, mảng 2","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["qlth","tp"],"phoi_hop":["btgd|kết quả cấp hệ thống"],"noi_dung":"Dùng kết quả cho kế hoạch năm, Hạng mục, thông điệp; Trưởng phòng báo Ban Tổng Giám đốc khi là nghiên cứu cấp hệ thống.","thoi_han":"Sau khi có báo cáo","ghi_nhan":"Kế hoạch năm; kế hoạch Hạng mục","can_cu":"QT.15; mục 4.2","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"}],"kiem_soat":["Phương án khảo sát có Chuyên viên trưởng duyệt trước khi thu thập (mục 14.16)","Không thu dữ liệu sức khỏe trong khảo sát thị trường (Đề xuất – chờ duyệt)"],"ngoai_le":[{"tinh_huong":"Thuê đơn vị nghiên cứu bên ngoài","cach_lam":"Chỉ phần Phòng Marketing không tự làm được; mua theo QT.32 (mục 2)."},{"tinh_huong":"Khảo sát hài lòng người bệnh","cach_lam":"Theo QT.52."}],"nhom_vi_du":"N1"},{"id":"kham-suc-khoe-doanh-nghiep","ten":"Khám sức khỏe doanh nghiệp, gói dịch vụ cho tổ chức: phần Marketi