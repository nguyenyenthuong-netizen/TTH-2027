.","co_che_quan_tri":{"nguoi_lap":["dl-1"],"nguoi_nam_giu":"dl-1","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"M-1","loai":"Mẫu","ten":"Kịch bản tư vấn Contact Center (gốc và nhánh theo cơ sở)","noi_dung":"Kịch bản gốc toàn hệ thống, nhánh dịch vụ/gói, cơ sở áp dụng, câu hỏi thường gặp, giá và điều kiện đã xác nhận, giới hạn tư vấn, điểm chuyển tuyến, mã phiên bản và hiệu lực.","xay_dung":"Contact Center; cơ sở đề xuất thông tin/tình huống, không tự ban hành","nam_giu":"Contact Center (kho tri thức dùng chung)","cap_nhat":"Contact Center sau khi cơ sở/chuyên môn xác nhận dữ liệu thay đổi","duyet":"Người được phân quyền của đơn vị chủ quản Contact Center duyệt nghiệp vụ; bác sĩ/chuyên môn và đầu mối gói/giá xác nhận theo nội dung","dung":["cc"],"noi_luu_co_pm":"Phần mềm; CRM khi có","noi_luu_chua_pm":"Thư mục kịch bản trên kho tư liệu","chu_ky_ra_soat":"Khi thay đổi dịch vụ/gói/giá/lịch; rà soát định kỳ theo quy định của Contact Center","pham_vi":"theo_nhom","can_cu":"mục 17; mảng 17","so_cu":12,"