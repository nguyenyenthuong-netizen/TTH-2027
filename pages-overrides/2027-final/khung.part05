nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["cvt"],"nguoi_nam_giu":"cvt","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung.","Chỉ chuyển quyền kênh sở hữu doanh nghiệp và giữ lịch sử xác minh thu hồi quyền cũ."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"BM-25","loai":"Biểu mẫu","ten":"Giấy đồng ý chụp ảnh, ghi hình","noi_dung":"Mục đích, kênh, thời hạn, rút đồng ý; bộ phận pháp chế xem mẫu","xay_dung":["dl-2"],"nam_giu":"dl-2","cap_nhat":["dl-2"],"duyet":["phap-che"],"dung":["mdcs","md","bt"],"noi_luu_co_pm":"Hồ sơ hình ảnh; kho tư liệu","noi_luu_chua_pm":"Bản giấy lưu tại cơ sở, bản chụp lên kho tư liệu","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"QT.21, QT.48; mục 17.1","so_cu":27,"truong":[{"ma_truong":"ma_mau_dong_y","ten":"Mã phiên bản biểu mẫu pháp chế đã duyệ