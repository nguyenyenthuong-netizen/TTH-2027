ệm thu độc lập","loai_du_lieu":"user","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ket_luan","ten":"Đạt, cần sửa, không đạt","loai_du_lieu":"enum","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"han_sua","ten":"Hạn sửa","loai_du_lieu":"date","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["cvt"],"nguoi_nam_giu":"cvt","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung.","Bắt buộc người nghiệm thu khác người thực hiện và có tiêu chí nghiệm thu đối chiếu."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"BM-16","loai":"Biểu mẫu","ten":"Biên bản bàn giao; biên bản rà soát định biên; biên bản đào tạo","noi_dung":"Bàn giao theo hồ sơ vị trí, gồm chuyển quyền kênh; giờ theo vị trí, theo nhóm","xay_dung":["cvt"],"nam_giu":"cvt","cap_nhat":["cvt"],"duyet":["tp"],"dung":["cvt","tp","nhan-luc"],"noi_luu_co_pm":"Phần mềm","noi_luu_chua_pm":"Biên bản theo mẫu","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"QT.9, QT.17, QT.18","so_cu":34,"truong":[{"ma_truong":"loai_bien_ban","ten":"Bàn giao, rà định biên, đào tạo","loai_du_lieu":"enum","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ma_ho_so_vi_tri","ten":"Hồ sơ vị trí","loai_du_lieu":"relation","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"nguoi_ban_giao","ten":"Người bàn giao","loai_du_lieu":"user","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"nguoi_nhan","ten":"Người nhận","loai_du_lieu":"user","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"tai_san_quyen_kenh","ten":"Tài sản và quyền kênh","loai_du_lieu":"rows","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","ng