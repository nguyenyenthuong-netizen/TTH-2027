01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Đánh giá cấp 1 đúng kỳ","cong_thuc":"Đạt (100 điểm): hồ sơ đánh giá cấp 1 của mọi thành viên Marketing tại cơ sở nộp đúng kỳ; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Tin sau sự kiện trong 04 giờ","cong_thuc":"Số tin đăng trong 04 giờ sau khi sự kiện kết thúc ÷ tổng số sự kiện cần tin trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Nhu cầu tháng đúng hạn","cong_thuc":"Đạt (100 điểm): nhu cầu tháng nhập phần mềm trong ngày 10–15 của cả 03 tháng trong quý; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Xác nhận chuyên môn đúng hạn","cong_thuc":"Số yêu cầu xác nhận chuyên môn (bác sĩ, khoa phòng) hoàn tất đúng hạn ÷ tổng số yêu cầu xác nhận trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Không bỏ sót lịch ghi hình","cong_thuc":"Đạt (100 điểm): mọi lịch ghi hình tại cơ sở trong quý có người thực hiện; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Góp ý của Ban Giám đốc cơ sở theo phiếu góp ý quý (thang 100 điểm)","cong_thuc":"Điểm phiếu góp ý quý của Ban Giám đốc cơ sở, thang 100","don_vi_tinh":"Điểm","ky_cham":"Quý","de_xuat":true}],"tinh_huong_thuong_gap":[{"tinh_huong":"Bệnh viện cần chương trình dịch vụ trọng điểm của 01 cơ sở (gói khám, gói điều trị, khai trương dịch vụ)","quy_trinh":"QT.1"},{"tinh_huong":"Chương trình chung nhiều cơ sở, dùng ngân sách Tổng công ty","quy_trinh":"QT.10, QT.15"},{"tinh_huong":"Chương trình trọng điểm từ 02 cơ sở, theo hệ thống bệnh viện, phòng khám: gói khám, gói điều trị, hội thảo, lớp học","quy_trinh":"QT.26, QT.10"},{"tinh_huong":"Cơ sở cần một sản phẩm lẻ (ảnh, bài, video, ấn phẩm) ngoài Hạng mục","quy_trinh":"QT.2"},{"tinh_huong":"Tin hoạt động trong ngày tại cơ sở","quy_trinh":"QT.3"},{"tinh_huong":"Kế hoạch nội dung, lịch đăng hằng tháng trên kênh; ai chịu trách nhiệm nội dung kênh","quy_trinh":"QT.56"},{"tinh_huong":"Sự kiện tại cơ sở ngoài Hạng mục (khám cộng đồng, học đường, tư vấn sức khỏe)","quy_trinh":"QT.21; tin trong ngày: QT.3"},{"tinh_huong":"Hội nghị khoa học, sự kiện cấp hệ thống","quy_trinh":"QT.12"},{"tinh_huong":"Khách để lại thông tin, nhắn tin, gọi tổng đài, hotline di động, gửi email, form","quy_trinh":"QT.4"},{"tinh_huong":"Chăm sóc khách cũ: gửi tin hàng loạt, tin chăm sóc tự động","quy_trinh":"QT.5"},{"tinh_huong":"Đánh giá tiêu cực, phản ánh, khủng hoảng truyền thông, thông tin vi phạm trên kênh","quy_trinh":"QT.6"},{"tinh_huong":"Người phụ trách, Tổ trưởng vắng mặt; ngoại lệ chéo nhóm khi vắng, chờ tuyển","quy_trinh":"QT.7"},{"tinh_huong":"Lãnh đạo, khoa phòng nhắn thẳng nhân viên; loại việc chưa có trong bảng phân công","quy_trinh":"QT.8"},{"tinh_huong":"Cơ sở mới hoạt động, khai trương","quy_trinh":"QT.9"},{"tinh_huong":"Bộ nhận diện; thay biển theo nhận diện mới","quy_trinh":"QT.11"},{"tinh_huong":"Biển bảng hỏng, xuống cấp","quy_trinh":"QT.13"},{"tinh_huong":"Trang trí lễ, Tết; poster, tranh ảnh, trang trí cố định tại khoa phòng; vật phẩm thương hiệu","quy_trinh":"QT.24; mục 15.2"},{"tinh_huong":"Phân việc thiết kế: ai làm sản phẩm nào, bản in hay bản số","quy_trinh":"Mục 15.2: quy tắc hai bước, quy tắc chặn C1–C13"},{"tinh_huong":"Poster dịch vụ, bảng danh mục dịch vụ của khoa treo lâu dài","quy_trinh":"QT.2; mục 15.2 (nguyên tắc thông điệp dịch vụ)"},{"tinh_huong":"Website, App TTH: cập nhật nội dung, lỗi; kế hoạch SEO","quy_trinh":"QT.14; mục 11.1, số 23"},{"tinh_huong":"Kế hoạch, ngân sách năm; chi ngoài kế hoạch; chốt kỳ; KPI quý","quy_trinh":"QT.15"},{"tinh_huong":"Cơ sở y tế tuyến dưới, bác sĩ, phòng khám bên ngoài giới thiệu người bệnh; tài trợ tại địa phương","quy_trinh":"QT.16"},{"tinh_huong":"Mạo danh, tin giả về bệnh viện, bác sĩ, thương hiệu trên mạng","quy_trinh":"QT.27"},{"tinh_huong":"Rà soát định kỳ nội dung y khoa; thông tin công khai trên website, App TTH (giá, người hành nghề, kỹ thuật được phép)","quy_trinh":"QT.28"},{"tinh_huong":"Bảo hiểm y tế, bảo hiểm sức khỏe, bảo lãnh viện phí","quy_trinh":"QT.1 (ngoại lệ bảo hiểm); mục 31, mảng 45"},{"tinh_huong":"KOL, KOC trong Hạng mục","quy_trinh":"QT.20"},{"tinh_huong":"Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện gửi nhu cầu truyền thông","quy_trinh":"QT.19"},{"tinh_huong":"Truyền thông tuyển dụng","quy_trinh":"QT.22"},{"tinh_huong":"Chuyển quyền kênh, tài khoản quảng cáo, kho tư liệu của bệnh viện về Tổng công ty (Giai đoạn 2)","quy_trinh":"QT.23"},{"tinh_huong":"Nhân viên nghỉ việc, chuyển công tác","quy_trinh":"QT.17"},{"tinh_huong":"Thay đổi pháp luật, chính sách nền tảng; thủ tục với cơ quan nhà nước; dùng trí tuệ nhân tạo","quy_trinh":"QT.18"},{"tinh_huong":"Việc định kỳ (ngày, tuần, tháng, quý, năm)","quy_trinh":"mục 30"},{"tinh_huong":"Phát thanh nội viện, màn hình nội viện: nhu cầu, kế hoạch phát, kịch bản, thu âm, phát, kiểm tra thiết bị","quy_trinh":"QT.29"},{"tinh_huong":"Hai cơ sở, hai nhóm thương hiệu cùng cần một người, một ngày ghi hình","quy_trinh":"QT.30"},{"tinh_huong":"Yêu cầu gấp hơn thời hạn chuẩn","quy_trinh":"QT.31"},{"tinh_huong":"Mua dịch vụ in ấn, thi công, quảng cáo ngoài trời: nhà cung cấp, hợp đồng, nghiệm thu, thanh toán","quy_trinh":"QT.32"},{"tinh_huong":"Truyền hình, truyền thanh, báo chí, trang cộng đồng trên mạng xã hội theo hợp đồng năm","quy_trinh":"QT.33"},{"tinh_huong":"Báo chí đề nghị phỏng vấn, đưa tin; bác sĩ tham gia truyền thông","quy_trinh":"QT.34"},{"tinh_huong":"Sự kiện nội bộ; phòng ban Tổng công ty cần truyền thông (sơ kết, tổng kết, nội bộ)","quy_trinh":"QT.35"},{"tinh_huong":"Cơ sở cần người Marketing cơ sở của cơ sở khác hỗ trợ","quy_trinh":"QT.36"},{"tinh_huong":"Giới thiệu dịch vụ của cơ sở này tại cơ sở khác trong hệ thống","quy_trinh":"QT.37"},{"tinh_huong":"Bài, ấn phẩm đã phát hành có sai sót (giá, chuyên môn, thông tin người bệnh)","quy_trinh":"QT.38"},{"tinh_huong":"Tài khoản kênh, tài khoản quảng cáo bị khóa, mất quyền, bị chiếm","quy_trinh":"QT.39"},{"tinh_huong":"Lộ, mất dữ liệu cá nhân khách hàng","quy_trinh":"QT.40"},{"tinh_huong":"Ban Tổng Giám đốc giao việc, chỉ đạo; báo cáo, xin ý kiến","quy_trinh":"QT.41"},{"tinh_huong":"Ban Giám đốc cơ sở đề nghị, phản ánh, bất đồng với Marketing; góp ý quý; Trưởng nhóm Marketing cơ sở và Quản lý thương hiệu chưa thống nhất","quy_trinh":"QT.42"},{"tinh_huong":"Đối tác đề nghị hợp tác: ký kết, đồng thương hiệu, sự kiện chung","quy_trinh":"QT.43"},{"tinh_huong":"Cơ sở đổi tên, đổi thương hiệu, chuyển nhóm thương hiệu","quy_trinh":"QT.44"},{"tinh_huong":"Cơ quan nhà nước thanh tra, kiểm tra, yêu cầu giải trình, xử phạt về quảng cáo, thông tin trên kênh","quy_trinh":"QT.45"},{"tinh_huong":"Cơ sở tạm ngừng dịch vụ, đổi giờ làm việc","quy_trinh":"QT.46"},{"tinh_huong":"Phát trực tiếp trên kênh chính thức (tư vấn sức khỏe, sự kiện, hội thảo)","quy_trinh":"QT.47"},{"tinh_huong":"Ca bệnh, câu chuyện, cảm nhận, hình ảnh trước – sau của người bệnh; người bệnh rút đồng ý, yêu cầu gỡ ảnh","quy_trinh":"QT.48"},{"tinh_huong":"Phần mềm Quản trị Marketing, kho tư liệu, CRM gián đoạn; mất tư liệu","quy_trinh":"QT.49"},{"tinh_huong":"Nghiên cứu thị trường, khảo sát nhận biết thương hiệu","quy_trinh":"QT.50"},{"tinh_huong":"Khám sức khỏe doanh nghiệp, gói dịch vụ cho tổ chức","quy_trinh":"QT.51; đơn vị bán, ký hợp đồng chờ quyết định (mục 28, số 24)"},{"tinh_huong":"Khảo sát hài lòng, trải nghiệm người bệnh (NPS, CSAT)","quy_trinh":"QT.52; chịu trách nhiệm kết quả chờ quyết định (mục 28, số 30)"},{"tinh_huong":"Người bệnh nước ngoài","quy_trinh":"QT.53; chờ xác nhận nhu cầu (mục 28, số 48)"},{"tinh_huong":"Dịch bệnh, thiên tai; cơ quan y tế đề nghị đăng hướng dẫn phòng bệnh","quy_trinh":"QT.54"},{"tinh_huong":"Quảng cáo, giới thiệu thuốc, thực phẩm bảo vệ sức khỏe, mỹ phẩm, trang thiết bị y tế","quy_trinh":"QT.55"},{"tinh_huong":"Sự kiện, hội nghị hoãn, hủy","quy_trinh":"QT.21, QT.12 (ng