ng theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ngay_dong_y","ten":"Thời điểm người đó đồng ý","loai_du_lieu":"datetime","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"rut_dong_y","ten":"Yêu cầu rút đồng ý","loai_du_lieu":"boolean","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ngay_ngung_su_dung","ten":"Ngày ngừng sử dụng","loai_du_lieu":"datetime","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"bang_chung","ten":"Bằng chứng lưu theo chính sách bảo mật","loai_du_lieu":"files","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["dl-2"],"nguoi_nam_giu":"dl-2","danh_sach_nguoi_duyet":["phap-che"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung.","Trạng thái đồng ý mặc định là chưa đồng ý; không được ghi hình/sử dụng ngoài phạm vi hợp pháp khi thiếu đồng ý; rút đồng ý kích hoạt quy trình rà soát dừng sử dụng theo chính sách pháp chế.","Tuyệt đối không đưa họ tên/người bệnh thật vào bản khung mẫu hoặc dữ liệu demo."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"BM-26","loai":"Biểu mẫu","ten":"Bản cộng nhu cầu mua của 02 nhóm","noi_dung":"Nhà cung cấp, loại hàng, dịch vụ, giá trị từng nhóm, tổng; tổng từ 20 triệu đồng trở lên: một hợp đồng, mỗi nhóm một phụ lục","xay_dung":["dl-1"],"nam_giu":"dl-1","cap_nhat":["dl-1"],"duyet":["tp"],"dung":["mua-sam","qlth","ptgd-tc"],"noi_luu_co_pm":"Phần mềm, ngày 20–22","noi_luu_chua_pm":"Bảng tính sổ hợp đồng","chu_ky_ra_soat":"Năm","pham_vi":"chung","can_cu":"Quy chế chi tiêu nội bộ (189/QĐ-TTH) Điều 32.1; QT.32, QT.33","so_cu":null,"truong":[{"ma_truong":"ky_cong_nhu_cau","ten":"Kỳ cộng nhu cầu","loai_du_lieu":"daterange","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"nhu_cau_nhom_1","ten":"Nhu cầu và giá trị nhóm 1","loai_du_lieu":"rows","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"