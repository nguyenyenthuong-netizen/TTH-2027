tiêu nội bộ (Quyết định 189/QĐ-TTH), Điều 32.1","phu_trach":"Chuyên viên đo lường và đối soát; đơn vị chủ trì mua sắm làm một hợp đồng khi tổng từ 20 triệu đồng trở lên"},{"tan_suat":"Hằng tháng","viec":"Ngày 20–25: lịch đăng tháng sau của từng kênh","can_cu":"QT.56","phu_trach":"Chuyên viên quảng cáo và kênh số của nhóm lập; Quản lý thương hiệu của nhóm nghiệm thu"},{"tan_suat":"Quy tắc lịch","viec":"Mốc rơi vào ngày nghỉ (12 ngày lễ, Tết: Bộ luật Lao động 2019, Điều 112; Nghị quyết 28/2026/QH16) làm vào ngày làm việc liền trước","can_cu":"mục 16","phu_trach":"Mọi vị trí; phần mềm tự dời mốc"},{"tan_suat":"Hằng quý","viec":"Báo cáo giờ làm chéo nhóm theo người, vị trí, trường hợp; vị trí quá 24 giờ trong quý: xem nguyên nhân","can_cu":"mục 15.4","phu_trach":"Chuyên viên trưởng; Thư ký Ban Tổng Giám đốc mảng Marketing xem được"},{"tan_suat":"Theo sự việc","viec":"Cho phép làm thay chéo nhóm có thời hạn: lập trong 04 giờ làm việc; thu hồi quyền tạm đúng ngày hết hạn","can_cu":"mục 15.4","phu_trach":"Người trung lập cho phép làm thay có thời hạn (RC-1); Chuyên viên trưởng cấp, thu hồi quyền tạm"},{"tan_suat":"Theo sự việc","viec":"Bác sĩ nghỉ việc: cơ sở báo trong 01 ngày làm việc; dừng quảng cáo, ẩn bài, gỡ hồ sơ trong 01 ngày làm việc","can_cu":"QT.28","phu_trach":"Ban Giám đốc cơ sở báo; Chuyên viên quảng cáo và kênh số của nhóm; Quản lý sản phẩm số"},{"tan_suat":"Hằng tuần / hằng tháng","viec":"Kiểm tra biển bảng tại cơ sở (hằng tuần), tổng hợp ảnh/số đo hiện trạng và báo cáo (hằng tháng); biển hỏng báo trong ngày","can_cu":"QyĐ.48; quy trình biển-bảng-hỏng; ma trận TCT–chi nhánh 07,24","phu_trach":"Chuyên viên Truyền thông cơ sở (03 người); bệnh viện 02 người Trưởng nhóm Marketing cơ sở kiêm; Chuyên viên truyền thông TCT nhận và kiểm; Media cơ sở không chủ trì."}],"kpi_van_hanh":[{"ten":"Rà soát định biên, bảng phân công đúng kỳ","cong_thuc":"Đạt (100 điểm): biên bản rà soát định biên, bảng phân công lập trong 10 ngày làm việc đầu quý sau (mục 30); không đạt (0 điểm): quá hạn","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ đúng hạn của Tổ Nội dung và Sáng tạo, Marketing cơ sở","cong_thuc":"Số yêu cầu của Tổ Nội dung và Sáng tạo và Marketing cơ sở hoàn tất đúng hạn ÷ tổng số yêu cầu của Tổ Nội dung và Sáng tạo và Marketing cơ sở đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ người đạt bậc 3 (mục 24.3)","cong_thuc":"Số người trong phạm vi quản lý đạt bậc 3 trở lên ÷ tổng số người trong phạm vi quản lý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Cơ sở mới ra mắt đúng lịch","cong_thuc":"Đạt (100 điểm): mọi cơ sở mới trong quý ra mắt đúng lịch ra mắt đã duyệt (mục 22.2); không có cơ sở mới: không chấm, tỷ trọng chia cho chỉ tiêu còn lại","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ yêu cầu cần Tổ trưởng xử lý được xử lý trong 04 giờ làm việc","cong_thuc":"Số yêu cầu cần Tổ trưởng xử lý được xử lý trong 04 giờ làm việc kể từ khi nhận ÷ tổng số yêu cầu cần Tổ trưởng xử lý của tổ trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ đúng hạn của tổ","cong_thuc":"Số yêu cầu của tổ hoàn tất đúng hạn ÷ tổng số yêu cầu của tổ đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Sản phẩm phát hành đủ bước kiểm tra","cong_thuc":"Đạt (100 điểm): mọi sản phẩm của tổ phát hành trong quý có đủ bước kiểm tra trên sổ theo dõi (pháp lý, nhận diện, duyệt); không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Sổ theo dõi cập nhật hằng ngày","cong_thuc":"Đạt (100 điểm): sổ theo dõi yêu cầu của tổ được cập nhật trong mọi ngày làm việc của quý; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Kế hoạch, ngân sách, đối soát đúng hạn","cong_thuc":"Số kế hoạch, tờ trình ngân sách, bản đối soát của Hạng mục phụ trách nộp đúng hạn ÷ tổng số phải nộp trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Xử lý khủng hoảng đúng thời hạn","cong_thuc":"Đạt (100 điểm): mọi sự cố truyền thông trong quý được báo, xử lý, báo cáo đúng thời hạn (mục 30); không có sự cố: đạt; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Lịch phát màn hình, phát thanh đúng kế hoạch","cong_thuc":"Số lượt phát màn hình, phát thanh đúng kế hoạch ÷ tổng số lượt theo kế hoạch trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ yêu cầu hoàn tất đúng hạn","cong_thuc":"Số yêu cầu do vị trí thực hiện hoàn tất đúng hạn ÷ tổng số yêu cầu do vị trí thực hiện đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Số vòng chỉnh sửa bình quân","cong_thuc":"Tổng số vòng chỉnh sửa của các sản phẩm hoàn tất ÷ số sản phẩm hoàn tất trong quý","don_vi_tinh":"Vòng","ky_cham":"Quý","de_xuat":true},{"ten":"Không vi phạm pháp luật quảng cáo y tế","cong_thuc":"Đạt (100 điểm): không có sản phẩm do vị trí làm hoặc kiểm tra bị cơ quan nhà nước, bộ phận pháp chế xác định vi phạm trong quý; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Nội dung xây mới website tthhealthcare.com, App TTH bàn giao đúng lịch được duyệt","cong_thuc":"Số phần nội dung xây mới bàn giao đúng lịch dự án ÷ tổng số phần đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Nội dung xây mới website các chuỗi bàn giao đúng lịch được duyệt","cong_thuc":"Số phần nội dung xây mới bàn giao đúng lịch dự án ÷ tổng số phần đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ yêu cầu hoàn tất đúng hạn theo cấp độ","cong_thuc":"Số yêu cầu thiết kế hoàn tất trong thời hạn chuẩn của cấp độ ÷ tổng số yêu cầu đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ sản phẩm đạt trong 02 vòng chỉnh sửa","cong_thuc":"Số sản phẩm được duyệt trong tối đa 02 vòng chỉnh sửa ÷ tổng số sản phẩm hoàn tất trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Áp dụng bộ nhận diện chung của TTH tại cơ sở nhóm 1 đúng lịch được duyệt","cong_thuc":"Số phần việc áp dụng bộ nhận diện hoàn tất đúng lịch dự án ÷ tổng số phần việc đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ sản phẩm làm từ mẫu","cong_thuc":"Số sản phẩm thiết kế làm từ thư viện mẫu thiết kế sẵn ÷ tổng số sản phẩm thiết kế thuộc loại đã có mẫu trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Bộ nhận diện nhóm 2 bàn giao đúng lịch được duyệt","cong_thuc":"Số phần của bộ nhận diện bàn giao đúng lịch dự án ÷ tổng số phần đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Bộ nhận diện chung của TTH bàn giao đúng lịch được duyệt","cong_thuc":"Số phần của bộ nhận diện bàn giao đúng lịch dự án ÷ tổng số phần đến hạn trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ file in đạt quy chuẩn ngay lần đầu","cong_thuc":"Số file in đạt kiểm tra kỹ thuật ngay lần đầu ÷ tổng số file in được kiểm tra trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Không bỏ sót lịch đã duyệt","cong_thuc":"Đạt (100 điểm): mọi lịch ghi hình, chụp ảnh đã duyệt trong quý có người thực hiện; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Tỷ lệ tư liệu lên kho tư liệu trong ngày","cong_thuc":"Số đợt ghi hình, chụp ảnh có tư liệu lên kho tư liệu trong ngày ÷ tổng số đợt trong quý × 100","don_vi_tinh":"%","ky_cham":"Quý","de_xuat":true},{"ten":"Sự cố kênh xử lý đúng hạn","cong_thuc":"Đạt (100 điểm): mọi sự cố kênh trong quý được báo trong 30 phút, báo cáo trong 48 giờ, gỡ vi phạm trong 03 giờ (mục 30); không có sự cố: đạt; không đạt (0 điểm): có từ 01 trường hợp","don_vi_tinh":"Đạt/không đạt","ky_cham":"Quý","de_xuat":true},{"ten":"Không vi