ap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ngay_ky","ten":"Ngày ký","loai_du_lieu":"date","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"han_nghiem_thu","ten":"Hạn nghiệm thu","loai_du_lieu":"date","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"ket_qua_nghiem_thu","ten":"Biên bản nghiệm thu","loai_du_lieu":"relation","bat_buoc":false,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"han_thanh_toan","ten":"Hạn thanh toán","loai_du_lieu":"date","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"trang_thai_thanh_toan","ten":"Trạng thái thanh toán","loai_du_lieu":"enum","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"}],"ban_theo_nhom":false,"tinh_trang_dac_ta":"ĐÃ LẬP BẢN ĐẶC TẢ KỸ THUẬT ĐỀ XUẤT – CHƯA ĐƯỢC NGƯỜI NẮM GIỮ VÀ NGƯỜI DUYỆT XÁC NHẬN; KHÔNG COI LÀ BIỂU MẪU BAN HÀNH.","co_che_quan_tri":{"nguoi_lap":["qlth"],"nguoi_nam_giu":"dl-1","danh_sach_nguoi_duyet":["tp"],"quy_tac_duyet":"Theo tuyến thẩm quyền và phân nhóm; không tự duyệt; người nắm giữ không đương nhiên là người duyệt; dữ liệu chỉ có giá trị phê duyệt khi có bản ghi duyệt hợp lệ","lich_su_bat_buoc":true,"che_do_chua_co_phan_mem":"Lưu bản kiểm soát trong sổ/bảng tính, khóa bản đã duyệt; nhập bù có đối soát khi dùng phần mềm."},"quy_tac_du_lieu":["Bắt buộc có mã, phiên bản, người tạo, ngày tạo, trạng thái duyệt, lịch sử sửa; không xóa vật chứng sau khi duyệt.","Mã đơn vị/nhóm/kênh/nhân sự phải chọn từ danh mục được quyền xem; không nhận chuỗi tự do khi đã có danh mục.","Không cho người lập tự phê duyệt; không tự chuyển quyền theo quá hạn.","Bản đã duyệt chỉ sửa bằng phiên bản mới, có lý do và người duyệt lại nếu thay đổi ảnh hưởng.","Quyền xem dữ liệu cá nhân giới hạn cho vai trò được phân quyền; không đưa dữ liệu người bệnh vào bản trình khung."],"truong_nguon":"Đề xuất từ mục đích biểu mẫu/sổ trong khung 14/11; phải xác nhận từng trường, quyền, giá trị trước nghiệm thu phần mềm."},{"ma":"SO-3","loai":"Sổ","ten":"Sổ theo dõi sự cố; lịch trực sự cố","noi_dung":"Sự cố kênh, truyền thông; người trực tầng 1 chung đến khi Contact Center nhận ngoài giờ","xay_dung":["cvt"],"nam_giu":"cvt","cap_nhat":["cvt","cvtt","qc"],"duyet":["tp"],"dung":["Mọi vị trí theo quyền","cc"],"noi_luu_co_pm":"Phần mềm","noi_luu_chua_pm":"Bảng tính sổ sự cố","chu_ky_ra_soat":"Quý","pham_vi":"chung","can_cu":"QT.6, QT.27, QT.39; mục 30","so_cu":32,"truong":[{"ma_truong":"ma_su_co","ten":"Mã sự cố","loai_du_lieu":"text","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"kenh_he_thong","ten":"Kênh hoặc hệ thống","loai_du_lieu":"relation","bat_buoc":true,"nguon":"Danh mục/đầu vào đã xác nhận theo quy trình và hồ sơ của biểu mẫu","nguoi_nhap":"Người lập hoặc hệ thống theo phân quyền","nguoi_xem":"Người lập, người quản lý theo tuyến, người duyệt có quyền"},{"ma_truong":"thoi_diem_bat_dau","ten":"Thời điểm phát hiện","loai_du_lieu":"datetime","bat_buoc":tr