"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt"],"phoi_hop":["phap-che|nộp hồ sơ"],"noi_dung":"Lập nội dung, hồ sơ nội dung quảng cáo; bộ phận pháp chế nộp; chỉ phát hành đúng bản đã được chấp thuận khi pháp luật yêu cầu.","thoi_han":"Theo thời hạn của cơ quan nhà nước","ghi_nhan":"Hồ sơ nội dung quảng cáo","can_cu":"mục 31, mảng 38; QT.18, bước 6","de_xuat":true,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tk","md"],"phoi_hop":["bt|kiểm tra đúng bản đã chấp thuận"],"noi_dung":"Sản xuất theo bản đã chấp thuận; dùng hình ảnh bác sĩ, nhân viên y tế, người bệnh chỉ khi danh sách kiểm tra pháp lý cho phép.","thoi_han":"Theo thời hạn chuẩn","ghi_nhan":"kho tư liệu","can_cu":"mục 16, số 4","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["qc"],"phoi_hop":["qlth|nghiệm thu lịch đăng"],"noi_dung":"Đăng, quảng cáo trên kênh của đơn vị sở hữu hoặc kênh đã thống nhất; theo chính sách nền tảng với loại sản phẩm đó.","thoi_han":"Theo lịch đăng","ghi_nhan":"Lịch đăng","can_cu":"QT.18, bước 3","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Trang tính lịch đăng"},{"thuc_hien":["bt"],"phoi_hop":["qc|dừng, gỡ"],"noi_dung":"Chuyên viên biên tập của nhóm có sản phẩm lưu hồ sơ; theo dõi hiệu lực giấy tờ; hết hiệu lực: dừng quảng cáo, gỡ theo QT.38.","thoi_han":"Hằng quý","ghi_nhan":"Hồ sơ pháp lý","can_cu":"mục 31, mảng 38; QT.38","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Không phát hành khi bộ phận pháp chế chưa xác định thủ tục (Đề xuất – chờ duyệt)","Không lồng giới thiệu sản phẩm vào bài kiến thức y khoa có bác sĩ xác nhận (Đề xuất – chờ duyệt)"],"ngoai_le":[{"tinh_huong":"Nhà thuốc bệnh viện chỉ thông báo giờ mở cửa, địa điểm","cach_lam":"Thông báo vận hành theo QT.46, bước 4; không nêu tên, công dụng sản phẩm. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Hãng dược, nhà cung cấp đề nghị TTH quảng cáo sản phẩm của họ","cach_lam":"Theo QT.43 (đối tác đề nghị quảng cáo trên kênh của TTH)."},{"tinh_huong":"Hãng dược, nhà cung cấp thiết bị tài trợ hội nghị, sự kiện","cach_lam":"Theo QT.12 (ngoại lệ tài trợ)."}],"nhom_vi_du":"N1"},{"id":"lich-dang-thang","ten":"Kế hoạch nội dung, lịch đăng hằng tháng trên kênh (ngoài Hạng mục); trách nhiệm nội dung kênh","nhom_hoat_dong":["N3","N2","N1"],"vi_du":"Tháng 12: kênh TikTok TTH Healthcare (kênh có trong danh mục đã duyệt) cần 08 video ngắn theo chỉ tiêu năm; Facebook của Bệnh viện Đa khoa TTH Vinh cần bài kiến thức mùa lạnh, bài nhắc lịch khám ngày lễ và bài của Hạng mục đang triển khai.","buoc":[{"thuc_hien":["qlth"],"phoi_hop":["tn|nhu cầu tháng của cơ sở","tp|duyệt"],"noi_dung":"Lập kế hoạch nội dung tháng của các kênh thương hiệu trong kế hoạch tháng: chủ đề, bài kiến thức, video ngắn theo chỉ tiêu năm, ngày lễ, ngày sức khỏe; gộp nhu cầu tháng của cơ sở (ngày 10–15). Trưởng phòng duyệt.","thoi_han":"Trình chậm nhất ngày 18; duyệt chậm nhất ngày 20","ghi_nhan":"Kế hoạch tháng trên phần mềm","can_cu":"mục 4.2; mục 16, số 12","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Trang tính BM-3 của nhóm"},{"thuc_hien":["qlth"],"phoi_hop":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"noi_dung":"Gửi yêu cầu sản xuất qua cổng tiếp nhận; đủ ô bắt buộc thì tự xác nhận, xếp vào lịch sản xuất chung; yêu cầu cần xử lý: Tổ trưởng Tổ Nội dung và Sáng tạo (người nhóm 2, Chuyên viên thiết kế ngoại tuyến: Chuyên viên trưởng) xử lý trong 04 giờ làm việc.","thoi_han":"Sau khi kế hoạch tháng được duyệt","ghi_nhan":"Cổng tiếp nhận yêu cầu; sổ theo dõi yêu cầu","can_cu":"mục 14.5; mục 16, số 14","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["bt","tk","md"],"phoi_hop":["bac-si|xác nhận chuyên môn"],"noi_dung":"Sản xuất bài, ảnh, video; kiểm tra chất lượng, pháp lý (mục 15.6); bác sĩ xác nhận nội dung chuyên môn; phát hành khi đủ bước kiểm, nghiệm thu, duyệt (mục 14.16).","thoi_han":"Theo thời hạn chuẩn (mục 14.7)","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 16.1; mục 15.6","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qc"],"phoi_hop":["qlth|nghiệm thu lịch đăng"],"noi_dung":"Lập lịch đăng tháng của từng kênh của nhóm từ sản phẩm đã phát hành; Quản lý thương hiệu của nhóm nghiệm thu.","thoi_han":"Ngày 20–25; bổ sung hằng tuần","ghi_nhan":"Lịch đăng trên phần mềm","can_cu":"mục 14.16, mảng 10; mục 11.1, số 21","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Trang tính lịch đăng"},{"thuc_hien":["qc"],"phoi_hop":["cc|bình luận hỏi dịch vụ, tin nhắn","cvtt|đánh giá nhạy cảm, dư luận"],"noi_dung":"Đăng theo lịch; người đăng không sửa nội dung, cần sửa thì đề nghị qua cổng tiếp nhận. Bình luận hỏi dịch vụ, tin nhắn: Contact Center; đánh giá nhạy cảm: Chuyên viên truyền thông của nhóm; thông tin vi phạm: Chuyên viên quảng cáo và kênh số gỡ trong 03 giờ.","thoi_han":"Theo lịch đăng; gỡ thông tin vi phạm trong 03 giờ","ghi_nhan":"Kênh chính thức; sổ theo dõi sự cố","can_cu":"mục 16, số 21; mục 30","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["dl-1","qc"],"phoi_hop":["qlth|đánh giá, điều chỉnh kế hoạch tháng sau"],"noi_dung":"Số liệu kênh của tháng (tiếp cận, tương tác, Lead theo nguồn khách) trong báo cáo tháng dựng từ phần mềm; Quản lý thương hiệu của nhóm đánh giá, điều chỉnh kế hoạch nội dung tháng sau.","thoi_han":"Ngày làm việc đầu tháng","ghi_nhan":"Báo cáo tháng","can_cu":"mục 16, số 11; mục 12.5","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["Mỗi kênh một người quản trị; mỗi bài một người viết, một người duyệt phát hành (mục 16, số 21)","Chỉ sản phẩm đã duyệt phát hành vào lịch đăng; người đăng không sửa nội dung","Trách nhiệm nội dung bài: người viết; chuyên môn: bác sĩ xác nhận; pháp lý: Chuyên viên biên tập kiểm theo tầng; nghiệm thu: Quản lý thương hiệu của nhóm; phát hành khi đủ bước. Trách nhiệm kênh (lịch đăng, đăng, bình luận) và kết quả kênh số của nhóm: Chuyên viên quảng cáo và kênh số của nhóm; quyền: Chuyên viên trưởng","Nội dung do công cụ trí tuệ nhân tạo tạo ra (ảnh, video, giọng đọc, nhất là hình người) ghi dấu hiệu nhận biết theo Luật Trí tuệ nhân tạo 134/2025/QH15 (số điều: bộ phận pháp chế xác nhận)"],"ngoai_le":[{"tinh_huong":"Tin trong ngày trên Facebook của bệnh viện","cach_lam":"Trưởng nhóm Marketing cơ sở đăng theo QT.3; không qua lịch đăng của Tổng công ty."},{"tinh_huong":"Cơ sở đề nghị đăng bài ngoài lịch","cach_lam":"Gửi qua cổng tiếp nhận theo QT.2; gấp: QT.31."},{"tinh_huong":"Kênh TTH Healthcare, kênh chung TTH Clinic","cach_lam":"Dùng lại sản phẩm đã duyệt của TTH Hospital, TTH Clinic, TTH Group; sản phẩm riêng theo Hạng mục (mục 6)."},{"tinh_huong":"Kênh của Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện","cach_lam":"Theo QT.19."},{"tinh_huong":"Nội dung đã đăng có sai sót","cach_lam":"Theo QT.38."}],"nhom_vi_du":"N1"},{"id":"quang-cao-tra-phi","ten":"Quảng cáo trả phí trực tuyến: kế hoạch, mẫu quảng cáo, trang đích, triển khai, tối ưu, báo cáo","nhom_hoat_dong":["N4","N2","N10"],"vi_du":"Tháng 3: Bệnh viện Đa khoa TTH Hà Tĩnh triển khai quảng cáo Facebook cho gói khám tầm soát ung thư trong Hạng mục đã duyệt; cần 03 biến thể mẫu quảng cáo, 01 trang đích, nguồn khách riêng.","buoc":[{"thuc_hien":["qc"],"phoi_hop":["qlth|kết quả cần đạt, thông điệp, ngân sách","dl-1|cách đo, nguồn khách"],"noi_dung":"Lập kế hoạch quảng cáo tháng theo kế hoạch tháng, Hạng mục: chiến dịch, kênh, đối tượng, ngân sách, thời gian, số mẫu quảng cáo, nguồn khách. Công ty Cổ phần Winmed Việt Nam: theo QT.19.","thoi_han":"Ngày 20–25 hằng tháng","ghi_nhan":"Kế hoạch quảng cáo tháng trên phần mềm","can_cu":"QT.05.MKT.TCT; mục 30","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qlth"],"phoi_hop":["tp|thẩm định kế hoạch, không duyệt thay khoản chi","gd-coso|xác nhận mức chi dùng ngân sách cơ sở","ptgd-tc|duyệt chi trong hạn mức theo R28","btgd|Tổng Giám đốc phê duyệt chi mới ngoài hạn mức theo R28"],"noi_dung":"Quản lý thương hiệu của nhóm rà soát kế hoạch quảng cáo, mức ngân sách đề xuất, đối chiếu ngân sách đã duyệt và lập tờ trình chi. Giám đốc cơ sở xác nhận mức chi dùng ngân sách cơ sở. Cấp có thẩm quyền duyệt khoản chi theo R28: Phó Tổng Giám đốc mảng tài chính (trong hạn mức, kế hoạch đã duyệt); Tổng Giám đốc (chi mới ngoài hạn mức). Người lập và Trưởng phòng Marketing không tự thay người có thẩm quyền duyệt chi.","thoi_han":"Theo lịch trình kế hoạch tháng; chỉ triển khai khi khoản chi có phê duyệt hợp lệ theo R28","ghi_nhan":"Kế hoạch tháng; tờ trình chi Hạng mục","can_cu":"R28; mục 4.2; mục 14.5 bước 7","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Tờ trình chi trên Workit có loại chi, ngân sách, hạn mức, người có quyền ký và xác nhận của cơ sở nếu sử dụng ngân sách cơ sở; sổ Hạng mục ghi ngày duyệt và bằng chứng; chưa đủ thì dừng triển khai."},{"thuc_hien":["qc"],"phoi_hop":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"noi_dung":"Bổ sung yêu cầu kênh vào yêu cầu sản xuất của Quản lý thương hiệu: định dạng, kích thước, số biến thể (mục 14.5, bước 1).","thoi_han":"Cùng yêu cầu sản xuất","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.5; mục 14.12","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["bt","tk","md"],"phoi_hop":["bac-si|xác nhận nội dung chuyên môn","phap-che|rủi ro cao","tp|nội dung thuộc QyĐ.03.MKT mục 5.2"],"noi_dung":"Làm mẫu quảng cáo: lời quảng cáo và mọi biến thể chữ: Chuyên viên biên tập của nhóm; hình ảnh: Chuyên viên thiết kế của nhóm; video quảng cáo: Chuyên viên media của nhóm, kịch bản lời: Chuyên viên biên tập (mục 15.3, K2). Kiểm pháp lý theo tầng (mục 15.6); nội dung bắt buộc của quảng cáo dịch vụ khám bệnh, chữa bệnh theo danh sách kiểm tra pháp lý (Nghị định 342/2025/NĐ-CP, Điều 9); chỉ quảng cáo dịch vụ, kỹ thuật thuộc danh mục được phép (mục 14.15, số 40); hồ sơ nội dung quảng cáo khi pháp luật yêu cầu (QT.18, QT.55).","thoi_han":"Theo thời hạn chuẩn (mục 14.7)","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 15.6; mục 16.1, số 5","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qc"],"phoi_hop":["qlsps|nghiệm thu trang đích","dl-1|mã theo dõi"],"noi_dung":"Dựng trang đích từ mẫu khi Hạng mục cần; gắn mã theo dõi, nguồn khách; gỡ trang khi Hạng mục kết thúc.","thoi_han":"Trước ngày bắt đầu chiến dịch","ghi_nhan":"Danh mục sản phẩm số; trang quản trị nội dung website","can_cu":"mục 28, số 31; mục 11.1, số 25","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc"],"phoi_hop":["cc|tin nhắn, cuộc gọi từ quảng cáo; trước khi nhận: người đang trả lời tại cơ sở"],"noi_dung":"Triển khai quảng cáo theo kế hoạch đã duyệt; chỉ dùng mẫu đã duyệt phát hành, không sửa nội dung; tối ưu đối tượng, phân bổ ngân sách giữa các biến thể đã duyệt; theo dõi Lead hợp lệ theo nguồn khách.","thoi_han":"Trong thời gian chiến dịch","ghi_nhan":"Tài khoản quảng cáo; phần mềm","can_cu":"mục 16, số 21; QT.4","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc"],"phoi_hop":["dl-1|đối soát","qlth|đánh giá kết quả"],"noi_dung":"Báo cáo chiến dịch: chi, Lead hợp lệ, chi phí trên Lead hợp lệ, đặt lịch theo nguồn khách (mẫu đầu ra số 11).","thoi_han":"02 ngày sau khi chiến dịch kết thúc","ghi_nhan":"Báo cáo chiến dịch quảng cáo trên phần mềm","can_cu":"QT.05.MKT.TCT; mục 30","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["qc"],"phoi_hop":["bt|nhận phản hồi","tk|nhận phản hồi","md|nhận phản hồi"],"noi_dung":"Phản hồi mẫu quảng cáo hiệu quả, kém hiệu quả cho Biên tập, Thiết kế, Media để dùng cho tháng sau.","thoi_han":"Hằng tháng","ghi_nhan":"Phần mềm","can_cu":"mục 14.5, bước 8","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Người triển khai quảng cáo không sửa nội dung mẫu quảng cáo; mọi biến thể chữ, hình qua kiểm tra pháp lý và duyệt phát hành (mục 16, số 21)","Chi quảng cáo trong ngân sách đã duyệt; chi ngoài kế hoạch theo mục 4.2, quy tắc 3","Mỗi chiến dịch có nguồn khách; Lead hợp lệ theo tiêu chí của Chuyên viên đo lường và đối soát (QT.4)"],"ngoai_le":[{"tinh_huong":"Nền tảng từ chối quảng cáo, hạn chế tài khoản","cach_lam":"Cần sửa nội dung: Chuyên viên quảng cáo và kênh số gửi lại qua cổng tiếp nhận cho Biên tập, Thiết kế (người đăng không sửa nội dung); tài khoản bị khóa: QT.39."},{"tinh_huong":"Lead vượt khả năng tiếp nhận của cơ sở (hết lịch khám, hết suất)","cach_lam":"Trưởng nhóm Marketing cơ sở hoặc Contact Center báo; Chuyên viên quảng cáo và kênh số giảm hoặc tạm dừng ngân sách trong ngày; Quản lý thương hiệu quyết định tiếp tục (Đề xuất – chờ duyệt)."},{"tinh_huong":"Ưu đãi hết hạn, dịch vụ tạm ngừng, đổi giờ làm việc","cach_lam":"Tạm dừng quảng cáo liên quan trong ngày (QT.46)."},{"tinh_huong":"Website, App TTH, trang đích bị lỗi","cach_lam":"Tạm dừng quảng cáo dẫn về chức năng bị lỗi (QT.14)."},{"tinh_huong":"Quảng cáo thuốc, thực phẩm bảo vệ sức khỏe, mỹ phẩm, trang thiết bị y tế","cach_lam":"Theo QT.55."},{"tinh_huong":"Quảng cáo tuyển dụng; quảng cáo cho Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện","cach_lam":"Theo QT.22 (nguồn ngân sách: mục 28, số 42); QT.19."}],"nhom_vi_du":"N1"},{"id":"bao-cao-giao-ban","ten":"Báo cáo định kỳ, giao ban; chỉ đạo sau giao ban","nhom_hoat_dong":["N10","N11"],"vi_du":"Tuần thứ 3 của tháng: báo cáo tuần gửi thứ Bảy; Trưởng phòng dự giao ban Tổng công ty thứ Hai, nhận chỉ đạo truyền thông khai trương dịch vụ mới; giao ban nội bộ phòng thứ Ba giao việc; ngày 25 gửi báo cáo tháng.","buoc":[{"thuc_hien":["mkt-tct","mkt-coso"],"phoi_hop":["cvt|nhận xét","tt-nd|nhận xét","tt-ts|nhận xét","tn|nhận xét tại cơ sở"],"noi_dung":"Từng vị trí cập nhật mẫu tuần (mục 30.4): lý do việc chưa hoàn tất, vướng mắc, kế hoạch tuần sau; phần số liệu dựng từ phần mềm. Người đánh giá theo tuyến nhận xét trước giờ giao ban.","thoi_han":"Trước 10:00 thứ Bảy","ghi_nhan":"Phần mềm; mẫu tuần","can_cu":"mục 30.4; QyĐ.02.MKT 5.5.3.1","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-1"],"phoi_hop":[],"noi_dung":"Kiểm tra báo cáo tuần dựng tự động (BM-2): chỉ số theo cơ sở, kênh, Hạng mục; việc quá hạn; vướng mắc; việc trọng điểm tuần sau.","thoi_han":"Trước 10:00 thứ Bảy","ghi_nhan":"Báo cáo tuần","can_cu":"29/BB-TTH; QT.4","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["tp"],"phoi_hop":["btgd|nhận báo cáo, chỉ đạo"],"noi_dung":"Dự giao ban Tổng công ty: kết quả tuần, việc trọng điểm, việc cần Ban Tổng Giám đốc quyết định; chưa có Trưởng phòng: Chuyên viên trưởng dự. Chỉ đạo ghi vào cổng tiếp nhận yêu cầu (QT.41).","thoi_han":"11:00 thứ Hai; chỉ đạo ghi trong ngày","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 30.1; QT.41","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tp"],"phoi_hop":["dl-1|thư ký","cvt|báo cáo tổ","tt-nd|báo cáo tổ, lịch sản xuất chung","tt-ts|báo cáo tổ","cvt|lịch sản xuất chung, giờ dự phòng"],"noi_dung":"Chủ trì giao ban nội bộ phòng theo khung nội dung (mục 30.3); Trưởng phòng vắng hoặc chưa có: Chuyên viên trưởng.","thoi_han":"09:00 thứ Ba; tối đa 60 phút","ghi_nhan":"Sổ giao ban","can_cu":"mục 30.3; QyĐ.02.MKT 5.5.3.1","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-1"],"phoi_hop":[],"noi_dung":"Thư ký ghi sổ giao ban (BM-6): kết luận; việc giao thành yêu cầu hoặc Hoạt động có người, hạn trên phần mềm.","thoi_han":"Trong ngày họp","ghi_nhan":"Sổ giao ban; cổng tiếp nhận yêu cầu","can_cu":"m