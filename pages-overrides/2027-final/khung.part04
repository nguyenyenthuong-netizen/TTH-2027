<script id="csdl" type="application/json">{"ten":"Cơ sở dữ liệu tổ chức và vận hành Marketing toàn hệ thống TTH Group – phương án 2 nhóm thương hiệu","ngay_cap_nhat":"19/11/2026 – cơ cấu 02 Chuyên viên trưởng, 03 tổ chuyên môn, 02 nhóm thương hiệu; đối soát tuyến TCT – bệnh viện","trang_thai":"Phương án cơ cấu Marketing TTH Group 2027; chưa thay quyết định nhân sự, thẩm quyền phê duyệt hay quy chế đã ban hành.","nguon":"Khung bộ máy, định biên và phân công Marketing toàn hệ thống TTH Group – phương án 2 nhóm thương hiệu (10/11/2026)","quy_uoc_tham_chieu":"Trường thuc_hien, phoi_hop, chiu_trach_nhiem, don_vi ghi mã: vi_tri, chuc_danh, vai_tro hoặc don_vi; dạng \"mã|ghi chú\"","to":[{"id":"lanhdao","ten":"Lãnh đạo, quản lý"},{"id":"th","ten":"Tổ Truyền thông và Thương hiệu"},{"id":"nd","ten":"Tổ Nội dung và Sáng tạo"},{"id":"ts","ten":"Tổ Tăng trưởng số"},{"id":"coso","ten":"Marketing cơ sở"}],"chuc_danh":[{"id":"tp","ten":"Trưởng phòng Marketing","to":"lanhdao"},{"id":"cvt","ten":"Chuyên viên trưởng","to":"lanhdao"},{"id":"qlth","ten":"Quản lý thương hiệu","to":"th"},{"id":"cvtt","ten":"Chuyên viên truyền thông","to":"th"},{"id":"bt","ten":"Chuyên viên biên tập","to":"nd"},{"id":"tk","ten":"Chuyên viên thiết kế","to":"nd"},{"id":"md","ten":"Chuyên viên media","to":"nd"},{"id":"qc","ten":"Chuyên viên quảng cáo và kênh số","to":"ts"},{"id":"dl","ten":"Chuyên viên đo lường và đối soát; Chuyên viên dữ liệu khách hàng và thị trường","to":"ts"},{"id":"qlsps","ten":"Quản lý sản phẩm số","to":"ts"},{"id":"qlml","ten":"Quản lý mạng lưới Marketing cơ sở theo vùng","to":"lanhdao"},{"id":"tn","ten":"Trưởng nhóm Marketing cơ sở","to":"coso"},{"id":"mdcs","ten":"Chuyên viên Marketing cơ sở – media","to":"coso"},{"id":"qhcs","ten":"Chuyên viên Marketing cơ sở – truyền thông","to":"coso"},{"id":"dmpk","ten":"Đầu mối kiêm nhiệm tại phòng khám","to":"coso"},{"id":"cvt2","ten":"Chuyên viên trưởng 2 – Truyền thông, Thương hiệu và Tăng trưởng số","to":"lanhdao"}],"vi_tri":[{"id":"tp","ten":"Trưởng phòng Marketing","to":"lanhdao","nhom_thuong_hieu":"","chuc_danh":"tp","thay_chinh":"cvt","du_phong":["qlsps|thứ tự ủy quyền thứ hai, chỉ việc không có chi mới ngoài hạn mức; việc có chi mới: Tổng Giám đốc"],"pham_vi":"trung_lap","gio_ke_hoach":"≈ 81–88 giờ/tháng (ước tính, đo ở thí điểm)","viec_chung":"Điều hành; duyệt theo phân cấp (mục 14.16); quyền quản trị cao nhất kênh (R08)","muc_dich":"Tham mưu cho Ban Tổng Giám đốc và chịu trách nhiệm chung về công tác Marketing của toàn hệ thống: kế hoạch, ngân sách, nội dung chuyên môn, kết quả Hạng mục trọng điểm (mục 4.1); chủ trì khủng hoảng liên quan cả hai nhóm.","bao_cao_cho":"Ban Tổng Giám đốc","ngach":"Theo khung lãnh đạo của Tổng công ty (mục 24.2)","trang_thai_kpi":"Chưa có bảng KPI chính thức; phải lập và duyệt trước khi áp dụng với vị trí này.","phan_dinh_chu_tri_dau_ra":"Chủ kế hoạch năm, ngân sách, cơ chế duyệt, kết quả toàn phòng; quyết định ưu tiên giữa hai nhóm","phan_dinh_khong_thuoc_trach_nhiem":"Không mặc nhiên duyệt thay bác sĩ, Pháp chế, Ban Tổng Giám đốc hoặc đơn vị chủ dữ liệu","phan_dinh_ban_giao_dau_vao":"Nhận báo cáo từ Quản lý thương hiệu, Chuyên viên trưởng, đo lường; ký/duyệt theo ma trận thẩm quyền","phan_dinh_kiem_duyet":"Ban Tổng Giám đốc đối với nội dung vượt thẩm quyền"},{"id":"cvt","ten":"Chuyên viên trưởng 1 – Nội dung và Sáng tạo","to":"lanhdao","nhom_thuong_hieu":"","chuc_danh":"cvt","thay_chinh":"tp","du_phong":["qlsps|việc không có chi mới ngoài hạn mức"],"pham_vi":"trung_lap","gio_ke_hoach":"Tính tải quản lý và nghiệp vụ từ nhật ký công việc thực đo; không cộng chồng tải Tổ trưởng hoặc người sản xuất.","viec_chung":"Điều phối năng lực và kế hoạch sản xuất Nội dung – Biên tập – Thiết kế – Media hai nhóm; tiêu chuẩn kịch bản, file mẫu, bộ nhận diện sản phẩm, lịch dùng thiết bị Media và kiểm soát kỹ thuật sản xuất toàn hệ thống. Tổ trưởng tại bệnh viện trực tiếp giao việc hiện trường; Chuyên viên trưởng 1 giải quyết xung đột năng lực sản xuất đúng thẩm quyền.","muc_dich":"Quản lý, điều phối chuyên môn Tổ Nội dung và Sáng tạo tại Tổng công ty; hướng dẫn chuẩn biên tập, thiết kế, media cho Tổ Marketing tại bệnh viện. Không quản lý hành chính nhân sự bệnh viện.","bao_cao_cho":"Trưởng phòng Marketing","ngach":"Quản lý","phan_dinh_chu_tri_dau_ra":"Quy chuẩn, biểu mẫu, sản lượng và kiểm soát chuyên môn Tổ Nội dung và Sáng tạo; hướng dẫn sản xuất tại cơ sở.","phan_dinh_khong_thuoc_trach_nhiem":"Không duyệt nội dung y khoa, nghiệm thu mục tiêu thương hiệu, duyệt phát hành, chi phí hoặc quản lý hành chính cơ sở nếu không có phân quyền cụ thể.","phan_dinh_ban_giao_dau_vao":"Nhận đề xuất xung đột, phân bổ nguồn lực theo phân cấp; bàn giao cho người được chỉ định","phan_dinh_kiem_duyet":"Trưởng phòng duyệt thay đổi quy tắc/quyền ngoài hạn mức"},{"id":"cvt-2","ten":"Chuyên viên trưởng 2 – Truyền thông, Thương hiệu và Tăng trưởng số","to":"lanhdao","nhom_thuong_hieu":"","chuc_danh":"cvt2","pham_vi":"trung_lap","thay_chinh":"tp","du_phong":[],"bao_cao_cho":"Trưởng phòng Marketing","ngach":"Quản lý","gio_ke_hoach":"Tính tải quản lý của hai tổ và tuyến nghiệp vụ tại cơ sở theo giờ thực đo; không tự cộng quyền hoặc vị trí Tổ trưởng.","muc_dich":"Điều phối chuyên môn Tổ Truyền thông và Thương hiệu cùng Tổ Tăng trưởng số ở Tổng công ty; hướng dẫn tuyến truyền thông, thương hiệu và kênh số tương ứng tại Tổ Marketing bệnh viện.","viec_chung":"Quản lý chuẩn PR, OOH, phát thanh và màn hình nội viện, kênh số, quảng cáo, sản phẩm số và đo lường theo từng nhóm thương hiệu. Tổ trưởng của hai tổ phân công nhân sự TCT; Tổ trưởng Marketing bệnh viện quản lý, giao việc nhân sự tại bệnh viện. Chuyên viên trưởng 2 không trực tiếp ra hai lệnh cho cùng một nhân viên.","phan_dinh_chu_tri_dau_ra":"Quy chuẩn nghiệp vụ truyền thông, thương hiệu, kênh số, quảng cáo, dữ liệu đo lường; điều phối năng lực hai tổ và hướng dẫn chuyên môn tương ứng ở cơ sở.","phan_dinh_khong_thuoc_trach_nhiem":"Không tự động duyệt nội dung y khoa, phát hành, ngân sách hoặc chi phí; không thay quản lý thương hiệu nghiệm thu hạng mục.","phan_dinh_ban_giao_dau_vao":"Nhận yêu cầu từ Quản lý thương hiệu, Tổ trưởng hai tổ và Tổ trưởng Marketing bệnh viện; điều phối một đầu mối công việc, chuyển đúng cấp duyệt.","phan_dinh_kiem_duyet":"Kiểm đúng chuyên môn trong phạm vi hai tổ; người có thẩm quyền được ủy quyền mới được duyệt phát hành; Trưởng phòng giải quyết xung đột ngoài thẩm quyền."},{"id":"qlth-a","ten":"Quản lý thương hiệu nhóm 1","to":"th","nhom_thuong_hieu":"N1","chuc_danh":"qlth","thay_chinh":"cvtt-a","du_phong":["cvt"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 139 giờ/tháng (sau cân giờ 14/11/2026: phần Hạng mục toàn hệ thống của nhóm 2 về Quản lý thương hiệu nhóm 2; tài trợ, hồ sơ năng lực về Chuyên viên truyền thông nhóm 1)","viec_chung":"Phần nhóm 1 của Hạng mục toàn hệ thống (chi phí dùng chung ở thương hiệu chủ); hội nghị, sự kiện cấp hệ thống mang thương hiệu TTH Group; Hạng mục đối tác cấp hệ thống của thương hiệu nhóm 1; trực sự cố tầng 1 chung (CN-4)","muc_dich":"Chịu trách nhiệm kết quả Hạng mục trọng điểm của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic): khách hàng, doanh thu ghi nhận theo nguồn khách; giữ định vị, thông điệp các thương hiệu TTH; chủ Hạng mục toàn hệ thống; đầu mối giao việc theo Hạng mục với Marketing của các bệnh viện, phòng khám nhóm 1.","bao_cao_cho":"Tổ trưởng Tổ Truyền thông và Thương hiệu phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"Chủ mục tiêu/kết quả Hạng mục nhóm 1; thông điệp, kế hoạch, nghiệm thu yêu cầu; giao nhiệm vụ theo Hạng mục","phan_dinh_khong_thuoc_trach_nhiem":"Không tự viết bài, dựng video, đăng quảng cáo, nhập CMS, xác nhận y khoa; không phân công chuyên môn nhóm 2","phan_dinh_ban_giao_dau_vao":"Đặt yêu cầu cho Biên tập/Thiết kế/Media/Quảng cáo/Truyền thông đúng nhóm; nhận dữ liệu cơ sở","phan_dinh_kiem_duyet":"Trưởng phòng/cấp được ủy quyền duyệt kế hoạch, ngân sách và phát hành theo loại"},{"id":"qlth-bc","ten":"Quản lý thương hiệu nhóm 2","to":"th","nhom_thuong_hieu":"N2","chuc_danh":"qlth","thay_chinh":"cvtt-bc","du_phong":["cvt"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 88–91 giờ/tháng (không kiêm Tổ trưởng; chỉ nghiệm thu, không kiểm lời)","viec_chung":"Phần nhóm 2 của Hạng mục toàn hệ thống (≈ 07 giờ/tháng); nhãn hiệu các thương hiệu nhóm 2 (hồ sơ: bộ phận pháp chế); trực sự cố tầng 1 chung (CN-4); Kiêm Tổ trưởng Tổ Truyền thông và Thương hiệu (04 vị trí), điều phối công việc chung không mặc định quyền phê duyệt","muc_dich":"Chịu trách nhiệm kết quả Hạng mục trọng điểm của nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng, các chuỗi chuyên khoa, Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện); giữ định vị, thông điệp các thương hiệu này; lập phần nhóm 2 của Hạng mục toàn hệ thống. Kiêm Tổ trưởng Tổ Truyền thông và Thương hiệu: điều phối tiến độ, phân việc, xử lý trùng lịch của cả 04 vị trí trong tổ, không làm thay công việc chuyên môn nhóm 1 và không tự có quyền duyệt ngân sách, nội dung hay quyết định nhân sự.","bao_cao_cho":"Tổ trưởng Tổ Truyền thông và Thương hiệu phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"Chủ mục tiêu/kết quả Hạng mục nhóm 2; kiêm điều phối tiến độ 04 vị trí của tổ, không thay trách nhiệm nhóm 1","phan_dinh_khong_thuoc_trach_nhiem":"Không tự thành cấp duyệt cao hơn; không duyệt ngân sách/nội dung chuyên môn và không chỉ đạo làm chéo nhóm","phan_dinh_ban_giao_dau_vao":"Nhận đề bài nhóm 2, phân luồng công việc tổ; báo Trưởng phòng khi xung đột","phan_dinh_kiem_duyet":"Trưởng phòng/cấp được ủy quyền; quyền tổ trưởng chỉ điều phối"},{"id":"cvtt-a","ten":"Chuyên viên truyền thông nhóm 1","to":"th","nhom_thuong_hieu":"N1","chuc_danh":"cvtt","thay_chinh":"qlth-a","du_phong":["cvt"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 115 giờ/tháng","viec_chung":"Phần nhóm 1 của chuẩn quan hệ công chúng, quy chế phát ngôn (Chuyên viên trưởng tổng hợp); hồ sơ năng lực Tập đoàn (ghép, phần nhóm 2 không sửa); tài trợ, hồ sơ năng lực thương hiệu Tập đoàn; trực sự cố tầng 1 chung (CN-4)","muc_dich":"Thực hiện quan hệ công chúng, kênh ngoại tuyến và nội viện của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic), gồm lịch phát màn hình, phát thanh nội viện của cơ sở nhóm 1; xử lý khủng hoảng của nhóm 1, gồm khủng hoảng mang tên TTH Group; khủng hoảng liên quan cả hai nhóm: làm phần của nhóm 1 theo chủ trì của Trưởng phòng. Góp phần nhóm 1 vào chuẩn quan hệ công chúng chung, quy chế phát ngôn (Chuyên viên trưởng giữ, QC-5).","bao_cao_cho":"Tổ trưởng Tổ Truyền thông và Thương hiệu phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"PR/báo chí, đối tác truyền thông, KOL/KOC, tài trợ và ngoại tuyến nhóm 1; chốt lịch màn hình, phát thanh cơ sở nhóm 1","phan_dinh_khong_thuoc_trach_nhiem":"Không sản xuất thay Biên tập/Thiết kế/Media; không vận hành thiết bị ở bệnh viện; không chốt KPI Hạng mục","phan_dinh_ban_giao_dau_vao":"Đặt sản phẩm qua Tổ Nội dung và Sáng tạo; giao lịch đã duyệt cho cơ sở; nhận ảnh nghiệm thu","phan_dinh_kiem_duyet":"Quản lý thương hiệu nghiệm thu phù hợp Hạng mục; Trưởng phòng/cấp có thẩm quyền duyệt phát ngôn"},{"id":"cvtt-bc","ten":"Chuyên viên truyền thông nhóm 2","to":"th","nhom_thuong_hieu":"N2","chuc_danh":"cvtt","thay_chinh":"qlth-bc","du_phong":["cvt"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 69 giờ/tháng","viec_chung":"Phần nhóm 2 của chuẩn quan hệ công chúng, quy chế phát ngôn; phần nhóm 2 của hồ sơ năng lực Tập đoàn; trực sự cố tầng 1 chung (CN-4)","muc_dich":"Thực hiện quan hệ công chúng, kênh ngoại tuyến và nội viện của nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng, các chuỗi chuyên khoa, Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện), gồm lịch phát màn hình, phát thanh nội viện của cơ sở nhóm 2; xử lý khủng hoảng của nhóm 2. Góp phần nhóm 2 vào chuẩn quan hệ công chúng chung, quy chế phát ngôn (Chuyên viên trưởng giữ, QC-5).","bao_cao_cho":"Tổ trưởng Tổ Truyền thông và Thương hiệu phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"PR/báo chí, đối tác, KOL/KOC, tài trợ, ngoại tuyến, lịch phát cho các đơn vị nhóm 2","phan_dinh_khong_thuoc_trach_nhiem":"Không mặc định quản trị kênh quảng cáo, sản xuất nội dung hay điều hành PR nhóm 1","phan_dinh_ban_giao_dau_vao":"Bàn giao lịch/mẫu phát cho Trưởng nhóm hoặc truyền thông cơ sở; chuyển nguồn về người viết","phan_dinh_kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu; Trưởng phòng/cấp được ủy quyền duyệt"},{"id":"bt-ac","ten":"Chuyên viên biên tập nhóm 1","to":"nd","nhom_thuong_hieu":"N1","chuc_danh":"bt","thay_chinh":"bt-ac|người còn lại trong nhóm","du_phong":["cvtt-a|việc có hạn, không nội dung chuyên môn"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 211 giờ/tháng cho 02 người (gồm ≈ 12 giờ kiểm pháp lý ngang hàng cho nhóm 2; ≈ 17 giờ vai trò Tổ trưởng của người được chỉ định)","viec_chung":"Kiểm pháp lý ngang hàng lời của Chuyên viên biên tập nhóm 2 (CN-1, ≈ 12 giờ/tháng); duyệt sản phẩm truyền thông nội bộ Tổng công ty, TTH Group; thay khi vắng, chờ tuyển cho nhóm 2 (CN-2, CN-3)","muc_dich":"Viết toàn bộ nội dung của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic), gồm nội dung website tthhealthcare.com (bản tiếng Việt, tiếng Anh) và App TTH; hai người kiểm pháp lý lời của nhau; kiểm pháp lý ngang hàng lời của Chuyên viên biên tập nhóm 2 (CN-1).","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng 1 quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Viết/biên tập nội dung bài, kịch bản lời, nội dung website/App của nhóm 1; rà soát nội dung y tế theo lịch; chuẩn bị bản nội dung và minh chứng phục vụ hồ sơ pháp lý; chủ trì kịch bản lời/thoại của video V2–V4 kể cả video không có nội dung y tế; thông điệp, lời dẫn và nội dung chữ trên hình. Không chuyển quyền chủ trì lời cho Media chỉ vì video không mang nội dung y tế.","phan_dinh_khong_thuoc_trach_nhiem":"Không soạn kịch bản tư vấn Contact Center; không tự lập/nộp hồ sơ pháp lý; không tự xác nhận giá, giấy phép, lịch bác sĩ; không nhập dữ liệu có cấu trúc thuộc mảng 43","phan_dinh_ban_giao_dau_vao":"Nhận nguồn bác sĩ/cơ sở và yêu cầu Quản lý thương hiệu; giao file lời cho Thiết kế/Media/Kênh số; chuyển minh chứng cho Pháp chế","phan_dinh_kiem_duyet":"Đầu ra của Biên tập được người khác kiểm độc lập theo cấp độ rủi ro; bác sĩ/đơn vị chuyên môn xác nhận mọi nội dung y khoa; Quản lý thương hiệu nghiệm thu đầu ra; người có thẩm quyền duyệt phát hành. Biên tập không tự phê duyệt sản phẩm mình viết."},{"id":"bt-b","ten":"Chuyên viên biên tập nhóm 2","to":"nd","nhom_thuong_hieu":"N2","chuc_danh":"bt","thay_chinh":"bt-ac|ngoại lệ thay khi vắng, người trung lập cho phép làm thay có thời hạn (mục 15.4)","du_phong":["Việc không gấp lùi hạn"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 125 giờ/tháng","viec_chung":"Không","muc_dich":"Viết toàn bộ nội dung của nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng, các chuỗi chuyên khoa, Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện), gồm nội dung xây mới website các chuỗi; lời do Chuyên viên biên tập nhóm 1 kiểm pháp lý ngang hàng (CN-1); có quyền dừng phát hành vì lý do pháp lý.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng 1 quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Viết/biên tập nội dung, lời video, website của nhóm 2; chuẩn bị minh chứng nội dung nhóm 2 khi có hồ sơ pháp lý; chủ trì kịch bản lời/thoại của video V2–V4 kể cả video không có nội dung y tế; thông điệp, lời dẫn và nội dung chữ trên hình. Không chuyển quyền chủ trì lời cho Media chỉ vì video không mang nội dung y tế.","phan_dinh_khong_thuoc_trach_nhiem":"Không viết thay kịch bản tư vấn, hồ sơ pháp lý; không tự quản trị kênh/quảng cáo hay xác nhận thông số chuyên môn","phan_dinh_ban_giao_dau_vao":"Nhận nguồn chuyên môn đơn vị nhóm 2; giao sản phẩm theo phiếu cho Media, Thiết kế, Quảng cáo","phan_dinh_kiem_duyet":"Đầu ra của Biên tập được người khác kiểm độc lập theo cấp độ rủi ro; bác sĩ/đơn vị chuyên môn xác nhận mọi nội dung y khoa; Quản lý thương hiệu nghiệm thu đầu ra; người có thẩm quyền duyệt phát hành. Biên tập không tự phê duyệt sản phẩm mình viết."},{"id":"tk-a","ten":"Chuyên viên thiết kế nhóm 1","to":"nd","nhom_thuong_hieu":"N1","chuc_danh":"tk","thay_chinh":"tk-a|người còn lại trong nhóm","du_phong":["tk-nt|sản phẩm in"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 189 giờ/tháng cho 02 người (chia cố định: phụ trách hệ thống / phụ trách bệnh viện)","viec_chung":"Bộ nhận diện chung của TTH, quy chuẩn ứng dụng (người phụ trách hệ thống); thay khi vắng, chờ tuyển cho nhóm 2 (CN-2, CN-3)","muc_dich":"Hai người cùng mô tả công việc, chia cố định (phụ trách hệ thống / phụ trách bệnh viện): làm mọi sản phẩm thiết kế của nhóm 1 ngoài danh sách cố định của Chuyên viên thiết kế ngoại tuyến, cả bản số và bản in (gồm Hạng mục toàn hệ thống, sự kiện hệ thống, tuyển dụng, nội bộ); làm và giữ bộ nhận diện chung của TTH, quy chuẩn ứng dụng (B-1, QC-1); hình ảnh website tthhealthcare.com, App TTH. Phần mềm giao việc theo bảng phân công; yêu cầu cần xử lý: Tổ trưởng.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng 1 quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Thiết kế bản số và bản in không thuộc danh sách cố định của Thiết kế ngoại tuyến; bộ nhận diện TTH, ứng dụng web/App","phan_dinh_khong_thuoc_trach_nhiem":"Không thi công, quản trị biển bảng, dựng video, đăng kênh; không làm thay thiết kế cố định ngoại tuyến","phan_dinh_ban_giao_dau_vao":"Nhận nội dung đã kiểm; giao file đúng thông số cho Quảng cáo, Media hoặc Truyền thông; bàn giao kiểm file in","phan_dinh_kiem_duyet":"Người yêu cầu nghiệm thu; kiểm độc lập và người duyệt theo loại sản phẩm"},{"id":"tk-b","ten":"Chuyên viên thiết kế nhóm 2","to":"nd","nhom_thuong_hieu":"N2","chuc_danh":"tk","thay_chinh":"tk-a|ngoại lệ thay khi vắng, người trung lập cho phép làm thay có thời hạn (mục 15.4)","du_phong":["tk-nt|sản phẩm in","Việc không gấp lùi hạn"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 135 giờ/tháng","viec_chung":"Bộ nhận diện các thương hiệu nhóm 2 (đầu mối phần thuê ngoài thiết kế hệ nhận diện, mục 26); Chủ trì bộ nhận diện nhóm 2; Chuyên viên thiết kế ngoại tuyến hỗ trợ trong giờ dư đến khi bàn giao","muc_dich":"Làm mọi sản phẩm thiết kế của nhóm 2 (gồm Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện) ngoài danh sách cố định của Chuyên viên thiết kế ngoại tuyến, cả bản số và bản in; bộ nhận diện các thương hiệu nhóm 2, quy chuẩn ứng dụng (B-2, QC-2); mẫu thiết kế sẵn của nhóm 2 trong thư viện mẫu (M-6); hình ảnh website các chuỗi.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng 1 quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Thiết kế sản phẩm nhóm 2 ngoài danh sách cố định ngoại tuyến; chủ trì thiết kế hệ nhận diện của nhóm 2 theo phân công","phan_dinh_khong_thuoc_trach_nhiem":"Không tự thay mẫu nhận diện được duyệt; không tự duyệt in/thi công; không phụ trách sản phẩm nhóm 1","phan_dinh_ban_giao_dau_vao":"Nhận nội dung nhóm 2; giao file đến Media/Kênh số/Truyền thông; phối hợp Thiết kế ngoại tuyến phần cố định","phan_dinh_kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu, cấp có thẩm quyền duyệt nhận diện"},{"id":"tk-nt","ten":"Chuyên viên thiết kế ngoại tuyến","to":"nd","nhom_thuong_hieu":"","chuc_danh":"tk","thay_chinh":"Chuyên viên thiết kế của nhóm có sản phẩm","du_phong":["cvt|vai trò Tổ trưởng"],"pham_vi":"trung_lap","gio_ke_hoach":"≈ 75–80 giờ/tháng việc của vị trí; giờ dư ≈ 60 giờ/tháng hỗ trợ bộ nhận diện nhóm 2 đến khi bàn giao (không giữ vai trò Tổ trưởng từ 14/11/2026)","viec_chung":"Cấu trúc thư viện mẫu thiết kế sẵn (quyền, thu hồi mẫu cũ, hướng dẫn công cụ); danh mục biển bảng toàn hệ thống, đầu mối QyĐ.48; kiểm tra tuân thủ nhận diện tại cơ sở hằng quý; quy chuẩn in; bộ mẫu trang trí; bản quyền phông chữ, ảnh, nhạc, video, thuê bao công cụ thiết kế; làm việc kỹ thuật với đơn vị in, thi công (hợp đồng, thanh toán: Quản lý thương hiệu; thi công, nghiệm thu: Chuyên viên truyền thông của nhóm); Hỗ trợ Chuyên viên thiết kế nhóm 2 làm bộ nhận diện nhóm 2 (mảng 7; B-2, QC-2) trong giờ dư (≈ 60 giờ/tháng) đến khi bàn giao: phần ứng dụng lên ấn phẩm, mẫu thiết kế sẵn, biển bảng của nhóm 2; phần thiết kế hệ nhận diện thuê ngoài theo phiếu chốt điểm 26, chưa thuê được thì cùng làm (điểm 7a). Chuyên viên thiết kế nhóm 2 chủ trì, Quản lý thương hiệu nhóm 2 nghiệm thu; giờ, KPI kết quả tính cho nhóm 2 (Phòng Marketing Tổng công ty chốt 14/11/2026)","muc_dich":"Làm sản phẩm thuộc danh sách cố định của toàn hệ thống: biển bảng, phương tiện quảng cáo cố định, trang trí cố định, trang trí lễ, Tết, phương tiện; giữ quy chuẩn in; chịu trách nhiệm tổ chức kiểm tra kỹ thuật file in, thi công trước khi gửi nhà cung cấp; với file do chính mình tạo phải chuyển người khác đủ năng lực kiểm độc lập, không tự xác nhận kiểm cuối. Vị trí trung lập giữ việc chung: cấu trúc thư viện mẫu thiết kế sẵn, danh mục biển bảng toàn hệ thống, đầu mối QyĐ.48, kiểm tra tuân thủ nhận diện tại cơ sở hằng quý, bản quyền và thuê bao công cụ; không giữ vai trò Tổ trưởng Tổ Nội dung và Sáng tạo; tuyến điều phối việc của vị trí này thuộc Chuyên viên trưởng.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng 1 quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Thiết kế danh sách cố định: biển bảng, trang trí cố định, lễ Tết; giữ quy chuẩn in, danh mục và kiểm nhận diện độc lập","phan_dinh_khong_thuoc_trach_nhiem":"Không giữ toàn bộ thiết kế in; không tự nghiệm thu cuối sản phẩm do chính mình thiết kế; không trực tiếp vận hành biển bảng tại cơ sở","phan_dinh_ban_giao_dau_vao":"Nhận số đo/ảnh hiện trạng từ Truyền thông cơ sở, yêu cầu Chuyên viên truyền thông; chuyển file kỹ thuật để triển khai","phan_dinh_kiem_duyet":"Người kiểm độc lập (nếu tự làm), cấp duyệt biển bảng theo QyĐ.48"},{"id":"md-ac","ten":"Chuyên viên media nhóm 1","to":"nd","nhom_thuong_hieu":"N1","chuc_danh":"md","thay_chinh":"md-ac|người còn lại trong nhóm","du_phong":["mdcs-a|ghi hình tại cơ sở"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 219 giờ/tháng cho 02 người","viec_chung":"Lập chuẩn kỹ thuật media chung (Chuyên viên trưởng giữ, Trưởng phòng duyệt, QC-4); thư mục kho tư liệu của nhóm 1; thay khi vắng, chờ tuyển cho nhóm 2 (CN-2, CN-3); Chuyên viên media của nhóm duyệt bản dựng V2, V3 do Marketing cơ sở – media thực hiện theo bộ mẫu B-7; làm V4 và sản phẩm video thuộc Tổng công ty.","muc_dich":"Hai người cùng mô tả công việc, chia cố định (phụ trách hệ thống / phụ trách bệnh viện): sản xuất video, ảnh hoàn chỉnh của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic); sự kiện, phim thương hiệu cấp hệ thống; lập chuẩn kỹ thuật media chung (QC-4), soạn nội dung đào tạo Marketing cơ sở – media; giữ thư mục kho tư liệu của nhóm 1. Phần mềm giao việc theo bảng phân công; yêu cầu cần xử lý: Tổ trưởng.","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng 1 quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Chủ trì kịch bản phân cảnh, shot-list, quay/dựng, âm thanh, hình ảnh, hậu kỳ kỹ thuật và chuẩn kỹ thuật Media; kiểm kỹ thuật độc lập V2/V3 do Media cơ sở dựng; trực tiếp sản xuất V3 vượt mẫu và V4. Không là người chủ trì kịch bản lời/thoại.","phan_dinh_khong_thuoc_trach_nhiem":"Không thay Biên tập viết kịch bản lời/thoại; không thay bác sĩ xác nhận chuyên môn; không thay người có thẩm quyền duyệt phát hành; không trực tiếp vận hành biển bảng, màn hình, phát thanh ở cơ sở.","phan_dinh_ban_giao_dau_vao":"Nhận kịch bản đã kiểm từ Biên tập và tư liệu từ Media cơ sở; xuất bản hoàn chỉnh cho Kênh số/Truyền thông","phan_dinh_kiem_duyet":"Chỉ kiểm kỹ thuật hình/âm/dựng và tuân thủ B-7/QC-4 của bản dựng khác người làm; không tự duyệt bản dựng do chính mình sản xuất và không duyệt nội dung y khoa hoặc phát hành."},{"id":"md-b","ten":"Chuyên viên media nhóm 2","to":"nd","nhom_thuong_hieu":"N2","chuc_danh":"md","thay_chinh":"md-ac|ngoại lệ thay khi vắng, người trung lập cho phép làm thay có thời hạn (mục 15.4)","du_phong":["mdcs-b|ghi hình tại cơ sở","Việc không gấp lùi hạn"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 131 giờ/tháng","viec_chung":"Không (thư mục kho tư liệu của nhóm 2); Chuyên viên media của nhóm duyệt bản dựng V2, V3 do Marketing cơ sở – media thực hiện theo bộ mẫu B-7; làm V4 và sản phẩm video thuộc Tổng công ty.","muc_dich":"Sản xuất video, ảnh hoàn chỉnh của nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng, các chuỗi chuyên khoa, Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện); giữ thư mục kho tư liệu của nhóm 2 (quyền: Chuyên viên trưởng).","bao_cao_cho":"Tổ trưởng Tổ Nội dung và Sáng tạo điều phối lịch, nhân lực trong tổ; Chuyên viên trưởng 1 quản lý chuyên môn Nội dung – Sáng tạo; Trưởng phòng quyết định vượt quyền. Người làm không tự duyệt.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Chủ trì kịch bản phân cảnh, shot-list, quay/dựng, âm thanh, hình ảnh, hậu kỳ kỹ thuật và chuẩn kỹ thuật Media; kiểm kỹ thuật độc lập V2/V3 do Media cơ sở dựng; trực tiếp sản xuất V3 vượt mẫu và V4. Không là người chủ trì kịch bản lời/thoại.","phan_dinh_khong_thuoc_trach_nhiem":"Không thay Biên tập viết kịch bản lời/thoại; không thay bác sĩ xác nhận chuyên môn; không thay người có thẩm quyền duyệt phát hành; không trực tiếp vận hành biển bảng, màn hình, phát thanh ở cơ sở.","phan_dinh_ban_giao_dau_vao":"Nhận tư liệu Media cơ sở và kịch bản lời nhóm 2; giao file phát hành","phan_dinh_kiem_duyet":"Chỉ kiểm kỹ thuật hình/âm/dựng và tuân thủ B-7/QC-4 của bản dựng khác người làm; không tự duyệt bản dựng do chính mình sản xuất và không duyệt nội dung y khoa hoặc phát hành."},{"id":"qc-a","ten":"Chuyên viên quảng cáo và kênh số nhóm 1","to":"ts","nhom_thuong_hieu":"N1","chuc_danh":"qc","thay_chinh":"qc-a|người còn lại trong nhóm","du_phong":["qlsps"],"pham_vi":"nhom_1","gio_ke_hoach":"≈ 264 giờ/tháng cho 02 người","viec_chung":"Thay khi vắng, chờ tuyển cho nhóm 2 (CN-2, CN-3)","muc_dich":"Hai người cùng mô tả công việc, chia cố định (phụ trách hệ thống / phụ trách bệnh viện): quảng cáo trực tuyến và quản trị kênh số của nhóm 1 (TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic); gửi tin hàng loạt trên kênh nhóm 1; đăng tin tuyển dụng.","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Chạy quảng cáo trả phí, đăng/quản trị kênh số, lịch gửi nhóm 1, tối ưu theo dữ liệu nền tảng","phan_dinh_khong_thuoc_trach_nhiem":"Không quyết định chiến lược thương hiệu, không chốt KPI tài chính chính thức, không sửa dữ liệu gốc/đăng CMS cấu trúc","phan_dinh_ban_giao_dau_vao":"Nhận nội dung, thiết kế, media đã duyệt; gắn đo theo hướng dẫn; báo số liệu cho Đo lường và đối soát","phan_dinh_kiem_duyet":"Quản lý thương hiệu nghiệm thu lịch; Chuyên viên trưởng quản quyền theo ma trận"},{"id":"qc-b","ten":"Chuyên viên quảng cáo và kênh số nhóm 2","to":"ts","nhom_thuong_hieu":"N2","chuc_danh":"qc","thay_chinh":"qc-a|ngoại lệ thay khi vắng, người trung lập cho phép làm thay có thời hạn (mục 15.4)","du_phong":["qlsps"],"pham_vi":"nhom_2","gio_ke_hoach":"≈ 138 giờ/tháng","viec_chung":"Không","muc_dich":"Quảng cáo trực tuyến và quản trị kênh số của nhóm 2, gồm trang Facebook Công ty Cổ phần Winmed Việt Nam, Công ty TNHH Tuệ Đức Thiện; gửi tin hàng loạt trên kênh nhóm 2; áp dụng chính sách nền tảng trên kênh nhóm 2 (danh sách: Quản lý sản phẩm số, DS-3).","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Chạy quảng cáo, quản trị kênh số, lịch đăng/gửi tin của thương hiệu nhóm 2","phan_dinh_khong_thuoc_trach_nhiem":"Không thay Truyền thông xử lý báo chí/KOL; không đổi chính sách nền tảng hoặc dữ liệu có cấu trúc website","phan_dinh_ban_giao_dau_vao":"Nhận gói sản phẩm nhóm 2 đã duyệt; phản hồi chi phí, Lead về Đo lường","phan_dinh_kiem_duyet":"Quản lý thương hiệu nhóm 2 nghiệm thu lịch; cấp duyệt kinh phí"},{"id":"dl-1","ten":"Chuyên viên đo lường và đối soát","to":"ts","nhom_thuong_hieu":"","chuc_danh":"dl","thay_chinh":"dl-2|chưa có người: bảng tính chốt số có công thức, hướng dẫn chốt số","du_phong":["qlsps|chốt theo hướng dẫn; phần KPI của Quản lý sản phẩm số do Chuyên viên trưởng kiểm"],"pham_vi":"trung_lap","gio_ke_hoach":"≈ 144 giờ/tháng có phần mềm, gồm phần kiêm Chuyên viên dữ liệu khách hàng và thị trường (chưa có phần mềm ≈ 179)","viec_chung":"Chốt kỳ, chốt KPI quý; danh mục nguồn khách, tiêu chí Lead hợp lệ; cộng nhu cầu mua của 02 nhóm ngày 20–22 (R17); sổ hợp đồng","muc_dich":"Đo hiệu quả Marketing: số liệu đo lường, đối soát, báo cáo đúng kỳ cho mọi nhóm thương hiệu; chốt số liệu KPI; phân tích để Quản lý thương hiệu quyết định kênh, ngân sách. Giai đoạn đầu kiêm phần việc của Chuyên viên dữ liệu khách hàng và thị trường đến khi vị trí này có người (mục 6).","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên","phan_dinh_chu_tri_dau_ra":"Đối soát nguồn khách, chi phí, KPI, báo cáo chốt kỳ toàn hệ thống; phát hiện lệch số","phan_dinh_khong_thuoc_trach_nhiem":"Không thay Quảng cáo tối ưu tài khoản; không tự sửa dữ liệu nguồn; không thay Quản lý thương hiệu quyết định ngân sách","phan_dinh_ban_giao_dau_vao":"Nhận số nền tảng từ Quảng cáo, số tiếp đón/HIS và chứng từ, khóa kỳ và bàn giao báo cáo","phan_dinh_kiem_duyet":"Trưởng phòng duyệt bản chốt kỳ; đối soát độc lập"},{"id":"dl-2","ten":"Chuyên viên dữ liệu khách hàng và thị trường","to":"ts","nhom_thuong_hieu":"","chuc_danh":"dl","thay_chinh":"dl-1","du_phong":["qlsps"],"pham_vi":"trung_lap","gio_ke_hoach":"Giai đoạn đầu do Chuyên viên đo lường và đối soát kiêm; có người từ bước Bệnh viện Đa khoa Quốc tế TTH Huế (mục 21)","viec_chung":"Lịch gửi chung, trần tần suất, danh sách loại (R19); CRM; đầu mối Marketing về bảo vệ dữ liệu cá nhân, hồ sơ đánh giá tác động (R18)","muc_dich":"Quản lý dữ liệu khách hàng, chất lượng dữ liệu phần mềm và bảo vệ dữ liệu cá nhân trong hoạt động Marketing; lịch gửi chung, trần tần suất (QC-6); khảo sát, thông tin thị trường. Giai đoạn đầu chưa có người: Chuyên viên đo lường và đối soát kiêm; có người khi CRM vận hành toàn hệ thống hoặc khi vượt 142 giờ 02 quý liên tiếp (mục 6, 21).","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên","trang_thai_kpi":"Chưa có bảng KPI chính thức; phải lập và duyệt trước khi áp dụng với vị trí này.","phan_dinh_chu_tri_dau_ra":"Chủ chất lượng dữ liệu, phân nhóm khách hàng, quyền riêng tư/lịch gửi, khảo sát, yêu cầu nghiệp vụ CRM","phan_dinh_khong_thuoc_trach_nhiem":"Không làm thay Đo lường chốt KPI; không vận hành Contact Center; không thay Số hóa lập trình ứng dụng","phan_dinh_ban_giao_dau_vao":"Nhận dữ liệu hợp lệ, phân nhóm/kiểm trùng, gửi tiêu chí cho Kênh số/Contact Center đúng quyền","phan_dinh_kiem_duyet":"Cấp phụ trách dữ liệu và pháp lý xác nhận điều kiện sử dụng; chưa đủ consent thì chặn"},{"id":"qlsps","ten":"Quản lý sản phẩm số","to":"ts","nhom_thuong_hieu":"","chuc_danh":"qlsps","thay_chinh":"dl-2|chưa có người: Chuyên viên đo lường và đối soát","du_phong":["qc-a|sản phẩm số nhóm 1","qc-b|sản phẩm số nhóm 2","cvt|vai trò Tổ trưởng"],"pham_vi":"trung_lap","gio_ke_hoach":"≈ 117 giờ/tháng, gồm ≈ 19 giờ vai trò Tổ trưởng Tổ Tăng trưởng số (chưa có phần mềm ≈ 24)","viec_chung":"Vai trò Tổ trưởng Tổ Tăng trưởng số; chính sách nền tảng, danh sách bị cấm; website, App TTH, trang đích; mã theo dõi chỉ bật sau đồng ý (R18)","muc_dich":"Chủ nghiệp vụ website tthhealthcare.com, website các chuỗi, App TTH, trang đích; là đầu mối duy nhất của Phòng Marketing với Phòng Số hóa; giữ chính sách nền tảng, danh sách bị cấm (DS-3), tên miền; vai trò Tổ trưởng Tổ Tăng trưởng số (chỉ điều phối).","bao_cao_cho":"Tổ trưởng Tổ Tăng trưởng số phân công, điều phối công việc trong tổ; Chuyên viên trưởng 2 quản lý chuyên môn Truyền thông – Thương hiệu – Tăng trưởng số; Trưởng phòng quyết định vượt quyền. Không phát sinh quyền duyệt mặc định.","ngach":"Chuyên viên chính","phan_dinh_chu_tri_dau_ra":"Chủ nghiệp vụ website/App/trang đích, cấu trúc CMS, SEO tự nhiên, thay đổi sản phẩm số; công bố dữ liệu có cấu trúc mảng 43 sau kiểm độc lập","phan_dinh_khong_thuoc_trach_nhiem":"Không viết lời thay Biên tập; không làm kỹ thuật thay Phòng Số hóa; không xác nhận dữ liệu gốc; không tự có quyền duyệt chỉ vì kiêm Tổ trưởng","phan_dinh_ban_giao_dau_vao":"Nhận nội dung đã duyệt và dữ liệu có xác nhận; gửi yêu cầu kỹ thuật đến Số hóa; nghiệm thu nghiệp vụ, kiểm công bố","phan_dinh_kiem_duyet":"Trưởng phòng/cấp có thẩm quyền duyệt thay đổi lớn; nguồn và người kiểm độc lập duyệt dữ liệu"},{"id":"qlml","ten":"Quản lý mạng lưới Marketing cơ sở theo vùng (01 suất dự kiến, chờ phân vùng)","to":"lanhdao","nhom_thuong_hieu":"","chuc_danh":"qlml","thay_chinh":"tn-a|Trưởng nhóm Marketing cơ sở trong vùng do Chuyên viên trưởng chỉ định (đúng nhóm có việc)","du_phong":["cvt|chỉ điều phối tạm thời theo vùng, khi bảo đảm giới hạn đánh giá"],"pham_vi":"theo_nhom","gio_ke_hoach":"01 suất trong mốc 56 người; chỉ bố trí khi đủ điều kiện R15, được phê duyệt phân vùng/bàn giao. Giới hạn Chuyên viên trưởng 12; Quản lý vùng 15 người trực tiếp.","viec_chung":"Vị trí dự kiến tại mốc đủ 10 bệnh viện, nằm trong 56 người; chỉ nhận tuyến quản lý theo danh sách cơ sở/nhóm, quyết định và biên bản bàn giao có ngày hiệu lực. Chưa có hiệu lực thì không tự giao quyền đánh giá hoặc duyệt.","muc_dich":"Quản lý Trưởng nhóm Marketing cơ sở của một phạm vi nhóm/vùng được phê duyệt bằng danh sách cụ thể; báo cáo Chuyên viên trưởng, tối đa 15 người được đánh giá trực tiếp, không quản lý chồng hai nhóm khi chưa có phê duyệt.","bao_cao_cho":"Chuyên viên trưởng. Trước ngày bàn giao có hiệu lực, không có cấp quản lý mới; tuyến cũ vẫn chịu trách nhiệm.","ngach":"Chuyên viên chính","trang_thai_kpi":"Chưa có bảng KPI chính thức; phải lập và duyệt trước khi áp dụng với vị trí này.","trang_thai_phan_vung":"Chưa chốt danh sách cơ sở/nhóm, chưa có ngày hiệu lực; mẫu thủ tục hoàn thiện trong phụ lục điều kiện.","phan_dinh_chu_tri_dau_ra":"Giám sát Trưởng nhóm Marketing cơ sở trong vùng danh sách đã duyệt; hỗ trợ đánh giá, chuẩn hóa vận hành","phan_dinh_khong_thuoc_trach_nhiem":"Không tự giành chủ Hạng mục của Quản lý thương hiệu; không chỉ đạo chuyên môn ngoài vùng chưa giao","phan_dinh_ban_giao_dau_vao":"Nhận báo cáo cơ sở, chuyển nhu cầu và vấn đề lên Chuyên viên trưởng","phan_dinh_kiem_duyet":"Chuyên viên trưởng phê duyệt phân công theo văn bản/phạm vi"},{"id":"tn-a","ten":"Trưởng nhóm Marketing cơ sở – bệnh viện nhóm 1","to":"coso","nhom_thuong_hieu":"N1","chuc_danh":"tn","thay_chinh":"qhcs","du_phong":["bt-ac","qlth-a"],"pham_vi":"nhom_1","gio_ke_hoach":"Theo danh mục việc, định mức mục 6; đo ở thí điểm","viec_chung":"Không","muc_dich":"Đầu mối Marketing tại bệnh viện đa khoa TTH Hospital: làm việc với khoa phòng, tổ chức việc tại chỗ, cung cấp đầu vào cho Tổng công ty, quản lý trực tiếp 02 thành viên Marketing tại cơ sở. Bệnh viện 02 người: kiêm nhiệm toàn bộ nhiệm vụ truyền thông cơ sở về biển bảng, màn hình và phát thanh; không giao sang Media.","bao_cao_cho":"Quản lý trực tiếp nhân sự Tổ Marketing tại bệnh viện theo phân cấp của cơ sở; Chuyên viên trưởng 1 phụ trách chuẩn sản xuất và tổng hợp nghiệp vụ cơ sở; Chuyên viên trưởng 2 phụ trách chuẩn truyền thông, thương hiệu, tăng trưởng số theo tuyến ngành dọc; Trưởng phòng điều phối khi có mâu thuẫn. Chấm công và nội quy theo cơ sở.","ngach":"Chuyên viên cơ sở; phụ cấp trách nhiệm Trưởng nhóm (mục 24.5)","phan_dinh_chu_tri_dau_ra":"Tiếp nhận yêu cầu khoa phòng, lấy xác nhận nguồn, điều phối nhân sự cơ sở; tin Facebook bệnh viện trong danh mục; kiêm vận hành biển bảng/màn hình/phát thanh nếu cơ sở 02 người","phan_dinh_khong_thuoc_trach_nhiem":"Không tự đổi chiến lược/nhận diện/chiến dịch TCT, không tự duyệt bài vượt danh mục; không tự sửa dữ liệu giá/chứng chỉ; chỉ có quyền đăng tin V1 thuộc danh mục Facebook bệnh viện khi có quyền đăng hợp lệ, không tự đăng dịch vụ/giá/khuyến mại/ca bệnh lên bất kỳ kênh nào; không quản trị các kênh khác.","phan_dinh_ban_giao_dau_vao":"Chuyển thông tin đã xác nhận cho TCT theo một luồng; nhận kế hoạch đã duyệt; trả ảnh, nhật ký triển khai","phan_dinh_kiem_duyet":"Ban Giám đốc cơ sở xác nhận thông tin gốc; TCT/cấp duyệt nội dung theo phân cấp"},{"id":"tn-b","ten":"Trưởng nhóm Marketing cơ sở – bệnh viện nhóm 2 (kiêm nhiệm truyền thông cơ sở)","to":"coso","nhom_thuong_hieu":"N2","chuc_danh":"tn","thay_chinh":"mdcs-b","du_phong":["bt-b","qlth-bc"],"pham_vi":"nhom_2","gio_ke_hoach":"Theo danh mục việc, định mức mục 6; đo ở thí điểm","viec_chung":"Không","muc_dich":"Đầu mối Marketing tại bệnh viện nhóm 2: làm việc với khoa phòng, tổ chức việc tại chỗ, cung cấp đầu vào cho Tổng công ty; kiêm truyền thông cơ sở; quản lý trực tiếp 01 thành viên Marketing tại cơ sở. Bệnh viện 02 người: kiêm nhiệm toàn bộ nhiệm vụ truyền thông cơ sở về biển bảng, màn hình và phát thanh; không giao sang Media; đồng thời kiêm khảo sát, điều phối decor lễ/Tết, kiểm tra hiện trạng biển bảng hằng tháng và chụp ảnh nghiệm thu tại cơ sở 02 người.","bao_cao_cho":"Quản lý trực tiếp nhân sự Tổ Marketing tại bệnh viện theo phân cấp của cơ sở; Chuyên viên trưởng 1 phụ trách chuẩn sản xuất và tổng hợp nghiệp vụ cơ sở; Chuyên viên trưởng 2 phụ trách chuẩn truyền thông, thương hiệu, tăng trưởng số theo tuyến ngành dọc; Trưởng phòng điều phối khi có mâu thuẫn. Chấm công và nội quy theo cơ sở.","ngach":"Chuyên viên cơ sở; phụ cấp trách nhiệm Trưởng nhóm (mục 24.5)","phan_dinh_chu_tri_dau_ra":"Điều phối nguồn khoa phòng, tổ chức hiện trường và quan hệ cộng đồng; kiểm/vận hành biển bảng, màn hình, phát thanh tại cơ sở 02 người; kiêm triển khai decor, theo dõi hiện trạng biển bảng theo tháng, ảnh nghiệm thu và báo cáo theo phân quyền","phan_dinh_khong_thuoc_trach_nhiem":"Không chuyển việc kiểm định kỳ thiết bị cho Media; không thay chuyên viên Truyền thông TCT quyết định lịch/hợp đồng hệ thống; chỉ có quyền đăng tin V1 thuộc danh mục Facebook bệnh viện khi có quyền đăng hợp lệ, không tự đăng dịch vụ/giá/khuyến mại/ca bệnh lên bất kỳ kênh nào; không quản trị các kênh khác.","phan_dinh_ban_giao_dau_vao":"Bàn giao thông tin đã xác nhận, tư liệu, nhật ký nghiệm thu cho TCT nhóm 2","phan_dinh_kiem_duyet":"Ban Giám đốc cơ sở xác nhận thực tế; TCT nghiệm thu sản phẩm/lịch"},{"id":"mdcs-a","ten":"Chuyên viên Marketing cơ sở – media, bệnh viện nhóm 1","to":"coso","nhom_thuong_hieu":"N1","chuc_danh":"mdcs","thay_chinh":"tn-a","du_phong":["Chuyên viên Marketing cơ sở – media bệnh viện cùng nhóm gần nhất","md-ac"],"pham_vi":"nhom_1","gio_ke_hoach":"Ngưỡng kế hoạch 142 giờ/người/tháng; giờ công thực đo theo từng đầu ra chưa có, không kết luận có giờ dư","viec_chung":"Không; Dựng video V2 và V3 của chính bệnh viện theo bộ mẫu dựng của nhóm (B-7) và chuyển Chuyên viên Media TCT đúng nhóm kiểm kỹ thuật bản dựng; không tự dựng video chiến dịch V4 (phiếu chốt điểm 12, định hướng 11/11/2026).","muc_dich":"Ghi hình, chụp ảnh tại chỗ cho sản phẩm của Tổng công ty tại bệnh viện nhóm 1; hỗ trợ bệnh viện nhóm 1 lân cận. Không phụ trách biển bảng, màn hình, phát thanh tại cơ sở; chỉ hỗ trợ quay, chụp, thu âm theo yêu cầu sản xuất. Đồng thời chủ trì quay/dựng V1, V2 và V3 theo mẫu B-7 đã được giao, không chỉ làm clip tin trong ngày. Media TCT đúng nhóm kiểm bản dựng và trực tiếp hậu kỳ V3 phức tạp/V4.","bao_cao_cho":"Tổ trưởng Marketing tại bệnh viện trực tiếp giao việc; Chuyên viên trưởng 1 hướng dẫn, kiểm chuẩn chuyên môn Media từ Tổng công ty; chấm công, nội quy do cơ sở.","ngach":"Chuyên viên cơ sở","phan_dinh_chu_tri_dau_ra":"Quay, chụp, thu thập tư liệu hiện trường; cắt dựng V1 và sản xuất V2/V3 thuộc mẫu B-7 theo kịch bản lời đã có của Biên tập đúng nhóm và phân cảnh do Media TCT cung cấp; lưu nguồn, giấy đồng ý và giờ công; V3 vượt mẫu và V4 chuyển Media TCT.","phan_dinh_khong_thuoc_trach_nhiem":"Không viết kịch bản lời, không phê duyệt lời/chuyên môn/phát hành; không chủ trì kiểm biển bảng, vận hành màn hình, phát thanh hoặc chụp ảnh nghiệp vụ nghiệm thu công trình; không tự làm V4.","phan_dinh_ban_giao_dau_vao":"Nhận lịch/kịch bản qua cổng; phối hợp bác sĩ, nhân vật và địa điểm; giao tư liệu gốc, căn cứ sử dụng hình ảnh, bản dựng V2/V3 và nhật ký giờ công riêng cho TCT.","phan_dinh_kiem_duyet":"Media TCT đúng nhóm kiểm kỹ thuật bản dựng; bác sĩ/đơn vị chuyên môn xác nhận y khoa; người có thẩm quyền riêng duyệt phát hành. Không tự duyệt sản phẩm mình làm."},{"id":"mdcs-b","ten":"Chuyên viên Marketing cơ sở – media, bệnh viện nhóm 2","to":"coso","nhom_thuong_hieu":"N2","chuc_danh":"mdcs","thay_chinh":"tn-b","du_phong":["Chuyên viên Marketing cơ sở – media bệnh viện cùng nhóm gần nhất","md-b"],"pham_vi":"nhom_2","gio_ke_hoach":"Ngưỡng kế hoạch 142 giờ/người/tháng; giờ công thực đo theo từng đầu ra chưa có, không kết luận có giờ dư","viec_chung":"Không; Dựng video V2 và V3 của chính bệnh viện theo bộ mẫu dựng của nhóm (B-7) và chuyển Chuyên viên Media TCT đúng nhóm kiểm kỹ thuật bản dựng; không tự dựng video chiến dịch V4 (phiếu chốt điểm 12, định hướng 11/11/2026).","muc_dich":"Ghi hình, chụp ảnh tại chỗ cho sản phẩm của Tổng công ty tại bệnh viện nhóm 2; người thay chính của Trưởng nhóm. Không phụ trách biển bảng, màn hình, phát thanh tại cơ sở; chỉ hỗ trợ quay, chụp, thu âm theo yêu cầu sản xuất. Đồng thời chủ trì quay/dựng V1, V2 và V3 theo mẫu B-7 đã được giao, không chỉ làm clip tin trong ngày. Media TCT đúng nhóm kiểm bản dựng và trực tiếp hậu kỳ V3 phức tạp/V4.","bao_cao_cho":"Tổ trưởng Marketing tại bệnh viện trực tiếp giao việc; Chuyên viên trưởng 1 hướng dẫn, kiểm chuẩn chuyên môn Media từ Tổng công ty; chấm công, nội quy do cơ sở.","ngach":"Chuyên viên cơ sở","phan_dinh_chu_tri_dau_ra":"Quay, chụp, thu thập tư liệu hiện trường; cắt dựng V1 và sản xuất V2/V3 thuộc mẫu B-7 theo kịch bản lời đã có của Biên tập đúng nhóm và phân cảnh do Media TCT cung cấp; lưu nguồn, giấy đồng ý và giờ công; V3 vượt mẫu và V4 chuyển Media TCT.","phan_dinh_khong_thuoc_trach_nhiem":"Không viết kịch bản lời, không phê duyệt lời/chuyên môn/phát hành; không chủ trì kiểm biển bảng, vận hành màn hình, phát thanh hoặc chụp ảnh nghiệp vụ nghiệm thu công trình; không tự làm V4.","phan_dinh_ban_giao_dau_vao":"Nhận lịch/kịch bản qua cổng; phối hợp bác sĩ, nhân vật và địa điểm; giao tư liệu gốc, căn cứ sử dụng hình ảnh, bản dựng V2/V3 và nhật ký giờ công riêng cho TCT.","phan_dinh_kiem_duyet":"Media TCT đúng nhóm kiểm kỹ thuật bản dựng; bác sĩ/đơn vị chuyên môn xác nhận y khoa; người có thẩm quyền riêng duyệt phát hành. Không tự duyệt sản phẩm mình làm."},{"id":"qhcs","ten":"Chuyên viên Marketing cơ sở – truyền thông, bệnh viện nhóm 1","to":"coso","nhom_thuong_hieu":"N1","chuc_danh":"qhcs","thay_chinh":"tn-a","du_phong":["cvtt-a"],"pham_vi":"nhom_1","gio_ke_hoach":"Theo danh mục việc, định mức mục 6; đo ở thí điểm","viec_chung":"Không","muc_dich":"Quan hệ đối tác, cộng đồng, nguồn giới thiệu người bệnh và sự kiện Marketing tại bệnh viện đa khoa nhóm 1; chủ trì khảo sát, tổ chức triển khai trang trí lễ, Tết và sự kiện Marketing ở hiện trường theo thiết kế đã duyệt; vận hành lịch phát màn hình và phát thanh nội viện; kiểm tra biển bảng hằng tuần, tổng hợp hiện trạng hằng tháng, báo hỏng trong ngày; trực tiếp chụp ảnh xác nhận hiện trạng, ảnh nghiệm thu và gửi hồ sơ, số đo cho TCT. Không duyệt thiết kế, chi phí hoặc nghiệm thu tài chính.","bao_cao_cho":"Tổ trưởng Marketing tại bệnh viện trực tiếp giao việc và quản lý nhân sự; Chuyên viên trưởng 2 hướng dẫn, kiểm chuẩn nghiệp vụ truyền thông/OOH/phát thanh/màn hình nội viện từ TCT; chấm công, nội quy do cơ sở.","ngach":"Chuyên viên cơ sở","phan_dinh_chu_tri_dau_ra":"Chủ trì tổ chức sự kiện và quan hệ cộng đồng tại cơ sở; kiểm tra hiện trạng biển bảng hằng tuần, tổng hợp hằng tháng, báo hỏng trong ngày, chụp ảnh và số đo, ảnh nghiệm thu thi công/tuân thủ nhận diện; trực tiếp vận hành màn hình và phát thanh theo lịch đã duyệt, ghi nhật ký. Cơ sở 02 người do Trưởng nhóm kiêm nhiệm.","phan_dinh_khong_thuoc_trach_nhiem":"Không thiết kế mẫu, không viết kịch bản phát thanh chính thức, không ký hợp đồng truyền thông hệ thống, không duyệt lịch phát mới, ngân sách hoặc nghiệm thu tài chính; không thay Phòng Nhân lực/Công đoàn chủ trì các hoạt động nội bộ ngoài Marketing.; không viết lời, thiết kế, đăng bài/quản trị kênh số hoặc có quyền phê duyệt phát hành chỉ vì đang vận hành thiết bị phát.","phan_dinh_ban_giao_dau_vao":"Nhận lịch/mẫu từ Chuyên viên Truyền thông TCT đúng nhóm; bàn giao báo cáo kiểm tra biển bảng hằng tháng, ảnh hiện trạng, ảnh nghiệm thu trang trí, màn hình, phát thanh và sự kiện cho Truyền thông TCT và Thiết kế ngoại tuyến.","phan_dinh_kiem_duyet":"Ban Giám đốc cơ sở duyệt phần địa phương; TCT duyệt theo phạm vi/mẫu"},{"id":"dmpk","ten":"Đầu mối kiêm nhiệm tại phòng khám (nhóm 1)","to":"coso","nhom_thuong_hieu":"N1","chuc_danh":"dmpk","thay_chinh":"Người dự phòng do phòng khám cử","du_phong":["md-ac|ghi hình theo lịch, kết hợp chuyến","qlth-a|thông tin"],"pham_vi":"nhom_1","gio_ke_hoach":"Kiêm nhiệm tại phòng khám","viec_chung":"Không","muc_dich":"Cung cấp ảnh, thông tin và hỗ trợ việc tại chỗ cho Marketing tại phòng khám nhóm 1 (TTH Clinic).","bao_cao_cho":"Phòng khám TTH Clinic quản lý công việc chính; Quản lý thương hiệu Nhóm 1 xác định mục tiêu, Chuyên viên trưởng 1/2 hướng dẫn theo từng loại đầu ra Marketing. Không thuộc thương hiệu Nhóm 2.","ngach":"Phụ cấp kiêm nhiệm theo xác nhận phần việc Marketing (mục 24.5)","trang_thai_kpi":"Chưa có bảng KPI chính thức; phải lập và duyệt trước khi áp dụng với vị trí này.","phan_dinh_chu_tri_dau_ra":"Nhận thông tin, ảnh, lịch, sự kiện, nhu cầu tại phòng khám; chuyển một đầu mối về Marketing TCT","phan_dinh_khong_thuoc_trach_nhiem":"Không là bộ máy marketing độc lập, không tự đăng/sửa dữ liệu có điều kiện, không tự phát hành sản phẩm khi thiếu duyệt","phan_dinh_ban_giao_dau_vao":"Gửi nguồn có xác nhận của phòng khám cho Quản lý thương hiệu nhóm 1/Chuyên viên trưởng","phan_dinh_kiem_duyet":"Đơn vị chủ dữ liệu/phòng khám xác nhận; TCT duyệt sản phẩm theo quy trình"}],"vai_tro":[{"id":"tt-nd","ten":"Tổ trưởng Tổ Nội dung và Sáng tạo","vi_tri":"bt-ac","giu_tam":"bt-ac","to":"nd","viec":"Điều phối 05 người nhóm 1 (Chuyên viên biên tập nhóm 1 còn lại, Chuyên viên thiết kế nhóm 1, Chuyên viên media nhóm 1): yêu cầu cần Tổ trưởng xử lý trong 04 giờ làm việc; xếp lịch sản xuất, lịch ghi hình, xử lý trùng lịch của người nhóm 1; duyệt nghỉ; đánh giá theo số liệu; báo cáo tổ. 03 người nhóm 2 (Chuyên viên biên tập, thiết kế, media nhóm 2), Chuyên viên thiết kế ngoại tuyến, lịch thiết bị media dùng chung, cho phép làm thay có thời hạn (RC-1), tranh chấp phân loại: Chuyên viên trưởng 1 (≈ 13 giờ/tháng). Không duyệt nội dung, không duyệt phát hành","gio":"≈ 17 giờ/tháng (phần người nhóm 2, Chuyên viên thiết kế ngoại tuyến: Chuyên viên trưởng ≈ 13 giờ/tháng)","ghi_chu":"Người giữ vai trò: Chuyên viên biên tập nhóm 1 do Trưởng phòng chỉ định (chốt 14/11/2026); Phương án người thay chờ quyết định nhân sự, không tự kích hoạt quyền.","dieu_kien_giu_tam":"Chỉ người biên tập nhóm 1 còn lại (không phải người đang giữ Tổ trưởng); Trưởng phòng phải chỉ định cá nhân bằng văn bản, nêu ngày hiệu lực và phạm vi nhóm 1. Không tự động cấp quyền."},{"id":"tt-ts","ten":"Tổ trưởng Tổ Tăng trưởng số","vi_tri":"qlsps","giu_tam":"cvt-2","to":"ts","viec":"Điều phối Chuyên viên quảng cáo và kênh số hai nhóm: yêu cầu cần Tổ trưởng xử lý trong 04 giờ làm việc; xếp lịch; duyệt nghỉ; đánh giá theo số liệu; báo cáo tổ; cho phép làm thay chéo nhóm có thời hạn. Không duyệt nội dung, lịch đăng, chính sách nền tảng","gio":"≈ 19 giờ/tháng (chưa có phần mềm ≈ 24)","canh_bao_nguoi_thay":"Chỉ Chuyên viên trưởng 2 được giao giữ tạm khi có ủy quyền riêng và đúng giới hạn; không mặc nhiên có quyền ký, duyệt phát hành hoặc chi."},{"id":"tt-th","ten":"Tổ trưởng Tổ Truyền thông và Thương hiệu","vi_tri":"qlth-bc","giu_tam":"qlth-bc","to":"th","viec":"Quản lý thương hiệu nhóm 2 kiêm nhiệm, điều phối tiến độ và khối lượng của 04 vị trí tổ (Quản lý thương hiệu nhóm 1/2; Chuyên viên truyền thông nhóm 1/2). Chỉ có quyền điều phối công việc của tổ; không tự phát sinh quyền duyệt sản phẩm, ngân sách, nghỉ phép, đánh giá cuối hay thay đổi nhân sự.","gio":"Trong quỹ giờ kiêm nhiệm của Quản lý thương hiệu nhóm 2; không tăng định biên.","ghi_chu":"Chuyên viên trưởng 2 phụ trách quản lý chuyên môn của tổ; Tổ trưởng kiêm nhiệm phân công thường ngày. Quyền duyệt phát hành, chi phí tách riêng."}],"don_vi":[{"id":"mkt-tct","ten":"Phòng Marketing Tổng công ty","loai":"marketing"},{"id":"mkt-coso","ten":"Marketing cơ sở","loai":"marketing"},{"id":"btgd","ten":"Ban Tổng Giám đốc","loai":"lanh_dao"},{"id":"bgd-coso","ten":"Ban Giám đốc cơ sở","loai":"co_so"},{"id":"gd-coso","ten":"Giám đốc cơ sở","loai":"co_so"},{"id":"khoa-phong","ten":"Khoa phòng","loai":"co_so"},{"id":"bac-si","ten":"Bác sĩ","loai":"co_so"},{"id":"tiep-don","ten":"Bộ phận tiếp đón","loai":"co_so"},{"id":"xu-ly-phan-anh","ten":"Bộ phận tiếp nhận, xử lý phản ánh của cơ sở","loai":"co_so"},{"id":"cc","ten":"Contact Center","loai":"contact_center"},{"id":"so-hoa","ten":"Phòng Số hóa","loai":"khac"},{"id":"cnnvy","ten":"Phòng Công nghệ – Nghiệp vụ Y","loai":"khac"},{"id":"nhan-luc","ten":"Phòng Nhân lực","loai":"khac"},{"id":"tuyen-dung","ten":"Tổ Tuyển dụng (Phòng Nhân lực)","loai":"khac"},{"id":"qlcl","ten":"Phòng Quản lý chất lượng","loai":"khac"},{"id":"phap-che","ten":"Bộ phận pháp chế","loai":"khac"},{"id":"hcqt","ten":"Phòng Hành chính quản trị","loai":"khac"},{"id":"ke-toan","ten":"Kế toán","loai":"khac"},{"id":"mua-sam","ten":"Phòng Tài chính – Kế hoạch (đơn vị chủ trì mua sắm)","loai":"khac"},{"id":"winmed","ten":"Công ty Cổ phần Winmed Việt Nam","loai":"khac"},{"id":"ctxh","ten":"Tổ Công tác xã hội","loai":"khac"},{"id":"don-vi-ban","ten":"Đơn vị bán, ký hợp đồng khám sức khỏe doanh nghiệp","loai":"khac"},{"id":"don-vi-ky-ket","ten":"Đơn vị ký kết đối tác cấp hệ thống","loai":"khac"},{"id":"don-vi-kinh-doanh","ten":"Đơn vị kinh doanh","loai":"khac"},{"id":"don-vi-chuyen-mon","ten":"Đơn vị chuyên môn","loai":"khac"},{"id":"khach","ten":"Khách hàng","loai":"ben_ngoai"},{"id":"nha-truong","ten":"Nhà trường","loai":"ben_ngoai"},{"id":"tue-duc-thien","ten":"Công ty TNHH Tuệ Đức Thiện","loai":"khac"},{"id":"nha-cung-cap","ten":"Nhà cung cấp, đơn vị thi công đã phê duyệt","loai":"ben_ngoai"},{"id":"bao-chi","ten":"Cơ quan báo chí","loai":"ben_ngoai"},{"id":"co-so-y-te-doi-tac","ten":"Cơ sở y tế đối tác, tuyến dưới","loai":"ben_ngoai"},{"id":"co-quan-nha-nuoc","ten":"Cơ quan nhà nước có thẩm quyền","loai":"ben_ngoai"},{"id":"thu-ky-btgd","ten":"Thư ký Ban Tổng Giám đốc mảng Marketing","loai":"lanh_dao"},{"id":"ptgd-tc","ten":"Phó Tổng Giám đốc mảng tài chính","loai":"lanh_dao"},{"id":"to-mkt-vinh","ten":"Tổ Marketing Bệnh viện Đa khoa TTH Vinh","loai":"to_marketing_benh_vien","nhom":"N1"},{"id":"to-mkt-hatinh","ten":"Tổ Marketing Bệnh viện Đa khoa TTH Hà Tĩnh","loai":"to_marketing_benh_vien","nhom":"N1"},{"id":"to-mkt-quangbinh","ten":"Tổ Marketing Bệnh viện Đa khoa TTH Quảng Bình","loai":"to_marketing_benh_vien","nhom":"N1"},{"id":"to-mkt-nguyenphuc","ten":"Tổ Marketing Bệnh viện Y học cổ truyền Nguyên Phúc","loai":"to_marketing_benh_vien","nhom":"N2"},{"id":"to-mkt-thaithuonghoang","ten":"Tổ Marketing Bệnh viện Răng Hàm Mặt và Phẫu thuật tạo hình thẩm mỹ Thái Thượng Hoàng","loai":"to_marketing_benh_vien","nhom":"N2"}],"muc_tieu_chien_luoc":[{"id":"MT1","ten":"Tăng trưởng và phát triển thị trường"},{"id":"MT2","ten":"Thương hiệu và niềm tin"},{"id":"MT3","ten":"Giá trị và quan hệ vòng đời khách hàng"},{"id":"MT4","ten":"Hệ sinh thái, cộng đồng và quan hệ chiến lược"},{"id":"MT5","ten":"Thương hiệu nhà tuyển dụng và gắn kết nội bộ"},{"id":"MT6","ten":"Năng lực Marketing và nền tảng quản trị"}],"kpi":[{"id":"KPI-01","ten":"Khách sử dụng dịch vụ","muc_tieu":"MT1","cong_thuc":"Đếm khách duy nhất sử dụng dịch vụ và được quy thuộc cho Hạng mục theo quy tắc đối soát","don_vi_tinh":"Khách","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS, CRM; đối soát của cơ sở","dieu_kien_dung":"Hạng mục có kết quả cần đạt là tạo khách sử dụng dịch vụ","quy_tac":"Không thay bằng số Lead, số đặt lịch","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-02","ten":"Doanh thu quy thuộc","muc_tieu":"MT1","cong_thuc":"Tổng doanh thu đã xác nhận của khách, dịch vụ được quy thuộc cho Hạng mục trong thời gian ghi nhận","don_vi_tinh":"Đồng","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS; kế toán; CRM đối soát","dieu_kien_dung":"Chỉ dùng khi có căn cứ quy thuộc","quy_tac":"Không phải tổng doanh thu của cơ sở; không suy ra từ lượt tiếp cận, lượt truy cập","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-03","ten":"Tỷ lệ Lead hợp lệ thành khách","muc_tieu":"MT1","cong_thuc":"Khách sử dụng dịch vụ quy thuộc ÷ Lead hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM, Contact Center; HIS","dieu_kien_dung":"Có cùng lúc số Lead hợp lệ và số khách sử dụng dịch vụ","quy_tac":"Lead hợp lệ theo tiêu chí chuẩn","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-04","ten":"Lead hợp lệ","muc_tieu":"MT1","cong_thuc":"Đếm Lead duy nhất đạt tiêu chí Lead hợp lệ, đủ điều kiện chuyển tư vấn, chăm sóc","don_vi_tinh":"Lead hợp lệ","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM, Contact Center","dieu_kien_dung":"Hạng mục có hoạt động tạo Lead","quy_tac":"Không dùng số tin nhắn, bình luận thô","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-05","ten":"Đặt lịch","muc_tieu":"MT1","cong_thuc":"Đếm lịch hẹn hợp lệ, đã xác nhận, quy thuộc cho Hạng mục","don_vi_tinh":"Lịch","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM; App TTH; website; HIS","dieu_kien_dung":"Hạng mục có bước đặt lịch","quy_tac":"Có quy tắc xử lý lịch hủy, lịch trùng","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-06","ten":"Chi phí trên Lead hợp lệ","muc_tieu":"MT1","cong_thuc":"Chi phí quảng cáo ÷ Lead hợp lệ từ quảng cáo","don_vi_tinh":"Đồng/Lead hợp lệ","chieu":"Càng thấp càng tốt","nguon_so_lieu":"Nền tảng quảng cáo; CRM đối soát","dieu_kien_dung":"Có quảng cáo trả phí, truy được Lead hợp lệ","quy_tac":"Chỉ tính chi phí quảng cáo; chỉ để chẩn đoán","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-07","ten":"Chi phí trên khách","muc_tieu":"MT1","cong_thuc":"Tổng chi của Hạng mục ÷ khách sử dụng dịch vụ quy thuộc","don_vi_tinh":"Đồng/khách","chieu":"Càng thấp càng tốt","nguon_so_lieu":"Phần mềm (chi Hạng mục); HIS","dieu_kien_dung":"Hạng mục có kết quả cần đạt là tạo khách","quy_tac":"Không áp dụng cho tuyển dụng, dự án nền tảng","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-08","ten":"Nhận biết thương hiệu","muc_tieu":"MT2","cong_thuc":"Số người nhận biết thương hiệu ÷ tổng mẫu hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Khảo sát, nghiên cứu thương hiệu","dieu_kien_dung":"Có khảo sát nhận biết thương hiệu theo năm (thuê đơn vị bên ngoài có điều kiện, mục 26); chưa có khảo sát: theo quy tắc chung cho KPI chưa đo được","quy_tac":"Không thay bằng lượt tiếp cận; giữ cùng phương pháp giữa các kỳ","ky_cham":"Năm","can_cu":"mục 12.5"},{"id":"KPI-09","ten":"Mức độ cân nhắc, lựa chọn thương hiệu","muc_tieu":"MT2","cong_thuc":"Số người cân nhắc, lựa chọn thương hiệu ÷ tổng mẫu hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Khảo sát, nghiên cứu thương hiệu","dieu_kien_dung":"Có khảo sát nhận biết thương hiệu theo năm (thuê đơn vị bên ngoài có điều kiện, mục 26); chưa có khảo sát: theo quy tắc chung cho KPI chưa đo được","quy_tac":"Giữ cùng phương pháp giữa các kỳ","ky_cham":"Năm","can_cu":"mục 12.5"},{"id":"KPI-10","ten":"Tỷ lệ đánh giá tích cực","muc_tieu":"MT2","cong_thuc":"Đánh giá công khai tích cực hợp lệ ÷ tổng đánh giá hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Trang doanh nghiệp trên Google; nền tảng đánh giá","dieu_kien_dung":"Có hoạt động quản lý đánh giá","quy_tac":"Ngưỡng tích cực thống nhất trước khi đo","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-11","ten":"Tăng trưởng tìm kiếm thương hiệu","muc_tieu":"MT2","cong_thuc":"(Lượt tìm kiếm có từ khóa thương hiệu kỳ này − kỳ gốc) ÷ kỳ gốc × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Google Search Console; công cụ SEO thống nhất","dieu_kien_dung":"Có kỳ gốc so sánh hợp lệ","quy_tac":"Không so giữa các nguồn, cách đo khác nhau","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-12","ten":"Điểm đánh giá trung bình","muc_tieu":"MT2","cong_thuc":"Tổng điểm đánh giá ÷ số đánh giá hợp lệ","don_vi_tinh":"Điểm (thang 5)","chieu":"Càng cao càng tốt","nguon_so_lieu":"Trang doanh nghiệp trên Google; nền tảng đánh giá","dieu_kien_dung":"Có đủ số đánh giá tin cậy","quy_tac":"Ghi rõ thang điểm","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-13","ten":"Bài, đề cập báo chí không trả phí đạt chuẩn","muc_tieu":"MT2","cong_thuc":"Đếm bài, đề cập không trả phí đạt tiêu chí nguồn, nội dung, thời gian","don_vi_tinh":"Bài","chieu":"Càng cao càng tốt","nguon_so_lieu":"Theo dõi báo chí; báo cáo quan hệ công chúng","dieu_kien_dung":"Hạng mục có kết quả cần đạt tương ứng, hoặc chỉ tiêu quý của vị trí","quy_tac":"Không tính bài trả phí","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-14","ten":"Tỷ lệ tuân thủ thương hiệu","muc_tieu":"MT2","cong_thuc":"Điểm chạm đạt chuẩn ÷ tổng điểm chạm được kiểm tra × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Biên bản kiểm tra tuân thủ nhận diện của Chuyên viên thiết kế ngoại tuyến; phần mềm","dieu_kien_dung":"Hạng mục có kết quả cần đạt tương ứng, hoặc chỉ tiêu quý của vị trí","quy_tac":"Dùng một mẫu kiểm tra thống nhất","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-15","ten":"Tỷ lệ tái sử dụng dịch vụ","muc_tieu":"MT3","cong_thuc":"Khách quay lại sử dụng dịch vụ ÷ khách đủ điều kiện theo dõi × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS; CRM","dieu_kien_dung":"Có định nghĩa nhóm khách, thời gian tái sử dụng","quy_tac":"Không dùng tổng lượt khám làm mẫu số","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-16","ten":"Khách sử dụng thêm dịch vụ","muc_tieu":"MT3","cong_thuc":"Đếm khách hiện hữu duy nhất sử dụng thêm dịch vụ khác, quy thuộc hoạt động chăm sóc","don_vi_tinh":"Khách","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM; HIS","dieu_kien_dung":"Có chương trình chăm sóc, sử dụng thêm dịch vụ","quy_tac":"Loại trừ khách trùng","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-17","ten":"Doanh thu từ khách hiện hữu","muc_tieu":"MT3","cong_thuc":"Tổng doanh thu quy thuộc từ nhóm khách hiện hữu được chăm sóc trong kỳ","don_vi_tinh":"Đồng","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS; kế toán; CRM","dieu_kien_dung":"Có định nghĩa khách hiện hữu, căn cứ quy thuộc","quy_tac":"Không lấy toàn bộ doanh thu khách cũ nếu không gắn chương trình","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-18","ten":"Tỷ lệ phản hồi đúng thời hạn","muc_tieu":"MT3","cong_thuc":"Tương tác phản hồi đúng thời hạn chuẩn ÷ tổng tương tác thuộc thời hạn chuẩn × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Contact Center; CRM","dieu_kien_dung":"Có thời hạn phản hồi chuẩn theo kênh, loại yêu cầu","quy_tac":"Loại trừ tin rác, tin tự động","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-19","ten":"Tỷ lệ chăm sóc thành đặt lịch","muc_tieu":"MT3","cong_thuc":"Đặt lịch từ nhóm được chăm sóc ÷ tổng khách, Lead đủ điều kiện chăm sóc × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM, Contact Center; HIS","dieu_kien_dung":"Có chương trình chăm sóc","quy_tac":"Mẫu số là nhóm đủ điều kiện, không phải toàn bộ dữ liệu","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-20","ten":"NPS","muc_tieu":"MT3","ghi_chu":"Chờ chốt phân vai với Phòng Quản lý chất lượng (mục 28, số 30)","cong_thuc":"% khách chấm 9–10 trừ % khách chấm 0–6 trên thang 0–10","don_vi_tinh":"Điểm NPS","chieu":"Càng cao càng tốt","nguon_so_lieu":"Khảo sát NPS; CRM","dieu_kien_dung":"Có khảo sát theo thang 0–10","quy_tac":"Không quy đổi thành % hoàn thành khi chưa đặt chỉ tiêu","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-21","ten":"CSAT","muc_tieu":"MT3","ghi_chu":"Chờ chốt phân vai với Phòng Quản lý chất lượng (mục 28, số 30)","cong_thuc":"Phản hồi hài lòng theo ngưỡng ÷ tổng phản hồi hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Khảo sát hài lòng; CRM","dieu_kien_dung":"Có câu hỏi, thang đo thống nhất","quy_tac":"Không trộn các thang đo khác nhau","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-22","ten":"Đối tác hoạt động","muc_tieu":"MT4","cong_thuc":"Đếm đối tác có ít nhất 01 hoạt động hợp tác đạt điều kiện xác nhận trong kỳ","don_vi_tinh":"Đối tác","chieu":"Càng cao càng tốt","nguon_so_lieu":"Danh sách đối tác; biên bản; CRM","dieu_kien_dung":"Hạng mục phát triển đối tác, nguồn giới thiệu","quy_tac":"Không tính đối tác chỉ ký, chưa kích hoạt","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-23","ten":"Khách từ đối tác, nguồn giới thiệu","muc_tieu":"MT4","cong_thuc":"Đếm khách duy nhất sử dụng dịch vụ có nguồn đối tác, nguồn giới thiệu hợp lệ","don_vi_tinh":"Khách","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM; HIS; nguồn khách đối tác","dieu_kien_dung":"Có cách ghi nhận nguồn đối tác","quy_tac":"Nguồn xác định trước, đối soát được","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-24","ten":"Đối tượng cộng đồng được phục vụ","muc_tieu":"MT4","cong_thuc":"Đếm người duy nhất được sàng lọc, tư vấn, phục vụ theo điều kiện của chương trình","don_vi_tinh":"Người","chieu":"Càng cao càng tốt","nguon_so_lieu":"Danh sách sự kiện, chương trình","dieu_kien_dung":"Hạng mục có kết quả cần đạt là cộng đồng","quy_tac":"Không thay bằng lượt tiếp cận truyền thông","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-25","ten":"Đối tác ký, kích hoạt mới","muc_tieu":"MT4","cong_thuc":"Đếm đối tác mới đạt điều kiện ký kết hoặc kích hoạt trong kỳ","don_vi_tinh":"Đối tác","chieu":"Càng cao càng tốt","nguon_so_lieu":"Hợp đồng; biên bản ghi nhớ; CRM","dieu_kien_dung":"Có kết quả cần đạt là mở rộng mạng lưới","quy_tac":"Thống nhất trước điều kiện kích hoạt","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-26","ten":"Lead hợp lệ từ đối tác, nguồn giới thiệu","muc_tieu":"MT4","cong_thuc":"Đếm Lead hợp lệ duy nhất có nguồn đối tác, nguồn giới thiệu đã xác nhận","don_vi_tinh":"Lead hợp lệ","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM; nguồn khách đối tác","dieu_kien_dung":"Có chương trình tạo nguồn từ đối tác","quy_tac":"Không dùng danh sách thô chưa xác minh","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-27","ten":"Doanh thu quy thuộc từ đối tác, nguồn giới thiệu","muc_tieu":"MT4","cong_thuc":"Tổng doanh thu đã xác nhận của khách quy thuộc nguồn đối tác, nguồn giới thiệu","don_vi_tinh":"Đồng","chieu":"Càng cao càng tốt","nguon_so_lieu":"HIS; kế toán; CRM","dieu_kien_dung":"Có căn cứ quy thuộc đối tác","quy_tac":"Không bắt buộc với hoạt động cộng đồng thuần túy","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-28","ten":"Tỷ lệ đối tác kích hoạt","muc_tieu":"MT4","cong_thuc":"Đối tác hoạt động ÷ tổng đối tác đủ điều kiện theo dõi × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Danh sách đối tác; CRM","dieu_kien_dung":"Có danh sách đối tác chuẩn, kỳ theo dõi","quy_tac":"Không dùng tổng số liên hệ làm mẫu số","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-29","ten":"Ứng viên hợp lệ","muc_tieu":"MT5","cong_thuc":"Đếm ứng viên duy nhất đạt tiêu chí đầu vào của vị trí, chương trình tuyển dụng","don_vi_tinh":"Ứng viên","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực; form tuyển dụng","dieu_kien_dung":"Hạng mục có kết quả cần đạt là tuyển dụng","quy_tac":"Không dùng toàn bộ hồ sơ thô","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-30","ten":"Tuyển được","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Đếm ứng viên đạt trạng thái tuyển được, nhận việc theo mốc đã thống nhất","don_vi_tinh":"Người","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực","dieu_kien_dung":"Có kết quả cần đạt là tuyển dụng","quy_tac":"Chốt rõ mốc: đồng ý đề nghị tuyển dụng hay nhận việc","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-31","ten":"Tỷ lệ tham gia, gắn kết cán bộ nhân viên","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Phòng Nhân lực (chờ chốt, mục 28, số 30)","cong_thuc":"Cán bộ nhân viên tham gia hợp lệ ÷ tổng cán bộ nhân viên thuộc đối tượng × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực; form nội bộ","dieu_kien_dung":"Chương trình có kết quả cần đạt là gắn kết nội bộ","quy_tac":"Không dùng cho truyền thông tuyển dụng bên ngoài","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-32","ten":"Tỷ lệ ứng viên hợp lệ thành phỏng vấn","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Ứng viên được phỏng vấn ÷ ứng viên hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực","dieu_kien_dung":"Có các bước tuyển chọn","quy_tac":"Cùng kỳ, cùng nhóm vị trí","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-33","ten":"Tỷ lệ phỏng vấn thành tuyển được","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Tuyển được ÷ ứng viên đã phỏng vấn × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực","dieu_kien_dung":"Có các bước tuyển chọn","quy_tac":"Cùng định nghĩa tuyển được","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-34","ten":"Chi phí trên người tuyển được","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Tổng chi của Hạng mục tuyển dụng ÷ số người tuyển được","don_vi_tinh":"Đồng/người","chieu":"Càng thấp càng tốt","nguon_so_lieu":"Phần mềm (chi Hạng mục); Phòng Nhân lực","dieu_kien_dung":"Có số liệu chi, số tuyển được","quy_tac":"Không dùng chi phí trên khách","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-35","ten":"Tỷ lệ chấp nhận đề nghị tuyển dụng","muc_tieu":"MT5","ghi_chu":"Đơn vị ngoài Phòng Marketing chịu trách nhiệm: Tổ Tuyển dụng (Phòng Nhân lực) (chờ chốt, mục 28, số 30)","cong_thuc":"Ứng viên đồng ý đề nghị tuyển dụng ÷ tổng đề nghị hợp lệ × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phòng Nhân lực","dieu_kien_dung":"Có ghi nhận đề nghị tuyển dụng","quy_tac":"Không dùng khi chưa theo dõi đề nghị tuyển dụng có cấu trúc","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-36","ten":"Tỷ lệ Hạng mục nghiệm thu","muc_tieu":"MT6","cong_thuc":"Phần việc nghiệm thu đạt ÷ tổng phần việc phải nghiệm thu × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Biên bản nghiệm thu; phần mềm","dieu_kien_dung":"Dự án có danh mục phần việc rõ ràng","quy_tac":"Điều kiện nghiệm thu xác định trước","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-37","ten":"Tỷ lệ Hạng mục đúng hạn","muc_tieu":"MT6","cong_thuc":"Phần việc hoàn thành đúng hoặc trước hạn đã duyệt ÷ tổng phần việc đến hạn × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Phần mềm","dieu_kien_dung":"Có hạn chuẩn","quy_tac":"Không tính phần việc chưa đến hạn vào mẫu số","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-38","ten":"Tỷ lệ sử dụng","muc_tieu":"MT6","cong_thuc":"Người, đơn vị sử dụng thực tế ÷ tổng người, đơn vị phải sử dụng × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Nhật ký hệ thống; báo cáo sử dụng","dieu_kien_dung":"Dự án có yêu cầu sử dụng sau triển khai","quy_tac":"Định nghĩa trước thế nào là sử dụng thực tế","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-39","ten":"Tỷ lệ dữ liệu đạt chuẩn","muc_tieu":"MT6","cong_thuc":"Bản ghi đạt chuẩn ÷ tổng bản ghi kiểm tra × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"CRM; báo cáo chất lượng dữ liệu","dieu_kien_dung":"Có bộ tiêu chuẩn dữ liệu","quy_tac":"Có thể tách đủ trường, đúng giá trị khi dữ liệu ổn định","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-40","ten":"Tỷ lệ đơn vị tuân thủ quy trình","muc_tieu":"MT6","cong_thuc":"Đơn vị, điểm đạt ÷ tổng đơn vị, điểm được kiểm tra × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Danh sách kiểm tra; phần mềm","dieu_kien_dung":"Có quy trình, chuẩn áp dụng toàn hệ thống","quy_tac":"Dùng một mẫu kiểm tra thống nhất","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-41","ten":"Tỷ lệ tích hợp, kết nối hoàn thành","muc_tieu":"MT6","cong_thuc":"Luồng kết nối đạt kiểm thử ÷ tổng luồng kết nối theo kế hoạch × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Biên bản kiểm thử; sổ theo dõi kết nối","dieu_kien_dung":"Dự án có kết nối hệ thống","quy_tac":"Chỉ tính luồng đạt điều kiện kỹ thuật, nghiệp vụ","ky_cham":"Quý","can_cu":"mục 12.5"},{"id":"KPI-42","ten":"Tỷ lệ mã theo dõi, quy thuộc đối soát được","muc_tieu":"MT6","cong_thuc":"Điểm chạm, nguồn đối soát được ÷ tổng điểm chạm, nguồn phải đo × 100","don_vi_tinh":"%","chieu":"Càng cao càng tốt","nguon_so_lieu":"Công cụ đo; CRM; HIS; kiểm tra dữ liệu","dieu_kien_dung":"Có kết quả cần đạt là đo lường, quy thuộc","quy_tac":"Gắn mã nhưng không đối soát được thì không tính đạt; Đo trên phần khách đã đồng ý mã theo dõi (Nghị định 330/2026/NĐ-CP)","ky_cham":"Quý","can_cu":"mục 12.5"}],"nhom_hoat_dong":[{"id":"N1","ten":"Nghiên cứu / Chiến lược / Kế hoạch"},{"id":"N2","ten":"Sáng tạo / Sản xuất nội dung / Tài sản thương hiệu"},{"id":"N3","ten":"Kênh sở hữu / Xuất bản tự nhiên"},{"id":"N4","ten":"Quảng cáo trả phí / Mua truyền thông"},{"id":"N5","ten":"PR / Danh tiếng / Đánh giá công khai"},{"id":"N6","ten":"Sự kiện / Kích hoạt / Cộng đồng"},{"id":"N7","ten":"Đối tác / B2B / Nguồn giới thiệu"},{"id":"N8","ten":"Website / App / SEO kỹ thuật / Công nghệ Marketing"},{"id":"N9","ten":"CRM / Tiếp thị trực tiếp / Tổng đài"},{"id":"N10","ten":"Đo lường / Phân tích / Quy thuộc kết quả / Báo cáo"},{"id":"N11","ten":"Vận hành / Quản trị / Năng lực Marketing"}],"mang_viec":[{"so":1,"ten":"Kế hoạch, ngân sách","thuc_hien":"Quản lý thương hiệu (Hạng mục, tháng); Trưởng phòng chủ trì kế hoạch năm","dau_vao":"Trưởng nhóm cơ sở (nhu cầu); Ban Giám đốc cơ sở (dịch vụ trọng tâm); Chuyên viên đo lường và đối soát (số liệu)","duyet":"Ban Giám đốc cơ sở: nhu cầu, ngân sách cơ sở. Trưởng phòng: kế hoạch Hạng mục, kế hoạch tháng. Ban Tổng Giám đốc: kế hoạch, hạn mức năm; Hạng mục dùng ngân sách Tổng công ty hoặc nhiều cơ sở (mục 4.2)","chiu_trach_nhiem":"Trưởng phòng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":2,"ten":"Nghiên cứu thị trường, khảo sát nhận biết","thuc_hien":"Chuyên viên dữ liệu khách hàng và thị trường","dau_vao":"Marketing cơ sở (thu thập tại chỗ); Quản lý thương hiệu (câu hỏi)","duyet":"Chuyên viên trưởng: phương án khảo sát (mục 14.16)","chiu_trach_nhiem":"Chuyên viên dữ liệu khách hàng và thị trường","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":3,"ten":"Gói dịch vụ, ưu đãi; chương trình trọng điểm theo hệ thống bệnh viện, phòng khám (gói khám, gói điều trị, chương trình trị liệu, hội thảo, lớp học)","thuc_hien":"Trưởng phòng chủ trì (chương trình theo hệ thống trong kế hoạch năm; trình Ban Tổng Giám đốc); Quản lý thương hiệu của nhóm lập đề xuất chi tiết theo thị trường, Hạng mục","dau_vao":"Đơn vị chuyên môn chủ trì nội dung chuyên môn của chương trình áp dụng từ 02 cơ sở; khoa phòng, bác sĩ (thành phần chuyên môn, chỉ định, chống chỉ định, số buổi; chương trình, báo cáo viên của hội thảo, lớp học); kế toán (giá, phí); Chuyên viên dữ liệu khách hàng và thị trường (thị trường, giá đối thủ)","duyet":"Ban Giám đốc cơ sở: chương trình, gói của 01 cơ sở. Chương trình áp dụng từ 02 cơ sở hoặc toàn hệ thống bệnh viện, phòng khám của một thương hiệu: Ban Tổng Giám đốc (Đề xuất – chờ duyệt, theo ngưỡng mục 14.15, số 38); Ban Giám đốc từng cơ sở xác nhận khả năng tiếp nhận, lịch, địa điểm. Marketing không quyết nội dung chuyên môn, giá (QT.26)","chiu_trach_nhiem":"Ban Giám đốc cơ sở","pham_vi":"mot_phan","phan_marketing":"Quản lý thương hiệu đề xuất","can_cu":"mục 31"},{"so":4,"ten":"Nội dung chuyên môn; rà soát định kỳ nội dung y khoa đã đăng (QT.28)","thuc_hien":"Chuyên viên biên tập của nhóm","dau_vao":"Trưởng nhóm cơ sở (chủ đề, bác sĩ)","duyet":"Bác sĩ, trưởng khoa: chuyên môn. Pháp lý: kiểm pháp lý theo tầng (mục 15.6). Bộ phận pháp chế: sản phẩm rủi ro cao. Nghiệm thu: người gửi yêu cầu; phát hành khi đủ bước kiểm, nghiệm thu, duyệt (mục 14.16)","chiu_trach_nhiem":"Chuyên viên biên tập của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":5,"ten":"Tin hoạt động trong ngày","thuc_hien":"Trưởng nhóm Marketing cơ sở: tin V1 đúng danh mục trên Facebook bệnh viện khi có quyền đăng hợp lệ; Media cơ sở chỉ đăng thay nếu có ủy quyền tách biệt và truy cập hợp lệ, không mặc nhiên có quyền khi Trưởng nhóm vắng.","dau_vao":"Chuyên viên Marketing cơ sở – media (ảnh, clip ngắn)","duyet":"Kiểm danh mục, nguồn, quyền đăng và nhật ký; danh sách kiểm không thay giấy ủy quyền. Vượt danh mục/chứa ca bệnh, giá, ưu đãi, kỹ thuật mới: chuyển Biên tập TCT và quy trình duyệt phát hành.","chiu_trach_nhiem":"Trưởng nhóm cơ sở","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":6,"ten":"Thiết kế","thuc_hien":"Chuyên viên thiết kế ngoại tuyến (danh sách cố định, mục 15.2); Chuyên viên thiết kế của nhóm (sản phẩm còn lại, cả bản số và bản in)","dau_vao":"Marketing cơ sở (yêu cầu, số đo); Chuyên viên biên tập (nội dung)","duyet":"Người gửi yêu cầu nghiệm thu đúng yêu cầu (Quản lý thương hiệu; Trưởng nhóm Marketing cơ sở với yêu cầu của cơ sở). Ấn phẩm ngoại viện (QyĐ.03.MKT mục 5.2): theo phân cấp (mục 14.16). Biển truyền thông: theo QyĐ.48","chiu_trach_nhiem":"Chuyên viên thiết kế của nhóm (sản phẩm của nhóm); Chuyên viên thiết kế ngoại tuyến (danh sách cố định)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":7,"ten":"Bộ nhận diện làm lại","thuc_hien":"Chuyên viên thiết kế nhóm 1 (bộ nhận diện chung của TTH: TTH Group, TTH Healthcare, TTH Hospital, TTH Clinic); Chuyên viên thiết kế nhóm 2 (bộ nhận diện của nhóm 2; phần thiết kế hệ nhận diện thuê ngoài theo tờ trình – mục 26, Chuyên viên thiết kế nhóm 2 là đầu mối, nghiệm thu kỹ thuật); Chuyên viên thiết kế của nhóm (áp dụng cho sản phẩm còn lại); Chuyên viên thiết kế ngoại tuyến (áp dụng cho biển bảng, trang trí, phương tiện); Chuyên viên truyền thông của nhóm (thi công biển); Chuyên viên thiết kế ngoại tuyến hỗ trợ bộ nhận diện nhóm 2 trong giờ dư đến khi bàn giao","dau_vao":"Quản lý thương hiệu (định vị); Marketing cơ sở (hiện trạng)","duyet":"Ban Tổng Giám đốc","chiu_trach_nhiem":"Quản lý thương hiệu nhóm 1 (bộ nhận diện chung của TTH, áp dụng tại nhóm 1); Quản lý thương hiệu nhóm 2 (bộ nhận diện của nhóm 2)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":8,"ten":"Nhãn hiệu, tên miền","thuc_hien":"Bộ phận pháp chế (đăng ký nhãn hiệu); Phòng Công nghệ – Nghiệp vụ Y (đăng ký, gia hạn, theo dõi hạn tên miền, chứng chỉ bảo mật); Phòng Số hóa (trỏ tên miền, cài chứng chỉ bảo mật trên website)","dau_vao":"Quản lý sản phẩm số (danh mục tên miền)","duyet":"Ban Tổng Giám đốc","chiu_trach_nhiem":"Nhãn hiệu: Quản lý thương hiệu của nhóm (hồ sơ: bộ phận pháp chế); tên miền: Quản lý sản phẩm số","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":9,"ten":"Media","thuc_hien":"Biên tập đúng nhóm chịu trách nhiệm kịch bản lời mọi video V2–V4; Media TCT đúng nhóm lập phân cảnh, kiểm kỹ thuật, dựng V3 vượt mẫu và V4; Media cơ sở chủ trì quay/dựng V1–V3 trong B-7, chuyển kiểm kỹ thuật theo quy trình. Không giao lời cho Media vì video không chứa chuyên môn.","dau_vao":"Biên tập đúng nhóm (kịch bản lời/thoại của mọi V2–V4, thông điệp); Media TCT (phân cảnh/shot-list); cơ sở/bác sĩ (nguồn y tế, nhân vật, giấy đồng ý); phân loại rủi ro chuyên môn/giá/ưu đãi độc lập với V1–V4.","duyet":"Bác sĩ/đơn vị chuyên môn xác nhận nếu có yếu tố y tế; kiểm pháp lý độc lập; Media TCT kiểm kỹ thuật nếu cơ sở dựng; Quản lý thương hiệu nghiệm thu đầu ra; người có thẩm quyền theo ma trận duyệt phát hành. Không tự kiểm hoặc tự duyệt.","chiu_trach_nhiem":"Media cơ sở chịu trách nhiệm chất lượng đầu ra dựng V2/V3 theo B-7 của chính cơ sở; Media TCT đúng nhóm chịu trách nhiệm kiểm kỹ thuật V2/V3, sản phẩm dựng chuyên sâu V3/V4 và chuẩn kỹ thuật. Phê duyệt phát hành theo ma trận riêng.","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":10,"ten":"Kênh số","thuc_hien":"Chuyên viên quảng cáo và kênh số của nhóm (kênh của nhóm)","dau_vao":"Tổ Nội dung và Sáng tạo (sản phẩm); Trưởng nhóm cơ sở (tin trong ngày trên Facebook của bệnh viện)","duyet":"Quản lý thương hiệu của nhóm: nghiệm thu lịch đăng. Trưởng phòng: quyền quản trị kênh (quyền quản trị cao nhất 02 người); Chuyên viên trưởng: quyền đăng bài, trả lời tin nhắn theo ma trận quyền (mục 11.3)","chiu_trach_nhiem":"Chuyên viên quảng cáo và kênh số của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":11,"ten":"Quảng cáo trực tuyến, KOL, KOC","thuc_hien":"Chuyên viên quảng cáo và kênh số (quảng cáo trả phí, đo Lead); Chuyên viên truyền thông của nhóm (KOL, KOC: chọn người, hợp đồng, quan hệ, pháp lý)","dau_vao":"Quản lý thương hiệu (kết quả cần đạt, ngân sách); Marketing cơ sở (ưu đãi, khả năng tiếp nhận)","duyet":"Chi phí: tờ trình theo Hạng mục. Nội dung: kiểm tra pháp lý","chiu_trach_nhiem":"Chuyên viên quảng cáo và kênh số của nhóm (Lead hợp lệ; chi phí trên Lead chỉ để chẩn đoán)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":12,"ten":"Bảng biển, quảng cáo ngoài trời, truyền thanh, truyền hình","thuc_hien":"Chuyên viên truyền thông của nhóm (quyết định vận hành/lịch/cải tạo theo phân cấp); Chuyên viên Marketing cơ sở – truyền thông (vận hành/kiểm tra/ảnh, số đo tại bệnh viện 03 người); bệnh viện 02 người: Trưởng nhóm Marketing cơ sở kiêm; Chuyên viên thiết kế ngoại tuyến (danh mục và mẫu)","dau_vao":"Chuyên viên thiết kế ngoại tuyến (mẫu thiết kế, file theo số đo, quy chuẩn chung); Marketing cơ sở (khảo sát); Quản lý thương hiệu; Chuyên viên Marketing cơ sở – truyền thông cung cấp kiểm tra tại chỗ, không giao Media cơ sở","duyet":"Thiết kế, nội dung, chất liệu: theo QyĐ.48 (Ban Tổng Giám đốc hoặc Ban Giám đốc cơ sở). Chi phí: tờ trình","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":13,"ten":"Màn hình nội viện","thuc_hien":"Chuyên viên truyền thông của nhóm (lập, giao lịch phát); Chuyên viên Marketing cơ sở – truyền thông (vận hành, kiểm tra hiển thị/âm thanh tại cơ sở; bệnh viện 02 người: Trưởng nhóm kiêm); Chuyên viên biên tập, thiết kế, media TCT (sản phẩm nội dung), không giao Media chi nhánh vận hành","dau_vao":"Marketing cơ sở gửi đề xuất của khoa phòng, có xác nhận của người phụ trách; sản phẩm đã được duyệt","duyet":"Chuyên viên truyền thông của nhóm nghiệm thu; kiểm pháp lý theo tầng (mục 15.6); phát hành khi đủ bước","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":14,"ten":"Phát thanh nội viện","thuc_hien":"Chuyên viên truyền thông TCT của nhóm lập lịch và điều phối; Chuyên viên biên tập của nhóm soạn kịch bản mẫu; Chuyên viên Marketing cơ sở – truyền thông trực tiếp phát, kiểm tra âm thanh tại bệnh viện 03 người; bệnh viện 02 người: Trưởng nhóm Marketing cơ sở kiêm nhiệm; Media cơ sở chỉ hỗ trợ thu âm tư liệu nếu được yêu cầu","dau_vao":"Khoa phòng (thông tin đã xác nhận); Trưởng nhóm Marketing cơ sở (nhu cầu, khung giờ, tình trạng hệ thống phát)","duyet":"Kịch bản do Biên tập soạn; bác sĩ xác nhận khi có chuyên môn; kiểm nội dung độc lập theo tầng; Truyền thông TCT nghiệm thu lịch phát; người có thẩm quyền duyệt phát hành trước khi cơ sở phát đúng bản.","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm chịu trách nhiệm lịch và nội dung phát theo bản đã duyệt; truyền thông cơ sở hoặc Trưởng nhóm kiêm chịu trách nhiệm vận hành tại chỗ","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":15,"ten":"Trang trí lễ, Tết; poster, tranh ảnh trang trí tại cơ sở; vật phẩm thương hiệu","thuc_hien":"Chuyên viên Truyền thông TCT đúng nhóm lập kế hoạch, điều phối; Chuyên viên Marketing cơ sở – truyền thông khảo sát, triển khai, kiểm tra và chụp ảnh nghiệm thu tại bệnh viện 03 người; bệnh viện 02 người: Trưởng nhóm Marketing cơ sở kiêm nhiệm; Chuyên viên Thiết kế ngoại tuyến phụ trách mẫu trang trí, Thiết kế đúng nhóm phụ trách vật phẩm.","dau_vao":"Quản lý thương hiệu đúng nhóm xác định nhu cầu; Chuyên viên Marketing cơ sở – truyền thông cung cấp vị trí, kích thước, tình trạng thực tế, ảnh nghiệm thu (bệnh viện 02 người: Trưởng nhóm kiêm).","duyet":"Mẫu toàn hệ thống: Trưởng phòng, mỗi dịp một lần. Chi phí: tờ trình. Ban Giám đốc cơ sở: tại cơ sở; không đồng nhất duyệt thiết kế với nghiệm thu thi công, duyệt chi phí","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":16,"ten":"Website, App TTH","thuc_hien":"Quản lý sản phẩm số chủ nghiệp vụ, phối hợp Phòng Số hóa kỹ thuật; Chuyên viên biên tập phụ trách nội dung biên tập; Quản lý sản phẩm số cập nhật dữ liệu có cấu trúc theo mảng 43 sau kiểm độc lập; Chuyên viên quảng cáo và kênh số quản trị kênh mạng xã hội/Trang doanh nghiệp trên Google, không quản trị CMS website","dau_vao":"Marketing cơ sở (hồ sơ bác sĩ, dịch vụ; lịch bác sĩ khi chưa có kết nối HIS); HIS (lịch làm việc của bác sĩ khi có kết nối); kế toán (giá)","duyet":"Trưởng phòng: cấu trúc, thay đổi lớn. Bác sĩ: nội dung y khoa","chiu_trach_nhiem":"Quản lý sản phẩm số","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":17,"ten":"Tiếp nhận đa kênh: tổng đài, hotline di động, tin nhắn, bình luận, email, form","thuc_hien":"Contact Center (trước khi nhận: người đang trả lời tại cơ sở, mục 17)","dau_vao":"Cơ sở/bộ phận quản lý dịch vụ cung cấp phiếu thông tin gói khám, giá, điều kiện, lịch, câu hỏi thường gặp; chuyên môn/đơn vị có thẩm quyền xác nhận; Marketing cung cấp chương trình, thông điệp đã duyệt và tiêu chí Lead hợp lệ. Contact Center chủ trì kịch bản.","duyet":"Người có thẩm quyền của đơn vị chủ quản Contact Center duyệt kịch bản nghiệp vụ; chuyên môn xác nhận phần y tế, cơ sở xác nhận giá/điều kiện; Marketing chỉ kiểm tra thông điệp thuộc Marketing khi có.","chiu_trach_nhiem":"Contact Center: chất lượng tiếp nhận, nội dung kịch bản và phân tuyến; cơ sở/chuyên môn: tính đúng của thông tin cung cấp.","pham_vi":"mot_phan","phan_marketing":"Bàn giao thông tin Marketing đã duyệt, tiêu chí Lead hợp lệ; không chủ trì kịch bản tư vấn","can_cu":"mục 31"},{"so":18,"ten":"Chăm sóc, giữ chân khách hàng cũ; gửi tin hàng loạt","thuc_hien":"Chuyên viên quảng cáo và kênh số của nhóm (gửi tin hàng loạt, gửi tự động trên kênh của nhóm); Chuyên viên dữ liệu khách hàng và thị trường (lịch gửi chung, trần tần suất, chặn trùng; giai đoạn đầu: Chuyên viên đo lường và đối soát); Contact Center (gọi; trả lời tin khách gửi lại)","dau_vao":"Chuyên viên dữ liệu khách hàng và thị trường (phân khúc, danh sách đã đồng ý); Chuyên viên biên tập (nội dung); Chuyên viên thiết kế của nhóm (hình ảnh); Marketing cơ sở (đăng ký nhận tin, có đồng ý)","duyet":"Quản lý thương hiệu của nhóm: Hạng mục, đợt gửi. Biên tập kiểm theo tầng: pháp lý. Chuyên viên dữ liệu khách hàng và thị trường: dữ liệu cá nhân. Trưởng phòng: tần suất tối đa mỗi khách (mục 16, số 20)","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":19,"ten":"Đánh giá công khai","thuc_hien":"Contact Center, trước khi nhận: người đang trả lời tại cơ sở (thông thường); Chuyên viên truyền thông của nhóm (nhạy cảm)","dau_vao":"Marketing cơ sở (điểm chạm, phản ánh); bộ phận tiếp nhận, xử lý phản ánh của cơ sở (kết quả giải quyết)","duyet":"Chuyên viên truyền thông của nhóm: kịch bản trả lời","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":20,"ten":"Sự kiện, cộng đồng, học đường, đối tác địa phương","thuc_hien":"Truyền thông cơ sở (bệnh viện 02 người: Trưởng nhóm)","dau_vao":"Khoa phòng (phần y tế); Chuyên viên thiết kế của nhóm (ấn phẩm, bản số và bản in)","duyet":"Ban Giám đốc cơ sở: kế hoạch, ngân sách. Nội dung truyền thông (QyĐ.03.MKT mục 5.2): Chuyên viên trưởng; có báo chí, cấp hệ thống: Trưởng phòng (mục 14.16)","chiu_trach_nhiem":"Truyền thông cơ sở; sự kiện thuộc Hạng mục: Quản lý thương hiệu chịu trách nhiệm kết quả Hạng mục (mục 11.1, số 14)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":21,"ten":"Cơ sở y tế, bác sĩ, phòng khám bên ngoài giới thiệu người bệnh; tuyến dưới","thuc_hien":"Truyền thông cơ sở (bệnh viện 02 người: Trưởng nhóm); từ 02 cơ sở: Quản lý thương hiệu của nhóm","dau_vao":"Chuyên viên đo lường và đối soát (nguồn giới thiệu); đơn vị chuyên môn (chuyển tuyến, phản hồi chuyên môn cho người giới thiệu theo quy định)","duyet":"Ban Giám đốc cơ sở: chính sách hợp tác. Hình thức ghi nhận, chăm sóc bác sĩ, phòng khám bên ngoài: chỉ áp dụng hình thức được bộ phận pháp chế xác nhận (mục 28, số 47)","chiu_trach_nhiem":"Truyền thông cơ sở","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":22,"ten":"Hội nghị khoa học, sự kiện hệ thống","thuc_hien":"Chuyên viên biên tập, thiết kế, media của nhóm có sự kiện (sản xuất); Chuyên viên truyền thông của nhóm (báo chí); Marketing cơ sở cùng nhóm (hậu cần tại chỗ). Sự kiện của nhóm 1 tại trụ sở Tổng công ty (Bệnh viện Y học cổ truyền Nguyên Phúc, nhóm 2): Quản lý thương hiệu nhóm 1 lo hậu cần, phối hợp bộ phận hành chính của cơ sở (QT.12) – thay cách làm Phòng Marketing Tổng công ty xác nhận ngày 28/10/2026, theo nguyên tắc không xử lý chéo nhóm. Sự kiện hệ thống tổ chức ở nơi không có Marketing cơ sở (địa điểm thuê, phòng khám): Quản lý thương hiệu phụ trách Hạng mục điều phối hậu cần tại chỗ; Marketing cơ sở cùng nhóm gần nhất hỗ trợ theo lịch chung; âm thanh, sân khấu thuê qua nhà cung cấp, hồ sơ do Quản lý thương hiệu lập (mảng 30)","dau_vao":"Đơn vị chủ trì nội dung khoa học","duyet":"Trưởng phòng; Ban Tổng Giám đốc theo thẩm quyền","chiu_trach_nhiem":"Quản lý thương hiệu phụ trách Hạng mục","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":23,"ten":"Báo chí, khủng hoảng, theo dõi dư luận","thuc_hien":"Chuyên viên truyền thông của nhóm (gồm theo dõi dư luận về thương hiệu của nhóm)","dau_vao":"Marketing cơ sở (thông tin, bác sĩ); Phòng Quản lý chất lượng (sự cố y khoa)","duyet":"Người phát ngôn theo quy chế; Ban Tổng Giám đốc: thông cáo khủng hoảng","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm; khủng hoảng liên quan cả hai nhóm: Trưởng phòng (chưa có: Chuyên viên trưởng)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":24,"ten":"Bác sĩ trên mạng","thuc_hien":"Bác sĩ; Trưởng nhóm cơ sở (điều phối)","dau_vao":"Chuyên viên truyền thông của nhóm (hướng dẫn)","duyet":"Theo quy chế phát ngôn","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":25,"ten":"Truyền thông nội bộ","thuc_hien":"Nội bộ Tổng công ty, TTH Group: Chuyên viên truyền thông nhóm 1 (vận động tương tác), Chuyên viên biên tập nhóm 1, Chuyên viên media nhóm 1 (sản xuất); nội bộ đơn vị nhóm 2: người cùng chuyên môn nhóm 2; Marketing cơ sở (cấp cơ sở)","dau_vao":"Phòng Hành chính quản trị, Phòng Nhân lực (nội dung chủ trương, văn hóa)","duyet":"Đơn vị chủ trì nội dung; sản phẩm Marketing: Chuyên viên biên tập của nhóm duyệt, không duyệt sản phẩm do chính mình làm (mục 14.16)","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm (nội bộ Tổng công ty, TTH Group: nhóm 1)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":26,"ten":"Truyền thông tuyển dụng","thuc_hien":"Chuyên viên thiết kế của nhóm có cơ sở tuyển dụng (Tổng công ty, TTH Group: nhóm 1); Chuyên viên quảng cáo và kênh số của nhóm (đăng)","dau_vao":"Tổ Tuyển dụng (Phòng Nhân lực) (nội dung)","duyet":"Tổ Tuyển dụng (Phòng Nhân lực)","chiu_trach_nhiem":"Tổ Tuyển dụng (Phòng Nhân lực)","pham_vi":"mot_phan","phan_marketing":"Thiết kế, đăng trên kênh","can_cu":"mục 31"},{"so":27,"ten":"Quy tắc ứng xử mạng xã hội của nhân viên","thuc_hien":"Chuyên viên truyền thông nhóm 1, nhóm 2 soạn phần của nhóm; Chuyên viên trưởng tổng hợp","dau_vao":"Phòng Nhân lực","duyet":"Phòng Nhân lực trình ban hành","chiu_trach_nhiem":"Phòng Nhân lực","pham_vi":"mot_phan","phan_marketing":"Chuyên viên truyền thông nhóm 1 soạn","can_cu":"mục 31"},{"so":28,"ten":"Ấn phẩm giáo dục sức khỏe cho người bệnh","thuc_hien":"Chuyên viên thiết kế của nhóm (bản gốc: bản số, tờ phát tay); Chuyên viên thiết kế ngoại tuyến (poster treo cố định tại khoa phòng)","dau_vao":"Khoa phòng (nội dung)","duyet":"Khoa phòng: chuyên môn","chiu_trach_nhiem":"Khoa phòng (chờ văn bản Tổ Công tác xã hội)","pham_vi":"mot_phan","phan_marketing":"Thiết kế theo quy chuẩn","can_cu":"mục 31"},{"so":29,"ten":"Đối tác cấp hệ thống","thuc_hien":"Đơn vị được Ban Tổng Giám đốc giao (ký kết); hồ sơ năng lực: Chuyên viên truyền thông của nhóm (hồ sơ năng lực Tập đoàn: nhóm 1 ghép, phần nhóm 2 do Chuyên viên truyền thông nhóm 2 viết, nhóm 1 không sửa); truyền thông: Quản lý thương hiệu của nhóm","dau_vao":"Marketing cơ sở","duyet":"Ban Tổng Giám đốc","chiu_trach_nhiem":"Đơn vị được Ban Tổng Giám đốc giao","pham_vi":"mot_phan","phan_marketing":"Hồ sơ năng lực, truyền thông","can_cu":"mục 31"},{"so":30,"ten":"Nhà cung cấp, hợp đồng, thanh toán","thuc_hien":"Quản lý thương hiệu của nhóm (hồ sơ); Chuyên viên trưởng (danh sách nhà cung cấp đã phê duyệt); Chuyên viên đo lường và đối soát (cộng nhu cầu mua của 02 nhóm ngày 20–22, trước khi ký)","dau_vao":"Chuyên viên truyền thông, Chuyên viên quảng cáo và kênh số (đề xuất)","duyet":"Theo quy định mua sắm (Phòng Tài chính – Kế hoạch chủ trì); Quy chế chi tiêu nội bộ ban hành kèm Quyết định 189/QĐ-TTH: Điều 3.1 (người phê duyệt chi tiêu; với Marketing: chi mới ngoài hạn mức, kế hoạch và ngân sách năm: Tổng Giám đốc (đồng thời là Chủ tịch Hội đồng quản trị); chi trong hạn mức đã duyệt (tờ trình chi Hạng mục, hợp đồng, thanh toán): Phó Tổng Giám đốc mảng tài chính theo ma trận thẩm quyền), Điều 32.1 (tổng giá trị mua sắm từ 20 triệu đồng trở lên bắt buộc ký hợp đồng)","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm (chi trong hạn mức)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":31,"ten":"Quản trị nghiệp vụ phần mềm","thuc_hien":"Chuyên viên trưởng (phân quyền, mẫu Hạng mục); Chuyên viên dữ liệu khách hàng và thị trường (danh mục, chất lượng dữ liệu)","dau_vao":"Phòng Số hóa (kỹ thuật; yêu cầu gửi qua Quản lý sản phẩm số)","duyet":"Ma trận phân quyền, mẫu Hạng mục: Trưởng phòng duyệt một lần, sửa khi cần (Chuyên viên trưởng cấp quyền theo ma trận); thay đổi quy tắc phần mềm: Trưởng phòng","chiu_trach_nhiem":"Chuyên viên trưởng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":32,"ten":"Ghi nhận kết quả","thuc_hien":"Bộ phận tiếp đón (nguồn khách); Chuyên viên đo lường và đối soát (đối soát)","dau_vao":"Trưởng nhóm cơ sở (kiểm tra nguồn khách, bằng chứng)","duyet":"Trưởng phòng: bản chốt kỳ","chiu_trach_nhiem":"Chuyên viên đo lường và đối soát","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":33,"ten":"Bảo vệ dữ liệu cá nhân","thuc_hien":"Chuyên viên dữ liệu khách hàng và thị trường","dau_vao":"Marketing cơ sở (giấy đồng ý); Phòng Công nghệ – Nghiệp vụ Y","duyet":"Bộ phận pháp chế","chiu_trach_nhiem":"Chuyên viên dữ liệu khách hàng và thị trường","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":34,"ten":"Khám sức khỏe doanh nghiệp, gói dịch vụ cho tổ chức","thuc_hien":"Truyền thông: Quản lý thương hiệu của nhóm (Hạng mục); hồ sơ năng lực: Chuyên viên truyền thông của nhóm; quan hệ: truyền thông cơ sở; bán, ký hợp đồng: đơn vị do Ban Tổng Giám đốc xác định","dau_vao":"Khoa Khám sức khỏe (gói, giá)","duyet":"Ban Giám đốc cơ sở; Ban Tổng Giám đốc theo thẩm quyền","chiu_trach_nhiem":"Đơn vị bán, ký hợp đồng (mục 28, số 24)","pham_vi":"mot_phan","phan_marketing":"Truyền thông, hồ sơ năng lực, quan hệ","can_cu":"mục 31"},{"so":35,"ten":"Nội dung tiếng Anh của website","thuc_hien":"tthhealthcare.com: Chuyên viên biên tập nhóm 1; website của thương hiệu nhóm 2: Chuyên viên biên tập nhóm 2","dau_vao":"Bác sĩ (chuyên môn)","duyet":"Bác sĩ: chuyên môn. Kiểm pháp lý theo tầng (mục 15.6); Quản lý sản phẩm số nghiệm thu; phát hành khi đủ bước","chiu_trach_nhiem":"Chuyên viên biên tập của nhóm có website","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":36,"ten":"Theo dõi tổng chi Marketing so với ngân sách năm","thuc_hien":"Chuyên viên đo lường và đối soát","dau_vao":"Quản lý thương hiệu (khoản chi theo Hạng mục); kế toán (đối chiếu)","duyet":"Trưởng phòng","chiu_trach_nhiem":"Trưởng phòng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":37,"ten":"Kiểm tra tuân thủ nhận diện tại cơ sở","thuc_hien":"Chuyên viên thiết kế ngoại tuyến (kiểm độc lập; sản phẩm do chính mình làm: Chuyên viên thiết kế của nhóm có cơ sở kiểm); Chuyên viên truyền thông của nhóm (biển bảng)","dau_vao":"Chuyên viên Marketing cơ sở – truyền thông kiểm hiện trạng biển bảng hằng tuần, tổng hợp và gửi ảnh/số đo hằng tháng (bệnh viện 02 người: Trưởng nhóm kiêm); Media cơ sở không giữ lịch kiểm định kỳ.","duyet":"Quản lý thương hiệu của nhóm: biện pháp khắc phục","chiu_trach_nhiem":"Chuyên viên thiết kế ngoại tuyến","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":38,"ten":"Thủ tục với cơ quan nhà nước khi pháp luật yêu cầu","thuc_hien":"Pháp chế chủ trì xác định điều kiện, thành phần, hoàn thiện và nộp hồ sơ pháp lý quảng cáo; Chuyên viên biên tập của nhóm chỉ chuẩn bị nội dung/phiên bản và minh chứng Marketing. Hồ sơ website/App: Phòng Số hóa chủ trì theo phân công hiện hành","dau_vao":"Bộ phận pháp chế; Phòng Công nghệ – Nghiệp vụ Y (hồ sơ tên miền, chứng chỉ bảo mật); Quản lý sản phẩm số (phần nội dung của hồ sơ website, App TTH); bác sĩ/đơn vị chuyên môn xác nhận nội dung y tế, giấy phép/căn cứ và nguồn","duyet":"Trưởng phòng duyệt nội dung Marketing; Pháp chế kiểm tra điều kiện pháp lý, hoàn thiện/nộp hồ sơ; không phát hành khi thiếu căn cứ","chiu_trach_nhiem":"Bộ phận pháp chế (mục 28, số 7)","pham_vi":"mot_phan","phan_marketing":"Bản nội dung, minh chứng, nguồn xác nhận và phiên bản Marketing đã duyệt; không lập/nộp thay hồ sơ pháp lý","can_cu":"mục 31"},{"so":39,"ten":"Theo dõi thay đổi pháp luật quảng cáo y tế, chính sách nền tảng","thuc_hien":"Bộ phận pháp chế (pháp luật, danh sách kiểm tra pháp lý chung); Quản lý sản phẩm số (chính sách nền tảng, danh sách từ khóa, hình ảnh bị cấm); Chuyên viên biên tập của nhóm (phần chuyên khoa, sửa mẫu của nhóm)","dau_vao":"Bộ phận pháp chế (thông báo thay đổi)","duyet":"Pháp chế xác nhận nội dung chuyên môn DS-1; Trưởng phòng phê duyệt áp dụng danh sách trong quy trình Marketing; chính sách nền tảng do Chuyên viên trưởng duyệt","chiu_trach_nhiem":"Trưởng phòng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":40,"ten":"Quy định dùng công cụ trí tuệ nhân tạo","thuc_hien":"Chuyên viên trưởng (soạn)","dau_vao":"Chuyên viên biên tập; Chuyên viên dữ liệu khách hàng và thị trường; Phòng Công nghệ – Nghiệp vụ Y","duyet":"Trưởng phòng","chiu_trach_nhiem":"Chuyên viên trưởng","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":41,"ten":"Tài trợ","thuc_hien":"Cấp hệ thống, thương hiệu: hồ sơ tài trợ: Chuyên viên truyền thông của nhóm (thương hiệu Tập đoàn: nhóm 1); tài trợ thuộc Hạng mục: Quản lý thương hiệu của nhóm. Địa phương: truyền thông cơ sở. Từ thiện không có đối ứng truyền thông: Tổ Công tác xã hội (mục 11.1, số 15)","dau_vao":"Đơn vị đề nghị tài trợ","duyet":"Ban Giám đốc cơ sở (địa phương); Trưởng phòng, Ban Tổng Giám đốc theo thẩm quyền","chiu_trach_nhiem":"Theo phạm vi: Chuyên viên truyền thông của nhóm, Quản lý thương hiệu của nhóm (Hạng mục) hoặc truyền thông cơ sở","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":42,"ten":"Mạo danh bệnh viện, bác sĩ, thương hiệu trên mạng (trang Facebook, tài khoản, website, quảng cáo giả)","thuc_hien":"Chuyên viên truyền thông của nhóm có thương hiệu bị mạo danh (phát hiện, xác minh, lưu bằng chứng, cảnh báo khách, báo bác sĩ); Chuyên viên quảng cáo và kênh số của nhóm (báo cáo vi phạm lên nền tảng); mạo danh cả hai nhóm: Chuyên viên trưởng chủ quy trình (QT.27)","dau_vao":"Marketing cơ sở, Contact Center, nhân viên (báo phát hiện); Quản lý thương hiệu của nhóm có thương hiệu (hồ sơ nhãn hiệu, mảng 8)","duyet":"Cảnh báo trên kênh chính thức: Trưởng phòng (mục 14.16). Báo cơ quan chức năng: bộ phận pháp chế","chiu_trach_nhiem":"Chuyên viên truyền thông của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":43,"ten":"Thông tin công khai của cơ sở khám bệnh, chữa bệnh trên website, App TTH (giá dịch vụ, người hành nghề, dịch vụ, kỹ thuật được phép)","thuc_hien":"Quản lý sản phẩm số đối chiếu nguồn, nhập và đăng dữ liệu có cấu trúc về giá/người hành nghề/dịch vụ/kỹ thuật trên website/App sau kiểm độc lập; Chuyên viên biên tập chỉ hiệu đính cách diễn đạt, không sửa số liệu nguồn","dau_vao":"Nguồn gốc: Kế toán/đơn vị quản lý giá cấp bảng giá; Phòng Nhân lực và đơn vị chuyên môn cấp, xác nhận người hành nghề và phân công; Phòng chuyên môn/Pháp chế cấp, xác nhận danh mục dịch vụ, kỹ thuật được phép; Ban Giám đốc cơ sở xác nhận hiệu lực. Trưởng nhóm cơ sở chuyển đủ bộ tài liệu đã xác nhận, không tự làm chủ dữ liệu.","duyet":"Đơn vị chủ dữ liệu và Ban Giám đốc cơ sở xác nhận tính đúng, hiệu lực của dữ liệu; Pháp chế kiểm soát điều kiện công khai; người kiểm độc lập đối chiếu trước công bố. Quản lý sản phẩm số chỉ công bố sau khi đủ bước.","chiu_trach_nhiem":"Quản lý sản phẩm số (tính chính xác cập nhật so với nguồn đã duyệt; chủ dữ liệu cơ sở chịu trách nhiệm dữ liệu gốc)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":44,"ten":"Trải nghiệm người bệnh; khảo sát hài lòng (NPS, CSAT)","thuc_hien":"Chuyên viên dữ liệu khách hàng và thị trường (NPS trên kênh số, điểm chạm sau khám; tổng hợp phản hồi cho Hạng mục); Contact Center (gọi khảo sát khi vận hành)","dau_vao":"Phòng Quản lý chất lượng (khảo sát hài lòng người bệnh theo quy định); bộ phận tiếp nhận, xử lý phản ánh","duyet":"Trưởng phòng: bộ câu hỏi trên kênh số","chiu_trach_nhiem":"Chờ quyết định (mục 28, số 30)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":45,"ten":"Bảo hiểm y tế, bảo hiểm sức khỏe, bảo lãnh viện phí: truyền thông quyền lợi, đối tác bảo hiểm","thuc_hien":"Quản lý thương hiệu của nhóm (truyền thông quyền lợi; đối tác bảo hiểm cấp hệ thống: hồ sơ năng lực, truyền thông); Chuyên viên biên tập (nội dung); Contact Center (tư vấn theo kịch bản)","dau_vao":"Bộ phận phụ trách bảo hiểm của cơ sở (quyền lợi, danh sách bảo lãnh viện phí)","duyet":"Ban Giám đốc cơ sở: nội dung quyền lợi tại cơ sở. Ký kết đối tác: đơn vị được Ban Tổng Giám đốc giao (mục 28, số 49)","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"},{"so":46,"ten":"Người bệnh nước ngoài","thuc_hien":"Quản lý thương hiệu của nhóm (Hạng mục); Chuyên viên biên tập của nhóm (nội dung tiếng Anh, mảng 35); Quản lý sản phẩm số (trang ngôn ngữ trên website, App TTH)","dau_vao":"Ban Giám đốc cơ sở (nhu cầu, khả năng tiếp đón người bệnh nước ngoài)","duyet":"Trưởng phòng","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm, khi Ban Tổng Giám đốc xác nhận nhu cầu (mục 28, số 48)","pham_vi":"marketing","phan_marketing":"","can_cu":"mục 31"}],"mang_viec_bo_sung":[{"ten":"Tin giao dịch gửi tự động (xác nhận, nhắc lịch hẹn, báo đã có kết quả, nhắc tái khám theo chỉ định)","phan_marketing":"Soạn mẫu nội dung","chiu_trach_nhiem":"Đơn vị vận hành chờ Ban Tổng Giám đốc chốt","can_cu":"mục 28, số 36"}],"ngoai_pham_vi":[{"viec":"Giải quyết khiếu nại, phản ánh của người bệnh; trả lời người phản ánh qua kênh riêng","don_vi":["xu-ly-phan-anh"],"ghi_chu":"QT.18.MAR chuyển ra (mục 18)"},{"viec":"Sự cố y khoa; khảo sát hài lòng người bệnh","don_vi":["qlcl"],"ghi_chu":"KPI-20, KPI-21: chờ chốt (mục 28, số 30)"},{"viec":"Giao diện, lập trình, vận hành kỹ thuật website, App TTH, website các chuỗi, phần mềm Quản trị Marketing","don_vi":["so-hoa"],"ghi_chu":"mục 17"},{"viec":"Phần mềm phát màn hình, kho tư liệu; đăng ký, gia hạn, theo dõi hạn tên miền, chứng chỉ bảo mật (SSL); kết nối hệ thống","don_vi":["cnnvy"],"ghi_chu":"mục 17"},{"viec":"Bản tin nội bộ, chủ trương; lắp đặt, bảo trì thiết bị màn hình; sửa chữa vật lý biển bảng","don_vi":["hcqt"],"ghi_chu":"mục 17"},{"viec":"Mua sắm theo quy định mua sắm, gồm thiết bị màn hình, đồng phục","don_vi":["mua-sam"],"ghi_chu":"mục 17; mục 28, số 7"},{"viec":"Văn hóa doanh nghiệp, sự kiện nội bộ; quy định đồng phục; chức danh, chế độ, lương thưởng","don_vi":["nhan-luc"],"ghi_chu":"mục 17"},{"viec":"Nội dung, kế hoạch tuyển dụng","don_vi":["tuyen-dung"],"ghi_chu":"mục 17"},{"viec":"Đăng ký nhãn hiệu; ý kiến pháp lý sản phẩm rủi ro cao","don_vi":["phap-che"],"ghi_chu":"đơn vị chờ chốt (mục 28, số 7)"},{"viec":"Từ thiện, hỗ trợ người bệnh","don_vi":["ctxh"],"ghi_chu":"mục 17"},{"viec":"Giá dịch vụ; chuyên môn, phần y tế của khám cộng đồng; chuyển tuyến","don_vi":["ke-toan","khoa-phong","don-vi-chuyen-mon"],"ghi_chu":"mục 17"},{"viec":"Vật tư y tế khám cộng đồng","don_vi":["khoa-phong"],"ghi_chu":"QT.05.MKT chuyển ra (mục 18)"},{"viec":"Danh sách người hành nghề, danh mục dịch vụ, kỹ thuật được phép của cơ sở","don_vi":["don-vi-chuyen-mon"],"ghi_chu":"mục 17; mảng 43"}],"hanh_trinh_khach_hang":[{"ten":"Thu hút","chiu_trach_nhiem":["mkt-tct","mkt-coso"],"marketing_lam":"Kế hoạch, Hạng mục, nội dung, thiết kế, media, quảng cáo, kênh số, website, App TTH, báo chí, biển bảng, sự kiện, cộng đồng, đối tác địa phương; thông tin công khai của cơ sở trên website, App TTH (mảng 43); quan hệ với bác sĩ, phòng khám bên ngoài giới thiệu người bệnh (mảng 21)","don_vi_khac_lam":"Ban Giám đốc cơ sở duyệt ưu đãi, giá, ngân sách cơ sở; bác sĩ xác nhận chuyên môn","can_cu":"mục 31, mảng 1–16, 20–24"},{"ten":"Tiếp nhận từ xa","chiu_trach_nhiem":["cc"],"marketing_lam":"Marketing cung cấp thông tin chiến dịch/dịch vụ/ưu đãi đã duyệt, tiêu chí Lead hợp lệ và đầu mối với Contact Center (Chuyên viên đo lường và đối soát); không soạn hay duyệt kịch bản tư vấn","don_vi_khac_lam":"Mọi nguồn đa kênh: tổng đài 19002675, hotline di động của các cơ sở, tin nhắn trên mọi kênh (Facebook, Trang Zalo chính thức, TikTok, YouTube, Threads, website, App TTH), bình luận hỏi dịch vụ, email, form trên website, App TTH, trang đích","can_cu":"mục 17; mục 31, mảng 17"},{"ten":"Đặt lịch","chiu_trach_nhiem":["cc"],"marketing_lam":"Đặt lịch trên website, App TTH: Quản lý sản phẩm số (kỹ thuật: Phòng Số hóa). KPI-05 đặt lịch: Chuyên viên quảng cáo và kênh số, chỉ tiêu chung với Contact Center","don_vi_khac_lam":"Tư vấn, đặt lịch qua tổng đài, tin nhắn (KPI-18, KPI-19)","can_cu":"mục 9; mục 12.2"},{"ten":"Tiếp đón, khám","chiu_trach_nhiem":["tiep-don","khoa-phong"],"marketing_lam":"Marketing cơ sở kiểm tra nguồn khách tại quầy tiếp đón; truyền thông quyền lợi bảo hiểm, bảo lãnh viện phí (Quản lý thương hiệu của nhóm, mảng 45)","don_vi_khac_lam":"Bộ phận tiếp đón ghi nguồn khách; khoa phòng thực hiện dịch vụ","can_cu":"mục 31, mảng 32; mục 31, mảng 45"},{"ten":"Tin giao dịch","chiu_trach_nhiem":[],"chiu_trach_nhiem_ghi_chu":"Gửi tự động từ hệ thống; đơn vị vận hành chờ Ban Tổng Giám đốc chốt","marketing_lam":"Soạn mẫu nội dung","don_vi_khac_lam":"Xác nhận, nhắc lịch hẹn, báo đã có kết quả, nhắc tái khám theo chỉ định. Đề xuất: Phòng Số hóa vận hành kỹ thuật; Phòng Công nghệ – Nghiệp vụ Y kết nối HIS","can_cu":"mục 28, số 36","de_xuat":true},{"ten":"Chăm sóc, giữ chân","chiu_trach_nhiem":["qlth|của nhóm"],"marketing_lam":"Hạng mục chăm sóc khách hàng cũ; danh sách đã đồng ý (Chuyên viên dữ liệu khách hàng và thị trường); nội dung (Biên tập); gửi tin hàng loạt (Chuyên viên quảng cáo và kênh số của nhóm; lịch gửi chung: Chuyên viên dữ liệu khách hàng và thị trường); đo (Chuyên viên đo lường và đối soát)","don_vi_khac_lam":"Contact Center: gọi chăm sóc, trả lời tin khách gửi lại. Bộ phận tiếp đón: tiếp đón khách tái khám","can_cu":"mục 31, mảng 18"},{"ten":"Phản ánh, đánh giá","chiu_trach_nhiem":["xu-ly-phan-anh|nội dung phản ánh","cvtt|của nhóm, trả lời công khai"],"marketing_lam":"Trả lời đánh giá nhạy cảm; kịch bản trả lời (Chuyên viên truyền thông của nhóm); khủng hoảng truyền thông; NPS trên kênh số, điểm chạm sau khám (Chuyên viên dữ liệu khách hàng và thị trường, mảng 44); mạo danh trên mạng (Chuyên viên truyền thông của nhóm, QT.27)","don_vi_khac_lam":"Contact Center: đánh giá thông thường, chuyển phản ánh. Phòng Quản lý chất lượng: sự cố y khoa, khảo sát hài lòng người bệnh","can_cu":"mục 11.1, số 6; mục 31, mảng 19, 23; mục 31, mảng 42, 44"},{"ten":"Đo lường","chiu_trach_nhiem":["dl-1"],"marketing_lam":"Đối soát Lead – đặt lịch – khách – doanh thu được ghi nhận; KPI; báo cáo tuần, tháng, quý dựng tự động","don_vi_khac_lam":"Bộ phận tiếp đón (nguồn khách); kế toán (đối chiếu chi)","can_cu":"mục 31, mảng 32, 36"}],"lien_he_don_vi":[{"don_vi":["btgd"],"marketing_gui":"Kế hoạch, ngân sách Marketing năm (có xác nhận của Giám đốc từng cơ sở); Hạng mục dùng ngân sách Tổng công ty hoặc nhiều cơ sở; đề xuất định biên; báo cáo","don_vi_phu_trach":"Duyệt định biên, hạn mức năm, Hạng mục dùng ngân sách Tổng công ty; thông cáo khủng hoảng; ban hành ma trận thẩm quyền","marketing_nhan":"Quyết định. Yêu cầu của Ban Tổng Giám đốc do Trưởng phòng chuyển vào cổng tiếp nhận yêu cầu","can_cu":"mục 4.2; mục 14.10"},{"don_vi":["bgd-coso","khoa-phong"],"marketing_gui":"Kế hoạch Hạng mục, sản phẩm truyền thông, báo cáo kết quả của cơ sở","don_vi_phu_trach":"Duyệt nội dung kinh doanh và tiền của cơ sở: ngân sách cơ sở, ưu đãi, giá, khả năng tiếp nhận. Bác sĩ xác nhận chuyên môn. Chịu trách nhiệm tổng khách hàng, doanh thu của cơ sở","marketing_nhan":"Dịch vụ trọng tâm, nhu cầu tháng (qua Trưởng nhóm), chủ đề, bác sĩ, ý kiến đánh giá theo tuyến","can_cu":"mục 4.2; mục 14.13; mục 16, số 10"},{"don_vi":["cc"],"marketing_gui":"Thông tin dịch vụ, Hạng mục, ưu đãi đã duyệt để Contact Center tự soạn kịch bản tư vấn; tiêu chí Lead hợp lệ; kịch bản trả lời đánh giá; thông tin Hạng mục, ưu đãi đang triển khai; Kịch bản tư vấn bảo hiểm (mảng 45), kịch bản trả lời khi có kênh mạo danh (QT.27)","don_vi_phu_trach":"Tiếp nhận mọi nguồn đa kênh (tổng đài 19002675, hotline di động của các cơ sở, tin nhắn trên mọi kênh (Facebook, Trang Zalo chính thức, TikTok, YouTube, Threads, website, App TTH), bình luận hỏi dịch vụ, email, form trên website, App TTH, trang đích), đánh giá thông thường, chăm sóc Lead, gọi chăm sóc khách hàng cũ","marketing_nhan":"Lead đã xử lý, lịch hẹn; đánh giá nhạy cảm chuyển Chuyên viên truyền thông; báo cáo trực cuối ngày; báo cáo phản hồi khách hàng tháng","can_cu":"mục 17; mục 30; mục 31, mảng 17"},{"don_vi":["tiep-don"],"marketing_gui":"Nguồn khách theo Hạng mục, theo đợt gửi tin","don_vi_phu_trach":"Ghi nguồn khách khi khách đến; tiếp đón khách tái khám","marketing_nhan":"Số khách theo nguồn khách để đối soát","can_cu":"mục 31, mảng 18, 32"},{"don_vi":["xu-ly-phan-anh"],"marketing_gui":"Phản ánh nhận qua kênh số (Contact Center, Marketing cơ sở chuyển)","don_vi_phu_trach":"Giải quyết nội dung phản ánh; trả lời người phản ánh qua kênh riêng","marketing_nhan":"Kết quả giải quyết, làm đầu vào trả lời công khai","can_cu":"mục 11.1, số 6; mục 17"},{"don_vi":["so-hoa"],"marketing_gui":"Yêu cầu nghiệp vụ (Quản lý sản phẩm số là đầu mối duy nhất); bộ nhận diện số (Chuyên viên thiết kế của nhóm); yêu cầu nghiệp vụ, quy tắc dữ liệu, danh sách quyền theo vị trí của từng hệ thống (chủ nghiệp vụ, mục 17.2); phần nội dung của hồ sơ website, App TTH","don_vi_phu_trach":"Thiết kế giao diện, lập trình, vận hành kỹ thuật website, App TTH, website các chuỗi, mẫu trang đích, phần mềm Quản trị Marketing (02 phân hệ, mục 17.2); trỏ tên miền, cài chứng chỉ bảo mật trên website; hồ sơ pháp lý, thủ tục của website, App TTH (chủ trì, nộp; mảng 38); phần kỹ thuật của hệ thống phần mềm Marketing, trừ CRM, hộp thư dùng chung (mục 17.2): cài đặt, kết nối, chuyển dữ liệu, tạo tài khoản theo danh sách quyền, cài mã theo dõi, SEO kỹ thuật; kết nối HIS với website, App TTH cho lịch làm việc của bác sĩ (mục 28, số 50); kết nối form, trang đích trên website, App TTH với CRM","marketing_nhan":"Bản phát hành theo lịch định kỳ; lỗi xử lý theo 03 mức; KPI-41 chỉ tiêu chung","can_cu":"mục 11.1, số 5; mục 17"},{"don_vi":["cnnvy"],"marketing_gui":"Danh mục tên miền, yêu cầu hộp thư chức danh, quyền sổ theo dõi dùng chung; yêu cầu nghiệp vụ, quy tắc dữ liệu, danh sách quyền CRM (Chuyên viên dữ liệu khách hàng và thị trường)","don_vi_phu_trach":"Phần mềm phát màn hình, kho tư liệu; đăng ký, gia hạn, theo dõi hạn tên miền, chứng chỉ bảo mật (SSL); kết nối hệ thống; hồ sơ tên miền, chứng chỉ bảo mật cho hồ sơ website, App TTH (mảng 38); dữ liệu lịch làm việc của bác sĩ trên HIS (mục 28, số 50); kỹ thuật, kết nối CRM, hộp thư dùng chung (tổng đài 19002675, hotline di động, email, form, HIS), chuyển dữ liệu, tạo tài khoản theo danh sách quyền (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026)","marketing_nhan":"Hạ tầng, tài khoản, kết nối","can_cu":"mục 17; mục 28, số 21, 23"},{"don_vi":["nhan-luc","tuyen-dung"],"marketing_gui":"Định biên, mô tả vị trí, đầu vào lương thưởng; sản phẩm truyền thông tuyển dụng; dự thảo quy tắc ứng xử mạng xã hội","don_vi_phu_trach":"Chức danh, chế độ, lương thưởng, phương án sử dụng lao động; tuyển dụng; ban hành quy tắc ứng xử","marketing_nhan":"Nội dung tuyển dụng; quyết định nhân sự; báo nghỉ việc để thu hồi quyền kênh trong 48 giờ","can_cu":"mục 17; mục 14.7"},{"don_vi":["qlcl"],"marketing_gui":"Thông tin truyền thông khi có sự cố; Phản hồi trải nghiệm người bệnh trên kênh số, NPS (mảng 44)","don_vi_phu_trach":"Sự cố y khoa; khảo sát hài lòng người bệnh; cập nhật Sổ quy định","marketing_nhan":"Thông tin sự cố để xử lý truyền thông; Kết quả khảo sát hài lòng người bệnh theo quy định (mảng 44)","can_cu":"mục 17; mục 31, mảng 23"},{"don_vi":["phap-che"],"marketing_gui":"Sản phẩm rủi ro cao; hồ sơ thủ tục khi pháp luật yêu cầu; Bằng chứng mạo danh (QT.27); đề nghị xác nhận danh mục thông tin phải công khai, hình thức chăm sóc người giới thiệu (mục 28, số 46, 47)","don_vi_phu_trach":"Ý kiến pháp lý; đăng ký nhãn hiệu; bảo vệ dữ liệu cá nhân; nộp hồ sơ; thông báo thay đổi pháp luật quảng cáo y tế","marketing_nhan":"Ý kiến pháp lý; thông báo thay đổi để cập nhật danh sách kiểm tra; Đánh giá pháp lý, báo cơ quan chức năng khi mạo danh có dấu hiệu lừa đảo; danh mục thông tin phải công khai","can_cu":"mục 17; mục 11.2"},{"don_vi":["hcqt"],"marketing_gui":"Đề nghị sửa chữa biển bảng, thiết bị màn hình","don_vi_phu_trach":"Bản tin nội bộ, chủ trương; lắp đặt, bảo trì thiết bị màn hình; sửa chữa vật lý biển bảng","marketing_nhan":"Thiết bị, biển bảng được sửa chữa","can_cu":"mục 17; mục 28, số 8"},{"don_vi":["ke-toan","mua-sam"],"marketing_gui":"Tờ trình, hồ sơ khoản chi theo Hạng mục","don_vi_phu_trach":"Giá dịch vụ; đối chiếu chi; mua sắm theo quy định (Phòng Tài chính – Kế hoạch chủ trì); Giá dịch vụ để công khai trên website, App TTH (mảng 43)","marketing_nhan":"Xác nhận chi, số đối chiếu tổng chi","can_cu":"mục 31, mảng 30, 36"},{"don_vi":["winmed"],"marketing_gui":"Kế hoạch, sản phẩm truyền thông, quảng cáo (nhóm 2)","don_vi_phu_trach":"Cử đầu mối; gửi nhu cầu qua cổng tiếp nhận yêu cầu; xác nhận thông tin sản phẩm, dịch vụ; không triển khai quảng cáo song song","marketing_nhan":"Nhu cầu ngày 20–25; thông tin sản phẩm","can_cu":"mục 11.1, số 4; mục 17; mục 28, số 13"},{"don_vi":["ctxh"],"marketing_gui":"Ấn phẩm giáo dục sức khỏe; truyền thông hoạt động","don_vi_phu_trach":"Từ thiện, hỗ trợ người bệnh; phát ấn phẩm giáo dục sức khỏe (chờ văn bản)","marketing_nhan":"Thông tin hoạt động","can_cu":"mục 17; mục 28, số 10"},{"don_vi":["tue-duc-thien"],"marketing_gui":"Kế hoạch, sản phẩm truyền thông, quảng cáo, hồ sơ năng lực (nhóm 2)","don_vi_phu_trach":"Công ty xây dựng trong Tập đoàn. Cử đầu mối; gửi nhu cầu qua cổng tiếp nhận yêu cầu; xác nhận thông tin công trình, dịch vụ; trả lời tin nhắn trên kênh của công ty; không triển khai quảng cáo song song","marketing_nhan":"Nhu cầu ngày 20–25; thông tin công trình, dịch vụ","can_cu":"mục 3; mục 11.1, số 4; mục 17; mục 28, số 39"},{"don_vi":["don-vi-chuyen-mon"],"marketing_gui":"Đề xuất chương trình trọng điểm; danh sách bài nội dung y khoa cần xác nhận lại","don_vi_phu_trach":"Nội dung chuyên môn của chương trình áp dụng từ 02 cơ sở; chuyển tuyến; danh sách người hành nghề, danh mục dịch vụ, kỹ thuật được phép của cơ sở","marketing_nhan":"Nội dung chuyên môn đã duyệt; danh mục được phép làm căn cứ công khai, kiểm tra trước khi quảng cáo","can_cu":"mục 17; mục 31, mảng 3, 21, 43; mục 28, số 46"}],"contact_center":{"gioi_thieu":"Contact Center là cổng tiếp nhận yêu cầu từ xa tập trung toàn hệ thống cho mọi nguồn đa kênh: tổng đài 19002675, hotline di động của các cơ sở, tin nhắn trên mọi kênh (Facebook, Trang Zalo chính thức, TikTok, YouTube, Threads, website, App TTH), bình luận hỏi dịch vụ, email, form trên website, App TTH, trang đích (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026); mọi nguồn về một hộp thư dùng chung, CRM khi có, gắn nguồn khách. Không phải bộ phận chăm sóc khách hàng tại cơ sở. Đơn vị chủ quản, thời điểm vận hành: Ban Tổng Giám đốc quyết định (mục 28, số 11). Kế hoạch hoạt động năm 2026 giao Phòng Marketing chủ trì xây dựng hệ thống Hotline 1900. Contact Center là bộ phận nghiệp vụ ngoài Marketing, giữ một bộ kịch bản thống nhất cho toàn hệ thống với các biến thể đã kiểm soát theo cơ sở, dịch vụ và chương trình.","marketing_giao":["Thông tin về thông điệp, tên dịch vụ, chương trình, ưu đãi và nội dung quảng cáo đã được phê duyệt; Marketing không biên soạn, quản lý hoặc phê duyệt kịch bản tư vấn nghiệp vụ","Tiêu chí Lead hợp lệ và yêu cầu đo lường nguồn khách do Chuyên viên đo lường và đối soát bàn giao","Mẫu phản hồi đánh giá công khai về thương hiệu do Chuyên viên truyền thông đúng nhóm chủ trì; khác với kịch bản tư vấn nghiệp vụ do Contact Center chủ trì","Thông điệp và điều kiện chương trình đã được phê duyệt, có mã phiên bản, ngày hiệu lực và đầu mối giải đáp","Lead từ quảng cáo, trang đích và kênh số, có nguồn khách và căn cứ xử lý dữ liệu hợp pháp","Phản hồi từ cơ sở về những câu hỏi khách hàng thường gặp để Contact Center tổng hợp, cập nhật kịch bản"],"contact_center_lam":["Tiếp nhận theo ca mọi nguồn đa kênh: tổng đài 19002675, hotline di động của các cơ sở, tin nhắn trên mọi kênh (Facebook, Trang Zalo chính thức, TikTok, YouTube, Threads, website, App TTH), bình luận hỏi dịch vụ, email, form trên website, App TTH, trang đích","Lọc Lead hợp lệ, tư vấn, đặt lịch","Chăm sóc Lead; gọi chăm sóc khách hàng cũ","Trả lời tin khách gửi lại sau đợt gửi tin","Trả lời đánh giá thông thường theo kịch bản","Báo cáo trực cuối ngày; báo cáo phản hồi khách hàng tháng","Tư vấn quyền lợi bảo hiểm, bảo lãnh viện phí theo kịch bản (mảng 45)","Hướng dẫn khách khi gặp kênh mạo danh; báo Chuyên viên truyền thông của nhóm có thương hiệu bị mạo danh (QT.27)","Gọi khảo sát trải nghiệm người bệnh khi vận hành (mảng 44)","Chủ trì viết, chuẩn hóa, quản lý phiên bản, đào tạo và kiểm soát chất lượng kịch bản tư vấn; chỉ sử dụng thông tin dịch vụ, gói khám, giá và điều kiện đã được cơ sở/chuyên môn xác nhận","Quản lý kho tri thức nghiệp vụ thống nhất: dịch vụ/gói, giá, điều kiện, lịch tiếp nhận, câu hỏi thường gặp; gắn từng phiên bản với cơ sở áp dụng, ngày hiệu lực, người xác nhận và người phê duyệt"],"chuyen_tiep":["Lịch hẹn → bộ phận tiếp đón của cơ sở","Phản ánh → bộ phận tiếp nhận, xử lý phản ánh của cơ sở","Đánh giá nhạy cảm → Chuyên viên truyền thông của nhóm","Dấu hiệu khủng hoảng → lịch trực sự cố","Số liệu Lead, đặt lịch → Chuyên viên đo lường và đối soát"],"khong_lam":["Giải quyết nội dung phản ánh: bộ phận tiếp nhận, xử lý phản ánh của cơ sở","Trả lời đánh giá nhạy cảm, khủng hoảng: Chuyên viên truyền thông của nhóm","Gửi tin hàng loạt, gửi tự động: Chuyên viên quảng cáo và kênh số của nhóm, theo lịch gửi chung của Chuyên viên dữ liệu khách hàng và thị trường","Tiếp đón, hướng dẫn tại cơ sở: theo cơ cấu của cơ sở","Tin nhắn trên kênh của Công ty TNHH Tuệ Đức Thiện: đầu mối của công ty trả lời","Không tự xác nhận hoặc thay đổi chỉ định y khoa, giá, điều kiện gói dịch vụ, quyền lợi bảo hiểm, lịch bác sĩ; khi không chắc chắn phải chuyển người phụ trách chuyên môn/cơ sở","Không dùng kịch bản khi thiếu xác nhận nguồn hoặc thiếu phê duyệt nghiệp vụ; không biến kịch bản tư vấn thành nội dung quảng cáo chưa được kiểm soát"],"kpi":[{"kpi":"KPI-18","chiu_trach_nhiem":"Contact Center"},{"kpi":"KPI-19","chiu_trach_nhiem":"Contact Center; phần gửi tự động, gửi tin hàng loạt: Chuyên viên quảng cáo và kênh số của nhóm"},{"kpi":"KPI-05","chiu_trach_nhiem":"Chuyên viên quảng cáo và kênh số của nhóm; chỉ tiêu chung với Contact Center"},{"kpi":"KPI-15","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm; dữ liệu: Chuyên viên dữ liệu khách hàng và thị trường"},{"kpi":"KPI-16","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm; dữ liệu: Chuyên viên dữ liệu khách hàng và thị trường"},{"kpi":"KPI-17","chiu_trach_nhiem":"Quản lý thương hiệu của nhóm; dữ liệu: Chuyên viên dữ liệu khách hàng và thị trường"},{"kpi":"KPI-20","chiu_trach_nhiem":"Chờ chốt với Phòng Quản lý chất lượng"},{"kpi":"KPI-21","chiu_trach_nhiem":"Chờ chốt với Phòng Quản lý chất lượng"}],"kpi_can_cu":"mục 9; mục 12.2","khi_chua_co":["Hiện nay (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026): Bệnh viện Răng hàm mặt và Phẫu thuật tạo hình thẩm mỹ Thái Thượng Hoàng có trả lời tự động bằng trí tuệ nhân tạo; Bệnh viện Đa khoa TTH Vinh, Bệnh viện Y học cổ truyền Nguyên Phúc, Bệnh viện Đa khoa TTH Hà Tĩnh, Bệnh viện Đa khoa TTH Quảng Bình: nhân viên tư vấn hoặc Phát triển dịch vụ của bệnh viện kiêm nhiệm; không thuộc định biên Marketing","Trước khi Contact Center nhận: người đang trả lời tin nhắn tại cơ sở giữ việc. Khi quyền kênh chuyển về Tổng công ty (Giai đoạn 2), người này được cấp quyền chỉ trả lời tin nhắn trên hộp thư dùng chung; không đăng bài, không sửa trang; Lead ghi vào hộp thư dùng chung, gắn nguồn khách (Đề xuất – chờ duyệt)","Hộp thư của từng cơ sở chuyển Contact Center khi Contact Center nhận. Contact Center là điều kiện chuyển hộp thư, không là điều kiện của Giai đoạn 2","Cơ sở mới chưa có người trả lời tin nhắn: Ban Giám đốc cơ sở bố trí người (bộ phận tư vấn hoặc Phát triển dịch vụ) từ trước khai trương đến khi Contact Center nhận (Đề xuất – chờ duyệt; QT.9)","Hotline di động của cơ sở giữ người đang trực tại cơ sở; Lead ghi vào hộp thư dùng chung, gắn nguồn khách (Đề xuất – chờ duyệt)","Kênh cấp hệ thống, kênh của Công ty Cổ phần Winmed Việt Nam: người đang trả lời hiện nay giữ việc theo cùng quy tắc","Gọi chăm sóc khách hàng cũ tạm chưa thực hiện; tin chăm sóc tự động cho khách đã đồng ý vẫn gửi","Thí điểm Giai đoạn 1 tại bệnh viện thí điểm: hộp thư dùng chung, nguồn khách, sổ Lead; đo lượng tin nhắn, cuộc gọi theo giờ","Đầu mối phía Marketing: Chuyên viên đo lường và đối soát nhận số liệu tin nhắn, Lead, đặt lịch theo nguồn khách; Phòng Marketing không lập lịch ca, không quản lý người trả lời tin nhắn","Định biên, giờ trực, nguồn người của Contact Center: tham mưu ở mục 17.3; đơn vị chủ quản quyết định (mục 28, số 11, 33)"],"khi_chua_co_can_cu":"mục 17; mục 28, số 11, 33, 44","khi_chua_co_de_xuat":true,"crm":["Chủ trì dự án: Trưởng phòng Marketing","Chủ nghiệp vụ dữ liệu khách hàng: Chuyên viên dữ liệu khách hàng và thị trường","Đầu mối Contact Center: Chuyên viên đo lường và đối soát","Đầu mối yêu cầu, nghiệm thu với Phòng Công nghệ – Nghiệp vụ Y: Chuyên viên dữ liệu khách hàng và thị trường; kết nối form, trang đích trên website, App TTH: Quản lý sản phẩm số với Phòng Số hóa","Kỹ thuật, kết nối (tổng đài 19002675, hotline di động, email, form, HIS): Phòng Công nghệ – Nghiệp vụ Y (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026)","Lộ trình, quyền, dữ liệu, quy tắc chặn R1–R7: mục 17.1 (Đề xuất – chờ duyệt); quy trình mẫu: QT.25"],"crm_can_cu":"mục 11.1, số 37; mục 17.1","crm_de_xuat":false,"con_thieu":["Đơn vị chủ quản, thời điểm vận hành (Ban Tổng Giám đốc)","Lượng tin nhắn, cuộc gọi theo giờ, theo ca để tính số người trực (đo ở thí điểm Giai đoạn 1)","Mốc thời hạn phản hồi chuẩn làm căn cứ KPI-18; khung giờ trực, xử lý ngoài giờ","Thời hạn chuyển phản ánh cho cơ sở và thời hạn cơ sở báo lại kết quả","Danh sách kênh đưa về hộp thư dùng chung (Phòng Marketing lập)","Nền tảng CRM; quy tắc đồng ý, lưu trữ dữ liệu khách hàng","Nền tảng CRM, ngân sách (Ban Tổng Giám đốc, mục 28, số 45)"],"dinh_bien":[{"buoc":"1. Mở đầu","thoi_diem":"Cùng thí điểm Giai đoạn 1 (Quý I/2027)","pham_vi":"Bệnh viện thí điểm","cho_truc":"01 chỗ trực ghép cuộc gọi, tin nhắn","gio_thang":487,"so_nguoi":4,"cach_tinh":"487 ÷ 142 = 3,43; 01 người kiêm Trưởng nhóm Contact Center"},{"buoc":"2. Toàn hệ thống","thoi_diem":"Trước đợt chuyển hộp thư của Giai đoạn 2 (Quý II/2027)","pham_vi":"05 bệnh viện, 02 phòng khám, kênh cấp hệ thống, kênh của Công ty Cổ phần Winmed Việt Nam","cho_truc":"02 chỗ trực (cuộc gọi; tin nhắn, bình luận, email, form); Trưởng nhóm Contact Center giờ hành chính","gio_thang":1116,"so_nguoi":8,"cach_tinh":"974 ÷ 142 = 6,86 → 07; Trưởng nhóm 01"},{"buoc":"3. Gọi chăm sóc","thoi_diem":"Khi bắt đầu gọi chăm sóc khách hàng cũ, gọi khảo sát","pham_vi":"Như bước 2","cho_truc":"+01 người gọi ra trong giờ hành chính","gio_thang":1258,"so_nguoi":9,"cach_tinh":"+142 giờ"},{"buoc":"4. Mở rộng","thoi_diem":"Cơ sở mới hoặc khi số đo vượt ngưỡng","pham_vi":"Theo cơ sở mới","cho_truc":"+01 chỗ trực","gio_thang":null,"so_nguoi":null,"cach_tinh":"+487 giờ/chỗ trực; mức tham chiếu khi đủ 10 bệnh viện: 03 chỗ trực, 13 người"}],"dinh_bien_can_cu":"mục 17.3; mục 6; QyĐ.02.MKT phiên bản 3.0, mục 5.5.2","dinh_bien_de_xuat":true,"ghi_chu_phan_quyen":"Contact Center chủ trì biên soạn, bảo trì, đào tạo và vận hành kịch bản tư vấn (ngoài định biên Marketing). Bộ phận quản lý dịch vụ/tiếp đón tại cơ sở lập bản thông tin đầu vào, tình huống thực tế và phương án trả lời; bác sĩ/chuyên môn xác nhận phần y tế; bộ phận có thẩm quyền xác nhận giá, ưu đãi, điều kiện và khả năng tiếp nhận. Marketing cung cấp thông điệp hoặc nội dung chiến dịch đã duyệt, kiểm tra ngôn ngữ thương hiệu khi liên quan. Người được phân quyền ở đơn vị chủ quản Contact Center phê duyệt kịch bản nghiệp vụ sau khi có các xác nhận bắt buộc; Marketing không tự động có quyền duyệt kịch bản nghiệp vụ. Trước khi Contact Center tiếp nhận, bộ phận tư vấn được cơ sở phân công giữ nhiệm vụ dưới quản lý của cơ sở.","quy_trinh_quan_ly_kich_ban_18112026":[{"buoc":1,"ten":"Cơ sở cung cấp dữ liệu","chu_tri":"Bộ phận quản lý dịch vụ/tiếp đón tại cơ sở","dau_ra":"Phiếu thông tin gói, giá, điều kiện, câu hỏi thường gặp, nguồn chứng cứ và người phụ trách"},{"buoc":2,"ten":"Xác nhận nguồn nghiệp vụ","chu_tri":"Bộ phận chuyên môn, đơn vị quản lý giá/dịch vụ có thẩm quyền","dau_ra":"Xác nhận chuyên môn, thông tin giá, bảo hiểm, lịch, giới hạn tư vấn và ngày hiệu lực"},{"buoc":3,"ten":"Biên soạn kịch bản","chu_tri":"Contact Center","dau_ra":"Kịch bản gốc tập trung và nhánh theo dịch vụ, cơ sở, tình huống; có quy tắc chuyển tuyến"},{"buoc":4,"ten":"Kiểm tra thông điệp khi cần","chu_tri":"Marketing đúng nhóm thương hiệu","dau_ra":"Đối chiếu thông điệp/chương trình đã duyệt; không thay quyền xác nhận chuyên môn"},{"buoc":5,"ten":"Phê duyệt và phát hành","chu_tri":"Người có thẩm quyền thuộc đơn vị chủ quản Contact Center","dau_ra":"Mã phiên bản, lịch hiệu lực, phạm vi áp dụng, nhật ký duyệt, hướng dẫn sử dụng"},{"buoc":6,"ten":"Đánh giá và cập nhật","chu_tri":"Contact Center","dau_ra":"Theo dõi lỗi tư vấn, thay đổi gói/giá/lịch, phản hồi cơ sở, thu hồi phiên bản cũ"}],"quy_tac_chan_kich_ban_18112026":["Thiếu dữ liệu hoặc chứng cứ nguồn: không được tự viết thành cam kết tư vấn.","Thiếu xác nhận y khoa/giá/điều kiện tương ứng: khóa nội dung đó, chuyển cơ sở xác minh.","Thiếu phê duyệt nghiệp vụ hoặc hết hiệu lực: không phát hành, không dùng bản cũ.","Khách hỏi chẩn đoán, chỉ định, kết quả điều trị: chuyển nhân sự y tế phù hợp.","Trước khi thực hiện cuộc gọi quảng bá, kiểm tra điều kiện pháp lý về quảng cáo, dữ liệu và sự đồng ý liên quan."]},"quy_trinh":[{"id":"hang-muc","ten":"Hạng mục trọng điểm","nhom_hoat_dong":["N1","N2","N8","N3","N4","N9","N10"],"vi_du":"Bệnh viện Đa khoa TTH Vinh triển khai gói khám sức khỏe doanh nghiệp trong Quý I. Nhóm 1: Quản lý thương hiệu nhóm 1 chịu trách nhiệm kết quả.","buoc":[{"thuc_hien":["tn-a"],"phoi_hop":["bgd-coso"],"noi_dung":"Thống nhất nhu cầu với Ban Giám đốc bệnh viện (dịch vụ, đối tượng, ưu đãi dự kiến, khả năng tiếp nhận), gửi nhu cầu tháng.","thoi_han":"Ngày 10–15","ghi_nhan":"Phần mềm: nhu cầu tháng","can_cu":"mục 16, số 12","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Trang tính nhu cầu tháng"},{"thuc_hien":["qlth-a"],"phoi_hop":["dl-1","qc-a"],"noi_dung":"Lập Hạng mục: mục tiêu chiến lược chính MT1; chỉ tiêu KPI-01 (khách), KPI-04 (Lead hợp lệ); hạn mức chi; danh sách Hoạt động. Chuyên viên đo lường và đối soát ghi cách đo, nguồn khách; Chuyên viên quảng cáo và kênh số nhóm 1 ghi yêu cầu kênh.","thoi_han":"Trình chậm nhất ngày 18, cùng kế hoạch tháng (BM-3)","ghi_nhan":"Phần mềm: Hạng mục","can_cu":"mục 13; mục 14.5","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["tp","gd-coso"],"phoi_hop":["btgd|chi mới ngoài hạn mức: Tổng Giám đốc","ptgd-tc|chi trong hạn mức đã duyệt"],"noi_dung":"Giám đốc bệnh viện xác nhận mức chi dự kiến từ bước đề xuất. Trưởng phòng duyệt kế hoạch Hạng mục; Giám đốc bệnh viện ký tờ trình chi. Hạng mục dùng ngân sách Tổng công ty hoặc nhiều cơ sở: chi trong hạn mức đã duyệt – Phó Tổng Giám đốc mảng tài chính; chi mới ngoài hạn mức – Tổng Giám đốc (R28).","thoi_han":"Duyệt chậm nhất ngày 20","ghi_nhan":"Tờ trình trên phần mềm","can_cu":"mục 4.2; mục 16, số 9","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["qlth-a"],"phoi_hop":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"noi_dung":"Quản lý thương hiệu nhóm 1 gửi yêu cầu sản xuất qua cổng tiếp nhận (kết quả cần đạt, thông điệp, đối tượng, hạn). Đủ ô bắt buộc thì tự xác nhận, giao theo bảng phân công; yêu cầu cần Tổ trưởng xử lý (thiếu nội dung, gấp, vượt công suất, ngoài bộ): Tổ trưởng xử lý trong 04 giờ làm việc; người làm theo người phụ trách nhóm 1: Chuyên viên biên tập nhóm 1, Chuyên viên thiết kế nhóm 1, Chuyên viên media nhóm 1.","thoi_han":"Tự xác nhận khi đủ ô; yêu cầu cần Tổ trưởng xử lý 04 giờ làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu; sổ theo dõi yêu cầu","can_cu":"mục 14.5; mục 16, số 14","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["mdcs-a"],"phoi_hop":["khoa-phong"],"noi_dung":"Ghi hình, chụp ảnh bác sĩ và quy trình khám tại bệnh viện theo kịch bản; đưa tư liệu lên kho tư liệu.","thoi_han":"Trong ngày","ghi_nhan":"kho tư liệu","can_cu":"mục 15.3; QyĐ.04.MKT; mục 31, mảng 9","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["bt-ac","tk-a","md-ac"],"phoi_hop":["bac-si|xác nhận chuyên môn","bt-ac|người còn lại trong nhóm – kiểm pháp lý tầng 1","tk-nt|xác nhận kỹ thuật file in; biển bảng, phương tiện quảng cáo cố định nếu Hạng mục có","qlth-a|nghiệm thu nội dung chữ trước khi gửi thiết kế"],"noi_dung":"Chuyên viên biên tập nhóm 1 viết bài, kịch bản; bác sĩ xác nhận chuyên môn; Chuyên viên biên tập nhóm 1 còn lại kiểm pháp lý tầng 1 theo danh sách kiểm tra. Quản lý thương hiệu nhóm 1 nghiệm thu nội dung chữ trước khi gửi thiết kế (yêu cầu hợp lệ phải có nội dung đã duyệt, mục 14.6). Chuyên viên thiết kế nhóm 1 làm hình ảnh chủ đạo và mọi sản phẩm của Hạng mục, cả bản số và bản in (tờ rơi, băng rôn, standee); file in qua Chuyên viên thiết kế ngoại tuyến xác nhận kỹ thuật (mục 15.2). Chuyên viên media nhóm 1 dựng video từ tư liệu trong kho tư liệu.","thoi_han":"Bài kiến thức 03 ngày làm việc; thiết kế cấp 3–4: 05–10 ngày làm việc; video chiến dịch 07 ngày làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.7; mục 15.2; mục 15.6","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlth-a"],"phoi_hop":["tp|nội dung thuộc QyĐ.03.MKT mục 5.2"],"noi_dung":"Quản lý thương hiệu nhóm 1 nghiệm thu đúng yêu cầu, tối đa 02 vòng chỉnh sửa. Phần mềm chặn phát hành khi thiếu bước (chất lượng, pháp lý, bác sĩ xác nhận, nghiệm thu); chưa có phần mềm: người đăng kiểm cột các bước trên sổ yêu cầu.","thoi_han":"Theo lịch đã xếp","ghi_nhan":"Sổ theo dõi: số vòng chỉnh sửa","can_cu":"mục 14.5","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qc-a","cvtt-a","qhcs"],"phoi_hop":["qlsps|nghiệm thu trang đích","dl-1|form, nguồn khách","qlth-a|duyệt ngân sách quảng cáo (mục 14.5, bước 7)"],"noi_dung":"Chuyên viên quảng cáo và kênh số nhóm 1 dựng trang đích từ mẫu, triển khai quảng cáo, đăng trên kênh của bệnh viện. Chuyên viên truyền thông nhóm 1 thuê căng treo băng rôn, phát tờ rơi, mua truyền thanh (file in: Chuyên viên thiết kế nhóm 1, đã xác nhận kỹ thuật). Truyền thông cơ sở làm việc với doanh nghiệp.","thoi_han":"Trang đích 05 ngày làm việc; quảng cáo 02 ngày làm việc sau khi nhận đủ sản phẩm","ghi_nhan":"Phần mềm: Hoạt động","can_cu":"mục 14.7; mục 11.2; mục 31, mảng 10, 11","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["cc|trước khi nhận: người đang trả lời tại cơ sở"],"phoi_hop":["tiep-don"],"noi_dung":"Tiếp nhận Lead, tư vấn theo kịch bản, đặt lịch. Khách đến: bộ phận tiếp đón ghi nguồn khách.","thoi_han":"Đúng thời hạn phản hồi (KPI-18)","ghi_nhan":"Hộp thư dùng chung; CRM khi có","can_cu":"mục 17; mục 31, mảng 17","de_xuat":false,"thu_tu":9,"chua_co_phan_mem":"Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng"},{"thuc_hien":["qlth-a","tn-a"],"phoi_hop":[],"noi_dung":"Rà tiến độ trên phần mềm. Điều chỉnh trong ngưỡng: Quản lý thương hiệu nhóm 1 quyết định. Vượt ngưỡng: lập tờ trình.","thoi_han":"Hằng tuần","ghi_nhan":"Phần mềm","can_cu":"mục 13","de_xuat":false,"thu_tu":10,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-1","qlth-a","tp"],"phoi_hop":["ke-toan|đối chiếu chi"],"noi_dung":"Chuyên viên đo lường và đối soát đối soát Lead, khách, doanh thu được ghi nhận. Quản lý thương hiệu nhóm 1 lập báo cáo tổng kết. Trưởng phòng nghiệm thu Hạng mục.","thoi_han":"Báo cáo nhanh 01 ngày sau khi kết thúc; kết quả chính thức sau kỳ chốt số liệu (mục 14.7)","ghi_nhan":"Mẫu Báo cáo Hạng mục trọng điểm","can_cu":"QT.MKT.22; mục 14.7","de_xuat":false,"thu_tu":11,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung; Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["07 bước Chiến dịch chuyển đổi (mục 12.1): N1 kế hoạch: bước 1–3; N2 nội dung: bước 4–7; N8 điểm chuyển đổi, N3 kênh sở hữu, N4 quảng cáo: bước 8; N9 chăm sóc Lead hợp lệ: bước 9; N10 đối soát: bước 10–11. Đầu ra mỗi bước ghi ở cột nơi ghi nhận","Đủ ô bắt buộc thì tự xác nhận, giao theo bảng phân công; yêu cầu cần Tổ trưởng xử lý (thiếu nội dung, gấp, vượt công suất, ngoài bộ): Tổ trưởng Tổ Nội dung và Sáng tạo xử lý trong 04 giờ làm việc. Chưa có phần mềm: người nhận việc kiểm đủ ô trên sổ yêu cầu dùng chung; thiếu ô thì chuyển Tổ trưởng xử lý","Bác sĩ xác nhận chuyên môn trước khi phát hành","Chuyên viên biên tập nhóm 1 và Chuyên viên biên tập nhóm 1 còn lại kiểm pháp lý tầng 1 cho nhau","Tối đa 02 vòng chỉnh sửa","Chi trong hạn mức đã duyệt; kế toán đối chiếu","Nguồn khách đi từ quảng cáo đến quầy tiếp đón"],"ngoai_le":[{"tinh_huong":"Yêu cầu thiếu nội dung","cach_lam":"Có phần mềm: không gửi được khi thiếu ô bắt buộc. Ô có nhưng nội dung không dùng được: Tổ trưởng Tổ Nội dung và Sáng tạo trả lại kèm danh sách phần còn thiếu trong 04 giờ làm việc; thời hạn chuẩn tính lại từ khi đủ."},{"tinh_huong":"Vượt công suất","cach_lam":"Tổ trưởng Tổ Nội dung và Sáng tạo đề xuất hạn mới trong 04 giờ làm việc; Quản lý thương hiệu của nhóm đồng ý hạn mới hoặc lùi việc khác của nhóm mình theo thứ tự ưu tiên (mục 14.9)."},{"tinh_huong":"Bán, ký hợp đồng với doanh nghiệp","cach_lam":"Không thuộc Marketing: đơn vị do Ban Tổng Giám đốc xác định (mục 28, số 24)."},{"tinh_huong":"Hai Hạng mục trọng điểm cùng cần một người","cach_lam":"Trưởng phòng chọn thứ tự (mục 14.8)."},{"tinh_huong":"Gói khám, gói điều trị, ưu đãi mới của 01 cơ sở","cach_lam":"Khoa phòng, bác sĩ: nội dung chuyên môn (thành phần, chỉ định, chống chỉ định); kế toán: giá, phí; Ban Giám đốc cơ sở duyệt trước bước 2. Marketing không quyết nội dung chuyên môn, giá (mục 31, mảng 3). Chương trình từ 02 cơ sở: QT.26."},{"tinh_huong":"Khách khiếu nại ưu đãi, khuyến mại (hết hạn, điều kiện áp dụng)","cach_lam":"Bộ phận tiếp nhận, xử lý phản ánh của cơ sở giải quyết; Quản lý thương hiệu của nhóm cung cấp điều kiện ưu đãi đã duyệt; sản phẩm ghi sai: QT.38."},{"tinh_huong":"Bảo hiểm y tế, bảo hiểm sức khỏe, bảo lãnh viện phí","cach_lam":"Hạng mục theo quy trình này: Quản lý thương hiệu của nhóm (truyền thông quyền lợi; đối tác bảo hiểm cấp hệ thống: hồ sơ năng lực, truyền thông), Chuyên viên biên tập (nội dung), Contact Center (tư vấn theo kịch bản); Ban Giám đốc cơ sở duyệt nội dung quyền lợi tại cơ sở; ký kết đối tác: đơn vị được Ban Tổng Giám đốc giao (mục 31, mảng 45; mục 28, số 49)."}],"nhom_vi_du":"N1"},{"id":"yeu-cau-le","ten":"Yêu cầu sản xuất lẻ từ cơ sở","nhom_hoat_dong":["N2"],"vi_du":"Bệnh viện Đa khoa TTH Quảng Bình cần ấn phẩm thông báo lịch làm việc dịp Tết. Việc này không thuộc Hạng mục nào.","buoc":[{"thuc_hien":["tn-a"],"phoi_hop":[],"noi_dung":"Kiểm tra mẫu thiết kế sẵn thông báo vận hành dạng in. Có mẫu: Trưởng nhóm tự làm trên mẫu thiết kế sẵn.","thoi_han":"Khi phát sinh","ghi_nhan":"Thư viện mẫu thiết kế sẵn","can_cu":"mục 8; mục 10, mảng 6; mục 31, mảng 28","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Thư viện mẫu trên công cụ thiết kế"},{"thuc_hien":["tn-a"],"phoi_hop":["bgd-coso"],"noi_dung":"Cần sản phẩm mới: gửi yêu cầu qua cổng tiếp nhận, kèm nội dung chữ đã được duyệt, kích thước, hạn đề nghị.","thoi_han":"Không ngắn hơn thời hạn chuẩn","ghi_nhan":"Mẫu yêu cầu","can_cu":"mục 14.6","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"phoi_hop":[],"noi_dung":"Đủ ô bắt buộc thì phần mềm tự xác nhận, giao người theo bảng phân công và quy tắc hai bước (mục 15.2) (chưa có phần mềm: người nhận việc tự nhận theo bảng phân công ghi trên sổ yêu cầu); Tổ trưởng Tổ Nội dung và Sáng tạo chỉ xử lý yêu cầu cần Tổ trưởng xử lý trong 04 giờ làm việc. Ví dụ: thông báo vận hành dạng in không thuộc danh sách cố định nên giao Chuyên viên thiết kế của nhóm có cơ sở; ghi cấp độ: cấp 1 là sửa trên mẫu thiết kế sẵn (0,5 giờ); cấp 2 là sản phẩm mới trên nhận diện có sẵn (2,5 giờ).","thoi_han":"Tự xác nhận khi đủ ô; yêu cầu cần Tổ trưởng xử lý 04 giờ làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 15.2","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tk-a"],"phoi_hop":["tk-nt|xác nhận kỹ thuật file in","tk-a|giữ quy chuẩn bộ nhận diện chung của TTH"],"noi_dung":"Thiết kế trên mẫu thiết kế sẵn thông báo vận hành (số và in) của nhóm 1, áp dụng bộ nhận diện chung của TTH; xuất cả bản in và bản số. File in qua Chuyên viên thiết kế ngoại tuyến xác nhận kỹ thuật.","thoi_han":"Theo cấp độ","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 15.2; 15.6","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tn-a"],"phoi_hop":["cvtt-a|khi là biển, băng rôn"],"noi_dung":"Trưởng nhóm nghiệm thu; phát hành khi đủ bước kiểm, nghiệm thu; file in gửi bệnh viện. Biển, băng rôn: Chuyên viên truyền thông nhóm 1 vận hành phần thi công, nghiệm thu theo QyĐ.48.","thoi_han":"Duyệt 01 ngày làm việc (mục 14.16)","ghi_nhan":"Sổ theo dõi: ngày hoàn thành, số vòng chỉnh sửa, giờ làm","can_cu":"mục 14.5; mục 11.1, số 1","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"}],"kiem_soat":["Yêu cầu chỉ hợp lệ khi nội dung chữ đã duyệt","Sổ theo dõi ghi đủ mốc để tính tỷ lệ đúng hạn","Sản phẩm đúng quy chuẩn bộ nhận diện chung của TTH"],"ngoai_le":[{"tinh_huong":"Cần gấp hơn thời hạn chuẩn","cach_lam":"Dùng 25% giờ dự phòng; người gửi ghi lý do (mục 16, số 3)."},{"tinh_huong":"Thiếu nội dung","cach_lam":"Trả lại kèm danh sách phần thiếu."},{"tinh_huong":"Không thuộc phạm vi Marketing","cach_lam":"Trả lại, ghi rõ lý do (mục 14.6)."},{"tinh_huong":"Sản phẩm thuộc danh sách cố định (biển, trang trí, phương tiện quảng cáo cố định, trang trí lễ, Tết, phương tiện)","cach_lam":"Phần mềm giao Chuyên viên thiết kế ngoại tuyến theo danh sách cố định (chưa có phần mềm: người nhận yêu cầu giao theo danh sách cố định ghi trên sổ yêu cầu dùng chung); Chuyên viên thiết kế của nhóm có cơ sở kiểm tra tuân thủ nhận diện khi là mẫu mới (mục 11.1, số 1)."},{"tinh_huong":"Poster dịch vụ của khoa, bảng danh mục dịch vụ treo lâu dài tại khoa","cach_lam":"Khoa đề nghị qua Trưởng nhóm Marketing cơ sở, gửi cổng tiếp nhận yêu cầu (không tự in, C7). Chuyên viên biên tập của nhóm viết nội dung, kiểm pháp lý theo tầng; khoa phòng, bác sĩ xác nhận chuyên môn; Ban Giám đốc cơ sở duyệt giá, ưu đãi. Chuyên viên thiết kế của nhóm làm bản in và bản số; file in qua Chuyên viên thiết kế ngoại tuyến xác nhận kỹ thuật; khung, hộp đèn: Chuyên viên thiết kế ngoại tuyến. Thuộc Hạng mục: Quản lý thương hiệu gửi yêu cầu (QT.1)."},{"tinh_huong":"Ấn phẩm ngoại viện (QyĐ.03.MKT mục 5.2)","cach_lam":"; phát hành khi đủ bước kiểm, nghiệm thu; duyệt thêm theo mục 14.16, mảng 6: làm từ mẫu thiết kế sẵn: Chuyên viên trưởng; sản phẩm mới, cấp hệ thống, rủi ro cao: Trưởng phòng."}],"nhom_vi_du":"N1"},{"id":"tin-trong-ngay","ten":"Tin trong ngày tại cơ sở","nhom_hoat_dong":["N3","N6"],"vi_du":"Bệnh viện Răng hàm mặt và Phẫu thuật tạo hình thẩm mỹ Thái Thượng Hoàng tổ chức khám răng miễn phí cho học sinh một trường tiểu học. Bệnh viện 02 người: Trưởng nhóm kiêm truyền thông cơ sở.","buoc":[{"thuc_hien":["tn-b"],"phoi_hop":["khoa-phong|phần y tế","nha-truong","bgd-coso|duyệt kế hoạch, ngân sách","cvt|duyệt nội dung truyền thông (mục 14.16, mảng 20)"],"noi_dung":"Kế hoạch, kịch bản, tổng duyệt buổi khám theo QT.21, bước 1–4 (bệnh viện 02 người: Trưởng nhóm làm phần truyền thông cơ sở). Thu giấy đồng ý chụp ảnh của cha mẹ hoặc người giám hộ học sinh.","thoi_han":"Tổng duyệt trước 01 ngày","ghi_nhan":"Phần mềm: Hoạt động","can_cu":"QT.MKT.13; mục 31, mảng 20","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["mdcs-b"],"phoi_hop":[],"noi_dung":"Chụp ảnh, quay clip; đưa lên kho tư liệu; cắt clip ngắn, chỉnh ảnh cơ bản cho tin trong ngày.","thoi_han":"Trong ngày","ghi_nhan":"kho tư liệu","can_cu":"QyĐ.04.MKT","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["tn-b"],"phoi_hop":[],"noi_dung":"Chọn tin đúng danh mục V1 và đối chiếu nguồn; người có quyền đăng hợp lệ đăng trên Facebook bệnh viện, lưu nhật ký. Media cơ sở chỉ đăng thay khi có ủy quyền riêng, không mặc nhiên đăng khi Trưởng nhóm vắng. Nếu có giá, ưu đãi, kỹ thuật mới, ca bệnh phải chuyển duyệt.","thoi_han":"Trong 04 giờ sau sự kiện","ghi_nhan":"Facebook của bệnh viện","can_cu":"mục 16, số 5, 13; mục 16.1","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt-b"],"phoi_hop":["bt-ac|kiểm pháp lý ngang hàng – ngoại lệ, người trung lập cho phép có thời hạn (mục 15.4)"],"noi_dung":"Viết bài hoàn chỉnh nếu sự kiện thuộc danh mục bài.","thoi_han":"Trong 12 giờ làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 16, số 13","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["md-b","qc-b"],"phoi_hop":[],"noi_dung":"Biên tập nhóm 2 viết lời nếu tạo V2/V3; Media TCT cung cấp phân cảnh và kiểm kỹ thuật, nhận dựng phần vượt mẫu; Media cơ sở dựng V2/V3 theo B-7 nếu có đủ năng lực. Chuyên viên quảng cáo và kênh số nhóm 2 đăng TikTok, YouTube theo lịch và quyền khi đã duyệt.","thoi_han":"Video ngắn 03 ngày làm việc","ghi_nhan":"Lịch đăng","can_cu":"mục 6; mục 14.7","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Trang tính lịch đăng"}],"kiem_soat":["Không có thông tin sức khỏe của từng học sinh","Ảnh trẻ em có giấy đồng ý của cha mẹ hoặc người giám hộ","Tin cơ sở tự đăng không có dịch vụ, giá, ưu đãi, kỹ thuật mới, ca bệnh (mục 16, số 5)","Facebook cơ sở chỉ cho tin đúng danh mục V1 với quyền đăng hợp lệ; kênh TikTok, YouTube, website, App do Kênh số TCT chịu trách nhiệm phát hành.","Nhãn V2/V3 xác định cách sản xuất, không làm giảm bước kiểm duyệt nội dung y tế."],"ngoai_le":[{"tinh_huong":"Tin có dịch vụ, giá, ưu đãi, kỹ thuật mới","cach_lam":"Không đăng từ cơ sở; chuyển Chuyên viên biên tập qua cổng tiếp nhận yêu cầu (mục 31, mảng 5)."},{"tinh_huong":"Có phóng viên đến đưa tin","cach_lam":"Marketing cơ sở tiếp đón phóng viên; Chuyên viên truyền thông của nhóm phụ trách phần báo chí (mục 10, mảng 23)."},{"tinh_huong":"Trưởng nhóm và Chuyên viên Marketing cơ sở – media cùng vắng (bệnh viện 02 người)","cach_lam":"Người chính và người thay chính không nghỉ kế hoạch cùng lúc (mục 15.4). Vắng đột xuất: ảnh, thông tin gửi qua cổng tiếp nhận yêu cầu; Chuyên viên quảng cáo và kênh số của nhóm đăng khi đủ bước kiểm, nghiệm thu (mục 14.16) (Đề xuất – chờ duyệt)."}],"nhom_vi_du":"N2"},{"id":"lead","ten":"Từ Lead đến khách","nhom_hoat_dong":["N4","N9","N10"],"vi_du":"Quảng cáo gói khám tầm soát của Bệnh viện Đa khoa TTH Hà Tĩnh trong một Hạng mục nhóm 1.","buoc":[{"thuc_hien":["qc-a"],"phoi_hop":["dl-1","qlsps"],"noi_dung":"Triển khai quảng cáo dẫn về trang đích có form, mã theo dõi. Chuyên viên đo lường và đối soát kiểm tra form, nguồn khách trước khi phát hành. Website, App TTH có hộp đồng ý cho mã theo dõi.","thoi_han":"02 ngày làm việc sau khi nhận đủ sản phẩm","ghi_nhan":"Nền tảng quảng cáo; trang đích","can_cu":"mục 28, số 31","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["khach"],"phoi_hop":[],"noi_dung":"Khách điền form, nhắn tin, bình luận, gọi tổng đài 19002675 hoặc hotline di động, gửi email. Mọi nguồn về hộp thư dùng chung (CRM khi có), gắn nguồn khách.","thoi_han":"Khi phát sinh","ghi_nhan":"Hộp thư dùng chung; CRM","can_cu":"mục 17","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng"},{"thuc_hien":["cc|trước khi nhận: người đang trả lời tại cơ sở"],"phoi_hop":["dl-1|lập tiêu chí Lead hợp lệ; Trưởng phòng duyệt (mục 14.16, mảng 17)"],"noi_dung":"Phản hồi, lọc Lead hợp lệ theo tiêu chí, tư vấn theo kịch bản, đặt lịch.","thoi_han":"Đúng thời hạn phản hồi (KPI-18)","ghi_nhan":"CRM; lịch hẹn","can_cu":"mục 12.2","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng"},{"thuc_hien":["tiep-don","khoa-phong"],"phoi_hop":["tn-a|kiểm tra nguồn khách"],"noi_dung":"Khách đến khám: bộ phận tiếp đón ghi nguồn khách; khoa phòng thực hiện dịch vụ. Trường ghi nguồn khách trên HIS: chờ xác nhận (mục 28, số 53).","thoi_han":"Ngày khách đến","ghi_nhan":"HIS","can_cu":"mục 31, mảng 32","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Ghi tạm nguồn khách tại quầy tiếp đón"},{"thuc_hien":["dl-1"],"phoi_hop":[],"noi_dung":"Đối soát Lead – đặt lịch – khách – doanh thu ghi nhận theo cơ sở, theo Hạng mục; báo cáo tuần dựng tự động.","thoi_han":"Hằng tuần","ghi_nhan":"Phần mềm","can_cu":"mục 12.1; mục 30","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc-a","qlth-a"],"phoi_hop":[],"noi_dung":"Chuyên viên quảng cáo và kênh số nhóm 1 tối ưu theo Lead hợp lệ (KPI-04); chi phí trên Lead (KPI-06) chỉ để chẩn đoán. Quản lý thương hiệu nhóm 1 theo dõi chi phí trên khách (KPI-07), điều chỉnh ngân sách trong ngưỡng.","thoi_han":"Hằng tuần, hằng tháng","ghi_nhan":"Phần mềm","can_cu":"mục 12.2; mục 14.5","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Nguồn khách đi suốt từ quảng cáo đến quầy tiếp đón (KPI-42)","Dữ liệu khách chỉ dùng cho mục đích khách đã đồng ý","KPI-05 đặt lịch: chỉ tiêu chung của Chuyên viên quảng cáo và kênh số với Contact Center (mục 9)","Khách chuyển chéo thương hiệu qua Contact Center: tính cho Hạng mục phát sinh Lead; báo cáo tháng có dòng khách chuyển chéo","Mã theo dõi trên website, App TTH, trang đích chỉ bật sau khi khách đồng ý; KPI-42 đo trên phần khách đã đồng ý"],"ngoai_le":[{"tinh_huong":"Quảng cáo có thông tin vi phạm","cach_lam":"Chuyên viên quảng cáo và kênh số gỡ trong 03 giờ, báo cáo sự cố trong 48 giờ; sản phẩm sửa qua cổng tiếp nhận yêu cầu (mục 14.7)."},{"tinh_huong":"Bệnh viện không tiếp nhận thêm","cach_lam":"Trưởng nhóm báo khả năng tiếp nhận; Quản lý thương hiệu nhóm 1 điều chỉnh trong ngưỡng, vượt ngưỡng lập tờ trình (mục 13)."},{"tinh_huong":"Khi CRM vận hành","cach_lam":"Mọi Lead ghi trên CRM, một nguồn khách, một người xử lý; không nhận, không lưu Lead ngoài CRM (mục 17.1, R2, R3)."},{"tinh_huong":"Khách hỏi triệu chứng, đề nghị chẩn đoán, kê đơn qua tin nhắn, bình luận","cach_lam":"Contact Center không chẩn đoán, không kê đơn qua tin nhắn; tư vấn đặt lịch khám theo kịch bản; dấu hiệu cấp cứu: hướng dẫn gọi cấp cứu, đến cơ sở y tế gần nhất theo kịch bản (Chuyên viên biên tập của nhóm soạn, mục 17). (Đề xuất – chờ duyệt)"}],"nhom_vi_du":"N1"},{"id":"gui-tin","ten":"Chăm sóc khách cũ bằng gửi tin","nhom_hoat_dong":["N9"],"vi_du":"Bệnh viện Y học cổ truyền Nguyên Phúc mời khách đã khám trong năm và đã đồng ý nhận tin tham gia chương trình khám sức khỏe mùa đông.","buoc":[{"thuc_hien":["qlth-bc"],"phoi_hop":["tp|duyệt kế hoạch Hạng mục chăm sóc khách hàng cũ (mục 14.16, mảng 1)"],"noi_dung":"Lập kế hoạch đợt gửi trong Hạng mục chăm sóc khách hàng cũ: kết quả cần đạt, đối tượng, thời điểm, chi phí.","thoi_han":"Theo kế hoạch tháng","ghi_nhan":"Phần mềm: Hạng mục","can_cu":"mục 16, số 20","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["dl-2"],"phoi_hop":[],"noi_dung":"Lập danh sách nhận: chỉ khách đã đồng ý; loại người đã từ chối nhận.","thoi_han":"Trước ngày gửi","ghi_nhan":"Danh sách đã đồng ý","can_cu":"mục 16, số 20; Nghị định 91/2020/NĐ-CP; Luật Bảo vệ dữ liệu cá nhân 91/2025/QH15","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt-b","tk-b"],"phoi_hop":["bt-ac|kiểm pháp lý ngang hàng – ngoại lệ, người trung lập cho phép có thời hạn (mục 15.4)"],"noi_dung":"Viết nội dung tin, làm hình ảnh; kiểm tra pháp lý. Tin không chứa dữ liệu sức khỏe.","thoi_han":"Theo thời hạn chuẩn","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 16, số 20","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qc-b"],"phoi_hop":["dl-2|lịch gửi chung, chặn trùng, trần tần suất"],"noi_dung":"Gửi trên kênh của nhóm mình (ví dụ này: Trang Zalo chính thức, tin nhắn Zalo theo mẫu (ZNS), SMS của nhóm 2) theo lịch gửi chung toàn hệ thống do Chuyên viên dữ liệu khách hàng và thị trường giữ (giai đoạn đầu: Chuyên viên đo lường và đối soát) để một khách không nhận trùng giữa các thương hiệu; trong tần suất tối đa mỗi khách do Trưởng phòng duyệt. Mỗi tin có cách từ chối nhận tin; người đã từ chối vào danh sách loại (Nghị định 91/2020/NĐ-CP; Nghị định 330/2026/NĐ-CP).","thoi_han":"Theo lịch gửi chung","ghi_nhan":"Tài khoản tin nhắn Zalo theo mẫu (ZNS), SMS thương hiệu","can_cu":"mục 16, số 20","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cc|trước khi nhận: người đang trả lời tại cơ sở"],"phoi_hop":[],"noi_dung":"Trả lời tin khách gửi lại.","thoi_han":"Đúng thời hạn phản hồi","ghi_nhan":"Hộp thư dùng chung; CRM khi có","can_cu":"mục 16, số 20; mục 31, mảng 18","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng"},{"thuc_hien":["dl-1","qlth-bc"],"phoi_hop":[],"noi_dung":"Đo theo nguồn khách riêng từng đợt: KPI-15 tỷ lệ tái sử dụng dịch vụ, KPI-17 doanh thu từ khách hiện hữu; Quản lý thương hiệu nhóm 2 đánh giá đợt gửi.","thoi_han":"Sau mỗi đợt; báo cáo tháng","ghi_nhan":"Phần mềm","can_cu":"mục 12.2","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Danh sách chỉ gồm khách đã đồng ý","Một khách không nhận trùng giữa các nhóm (lịch gửi chung)","Tin không chứa dữ liệu sức khỏe"],"ngoai_le":[{"tinh_huong":"Tin nhắc lịch hẹn, báo đã có kết quả, nhắc tái khám theo chỉ định","cach_lam":"Tin giao dịch, gửi tự động từ hệ thống, không phải chiến dịch Marketing (mục 28, số 36)."},{"tinh_huong":"Gọi chăm sóc khách hàng cũ","cach_lam":"Contact Center thực hiện; khi chưa có Contact Center: tạm chưa thực hiện (mục 17)."}],"nhom_vi_du":"N2"},{"id":"danh-gia","ten":"Đánh giá tiêu cực, khủng hoảng","nhom_hoat_dong":["N5"],"vi_du":"Một đánh giá 02 sao trên Trang doanh nghiệp Google của Bệnh viện Đa khoa TTH Hà Tĩnh phàn nàn về thời gian chờ, có nêu tên một nhân viên.","buoc":[{"thuc_hien":["cc|trước khi nhận: người đang trả lời tại cơ sở"],"phoi_hop":["qc-a|thông tin vi phạm","cvtt-a|dư luận"],"noi_dung":"Phát hiện khi rà soát thông tin, bình luận trên kênh.","thoi_han":"Hằng ngày","ghi_nhan":"Sổ theo dõi","can_cu":"mục 30; QT.MKT.09; mục 31, mảng 19","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cc|trước khi nhận: người đang trả lời tại cơ sở"],"phoi_hop":[],"noi_dung":"Phân loại: 1–2 sao; khiếu nại chuyên môn, thái độ; nêu tên người bệnh, nhân viên; dấu hiệu lan truyền là đánh giá nhạy cảm. Đánh giá này nhạy cảm: chuyển Chuyên viên truyền thông nhóm 1; chuyển phản ánh cho bộ phận xử lý phản ánh của bệnh viện.","thoi_han":"Khi phát hiện","ghi_nhan":"Sổ theo dõi","can_cu":"mục 16, số 6; mục 11.1, số 6","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvtt-a"],"phoi_hop":[],"noi_dung":"Trả lời công khai: không xác nhận người viết là người bệnh; không nêu thông tin sức khỏe, dịch vụ đã dùng, thông tin cá nhân; cảm ơn hoặc xin lỗi theo kịch bản, mời liên hệ qua kênh riêng.","thoi_han":"Chưa có quy định (mục 28, số 41)","ghi_nhan":"Kịch bản trả lời","can_cu":"mục 16, số 19","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["xu-ly-phan-anh"],"phoi_hop":[],"noi_dung":"Giải quyết nội dung phản ánh, trả lời người phản ánh qua kênh riêng.","thoi_han":"Theo quy định của bệnh viện","ghi_nhan":"Kết quả giải quyết, gửi Chuyên viên truyền thông của nhóm làm đầu vào trả lời công khai","can_cu":"mục 17","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["mkt-coso","cvtt-a"],"phoi_hop":["qlcl|sự cố y khoa","btgd|thông cáo khủng hoảng","tp|nhận báo cáo sự cố, làm việc với Ban Tổng Giám đốc"],"noi_dung":"Thành khủng hoảng (báo chí, lan truyền): Marketing cơ sở báo sự cố, gọi trực tiếp theo lịch trực sự cố. Chuyên viên truyền thông của nhóm có cơ sở (ví dụ này: nhóm 1) xử lý theo quy chế phát ngôn; khủng hoảng liên quan cả hai nhóm: Trưởng phòng chủ trì (chưa có Trưởng phòng: Chuyên viên trưởng); thông cáo khủng hoảng: Tổng Giám đốc duyệt. Không đăng thông tin quy kết trách nhiệm người hành nghề trước khi có kết luận.","thoi_han":"Báo sự cố 30 phút; ghi sổ theo dõi trong 24 giờ","ghi_nhan":"Lịch trực sự cố","can_cu":"mục 14.10; mục 31, mảng 23","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc-a"],"phoi_hop":[],"noi_dung":"Thông tin vi phạm trên kênh: gỡ, báo cáo sự cố. Cơ quan có thẩm quyền yêu cầu gỡ: thực hiện trong 24 giờ.","thoi_han":"Gỡ 03 giờ; báo cáo 48 giờ","ghi_nhan":"Sổ theo dõi sự cố","can_cu":"QyĐ.05.MKT; Nghị định 342/2025/NĐ-CP, Điều 18","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"}],"kiem_soat":["Không lộ thông tin người bệnh khi trả lời công khai","Một đầu mối phát ngôn theo quy chế; xử lý nội dung, phát ngôn: nhóm có sự cố","KPI-10 tỷ lệ đánh giá tích cực, KPI-12 điểm đánh giá trung bình: Chuyên viên truyền thông của nhóm"],"ngoai_le":[{"tinh_huong":"Đánh giá thông thường (không thuộc tiêu chí nhạy cảm)","cach_lam":"Contact Center trả lời theo kịch bản của Chuyên viên truyền thông nhóm 1."},{"tinh_huong":"Phản ánh có dấu hiệu sự cố y khoa","cach_lam":"Phòng Quản lý chất lượng chủ trì; Marketing chỉ phụ trách truyền thông."},{"tinh_huong":"Người bệnh, người nhà quay video, phát trực tiếp tại cơ sở, tố cáo trên mạng","cach_lam":"Marketing cơ sở báo trong 30 phút theo lịch trực sự cố; Chuyên viên truyền thông của nhóm xử lý theo quy trình này; giải quyết nội dung: bộ phận tiếp nhận, xử lý phản ánh của cơ sở (mục 4.2)."},{"tinh_huong":"Đánh giá giả, chiến dịch đánh giá xấu có tổ chức","cach_lam":"Lưu bằng chứng, báo cáo nền tảng như QT.27, bước 2, 3; không tự tạo, không thuê viết đánh giá. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Ngoài giờ, khi Contact Center chưa nhận tiếp nhận ngoài giờ","cach_lam":"Lịch trực sự cố tầng 1 chung 04 người (Quản lý thương hiệu, Chuyên viên truyền thông của 02 nhóm). Người trực chỉ làm việc trong danh sách tiêu chí: ẩn bình luận, gỡ bài, tạm dừng quảng cáo, ở mức quyền tối thiểu; gọi người phụ trách của nhóm có sự cố trong 30 phút; không trả lời, không phát ngôn; không liên lạc được: Chuyên viên trưởng. Hết khi Contact Center nhận ngoài giờ, báo người trực của đúng nhóm (mục 15.4)."}],"nhom_vi_du":"N1"},{"id":"vang-mat","ten":"Nhân sự vắng mặt","nhom_hoat_dong":["N11"],"vi_du":"Chuyên viên thiết kế nhóm 1 (người phụ trách bệnh viện) nghỉ phép 05 ngày làm việc trong lúc Hạng mục khám sức khỏe doanh nghiệp đang triển khai; Chuyên viên biên tập nhóm 2 (vị trí 01 người) nghỉ ốm đột xuất 03 ngày làm việc.","buoc":[{"thuc_hien":["tk-a"],"phoi_hop":["tt-nd|duyệt nghỉ, kiểm không trùng người thay"],"noi_dung":"Đăng ký nghỉ phép trước; làm trước việc có hạn trong thời gian nghỉ. Tổ trưởng của tổ duyệt (vị trí do Trưởng phòng quản lý trực tiếp: Trưởng phòng; người nhóm 2, Chuyên viên thiết kế ngoại tuyến của Tổ Nội dung và Sáng tạo: Chuyên viên trưởng). Không duyệt khi: người thay chính nghỉ cùng thời điểm; 02 vị trí có chung người thay chính nghỉ cùng thời điểm; trùng mốc của vị trí (người trình, người duyệt BM-3 không nghỉ ngày 18–20).","thoi_han":"Trước khi nghỉ","ghi_nhan":"Lịch nghỉ trên phần mềm (chặn duyệt khi trùng)","can_cu":"mục 15.4","de_xuat":false,"chua_co_phan_mem":"Lịch nghỉ dùng chung (bảng tính); Tổ trưởng kiểm trùng trước khi duyệt","thu_tu":1},{"thuc_hien":["tk-a|người còn lại trong nhóm 1"],"phoi_hop":[],"noi_dung":"Người thay chính cùng nhóm nhận việc dở dang theo thứ tự: việc không được gián đoạn → việc đang triển khai → việc đã lên lịch; việc không gấp lùi hạn (dừng đếm thời hạn). Dùng quyền kênh, tài khoản, thư mục đã có sẵn của nhóm. Người thay chính theo bảng vị trí: vị trí nhóm 1 có 02 người – người còn lại; Quản lý thương hiệu ↔ Chuyên viên truyền thông cùng nhóm.","thoi_han":"Từ ngày đầu vắng","ghi_nhan":"Hồ sơ vị trí; sổ theo dõi yêu cầu","can_cu":"mục 15.4","de_xuat":false,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)","thu_tu":2},{"thuc_hien":["cvt|lập, xác nhận và chấm dứt cho phép làm thay tại Tổ Nội dung và Sáng tạo","qlsps|Tổ trưởng Tổ Tăng trưởng số, theo đúng phạm vi tổ"],"phoi_hop":["bt-ac|người cùng chuyên môn nhóm 1 – ngoại lệ thay khi vắng","qlth-bc|nghiệm thu, giữ định vị","cvt|cấp, thu hồi quyền tạm"],"noi_dung":"Vắng ở 04 vị trí sản xuất 01 người của nhóm 2 (Chuyên viên biên tập, thiết kế, media, quảng cáo và kênh số): việc không gấp lùi hạn. Việc gấp – có ngày phát hành trong thời gian vắng, hoặc yêu cầu gấp đã ghi lý do (mục 16, số 3): người trung lập (RC-1) của tổ (Tổ Nội dung và Sáng tạo: Chuyên viên trưởng; Tổ Tăng trưởng số: Quản lý sản phẩm số) cho phép làm thay có thời hạn (\"thay khi vắng\") (lý do, ngày hết hạn = ngày người vắng trở lại); người cùng chuyên môn nhóm 1 làm trên định vị, nội dung đã duyệt, mẫu của nhóm 2, không đổi thông điệp; Quản lý thương hiệu nhóm 2 nghiệm thu; Chuyên viên trưởng cấp quyền tạm đúng phần việc, thu hồi đúng ngày hết hạn.","thoi_han":"Trong 04 giờ làm việc từ khi biết vắng","ghi_nhan":"Cho phép làm thay trên phần mềm: chỉ chọn được người nhóm kia khi cho phép làm thay còn hạn; quyền tạm tự thu hồi","can_cu":"mục 15.4; mục 14.15","de_xuat":false,"chua_co_phan_mem":"Sổ yêu cầu: người cho phép làm thay, người yêu cầu, người làm, nhóm, lý do, thời điểm bắt đầu và ngày hết hạn; Chuyên viên trưởng hoặc Quản lý sản phẩm số xác nhận theo RC-1.","thu_tu":3},{"thuc_hien":["tp"],"phoi_hop":["cvt|duyệt thứ tự ưu tiên trong thời gian chờ","nhan-luc"],"noi_dung":"Vắng trên 05 ngày làm việc (ốm dài; thai sản – Bộ luật Lao động 2019, Điều 139): Trưởng phòng bố trí người tạm thời trong 05 ngày làm việc (người cùng nhóm có giờ trống, hoặc đề nghị Phòng Nhân lực hợp đồng có thời hạn); người tạm thời nhận nguyên danh mục của vị trí. Trong thời gian chờ: làm như bước 2–3, Chuyên viên trưởng duyệt thứ tự ưu tiên. Quá 01 tháng chưa có người tạm thời: Trưởng phòng báo Ban Tổng Giám đốc.","thoi_han":"Bố trí trong 05 ngày làm việc","ghi_nhan":"Quyết định bố trí","can_cu":"mục 15.4","de_xuat":false,"chua_co_phan_mem":"Quyết định bố trí trên Workit; việc, hạn ghi vào sổ yêu cầu dùng chung","thu_tu":4},{"thuc_hien":["cvt|lập, xác nhận và chấm dứt cho phép làm thay tại Tổ Nội dung và Sáng tạo","qlsps|Tổ trưởng Tổ Tăng trưởng số, theo đúng phạm vi tổ"],"phoi_hop":["tt-nd|chấm dứt cho phép làm thay"],"noi_dung":"Người vắng trở lại nhận lại việc dở dang theo sổ yêu cầu. Cho phép làm thay hết hạn đúng ngày; Chuyên viên trưởng thu hồi quyền tạm. Giờ làm chéo nhóm vào báo cáo quý theo người, vị trí, trường hợp; Thư ký Ban Tổng Giám đốc mảng Marketing xem được.","thoi_han":"Ngày người vắng trở lại","ghi_nhan":"Phần mềm: tự thu hồi quyền khi hết hạn cho phép làm thay; báo cáo quý giờ chéo nhóm","can_cu":"mục 15.4; mục 14.15","de_xuat":false,"chua_co_phan_mem":"Sổ yêu cầu: người cho phép làm thay, người yêu cầu, người làm, nhóm, lý do, thời điểm bắt đầu và ngày hết hạn; Chuyên viên trưởng hoặc Quản lý sản phẩm số xác nhận theo RC-1.","thu_tu":5}],"kiem_soat":["Hồ sơ vị trí cập nhật hằng tuần","Mỗi người làm thực tế phần việc phụ tối thiểu 01 lần/quý; người nhóm 1 ở 04 vị trí sản xuất làm thử việc của nhóm 2 trên mẫu của nhóm 2 khi được phân công thay","Không ai là người thay chính cho quá 02 vai trò","Chỉ chọn được người nhóm kia khi cho phép làm thay còn hạn; việc cho phép do người trung lập lập (RC-1), không phải người yêu cầu, không phải người làm"],"ngoai_le":[{"tinh_huong":"Tổ trưởng vắng","cach_lam":"Chuyên viên trưởng giữ tạm vai trò Tổ trưởng: yêu cầu cần Tổ trưởng xử lý trong 04 giờ làm việc, lịch, duyệt nghỉ, cho phép làm thay có thời hạn. Tổ Truyền thông và Thương hiệu do Quản lý thương hiệu nhóm 2 kiêm Tổ trưởng (chỉ điều phối)."},{"tinh_huong":"Sản phẩm do Tổ trưởng (Chuyên viên biên tập nhóm 1 được chỉ định, Quản lý sản phẩm số) làm","cach_lam":"Như mọi sản phẩm: phát hành khi đủ bước kiểm, nghiệm thu, duyệt (mục 14.16); yêu cầu liên quan chính Tổ trưởng do Chuyên viên trưởng xử lý."},{"tinh_huong":"Vị trí trung lập vắng (Chuyên viên thiết kế ngoại tuyến, Chuyên viên đo lường và đối soát, Chuyên viên dữ liệu khách hàng và thị trường, Quản lý sản phẩm số)","cach_lam":"Phần việc của nhóm nào do người cùng chuyên môn của nhóm đó làm (không phải chéo nhóm); việc chung toàn hệ thống: người dự phòng theo bảng vị trí; việc không gấp lùi hạn."},{"tinh_huong":"Người thay chính cũng vắng; 02 vị trí có chung người thay chính cùng vắng đột xuất","cach_lam":"Người dự phòng theo bảng vị trí; không có: Chuyên viên trưởng xếp lại theo thứ tự ưu tiên (mục 14.9), việc không gấp lùi hạn. Nhóm 2 vẫn chỉ dùng người cùng chuyên môn nhóm 1 khi được cho phép làm thay."},{"tinh_huong":"Một vị trí dùng quá 24 giờ chéo nhóm trong quý (≈ 03 ngày làm việc: 12 ngày phép ÷ 04 quý × 7,83 giờ)","cach_lam":"Chuyên viên trưởng xem nguyên nhân, xử lý theo quy tắc định biên (mục 21); có phần mềm: cảnh báo tự động."},{"tinh_huong":"Làm việc của nhóm kia khi chưa được cho phép làm thay hoặc đã hết hạn","cach_lam":"Không tính giờ, không cam kết thời hạn; ghi vào báo cáo tháng theo người giao, như giao việc ngoài cổng (mục 14.14)."}],"nhom_vi_du":"chung"},{"id":"ngoai-luong","ten":"Yêu cầu ngoài luồng","nhom_hoat_dong":["N11"],"vi_du":"Giám đốc Bệnh viện Đa khoa TTH Quảng Bình nhắn thẳng Chuyên viên media nhóm 1 đề nghị quay hội nghị vào sáng hôm sau.","buoc":[{"thuc_hien":["md-ac"],"phoi_hop":[],"noi_dung":"Không tự nhận việc: chuyển yêu cầu vào cổng tiếp nhận, báo lại người gửi.","thoi_han":"Ngay khi nhận","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.10","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"phoi_hop":["tn-a|xác nhận lịch Chuyên viên Marketing cơ sở – media"],"noi_dung":"Yêu cầu ngoài luồng được nhập lại qua cổng tiếp nhận; đủ ô thì tự xác nhận, giao theo bảng phân công; yêu cầu cần xử lý: Tổ trưởng xử lý trong 04 giờ làm việc. Ghi hình tại cơ sở: Chuyên viên Marketing cơ sở – media làm trước. Cần Chuyên viên media Tổng công ty: người phụ trách của nhóm có sản phẩm đi; trùng lịch: người còn lại cùng nhóm (nhóm 2: lùi lịch hoặc Chuyên viên Marketing cơ sở – media cùng nhóm).","thoi_han":"Tự xác nhận khi đủ ô; yêu cầu cần Tổ trưởng xử lý 04 giờ làm việc","ghi_nhan":"Lịch media","can_cu":"mục 14.7; mục 15.3","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"phoi_hop":[],"noi_dung":"Hạn gấp hơn thời hạn chuẩn: dùng giờ dự phòng; người gửi ghi lý do. Yêu cầu ngoài cổng tiếp nhận yêu cầu không cam kết thời hạn.","thoi_han":"Ghi lý do khi gửi yêu cầu","ghi_nhan":"Sổ theo dõi","can_cu":"mục 16, số 3","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tp"],"phoi_hop":["dl-1"],"noi_dung":"Ban Tổng Giám đốc yêu cầu số liệu: Trưởng phòng chuyển vào cổng tiếp nhận; Chuyên viên đo lường và đối soát làm phân tích riêng.","thoi_han":"03 ngày làm việc; gấp hơn dùng dự phòng","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.7; mục 14.10","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"}],"kiem_soat":["Mọi yêu cầu vào cổng tiếp nhận để tính giờ và tỷ lệ đúng hạn","Người làm không tự đổi thứ tự ưu tiên"],"ngoai_le":[{"tinh_huong":"Loại việc chưa có trong bảng phân công","cach_lam":"Trưởng phòng xếp một lần vào vị trí có chức năng gần nhất, bổ sung vào bảng."},{"tinh_huong":"Xung đột ưu tiên tại cơ sở","cach_lam":"Quản lý thương hiệu của nhóm và Trưởng nhóm thống nhất; chưa được thì Chuyên viên trưởng quyết định; liên quan Ban Giám đốc cơ sở thì Trưởng phòng làm việc với Ban Giám đốc cơ sở."}],"nhom_vi_du":"N1"},{"id":"co-so-moi","ten":"Cơ sở mới hoạt động","nhom_hoat_dong":["N1","N3","N8","N11"],"vi_du":"Bệnh viện Đa khoa Quốc tế TTH Huế khai trương theo lịch Ban Tổng Giám đốc chốt (nhóm 1).","buoc":[{"thuc_hien":["dl-1","cvt"],"phoi_hop":["tp","btgd"],"noi_dung":"Rà soát định biên với giờ thêm của bệnh viện mới: Tổng công ty không thêm người ở bước này; Marketing cơ sở 03 người.","thoi_han":"03 tháng trước khi cơ sở hoạt động","ghi_nhan":"Biên bản rà soát định biên","can_cu":"mục 14.14; mục 21","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tn-a"],"phoi_hop":["nhan-luc|tuyển dụng"],"noi_dung":"Có mặt từ 03 tháng trước khai trương; chuẩn bị nội dung đầu vào, bác sĩ, thông tin dịch vụ.","thoi_han":"03 tháng trước khai trương","ghi_nhan":"Phần mềm: nhu cầu, thông tin dịch vụ, bác sĩ","can_cu":"mục 21","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":[],"noi_dung":"Quy trình vận hành, bàn giao, đào tạo, phân quyền phần mềm cho cơ sở mới.","thoi_han":"Trước khai trương","ghi_nhan":"Phần mềm","can_cu":"mục 22.2","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc","qlsps"],"phoi_hop":["so-hoa","tp|cấp quyền quản trị","cvt|cấp quyền theo ma trận đăng bài, trả lời tin nhắn","bgd-coso|bố trí người trả lời tin nhắn","cvt|cấp quyền theo ma trận chỉ trả lời tin nhắn"],"noi_dung":"Lập bộ kênh riêng của bệnh viện (Facebook, Trang Zalo chính thức, TikTok, YouTube), Trang doanh nghiệp trên Google. Phân quyền theo mục 11.3: quyền quản trị: Trưởng phòng cấp; quyền đăng bài, trả lời tin nhắn: Chuyên viên trưởng cấp theo ma trận. Quản lý sản phẩm số nêu yêu cầu trang của bệnh viện trên website tthhealthcare.com, App TTH; Phòng Số hóa làm. Trước khi Contact Center nhận: Ban Giám đốc cơ sở bố trí người trả lời tin nhắn (bộ phận tư vấn hoặc Phát triển dịch vụ) từ trước khai trương; Chuyên viên trưởng cấp theo ma trận quyền chỉ trả lời tin nhắn; Chuyên viên biên tập của nhóm giao kịch bản tư vấn (Đề xuất – chờ duyệt; mục 17).","thoi_han":"Trước khai trương","ghi_nhan":"Danh mục kênh","can_cu":"mục 6; mục 22.2; mục 11.3","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qlth"],"phoi_hop":["bgd-coso","tp|duyệt"],"noi_dung":"Quản lý thương hiệu của nhóm lập Hạng mục khai trương theo QT.1: kết quả cần đạt, ưu đãi khai trương do Ban Giám đốc bệnh viện duyệt, Hoạt động, hạn mức; giao việc qua cổng tiếp nhận yêu cầu; điều phối, báo cáo.","thoi_han":"Trình chậm nhất ngày 18, duyệt chậm nhất ngày 20 của tháng trước khai trương","ghi_nhan":"Phần mềm: Hạng mục","can_cu":"mục 22.2; QT.1","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":["tp|ban hành bảng phân công"],"noi_dung":"Cân giờ theo từng nhóm (mục 21): cơ sở mới thuộc nhóm nào thì cộng giờ vào vị trí của nhóm đó (mục 22.1); vượt 142 giờ thì thêm người theo lộ trình định biên theo nhóm; không giao người nhóm kia làm cố định. Ví dụ Bệnh viện Đa khoa Quốc tế TTH Huế (nhóm 1): Quản lý thương hiệu nhóm 1 ≈ 139 + 28 ≈ 167 giờ → thêm 01 người; Chuyên viên quảng cáo và kênh số nhóm 1 ≈ 268 + 44 ≈ 312 giờ → người thứ ba; Chuyên viên media nhóm 1 ≈ 219 + 25 ≈ 244 giờ, dưới 284 giờ, không thêm; Chuyên viên đo lường và đối soát ≈ 144 + 12 ≈ 156 giờ → có Chuyên viên dữ liệu khách hàng và thị trường.","thoi_han":"Trước ngày người tăng thêm vào làm (theo giờ ra mắt, thường 01 tháng trước khai trương)","ghi_nhan":"Bảng phân công","can_cu":"mục 21","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt","tk","md","qc","cvtt-a"],"phoi_hop":["tt-nd|xếp lịch theo giờ dự phòng"],"noi_dung":"Sản phẩm ra mắt (một lần): Biên tập 40,5 giờ; Thiết kế khoảng 93 giờ; Media 46 giờ; chiến dịch khai trương 16 giờ; kênh ngoại tuyến 16 giờ. Chia cho người cùng vị trí còn giờ dự phòng; người phụ trách nhóm giữ định vị, nghiệm thu.","thoi_han":"Không quá 02 cơ sở ra mắt cùng lúc","ghi_nhan":"Sổ theo dõi: đo giờ ra mắt thực tế","can_cu":"mục 22.2; mục 21","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"}],"kiem_soat":["Giờ ra mắt đo thực tế, bổ sung vào mục 22.2","Quyền kênh gắn với vị trí, không gắn với cá nhân"],"ngoai_le":[{"tinh_huong":"Có người vượt 142 giờ mà không ai nhận được phần hỗ trợ","cach_lam":"Người vượt dùng giờ dự phòng; vị trí vượt giờ 02 quý liên tiếp thì bổ sung người theo quy tắc định biên (mục 21)."}],"nhom_vi_du":"N1"},{"id":"hang-muc-toan-he-thong","ten":"Hạng mục trọng điểm toàn hệ thống","nhom_hoat_dong":["N1","N2","N3","N4","N9","N10"],"vi_du":"Hạng mục tầm soát sức khỏe đầu năm cho cả 05 bệnh viện, 02 phòng khám; một thông điệp chung, mỗi thương hiệu thể hiện trên nhận diện của mình.","buoc":[{"thuc_hien":["tn","dmpk"],"phoi_hop":["bgd-coso"],"noi_dung":"Thống nhất dịch vụ, ưu đãi dự kiến, khả năng tiếp nhận của từng cơ sở; gửi nhu cầu tháng. Phòng khám (thuộc nhóm 1, gồm Phòng khám Đa khoa TTH Khe Tre) gửi qua Quản lý thương hiệu nhóm 1.","thoi_han":"Ngày 10–15","ghi_nhan":"Phần mềm: nhu cầu tháng","can_cu":"mục 16, số 12","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Trang tính nhu cầu tháng"},{"thuc_hien":["qlth-a","qlth-bc"],"phoi_hop":["dl-1|cách đo, nguồn khách từng cơ sở","qc|yêu cầu kênh"],"noi_dung":"Lập kế hoạch Hạng mục: mục tiêu chiến lược, KPI theo cơ sở, hạn mức, Hoạt động theo cơ sở. Quản lý thương hiệu nhóm 1 là chủ Hạng mục, chịu KPI phần nhóm 1; Quản lý thương hiệu nhóm 2 lập phần nhóm 2, chịu KPI phần nhóm 2.","thoi_han":"Trình chậm nhất ngày 18; duyệt chậm nhất ngày 20","ghi_nhan":"Phần mềm: kế hoạch Hạng mục","can_cu":"mục 11.1, số 38","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["tp","btgd"],"phoi_hop":["gd-coso"],"noi_dung":"Duyệt kế hoạch, ngân sách; Ban Tổng Giám đốc duyệt Hạng mục dùng ngân sách Tổng công ty. Giám đốc từng cơ sở xác nhận ưu đãi, giá.","thoi_han":"Theo tờ trình","ghi_nhan":"Tờ trình","can_cu":"mục 4.2; mục 16, số 9","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["qlth-a","qlth-bc"],"phoi_hop":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"noi_dung":"Gửi yêu cầu sản xuất qua cổng tiếp nhận; Đủ ô bắt buộc thì tự xác nhận, giao theo bảng phân công; yêu cầu cần Tổ trưởng xử lý (thiếu nội dung, gấp, vượt công suất, ngoài bộ): Tổ trưởng xử lý trong 04 giờ làm việc; người làm theo nhóm.","thoi_han":"Tự xác nhận khi đủ ô; yêu cầu cần Tổ trưởng xử lý 04 giờ làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.5","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["bt-ac","bt-b"],"phoi_hop":["bac-si","phap-che|rủi ro cao"],"noi_dung":"Thông điệp chung, bài chung, kịch bản phim chương trình; bài nhóm 1, TTH Clinic: Chuyên viên biên tập nhóm 1. Bài nhóm 2 (y học cổ truyền, răng hàm mặt): Chuyên viên biên tập nhóm 2. Kiểm pháp lý theo tầng: bài nhóm 1 – người còn lại trong nhóm; bài nhóm 2 – Chuyên viên biên tập nhóm 1 (CN-1); bác sĩ từng bệnh viện xác nhận chuyên môn; hình ảnh trước – sau qua bộ phận pháp chế.","thoi_han":"03 ngày làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 16, số 4","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tk-a"],"phoi_hop":[],"noi_dung":"Hình ảnh chủ đạo chung (cấp 4).","thoi_han":"10 ngày làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 15.2","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tk-a","tk-b"],"phoi_hop":["qc|kích thước, số biến thể","tk-nt|xác nhận kỹ thuật file in"],"noi_dung":"Áp dụng hình ảnh chủ đạo cho sản phẩm từng thương hiệu, cả bản số và bản in (băng rôn, standee, tờ rơi): Chuyên viên thiết kế nhóm 1 (03 bệnh viện, TTH Clinic, TTH Group, TTH Healthcare), Chuyên viên thiết kế nhóm 2 (Nguyên Phúc, Thái Thượng Hoàng). File in qua Chuyên viên thiết kế ngoại tuyến xác nhận kỹ thuật.","thoi_han":"01–02 ngày làm việc sau khi hình ảnh chủ đạo được duyệt","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 11.1, số 38, 39; mục 15.2","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["mdcs-a","mdcs-b","md-ac","md-b"],"phoi_hop":["dmpk|ảnh"],"noi_dung":"Chuyên viên Marketing cơ sở – media ghi hình tại chỗ (phòng khám: đầu mối gửi ảnh). Phim chương trình, video nhóm 1: Chuyên viên media nhóm 1; video nhóm 2: Chuyên viên media nhóm 2.","thoi_han":"Tư liệu trong ngày; video 07 ngày làm việc","ghi_nhan":"kho tư liệu; cổng tiếp nhận yêu cầu","can_cu":"mục 15.3","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính); Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["qlth-a","qlth-bc"],"phoi_hop":["tp"],"noi_dung":"Nghiệm thu phần của mình; phát hành khi đủ bước kiểm, nghiệm thu; Trưởng phòng duyệt thêm nội dung thuộc QyĐ.03.MKT mục 5.2.","thoi_han":"Tối đa 02 vòng chỉnh sửa","ghi_nhan":"Sổ theo dõi","can_cu":"mục 14.5","de_xuat":false,"thu_tu":9,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qc"],"phoi_hop":["qlsps|nghiệm thu","dl-1|form, nguồn khách"],"noi_dung":"Trang đích theo cơ sở dựng từ mẫu; trang chương trình trên website tthhealthcare.com, App TTH.","thoi_han":"05 ngày làm việc","ghi_nhan":"Danh mục sản phẩm số","can_cu":"mục 11.1, số 25, 26","de_xuat":false,"thu_tu":10,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc-a","qc-b"],"phoi_hop":["qlth|duyệt ngân sách phần của mình"],"noi_dung":"Đăng, quảng cáo trên kênh từng nhóm: nhóm 1: 03 bệnh viện đa khoa, TTH Clinic, TTH Healthcare, TTH Group; nhóm 2: Nguyên Phúc, Thái Thượng Hoàng.","thoi_han":"02 ngày làm việc","ghi_nhan":"Lịch đăng","can_cu":"mục 16.1","de_xuat":false,"thu_tu":11,"chua_co_phan_mem":"Trang tính lịch đăng"},{"thuc_hien":["qc-a","qc-b"],"phoi_hop":["dl-2|lịch gửi chung, chặn trùng","bt|nội dung"],"noi_dung":"Gửi tin cho khách cũ đã đồng ý: mỗi nhóm gửi trên kênh của nhóm mình (Chuyên viên quảng cáo và kênh số của nhóm), theo một lịch gửi chung do Chuyên viên dữ liệu khách hàng và thị trường giữ để một khách không nhận trùng giữa các thương hiệu; mỗi tin có cách từ chối nhận tin.","thoi_han":"Theo lịch gửi chung","ghi_nhan":"Lịch gửi chung","can_cu":"mục 16, số 20","de_xuat":false,"thu_tu":12,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvtt-a","cvtt-bc"]