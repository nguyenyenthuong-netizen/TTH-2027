","ghi_nhan":"Phần mềm: Hoạt động","can_cu":"mục 14.7; QT.06.MKT","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["bgd-coso","cvt"],"phoi_hop":["tp|có báo chí"],"noi_dung":"Ban Giám đốc bệnh viện duyệt kế hoạch, ngân sách. Nội dung truyền thông: Chuyên viên trưởng duyệt; có báo chí, cấp hệ thống: Trưởng phòng.","thoi_han":"01 ngày làm việc từ khi nhận đủ hồ sơ","ghi_nhan":"Tờ trình; phần mềm","can_cu":"mục 14.16, mảng 20; mục 31, mảng 20","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["qhcs"],"phoi_hop":["tk-a","tk-nt|xác nhận kỹ thuật file in"],"noi_dung":"Ấn phẩm in (băng rôn, backdrop, tờ rơi): gửi yêu cầu qua cổng tiếp nhận kèm nội dung đã duyệt; Chuyên viên thiết kế của nhóm làm (Bệnh viện Đa khoa TTH Quảng Bình: Chuyên viên thiết kế nhóm 1), file in qua Chuyên viên thiết kế ngoại tuyến xác nhận kỹ thuật (QT.2).","thoi_han":"Không ngắn hơn thời hạn chuẩn","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 15.2","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qhcs"],"phoi_hop":[],"noi_dung":"Tổng duyệt; giấy đồng ý chụp ảnh của người tham gia.","thoi_han":"Trước 01 ngày","ghi_nhan":"Giấy đồng ý chụp ảnh","can_cu":"QT.MKT.13","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["mdcs-a"],"phoi_hop":[],"noi_dung":"Ghi hình, chụp ảnh; tư liệu lên kho tư liệu. Vượt số người tại chỗ: đăng ký hỗ trợ trên lịch chung.","thoi_han":"Trong ngày","ghi_nhan":"kho tư liệu","can_cu":"mục 16, số 8","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["tn-a","bt-ac"],"phoi_hop":["bt-ac|người còn lại trong nhóm – kiểm pháp lý tầng 1"],"noi_dung":"Tin trong ngày trên Facebook của bệnh viện; bài hoàn chỉnh nếu thuộc danh mục bài.","thoi_han":"Tin 04 giờ; bài 12 giờ","ghi_nhan":"Facebook của bệnh viện; cổng tiếp nhận yêu cầu","can_cu":"mục 16, số 13","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qhcs"],"phoi_hop":[],"noi_dung":"Ghi Hoạt động, bằng chứng, thông tin thị trường trên phần mềm.","thoi_han":"Trong ngày","ghi_nhan":"Phần mềm","can_cu":"mục 31, mảng 20","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Không thu thập thông tin sức khỏe ngoài mục đích khám; ảnh có giấy đồng ý","Tin cơ sở tự đăng không có dịch vụ, giá, ưu đãi, kỹ thuật mới, ca bệnh (mục 16, số 5)"],"ngoai_le":[{"tinh_huong":"Sự kiện thuộc Hạng mục","cach_lam":"Làm theo QT.1; Quản lý thương hiệu chịu trách nhiệm kết quả (mục 11.1, số 14)."},{"tinh_huong":"Có phóng viên","cach_lam":"Chuyên viên truyền thông của nhóm phụ trách phần báo chí; Trưởng phòng duyệt nội dung."},{"tinh_huong":"Sự kiện hoãn, hủy (thời tiết, dịch bệnh)","cach_lam":"Trưởng nhóm báo qua cổng tiếp nhận yêu cầu sau khi Ban Giám đốc cơ sở quyết định; thông báo trên Facebook của bệnh viện; Chuyên viên quảng cáo và kênh số dừng quảng cáo sự kiện; Contact Center báo khách đã đăng ký; ấn phẩm đã in giữ lại dùng khi tổ chức lại. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Hoạt động từ thiện, công tác xã hội không có đối ứng truyền thông thương hiệu","cach_lam":"Tổ Công tác xã hội chủ trì; Marketing truyền thông khi Tổ Công tác xã hội gửi yêu cầu qua cổng tiếp nhận (QT.2); tin trong ngày theo QT.3 (mục 11.1, số 15; mục 28, số 10)."}],"nhom_vi_du":"N1"},{"id":"tuyen-dung","ten":"Truyền thông tuyển dụng","nhom_hoat_dong":["N2","N3"],"vi_du":"Bệnh viện Đa khoa TTH Vinh tuyển điều dưỡng trong tháng 3.","buoc":[{"thuc_hien":["tuyen-dung"],"phoi_hop":[],"noi_dung":"Gửi yêu cầu qua cổng tiếp nhận: vị trí, số lượng, nội dung tin tuyển dụng do Tổ Tuyển dụng soạn, chịu trách nhiệm.","thoi_han":"Theo kế hoạch tuyển dụng","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 31, mảng 26","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tt-nd|yêu cầu cần Tổ trưởng xử lý"],"phoi_hop":[],"noi_dung":"Đủ ô thì tự xác nhận, giao Chuyên viên thiết kế của nhóm có cơ sở tuyển dụng theo bảng phân công (Tổng công ty, TTH Group, cơ sở nhóm 1: nhóm 1; cơ sở nhóm 2: nhóm 2); yêu cầu cần xử lý: Tổ trưởng xử lý trong 04 giờ làm việc.","thoi_han":"Tự xác nhận khi đủ ô; yêu cầu cần Tổ trưởng xử lý 04 giờ làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 11.1, số 30","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tk-a"],"phoi_hop":[],"noi_dung":"Hình ảnh tin tuyển dụng trên mẫu thiết kế sẵn.","thoi_han":"Cấp 1: 01 ngày làm việc; cấp 2: 02 ngày làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 15.2","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tuyen-dung"],"phoi_hop":[],"noi_dung":"Tổ Tuyển dụng xác nhận đúng nội dung; phát hành khi đủ bước kiểm, nghiệm thu.","thoi_han":"Duyệt 01 ngày làm việc","ghi_nhan":"Sổ theo dõi","can_cu":"mục 14.5; 14.16","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qc-a"],"phoi_hop":["dl-1|nguồn khách"],"noi_dung":"Đăng trên kênh TTH Group (Facebook, LinkedIn) và kênh của cơ sở theo lịch đăng; nguồn khách riêng cho tin tuyển dụng.","thoi_han":"Theo lịch đăng","ghi_nhan":"Lịch đăng","can_cu":"mục 11.1, số 30; mảng 26","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Trang tính lịch đăng"},{"thuc_hien":["dl-1"],"phoi_hop":[],"noi_dung":"Đo ứng viên hợp lệ theo nguồn khách (KPI-29). Phân vai KPI-29 đến KPI-35 giữa Marketing, Tổ Tuyển dụng, Phòng Nhân lực chờ quyết định (mục 28, số 30).","thoi_han":"Hằng tháng","ghi_nhan":"Phần mềm","can_cu":"mục 28, số 30","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Nội dung tuyển dụng do Phòng Nhân lực chịu trách nhiệm","Dữ liệu ứng viên chỉ thu qua kênh của Tổ Tuyển dụng"],"ngoai_le":[{"tinh_huong":"Ứng viên nhắn tin hỏi trên kênh","cach_lam":"Contact Center (trước khi nhận: người đang trả lời tại cơ sở) chuyển Tổ Tuyển dụng (Đề xuất – chờ duyệt, mục 28, số 42)."},{"tinh_huong":"Quảng cáo trả phí tuyển dụng","cach_lam":"Chỉ triển khai khi có ngân sách được duyệt; nguồn ngân sách chưa có quy định (mục 28, số 42)."},{"tinh_huong":"Chương trình tuyển dụng nhiều sản phẩm (chiến dịch, ngày hội việc làm, video môi trường làm việc, quảng cáo trả phí)","cach_lam":"Lập Hạng mục theo QT.1 (01 cơ sở) hoặc QT.10 (nhiều cơ sở): Quản lý thương hiệu nhóm 1 lập kế hoạch; Tổ Tuyển dụng (Phòng Nhân lực) chịu nội dung tuyển dụng (vị trí, yêu cầu, quyền lợi); Chuyên viên biên tập, thiết kế, media nhóm 1 sản xuất; quảng cáo trả phí theo QT.57 khi có ngân sách (mục 28, số 42); đo ứng viên hợp lệ (KPI-29) (Đề xuất – chờ duyệt)."}],"nhom_vi_du":"N1"},{"id":"chuyen-quyen","ten":"Chuyển quyền kênh, tài khoản quảng cáo, kho tư liệu về Tổng công ty (Giai đoạn 2)","nhom_hoat_dong":["N11","N3"],"vi_du":"Đợt chuyển của Bệnh viện Đa khoa TTH Hà Tĩnh trong Quý II/2027.","buoc":[{"thuc_hien":["cvt"],"phoi_hop":["tn-a"],"noi_dung":"Lập danh mục kênh, tài khoản quảng cáo, Trang doanh nghiệp trên Google, Trang Zalo chính thức, kho tư liệu, file thiết kế của bệnh viện; người đang giữ quyền. Kênh, tài khoản quảng cáo đưa vào tài khoản doanh nghiệp của pháp nhân trên từng nền tảng (Meta Business Suite, Google, TikTok, Zalo), đăng ký bằng hộp thư chức danh (mục 28, số 21).","thoi_han":"Trước đợt chuyển","ghi_nhan":"Danh sách quyền","can_cu":"mục 21.2; mục 11.3","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tp","cvt"],"phoi_hop":[],"noi_dung":"Cấp quyền theo vị trí cho Tổng công ty trên tài khoản doanh nghiệp của pháp nhân: quyền quản trị cao nhất 02 người (Trưởng phòng – chưa có: Chuyên viên trưởng; Thư ký Ban Tổng Giám đốc mảng Marketing giữ dự phòng); quyền đăng bài, trả lời tin nhắn: Chuyên viên trưởng cấp theo ma trận quyền (mục 11.3). Người đang trả lời tin nhắn tại cơ sở: quyền chỉ trả lời tin nhắn trên hộp thư dùng chung (mục 17). Chuyển quyền kênh của một bệnh viện hoàn tất trước ngày công bố bố trí nhân sự của bệnh viện đó.","thoi_han":"Trước ngày công bố bố trí nhân sự của bệnh viện","ghi_nhan":"Danh sách quyền","can_cu":"mục 11.3","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc-a"],"phoi_hop":["dl-1"],"noi_dung":"Kiểm tra quyền, đăng thử, tài khoản quảng cáo, phương thức thanh toán; Chuyên viên đo lường và đối soát kiểm tra mã theo dõi.","thoi_han":"Ngày chuyển","ghi_nhan":"Biên bản chuyển quyền","can_cu":"mục I.2, số 6","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["md","tk","tk-nt"],"phoi_hop":[],"noi_dung":"Chuyển kho tư liệu lên kho tư liệu theo thư mục của nhóm (Chuyên viên media của nhóm; quyền: Chuyên viên trưởng); file, mẫu thiết kế của nhóm vào thư viện mẫu thiết kế sẵn (Chuyên viên thiết kế của nhóm đưa vào; cấu trúc, quyền thư viện: Chuyên viên thiết kế ngoại tuyến).","thoi_han":"Trong đợt chuyển","ghi_nhan":"kho tư liệu; thư viện mẫu thiết kế sẵn","can_cu":"mục 11.3; QyĐ.04.MKT","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm); Thư viện mẫu trên công cụ thiết kế"},{"thuc_hien":["qc-a"],"phoi_hop":["cc|trước khi nhận: người đang trả lời tại cơ sở – nhận quyền, trả lời trên hộp thư dùng chung"],"noi_dung":"Kết nối tin nhắn, bình luận trên kênh của bệnh viện vào hộp thư dùng chung; email, form, tổng đài, hotline: Phòng Công nghệ – Nghiệp vụ Y. Người đang trả lời tại cơ sở trả lời trên hộp thư dùng chung đến khi Contact Center nhận (mục 17).","thoi_han":"Cùng đợt chuyển quyền kênh","ghi_nhan":"Hộp thư dùng chung","can_cu":"mục 17","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng"},{"thuc_hien":["tp","cvt"],"phoi_hop":[],"noi_dung":"Giữ song song quyền cũ 01 tháng sau nghiệm thu chuyển quyền, chỉ quyền xem; sau đó thu hồi quyền của tài khoản cá nhân: quyền quản trị: Trưởng phòng; quyền đăng bài, trả lời tin nhắn: Chuyên viên trưởng. Quyền chỉ trả lời tin nhắn của người đang trả lời tại cơ sở thu hồi khi Contact Center nhận hộp thư của cơ sở.","thoi_han":"01 tháng sau nghiệm thu","ghi_nhan":"Danh sách quyền","can_cu":"mục 11.3; QyĐ.05.MKT","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":[],"noi_dung":"Biên bản chuyển quyền; cập nhật danh sách quyền của mọi hệ thống.","thoi_han":"Kết thúc đợt","ghi_nhan":"Biên bản chuyển quyền","can_cu":"mục I.2, số 6; mục 11.3","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Không kênh nào bị gián đoạn (mục I.2, số 6)","Quyền gắn với vị trí, không gắn với cá nhân"],"ngoai_le":[{"tinh_huong":"Kênh do cá nhân lập, chưa chuyển được quyền","cach_lam":"Báo Trưởng phòng; người đang quản trị giữ quyền đến khi chuyển được; ghi sổ theo dõi."},{"tinh_huong":"Thời gian giữ song song quyền cũ trước khi thu hồi","cach_lam":"01 tháng sau nghiệm thu, chỉ quyền xem (bước 6)."},{"tinh_huong":"Người giữ quyền cao nhất bằng tài khoản cá nhân nghỉ việc, thuyên chuyển trước khi chuyển quyền","cach_lam":"Chuyển quyền kênh là một mục của biên bản bàn giao (QT.17, bước 2); chưa chuyển được: Trưởng phòng báo Ban Tổng Giám đốc trước ngày người đó nghỉ."}],"nhom_vi_du":"N1"},{"id":"le-tet","ten":"Trang trí tại cơ sở (lễ, Tết; poster, tranh ảnh); vật phẩm thương hiệu","nhom_hoat_dong":["N2","N3"],"vi_du":"Trang trí Tết Nguyên đán năm 2027 tại các cơ sở.","buoc":[{"thuc_hien":["cvtt"],"phoi_hop":["qhcs|khảo sát tại bệnh viện 03 người","tn-b|bệnh viện 02 người kiêm nhiệm"],"noi_dung":"Kế hoạch trang trí, vật phẩm theo dịp cho cơ sở của nhóm: danh mục, dự toán, thời điểm (mỗi nhóm lập phần của nhóm mình; mẫu trang trí toàn hệ thống: bước 2). Truyền thông cơ sở khảo sát hiện trạng, kích thước, vị trí và điều kiện triển khai; bệnh viện 02 người do Trưởng nhóm kiêm nhiệm.","thoi_han":"Trước thời điểm thi công, đủ thời hạn thiết kế theo cấp độ (mục 15.2) cộng thời gian in, thi công","ghi_nhan":"Phần mềm: kế hoạch","can_cu":"mục 31, mảng 15","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tk-nt"],"phoi_hop":["tk|kiểm tra tuân thủ nhận diện của nhóm","cvtt|nghiệm thu đúng yêu cầu"],"noi_dung":"Mẫu trang trí toàn hệ thống trên bộ nhận diện của từng nhóm (danh sách cố định, mục 15.2); Chuyên viên thiết kế của nhóm kiểm tra tuân thủ nhận diện. Vật phẩm theo dịp: Chuyên viên thiết kế của nhóm.","thoi_han":"Theo cấp độ: cấp 3: 05 ngày làm việc; cấp 4: 10 ngày làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 15.2","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tp"],"phoi_hop":[],"noi_dung":"Duyệt mẫu toàn hệ thống, mỗi dịp một lần.","thoi_han":"01 ngày làm việc","ghi_nhan":"Phần mềm","can_cu":"mục 14.16, mảng 15","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bgd-coso"],"phoi_hop":["qhcs|cung cấp ảnh, vị trí và tình trạng hiện trường","tn-b|bệnh viện 02 người kiêm nhiệm"],"noi_dung":"Duyệt áp dụng tại cơ sở: vị trí, số lượng, ngân sách cơ sở.","thoi_han":"01 ngày làm việc","ghi_nhan":"Tờ trình","can_cu":"mục 14.16, mảng 15","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["cvtt","qlth"],"phoi_hop":["nha-cung-cap","mua-sam","dl-1|cộng nhu cầu mua 02 nhóm ngày 20–22","qhcs|bệnh viện 03 người điều phối và kiểm tại chỗ","tn-b|bệnh viện 02 người kiêm nhiệm"],"noi_dung":"In, thi công qua nhà cung cấp đã phê duyệt (Chuyên viên truyền thông của nhóm); tờ trình, hồ sơ hợp đồng, thanh toán (Quản lý thương hiệu của nhóm). File in, sản xuất có xác nhận kỹ thuật của Chuyên viên thiết kế ngoại tuyến (C4). Cùng nhà cung cấp, cùng loại hàng, dịch vụ của 02 nhóm: Chuyên viên đo lường và đối soát cộng nhu cầu mua của 02 nhóm ngày 20–22, sau khi 02 BM-3 được duyệt, trước khi ký; tổng từ 20 triệu đồng trở lên thì đơn vị chủ trì mua sắm làm một hợp đồng, mỗi nhóm một phụ lục (Quy chế chi tiêu nội bộ ban hành kèm Quyết định 189/QĐ-TTH, Điều 32.1: tổng giá trị mua sắm từ 20 triệu đồng trở lên bắt buộc ký hợp đồng; Phòng Tài chính – Kế hoạch xác nhận cách áp dụng cho dịch vụ Marketing).","thoi_han":"Theo kế hoạch","ghi_nhan":"Tờ trình; hợp đồng","can_cu":"mục 11.1, số 11; mảng 30","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục; Trang tính sổ hợp đồng"},{"thuc_hien":["qhcs|bệnh viện 03 người","tn-b|bệnh viện 02 người kiêm nhiệm"],"phoi_hop":["cvtt|kiểm kết quả, nghiệm thu phạm vi truyền thông","tk-nt|kiểm kỹ thuật thiết kế khi có yêu cầu"],"noi_dung":"Chuyên viên Marketing cơ sở – truyền thông chụp ảnh trước, trong và sau thi công, đối chiếu hiện trạng với mẫu/khối lượng được duyệt, ghi nhận vấn đề và chuyển ảnh, biên bản cho Chuyên viên Truyền thông TCT của nhóm; bệnh viện 02 người do Trưởng nhóm kiêm. Chuyên viên Truyền thông TCT kiểm kết quả và ký nghiệm thu trong phạm vi được phân cấp; việc nghiệm thu tài chính thuộc bộ phận có thẩm quyền, không giao cho Media cơ sở.","thoi_han":"Sau thi công","ghi_nhan":"Bộ ảnh nghiệm thu trước–sau; biên bản hiện trường và hồ sơ nghiệm thu theo phân quyền","can_cu":"mục 11.1, số 34","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Mỗi thương hiệu dùng nhận diện của mình","Chi trong ngân sách được duyệt","Không gửi đơn vị in, thi công file chưa có xác nhận kỹ thuật (mục 15.2, C4)"],"ngoai_le":[{"tinh_huong":"Cơ sở cần mẫu riêng ngoài mẫu toàn hệ thống","cach_lam":"Gửi yêu cầu qua cổng tiếp nhận (QT.2); Ban Giám đốc cơ sở duyệt áp dụng."},{"tinh_huong":"Poster, tranh ảnh trang trí cố định tại một cơ sở (khu vực chờ, hành lang, phòng bệnh)","cach_lam":"Chuyên viên truyền thông của nhóm đề xuất, dự toán; Chuyên viên thiết kế ngoại tuyến làm trên bộ mẫu trang trí của nhóm (danh sách cố định, mục 15.2); Chuyên viên truyền thông của nhóm nghiệm thu; Ban Giám đốc cơ sở duyệt áp dụng, ngân sách. Poster có dịch vụ, giá, ưu đãi không phải trang trí: làm theo QT.2, Chuyên viên thiết kế của nhóm làm (mục 15.2, nguyên tắc thông điệp dịch vụ). Poster chỉ hiển thị trên màn hình nội viện: Chuyên viên thiết kế của nhóm."},{"tinh_huong":"Poster thuộc Hạng mục","cach_lam":"Chuyên viên thiết kế của nhóm làm, cả bản số và bản in (gỡ khi Hạng mục kết thúc); đặt vào khung trang trí có sẵn thì khung vẫn của Chuyên viên thiết kế ngoại tuyến (nguyên tắc khung – ruột, mục 15.2)."},{"tinh_huong":"Trang trí toàn bộ khoa phòng của một cơ sở","cach_lam":"Đợt đầu: giờ dự án cùng Giai đoạn 3; bộ mẫu trang trí theo nhóm (cấp 3–4), áp dụng cho từng khoa (cấp 1); Chuyên viên Marketing cơ sở – media đo, chụp hiện trạng; khoa phòng cung cấp nội dung. Vượt giờ của Chuyên viên thiết kế ngoại tuyến: phần của cơ sở nhóm nào do Chuyên viên thiết kế của nhóm đó làm."}],"nhom_vi_du":"chung"},{"id":"crm","ten":"Triển khai CRM đa kênh","nhom_hoat_dong":["N9","N8","N10","N11"],"vi_du":"Sau Giai đoạn 2, toàn hệ thống đã về hộp thư dùng chung; Ban Tổng Giám đốc duyệt nền tảng CRM; Phòng Công nghệ – Nghiệp vụ Y làm kỹ thuật, kết nối.","buoc":[{"thuc_hien":["dl-2"],"phoi_hop":["phap-che|hồ sơ đánh giá tác động","btgd|chỉ định đơn vị, nhân sự bảo vệ dữ liệu cá nhân"],"noi_dung":"Đưa các việc xử lý dữ liệu cá nhân của Marketing (CRM, gửi tin, quảng cáo nhắm đối tượng, mã theo dõi, giấy đồng ý hình ảnh) vào hồ sơ đánh giá tác động xử lý dữ liệu cá nhân của pháp nhân. Đơn vị, nhân sự bảo vệ dữ liệu cá nhân do Ban Tổng Giám đốc chỉ định (không phải Phòng Marketing); Chuyên viên dữ liệu khách hàng và thị trường là đầu mối của Marketing. Cập nhật khi có mục đích xử lý mới; trong 10 ngày khi tái cơ cấu (bộ phận pháp chế xác nhận trường hợp chuyển Marketing về Tổng công ty).","thoi_han":"Trước Giai đoạn 2 (điều kiện tiên quyết, mục 25)","ghi_nhan":"Hồ sơ đánh giá tác động của pháp nhân","can_cu":"Luật Bảo vệ dữ liệu cá nhân 91/2025/QH15; Nghị định 356/2025/NĐ-CP; mục 25","de_xuat":false,"chua_co_phan_mem":"Như cột ghi nhận","thu_tu":1},{"thuc_hien":["dl-2","dl-1","qlsps"],"phoi_hop":["cc|quy trình tiếp nhận","qc|gửi tin hàng loạt của nhóm"],"noi_dung":"Lập yêu cầu nghiệp vụ: nguồn đa kênh, trường dữ liệu, quy tắc gộp hồ sơ trùng, đồng ý, quyền theo vai trò (Chuyên viên dữ liệu khách hàng và thị trường); quy trình tiếp nhận, tiêu chí Lead hợp lệ, báo cáo KPI-18, KPI-19 (Chuyên viên đo lường và đối soát); Chuyên viên dữ liệu khách hàng và thị trường tổng hợp, gửi Phòng Công nghệ – Nghiệp vụ Y; phần kết nối form, trang đích trên website, App TTH: Quản lý sản phẩm số gửi Phòng Số hóa.","thoi_han":"Giai đoạn 2","ghi_nhan":"Yêu cầu nghiệp vụ trên phần mềm","can_cu":"mục 11.1, số 37; mục 17.1","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tp"],"phoi_hop":["btgd|duyệt","cnnvy"],"noi_dung":"Trình Ban Tổng Giám đốc nền tảng CRM, ngân sách. Kỹ thuật, kết nối tổng đài 19002675, hotline di động, email, form, HIS: Phòng Công nghệ – Nghiệp vụ Y (Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026).","thoi_han":"Sau khi có yêu cầu nghiệp vụ","ghi_nhan":"Tờ trình","can_cu":"mục 28, số 11, 45","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["cnnvy","so-hoa"],"phoi_hop":["dl-2|đầu mối yêu cầu, nghiệm thu","qlsps|phần website, App TTH","phap-che|trường dữ liệu, đồng ý"],"noi_dung":"Thiết lập CRM; kết nối tổng đài 19002675, hotline di động, email, form, HIS theo trường dữ liệu được duyệt (Phòng Công nghệ – Nghiệp vụ Y). Kết nối form, trang đích trên website, App TTH với CRM (Phòng Số hóa, theo yêu cầu của Quản lý sản phẩm số).","thoi_han":"Theo kế hoạch được duyệt","ghi_nhan":"Biên bản kỹ thuật","can_cu":"mục 17; mục 17.1","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cnnvy","dl-2"],"phoi_hop":[],"noi_dung":"Phòng Công nghệ – Nghiệp vụ Y chuyển dữ liệu từ hộp thư dùng chung, sổ Lead; gộp hồ sơ trùng; tạo tài khoản theo danh sách quyền. Chuyên viên dữ liệu khách hàng và thị trường lập chuẩn dữ liệu, quy tắc gộp hồ sơ trùng, danh sách quyền theo vai trò; kiểm tra kết quả chuyển.","thoi_han":"Trước thí điểm","ghi_nhan":"CRM; danh sách quyền","can_cu":"mục 17.1, R1, R7; mục 11.3","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng"},{"thuc_hien":["cc"],"phoi_hop":["tp|duyệt bản gốc kịch bản","cc","tiep-don"],"noi_dung":"Contact Center soạn và duyệt nghiệp vụ kịch bản tư vấn, kịch bản trả lời tự động theo phân cấp (Marketing cung cấp thông tin đã duyệt); đào tạo Contact Center, bộ phận tiếp đón (Chuyên viên đo lường và đối soát).","thoi_han":"Trước thí điểm","ghi_nhan":"Biên bản đào tạo","can_cu":"mục 9.2; mục 31, mảng 17","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-2","dl-1","qlsps"],"phoi_hop":["tp|nghiệm thu"],"noi_dung":"Thí điểm tại 01 cơ sở; Chuyên viên dữ liệu khách hàng và thị trường nghiệm thu nghiệp vụ (dữ liệu, quy tắc, quyền; giai đoạn đầu: Chuyên viên đo lường và đối soát kiêm); Chuyên viên dữ liệu khách hàng và thị trường nghiệm thu cả chức năng theo yêu cầu đã gửi Phòng Công nghệ – Nghiệp vụ Y; Quản lý sản phẩm số nghiệm thu phần kết nối form, trang đích; Chuyên viên đo lường và đối soát đối chiếu KPI-04, KPI-05, KPI-18 với hộp thư dùng chung.","thoi_han":"01 quý","ghi_nhan":"Biên bản nghiệm thu","can_cu":"mục 14.15, số 32","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tp","dl-2"],"phoi_hop":[],"noi_dung":"Áp dụng toàn hệ thống theo đợt; dừng hộp thư dùng chung sau khi nghiệm thu từng đợt; rà soát chất lượng dữ liệu hằng tháng.","thoi_han":"Sau thí điểm","ghi_nhan":"CRM; mục 30","can_cu":"mục 17.1","de_xuat":true,"thu_tu":8,"chua_co_phan_mem":"Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng"}],"kiem_soat":["Mỗi khách một hồ sơ; mỗi Lead một nguồn khách, một người xử lý (R1, R2)","Không lưu Lead, không xuất danh sách khách ngoài CRM (R3, R4)","Thông tin sức khỏe chi tiết giữ trong HIS; CRM chỉ nhận trường dữ liệu được duyệt","Ô đồng ý để trống, không đặt sẵn; dữ liệu khách chỉ chuyển ra ngoài pháp nhân khi có yêu cầu hoặc đồng ý bằng văn bản của khách (Nghị định 330/2026/NĐ-CP)"],"ngoai_le":[{"tinh_huong":"Nền tảng CRM chưa được quyết định","cach_lam":"Giữ hộp thư dùng chung, sổ Lead trên phần mềm Quản trị Marketing (mục 28, số 45)."},{"tinh_huong":"Khách đề nghị xóa dữ liệu, rút đồng ý","cach_lam":"Chuyên viên dữ liệu khách hàng và thị trường xử lý trên CRM, loại khỏi danh sách gửi tin (mục 16, số 20)."}],"nhom_vi_du":"N1"},{"id":"chuong-trinh-he-thong","ten":"Chương trình trọng điểm theo hệ thống bệnh viện, phòng khám: gói khám, gói điều trị, hội thảo, lớp học","nhom_hoat_dong":["N1","N2","N4","N6","N10"],"vi_du":"Chương trình tầm soát ung thư đường tiêu hóa áp dụng chung cho 03 bệnh viện TTH Hospital, kèm hội thảo tư vấn cho người dân tại từng bệnh viện.","buoc":[{"thuc_hien":["tp","qlth-a"],"phoi_hop":["dl-2|thông tin thị trường","tn-a|nhu cầu cơ sở"],"noi_dung":"Trưởng phòng chủ trì: đưa chương trình trọng điểm theo hệ thống vào danh mục Hạng mục của kế hoạch năm (tháng 12), hoặc đề xuất bổ sung trong năm. Quản lý thương hiệu của nhóm lập đề xuất chi tiết: loại (gói khám, gói điều trị, hội thảo, lớp học), phạm vi áp dụng (hệ thống bệnh viện, phòng khám của một thương hiệu; từ 02 cơ sở), đối tượng, kết quả cần đạt. Chuyên viên dữ liệu khách hàng và thị trường cung cấp thông tin thị trường, giá đối thủ; Trưởng nhóm các cơ sở gửi nhu cầu, khả năng tiếp nhận.","thoi_han":"Kế hoạch năm (tháng 12) hoặc chậm nhất ngày 15 tháng trước, cùng nhu cầu tháng","ghi_nhan":"Phần mềm: nhu cầu, kế hoạch","can_cu":"mục 4.2; mục 31, mảng 1, 3; mục 16, số 12","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["don-vi-chuyen-mon","khoa-phong","bac-si"],"phoi_hop":[],"noi_dung":"Nội dung chuyên môn chung: gói khám, gói điều trị: thành phần, chỉ định, chống chỉ định, số buổi, quy trình; hội thảo, lớp học: chương trình, báo cáo viên, tài liệu chuyên môn. Marketing không quyết nội dung chuyên môn.","thoi_han":"Theo quy định chuyên môn","ghi_nhan":"Hồ sơ chương trình","can_cu":"mục 31, mảng 3","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["ke-toan","bgd-coso"],"phoi_hop":[],"noi_dung":"Kế toán tính giá, phí, mức ưu đãi chung; Ban Giám đốc từng cơ sở xác nhận khả năng tiếp nhận, lịch, địa điểm.","thoi_han":"Theo quy định của cơ sở","ghi_nhan":"Hồ sơ chương trình","can_cu":"mục 31, mảng 3","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tp","btgd"],"phoi_hop":["bgd-coso|ý kiến của từng cơ sở"],"noi_dung":"Trưởng phòng trình Ban Tổng Giám đốc chương trình áp dụng từ 02 cơ sở (tờ trình: nội dung chung, giá, ưu đãi, ngân sách; kèm ý kiến đơn vị chuyên môn, kế toán, Ban Giám đốc các cơ sở); Ban Tổng Giám đốc duyệt. Trưởng phòng duyệt kế hoạch Marketing của chương trình.","thoi_han":"Duyệt chậm nhất ngày 20 tháng trước","ghi_nhan":"Quyết định; tờ trình","can_cu":"mục 4.2; mục 31, mảng 3; mục 14.15, số 38","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["qlth-a"],"phoi_hop":["qhcs|hậu cần hội thảo, lớp học"],"noi_dung":"Lập Hạng mục theo QT.10 (Quản lý thương hiệu của nhóm là chủ Hạng mục, chịu kết quả). Hội thảo, lớp học tại cơ sở: Truyền thông cơ sở (bệnh viện 02 người: Trưởng nhóm) lo hậu cần, điều phối theo QT.21.","thoi_han":"Trình chậm nhất ngày 18; duyệt chậm nhất ngày 20","ghi_nhan":"Phần mềm: Hạng mục","can_cu":"mục 13; mục 14.5; QT.10; QT.21","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["bt-ac","tk-a","md-ac"],"phoi_hop":["bt-ac|người còn lại trong nhóm – kiểm pháp lý tầng 1","phap-che|rủi ro cao","bac-si","tk-nt|xác nhận kỹ thuật file in","mdcs-a|ghi hình tại chỗ"],"noi_dung":"Nội dung truyền thông: Chuyên viên biên tập của nhóm, kiểm pháp lý theo tầng (hiệu quả điều trị là nội dung rủi ro cao: thêm ý kiến pháp chế); bác sĩ xác nhận chuyên môn. Thiết kế: Chuyên viên thiết kế của nhóm, cả bản số và bản in, file in qua Chuyên viên thiết kế ngoại tuyến xác nhận kỹ thuật. Media: ghi hình hội thảo, lớp học.","thoi_han":"Theo thời hạn chuẩn","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 16, số 4; mục 15.2","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlsps","qc-a","cc|trước khi nhận: người đang trả lời tại cơ sở"],"phoi_hop":["cc|chủ trì kịch bản tư vấn; biên tập chỉ cung cấp thông tin duyệt","dl-2|danh sách đã đồng ý, lịch gửi chung","qlth-a|duyệt ngân sách quảng cáo (mục 14.5, bước 7); nghiệm thu kịch bản tư vấn"],"noi_dung":"Trang chương trình, form đăng ký hội thảo, lớp học trên website, App TTH (Quản lý sản phẩm số); quảng cáo, đăng kênh (Chuyên viên quảng cáo và kênh số của nhóm); tiếp nhận đăng ký, tư vấn theo kịch bản (Contact Center); gửi lời mời cho khách đã đồng ý trên kênh của nhóm, theo lịch gửi chung (Chuyên viên quảng cáo và kênh số của nhóm).","thoi_han":"Trước ngày áp dụng","ghi_nhan":"Website, App TTH; hộp thư dùng chung","can_cu":"mục 31, mảng 16, 17, 18","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Hộp thư dùng chung; bảng Lead tách riêng có mật khẩu, bảng dùng chung chỉ ghi số tổng"},{"thuc_hien":["tiep-don","qhcs"],"phoi_hop":[],"noi_dung":"Tại cơ sở: bộ phận tiếp đón ghi mã chương trình, nguồn khách; hội thảo, lớp học: danh sách đăng ký, điểm danh người tham dự, giấy đồng ý chụp ảnh (Truyền thông cơ sở).","thoi_han":"Ngày diễn ra","ghi_nhan":"Phần mềm: danh sách tham dự","can_cu":"mục 31, mảng 18, 20","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-1","qlth-a","tp"],"phoi_hop":["btgd|quyết định","bgd-coso|ý kiến của từng cơ sở"],"noi_dung":"Đối soát đăng ký – tham dự – khách – doanh thu ghi nhận theo cơ sở; Quản lý thương hiệu tổng kết; Trưởng phòng báo cáo, đề xuất tiếp tục, điều chỉnh, dừng. Ban Tổng Giám đốc quyết định.","thoi_han":"Báo cáo nhanh 01 ngày sau khi kết thúc; kết quả chính thức sau kỳ chốt số liệu","ghi_nhan":"Phần mềm","can_cu":"mục 14.7; mục 31, mảng 32","de_xuat":false,"thu_tu":9,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Trưởng phòng chủ trì: chương trình trọng điểm theo hệ thống nằm trong kế hoạch năm do Trưởng phòng lập; bổ sung trong năm: Trưởng phòng đề xuất, dùng dự phòng hoặc điều chỉnh kế hoạch năm (mục 4.2)","Nội dung chuyên môn: đơn vị chuyên môn, khoa phòng, bác sĩ; giá, phí: kế toán; duyệt theo phạm vi áp dụng; Marketing đề xuất, lập Hạng mục, truyền thông, tổ chức, đo kết quả","Không đăng giá, ưu đãi chưa được duyệt; tin cơ sở tự đăng không có giá, ưu đãi (mục 16, số 5)","Đổi giá, ưu đãi: cập nhật cùng lúc website, App TTH, kịch bản tư vấn, ấn phẩm","Dữ liệu người đăng ký hội thảo, lớp học chỉ dùng theo nội dung đã đồng ý (mục 17.1)"],"ngoai_le":[{"tinh_huong":"Cơ sở muốn mức ưu đãi khác mức chung của chương trình hệ thống","cach_lam":"Ban Giám đốc cơ sở đề nghị qua Quản lý thương hiệu của nhóm; Ban Tổng Giám đốc duyệt (Đề xuất – chờ duyệt)."},{"tinh_huong":"Chương trình chỉ của 01 cơ sở","cach_lam":"Ban Giám đốc cơ sở duyệt; Marketing làm theo QT.1."},{"tinh_huong":"Hội nghị khoa học cho nhân viên y tế","cach_lam":"Làm theo QT.12."},{"tinh_huong":"Gói cho doanh nghiệp, tổ chức","cach_lam":"Bán, ký hợp đồng: đơn vị do Ban Tổng Giám đốc xác định (mục 28, số 24); Marketing làm truyền thông, hồ sơ năng lực."}],"nhom_vi_du":"N1"},{"id":"mao-danh","ten":"Mạo danh, tin giả về bệnh viện, bác sĩ, thương hiệu trên mạng","nhom_hoat_dong":["N5","N3"],"vi_du":"Một trang Facebook dùng tên, logo Bệnh viện Đa khoa TTH Hà Tĩnh và ảnh một bác sĩ của bệnh viện để nhận đặt lịch, thu tiền trước.","buoc":[{"thuc_hien":["cvtt-a"],"phoi_hop":["mkt-coso|báo phát hiện","cc|báo phát hiện"],"noi_dung":"Phát hiện khi theo dõi dư luận hằng ngày, hoặc nhận báo từ Marketing cơ sở, Contact Center, nhân viên, khách. Báo theo lịch trực sự cố.","thoi_han":"Báo trong 30 phút","ghi_nhan":"Sổ theo dõi sự cố","can_cu":"mục 30 (sự cố kênh); mảng 42","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvtt-a"],"phoi_hop":[],"noi_dung":"Xác minh; lưu bằng chứng (ảnh chụp, đường dẫn, thời điểm, nội dung giả) trước khi báo cáo; không tương tác với tài khoản mạo danh.","thoi_han":"Trong ngày","ghi_nhan":"Sổ theo dõi sự cố; kho tư liệu","can_cu":"mảng 42","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính); Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["qc"],"phoi_hop":["phap-che|hồ sơ nhãn hiệu","qlth|xác nhận thương hiệu của nhóm"],"noi_dung":"Báo cáo vi phạm mạo danh, vi phạm nhãn hiệu lên nền tảng theo chính sách nền tảng (Chuyên viên quảng cáo và kênh số của nhóm có thương hiệu bị mạo danh); bộ phận pháp chế cung cấp hồ sơ nhãn hiệu khi nền tảng yêu cầu.","thoi_han":"Trong ngày","ghi_nhan":"Mã báo cáo của nền tảng","can_cu":"mảng 42; mảng 8","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["cvtt"],"phoi_hop":["tp|duyệt","qc|đăng","bt|kịch bản"],"noi_dung":"Cảnh báo khách trên kênh chính thức của thương hiệu bị mạo danh (nội dung: Chuyên viên truyền thông của nhóm; Trưởng phòng duyệt (mục 14.16); Chuyên viên quảng cáo và kênh số của nhóm đăng); cập nhật kịch bản trả lời của Contact Center; báo bác sĩ bị mạo danh, hướng dẫn bác sĩ báo cáo trên tài khoản cá nhân (mảng 24). Mạo danh cả hai nhóm: Chuyên viên trưởng chủ quy trình, mỗi nhóm làm phần của nhóm mình.","thoi_han":"Trong ngày","ghi_nhan":"Kênh chính thức; kịch bản tư vấn","can_cu":"mảng 42; mảng 24","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["phap-che"],"phoi_hop":["cvtt-a|bằng chứng","tp|nhận báo cáo, làm việc với Ban Tổng Giám đốc khi có dấu hiệu lừa đảo"],"noi_dung":"Đánh giá pháp lý; báo cơ quan chức năng khi có dấu hiệu lừa đảo, vi phạm nhãn hiệu.","thoi_han":"Theo đánh giá của bộ phận pháp chế","ghi_nhan":"Hồ sơ pháp lý","can_cu":"mảng 42","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvtt-a"],"phoi_hop":[],"noi_dung":"Theo dõi đến khi gỡ; báo cáo sự cố; có dấu hiệu khủng hoảng: làm theo QT.6.","thoi_han":"Báo cáo sự cố trong 48 giờ","ghi_nhan":"Sổ theo dõi sự cố","can_cu":"mục 30 (sự cố kênh)","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvtt-a","qlsps"],"phoi_hop":["tp|nhận báo cáo quý"],"noi_dung":"Tổng hợp hằng quý; danh sách kênh chính thức công khai trên website, App TTH để khách đối chiếu (Đề xuất – chờ duyệt).","thoi_han":"Hằng quý","ghi_nhan":"Báo cáo quý; website, App TTH","can_cu":"mảng 42; mục 30","de_xuat":true,"thu_tu":7,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["Lưu bằng chứng trước khi báo cáo nền tảng","Không tương tác, không trả lời tài khoản mạo danh","Một người điều phối: Chuyên viên truyền thông nhóm 1"],"ngoai_le":[{"tinh_huong":"Mạo danh có thu tiền của khách","cach_lam":"Bộ phận pháp chế báo cơ quan chức năng; Contact Center hướng dẫn khách theo kịch bản; khách khiếu nại: bộ phận tiếp nhận, xử lý phản ánh của cơ sở."},{"tinh_huong":"Kênh mạo danh là kênh cũ do nhân viên đã nghỉ lập","cach_lam":"Làm theo QT.17, QT.23 (thu hồi, chuyển quyền); không thu hồi được thì báo cáo nền tảng như kênh mạo danh."},{"tinh_huong":"Tin giả, thông tin sai về bệnh viện, bác sĩ, thương hiệu trên trang khác (không mạo danh)","cach_lam":"Chuyên viên truyền thông nhóm 1 xác minh với đơn vị nguồn (khoa phòng, Ban Giám đốc cơ sở, bộ phận tiếp nhận, xử lý phản ánh của cơ sở); lưu bằng chứng như bước 2; báo cáo nền tảng như bước 3; cần thông tin chính thức: soạn, duyệt, đăng như bước 4. Nội dung Marketing đã phát hành bị sai: QT.38; lan rộng, báo chí đưa tin: QT.6; có dấu hiệu vi phạm pháp luật: bộ phận pháp chế như bước 5. (Đề xuất – chờ duyệt)"},{"tinh_huong":"Đơn vị khác dùng tên, nhãn hiệu TTH trong quảng cáo, từ khóa tìm kiếm","cach_lam":"Báo cáo vi phạm nhãn hiệu lên nền tảng như bước 3 (Quản lý thương hiệu nhóm 1 cung cấp hồ sơ nhãn hiệu); bộ phận pháp chế đánh giá khi có dấu hiệu cạnh tranh không lành mạnh. (Đề xuất – chờ duyệt)"}],"nhom_vi_du":"N1"},{"id":"ra-soat-noi-dung-y-khoa","ten":"Rà soát định kỳ nội dung y khoa; thông tin công khai của cơ sở trên website, App TTH","nhom_hoat_dong":["N2","N8","N11"],"vi_du":"Bài \"Tầm soát ung thư cổ tử cung\" đăng năm 2025 trên website tthhealthcare.com đến hạn rà soát; Bộ Y tế vừa cập nhật hướng dẫn chuyên môn liên quan.","buoc":[{"thuc_hien":["qlsps"],"phoi_hop":[],"noi_dung":"Gắn cho từng bài, trang nội dung y khoa: ngày đăng, ngày rà soát, bác sĩ xác nhận; lập danh sách đến hạn rà soát hằng tháng.","thoi_han":"Hằng tháng","ghi_nhan":"Trang quản trị nội dung website; danh sách đến hạn","can_cu":"mục 30; mảng 16","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt"],"phoi_hop":["bac-si|xác nhận lại"],"noi_dung":"Chuyên viên biên tập của nhóm rà soát bài đến hạn; bác sĩ xác nhận lại; cập nhật hoặc gỡ. Chu kỳ rà soát do Trưởng phòng quy định (Đề xuất – chờ duyệt: tối đa 02 năm; sớm hơn khi hướng dẫn chuyên môn thay đổi). Cleveland Clinic rà soát lại ít nhất vài năm một lần, sớm hơn khi có tiến bộ y khoa.","thoi_han":"Theo danh sách đến hạn","ghi_nhan":"Trang quản trị nội dung website: ngày rà soát mới","can_cu":"mảng 4","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc","qlsps","bt"],"phoi_hop":["tn|gửi yêu cầu","bgd-coso|báo bác sĩ nghỉ trong 01 ngày làm việc","nhan-luc|báo nghỉ việc"],"noi_dung":"Bác sĩ nghỉ việc, chuyển công tác: Ban Giám đốc cơ sở báo Trưởng nhóm Marketing cơ sở trong 01 ngày làm việc; Trưởng nhóm gửi yêu cầu qua cổng tiếp nhận. Trong 01 ngày làm việc: Chuyên viên quảng cáo và kênh số của nhóm dừng quảng cáo, ẩn bài có bác sĩ; Quản lý sản phẩm số gỡ hồ sơ, lịch bác sĩ trên website, App TTH, cập nhật danh sách người hành nghề công khai. Theo danh sách đến hạn: Chuyên viên biên tập của nhóm sửa bài có trích dẫn bác sĩ.","thoi_han":"01 ngày làm việc từ khi cơ sở báo","ghi_nhan":"Phần mềm: bài, sản phẩm gắn thẻ bác sĩ để lọc","can_cu":"QT.17; mảng 16","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Cột \"bác sĩ\" trên sổ đăng bài để lọc; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tn","dmpk"],"phoi_hop":["ke-toan|giá","don-vi-chuyen-mon|người hành nghề, danh mục kỹ thuật"],"noi_dung":"Gửi thay đổi thông tin của cơ sở qua cổng tiếp nhận yêu cầu: giá (kế toán), người hành nghề, danh mục dịch vụ, kỹ thuật được phép (đơn vị chuyên môn). Lịch bác sĩ, thông tin cơ sở: gửi theo QT.14.","thoi_han":"Khi có thay đổi","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mảng 43","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlsps"],"phoi_hop":["phap-che|danh mục bắt buộc","bgd-coso|xác nhận đúng thông tin"],"noi_dung":"Cập nhật thông tin công khai trên website, App TTH; đối chiếu hằng tháng với dữ liệu của cơ sở theo danh mục bắt buộc do bộ phận pháp chế xác nhận.","thoi_han":"Cập nhật 01 ngày làm việc sau khi nhận đủ thông tin (Đề xuất – chờ duyệt); đối chiếu hằng tháng","ghi_nhan":"Website, App TTH; sổ đối chiếu","can_cu":"mảng 43; mục 28, số 46","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt"],"phoi_hop":[],"noi_dung":"Trước khi viết bài dịch vụ: đối chiếu dịch vụ, kỹ thuật với danh mục được phép của cơ sở theo danh sách kiểm tra pháp lý.","thoi_han":"Mỗi bài dịch vụ","ghi_nhan":"Danh sách kiểm tra pháp lý","can_cu":"mục 14.15, số 40; mục 28, số 40","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qlsps"],"phoi_hop":["tp|nhận báo cáo quý"],"noi_dung":"Báo cáo: số bài đến hạn, đã rà soát, đã cập nhật, đã gỡ; sai lệch thông tin công khai đã sửa.","thoi_han":"Hằng quý","ghi_nhan":"Phần mềm: báo cáo quý","can_cu":"mục 30","de_xuat":true,"thu_tu":7,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["Không bài nội dung y khoa nào quá hạn rà soát mà còn hiển thị","Thông tin công khai một nguồn: dữ liệu do cơ sở cung cấp qua cổng tiếp nhận yêu cầu","Không quảng cáo dịch vụ, kỹ thuật ngoài danh mục được phép"],"ngoai_le":[{"tinh_huong":"Bác sĩ không còn ở cơ sở để xác nhận lại","cach_lam":"Trưởng khoa hoặc bác sĩ cùng chuyên khoa xác nhận; không có thì gỡ bài."},{"tinh_huong":"Hướng dẫn chuyên môn của Bộ Y tế thay đổi","cach_lam":"Rà soát ngay các bài liên quan, không chờ đến hạn."}],"nhom_vi_du":"N1"},{"id":"phat-thanh-man-hinh","ten":"Phát thanh, màn hình nội viện","nhom_hoat_dong":["N3","N2"],"vi_du":"Bệnh viện Y học cổ truyền Nguyên Phúc phát bản tin giáo dục sức khỏe, lịch bác sĩ trên hệ thống phát thanh nội viện; màn hình khu vực chờ phát nội dung Hạng mục đang triển khai.","buoc":[{"thuc_hien":["tn-b"],"phoi_hop":["bgd-coso|thống nhất nội dung","qlth-bc|nội dung Hạng mục cần phát"],"noi_dung":"Gửi nhu cầu phát thanh, màn hình của tuần sau qua cổng tiếp nhận yêu cầu: thông báo vận hành, sự kiện, lịch bác sĩ, chủ đề giáo dục sức khỏe. Nội dung theo tháng gửi cùng nhu cầu tháng (ngày 10–15).","thoi_han":"Trước thứ Tư hằng tuần","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 8; mục 30; mục 31, mảng 13, 14","de_xuat":true,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvtt-bc"],"phoi_hop":["cvt|duyệt kế hoạch phát","qlth-bc|nội dung Hạng mục của nhóm 2 (gồm phần nhóm 2 của Hạng mục toàn hệ thống)"],"noi_dung":"Lập kế hoạch phát tuần theo cơ sở: bản tin, khung giờ, tần suất, thời lượng; nội dung màn hình nội viện lập trong cùng kế hoạch.","thoi_han":"Trước thứ Tư; phát từ thứ Hai","ghi_nhan":"Lịch phát màn hình, phát thanh nội viện (mục 9.4)","can_cu":"QT.MKT.22; mục 14.7; mục 16.1","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt-b"],"phoi_hop":["bac-si|xác nhận chuyên môn","bt-ac|kiểm pháp lý ngang hàng – ngoại lệ, người trung lập cho phép có thời hạn (mục 15.4)"],"noi_dung":"Viết kịch bản bản tin từ kịch bản phát thanh mẫu; thông điệp màn hình theo kế hoạch phát.","thoi_han":"03 ngày làm việc","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.7; mục 16.1","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["md-b"],"phoi_hop":["tk-b|file màn hình (đồ họa, kích thước)"],"noi_dung":"Thu âm, dựng file âm thanh theo chuẩn kỹ thuật media; Chuyên viên thiết kế của nhóm làm file màn hình. Lưu kho tư liệu theo thư mục cơ sở. Dùng giọng đọc tạo bằng trí tuệ nhân tạo: theo QT.18.","thoi_han":"Trước ngày phát 01 ngày làm việc","ghi_nhan":"kho tư liệu","can_cu":"mục 15.3; QyĐ.04.MKT","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Kho tư liệu (thư mục theo nhóm)"},{"thuc_hien":["tn-b|kiêm truyền thông cơ sở tại bệnh viện 02 người"],"phoi_hop":["tn-b"],"noi_dung":"Trưởng nhóm Marketing cơ sở nhóm 2 kiêm Truyền thông cơ sở tại bệnh viện 02 người: phát theo kế hoạch, cập nhật file màn hình, kiểm tra âm thanh/hiển thị và ghi nhật ký phát. Tại bệnh viện 03 người, trách nhiệm này thuộc Chuyên viên Marketing cơ sở – truyền thông. Không giao cho Media cơ sở.","thoi_han":"Theo kế hoạch phát","ghi_nhan":"Nhật ký phát trên phần mềm","can_cu":"mục 8; mục 16.1","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tn-b|kiêm truyền thông cơ sở tại bệnh viện 02 người; qhcs|bệnh viện 03 người"],"phoi_hop":["hcqt|sửa chữa thiết bị","cvtt-bc|điều chỉnh kế hoạch phát"],"noi_dung":"Truyền thông cơ sở (bệnh viện 02 người: Trưởng nhóm kiêm) kiểm tra vận hành, hiển thị theo lịch; thiết bị hỏng báo Hành chính quản trị sửa chữa và báo Truyền thông TCT điều chỉnh lịch. Trưởng nhóm giám sát tại cơ sở.","thoi_han":"Hằng tuần; thiết bị hỏng: báo trong ngày","ghi_nhan":"Sổ theo dõi","can_cu":"mục 8; mục 17","de_xuat":true,"thu_tu":6,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvtt-bc"],"phoi_hop":["dl-1|số liệu KPI"],"noi_dung":"Tổng hợp hằng tháng theo cơ sở: số lượt phát đúng kế hoạch; cập nhật kịch bản mẫu, kế hoạch tháng sau.","thoi_han":"Ngày làm việc đầu tháng","ghi_nhan":"Báo cáo tháng","can_cu":"mục 12.5","de_xuat":true,"thu_tu":7,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["Mọi bản tin, nội dung màn hình có trong kế hoạch phát đã duyệt","Nội dung chuyên môn có bác sĩ xác nhận, qua kiểm pháp lý theo tầng trước khi phát","Dịch vụ, giá, ưu đãi chỉ phát khi thuộc Hạng mục đã duyệt"],"ngoai_le":[{"tinh_huong":"Thông báo khẩn tại cơ sở (tìm người nhà, sự cố, hướng dẫn an toàn)","cach_lam":"Thông báo khẩn phục vụ an toàn/vận hành do cơ sở thực hiện theo quy định chuyên ngành; đầu mối Truyền thông cơ sở hoặc Trưởng nhóm kiêm ghi nhận nhật ký, không giao Media cơ sở."},{"tinh_huong":"Cơ sở không bố trí Chuyên viên Truyền thông cơ sở riêng hoặc vị trí này vắng","cach_lam":"Trưởng nhóm cơ sở kiêm hoặc bố trí người thay có phân quyền vận hành theo lịch; Media cơ sở không tự động tiếp quản phát thanh/màn hình. Phòng khám: đầu mối kiêm nhiệm theo phân công."},{"tinh_huong":"Khoa phòng đề nghị phát nội dung riêng","cach_lam":"Gửi qua Trưởng nhóm Marketing cơ sở; đưa vào kế hoạch tuần sau."}],"nhom_vi_du":"N2"},{"id":"xung-dot-lich","ten":"Hai cơ sở, hai nhóm thương hiệu cùng cần một nguồn lực","nhom_hoat_dong":["N11"],"vi_du":"Cùng ngày thứ Bảy, Bệnh viện Đa khoa TTH Vinh và Bệnh viện Y học cổ truyền Nguyên Phúc cùng cần bộ thiết bị media dùng chung.","buoc":[{"thuc_hien":["cvt|xử lý trùng lịch giữa hai nhóm hoặc thiết bị media dùng chung","tt-nd|chỉ xử lý trùng lịch trong nhóm 1"],"phoi_hop":[],"noi_dung":"Phần mềm báo trùng lịch khi xếp lịch sản xuất chung (chưa có phần mềm: người nhận yêu cầu thứ hai ghi \"cần Tổ trưởng xử lý\" trên sổ yêu cầu); Tổ trưởng của tổ xếp theo thứ tự ưu tiên: việc không được gián đoạn, Hạng mục trọng điểm; nhu cầu tháng đã duyệt; việc phát sinh. Trùng lịch ghi hình trong nhóm: người còn lại cùng nhóm đi; nhóm 2: lùi lịch hoặc Chuyên viên Marketing cơ sở – media cùng nhóm quay tư liệu.","thoi_han":"Yêu cầu cần Tổ trưởng xử lý: trong 04 giờ làm việc từ khi nhận yêu cầu thứ hai","ghi_nhan":"Lịch sản xuất chung; sổ theo dõi yêu cầu","can_cu":"mục 14.8, 14.9; mục 15.3","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlth-a","qlth-bc"],"phoi_hop":["tn-a","tn-b","cvt|quyết khi không thống nhất"],"noi_dung":"Cùng mức ưu tiên trên nguồn lực trung lập (Chuyên viên thiết kế ngoại tuyến, Chuyên viên đo lường và đối soát, Chuyên viên dữ liệu khách hàng và thị trường, Quản lý sản phẩm số): Quản lý thương hiệu của hai nhóm thống nhất phương án (lùi lịch, chia ngày, Chuyên viên Marketing cơ sở – media cùng nhóm quay tư liệu để Tổng công ty dựng); không thống nhất: Chuyên viên trưởng quyết. Trùng trong cùng nhóm: Quản lý thương hiệu của nhóm quyết.","thoi_han":"Trong 01 ngày làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.9","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvt"],"phoi_hop":[],"noi_dung":"Chưa thống nhất: Chuyên viên trưởng quyết định phần điều phối nguồn lực trong khối mình quản lý.","thoi_han":"Trong 01 ngày làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.8","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tp"],"phoi_hop":["bgd-coso"],"noi_dung":"Hai Hạng mục trọng điểm cùng cần một người, hoặc liên quan Ban Giám đốc cơ sở: Trưởng phòng chọn thứ tự, làm việc với Ban Giám đốc cơ sở.","thoi_han":"Trong 01 ngày làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.8, 14.9","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvt|xử lý trùng lịch giữa hai nhóm hoặc thiết bị media dùng chung","tt-nd|chỉ xử lý trùng lịch trong nhóm 1"],"phoi_hop":[],"noi_dung":"Báo người gửi kết quả, hạn mới; yêu cầu lùi hạn ghi lý do.","thoi_han":"Ngay khi có quyết định","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.11","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"}],"kiem_soat":["Mỗi lần trùng lịch ghi vào sổ theo dõi kèm lý do lùi hạn","Không đổi thứ tự ưu tiên đã quyết định qua tin nhắn riêng"],"ngoai_le":[{"tinh_huong":"Trùng lịch với sự cố, khủng hoảng","cach_lam":"Sự cố được ưu tiên trước (mục 14.10)."},{"tinh_huong":"Một nhóm dùng nhiều giờ của người nhóm khác trong 02 quý liên tiếp","cach_lam":"Chuyên viên trưởng báo Trưởng phòng xét cân giờ theo mục 21."}],"nhom_vi_du":"chung"},{"id":"yeu-cau-gap","ten":"Yêu cầu gấp hơn thời hạn chuẩn","nhom_hoat_dong":["N11"],"vi_du":"Ban Giám đốc Bệnh viện Đa khoa TTH Quảng Bình cần ấn phẩm thông báo lịch khám miễn phí trong 01 ngày; thời hạn chuẩn 02 ngày làm việc.","buoc":[{"thuc_hien":["tn-a"],"phoi_hop":["qlth-a"],"noi_dung":"Người gửi (Trưởng nhóm Marketing cơ sở, Quản lý thương hiệu) gửi yêu cầu qua cổng tiếp nhận, ghi hạn cần và lý do gấp.","thoi_han":"Khi phát sinh","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.6; mục 14.7","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tt-nd"],"phoi_hop":[],"noi_dung":"Xác nhận: nhận bằng giờ dự phòng của người phụ trách, hoặc đề xuất hạn sớm nhất có thể. Không lùi yêu cầu khác khi chưa báo người gửi của yêu cầu đó.","thoi_han":"Tự xác nhận khi đủ ô; yêu cầu cần Tổ trưởng xử lý 04 giờ làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.5, 14.7; mục 16, số 2","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tk-a"],"phoi_hop":[],"noi_dung":"Người phụ trách làm theo hạn đã xác nhận; ghi giờ dự phòng đã dùng.","thoi_han":"Theo hạn đã xác nhận","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.11","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvt"],"phoi_hop":["tp|khi phải lùi Hạng mục trọng điểm"],"noi_dung":"Yêu cầu gấp vượt khả năng của tổ: Chuyên viên trưởng điều phối; phải lùi Hạng mục trọng điểm: Trưởng phòng quyết định.","thoi_han":"Trong ngày","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.8","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["dl-1"],"phoi_hop":[],"noi_dung":"Báo cáo tháng: số yêu cầu gấp theo người gửi, cơ sở; lý do; giờ dự phòng đã dùng.","thoi_han":"Hằng tháng","ghi_nhan":"Báo cáo tháng","can_cu":"mục 14.11","de_xuat":true,"thu_tu":5,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["Yêu cầu gấp có lý do ghi trên cổng tiếp nhận yêu cầu","Không bỏ kiểm tra pháp lý, xác nhận chuyên môn vì gấp"],"ngoai_le":[{"tinh_huong":"Cơ sở gửi gấp nhiều lần do không gửi nhu cầu tháng","cach_lam":"Chuyên viên trưởng nhắc Trưởng nhóm; lặp lại 02 tháng liên tiếp: Trưởng phòng làm việc với Ban Giám đốc cơ sở."},{"tinh_huong":"Sự cố, khủng hoảng","cach_lam":"Theo QT.6."},{"tinh_huong":"Yêu cầu gửi ngoài giờ làm việc, không phải sự cố","cach_lam":"Thời hạn chuẩn tính từ đầu giờ làm việc kế tiếp; cần trước đó: người nhận báo hạn khả thi, hoặc làm thêm giờ khi Trưởng phòng (chưa có: Chuyên viên trưởng) đồng ý theo quy định làm thêm giờ (Bộ luật Lao động 2019, Điều 107). Sự cố: theo QT.6."}],"nhom_vi_du":"N1"},{"id":"mua-sam","ten":"Mua dịch vụ Marketing: chọn nhà cung cấp, hợp đồng, nghiệm thu, thanh toán","nhom_hoat_dong":["N11","N4"],"vi_du":"Hạng mục khai trương dịch vụ tại Bệnh viện Đa khoa TTH Hà Tĩnh cần in 2.000 tờ rơi, thuê căng băng rôn tuyến đường.","buoc":[{"thuc_hien":["qlth-a"],"phoi_hop":[],"noi_dung":"Xác định hạng mục chi, số lượng, hạn mức trong kế hoạch Hạng mục.","thoi_han":"Khi lập kế hoạch Hạng mục","ghi_nhan":"Kế hoạch Hạng mục trọng điểm (mục 9.4)","can_cu":"QT.1","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung"},{"thuc_hien":["cvtt-a"],"phoi_hop":["tk-nt|xác nhận kỹ thuật file in, quy cách"],"noi_dung":"Đề xuất nhà cung cấp trong danh sách đã phê duyệt; dự toán; yêu cầu kỹ thuật.","thoi_han":"Trước khi lập tờ trình","ghi_nhan":"Dự toán","can_cu":"mục 11.1, số 11; mục 15.2","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qlth-a"],"phoi_hop":["gd-coso|ký tờ trình khi dùng ngân sách cơ sở","tp|duyệt theo ma trận thẩm quyền","ke-toan"],"noi_dung":"Lập tờ trình chi; trình duyệt.","thoi_han":"Theo ma trận thẩm quyền","ghi_nhan":"Tờ trình chi Hạng mục (mục 9.4)","can_cu":"mục 4.2; mục 14.16","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung; Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["mua-sam"],"phoi_hop":["phap-che|hợp đồng ngoài mẫu","qlth-a"],"noi_dung":"Chọn nhà cung cấp, ký hợp đồng theo quy định mua sắm của Tập đoàn.","thoi_han":"Theo quy định mua sắm","ghi_nhan":"Hồ sơ hợp đồng","can_cu":"mục 17; mục 31, mảng 30","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Trang tính sổ hợp đồng"},{"thuc_hien":["cvtt-a"],"phoi_hop":["nha-cung-cap","mdcs-a|ảnh nghiệm thu"],"noi_dung":"Làm việc kỹ thuật, theo dõi sản xuất, thi công; nghiệm thu bằng biên bản kèm ảnh.","thoi_han":"Theo hợp đồng","ghi_nhan":"Biên bản nghiệm thu (mục 9.4)","can_cu":"mục 11.1, số 11","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qlth-a"],"phoi_hop":["ke-toan"],"noi_dung":"Hồ sơ thanh toán; đối soát khoản chi với hạn mức Hạng mục.","thoi_han":"Sau nghiệm thu","ghi_nhan":"Hồ sơ thanh toán","can_cu":"mục 11.1, số 11; QT.15","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":["tp|duyệt danh sách"],"noi_dung":"Đánh giá nhà cung cấp sau hợp đồng (chất lượng, đúng hạn); cập nhật danh sách nhà cung cấp đã phê duyệt.","thoi_han":"Sau mỗi hợp đồng; rà soát hằng năm","ghi_nhan":"Danh sách nhà cung cấp đã phê duyệt","can_cu":"mục 7.1","de_xuat":true,"thu_tu":7,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Nhà cung cấp trong danh sách đã phê duyệt","Không thanh toán khi chưa có biên bản nghiệm thu kèm ảnh","Chi trong hạn mức Hạng mục","Cùng nhà cung cấp, cùng loại hàng, dịch vụ của 02 nhóm: cộng nhu cầu ngày 20–22 trước khi ký (Chuyên viên đo lường và đối soát); tổng từ 20 triệu đồng trở lên bắt buộc ký hợp đồng (Quy chế chi tiêu nội bộ ban hành kèm Quyết định 189/QĐ-TTH, Điều 32.1)"],"ngoai_le":[{"tinh_huong":"Nhà cung cấp mới, ngoài danh sách","cach_lam":"Chuyên viên trưởng thẩm định; Trưởng phòng duyệt bổ sung vào danh sách trước khi ký."},{"tinh_huong":"Truyền hình, truyền thanh, báo chí, trang cộng đồng trên mạng xã hội theo hợp đồng năm","cach_lam":"Theo QT.33."},{"tinh_huong":"Thuê đơn vị bên ngoài làm việc chuyên sâu","cach_lam":"Chỉ việc chuyên sâu, làm một lần hoặc theo năm: thiết kế hệ nhận diện, khảo sát nhận biết thương hiệu (KPI-08, KPI-09), phim thương hiệu lớn; theo tờ trình Ban Tổng Giám đốc duyệt; không thay vị trí thường xuyên, không dùng để bù thiếu người; người của nhóm có thương hiệu là đầu mối, nghiệm thu (mục 26)."}],"nhom_vi_du":"N1"},{"id":"mua-truyen-thong","ten":"Truyền hình, truyền thanh, báo chí, trang cộng đồng trên mạng xã hội theo hợp đồng năm","nhom_hoat_dong":["N4","N5"],"vi_du":"Hợp đồng năm giữa TTH Group và đài truyền hình phân bổ thời lượng cho các chi nhánh; chương trình sức khỏe trên truyền hình cho Bệnh viện Đa khoa TTH Vinh, Bệnh viện Y học cổ truyền Nguyên Phúc.","buoc":[{"thuc_hien":["tp"],"phoi_hop":["cvtt|phần của nhóm","qlth|phần của nhóm"],"noi_dung":"Kế hoạch năm: đơn vị truyền thông, thời lượng, ngân sách, phân bổ theo cơ sở trong kế hoạch, ngân sách năm.","thoi_han":"Theo lịch kế hoạch năm","ghi_nhan":"Kế hoạch, ngân sách năm","can_cu":"QT.15","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvtt"],"phoi_hop":["qlth|tờ trình, hồ sơ hợp đồng","dl-1|cộng nhu cầu mua 02 nhóm ngày 20–22","mua-sam"],"noi_dung":"Đề xuất hợp đồng năm cho thương hiệu của nhóm, phân bổ theo cơ sở của nhóm; hồ sơ hợp đồng theo QT.32. Cùng nhà cung cấp, cùng loại hàng, dịch vụ của 02 nhóm: Chuyên viên đo lường và đối soát cộng nhu cầu mua của 02 nhóm ngày 20–22, sau khi 02 BM-3 được duyệt, trước khi ký; tổng từ 20 triệu đồng trở lên thì đơn vị chủ trì mua sắm làm một hợp đồng, mỗi nhóm một phụ lục (Quy chế chi tiêu nội bộ ban hành kèm Quyết định 189/QĐ-TTH, Điều 32.1: tổng giá trị mua sắm từ 20 triệu đồng trở lên bắt buộc ký hợp đồng; Phòng Tài chính – Kế hoạch xác nhận cách áp dụng cho dịch vụ Marketing).","thoi_han":"Trước khi hợp đồng cũ hết hạn","ghi_nhan":"Hồ sơ hợp đồng","can_cu":"mục 11.1, số 11; QT.32","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Trang tính sổ hợp đồng"},{"thuc_hien":["tn"],"phoi_hop":["qhcs"],"noi_dung":"Đề xuất chủ đề chương trình truyền hình, bài báo của tháng sau.","thoi_han":"Trước ngày 28 hằng tháng","ghi_nhan":"Nhu cầu tháng","can_cu":"mục 14.7; QT.37