(Nghị định 356/2025/NĐ-CP; Nghị định 330/2026/NĐ-CP)."}],"nhom_vi_du":"N1"},{"id":"ke-hoach-nam","ten":"Kế hoạch, ngân sách năm → tổng chi → chốt kỳ → KPI quý","nhom_hoat_dong":["N1","N10"],"vi_du":"Chu kỳ năm 2027.","buoc":[{"thuc_hien":["tp","qlth"],"phoi_hop":["dl-1|số liệu","gd-coso"],"noi_dung":"Tổng kết năm; lập kế hoạch, ngân sách Marketing năm (một tờ trình, có xác nhận của Giám đốc từng cơ sở).","thoi_han":"Tháng 12","ghi_nhan":"Tờ trình","can_cu":"mục 4.2; mục 30","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["btgd"],"phoi_hop":[],"noi_dung":"Duyệt kế hoạch, hạn mức năm.","thoi_han":"Theo lịch của Tổng công ty","ghi_nhan":"Quyết định","can_cu":"mảng 1","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tn","qlth","tp"],"phoi_hop":[],"noi_dung":"Kế hoạch tháng: Trưởng nhóm Marketing cơ sở gửi nhu cầu ngày 10–15; Quản lý thương hiệu của nhóm lập BM-3, trình chậm nhất ngày 18; Trưởng phòng duyệt chậm nhất ngày 20. Mốc rơi ngày nghỉ làm ngày làm việc liền trước.","thoi_han":"Trình chậm nhất ngày 18; duyệt chậm nhất ngày 20","ghi_nhan":"Phần mềm: kế hoạch tháng","can_cu":"mục 16, số 12","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Trang tính BM-3 của nhóm"},{"thuc_hien":["qlth"],"phoi_hop":["tp","bgd-coso"],"noi_dung":"Chi ngoài kế hoạch: đề xuất dùng dự phòng trong hạn mức. Dự phòng Tổng công ty: Trưởng phòng duyệt; ngân sách cơ sở: Ban Giám đốc cơ sở duyệt.","thoi_han":"Trước khi chi","ghi_nhan":"Tờ trình","can_cu":"mục 4.2","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["dl-1"],"phoi_hop":["ke-toan|đối chiếu","tp|báo cáo Ban Tổng Giám đốc"],"noi_dung":"Theo dõi tổng chi so với ngân sách năm; chỉ số ngân sách Marketing trên doanh thu thuần.","thoi_han":"Hằng tháng","ghi_nhan":"Báo cáo tháng","can_cu":"mảng 36; mục 16, số 18","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["dl-1"],"phoi_hop":["tp"],"noi_dung":"Chốt kỳ, báo cáo tháng dựng tự động; Trưởng phòng duyệt bản chốt kỳ.","thoi_han":"Đầu tháng","ghi_nhan":"Bản chốt kỳ","can_cu":"mảng 32","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["tp","cvt","tt-nd","tt-ts","tn"],"phoi_hop":["qlml|khi có, giao chỉ tiêu Trưởng nhóm trong vùng (mục 21)"],"noi_dung":"Giao chỉ tiêu KPI quý từ kế hoạch Hạng mục đã duyệt (người đánh giá theo tuyến).","thoi_han":"Đầu quý","ghi_nhan":"Phần mềm","can_cu":"mục 24.4","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-1","tp","cvt"],"phoi_hop":["bgd-coso|góp ý Marketing cơ sở","nhan-luc","qlml|khi có, đánh giá Trưởng nhóm trong vùng (mục 21)"],"noi_dung":"Chốt số liệu KPI; chấm điểm; hệ số; thưởng quý. Quý I/2027: tính thử, chưa chi.","thoi_han":"05 ngày làm việc đầu quý sau","ghi_nhan":"Bảng điểm KPI","can_cu":"mục 24.4, 24.7; 14.13","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["dl-1","cvt"],"phoi_hop":["tp"],"noi_dung":"Rà soát định biên, cân giờ: Chuyên viên trưởng tính, đề xuất (số giờ theo sổ theo dõi yêu cầu: Chuyên viên đo lường và đối soát); Trưởng phòng duyệt.","thoi_han":"10 ngày làm việc đầu quý sau","ghi_nhan":"Biên bản rà soát","can_cu":"mục 14.14","de_xuat":false,"thu_tu":9,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Ngân sách Marketing của cơ sở chỉ trình một lần, trong kế hoạch Marketing năm","KPI chấm từ số liệu đã chốt trên phần mềm, không từ báo cáo nhập tay"],"ngoai_le":[{"tinh_huong":"Vượt hạn mức năm","cach_lam":"Tờ trình điều chỉnh kế hoạch năm, Ban Tổng Giám đốc duyệt (mục 4.2)."},{"tinh_huong":"Người được đánh giá không đồng ý điểm KPI","cach_lam":"Gửi khiếu nại trong 05 ngày làm việc sau khi công bố, kèm số liệu đã chốt; người duyệt giải quyết trong 05 ngày làm việc; tiếp theo là Phòng Nhân lực (mục 24.6)."}],"nhom_vi_du":"N1"},{"id":"tuyen-duoi-tai-tro","ten":"Cơ sở y tế tuyến dưới, bác sĩ, phòng khám bên ngoài giới thiệu người bệnh; tài trợ tại địa phương","nhom_hoat_dong":["N7","N6"],"vi_du":"Bệnh viện Đa khoa TTH Hà Tĩnh hợp tác chuyên môn với một trung tâm y tế khu vực; đồng thời tài trợ giải việt dã của địa phương.","buoc":[{"thuc_hien":["qhcs"],"phoi_hop":["khoa-phong","co-so-y-te-doi-tac"],"noi_dung":"Lập danh sách cơ sở y tế đối tác; đề xuất chính sách hợp tác.","thoi_han":"Theo kế hoạch","ghi_nhan":"Phần mềm","can_cu":"mảng 21","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["phap-che"],"phoi_hop":[],"noi_dung":"Xem nội dung hợp tác.","thoi_han":"Trước khi ký","ghi_nhan":"Ý kiến pháp lý","can_cu":"mảng 21","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bgd-coso"],"phoi_hop":["don-vi-ky-ket","qlth"],"noi_dung":"Duyệt chính sách hợp tác; ký theo thẩm quyền. Đối tác từ 02 cơ sở trở lên: đơn vị được Ban Tổng Giám đốc giao ký; Quản lý thương hiệu làm hồ sơ năng lực.","thoi_han":"Trước khi triển khai hợp tác","ghi_nhan":"Hợp đồng","can_cu":"mảng 21, 29","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Trang tính sổ hợp đồng"},{"thuc_hien":["dl-1"],"phoi_hop":["tiep-don|ghi nguồn khách"],"noi_dung":"Nguồn khách riêng cho từng đối tác.","thoi_han":"Trước khi bắt đầu","ghi_nhan":"Phần mềm","can_cu":"mục 14.5","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["don-vi-chuyen-mon"],"phoi_hop":[],"noi_dung":"Chuyển tuyến chuyên môn.","thoi_han":"Theo quy định chuyển tuyến","ghi_nhan":"Hồ sơ chuyển tuyến của đơn vị chuyên môn","can_cu":"mục 17","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["dl-1"],"phoi_hop":["qhcs","qlth-a|KPI-27"],"noi_dung":"Đo khách, Lead hợp lệ, doanh thu ghi nhận từ đối tác (KPI-23, KPI-26, KPI-27).","thoi_han":"Hằng tháng","ghi_nhan":"Báo cáo tháng","can_cu":"mục 12.2","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["qhcs","bgd-coso"],"phoi_hop":["ctxh"],"noi_dung":"Tài trợ tại địa phương: đề xuất; Ban Giám đốc cơ sở duyệt ngân sách. Tài trợ cấp hệ thống, thương hiệu: lập Hạng mục, Quản lý thương hiệu phụ trách. Từ thiện không có đối ứng truyền thông: Tổ Công tác xã hội.","thoi_han":"Theo kế hoạch tháng","ghi_nhan":"Tờ trình","can_cu":"mảng 41; mục 11.1, số 15","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["tn-a","tk-a"],"phoi_hop":["tk-nt|xác nhận kỹ thuật file in","cvt|duyệt ấn phẩm ngoại viện làm từ mẫu thiết kế sẵn, mục 14.16, mảng 6","tp|duyệt ấn phẩm ngoại viện là sản phẩm mới"],"noi_dung":"Tin trong ngày trên Facebook của bệnh viện; ấn phẩm tài trợ (băng rôn, backdrop): Chuyên viên thiết kế nhóm 1, file in qua Chuyên viên thiết kế ngoại tuyến xác nhận kỹ thuật. Ghi Hoạt động, bằng chứng trên phần mềm.","thoi_han":"Tin trong 04 giờ","ghi_nhan":"Facebook của bệnh viện","can_cu":"mục 16, số 13","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Không chi tiền, tặng quà để đổi lấy việc giới thiệu người bệnh; chính sách hợp tác qua bộ phận pháp chế","Mỗi đối tác một nguồn khách","Dữ liệu người bệnh chỉ chuyển cho cơ sở y tế, phòng khám bên ngoài khi có yêu cầu hoặc đồng ý bằng văn bản của người bệnh (Nghị định 330/2026/NĐ-CP)"],"ngoai_le":[{"tinh_huong":"Đối tác liên quan nhiều cơ sở","cach_lam":"Chuyển Quản lý thương hiệu, lập Hạng mục (mảng 29)."},{"tinh_huong":"Bác sĩ, phòng khám tư nhân bên ngoài giới thiệu người bệnh","cach_lam":"Truyền thông cơ sở ghi nguồn giới thiệu; Chuyên viên đo lường và đối soát đo theo nguồn. Hình thức ghi nhận, chăm sóc người giới thiệu: chỉ áp dụng hình thức được bộ phận pháp chế xác nhận (mục 28, số 47)."}],"nhom_vi_du":"N1"},{"id":"nghi-viec","ten":"Nhân viên nghỉ việc","nhom_hoat_dong":["N11"],"vi_du":"Chuyên viên quảng cáo và kênh số nhóm 2 nộp đơn nghỉ việc.","buoc":[{"thuc_hien":["nhan-luc"],"phoi_hop":[],"noi_dung":"Báo đơn xin nghỉ việc ngày nhận đơn; báo quyết định nghỉ việc.","thoi_han":"Ngày nhận đơn; khi có quyết định","ghi_nhan":"Quyết định nghỉ việc","can_cu":"QyĐ.05.MKT 5.4.2","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":["tt-ts|lịch, giờ của tổ"],"noi_dung":"Tổ chức bàn giao theo hồ sơ vị trí; làm song song 10 ngày với người kế nhiệm. Người kế nhiệm chưa vào làm trước ngày nghỉ: bàn giao cho người thay chính (bước 3); người kế nhiệm nhận lại khi vào làm.","thoi_han":"Làm song song 10 ngày","ghi_nhan":"Biên bản bàn giao","can_cu":"mục 15.5","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc-a|ngoại lệ chờ tuyển – người trung lập cho phép làm thay có thời hạn (mục 15.4)"],"phoi_hop":["tt-ts|cho phép làm thay có thời hạn chờ tuyển","qlth-bc|nghiệm thu"],"noi_dung":"Người thay chính nhận việc. Vị trí 01 người của nhóm 2 (ví dụ này): người cùng chuyên môn nhóm 1, chỉ việc có hạn, khi được cho phép làm thay (chờ tuyển) (điều kiện: đã mở tuyển, có ngày dự kiến vào làm; hết khi người mới vào làm); quyền tạm theo thời hạn cho phép làm thay; nghiệm thu, duyệt vẫn ở nhóm 2.","thoi_han":"Từ ngày người nghỉ vắng","ghi_nhan":"Hồ sơ vị trí","can_cu":"mục 15.4","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt","tp","qc"],"phoi_hop":[],"noi_dung":"Thu hồi quyền đăng bài, trả lời tin nhắn: Chuyên viên trưởng (theo ma trận quyền); quyền quản trị kênh, Trang doanh nghiệp trên Google, tài khoản quảng cáo: Trưởng phòng; quyền gửi tin của nhóm (Trang Zalo chính thức, tin nhắn Zalo theo mẫu (ZNS), SMS, email thương hiệu): Chuyên viên quảng cáo và kênh số của nhóm. Người nghỉ là người cấp quyền: Trưởng phòng thu hồi (mục 11.3). Chuyên viên trưởng là người kiểm tra, xác nhận cuối cùng việc thu hồi đầy đủ quyền; từng người cấp quyền chịu trách nhiệm thu hồi quyền thuộc hệ thống mình quản lý.","thoi_han":"01 ngày sau bàn giao; 48 giờ sau khi Phòng Nhân lực báo","ghi_nhan":"Danh sách quyền","can_cu":"QyĐ.05.MKT 5.4.2; mục 11.3","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":[],"noi_dung":"Thu hồi quyền phần mềm Quản trị Marketing.","thoi_han":"Cùng ngày thu hồi quyền kênh","ghi_nhan":"Danh sách quyền","can_cu":"mục 11.3","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cnnvy","cvt","qlsps","tk-nt"],"phoi_hop":[],"noi_dung":"Hộp thư chức danh: Phòng Công nghệ – Nghiệp vụ Y. Quyền kho tư liệu: Chuyên viên trưởng (thư mục của nhóm do Chuyên viên media của nhóm giữ). Trang quản trị nội dung website, App TTH: Quản lý sản phẩm số. Thư viện mẫu thiết kế sẵn, công cụ thiết kế: Chuyên viên thiết kế ngoại tuyến.","thoi_han":"Cùng ngày","ghi_nhan":"Danh sách quyền","can_cu":"mục 11.3; mục 28, số 21","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["tp"],"phoi_hop":["nhan-luc"],"noi_dung":"Vị trí cấu trúc (vị trí 01 người của nhóm, vị trí trung lập) luôn tuyển thay: mở tuyển ngày nhận đơn (thời hạn báo trước 30 hoặc 45 ngày – Bộ luật Lao động 2019, Điều 35). Vị trí có 02 người trở lên: theo quy tắc định biên (mục 21). Chờ tuyển quá 03 tháng: Trưởng phòng báo Ban Tổng Giám đốc. Vắng trên 01 tháng chưa có người: hợp đồng có thời hạn.","thoi_han":"Mở tuyển ngày nhận đơn","ghi_nhan":"Bảng phân công","can_cu":"mục 15.4; 21","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Quyền kênh gắn với vị trí; không còn tài khoản cá nhân giữ quyền quản trị sau 48 giờ","Hồ sơ vị trí đủ để người mới làm được ngay"],"ngoai_le":[{"tinh_huong":"Người đã nghỉ đăng thông tin sai về bệnh viện trên trang cá nhân","cach_lam":"Chuyên viên truyền thông của nhóm có bệnh viện bị nêu theo dõi; Phòng Nhân lực xử lý theo quy tắc ứng xử mạng xã hội (mảng 27)."},{"tinh_huong":"Đang trong giai đoạn giảm định biên","cach_lam":"Chỉ không tuyển người thay khi định biên của vị trí giảm; vị trí cấu trúc vẫn tuyển thay (mục 21)."}],"nhom_vi_du":"N2"},{"id":"phap-luat","ten":"Thay đổi pháp luật, chính sách nền tảng; thủ tục với cơ quan nhà nước; quy định dùng trí tuệ nhân tạo","nhom_hoat_dong":["N11"],"vi_du":"Có văn bản mới hướng dẫn quảng cáo dịch vụ khám bệnh, chữa bệnh; cùng tháng, một nền tảng quảng cáo đổi chính sách với quảng cáo y tế.","buoc":[{"thuc_hien":["phap-che"],"phoi_hop":[],"noi_dung":"Thông báo thay đổi pháp luật quảng cáo y tế.","thoi_han":"Khi có văn bản","ghi_nhan":"Thông báo của bộ phận pháp chế","can_cu":"mảng 39","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["phap-che","tp"],"phoi_hop":["bt|sửa mẫu nội dung, kịch bản của nhóm"],"noi_dung":"Bộ phận pháp chế cung cấp nội dung cập nhật danh sách kiểm tra pháp lý chung (gồm nội dung bắt buộc của quảng cáo dịch vụ khám bệnh, chữa bệnh: tên, địa chỉ, số giấy phép hoạt động, thời gian hoạt động, phạm vi chuyên môn – Nghị định 342/2025/NĐ-CP, Điều 9); Trưởng phòng duyệt; Chuyên viên biên tập của từng nhóm sửa mẫu nội dung, kịch bản của nhóm theo bản đã duyệt.","thoi_han":"Trước khi văn bản có hiệu lực","ghi_nhan":"Danh sách kiểm tra trên phần mềm","can_cu":"mảng 39; mục 11.1, số 16","de_xuat":false,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qlsps"],"phoi_hop":["cvt|duyệt","qc|áp dụng trên kênh của nhóm"],"noi_dung":"Quản lý sản phẩm số cập nhật chính sách nền tảng, danh sách từ khóa, hình ảnh bị cấm (dùng chung cả hai nhóm); Chuyên viên trưởng duyệt; Chuyên viên quảng cáo và kênh số của từng nhóm áp dụng trên kênh của nhóm.","thoi_han":"Hằng tháng; khi nền tảng đổi chính sách","ghi_nhan":"Danh sách trên phần mềm","can_cu":"mục 30; mảng 39","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["qc","bt"],"phoi_hop":[],"noi_dung":"Rà lại quảng cáo đang triển khai, bài đang đăng trên website.","thoi_han":"Trước ngày hiệu lực","ghi_nhan":"Sổ theo dõi","can_cu":"mảng 39","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["cvt"],"phoi_hop":[],"noi_dung":"Phổ biến cho toàn phòng, Marketing cơ sở.","thoi_han":"Trong tháng","ghi_nhan":"Biên bản đào tạo","can_cu":"mục 11.1, số 8","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt","so-hoa"],"phoi_hop":["phap-che|nộp hồ sơ nội dung quảng cáo; ý kiến hồ sơ website, App TTH","cnnvy|hồ sơ tên miền, chứng chỉ bảo mật","qlsps|phần nội dung của hồ sơ website, App TTH"],"noi_dung":"Hồ sơ thủ tục khi pháp luật yêu cầu: hồ sơ nội dung quảng cáo (Chuyên viên biên tập lập, bộ phận pháp chế nộp); hồ sơ website, App TTH (Phòng Số hóa chủ trì, nộp; Phòng Công nghệ – Nghiệp vụ Y cung cấp hồ sơ tên miền, chứng chỉ bảo mật; Quản lý sản phẩm số cung cấp phần nội dung; bộ phận pháp chế cho ý kiến). Phòng Marketing Tổng công ty xác nhận ngày 05/11/2026.","thoi_han":"Theo thời hạn của cơ quan nhà nước","ghi_nhan":"Hồ sơ","can_cu":"mảng 38","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvt"],"phoi_hop":["bt|nội dung","dl-2|dữ liệu cá nhân","cnnvy","tp|duyệt"],"noi_dung":"Quy định dùng công cụ trí tuệ nhân tạo trong sản xuất nội dung; Trưởng phòng duyệt.","thoi_han":"Một lần; sửa khi pháp luật thay đổi","ghi_nhan":"Quy định","can_cu":"mảng 40; L