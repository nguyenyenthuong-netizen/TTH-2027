_nhan":"Tờ trình","can_cu":"mảng 12, 30; mục 11.1, số 11","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["nha-cung-cap"],"phoi_hop":["cvtt-a","qhcs|ảnh, số đo và hồ sơ nghiệm thu"],"noi_dung":"Thi công.","thoi_han":"Theo hợp đồng","ghi_nhan":"Biên bản/ảnh nghiệm thu hiện trường do Truyền thông cơ sở chụp (cơ sở 02 người: Trưởng nhóm kiêm); nghiệm thu theo thẩm quyền.","can_cu":"QyĐ.48","de_xuat":false,"thu_tu":7,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cvtt-a","tk-nt"],"phoi_hop":["qhcs|ảnh, số đo và hồ sơ nghiệm thu"],"noi_dung":"Ký nghiệm thu trên ảnh của Chuyên viên Marketing cơ sở – truyền thông (bệnh viện 02 người: Trưởng nhóm kiêm) (Chuyên viên truyền thông của nhóm có cơ sở); cập nhật danh mục biển bảng toàn hệ thống (Chuyên viên thiết kế ngoại tuyến).","thoi_han":"Sau thi công","ghi_nhan":"Biên bản nghiệm thu; QyĐ.48, BM.02","can_cu":"mảng 12","de_xuat":false,"thu_tu":8,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"}],"kiem_soat":["Mỗi biển có trong danh mục biển bảng toàn hệ thống (Chuyên viên thiết kế ngoại tuyến giữ; dữ liệu tách theo nhóm)","Nghiệm thu bằng ảnh trước khi thanh toán"],"ngoai_le":[{"tinh_huong":"Biển hỏng gây nguy hiểm","cach_lam":"Marketing cơ sở báo Ban Giám đốc cơ sở; Phòng Hành chính quản trị xử lý ngay; ghi sổ theo dõi trong 24 giờ."}],"nhom_vi_du":"N1"},{"id":"website-app","ten":"Website, App TTH: cập nhật nội dung và lỗi nghiêm trọng","nhom_hoat_dong":["N8"],"vi_du":"Bệnh viện Đa khoa TTH Quảng Bình đổi lịch khám của 02 bác sĩ; cùng tuần, chức năng đặt lịch trên App TTH bị lỗi.","buoc":[{"thuc_hien":["tn-a"],"phoi_hop":["khoa-phong|xác nhận"],"noi_dung":"Gửi ảnh, thông tin giới thiệu bác sĩ mới; thông tin cơ sở thay đổi gửi một lần. Lịch làm việc của bác sĩ: lấy tự động từ HIS khi có kết nối; chưa có kết nối thì gửi lịch (mục 11.1, số 24; mục 28, số 50).","thoi_han":"Khi có thay đổi","ghi_nhan":"Phần mềm","can_cu":"mảng 16; mục 11.1, số 24; mục 28, số 50","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["bt-ac","qc-a"],"phoi_hop":["bac-si"],"noi_dung":"Đơn vị chủ dữ liệu xác nhận nội dung, Marketing cơ sở gửi thay đổi một lần qua cổng. Tên, địa chỉ, giờ làm việc, điện thoại, hồ sơ bác sĩ và lịch bác sĩ khi chưa có HIS: Chuyên viên biên tập của nhóm chuẩn hóa, nhập và đăng CMS sau kiểm độc lập; Chuyên viên quảng cáo và kênh số cập nhật Trang doanh nghiệp trên Google. Giá, người hành nghề, dịch vụ/kỹ thuật được phép: Quản lý sản phẩm số đối chiếu chứng từ của đơn vị chủ dữ liệu, nhập và đăng dữ liệu có cấu trúc sau người kiểm độc lập; thiếu chứng từ thì chặn. Khi đã kết nối HIS: đồng bộ tự động, không ghi đè tay.","thoi_han":"Trong ngày nhận đủ thông tin","ghi_nhan":"Trang quản trị nội dung website","can_cu":"mảng 35; mục 11.1, số 24","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Như cột ghi nhận; việc, hạn ghi vào sổ yêu cầu dùng chung"},{"thuc_hien":["cc|trước khi nhận: người đang trả lời tại cơ sở","mkt-coso"],"phoi_hop":["khach"],"noi_dung":"Báo lỗi đặt lịch ngay khi phát hiện.","thoi_han":"Ngay khi phát hiện","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.4","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlsps"],"phoi_hop":[],"noi_dung":"Xác định mức lỗi; gửi qua cổng tiếp nhận yêu cầu của Phòng Số hóa (đầu mối duy nhất).","thoi_han":"Ngay khi nhận báo","ghi_nhan":"Cổng tiếp nhận yêu cầu của Phòng Số hóa","can_cu":"mục 17","de_xuat":false,"thu_tu":4,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["so-hoa"],"phoi_hop":[],"noi_dung":"Sửa lỗi.","thoi_han":"Theo thời hạn mức nghiêm trọng do Phòng Số hóa đề xuất, Ban Tổng Giám đốc duyệt","ghi_nhan":"Sổ theo dõi lỗi gửi Phòng Số hóa","can_cu":"mục 17; mục 28, số 35","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":