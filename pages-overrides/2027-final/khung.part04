 1."},{"tinh_huong":"Người bệnh rút đồng ý dùng hình ảnh, yêu cầu gỡ","cach_lam":"Theo QT.48, bước 6."}],"nhom_vi_du":"N1"},{"id":"btgd-giao-viec","ten":"Ban Tổng Giám đốc giao việc, chỉ đạo; báo cáo, xin ý kiến Ban Tổng Giám đốc","nhom_hoat_dong":["N11","N1"],"vi_du":"Tổng Giám đốc chỉ đạo truyền thông chương trình tri ân khách hàng toàn hệ thống trong 02 tuần.","buoc":[{"thuc_hien":["tp"],"phoi_hop":["btgd"],"noi_dung":"Trưởng phòng nhận chỉ đạo (văn bản, cuộc họp, tin nhắn); ghi vào cổng tiếp nhận yêu cầu: nội dung, kết quả cần đạt, hạn, người chỉ đạo.","thoi_han":"Trong ngày","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 14.10","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["tp"],"phoi_hop":["qlth-a","cvt"],"noi_dung":"Giao Quản lý thương hiệu của nhóm (việc thuộc Hạng mục) hoặc người phụ trách theo bảng phân công; việc cần Hạng mục mới: lập theo QT.1, QT.10.","thoi_han":"Trong 01 ngày làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 14.4","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlth-a"],"phoi_hop":["dl-1|cách đo, nguồn khách"],"noi_dung":"Lập kế hoạch, dự toán; việc dùng ngân sách Tổng công ty trình Ban Tổng Giám đốc duyệt.","thoi_han":"Theo hạn chỉ đạo","ghi_nhan":"Tờ trình chi Hạng mục","can_cu":"mục 4.2; QT.10","de_xuat":false,"thu_tu":3,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung; Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["tp"],"phoi_hop":["btgd"],"noi_dung":"Chỉ đạo ảnh hưởng Hạng mục đang triển khai hoặc vượt ngân sách: Trưởng phòng trình phương án (lùi Hạng mục nào, nguồn chi) trước khi triển khai.","thoi_han":"Trước khi triển khai","ghi_nhan":"Tờ trình","can_cu":"mục 14.8","de_xuat":true,"thu_tu":4,"chua_co_phan_mem":"Tờ trình trên Workit, ghi mã Hạng mục"},{"thuc_hien":["qlth-a"],"phoi_hop":["tp"],"noi_dung":"Báo cáo tiến độ theo mốc; báo cáo kết quả sau kỳ chốt số liệu.","thoi_han":"Theo mốc","ghi_nhan":"Báo cáo Hạng mục trọng điểm","can_cu":"QT.1","de_xuat":false,"thu_tu":5,"chua_co_phan_mem":"Trang tính Hạng mục, Hoạt động trong bảng tính dùng chung; Bảng tính chốt kỳ, báo cáo lập theo mẫu"},{"thuc_hien":["tp"],"phoi_hop":["btgd","dl-1|số liệu"],"noi_dung":"Báo cáo định kỳ Ban Tổng Giám đốc: báo cáo tháng, sơ kết quý, 06 tháng, tổng kết năm.","thoi_han":"Theo lịch (mục 30)","ghi_nhan":"Báo cáo tuần, tháng; bản chốt kỳ","can_cu":"mục 30; 29/BB-TTH","de_xuat":false,"thu_tu":6,"chua_co_phan_mem":"Bảng tính chốt kỳ, báo cáo lập theo mẫu"}],"kiem_soat":["Chỉ đạo của Ban Tổng Giám đốc có trên cổng tiếp nhận yêu cầu, có người nhận, có hạn","Nhân viên nhận chỉ đạo trực tiếp chuyển Trưởng phòng (mục 14.10)"],"ngoai_le":[{"tinh_huong":"Lãnh đạo giao trực tiếp cho nhân viên","cach_lam":"Nhân viên báo Trưởng phòng trong ngày; Trưởng phòng chuyển vào cổng tiếp nhận yêu cầu (QT.8)."},{"tinh_huong":"Chỉ đạo liên quan khủng hoảng","cach_lam":"Theo QT.6."}],"nhom_vi_du":"N1"},{"id":"bgd-coso-de-nghi","ten":"Ban Giám đốc cơ sở đề nghị, phản ánh, bất đồng với Marketing; góp ý quý","nhom_hoat_dong":["N11"],"vi_du":"Giám đốc Bệnh viện Đa khoa TTH Hà Tĩnh phản ánh bài quảng cáo gói khám chậm 01 tuần so với kế hoạch.","buoc":[{"thuc_hien":["bgd-coso"],"phoi_hop":["tn"],"noi_dung":"Ban Giám đốc cơ sở gửi đề nghị, phản ánh qua Trưởng nhóm Marketing cơ sở hoặc Quản lý thương hiệu của nhóm; việc cần sản xuất vào cổng tiếp nhận yêu cầu.","thoi_han":"Khi phát sinh","ghi_nhan":"Cổng tiếp nhận yêu cầu","can_cu":"mục 4.2","de_xuat":false,"thu_tu":1,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc_hien":["qlth"],"phoi_hop":["tt-nd|tiến độ sản xuất"],"noi_dung":"Quản lý thương hiệu của nhóm xác nhận, trả lời phương án; việc sản xuất theo QT.2; việc về nhân sự Marketing cơ sở chuyển Chuyên viên trưởng.","thoi_han":"01 ngày làm việc","ghi_nhan":"Sổ theo dõi yêu cầu","can_cu":"mục 4","de_xuat":true,"thu_tu":2,"chua_co_phan_mem":"Sổ yêu cầu dùng chung (bảng tính)"},{"thuc