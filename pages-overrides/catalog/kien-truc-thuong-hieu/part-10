function v19Mount(){if(!['group','tri','chau','thao','phuc','tth','tam','bach'].includes(active))return;document.body.classList.add('v19-site');if(active==='group')document.body.classList.add('v19-group');v19Menu();v19Measure();v19Resize?.disconnect();v19Resize=new ResizeObserver(v19Measure);[v19Header(),document.querySelector('#portalbar')].filter(Boolean).forEach(x=>v19Resize.observe(x));const orig=window.navRoute;window.navRoute=()=>{const k=currentHash.slice(1)||'home';if(active==='group'&&(V19_ESG.includes(k)||k==='community')){if(!document.querySelector('.v19-esg-page')){currentHash='#sustainability';orig();v19BuildESG();currentHash='#'+k;}document.querySelectorAll('header details[open]').forEach(d=>d.open=false);v19Header()?.classList.remove('open');v19Active(k==='community'?'esg-social':k);v19ScrollESG(k);return}orig();document.querySelectorAll('header details[open]').forEach(d=>d.open=false);v19Active(k);v19Side(k);v19Measure()};v19Active(currentHash.slice(1));v19Side(currentHash.slice(1));if(v19Scroll)window.removeEventListener('scroll',v19Scroll);v19Scroll=()=>{if(active!=='group'||!document.querySelector('.v19-esg-page'))return;const top=parseFloat(getComputedStyle(document.body).getPropertyValue('--v19-sticky-top'))||160;let key='sustainability';V19_ESG.slice(1).forEach(k=>{const el=document.getElementById('v19-'+k);if(el&&el.getBoundingClientRect().top<=top+30)key=k});v19Active(key)};window.addEventListener('scroll',v19Scroll,{passive:true});}

const V23VIDEOS=["data:video/mp4;base64,","data:video/mp4;base64,","data:video/mp4;base64,","data:video/mp4;base64,"];
const V23TITLES=["Phim giới thiệu TTH Group", "Năng lực và công nghệ", "Con người TTH", "Phát triển bền vững"];
document.addEventListener('click',e=>{if(active!=='group')return;let b=e.target.closest('[data-v23-video],[data-v23-gallery]');if(!b)return;e.preventDefault();let d=document.createElement('dialog');d.className='v23-media-view';d.innerHTML='<h2></h2><div class="v23-view-content"></div><p class="v23-note">Tư liệu minh họa, không phải hình ảnh hoặc phim chính thức của TTH.</p><nav><button data-prev>‹ Trước</button><span></span><button data-next>Tiếp ›</button><button data-close>Đóng</button></nav>';document.body.append(d);const items=[...document.querySelectorAll('#app [data-v23-gallery]')];let i=Number(b.dataset.v23Gallery||b.dataset.v23Video||0),video=b.hasAttribute('data-v23-video');function draw(){let c=d.querySelector('.v23-view-content');c.replaceChildren();let el=document.createElement(video?'video':'img');if(video){el.controls=true;el.playsInline=true;el.src=V23VIDEOS[i];el.poster=b.querySelector('img').src;d.querySelector('h2').textContent=V23TITLES[i]}else{el.src=items[i].querySelector('img').src;el.alt=items[i].querySelector('img').alt;d.querySelector('h2').textContent=el.alt}c.append(el);let total=video?V23VIDEOS.length:items.length;d.querySelector('nav span').textContent=(i+1)+' / '+total;d.querySelector('[data-prev]').disabled=i===0;d.querySelector('[data-next]').disabled=i===total-1}d.querySelector('[data-prev]').onclick=()=>{i--;draw()};d.querySelector('[data-next]').onclick=()=>{i++;draw()};d.querySelector('[data-close]').onclick=()=>d.close();d.addEventListener('close',()=>d.remove());draw();d.showModal()});


function v27CloseMenus(){document.querySelectorAll('header details[open]').forEach(d=>d.open=false);document.querySelector('header.header')?.classList.remove('open')}
document.addEventListener('click',e=>{const h=document.querySelector('header.header');if(!h)return;if(!h.contains(e.target))v27CloseMenus();else if(e.target.closest('header .g-dropdown a,header .v13-drop a'))v27CloseMenus();});
document.addEventListener('keydown',e=>{if(e.key==='Escape')v27CloseMenus()});
function v27MountTools(){if(!document.body.classList.contains('portal-site'))return;const nav=document.querySelector('.g-header .g-nav')||document.querySelector('header .nav');if(!nav||nav.querySelector('.v27-tools'))return;const tools=document.createElement('div');tools.className='v27-tools';tools.innerHTML=`<button type="button" class="v27-search" aria-label="Tìm kiếm" title="Tìm kiếm"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg></button><div class="v27-lang" aria-label="Ngôn ngữ"><button type="button" aria-current="true">VI</button><span aria-hidden="true">|</span><button type="button">EN</button></div>`;nav.append(tools);tools.querySelector('.v27-search').onclick=()=>{if(typeof window.search==='function')window.search();else openAdvancedSearch()};tools.querySelector('.v27-lang button:last-child').onclick=()=>{const d=document.createElement('dialog');d.style.cssText='max-width:420px;width:calc(100% - 36px);border:1px solid #cbd9e9;padding:24px;border-radius:6px;color:#142b49';d.innerHTML='<h2>English</h2><p>English language layout preview. The full English content has not yet been prepared.</p><p>Phiên bản tiếng Anh chưa được biên tập hoàn chỉnh.</p><button type="button">Đóng / Close</button>';document.body.append(d);d.querySelector('button').onclick=()=>d.close();d.addEventListener('close',()=>d.remove());d.showModal()};}
function v27Sync(){if(active==='group'){const k=currentHash.slice(1)||'home';const connect=document.querySelector('.g-connect');if(connect)connect.hidden=k!=='home';if(k==='contact'){document.querySelectorAll('#app aside .button').forEach(b=>{if(/hợp tác|liên hệ/i.test(b.textContent))b.style.display='none'})}}}
document.addEventListener('click',e=>{const c=e.target.closest('#app [data-v33-click]');if(!c||e.target.closest('a,button,input,select,textarea,label,summary')||window.getSelection()?.toString())return;const a=c.querySelector('a[href],button[onclick]');if(a)a.click()});

const mergedGroupRender=render;render=function(id){const r=mergedGroupRender(id);if(id!=="group")return r;v19Mount();v27MountTools();const orig=window.navRoute;window.navRoute=()=>{orig?.();v27Sync()};v27Sync();return r;};
