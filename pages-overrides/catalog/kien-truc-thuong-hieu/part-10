document.addEventListener('pointerover',e=>{if(e.pointerType!=='mouse')return;let d=e.target.closest('header details');const header=e.target.closest('header');if(d){header.querySelectorAll('details[open]').forEach(o=>{if(o!==d)o.open=false});if(e.target.closest('summary'))d.open=true}else if(header){header.querySelectorAll('details[open]').forEach(o=>o.open=false)}},true);
document.addEventListener('pointerout',e=>{if(e.pointerType!=='mouse')return;const header=e.target.closest('header');if(header&&!header.contains(e.relatedTarget))header.querySelectorAll('details[open]').forEach(o=>o.open=false)},true);
acceptedNavState();

function restoreAlwaysOn(){const root=document.documentElement,header=document.querySelector('header'),bar=document.getElementById('portalbar');const offset=()=>{const hb=header?.getBoundingClientRect(),bb=bar?.getBoundingClientRect();let top=Math.max(hb?.bottom||0,bb?.bottom||0,0)+14;root.style.setProperty('--article-sticky-top',Math.round(top)+'px')};offset();if(window.__articleResize)window.__articleResize.disconnect();if(typeof ResizeObserver!=='undefined'){window.__articleResize=new ResizeObserver(offset);if(header)window.__articleResize.observe(header);if(bar)window.__articleResize.observe(bar)}window.removeEventListener('resize',window.__articleOffset||(()=>{}));window.__articleOffset=offset;window.addEventListener('resize',offset);}
const beforeCalendarRender=render;render=function(id){beforeCalendarRender(id);if(id==='healthcare')return;restoreAlwaysOn();const old=window.navRoute;if(old)window.navRoute=()=>{old();restoreAlwaysOn()}};restoreAlwaysOn();

function syncNormalizedUI(){const d=NORMALIZED[active];if(!d)return;const m=currentHash.match(/^#med-doctor-(\d+)$/);if(m){const r=d.doctors[Number(m[1])];if(r){const h=document.querySelector('#app .pagehead h1');if(h)h.textContent=r.name;const cr=document.querySelector('#app .crumb');if(cr&&cr.lastChild?.nodeType===3)cr.lastChild.textContent=' / '+r.name;}}if(active==='tth'){document.querySelectorAll('#app .side a, header a, footer a').forEach(a=>{if(['#facilities','#med-facility'].includes(a.getAttribute('href'))){const x=a.querySelector('span');a.textContent='Thông tin bệnh viện';if(x)a.append(x)}})}finalBookingIcons();}
const normalizedRender=render;render=function(id){normalizedRender(id);if(id==='healthcare')return;const route=window.navRoute;if(route)window.navRoute=()=>{route();syncNormalizedUI()};syncNormalizedUI()};syncNormalizedUI();

