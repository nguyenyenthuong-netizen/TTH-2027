// Calendar icon for all booking CTA variants, including dynamically rendered records.
function finalBookingIcons(){document.querySelectorAll('a,button').forEach(a=>{let t=(a.textContent||'').replace(/\s+/g,' ').trim();let href=a.getAttribute('href')||'';if(/^(?:Đặt lịch(?: khám)?|Đăng ký khám|Đăng ký gói|Book (?:a visit|an appointment)|Đăng ký tư vấn mẫu)/i.test(t)||href==='#med-book'&&/đăng ký|đặt lịch|tư vấn/i.test(t)){if(!a.classList.contains('final-book'))a.classList.add('final-book')}})}
let finalPending=false;function finalSchedule(){if(finalPending)return;finalPending=true;requestAnimationFrame(()=>{finalPending=false;finalBookingIcons()})}
new MutationObserver(finalSchedule).observe(document.body,{childList:true,subtree:true});
function finalCloseOthers(d){d.closest('header')?.querySelectorAll('details[open]').forEach(x=>{if(x!==d)x.open=false})}
document.addEventListener('toggle',e=>{if(e.target.matches?.('header details')&&e.target.open)finalCloseOthers(e.target)},true);
document.addEventListener('pointerover',e=>{if(e.pointerType!=='mouse')return;const d=e.target.closest('header details');if(d&&e.target.closest('summary')&&!d.contains(e.relatedTarget)){finalCloseOthers(d);d.open=true}},true);
document.addEventListener('click',e=>{const d=e.target.closest('header details summary');if(d&&d.querySelector('a')&&e.target.closest('a')){finalCloseOthers(d.parentElement);d.parentElement.open=false}const card=e.target.closest('[data-final-route]');if(card&&!e.target.closest('a,button,input,select,label'))card.querySelector('a[href="'+card.dataset.finalRoute+'"]')?.click()});
finalBookingIcons();

function acceptedNavState(){const menus=[...document.querySelectorAll('header details')];const winner=menus.find(d=>d.querySelector('a[href="'+currentHash+'"]'));menus.forEach(d=>{d.classList.toggle('accepted-current',d===winner);if(d!==winner){d.classList.remove('current-menu','v19-active')}});if(active==='group'){const bar=document.querySelector('#portalbar strong');if(bar)bar.textContent='Công ty Cổ phần TTH Group · MOCKUP – DỮ LIỆU MINH HỌA'}
if(active==='bach'){document.querySelectorAll('#app .loc-chip').forEach(el=>{const names={'Tai Mũi Họng':0,'Mắt':1,'Răng Hàm Mặt':2,'Y học cổ truyền':3,'Thẩm mỹ':4};const ix=names[el.textContent.trim()];if(ix!==undefined&&el.tagName!=='A'){const a=document.createElement('a');for(const at of el.attributes)a.setAttribute(at.name,at.value);a.href='#clinical-'+ix;a.textContent=el.textContent;el.replaceWith(a)}})}
finalBookingIcons();}
