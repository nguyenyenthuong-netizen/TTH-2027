 function update(){const phrase=norm(q.value),words=phrase.split(' ').filter(Boolean);if(!phrase&&scope.value==='all'&&type.value==='all'){out.replaceChildren();count.textContent='Nhập từ khóa hoặc chọn bộ lọc để tìm kiếm.';return}const hits=entries.filter(e=>(scope.value==='all'||e.id===scope.value||e.brand===scope.value)&&(type.value==='all'||e.category===type.value)&&(!phrase||(exact.checked?e.hay.includes(phrase):words.every(w=>e.hay.includes(w)))));const score=e=>words.filter(w=>norm(e.title).includes(w)).length*4+(phrase&&norm(e.title).includes(phrase)?8:0)+(e.block>=0?2:0);hits.sort((a,b)=>score(b)-score(a));const unique=[...new Map(hits.map(e=>[e.id+'|'+e.anchor+'|'+e.title+'|'+e.block,e])).values()];out.replaceChildren();count.textContent=unique.length?'Tìm thấy '+unique.length+' kết quả'+(unique.length>80?' (hiển thị 80 kết quả đầu; thu hẹp bộ lọc để xem thêm)':'')+'.':'Không tìm thấy nội dung phù hợp.';
 for(const e of unique.slice(0,80)){const b=document.createElement('button');b.type='button';b.className='as-result';const h=document.createElement('strong');h.textContent=e.title;const meta=document.createElement('small');meta.textContent=(names[e.id]||'Danh mục website')+' · '+({legal:'Pháp lý',brand:'Thương hiệu / chuyên khoa',web:'Website',operation:'Quản trị / vận hành',growth:'Hành trình / Marketing'}[e.category]);const p=document.createElement('div');const ix=phrase?norm(e.text).indexOf(words[0]||phrase):0;const start=Math.max(0,ix-60);p.textContent=(start?'…':'')+e.text.slice(start,start+230)+(e.text.length>start+230?'…':'');b.append(h,meta,p);b.onclick=()=>{dialog.close();if(e.id==='architecture'&&e.anchor){openProfile(e.anchor);if(e.block>=0){requestAnimationFrame(()=>{const target=document.getElementById(e.anchor)?.querySelectorAll(blockSelector)[e.block];if(target){for(let p=target;p;p=p.parentElement)if(p.tagName==='DETAILS')p.open=true;target.style.outline='2px solid #0837A1';target.style.scrollMarginTop='180px';target.scrollIntoView({block:'center'});setTimeout(()=>{target.style.outline=''},2500)}})}return}render(e.id);if(e.id==='catalog'&&e.anchor)document.getElementById(e.anchor)?.scrollIntoView();else if(e.id!=='healthcare'&&e.anchor&&window.navRoute){currentHash='#'+e.anchor;window.navRoute()}};out.append(b)}}
 [q,scope,type,exact].forEach(el=>el.addEventListener(el===q?'input':'change',update));dialog.querySelector('#as-reset').onclick=()=>{q.value='';scope.value='all';type.value='all';exact.checked=false;update();q.focus()};dialog.showModal();update();q.focus();
}

render('catalog');
</script></body></html>