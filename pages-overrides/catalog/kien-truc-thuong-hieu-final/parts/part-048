function enhanceSpecialtyCards(){
  document.querySelectorAll('#app .sync-list-item').forEach((card,idx)=>{
    if(card.dataset.denseCard==='1') return;
    const titleEl=card.querySelector('h3');
    const descEl=card.querySelector('p');
    const links=[...card.querySelectorAll(':scope > a')];
    if(!titleEl||!descEl||!links.length) return;
    const sectionTitle=card.closest('.un-section')?.querySelector('.un-head h2')?.textContent?.trim()||'';
    const title=titleEl.textContent.trim();
    const desc=descEl.textContent.trim();
    const initials=title.split(/\s+/).filter(Boolean).slice(0,2).map(w=>w[0]).join('').toUpperCase();
    const eyeword = sectionTitle || 'Thông tin';
    const chips = [];
    if(sectionTitle.includes('Dịch vụ')) chips.push('Theo chỉ định');
    else if(sectionTitle.includes('Gói khám')) chips.push('Theo nhu cầu');
    else if(sectionTitle.includes('Chương trình')) chips.push('Hoạt động minh họa');
    else if(sectionTitle.includes('Bác sĩ')) chips.push('Hồ sơ chuyên môn');
    else chips.push('Thông tin minh họa');
    if(links.some(a=>/device|thiết bị/i.test(a.textContent))) chips.push('Có thiết bị liên quan');
    if(links.some(a=>/hồ sơ|bác sĩ/i.test(a.textContent))) chips.push('Xem hồ sơ');
    if(links.some(a=>/cơ sở|bệnh viện/i.test(a.textContent))) chips.push('Xem cơ sở');
    const top=document.createElement('div');
    top.className='sync-list-top';
    top.innerHTML='<div class="sync-list-icon">'+initials+'</div><div class="sync-list-head"><div class="sync-list-eyebrow">'+eyeword+'</div></div>';
    titleEl.remove();
    descEl.remove();
    top.querySelector('.sync-list-head').appendChild(titleEl);
    top.querySelector('.sync-list-head').appendChild(descEl);
    card.prepend(top);
    if(chips.length){
      const chipsEl=document.createElement('div');
      chipsEl.className='sync-list-chips';
      chipsEl.innerHTML=chips.map(ch=>'<span class="sync-list-chip">'+ch+'</span>').join('');
      top.after(chipsEl);
    }
    const note=document.createElement('div');
    note.className='sync-list-note';
    note.textContent = sectionTitle.includes('Dịch vụ') ? 'Xem mô tả kỹ thuật, thiết bị liên quan và cơ sở thực hiện trong website mẫu.' : 'Chọn nội dung phù hợp để tiếp tục xem chi tiết trong website mẫu.';
    const actions=document.createElement('div');
    actions.className='sync-list-actions';
    links.forEach(a=>actions.appendChild(a));
    card.appendChild(note);
    card.appendChild(actions);
    card.dataset.denseCard='1';
  });
}
