if((m=t.match(/^Gói:\s*(.+)$/)))return 'Package: '+tthTranslate(m[1]);
if((m=t.match(/^Xem chuyên khoa\s+(.+)$/)))return 'View specialty: '+tthTranslate(m[1]);
