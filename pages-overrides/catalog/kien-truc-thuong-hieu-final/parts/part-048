if((m=t.match(/^(.+?)\s*[–—-]\s*(ảnh minh họa AI|hình ảnh minh họa AI|hình minh họa AI|minh họa AI|ảnh minh họa|hình ảnh minh họa|chân dung minh họa AI)$/i)))return tthTranslate(m[1])+' – '+(/AI/i.test(m[2])?'AI-generated illustration':'illustrative image');
