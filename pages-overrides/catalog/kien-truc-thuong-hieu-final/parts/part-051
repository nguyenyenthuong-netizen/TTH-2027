const el=(tag,cls,txt)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(txt)e.textContent=txt;return e};
function draw(key,existing){const s=existing||document.createElementNS(ns,'svg');s.setAttribute('viewBox','0 0 24 24');s.setAttribute('fill','none');s.setAttribute('stroke','currentColor');s.setAttribute('stroke-width','1.65');s.setAttribute('stroke-linecap','round');s.setAttribute('stroke-linejoin','round');s.setAttribute('aria-hidden','true');s.replaceChildren();const p=document.createElementNS(ns,'path');p.setAttribute('d',paths[key]||paths.doc);s.append(p);if(!existing)s.classList.add('qc121-icon');return s}
const normalize=s=>String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d');
function keyFor(v){const s=normalize(v);const rules=[[/sau can thiep|sau dieu tri|sau thu thuat|aftercare|follow.up|post.procedure|tai kham|checkup/,'check'],[/khong phau thuat|non.surgical|non.invasive/,'noninvasive'],[/vung mat|facial|face|ham mat|jaw/,'face'],[/vung mat(?!\w)|eye|thi luc|thi giac|mat tre|mat hoc|mat kho|mat do|nhan khoa|kham mat|vung mi/,'eye'],[/vung mui|mui hong|nasal|nose|xoang|sinus/,'nose'],[/thinh luc|nghe kem|u tai|tai ngoai|hearing|ear/,'ear'],[/thanh quan|giong noi|voice|laryn/,'voice'],[/cham soc da|da lieu|skin|dermat|mun|chong nang/,'skin'],[/co the|body contour/,'body'],[/rang|nha khoa|dental|tooth|implant|orthodont|nha chu|noi nha/,'tooth'],[/xuong|khop|co xuong|cot song|bone|joint/,'bone'],[/van dong|phuc hoi|mobility|rehab/,'walk'],[/dinh duong|nutrition|an uong/,'food'],[/giac ngu|sleep/,'moon'],[/nhan thuc|than kinh|cognitive|neurolog|memory/,'brain'],[/tre em|nhi khoa|child|pediatric/,'child'],[/y hoc co truyen|duong sinh|traditional|herbal/,'leaf'],[/an toan|chat luong|quyen|safety|quality|rights/,'shield'],[/thiet bi|cong nghe|equipment|technology/,'device'],[/dao tao|nghien cuu|training|research/,'book'],[/hop tac|ket noi|partner|collaborat/,'network'],[/bac si|nhan su|doi ngu|doctor|team|staff/,'people'],[/co so|benh vien|facility|hospital|khong gian|phong o/,'building'],[/chi phi|bao hiem|cost|insurance/,'money'],[/chuong trinh|lich|event|schedule/,'calendar'],[/tu van|tham kham|consult|assessment/,'consult'],[/tim mach|cardio/,'heart']];for(const [r,k] of rules)if(r.test(s))return k;return 'medical'}
function iconCards(root){for(const c of root.querySelectorAll('.un-topic,.unified-clinical-card,.qc-icon-card')){const title=c.querySelector('h3,strong')?.textContent?.trim();if(!title)continue;let k=keyFor(title);if(/tạo hình vùng mắt|eyelid/i.test(title))k='eye';else if(/tạo hình vùng mặt/i.test(title))k='face';else if(/tạo hình vùng mũi/i.test(title))k='nose';else if(/thẩm mỹ không phẫu thuật/i.test(title))k='noninvasive';else if(/tạo hình cơ thể/i.test(title))k='body';else if(/tư vấn phẫu thuật tạo hình/i.test(title))k='consult';else if(/chăm sóc da/i.test(title))k='skin';if(c.dataset.qc121Icon===k)continue;c.dataset.qc121Icon=k;c.classList.add('qc121-icon-only');const targets=c.querySelectorAll('.qc-icon svg,svg.unified-symbol');for(const t of targets)draw(k,t)}}
function link(label,route,primary=false,click){const a=el('a',primary?'qc121-primary':'',label);a.href=route;if(click)a.addEventListener('click',click);return a}
function actions(items){const d=el('div','qc121-actions');for(const item of items)d.append(link(...item));return d}
function picture(src,alt){const f=el('figure','qc121-article-cover');const i=el('img');i.src=src;i.alt=alt;i.loading='lazy';f.append(i,el('figcaption','',tr('Hình ảnh minh họa','Illustrative image')));return f}
function rich(title,rows){const s=el('section','qc121-related-section');s.append(el('h2','',title));const g=el('div','qc121-rich-grid');for(const [h,p,k] of rows){const c=el('article'),t=el('h3');t.append(draw(k),el('span','',h));c.append(t,el('p','',p));g.append(c)}s.append(g);return s}
function isValid(r){try{return typeof tthRouteValid==='function'&&tthRouteValid(active,r)}catch{return false}}
